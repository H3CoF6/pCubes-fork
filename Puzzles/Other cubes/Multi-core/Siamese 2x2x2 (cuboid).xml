<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Siamese 2x2x2 (cuboid)</Name>
        <Menu>Other cubes\Multi-core\Siamese 2x2x2 (cuboid)</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3393</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2 / sqrt(2);
        A := Pi / 2;
    </Script>

    <Axes>
        <Axis TurningAngles = " 0; A" NormVector = " 1; 0; 0" BaseVector = " D; D; 0" PlaneDistances = "0" />
        <Axis TurningAngles = " 0; A" NormVector = " 0; 1; 0" BaseVector = " D; D; 0" PlaneDistances = "0" />

        <Axis TurningAngles = " 0; A" NormVector = "-1; 0; 0" BaseVector = "-D;-D; 0" PlaneDistances = "0" />
        <Axis TurningAngles = " 0; A" NormVector = " 0;-1; 0" BaseVector = "-D;-D; 0" PlaneDistances = "0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W / 2" WZ = "W * 0.4" />
        <SplitByAxes/>

        <HideContaining Vector = " 0; 0; 0" />
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " 0" /></Split>
        <ShowAll/>
    </Figure>
</xml>
