<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Edge Turning Corners Helicopter cube 3x3x3 AC</Name>
        <Menu>Other cubes\Multi-core\Edge Turning Corners Helicopter cube 3x3x3 AC</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-05</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FFEE00'; // Yellow
        Colors[2] := '0077EE'; // Blue
        Colors[3] := '00CC00'; // Green
        Colors[4] := 'AA00EE'; // Purple
        Colors[5] := '00CCCC'; // Cyan
        Colors[6] := 'FF7700'; // Orange
        Colors[7] := '333333'; // Black
        clBody := 'FFFFFF'; // White

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D1 := W / 5;
        D2 := D1 * 3;
        D3 := D1 * 4;

        D4 := D1 * sqrt(2);
        D5 := D4 * 3;
        D6 := D4 * 4;
 
        dAngle := 0.001;
        t := Tan(dAngle);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = " 0; Pi/4 + dAngle; Pi*2/4; Pi*3/4 + dAngle; Pi; Pi*5/4 + dAngle; Pi*6/4; Pi*7/4 + dAngle" PlaneDistances = " D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = "-1; 0; 0" />
        <Axis NormVector = " 0;-1; 0" />
        <Axis NormVector = " 0; 0;-1" />
    </Axes>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D5" NormVectors = "Ex; Ey; Ez" />

    <Axes TurningAngles = "Pi;0;Pi" PlaneDistances = "-D6; D6" >
        <Axis NormVector = " 0;-t; 1" BaseVector = " D2;  0;  0" />
        <Axis NormVector = " 0; t; 1" BaseVector = "-D2;  0;  0" />
        <Axis NormVector = " 0; 1;-t" BaseVector = "-D2;  0;  0" />
        <Axis NormVector = " 0; 1; t" BaseVector = " D2;  0;  0" />
        <Axis NormVector = " 1; 0;-t" BaseVector = "  0; D2;  0" />
        <Axis NormVector = " 1; 0; t" BaseVector = "  0;-D2;  0" />
        <Axis NormVector = "-t; 0; 1" BaseVector = "  0;-D2;  0" />
        <Axis NormVector = " t; 0; 1" BaseVector = "  0; D2;  0" />
        <Axis NormVector = "-t; 1; 0" BaseVector = "  0;  0; D2" />
        <Axis NormVector = " t; 1; 0" BaseVector = "  0;  0;-D2" />
        <Axis NormVector = " 1;-t; 0" BaseVector = "  0;  0;-D2" />
        <Axis NormVector = " 1; t; 0" BaseVector = "  0;  0; D2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "clBody" />

        <Macro Name = "Split" >
            <Split Color1 = "clBody" Color2 = "clBody" Axis = "i; Inc(i);" From = "1" />
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" i = "0" />

        <SplitByAxes/>

        <Macro Name = "SplitCorner" >
            <Hide> <Plane NormVector = " 0; 0; 1" NormDistance = "D1" /></Hide>
            <Hide> <Plane NormVector = " 1; 1; 0" NormDistance = "D6" /></Hide>
            <Split><Plane NormVector = " 1; 0;-1" NormDistance = "0 " /></Split>
            <Split><Plane NormVector = " 1; 0;-1" NormDistance = "D4" /></Split>
            <Split><Plane NormVector = " 0; 1;-1" NormDistance = "D4" /></Split>
            <HideContaining Vector = " D3; D3; D2" />
            <Split><Plane NormVector = " 1;-1; 0" NormDistance = "0 " /></Split>
            <ShowAll/>
            <Turn NormVector = "1;1;1" Angle = "2*Pi / 3" />
        </Macro>

        <Macro Name = "FormCorner" >
            <Hide> <Plane NormVector = " 1; 0; 0" NormDistance = "D1" /></Hide>
            <Hide> <Plane NormVector = " 0; 1; 0" NormDistance = "D1" /></Hide>
            <Hide> <Plane NormVector = " 0; 0; 1" NormDistance = "D1" /></Hide>
            <Split><Plane NormVector = " 0; 1; 1" NormDistance = "D6" /></Split>
            <Split><Plane NormVector = " 1; 0; 1" NormDistance = "D6" /></Split>
            <Split><Plane NormVector = " 1; 1; 0" NormDistance = "D6" /></Split>
            <HideContaining Vector = "D1; D2; D2" />
            <HideContaining Vector = "D2; D1; D2" />
            <HideContaining Vector = "D2; D2; D1" />
            <RemoveAllVisible/>

            <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "Colors[i]; Inc(i);" />
            <Cut Color = "Color" > <Plane NormVector = " 1; 0; 0" NormDistance = "D1" /></Cut>
            <Cut Color = "Color" > <Plane NormVector = " 0; 1; 0" NormDistance = "D1" /></Cut>
            <Cut Color = "Color" > <Plane NormVector = " 0; 0; 1" NormDistance = "D1" /></Cut>
            <SplitByAxes/>

            <Split><Plane NormVector = " 0; 1; 1" NormDistance = "D6" /></Split>
            <Split><Plane NormVector = " 1; 0; 1" NormDistance = "D6" /></Split>
            <Split><Plane NormVector = " 1; 1; 0" NormDistance = "D6" /></Split>
            <RemoveContaining Vector = "D1; D2; D2" />
            <RemoveContaining Vector = "D2; D1; D2" />
            <RemoveContaining Vector = "D2; D2; D1" />

            <ShowAll/>
            <ExecMacro MacroName = "SplitCorner" Repeat = "3" />

            <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        </Macro>
        <ExecMacro MacroName = "FormCorner" Repeat = "4" i = "0" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "FormCorner" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <!-- remove some gray parts -->

        <RemoveContaining Vector = "0;0;0" />

        <Script>
            W := W * 0.7;
            include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>
        <RemoveContaining Vector = "Vx;Vy;Vz" />

        <Script>
            W := W / 1.4;
            include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>
        <RemoveContaining Vector = "Ex;Ey;Ez" />
        <RemoveContaining Vector = "Vx;Vy;Vz" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
