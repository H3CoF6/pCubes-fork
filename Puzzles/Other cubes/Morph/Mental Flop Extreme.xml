<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mental Flop Extreme</Name>
        <Menu>Other cubes\Morph\Mental Flop Extreme</Menu>
        <Inventor>Alexander Sosnovsky</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-11-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10597</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        K := D * 1.005;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 1; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "D" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0;-D;0" />
        <RemoveContaining Vector = "0; D;0" />

        <Script>
            Colors[0] := -1;
            Colors[1] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D" WY = "W" WZ = "K" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "3" From  = "1" />
        <Split Axis = "4" From  = "1" />
    </Figure>
</xml>
