<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mental Flop Professor</Name>
        <Menu>Other cubes\Morph\Mental Flop Professor</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Added>2017-03-17</Added>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6122</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.6;
        WX := W / sqrt(2);
        WY := W;
        WZ := W * 0.4;
        D := WZ / 2 / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 1" />
        <Axis NormVector = "0; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
    </Figure>
</xml>
