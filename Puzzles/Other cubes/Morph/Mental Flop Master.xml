<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mental Flop Master</Name>
        <Menu>Other cubes\Morph\Mental Flop Master</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-03-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5416</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
        D2 := D / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "1; 0; 1" />
        <Axis NormVector = "1; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2 * 3" WY = "W" WZ = "D2 * 1.002" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2 "/>
    </Figure>
</xml>
