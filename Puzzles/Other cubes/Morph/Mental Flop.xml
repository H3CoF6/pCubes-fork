<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mental Flop</Name>
        <Aliases>1x3x3 Mental Block</Aliases>
        <Menu>Other cubes\Morph\Mental Flop</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1900</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 1; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
