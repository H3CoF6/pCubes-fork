<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windmill Mental Block</Name>
        <Menu>Other cubes\Morph\Windmill Mental Block</Menu>
        <Menu>Other cubes\Skewb variants\Windmill Mental Block</Menu>
        <Inventor>Linxiao Xu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-09-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9048</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=37106</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-Arccos(WZ / W / 2)" />
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
