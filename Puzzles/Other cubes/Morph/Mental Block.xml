<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mental Block</Name>
        <Menu>Other cubes\Morph\Mental Block</Menu>
        <Menu>Other cubes\Skewb variants\Mental Block</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=611</Link>
    </Interface>

    <Script>
        W := 0.5;
        H := W * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />
        <SplitByAxes/>
    </Figure>
</xml>
