<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>CubeMorph Vertex 2 (Octex)</Name>
        <Menu>Other cubes\Morph\CubeMorph Vertex 2 (Octex)</Menu>
        <Inventor>Eitan Cher</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2017-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1908</Link>
    </Interface>

    <Script>
        W := 0.5;

        H := W * 2 / 3 * sqrt(2);
        D := W * sqrt(6) / 9;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi/4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />

        <SplitByAxes/>
    </Figure>
</xml>
