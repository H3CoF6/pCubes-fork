<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mental Flop Professor 2 layers</Name>
        <Menu>Other cubes\Morph\Mental Flop Professor 2 layers</Menu>
        <Inventor>Ilya Toporgilka</Inventor>
        <Added>2022-04-14</Added>
        <Programmer>Boris</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9834</Link>
    </Interface>

    <Script>
        W := 0.55;
        D := W / 5 / sqrt(2);

        WX := W;
        WY := W * 2 / 5;
        WZ := W * 2 / 5;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;1;0" Angle = "Pi/4" />

        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
