<xml Data_Version = "2" >

    <Interface>
        <Name>Wring</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Wring</Menu>
        <Inventor>Chiu Chiung Yi</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2020-02-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3832</Link>
    </Interface>

    <Script>
        s2 := sqrt(2);

        W := 0.5;

        Wx := W / s2;
        Wy := Wx;
        Wz := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; -1;-s2" />
        <Axis NormVector = " 1;  1;  0" />
        <Axis NormVector = " 1; -1; s2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
