<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kite Cube II</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Kite Cube II</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1922</Link>
    </Interface>

    <Script>
        W := 0.5;

        A1:= Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "A1" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split><Plane NormVector = " 0; 1;-1" NormDistance = "0" /></Split>
        <Turn Axis = "1" Angle = " A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-A1" Layer = "1" />
    </Figure>
</xml>
