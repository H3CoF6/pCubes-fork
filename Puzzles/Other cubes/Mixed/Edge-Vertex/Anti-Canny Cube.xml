<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Anti-Canny Cube</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Anti-Canny Cube</Menu>
        <Inventor>Katelyn Neily</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-06-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5079</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W * 0.82;
        D2 := (W * 3 - D1 * sqrt(2)) / sqrt(3);


        D := W * 0.3;

        A := 2 * W  - D1 * sqrt(2);
        B := -W + D1 * sqrt(2);
        C := -W + D1 * sqrt(2);

        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>
    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>

        <HideContaining Vector = " 0; 0; 0" />

        <HideContaining Vector = " A; A; B" />
        <HideContaining Vector = "-A; A; B" />
        <HideContaining Vector = " A;-A; B" />
        <HideContaining Vector = "-A;-A; B" />
        <HideContaining Vector = " A; A;-B" />
        <HideContaining Vector = "-A; A;-B" />
        <HideContaining Vector = " A;-A;-B" />
        <HideContaining Vector = "-A;-A;-B" />

        <HideContaining Vector = " A; B; A" />
        <HideContaining Vector = "-A; B; A" />
        <HideContaining Vector = " A;-B; A" />
        <HideContaining Vector = "-A;-B; A" />
        <HideContaining Vector = " A; B;-A" />
        <HideContaining Vector = "-A; B;-A" />
        <HideContaining Vector = " A;-B;-A" />
        <HideContaining Vector = "-A;-B;-A" />

        <HideContaining Vector = " B; A; A" />
        <HideContaining Vector = "-B; A; A" />
        <HideContaining Vector = " B;-A; A" />
        <HideContaining Vector = "-B;-A; A" />
        <HideContaining Vector = " B; A;-A" />
        <HideContaining Vector = "-B; A;-A" />
        <HideContaining Vector = " B;-A;-A" />
        <HideContaining Vector = "-B;-A;-A" />

        <HideContaining Vector = " B; B; W" />
        <HideContaining Vector = "-B; B; W" />
        <HideContaining Vector = " B;-B; W" />
        <HideContaining Vector = "-B;-B; W" />
        <HideContaining Vector = " B; B;-W" />
        <HideContaining Vector = "-B; B;-W" />
        <HideContaining Vector = " B;-B;-W" />
        <HideContaining Vector = "-B;-B;-W" />
        <HideContaining Vector = " B; W; B" />
        <HideContaining Vector = "-B; W; B" />
        <HideContaining Vector = " B;-W; B" />
        <HideContaining Vector = "-B;-W; B" />
        <HideContaining Vector = " B; W;-B" />
        <HideContaining Vector = "-B; W;-B" />
        <HideContaining Vector = " B;-W;-B" />
        <HideContaining Vector = "-B;-W;-B" />
        <HideContaining Vector = " W; B; B" />
        <HideContaining Vector = "-W; B; B" />
        <HideContaining Vector = " W;-B; B" />
        <HideContaining Vector = "-W;-B; B" />
        <HideContaining Vector = " W; B;-B" />
        <HideContaining Vector = "-W; B;-B" />
        <HideContaining Vector = " W;-B;-B" />
        <HideContaining Vector = "-W;-B;-B" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

    </Figure>
</xml>
