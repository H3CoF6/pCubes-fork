<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter Skewb 120</Name>
        <Class>Jumble</Class>
        <Menu>Other cubes\Mixed\Edge-Vertex\Helicopter Skewb 120</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1757</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / sqrt(2);
    </Script>
 
    <Axes TurningAngles = "Pi;0;Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>
 
    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = " 1; -1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = "-1;  1; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
 
        <SplitByAxes/>
    </Figure>
</xml>
