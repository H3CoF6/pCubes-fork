<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewby Twins</Name>
        <Aliases>Twins cube</Aliases>
        <Menu>Other cubes\Mixed\Edge-Vertex\Skewby Twins</Menu>
        <Inventor>Mr. Fok</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7751</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W * sqrt(2) / 2 * 1.13;
        CutV := W * sqrt(3) * 0.95;
        CutE := W * sqrt(2) * 0.982;

        A1 := Arccos(1/3);
        A2 := Arccos(1/sqrt(3));
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "0; A1; A2; Pi-A2; Pi-A1; Pi; Pi+A1; Pi + A2; 2*Pi-A2; 2*Pi-A1" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <Macro Name = "Split" >
            <Turn  Axis = "Ax1" Layer = "0" Angle = "A * A1" />
            <Turn  Axis = "Ax1" Layer = "2" Angle = "A * A1" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "B * A1" />
            <Turn  Axis = "Ax2" Layer = "2" Angle = "B * A1" />
            <Split Axis = "Ax1" From  = "1" />
            <Split Axis = "Ax1" From  = "2" />
            <Turn  Axis = "Ax2" Layer = "2" Angle = "-B * A1" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "-B * A1" />
            <Turn  Axis = "Ax1" Layer = "2" Angle = "-A * A1" />
            <Turn  Axis = "Ax1" Layer = "0" Angle = "-A * A1" />
        </Macro>

        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "5" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "4" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "5" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "4" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "0" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "0" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "3" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "1" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "3" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "1" A = " 1" B = "-1" />

        <HideContaining Vectors = "Ex; Ey; Ez" />
        <InvertVisibility/>
        <Split><Plane NormVector = "1;0;0" /></Split>
        <Split><Plane NormVector = "0;1;0" /></Split>
        <Split><Plane NormVector = "0;0;1" /></Split>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>

    <Macros>
        <Macro Name = "Random1" >
            <Turn Axis = "Random(6)" Layer = "Random(2) * 2" Angle = "Pi" />
            <Turn Axis = "Random(4) + 6" Layer = "1" Angle = "2 * Pi / 3 * Random(3)" />
            <ExecMacro MacroName = "Random2" />
            <ExecMacro MacroName = "Random3" />
        </Macro>
        <Macro Name = "Random2" >
            <Turn Axis = "0" Layers = "2" Angle = " A2"/>
            <Turn Axis = "4" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "1" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "7" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "0" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "4" Layers = "0" Angle = " A2"/>
            <Turn Axis = "1" Layers = "0" Angle = " A2"/>

            <Turn Axis = "0" Layers = "0" Angle = " A2"/>
            <Turn Axis = "4" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "1" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "7" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "0" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "4" Layers = "2" Angle = " A2"/>
            <Turn Axis = "1" Layers = "2" Angle = " A2"/>

            <Turn Axis = "0" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "5" Layers = "0" Angle = " A2"/>
            <Turn Axis = "3" Layers = "0" Angle = " A2"/>
            <Turn Axis = "8" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "0" Layers = "2" Angle = " A2"/>
            <Turn Axis = "5" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "3" Layers = "0" Angle = "-A2"/>

            <Turn Axis = "0" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "5" Layers = "2" Angle = " A2"/>
            <Turn Axis = "3" Layers = "2" Angle = " A2"/>
            <Turn Axis = "8" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "0" Layers = "0" Angle = " A2"/>
            <Turn Axis = "5" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "3" Layers = "2" Angle = "-A2"/>

            <Turn Axis = "2" Layers = "2" Angle = " A2"/>
            <Turn Axis = "3" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "4" Layers = "2" Angle = " A2"/>
            <Turn Axis = "6" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "2" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "3" Layers = "0" Angle = " A2"/>
            <Turn Axis = "4" Layers = "2" Angle = "-A2"/>

            <Turn Axis = "2" Layers = "0" Angle = " A2"/>
            <Turn Axis = "3" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "4" Layers = "0" Angle = " A2"/>
            <Turn Axis = "6" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "2" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "3" Layers = "2" Angle = " A2"/>
            <Turn Axis = "4" Layers = "0" Angle = "-A2"/>

            <Turn Axis = "1" Layers = "2" Angle = " A2"/>
            <Turn Axis = "2" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "5" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "9" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "1" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "2" Layers = "0" Angle = " A2"/>
            <Turn Axis = "5" Layers = "0" Angle = " A2"/>

            <Turn Axis = "1" Layers = "0" Angle = " A2"/>
            <Turn Axis = "2" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "5" Layers = "2" Angle = "-A2"/>
            <Turn Axis = "9" Layers = "1" Angle = "2 * Pi / 3 * Random(3)"/>
            <Turn Axis = "1" Layers = "0" Angle = "-A2"/>
            <Turn Axis = "2" Layers = "2" Angle = " A2"/>
            <Turn Axis = "5" Layers = "2" Angle = " A2"/>
        </Macro>
        <Macro Name = "Random3" >
            <Turn Axis = "1" Layers ="2" Angle = "-A1"/>
            <Turn Axis = "2" Layers ="2" Angle = "A1-Pi"/>
            <Turn Axis = "2" Layers ="0" Angle = "A1"/>
            <Turn Axis = "1" Layers ="0" Angle = "Pi-A1"/>
            <Turn Axis = "5" Layers ="0" Angle = "Pi"/>
            <Turn Axis = "1" Layers ="0" Angle = "A1-Pi"/>
            <Turn Axis = "2" Layers ="0" Angle = "-A1"/>
            <Turn Axis = "2" Layers ="2" Angle = "Pi-A1"/>
            <Turn Axis = "1" Layers ="2" Angle = " A1"/>
        </Macro>
        <Macro Name = "RandomTurn" >
            <Turn Axis = "Random(6)" Layer = "Random(2) * 2" Angle = "2 * Pi * Random"/>
            <Turn Axis = "Random(4) + 6" Layer = "1" Angle = "2 * Pi * Random"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "" >
            <Script>
                A1 := Arccos(1/3);
                A2 := Arccos(1/sqrt(3));
            </Script>
            <ExecMacro MacroName = "Random1" Repeat = "50" />
            <ExecMacro MacroName = "RandomTurn" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
