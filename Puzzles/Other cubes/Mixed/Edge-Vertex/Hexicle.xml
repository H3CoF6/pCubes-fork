<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexicle (Double Tangram)</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Hexicle (Double Tangram)</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6011</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := 0.18;
        D2 := (1/2 - D1 * sqrt(2)) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = "-1;-1; 0" />
        <Axis NormVector = " 0; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "-D2; D2">
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Turn  Axis = "3" Angle = " Pi/3" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "3" Angle = "-Pi/3" Layer = "1" />
    </Figure>
</xml>
