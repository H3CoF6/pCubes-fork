<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewby Copter Plus</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Skewby Copter Plus</Menu>
        <Inventor>Diogo Sousa</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-01-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6042</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        A := W * 1.35;
        B := W * 0.4;

        C := A / sqrt(2) + 0.07;
        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.988;

        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "0; Pi" JumbleAngle = "JumAngle" PlaneDistances = "C" NormVectors = "Ex;Ey;Ez" />

    <Axes TurningAngles = "Pi/3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>

        <!-- uncolor cube centers -->
        <RemoveContaining Vector = " 0; 0; 0" />
        <HideAll/>
        <Script>
            for i := 0 to 5 do
                Colors[i] := '-1';
        </Script>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <HideContaining Vectors = "Cx;Cy;Cz" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Macro Name = "Split1" >
            <Turn  Axis = "Ax1" Layer = "1" Angle = " JumAngle" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-JumAngle" />
            <Split Axis = "Ax1" From  = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <Macro Name = "Split4" >
            <ExecMacro MacroName = "Split1" Ax1 = "Axis1" Ax2 = "Axis2" />
            <ExecMacro MacroName = "Split1" Ax1 = "Axis2" Ax2 = "Axis3" />
            <ExecMacro MacroName = "Split1" Ax1 = "Axis3" Ax2 = "Axis4" />
            <ExecMacro MacroName = "Split1" Ax1 = "Axis4" Ax2 = "Axis1" />
        </Macro>

        <ExecMacro MacroName = "Split4" Axis1 = "10" Axis2 = " 9" Axis3 = "11" Axis4 = " 2" />
        <ExecMacro MacroName = "Split4" Axis1 = " 3" Axis2 = " 4" Axis3 = " 8" Axis4 = " 5" />
        <ExecMacro MacroName = "Split4" Axis1 = " 0" Axis2 = "11" Axis3 = " 7" Axis4 = " 4" />
        <ExecMacro MacroName = "Split4" Axis1 = " 1" Axis2 = " 5" Axis3 = " 6" Axis4 = "10" />
        <ExecMacro MacroName = "Split4" Axis1 = " 6" Axis2 = " 8" Axis3 = " 7" Axis4 = " 9" />
        <ExecMacro MacroName = "Split4" Axis1 = " 0" Axis2 = " 3" Axis3 = " 1" Axis4 = " 2" />

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
