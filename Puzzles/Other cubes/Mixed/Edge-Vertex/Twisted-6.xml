<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Twisted-6</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Twisted-6</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1912</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * sqrt(2) / 2;
        D2 := W * sqrt(3) / 3; 
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; -1;  1" />
        <Axis NormVector = " 1;  0; -1" />
        <Axis NormVector = "-1;  1;  0" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1;  1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
