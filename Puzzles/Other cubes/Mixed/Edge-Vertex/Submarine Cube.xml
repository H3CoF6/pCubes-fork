<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Submarine Cube</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Submarine Cube</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7790</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * sqrt(2) / 2;
        D2 := W * 2 * sqrt(3) / 3; 
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = "-1;-1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
