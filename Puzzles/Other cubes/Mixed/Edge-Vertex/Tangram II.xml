<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tangram Extreme Cube</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Tangram Extreme Cube</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6441</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := 0.2;
        D2 := sqrt(3) / 6 - D1 * sqrt(6) / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D1" FixedLayers = "0" >
        <Axis NormVector = " 1;  0; -1" />
        <Axis NormVector = "-1; -1;  0" />
        <Axis NormVector = " 0;  1;  1" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D2; D2" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Turn  Axis = "3" Layer = "2" Angle = "Pi/3" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "3" Layer = "2" Angle = "2*Pi/3" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "3" Layer = "2" Angle = "2*Pi/3" />
        <Turn  Axis = "3" Layer = "2" Angle = "Pi/3" />

        <Turn  Axis = "3" Layer = "0" Angle = "Pi/3" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "3" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "3" Layer = "0" Angle = "2*Pi/3" />
        <Turn  Axis = "3" Layer = "0" Angle = "Pi/3" />
    </Figure>
</xml>
