<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tangram cube</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Tangram cube</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-09-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5768</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := sqrt(3) / 12;
        D2 := 0.175;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "  1;  1;  1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = "  0;  1; -1" />
        <Axis NormVector = " -1;  0;  1" />
        <Axis NormVector = "  1; -1;  0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>