<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cell Cube Plus</Name>
        <Aliases>3x3x3 + Compy Cube</Aliases>
        <Menu>Other cubes\Mixed\Face-Vertex\Cell Cube Plus</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9719</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.2;
        B := W * 0.345;
        W := 0.5;
        D1 := 0.3;
        D2 := (A + B) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0;  0;  1" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 1;  0;  0" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
