<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheese Cube</Name>
        <Menu>Other cubes\Mixed\Edge-Vertex\Cheese Cube</Menu>
        <Inventor>Casey Mihaloew</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7550</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "-1; -1;  0" />
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 1;  0; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
