<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Masterball Cube (3 layers)</Name>
        <Menu>Other Cubes\Mixed\Face-Edge\Masterball Cube (3 layers)</Menu>
        <Inventor>Ryan Thompson</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2046</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes />

        <Turn Axis = "0" Layer = "1" Angle = "Pi / 4" />
        <SplitByAxes />
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 4" />
        <SplitByAxes />
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 4" />
        <SplitByAxes />
        <Undo Repeat = "3" />
    </Figure>
</xml>
