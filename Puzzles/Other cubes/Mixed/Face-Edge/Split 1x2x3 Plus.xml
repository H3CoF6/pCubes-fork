<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Split 1x2x3 Plus</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Split 1x2x3 Plus</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-12-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7117</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        W2 := W / 3 * 2;
        H := W / 3;
        D := W / 3;

        R := W2 * 0.8;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D*sqrt(2)" >
        <Axis NormVector = " 1; 1; 0" BaseVector = "0; D; 0" />
        <Axis NormVector = "-1; 1; 0" BaseVector = "0; D; 0" />
        <Axis NormVector = " 1;-1; 0" BaseVector = "0;-D; 0" />
        <Axis NormVector = "-1;-1; 0" BaseVector = "0;-D; 0" />

        <Axis1 NormVector = " 0; 1; 1" BaseVector = "0; D; 0" />
        <Axis1 NormVector = " 0;-1; 1" BaseVector = "0;-D; 0" />
        <Axis1 NormVector = " 0; 1;-1" BaseVector = "0; D; 0" />
        <Axis1 NormVector = " 0;-1;-1" BaseVector = "0;-D; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W2; -W; -H" />
                <Add Vector = "-W2; -W;  H" />
                <Add Vector = "-W2;  W; -H" />
                <Add Vector = "-W2;  W;  H" />
                <Add Vector = " W2; -W; -H" />
                <Add Vector = " W2; -W;  H" />
                <Add Vector = " W2;  W; -H" />
                <Add Vector = " W2;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = "0;0;0" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />

        <Split Axis = "2" From = "1" />

        <Turn Axis = "3" Layer = "1" Angle = "Pi / 2" />
        <Turn Axis = "4" Layer = "1" Angle = "Pi / 2" />
        <Turn Axis = "5" Layer = "1" Angle = "Pi / 2" />
        <Turn Axis = "6" Layer = "1" Angle = "Pi / 2" />

        <Split Axis = "2" From = "1" />
        <Undo Repeat = "4" />

        <ShowAll/>

    </Figure>
</xml>
