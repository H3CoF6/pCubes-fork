<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triple Decky</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Triple Decky</Menu>
        <Inventor>Matthew Calin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-02-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12453</Link>
    </Interface>

    <Script>
        W := 0.5;

        C := W / sqrt(2);
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-C; C" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
