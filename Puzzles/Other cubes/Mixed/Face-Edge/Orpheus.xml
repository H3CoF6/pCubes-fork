<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Orpheus</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Orpheus</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6901</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(8);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1;  0; 0" />
        <Axis NormVector = " 0;  1; 0" />
        <Axis NormVector = " 0;  0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
