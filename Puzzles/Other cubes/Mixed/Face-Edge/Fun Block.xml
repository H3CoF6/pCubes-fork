<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fun Block</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Fun Block</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2938</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        W1 := 0.32;
        W2 := 2 * W1;
        Wn := -W1;
        H  := W1 * sqrt(2);
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 1; 0" BaseVector = "W1; 0; 0" />
        <Axis NormVector = "1;-1; 0" BaseVector = "W1; 0; 0" />
    </Axes>
    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "-1;-1; 0" BaseVector = "Wn; 0; 0" />
        <Axis NormVector = "-1; 1; 0" BaseVector = "Wn; 0; 0" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-W2; -W1; -H" />
                  <Add Vector = "-W2; -W1;  H" />
                  <Add Vector = "-W2;  W1; -H" />
                  <Add Vector = "-W2;  W1;  H" />
                  <Add Vector = " W2; -W1; -H" />
                  <Add Vector = " W2; -W1;  H" />
                  <Add Vector = " W2;  W1; -H" />
                  <Add Vector = " W2;  W1;  H" />
            </Vertices>

            <Faces>
                  <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                  <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                  <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                  <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                  <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                  <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
