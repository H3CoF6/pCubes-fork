<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chopped-3</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Chopped-3</Menu>
        <Inventor>Garrett Ong</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1959</Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "6" From = "1" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "7" From = "2" />
        <Split Axis = "8" From = "1" />
        <Split Axis = "8" From = "2" />
        <RemoveContaining Vector = "0; 0; 0" />

        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />

        <Hide Axis = "8" Layer = "1" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />
        <ShowAll/>
    </Figure>
</xml>
