<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter 3x3 Hybrid</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Helicopter 3x3 Hybrid</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-25</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=31061</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = " 0; -1;  1" />
        <Axis NormVector = "-1;  0;  1" />
        <Axis NormVector = "-1;  1;  0" />
        <Axis NormVector = " 1;  1;  0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/4; 1/4" TurnAxesWithLayer="1" >
        <Axis NormVector = " 0;  0;  1" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 1;  0;  0" />
    </Axes>

   <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
   </Figure>
</xml>
