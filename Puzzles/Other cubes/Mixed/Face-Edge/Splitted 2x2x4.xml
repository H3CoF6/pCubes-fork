<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Splitted 2x2x4</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Splitted 2x2x4</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3737</Link>
    </Interface>

    <Script>
        W := 0.60;
        WX := W / 2;
        WY := W / 2;
        WZ := W;

        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
