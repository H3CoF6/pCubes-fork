<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Illatsion Cube Plus</Name>
        <Menu>Other Cubes\Mixed\Face-Edge\Illatsion Cube Plus</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-06</Added>
        <Link>https://www.instagram.com/p/BgRwX6fHRUr/</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "6" From = "1"/>
        <Split Axis = "6" From = "2"/>
        <Split Axis = "7" From = "1"/>
        <Split Axis = "7" From = "2"/>
        <Split Axis = "8" From = "1"/>
        <Split Axis = "8" From = "2"/>
        <RemoveGrayParts/>

        <Split Axis = "4" From = "1"/>
        <Split Axis = "5" From = "1"/>

        <HideContaining Vector = "Ex; Ey; Ez" />

        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
