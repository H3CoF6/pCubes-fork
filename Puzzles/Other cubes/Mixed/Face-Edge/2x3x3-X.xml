<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x3x3-X</Name>
        <Menu>Other cubes\Mixed\Face-Edge\2x3x3-X</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-04-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7357</Link>
    </Interface>
 
    <Script>
        W := 0.5;

        WX := W;
        WY := W;
        WZ := W * 2 / 3;

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
