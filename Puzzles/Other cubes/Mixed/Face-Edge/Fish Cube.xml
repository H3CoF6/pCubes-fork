<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fish Cube</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Fish Cube</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2660</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(2);
        H := D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <!-- invisible part to prevent unnecessary turns -->
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <Cut   Axis = "0" From = "1" />
        <Cut   Axis = "0" To   = "3" />
        <Cut   Axis = "1" From = "1" />
        <Cut   Axis = "1" To   = "3" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <HideAll/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />

        <SplitByAxes/>
    </Figure>
</xml>
