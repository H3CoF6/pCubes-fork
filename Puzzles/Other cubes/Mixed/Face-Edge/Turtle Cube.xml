<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Turtle Cube</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Turtle Cube</Menu>
        <Inventor>Troy Robinson</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6810</Link>
    </Interface>

     <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.15;
        B := W * 0.2;

        D := W / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <Split Axis = "2" From = "1"/>
        <Split Axis = "2" From = "2"/>
        <Turn  Axis = "2" Angle = "Pi/4" Layer = "1" />
        <SplitByAxes/>
        <Undo/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
