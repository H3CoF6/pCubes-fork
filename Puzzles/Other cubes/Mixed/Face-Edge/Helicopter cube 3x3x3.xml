<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter cube 3x3x3</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Helicopter cube 3x3x3</Menu>
        <Inventor>Jason Smith</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4757</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        Width333 := W / 8;
        D := W / sqrt(2) + Width333 / sqrt(2);
    </Script>
 
    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-Width333; Width333" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
 
        <SplitByAxes/>
    </Figure>
</xml>
