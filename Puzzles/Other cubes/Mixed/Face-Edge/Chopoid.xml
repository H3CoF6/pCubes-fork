<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chopoid</Name>
        <Menu>Other cubes\Mixed\Face-Edge\Chopoid</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6378</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;

        WX := W;
        WY := W;
        WZ := W * 3/2;

        D := W / sqrt(2);
        Ax := W / 2;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0;-1; 1" BaseVector = "0; 0; Ax"/>
        <Axis NormVector = "-1; 0; 1" BaseVector = "0; 0; Ax"/>
        <Axis NormVector = " 0; 1; 1" BaseVector = "0; 0; Ax"/>
        <Axis NormVector = " 1; 0; 1" BaseVector = "0; 0; Ax"/>
        <Axis NormVector = " 0; 1;-1" BaseVector = "0; 0;-Ax"/>
        <Axis NormVector = " 1; 0;-1" BaseVector = "0; 0;-Ax"/>
        <Axis NormVector = " 0;-1;-1" BaseVector = "0; 0;-Ax"/>
        <Axis NormVector = "-1; 0;-1" BaseVector = "0; 0;-Ax"/>
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>

        <Turn Axis = "0" Angle = "Pi" Layer = "1" />
        <Turn Axis = "2" Angle = "Pi" Layer = "1" />
        <Turn Axis = "4" Angle = "Pi" Layer = "1" />
        <Turn Axis = "6" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "Pi" Layer = "1" />
        <Turn Axis = "3" Angle = "Pi" Layer = "1" />
        <Turn Axis = "5" Angle = "Pi" Layer = "1" />
        <Turn Axis = "7" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>

        <Undo Repeat = "8"/>
    </Figure>
</xml>
