<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x4x4 with a partial twist</Name>
        <Menu>Other cubes\Mixed\Face-Edge\4x4x4 with a partial twist</Menu>
        <Inventor>Mike Armbrust</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-08-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4431</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        D := 1/4;
        D2 := sqrt(2)*3/8;

        // Bumps to avoid illegal single edge rotation
        // Height must be larger than sqrt(2)*3/8-0.5 = 0.03033...
        BHeight := 0.035;
        B1 := W + BHeight;
        B2 := 0.001; //D - BHeight;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "1">
        <Axis NormVector = "1; 0; 0"/>
        <Axis NormVector = "0; 1; 0"/>
        <Axis NormVector = "0; 0; 1"/>
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2; D2" FixedLayers = "1">
        <Axis NormVector = " 0; 1; 1"/>
        <Axis NormVector = " 0; 1;-1"/>
        <Axis NormVector = " 1; 0; 1"/>
        <Axis NormVector = "-1; 0; 1"/>
        <Axis NormVector = " 1; 1; 0"/>
        <Axis NormVector = " 1;-1; 0"/>
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
                <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
                <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />

                <Add Vector = "-B1; B2; B2" />
                <Add Vector = "-B1;-B2; B2" />
                <Add Vector = "-B1;-B2;-B2" />
                <Add Vector = "-B1; B2;-B2" />
                <Add Vector = " B1; B2; B2" />
                <Add Vector = " B1;-B2; B2" />
                <Add Vector = " B1;-B2;-B2" />
                <Add Vector = " B1; B2;-B2" />
                <Add Vector = " B2;-B1; B2" />
                <Add Vector = " B2;-B1;-B2" />
                <Add Vector = "-B2;-B1;-B2" />
                <Add Vector = "-B2;-B1; B2" />
                <Add Vector = " B2; B1; B2" />
                <Add Vector = " B2; B1;-B2" />
                <Add Vector = "-B2; B1;-B2" />
                <Add Vector = "-B2; B1; B2" />
                <Add Vector = " B2; B2;-B1" />
                <Add Vector = "-B2; B2;-B1" />
                <Add Vector = "-B2;-B2;-B1" />
                <Add Vector = " B2;-B2;-B1" />
                <Add Vector = " B2; B2; B1" />
                <Add Vector = "-B2; B2; B1" />
                <Add Vector = "-B2;-B2; B1" />
                <Add Vector = " B2;-B2; B1" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />

                <Face VertexIndexes = " 8; 9;10;11" InvisibleEdges = "15" />
                <Face VertexIndexes = "15;14;13;12" InvisibleEdges = "15" />
                <Face VertexIndexes = "16;17;18;19" InvisibleEdges = "15" />
                <Face VertexIndexes = "23;22;21;20" InvisibleEdges = "15" />
                <Face VertexIndexes = "24;25;26;27" InvisibleEdges = "15" />
                <Face VertexIndexes = "31;30;29;28" InvisibleEdges = "15" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1"/>
        <Split Axis = "0" From = "2"/>
        <Split Axis = "0" From = "3"/>
        <Split Axis = "1" From = "1"/>
        <Split Axis = "1" From = "2"/>
        <Split Axis = "1" From = "3"/>
        <Split Axis = "2" From = "1"/>
        <Split Axis = "2" From = "2"/>
        <Split Axis = "2" From = "3"/>

        <Hide  Axis = "0" Layer = "0"/>
        <Hide  Axis = "0" Layer = "3"/>
        <Split Axis = "3" From = "1"/>
        <Split Axis = "3" From = "2"/>
        <Split Axis = "4" From = "1"/>
        <Split Axis = "4" From = "2"/>
        <Turn  Axis = "3" Layer = "0" Angle = "Pi/2"/>
        <Turn  Axis = "3" Layer = "2" Angle = "Pi/2"/>
        <Turn  Axis = "4" Layer = "0" Angle = "Pi/2"/>
        <Turn  Axis = "4" Layer = "2" Angle = "Pi/2"/>
        <Split Axis = "0" From = "2"/>
        <Undo  Repeat ="4"/>
        <ShowAll/>

        <Hide  Axis = "1" Layer = "0"/>
        <Hide  Axis = "1" Layer = "3"/>
        <Split Axis = "5" From = "1"/>
        <Split Axis = "5" From = "2"/>
        <Split Axis = "6" From = "1"/>
        <Split Axis = "6" From = "2"/>
        <Turn  Axis = "5" Layer = "0" Angle = "Pi/2"/>
        <Turn  Axis = "5" Layer = "2" Angle = "Pi/2"/>
        <Turn  Axis = "6" Layer = "0" Angle = "Pi/2"/>
        <Turn  Axis = "6" Layer = "2" Angle = "Pi/2"/>
        <Split Axis = "1" From = "2"/>
        <Undo  Repeat ="4"/>
        <ShowAll/>

        <Hide  Axis = "2" Layer = "0"/>
        <Hide  Axis = "2" Layer = "3"/>
        <Split Axis = "7" From = "1"/>
        <Split Axis = "7" From = "2"/>
        <Split Axis = "8" From = "1"/>
        <Split Axis = "8" From = "2"/>
        <Turn  Axis = "7" Layer = "0" Angle = "Pi/2"/>
        <Turn  Axis = "7" Layer = "2" Angle = "Pi/2"/>
        <Turn  Axis = "8" Layer = "0" Angle = "Pi/2"/>
        <Turn  Axis = "8" Layer = "2" Angle = "Pi/2"/>
        <Split Axis = "2" From = "2"/>
        <Undo  Repeat ="4"/>
        <ShowAll/>

    </Figure>
</xml>
