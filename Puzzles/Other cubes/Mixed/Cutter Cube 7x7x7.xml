<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cutter Cube 7x7x7</Name>
        <Menu>Other cubes\Mixed\Cutter Cube 7x7x7</Menu>
        <Inventor>Coren Broughton</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3675</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := 0.45;

        D1 := D * 1 / 7;
        D2 := D * 3 / 7;
        D3 := D * 5 / 7;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D3; -D2; -D1; D1; D2; D3" TurnAxesWithLayer = "3" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />

        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi/4" />
        <Turn Axis = "2" Layer = "5" Angle = "Pi/4" />

        <SplitByAxes/>

        <Undo Repeat = "3" />

        <RemoveGrayParts/>
    </Figure>
</xml>
