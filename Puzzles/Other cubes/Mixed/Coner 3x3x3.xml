<?xml version = "1.0" encoding = "UTF-8"?>

<xml Data_Version = "2" >
    <Interface>
        <Name>Coner 3x3x3</Name>
        <Menu>Other cubes\Mixed\Coner 3x3x3</Menu>
        <Inventor>Minh Sanghsu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-08-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3069</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / (1 + sqrt(2));
        D1 := W * (sqrt(3) - sqrt(2 / 3));
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
