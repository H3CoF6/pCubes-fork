<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Grilles I</Name>
        <Aliases>Cell Cube I</Aliases>
        <Menu>Other cubes\Mixed\Face-Vertex\Grilles I</Menu>
        <Inventor>Mr. Fok</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11033</Link>
        <Added>2017-02-07</Added>
    </Interface>

    <Script>
        W  := 0.5;
        D1 := W * 0.6;
        D2 := (W + D1) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
