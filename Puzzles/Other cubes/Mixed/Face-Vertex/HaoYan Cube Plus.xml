<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>HaoYan Cube Plus</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\HaoYan Cube Plus</Menu>
        <Inventor>limCube</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2021-04-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8396</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36489</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W * sqrt(3) / 6;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.982;
    </Script>

    <Axes TurningAngles = "Pi*2/3; Pi/6; Pi/6; Pi*2/3" PlaneDistances = " D; 0;-D">
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn  Axis = "Ax" Layers = "1;2" Angle = "Pi/6" />
            <Split Axis = "4" From = "1" />
            <Split Axis = "5" From = "1" />
            <Split Axis = "6" From = "1" />
            <Turn  Axis = "Ax" Layers = "1;2" Angle = "-Pi/3" />
            <Split Axis = "4" From = "1" />
            <Split Axis = "5" From = "1" />
            <Split Axis = "6" From = "1" />
            <RemoveGrayParts/>
            <Undo Repeat = "2" />
            <Script>Inc(Ax);</Script>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Ax = "0" Repeat = "4" />

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
