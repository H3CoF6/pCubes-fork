<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Slice Skewb</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Slice Skewb</Menu>
        <Inventor>Luke Benjii</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6648</Link>
    </Interface>

    <Script>
        W := 0.5;
 
        RCut := sqrt(3) / 2 - 0.04;
        RCu2 := sqrt(2) / 2 - 0.01;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Connect Axis = "0" Layers = "0;2" />
        <Connect Axis = "1" Layers = "0;2" />
        <Connect Axis = "2" Layers = "0;2" />

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1;-1" NormDistance = "-RCu2" /> </Cut>
    </Figure>
</xml>
