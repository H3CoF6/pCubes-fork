<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb + Crazy 3x3x3</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Skewb + Crazy 3x3x3\Skewb + Crazy 3x3x3</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-11</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=116055&amp;extra=page%3D1</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4;
        R := W * 0.55;
        WC := W * 1.004;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.985;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W;-D; D; W" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;  0;  0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;  0;  0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0;-WC;  0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0; WC;  0" />
        <Circle Radius = "R" Color = "clYellow" Center = "  0;  0;-WC" />
        <Circle Radius = "R" Color = "clWhite " Center = "  0;  0; WC" />

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Connect Axis = "0" Layers = "0;2;4" />
        <Connect Axis = "1" Layers = "0;2;4" />
        <Connect Axis = "2" Layers = "0;2;4" />

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
       Cross = 90,0,0, 99,0,0, 108,0,0, 117,0,0, 126,0,0, 135,0,0
    </SetTextures>
</xml>
