<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb + Crazy 3x3x3 - Neptune</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Skewb + Crazy 3x3x3\Neptune</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-13</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=116055&amp;extra=page%3D1</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4;
        R := W * 0.55;
        WC := W * 1.004;
        W2 := WC + WC - W;

        WX := WC - W;
        WY := D;
        WZ := D;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.985;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W2;-W;-D; D; W; W2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;  0;  0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;  0;  0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0;-WC;  0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0; WC;  0" />
        <Circle Radius = "R" Color = "clYellow" Center = "  0;  0;-WC" />
        <Circle Radius = "R" Color = "clWhite " Center = "  0;  0; WC" />

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Connect Axis = "0" Layers = "0;3;6" />
        <Connect Axis = "1" Layers = "0;3;6" />
        <Connect Axis = "2" Layers = "0;3;6" />

        <!-- Add invisible parts to connect layers -->
        <HideAll/>
        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <Macro Name = "AddInvisible" >
            <LoadFrom File = "Figures\Cuboid.xml" DWX = "-W - 2 * WX * Fixed1" />
            <Turn NormVector = "0;1;0" Angle = "Pi" />
            <LoadFrom File = "Figures\Cuboid.xml" DWX = "-W - 2 * WX * Fixed2" />
            <Turn NormVector = "0;1;0" Angle = "Pi" />
            <Turn NormVector = "1;1;1" Angle = "-2 * Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "AddInvisible" Fixed1 = "1" Fixed2 = "0" /> // red-orange
        <ExecMacro MacroName = "AddInvisible" Fixed1 = "1" Fixed2 = "0" /> // blue-green
        <ExecMacro MacroName = "AddInvisible" Fixed1 = "1" Fixed2 = "0" /> // yellow-white
        <InvertVisibility/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
       Cross = 90,0,0, 108,0,0, 126,0,0
    </SetTextures>
</xml>
