<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corona Cube</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Corona Cube</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6110</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1:= 0.3;
        D2:= sqrt(3) / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1;D1" FixedLayers = "1" >
        <Axis NormVector = " 0;  0;  1" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 1;  0;  0" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
