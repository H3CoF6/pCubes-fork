<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unicorn 2x2x2</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Unicorn 2x2x2</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9514</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W * sqrt(3) / 2;

        RCut := W * 1.35;
    </Script>
 
    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D; D" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />

        <!-- cut vertices for better control -->
        <Macro Name = "CutVertex">
            <HideContaining Vector = "Vx[v]; Vy[v]; Vz[v]" />
            <Cut> <Plane NormVector = "-Vx[v];-Vy[v];-Vz[v]" NormDistance = "-RCut" /> </Cut>
        </Macro>
        <ExecMacro MacroName = "CutVertex" v = "0" />
        <ExecMacro MacroName = "CutVertex" v = "3" />
        <ExecMacro MacroName = "CutVertex" v = "5" />
        <ExecMacro MacroName = "CutVertex" v = "6" />
        <ShowAll/>

    </Figure>
</xml>
