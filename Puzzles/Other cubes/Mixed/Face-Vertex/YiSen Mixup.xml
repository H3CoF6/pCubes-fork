<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>YiSen Mixup</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\YiSen Mixup</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-23</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=403032</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0055EE'; // Blue
        Colors[3] := '00BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'CCCCCC'; // LightGray

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.985;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "2" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "2" />

        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "2" />

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
