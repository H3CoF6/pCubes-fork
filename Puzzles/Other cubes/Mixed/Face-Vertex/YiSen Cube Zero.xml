<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>YiSen Cube Zero</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\YiSen Cube Zero</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2021-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8522</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36426</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.985;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "1" Angle = "Pi/4" />
        <Split Axis = "3" From = "1"/>
        <Split Axis = "4" From = "1"/>
        <Split Axis = "5" From = "1"/>
        <Split Axis = "6" From = "1"/>
        <Undo/>

        <Turn  Axis = "1" Layer = "1" Angle = "Pi/4" />
        <Split Axis = "3" From = "1"/>
        <Split Axis = "4" From = "1"/>
        <Split Axis = "5" From = "1"/>
        <Split Axis = "6" From = "1"/>
        <Undo/>

        <Turn  Axis = "2" Layer = "1" Angle = "Pi/4" />
        <Split Axis = "3" From = "1"/>
        <Split Axis = "4" From = "1"/>
        <Split Axis = "5" From = "1"/>
        <Split Axis = "6" From = "1"/>
        <Undo/>

        <!-- remove some (not all) gray parts -->
        <Macro Name = "HideGray2" >
            <HideContaining Vector = " D; D; W" />
            <HideContaining Vector = " D; D;-W" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2"/>
        </Macro>
        <Macro Name = "HideGray" >
            <ExecMacro MacroName = "HideGray2" Repeat = "4" />
            <Turn NormVector = "1;1;1" Angle = "2 * Pi / 3"/>
        </Macro>
        <ExecMacro MacroName = "HideGray" Repeat = "3" />
        <RemoveGrayParts/>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
