<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Coner 3x3x3</Name>       
        <Menu>Other cubes\Mixed\Face-Vertex\Double Coner 3x3x3</Menu>
        <Inventor>limCube</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8535</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36442</Link>
    </Interface>

    <Script>
        W  := 0.5;
        D1 := W * 2 / 3;
        D2 := W * 2 / sqrt(3);
        D3 := (W + 2 * D1) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D3;-D2; D2; D3" FixedLayers = "2" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
