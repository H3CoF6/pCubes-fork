<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unicorn</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Unicorn</Menu>
        <Inventor>Mr. Fok</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-08-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6763</Link>
    </Interface>
 
    <Script>
        W := 0.5;

        D1 := W * (sqrt(2) - 1);
        D2 := (2 * W - D1) / sqrt(3);
    </Script>
 
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />

        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
