<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x2+Rex</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\2x2x2+Rex</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9185</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / sqrt(3);
        A := W * 1.3;
        B := A - W;

        RCut := W * sqrt(3) * 0.95;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <!-- cut vertices for better control -->
        <HideContaining Vector = "Ex;Ey;Ez" />
        <InvertVisibility/>
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
