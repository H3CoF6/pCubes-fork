<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb Rex 2x2x2</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Skewb Rex 2x2x2</Menu>
        <Inventor>Minh Sanghsu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4539</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 2 * sqrt(3) / 9;
        RCut := W * 8 / 3 / sqrt(3);
        RCu2 := W * (sqrt(2) - 0.02);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>
    </Figure>
</xml>
