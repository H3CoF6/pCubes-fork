<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Redi 3x3x3</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Redi\Redi 3x3x3</Menu>
        <Inventor>Eric Vergo</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-11-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1995</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.2;
        B := W * 0.7;

        D := A / sqrt(3);
        W1 := W * 0.7;

        RCut := W * 1.56;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-B/2;B/2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3;0;2*Pi/3" PlaneDistances = "-D;D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "HideEdges" >
            <HideContaining Vector = " W1; W; W" />
            <HideContaining Vector = " W1; W;-W" />
            <HideContaining Vector = " W1;-W; W" />
            <HideContaining Vector = " W1;-W;-W" />
            <HideContaining Vector = "-W1; W; W" />
            <HideContaining Vector = "-W1; W;-W" />
            <HideContaining Vector = "-W1;-W; W" />
            <HideContaining Vector = "-W1;-W;-W" />

            <HideContaining Vector = " W; W1; W" />
            <HideContaining Vector = " W; W1;-W" />
            <HideContaining Vector = "-W; W1; W" />
            <HideContaining Vector = "-W; W1;-W" />
            <HideContaining Vector = " W;-W1; W" />
            <HideContaining Vector = " W;-W1;-W" />
            <HideContaining Vector = "-W;-W1; W" />
            <HideContaining Vector = "-W;-W1;-W" />

            <HideContaining Vector = " W; W; W1" />
            <HideContaining Vector = " W;-W; W1" />
            <HideContaining Vector = "-W; W; W1" />
            <HideContaining Vector = "-W;-W; W1" />
            <HideContaining Vector = " W; W;-W1" />
            <HideContaining Vector = " W;-W;-W1" />
            <HideContaining Vector = "-W; W;-W1" />
            <HideContaining Vector = "-W;-W;-W1" />
        </Macro>

        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes />
        <ExecMacro MacroName = "HideEdges" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>

        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <!-- cut vertices for better control -->
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <ExecMacro MacroName = "HideEdges" />

        <RemoveAllVisible/>
        <InvertVisibility/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
