<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Offset Skewb 2x2x2 II</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Offset Skewb 2x2x2 II</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-09-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1771</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * sqrt(3) / 6;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.982;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "6" From = "2" />
        <RemoveGrayParts/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
