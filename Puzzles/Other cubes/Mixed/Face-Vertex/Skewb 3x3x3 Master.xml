<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb 3x3x3 Master</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Skewb 3x3x3 Master</Menu>
        <Inventor>Minh Sanghsu (Arvin Hsu)</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-01-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3334</Link>
    </Interface>

    <Script>
        W := 0.5;
 
        D := sqrt(3) / 12;
        RCut := sqrt(3) / 2 - 0.04;
        RCu2 := sqrt(2) / 2 - 0.01;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-0.25; 0.25">
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi*2/3; 0; Pi*2/3" PlaneDistances = "-D; D">
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>
    </Figure>
</xml>
