<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Coner+3x3x3+Skewb</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Coner+3x3x3+Skewb</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8534</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36443</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.23;
        B := W * 0.5;
        D := W * 2 / sqrt(3);
        D2 := W * (2 * A - B) / (A - B + W) / 2;

        DCutV := W * 0.79;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;D2" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Macro Name = "CutVertex" >
            <Split> <Plane NormVector = "1; 1; 1" NormDistance = "D" /> </Split>
            <HideContaining Vector = "W; W; W" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = "-3; 1; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1;-3; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1; 1;-3" NormDistance = "-DCutV" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
