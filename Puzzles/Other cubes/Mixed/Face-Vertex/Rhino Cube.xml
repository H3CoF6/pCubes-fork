<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhino cube</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Rhino cube</Menu>
        <Inventor>Nikola Tutic</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-09-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2733</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 5 * sqrt(3) / 9;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3; 0; Pi * 2 / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "2" From  = "1" />
        <Split Axis = "2" From  = "2" />
        <Split Axis = "3" From  = "2" />
        <Split Axis = "4" From  = "2" />
        <Split Axis = "5" From  = "2" />
        <Split Axis = "6" From  = "2" />

        <Hide  Axis = "0" Layer = "1" />
        <Hide  Axis = "1" Layer = "1" />
        <Hide  Axis = "2" Layer = "1" />
        <Split Axis = "3" From  = "1" />
        <Split Axis = "4" From  = "1" />
        <Split Axis = "5" From  = "1" />
        <Split Axis = "6" From  = "1" />

        <ShowAll/>
        <RemoveGrayParts/>

    </Figure>
</xml>
