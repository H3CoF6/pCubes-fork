<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unicorn Crazy</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Unicorn Crazy</Menu>
        <Inventor>Mr. Fok</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-08-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6700</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D1 := W * (sqrt(2) - 1);
        D2 := W * 2 * (1 - D1) / sqrt(3);

        Delta := 0.002;
        R := D1 * sqrt(2);
        D := W + Delta;

        RCut := W * 1.33;
    </Script>
 
    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; -D1; D1; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clBlue  " Center = " 0; -D;  0" />
        <Circle Radius = "R" Color = "clOrange" Center = " D;  0;  0" />
        <Circle Radius = "R" Color = "clRed   " Center = "-D;  0;  0" />
        <Circle Radius = "R" Color = "clGreen " Center = " 0;  D;  0" />
        <Circle Radius = "R" Color = "clWhite " Center = " 0;  0;  D" />
        <Circle Radius = "R" Color = "clYellow" Center = " 0;  0; -D" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />

        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "2" />
        <Hide Axis = "2" Layer = "2" />
        <SplitByAxes/>
        <ShowAll/>

        <!-- cut vertices for better control -->
        <HideContaining Vector = "Ex;Ey;Ez" />
        <InvertVisibility/>
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <ShowAll/>

        <Connect Axis = "0" Layers = "0;2;4" />
        <Connect Axis = "1" Layers = "0;2;4" />
        <Connect Axis = "2" Layers = "0;2;4" />
    </Figure>

</xml>
