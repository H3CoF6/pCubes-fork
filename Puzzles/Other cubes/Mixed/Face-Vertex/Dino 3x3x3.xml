<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino 3x3x3</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Dino 3x3x3</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1688</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W / 3;
        D2 := W / sqrt(3);

        CutV := W * sqrt(3) * 0.96;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3; 0; Pi * 2 / 3" PlaneDistances = "-D2; D2" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <!-- cut vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />
    </Figure>
</xml>
