<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Grilles III</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Grilles III</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-04</Added>
        <Link>http://shop.mf8-china.com/index.php?route=product/product&amp;path=60&amp;product_id=109</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.35;
        D := A / sqrt(3);
        D2 := W * 0.75;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; D2" FixedLayers = "1">
        <Axis NormVector = " 1;  0;  0" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 0;  0;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
