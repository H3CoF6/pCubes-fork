<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Carnation Cube</Name>
        <Menu>Other cubes\Mixed\Face-Vertex\Carnation Cube</Menu>
        <Inventor>Linxiao Xu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8699</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36641</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // clRed
        Colors[1] := 'FF6600'; // clOrange
        Colors[2] := '0055EE'; // clBlue
        Colors[3] := '00BB00'; // clGreen
        Colors[4] := 'FFEE00'; // clYellow
        Colors[5] := 'FFFFFF'; // clWhite

        W := 0.5;
        A := W * 1.3;
        B := W * 2 - A;

        D1 := W * 1.1;
        D2 := W * 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi / 6" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Macro Name = "Split">
            <Split Axis = "i" From = "1"  />
            <Split Axis = "i" From = "2"  />
            <Turn Axis = "i" Layer = "0" Angle = "Pi/3" />
            <Turn Axis = "i" Layer = "2" Angle = "Pi/3" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" i = "3" Repeat = "4" />

        <SplitByAxes/>
        <Undo Repeat = "8" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
