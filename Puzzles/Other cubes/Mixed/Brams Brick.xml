<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bram's Brick</Name>
        <Menu>Other cubes\Mixed\Bram's Brick</Menu>
        <Inventor>Eric Vergo</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-06-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2195</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := 1 / 6 * Sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector =  "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-sqrt(2)/6; sqrt(2)/6" >
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1; -1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
