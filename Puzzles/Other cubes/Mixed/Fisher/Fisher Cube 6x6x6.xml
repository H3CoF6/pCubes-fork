<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher cube 6x6x6</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher cube 6x6x6</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9845</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5 / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-4*D;-2*D; 0; 2*D; 4*D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
