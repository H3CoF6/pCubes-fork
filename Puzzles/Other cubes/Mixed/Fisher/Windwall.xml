<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windwall</Name>
        <Aliases>Chester 4x4x4 Windwall Cube</Aliases>
        <Aliases>Calvin's 4x4x4 Windmill Extreme Cube</Aliases>
        <Menu>Other cubes\Mixed\Fisher\Windwall</Menu>
        <Inventor>Chester de Guzman</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6652</Link>
        <Link>https://www.hknowstore.com/locale/en-US/item.aspx?itemid=ca18445f-bef3-4c5d-90f5-60d87c6130d1</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0033EE'; // Blue
        Colors[3] := '00BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        D := W / 2;

        Angle := Pi / 6;
    </Script>

    <Axes TurningAngles = "Angle" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-Angle" />
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "2" Layers = "0;3" Angle = "Angle" />
        <SplitByAxes/>
        <Undo/>
    </Figure>
</xml>
