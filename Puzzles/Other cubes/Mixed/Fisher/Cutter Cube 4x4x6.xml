<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cutter Cube 4x4x6</Name>
        <Menu>Other cubes\Mixed\Fisher\Cutter Cube 4x4x6</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9843</Link>
    </Interface>
 
    <Script>
        W := 0.4;

        WX := W * sqrt(2) * 0.95;
        WY := W;
        WZ := W;
        D1 := WX / 3;
        D2 := D1 * 2;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D2;-D1; 0; D1; D2" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Turn Axis = "0" Layers = "1;3;5" Angle = "Pi/4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Undo/>
        <RemoveGrayParts/>
    </Figure>
</xml>
