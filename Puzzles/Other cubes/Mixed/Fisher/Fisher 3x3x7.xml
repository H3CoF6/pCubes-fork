<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher 3x3x7</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher 3x3x7</Menu>
        <Inventor>Cube4You</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-02-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10938</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 9;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi/4" />
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Turn Axis = "0" Layers = "3-5" Angle = "Pi/2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "6" />
        <Turn Axis = "1" Layers = "3-5" Angle = "Pi/2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "8" />

        <Hide Axis = "2" Layers = "0;8" />
        <Hide Axis = "0" Layers = "0-2;6-8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "8" />
        <ShowAll/>
        <Hide Axis = "2" Layers = "0;8" />
        <Hide Axis = "1" Layers = "0-2;6-8" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <ShowAll/>
        <RemoveGrayParts/>
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "7" />

        <Undo Repeat = "2" />
    </Figure>

    <!-- Scramble macro -->
    <Macros>
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(9)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(9)" Angle = "Pi/2 * Random(4)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(9)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "0" Layers = "3-5" Angle = "Pi/2" />
            <Turn Axis = "1" Layers = "3-5" Angle = "Pi/2" />
            <ExecMacro MacroName = "Sc1" Repeat = "500" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
