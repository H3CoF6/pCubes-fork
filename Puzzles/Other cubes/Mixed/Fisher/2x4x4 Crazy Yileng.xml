<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x4x4 Crazy Yileng</Name>
        <Menu>Other cubes\Mixed\Fisher\2x4x4 Crazy Yileng</Menu>
        <Inventor>César Gustavo Hernández Martínez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-08-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9805</Link>
    </Interface>

    <Script>
        W := 0.5;
        D :=  W / sqrt(10);

        WX := W;
        WY := W;
        WZ := W / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 4" />
        <Turn NormVector = "-1; 1; 0" Angle = "arctan(1/2)" />

        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
    </Figure>
</xml>
