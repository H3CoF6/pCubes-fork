<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Cross 3x3x5</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher Cross 3x3x5</Menu>
        <Inventor>lic.har</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-03-12</Added>
        <Link>https://www.instagram.com/p/CGF5XR0HSVe/</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0033EE'; // Blue
        Colors[3] := '00BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2*D;-D; D; 2*D" >
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />

        <HideContaining Vector = "Vx;Vy;Vz" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <InvertVisibility/>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "Random180" >
            <Turn Axis = "Random(2)" Layer = "Random(5)" Angle = "Pi"/>
            <Turn Axis = "2" Layer = "Random(5)" Angle = "Pi/2"/>
        </Macro>
        <Macro Name = "RandomTurn" >
            <Turn Axis = "Random(3)" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" >
            <Turn Axis = "0" Layer = "2" Angle = "Pi/2"/>
            <Turn Axis = "1" Layer = "2" Angle = "Pi/2"/>
            <ExecMacro MacroName = "Random180" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurn" Repeat = "2000" />
        </Macro>
    </Macros>
</xml>
