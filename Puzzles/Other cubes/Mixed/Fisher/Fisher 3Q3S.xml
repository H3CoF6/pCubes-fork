<?xml version="1.0" encoding = "UTF-8" ?>
<xml Data_Version="2">

    <Interface>
        <Name>Fisher 3Q3S</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher 3Q3S</Menu>
        <Inventor>Mark Lodge</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11370</Link>
    </Interface>

    <Script>
        BackColor := 'E0C07D';
        MirrorColor := 'BBBBBB';

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 4" />

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <SplitByAxes/>
        <HideAll/>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "BackColor" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <RemoveContaining Vector = "0;0;0" />
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
