<?xml version="1.0" encoding = "UTF-8" ?>
<xml Data_Version="2">

    <Interface>
        <Name>Bandaged 3 Fisher</Name>
        <Menu>Other cubes\Mixed\Fisher\Bandaged 3 Fisher</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9526</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 4" />
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />

        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "2" />
        <SplitByAxes/>
        <ShowAll/>

        <Hide Axis = "1" Layer = "2" />
        <Hide Axis = "2" Layer = "2" />
        <SplitByAxes/>
        <ShowAll/>

        <Hide Axis = "2" Layer = "2" />
        <Hide Axis = "0" Layer = "2" />
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
