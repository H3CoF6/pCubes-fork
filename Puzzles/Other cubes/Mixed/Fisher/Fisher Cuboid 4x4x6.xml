<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Cuboid 4x4x6</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher Cuboid 4x4x6</Menu>
        <Inventor>Dan Fast</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5181</Link>
    </Interface>
 
    <Script>
        W := 0.4;

        WX := W * sqrt(2) * 0.95;
        WY := W;
        WZ := W;
        D1 := WX / 3;
        D2 := D1 * 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; 0; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 1" />
        <Axis NormVector = "0; 1;-1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
