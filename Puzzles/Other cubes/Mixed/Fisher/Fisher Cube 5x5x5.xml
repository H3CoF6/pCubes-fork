<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher cube 5x5x5</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher cube 5x5x5</Menu>
        <Inventor>Charlie Messinger</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6142</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4 / sqrt(2);

        WX := W;
        WY := W;
        WZ := D * 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3*D;-D; D; 3*D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
