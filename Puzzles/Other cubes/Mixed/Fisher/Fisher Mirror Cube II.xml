<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Mirror Cube II</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher Mirror Cube II</Menu>
        <Menu>Other cubes\3x3x3 variants\Fisher Mirror Cube II</Menu>
        <Inventor>Joel Arturo Torres Navarro</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-01-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9611</Link>
    </Interface>

    <Script>
        MirrorColor := '30305D';

        W := 0.5;
        D := W * 0.3;

        DX :=-W * 0.22;
        DY := W * 0.03;
        DZ := W * 0.10;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi / 4" />
        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />
        <Transfer Vector = " DX; DY; DZ" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
