<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Cuboid 4x4x5</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher Cuboid 4x4x5</Menu>
        <Inventor>Calvin Fan</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6767</Link>
    </Interface>
 
    <Script>
        W := 0.4;

        WX := W * 1.3;
        WY := W;
        WZ := W;
        D1 := WX / 5;
        D2 := W / 3 * sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1*3;-D1; D1; D1*3" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = "0; 1; 1" />
        <Axis NormVector = "0; 1;-1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
