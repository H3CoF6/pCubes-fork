<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windmill Skewb</Name>
        <Menu>Other cubes\Mixed\Fisher\Windmill Skewb</Menu>
        <Inventor>Jay Hensley</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8092</Link>
    </Interface>

    <Script>
        W := 0.5;
        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.982;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-0.52" />
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
