<?xml version="1.0" encoding = "UTF-8" ?>
<xml Data_Version="2">

    <Interface>
        <Name>Windmill Mirror 2x2x2</Name>
        <Menu>Other cubes\Mixed\Fisher\Windmill Mirror 2x2x2</Menu>
        <Inventor>César Gustavo Hernández Martínez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11399</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        W := 0.5;

        DX := W * 0.2;
        DY := W * 0.1;
        DZ :=-W * 0.15;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 6" />

        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />
        <Transfer Vector = " DX; DY; DZ" />

        <SplitByAxes/>

        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
