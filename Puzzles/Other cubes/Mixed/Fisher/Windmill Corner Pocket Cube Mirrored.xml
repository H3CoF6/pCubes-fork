<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windmill Corner Pocket Cube Mirrored</Name>
        <Menu>Other cubes\Mixed\Fisher\Windmill Corner Pocket Cube Mirrored</Menu>
        <Inventor>Wu Zhe</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-11-23</Added>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?p=425505</Link>
    </Interface>

    <Script>
        MirrorColor := 'FF7CC0'; // Pink

        W := 0.5;
        D := W / 3;

        DWX := W * 0.138;
        DWY :=-W * 0.23;
        DWZ := W * 0.15;

        Angle := 0.55;
        D := (W - DWX) * cos(Angle) + (-W - DWY) * sin(Angle);

        // D := W / 3;
        // Angle := 2 * Arctan((W - DWX - D) / (W + DWY + sqrt((W - DWX)^2 + (W + DWY)^2 -D^2)));
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Angle" />
        <Transfer Vector = " DWX; DWY; DWZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />
        <InvertVisibility/>
        <LoadFrom File = "Figures\Cube.xml" />
        <Transfer Vector = "-DWX;-DWY;-DWZ" />

        <Cut Axis = "0" To   = "2" />
        <Cut Axis = "1" To   = "2" />
        <Cut Axis = "2" From = "1" />
        <SplitByAxes/>
        <InvertVisibility/>

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <RemoveContaining Vector = "0;0;0" />

        <Hide  Axis = "0" To   = "1" />
        <Hide  Axis = "1" To   = "1" />
        <Split Axis = "2" From = "2" />
        <ShowAll/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
