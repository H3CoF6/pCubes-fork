<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher cube 7x7x7</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher cube 7x7x7</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-08-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9808</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 6 / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-5*D;-3*D; -D; D; 3*D; 5*D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
