<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher AI 4x4x4</Name>
        <Menu>Other cubes\Mixed\Fisher\Fisher AI 4x4x4</Menu>
        <Inventor>Joachim Solborg</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-04-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8536</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2"/>
        <Split Axis = "1" From = "2"/>
        <Split Axis = "2" From = "2"/>

        <HideContaining Vector = " 0; W; W" />
        <HideContaining Vector = " 0;-W; W" />
        <HideContaining Vector = " W; 0;-W" />
        <HideContaining Vector = "-W; 0;-W" />
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
