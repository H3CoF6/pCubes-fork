<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Psycho Cube</Name>
        <Class>TCrazy332</Class>
        <Menu>Other cubes\Mixed\Fisher\Psycho Cube</Menu>
        <Inventor>Mohammad Badir</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8473</Link>
    </Interface>

    <Script>
        Colors[0] := 'C80000'; // Red   
        Colors[1] := 'FFFF00'; // Yellow
        Colors[2] := '0000C8'; // Blue  
        Colors[3] := 'FFFFFF'; // White 

        W := 0.5;
        WZ := W * 2 / 3;
        D := W / 3 * 0.5;

        R := W * 0.8;
        WC := WZ * 1.004;

        DCut := ((W + WZ) / sqrt(2) - D) * 0.95;

        Vx[0] :=-W; Vy[0] :=-W; Vz[0] :=-WZ;
        Vx[1] :=-W; Vy[1] :=-W; Vz[1] := WZ;
        Vx[2] :=-W; Vy[2] := W; Vz[2] :=-WZ;
        Vx[3] :=-W; Vy[3] := W; Vz[3] := WZ;
        Vx[4] := W; Vy[4] :=-W; Vz[4] :=-WZ;
        Vx[5] := W; Vy[5] :=-W; Vz[5] := WZ;
        Vx[6] := W; Vy[6] := W; Vz[6] :=-WZ;
        Vx[7] := W; Vy[7] := W; Vz[7] := WZ;

        Cx[0] :=  0; Cy[0] :=  0; Cz[0] :=-WZ;
        Cx[1] :=  0; Cy[1] :=  0; Cz[1] := WZ;

        N := 48;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2*Pi / N * i + Pi/4);
            y[i] := R * sin(2*Pi / N * i + Pi/4);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <!-- enabled (by Class TCrazy332), first is disabled when special turn occur via 2nd axis and vice versa -->
    <Axes TurningAngles = "Pi;Pi/2;Pi" PlaneDistances = "-D; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <!-- enabled (by Class TCrazy332), it's disabled when special turn occur -->
    <Axes TurningAngles = "Pi/4" PlaneDistances = "-WZ;-D; D; WZ" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <!-- disabled (by Class TCrazy332), it's enabled when special turn occur -->
    <Axes TurningAngles = "Pi" PlaneDistances = " D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "3*Pi/4" />

        <!-- cuboid -->
        <Part>
            <Vertices Vectors = " Vx; Vy; Vz" />
            <Vertices Vectors = " Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "3;1;9" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "1;5;9" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "5;7;9" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "7;3;9" InvisibleEdges = "6" />

                <Face Color = "Colors[1]" VertexIndexes = "0;2;8" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "4;0;8" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "6;4;8" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "2;6;8" InvisibleEdges = "6" />

                <Face Color = "Colors[1]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[2]" VertexIndexes = "4;5;1;0" />
                <Face Color = "Colors[3]" VertexIndexes = "6;7;5;4" />
                <Face Color = "Colors[0]" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <LoadFrom1 File = "Figures\Cuboid.xml" WX = "W" WY = "W" />

        <!-- cut to assign "0" to block cube -->
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Turn  Axis = "2" Layer = "3" Angle = "Pi/4" />
        <Split><Plane NormVector = "-1;-1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = "-D" /></Split>
        <HideAll/>

        <!-- cylinder 4-colors -->
        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Colors[c]" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Part>
            <Vertices Vectors = " x; y; WC" /> 0..N - 1
            <Vertices Vectors = " x; y;-WC" /> N..2*N - 1
            <Vertices Vectors = " 0; 0; WC" /> 2*N
            <Vertices Vectors = " 0; 0;-WC" /> 2*N + 1

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "   N/4; 2*N; FromTo(    0,   N/4 - 1)" InvisibleEdges = "3" />
                <Face Color = "Colors[1]" VertexIndexes = "   N/2; 2*N; FromTo(  N/4,   N/2 - 1)" InvisibleEdges = "3" />
                <Face Color = "Colors[2]" VertexIndexes = " 3*N/4; 2*N; FromTo(  N/2, 3*N/4 - 1)" InvisibleEdges = "3" />
                <Face Color = "Colors[3]" VertexIndexes = "0; 2*N;      FromTo(3*N/4,   N   - 1)" InvisibleEdges = "3" />
                <ExecMacro MacroName = "AddFace" i = "0" c = "0" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"         c = "1" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"         c = "2" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"         c = "3" Repeat = "N/4" />
                <Face Color = "Colors[3]" VertexIndexes = "7*N/4; 2*N + 1; N; FromTo(2 * N - 1, 7*N/4 + 1)" InvisibleEdges = "3" />
                <Face Color = "Colors[2]" VertexIndexes = "6*N/4; 2*N + 1;    FromTo(    7*N/4, 6*N/4 + 1)" InvisibleEdges = "3" />
                <Face Color = "Colors[1]" VertexIndexes = "5*N/4; 2*N + 1;    FromTo(    6*N/4, 5*N/4 + 1)" InvisibleEdges = "3" />
                <Face Color = "Colors[0]" VertexIndexes = "4*N/4; 2*N + 1;    FromTo(    5*N/4, 4*N/4 + 1)" InvisibleEdges = "3" />
            </Faces>
        </Part>

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <RemoveContaining Vector = " 0; 0; 0"/>

        <ShowAll/>

        <SplitByAxes/>
        <RemoveContaining Vector = " 0; 0;-WZ/2" />
        <RemoveContaining Vector = " 0; 0; WZ/2" />

        <HideContaining Vector = " W; 0;-WZ" />
        <InvertVisibility/>
        <Cut><Plane NormVector = " 0; 1; 1" NormDistance = "-DCut" /></Cut> <!-- mark "lock" part -->
        <Cut><Plane NormVector = " 0;-1; 1" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <Hide Axis = "2" Layer = "2" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
            WZ := D;
        </Script>

        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <ShowAll/>

        <Connect Axis = "2" Layers = "0;1;2;4" />
        <Undo/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
