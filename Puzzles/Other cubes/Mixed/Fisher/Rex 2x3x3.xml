<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rex 2x3x3</Name>
        <Menu>Other cubes\Mixed\Fisher\Rex 2x3x3</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8076</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W * 2 / 3;
        D := W * 0.2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 3 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>
