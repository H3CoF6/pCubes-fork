<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Spalt Cube Fisher</Name>
        <Menu>Other cubes\Mixed\Fisher\Spalt Cube Fisher</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9351</Link>
    </Interface>
 
    <Script>
        WX := 0.55;
        WY := WX;
        WZ := WX / 2 + 0.03;
        D := WX / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi/4" />

        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Turn Axis = "0" Layers = "2-3" Angle = "Pi" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "1" />
        <Undo/>
        <Turn Axis = "1" Layers = "2-3" Angle = "Pi" />
        <Split Axis = "0" From = "3" />
        <Undo/>
        <Split Axis = "2" From = "2" />
    </Figure>
</xml>
