<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>YAC (Yet Another Cube)</Name>
        <Menu>Other cubes\Unclassified\YAC (Yet Another Cube)</Menu>
        <Inventor>Lee Tutt</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5367</Link>
    </Interface>

    <Script>
        W := 0.5;

        for i := 0 to 2 do begin
            ax[i] := cos(Pi / 3 * i);
            ay[i] := sin(Pi / 3 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "Ax[0]; Ay[0]; 0" />
        <Axis NormVector = "Ax[1]; Ay[1]; 0" />
        <Axis NormVector = "Ax[2]; Ay[2]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
