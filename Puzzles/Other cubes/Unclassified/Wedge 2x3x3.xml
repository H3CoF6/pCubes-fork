<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Wedge 2x3x3</Name>
        <Menu>Other cubes\Unclassified\Wedge 2x3x3</Menu>
        <Inventor>Tristan Lusson</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-12-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12112</Link>
    </Interface>

    <Script>
        Color1 := 'FE8009'; // Orange
        Color2 := '333333'; // Black

        H := 0.5;
        K := 1.8;
        W := H / K;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "-K; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; K" />
    </Axes>

    <Figure>
        <Macro Name = "Half" >
            <Script>
                for i := 0 to 7 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />
            <Cut Color = "Color" ><Plane NormVector = "-K; 0; 1" /> </Cut>
            <Split Axis = "1" From = "1" Color1 = "Color" Color2 = "Color" />
            <Split Axis = "1" From = "2" Color1 = "Color" Color2 = "Color" />
            <Split Axis = "2" From = "1" Color1 = "Color" Color2 = "Color" />
            <Split Axis = "2" From = "2" Color1 = "Color" Color2 = "Color" />
            <Turn NormVector = "0;1;0" Angle = "Pi" />
        </Macro>

        <ExecMacro MacroName = "Half" Color = "Color1" />
        <HideAll/>
        <ExecMacro MacroName = "Half" Color = "Color2" />
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
