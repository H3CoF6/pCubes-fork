<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bed Cube Master</Name>
        <Menu>Other Cubes\Unclassified\Bed Cube Master</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8287</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFFFF'; // White
        Colors[1] := 'FFEE00'; // Yellow
        Colors[2] := 'FF6600'; // Orange
        Colors[3] := 'EE0000'; // Red
        Colors[4] := '0055EE'; // Blue
        Colors[5] := '00BB00'; // Green

        W := 0.5;
        D := W * 0.9;

        A := W * 1.25;
        B := W * 0.2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 6" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1;-2; 1" />
        <Axis NormVector = " 1; 1;-2" />
        <Axis NormVector = "-2; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>

        <Turn NormVector = " 1;-1;-1" Angle = "-2*Pi/3" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
