        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "-Pi / 4" />
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "5" />
        <Turn Axis = "0" Layers = "1-4" Angle = " Pi / 4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo/>
    </Figure>
