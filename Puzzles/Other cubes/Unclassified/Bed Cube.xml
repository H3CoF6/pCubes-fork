    <Script>
        Colors[0] := '0055EE'; // Blue
        Colors[1] := '00BB00'; // Green
        Colors[2] := 'FF6600'; // Orange
        Colors[3] := 'EE0000'; // Red
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        D := W * 0.674;

        A := W * 1.2;
        B := W * 0.2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 6" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D" >
        <Axis NormVector = " 1;-2; 1" />
        <Axis NormVector = " 1; 1;-2" />
        <Axis NormVector = "-2; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Split Axis = "0" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = "2*Pi/6" />
        <SplitByAxes/>
        <Undo/>
        <SaveSolvedState/>

        <Turn NormVector = "0;0;1" Angle = "Pi/2" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
