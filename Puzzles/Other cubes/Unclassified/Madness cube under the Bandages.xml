<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Madness cube under the Bandages</Name>
        <Menu>Other cubes\Unclassified\Madness cube under the Bandages</Menu>
        <Inventor>E-Cubes Designer X</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-28</Added>
        <Link>twistypuzzles.com/forum/viewtopic.php?f=9&amp;t=36880</Link>
    </Interface>

    <Script>
        W := 0.5;
        s2 := sqrt(2);

        C1 := W;
        C2 := W * (s2 - 1);
        C3 := W * (s2 + 1);

        D := W * sqrt((3 - 2 * s2) / 7);

        A1 := ArcCos(1/8);
        A2 := ArcCos(-3/4);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " C1;-C3;-C2" />
        <Axis NormVector = "-C2;-C1; C3" />
        <Axis NormVector = " C3; C2; C1" />
        <Axis NormVector = "-C1;-C2;-C3" />
        <Axis NormVector = "-C3; C1; C2" />
        <Axis NormVector = " C2; C3;-C1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Macro Name = "Split1" >
            <Turn Axis = "ax1" Layer = "1" Angle = "A2" />
            <Turn Axis = "ax2" Layer = "1" Angle = "A2" />
            <Split Axis = "ax3" From = "1" />
            <Undo Repeat = "2" />
            <Turn Axis = "ax1" Layer = "1" Angle = "-A2" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A2" />
            <Split Axis = "ax4" From = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split1" ax1 = "0" ax2 = "3" ax3 = "1" ax4 = "2" />
        <ExecMacro MacroName = "Split1" ax1 = "1" ax2 = "4" ax3 = "2" ax4 = "0" />
        <ExecMacro MacroName = "Split1" ax1 = "2" ax2 = "5" ax3 = "0" ax4 = "1" />

        <Macro Name = "Split2" >
            <Turn Axis = "ax1" Layer = "1" Angle = " A1" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A1" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split2" ax1 = "0" ax2 = "1" />
        <ExecMacro MacroName = "Split2" ax1 = "1" ax2 = "2" />
        <ExecMacro MacroName = "Split2" ax1 = "2" ax2 = "0" />
        <ExecMacro MacroName = "Split2" ax1 = "4" ax2 = "3" />
        <ExecMacro MacroName = "Split2" ax1 = "5" ax2 = "4" />
        <ExecMacro MacroName = "Split2" ax1 = "3" ax2 = "5" />
        <RemoveGrayParts/>
    </Figure>
</xml>
