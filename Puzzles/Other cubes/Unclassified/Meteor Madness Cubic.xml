<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Meteor Madness Cubic</Name>
        <Menu>Other cubes\Unclassified\Meteor Madness Cubic</Menu>
        <Inventor>Tom Koster</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6940</Link>
    </Interface>

    <Script>
        W := 0.5;

        A := 7 - 3 * sqrt(6);
        B := -7 - 3 * sqrt(6);

        D := -sqrt(42)/14 * W;

        A1 := ArcCos(0.125);
        A2 := ArcCos(-0.75);

        hide := W * 0.6;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1;A2" PlaneDistances = "D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; A" />
        <Axis NormVector = " 1; A; 1" />
        <Axis NormVector = " A; 1; 1" />
        <Axis NormVector = "-1;-1; B" />
        <Axis NormVector = "-1; B;-1" />
        <Axis NormVector = " B;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <RemoveContaining Vector = "W; -W; hide" />
        <RemoveContaining Vector = "hide; -W; W" />
        <RemoveContaining Vector = "-W; hide; W" />
        <RemoveContaining Vector = "-W; W; hide" />
        <RemoveContaining Vector = "W; hide; -W" />
        <RemoveContaining Vector = "hide; W; -W" />

        <Macro Name = "Split" >
            <Hide  Axis = "ax1" Layer = "1" />
            <Turn  Axis = "ax2" Layer = "0" Angle = "A1"/>
            <Split Axis = "ax1" From  = "1" />
            <Undo/>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "1" />
        <ExecMacro MacroName = "Split" ax1 = "1" ax2 = "2" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "0" />

        <ExecMacro MacroName = "Split" ax1 = "3" ax2 = "5" />
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "3" />
        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "4" />

        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "3" />
        <ExecMacro MacroName = "Split" ax1 = "3" ax2 = "0" />
        <ExecMacro MacroName = "Split" ax1 = "1" ax2 = "4" />
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "1" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "5" />
        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "2" />
    </Figure>
</xml>
