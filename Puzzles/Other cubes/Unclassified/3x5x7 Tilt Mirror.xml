<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x5x7 Tilt Mirror</Name>
        <Menu>Other cubes\Unclassified\3x5x7 Tilt Mirror</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8874</Link>
    </Interface>

    <Script>
        clSilver := 'C0C0C0';

        W := 0.5;

        D := W *0.1;
        D1 := D * 3;
        D2 := D * 5;
        D3 := D * 7;

        for i := 0 to 5 do
            Colors[i] := clSilver;

        AX :=-0.15;
        AY :=-0.05;
        AZ :=-0.1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3;-D2;-D1; D1; D2; D3" TurnAxesWithLayer = "3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "1;0;0" Angle = "AX" />
        <Turn NormVector = "0;1;0" Angle = "AY" />
        <Turn NormVector = "0;0;1" Angle = "AZ" />

        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />

        <Hide  Axis = "0" To   = "1" />
        <Hide  Axis = "0" From = "5" />
        <Hide  Axis = "2" To   = "0" />
        <Hide  Axis = "2" From = "6" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "6" />
        <ShowAll/>

        <Hide  Axis = "1" To   = "2" />
        <Hide  Axis = "1" From = "4" />
        <Hide  Axis = "2" To   = "0" />
        <Hide  Axis = "2" From = "6" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "6" />
        <ShowAll/>
        <RemoveGrayParts/>

    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(7)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(7)" Angle = "Pi" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(2)" Layer = "Random(7)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(7)" Angle = "Pi/2 * Random(4)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(7)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "Sc2" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
