<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cubic Helicopter Dodecahedron</Name>
        <Menu>Other cubes\Unclassified\Cubic Helicopter Dodecahedron</Menu>
        <Inventor>Tom Koster</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6618</Link>
    </Interface>

    <Script>
        Colors[3] := 'FF0000'; // clRed
        Colors[2] := 'FF8800'; // clOrange
        Colors[0] := '0066FF'; // clBlue
        Colors[1] := '00DD00'; // clGreen
        Colors[4] := 'FFFF00'; // clYellow
        Colors[5] := 'FFFFFF'; // clWhite

        W := 0.5;

        A := W * 1.38;
        B := W * 0.30;
        D := A * 0.90;

        Phi := (Sqrt(5) - 1) / 2; // The golden ratio
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "ArcTan(2)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "     1;     0;     0" />
        <Axis NormVector = "     0;     1;     0" />
        <Axis NormVector = "     0;     0;     1" />
        <Axis NormVector = "  -Phi;    -1; Phi-1" />
        <Axis NormVector = "  -Phi;    -1;-Phi-1" />
        <Axis NormVector = "   Phi;    -1;-Phi-1" />
        <Axis NormVector = " Phi+1;  -Phi;    -1" />
        <Axis NormVector = " Phi+1;   Phi;    -1" />
        <Axis NormVector = "-Phi+1;   Phi;    -1" />
        <Axis NormVector = "     1;-Phi-1;  -Phi" />
        <Axis NormVector = "     1;-Phi-1;   Phi" />
        <Axis NormVector = "   Phi;     1; Phi-1" />
        <Axis NormVector = "  -Phi;     1;-Phi-1" />
        <Axis NormVector = " Phi+1;  -Phi;     1" />
        <Axis NormVector = " Phi+1;   Phi;     1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>

        <Turn NormVector = "0;0;1" Angle = "Pi/2"/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
