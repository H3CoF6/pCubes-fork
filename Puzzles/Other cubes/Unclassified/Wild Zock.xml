    <Script>
        W := 0.5;
        D := W * 0.6;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "2" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 0;-1; 0" />
        <Axis NormVector = "-1; 0; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From  = "2" />
        <Turn  Axis = "0" Layer = "1" Angle = "-5*Pi/6" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "2" From  = "1" />
        <Split Axis = "2" From  = "3" />
        <Undo/>
    </Figure>
</xml>
