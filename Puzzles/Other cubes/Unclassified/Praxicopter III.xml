<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Praxicopter III</Name>
        <Menu>Other cubes\Unclassified\Praxicopter III</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6018</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.36;
        B := W * 0.4;
        D := W * 2 * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 1; 1" Angle = "Pi/3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />

        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
