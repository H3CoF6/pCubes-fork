<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ghost Cube 1x3x3</Name>
        <Menu>Other cubes\Unclassified\Ghost Cube 1x3x3</Menu>
        <Inventor>Yong Jun Toys (Company Name)</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-11-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6683</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        sAngle := Pi * 2 / 5;
        dAngle := 0.07;
        for i := 0 to 4 do begin
            x[i] := sin(sAngle * i + dAngle);
            y[i] := cos(sAngle * i + dAngle);
        end;

        W := 1/2;
        D := W * 0.56;
        H := D * tan(Pi / 5);
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " -W; -W; -H" />
                <Add Vector = " -W; -W;  H" />
                <Add Vector = " -W;  W; -H" />
                <Add Vector = " -W;  W;  H" />
                <Add Vector = "  W; -W; -H" />
                <Add Vector = "  W; -W;  H" />
                <Add Vector = "  W;  W; -H" />
                <Add Vector = "  W;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "MirrorColor" VertexIndexes = "1;0;4;5" />
                <Face Color = "MirrorColor" VertexIndexes = "2;3;7;6" />
                <Face Color = "MirrorColor" VertexIndexes = "0;1;3;2" />
                <Face Color = "MirrorColor" VertexIndexes = "5;4;6;7" />
                <Face Color = "MirrorColor" VertexIndexes = "0;2;6;4" />
                <Face Color = "MirrorColor" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
