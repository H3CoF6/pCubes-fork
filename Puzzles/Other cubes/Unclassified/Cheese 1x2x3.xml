<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheese 1x2x3</Name>
        <Menu>Other cubes\Unclassified\Cheese 1x2x3</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7444</Link>
    </Interface>
 
    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.65;
        W2 := W / sqrt(3);
        H := W / 3;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "cos(1 * Pi / 6); sin(1 * Pi / 6); 0" />
        <Axis NormVector = "cos(2 * Pi / 6); sin(2 * Pi / 6); 0" />
        <Axis NormVector = "cos(3 * Pi / 6); sin(3 * Pi / 6); 0" />
        <Axis NormVector = "cos(4 * Pi / 6); sin(4 * Pi / 6); 0" />
        <Axis NormVector = "cos(5 * Pi / 6); sin(5 * Pi / 6); 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W2; -W; -H" />
                <Add Vector = "-W2; -W;  H" />
                <Add Vector = "-W2;  W; -H" />
                <Add Vector = "-W2;  W;  H" />
                <Add Vector = " W2; -W; -H" />
                <Add Vector = " W2; -W;  H" />
                <Add Vector = " W2;  W; -H" />
                <Add Vector = " W2;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <S1plitByAxes />
        <Split Axis = "0" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "3" />
    </Figure>
</xml>
