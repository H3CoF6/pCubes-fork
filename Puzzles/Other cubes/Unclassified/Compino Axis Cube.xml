<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Compino Axis Cube</Name>
        <Menu>Other cubes\Unclassified\Compino Axis Cube</Menu>
        <Inventor>Alasdair Paton</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9576</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        Colors[0] := 'DD0000';
        Colors[2] := '0033EE';
        Colors[3] := '00AA00';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.3;

        D := W * sqrt(3) / 2;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-5;-1" />
        <Axis NormVector = "-5; 1;-1" />
        <Axis NormVector = " 1; 1; 5" />
    </Axes>

    <Figure>
        <Turn1 NormVector = "-1;-1; 1" Angle = "Pi / 3" />
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "-W;-W;-W" />
        <RemoveContaining Vector = "-W; W;-W" />
        <RemoveContaining Vector = "-W; W; W" />
        <RemoveContaining Vector = " W;-W;-W" />
        <RemoveContaining Vector = " W;-W; W" />
        <RemoveContaining Vector = " W; W; W" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
