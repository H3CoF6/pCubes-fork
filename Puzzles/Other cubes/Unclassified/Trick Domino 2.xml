<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trick Domino 2</Name>
        <Menu>Other cubes\Unclassified\Trick Domino 2</Menu>
        <Inventor>Hidetoshi Takeji</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2119</Link>
    </Interface>

    <Script>
        W := 0.5;
        sAngle := arctan(1/2);
        D := W / sqrt(5);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithPartNo = "4" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" AvailableAngles = "-Pi/2; 0; Pi/2; Pi; -Pi/2-2*sAngle; -2*sAngle; Pi/2-2*sAngle; Pi-2*sAngle" PlaneDistances = "0" TurnAxesWithPartNo = "4" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-sAngle" />
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "-2*sAngle" />
        <SplitByAxes/>
        <Undo Repeat = "1" />
    </Figure>
</xml>
