<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Insanity Cubed</Name>
        <Menu>Other cubes\Unclassified\Insanity Cubed</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4774</Link>
    </Interface>

    <Script>
        W := 0.5;
        C1 := W;
        C2 := W * (sqrt(2) - 1);
        C3 := W * (sqrt(2) + 1);

        D := W * 2 / sqrt(14);

        A1 := ArcCos( 1 / 8);
        A2 := ArcCos(-3 / 4);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "-C1;-C3;-C2" />
        <Axis NormVector = "-C3; C2; C1" />
        <Axis NormVector = " C2;-C1; C3" />
        <Axis NormVector = " C1;-C2;-C3" />
        <Axis NormVector = "-C2; C3;-C1" />
        <Axis NormVector = " C3; C1; C2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
