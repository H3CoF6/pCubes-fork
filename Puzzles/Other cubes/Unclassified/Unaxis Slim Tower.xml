<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unaxis Slim Tower</Name>
        <Menu>Other cubes\Unclassified\Unaxis Slim Tower</Menu>
        <Inventor>Rex Rossano Perez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11383</Link>
    </Interface>

    <Script>
        MirrorColor := 'D00080';

        W := 0.5;
        D := W / 3;

        RX := 5 * Pi / 180;
        RY :=-15 * Pi / 180;
        RZ := 34 * Pi / 180;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "RX" />
        <Turn NormVector = " 0; 1; 0" Angle = "RY" />
        <Turn NormVector = " 0; 0; 1" Angle = "RZ" />

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
