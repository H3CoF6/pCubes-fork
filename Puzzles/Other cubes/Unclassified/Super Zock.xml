<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Zock</Name>
        <Menu>Other cubes\Unclassified\Super Zock</Menu>
        <Inventor>Martin Guadalupe Bueno Alcantar</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6210</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From   = "2" />
        <Turn  Axis = "0" Layer  = "2" Angle = "Pi/2" />
        <Split Axis = "1" From   = "2" />
        <Split Axis = "2" From   = "1" />
        <Split Axis = "2" From   = "3" />
        <Turn  Axis = "0" Layer  = "2" Angle = "-Pi" />
        <Turn  Axis = "2" Layers = "0;3" Angle = "Pi/4" />
        <Split Axis = "0" From   = "2" />
        <Turn  Axis = "2" Layers = "0;3" Angle = "Pi/2" />
        <Split Axis = "0" From   = "2" />
        <Undo Repeat = "4" />
    </Figure>
</xml>
