<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Insanity Cube Plus</Name>
        <Menu>Other cubes\Unclassified\Insanity Cube Plus</Menu>
        <Inventor>Tom Koster</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7423</Link>
    </Interface>

    <Script>
        Colors[0] := 'ED0000'; // Red
        Colors[1] := 'FF8800'; // Orange
        Colors[2] := '0033EE'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFFF00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;

        C1 := 1;
        C2 := sqrt(2) - 1;
        C3 := sqrt(2) + 1;

        D := W * 2 / sqrt(14);

        A1 := ArcCos(1/8);
        A2 := ArcCos(-3/4);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "-C1;-C3;-C2" />
        <Axis NormVector = "-C3; C2; C1" />
        <Axis NormVector = " C2;-C1; C3" />
        <Axis NormVector = " C1;-C2;-C3" />
        <Axis NormVector = "-C2; C3;-C1" />
        <Axis NormVector = " C3; C1; C2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "ax1" Layer = "1" Angle = "an1" />
            <Turn Axis = "ax2" Layer = "1" Angle = "an2" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "4" an1 = "A1" an2 = "-A1"/>
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "3" />
        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "1" />
        <ExecMacro MacroName = "Split" ax1 = "1" ax2 = "2" />
        <ExecMacro MacroName = "Split" ax1 = "3" ax2 = "5" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "0" />

        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "4" an1= "-A2" an2 = "-A1"/>
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "3" />
        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "1" />
        <ExecMacro MacroName = "Split" ax1 = "1" ax2 = "2" />
        <ExecMacro MacroName = "Split" ax1 = "3" ax2 = "5" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "0" />
    </Figure>
</xml>
