    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0011EE'; // Blue
        Colors[3] := '00CC00'; // Green
        Colors[4] := 'FFFF00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        s2 := sqrt(2);
        A := W * s2;
        B := W * 0.2;
        D := A / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3; 0; Pi * 2 / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " s2;  0; 1" />
        <Axis NormVector = "-s2;  0; 1" />
        <Axis NormVector = "  0; s2;-1" />
        <Axis NormVector = "  0;-s2;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
