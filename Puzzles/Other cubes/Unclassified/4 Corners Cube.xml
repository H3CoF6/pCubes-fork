<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4 Corners Cube</Name>
        <Menu>Other cubes\Unclassified\4 Corners Cube</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5793</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.2;
        B := W * 0.3;
        R := 0.7;
        D := R * 0.74;

        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = "  1; -1;  3" />
        <Axis NormVector = "  1; -3;  1" />
        <Axis NormVector = "  3; -1;  1" />
        <Axis NormVector = "  1;  1; -3" />
        <Axis NormVector = "  1;  3; -1" />
        <Axis NormVector = "  3;  1; -1" />
        <Axis NormVector = " -1;  1;  3" />
        <Axis NormVector = " -1;  3;  1" />
        <Axis NormVector = " -3;  1;  1" />
        <Axis NormVector = " -1; -1; -3" />
        <Axis NormVector = " -1; -3; -1" />
        <Axis NormVector = " -3; -1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
