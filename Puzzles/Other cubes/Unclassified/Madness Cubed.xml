<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Madness Cubed</Name>
        <Menu>Other cubes\Unclassified\Madness Cubed</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4758</Link>
    </Interface>

    <Script>
        W := 0.5;
        A := W * (sqrt(2) - 1);
        B := W * (sqrt(2) + 1);

        D := A / sqrt(7);

        A1 := ArcCos(1/8);
        A2 := ArcCos(-3/4);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "-B;-W;-A" />
        <Axis NormVector = "-W; A; B" />
        <Axis NormVector = " A;-B; W" />
        <Axis NormVector = "-A; W;-B" />
        <Axis NormVector = " W; B; A" />
        <Axis NormVector = " B;-A;-W" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
