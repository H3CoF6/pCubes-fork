<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Hexagonal Cube</Name>
        <Menu>Other cubes\Unclassified\Hexagonal Cube</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2019-02-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7224</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W / 3;
        D2 := W * 0.62;
        s3 := sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "0; 0; 1"/>
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1;  0; 0"/>
        <Axis NormVector = " 1; s3; 0"/>
        <Axis NormVector = "-1; s3; 0"/>
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
