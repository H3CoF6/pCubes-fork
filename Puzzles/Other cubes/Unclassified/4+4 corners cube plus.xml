<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4+4 corners cube plus</Name>
        <Menu>Other cubes\Unclassified\4+4 corners cube plus</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7394</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.25;
        B := W * 0.475;
        D := 7 * W / 2 / sqrt(11);
        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = " 1;-3; 1" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 1; 1;-3" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = "-3; 1; 1" />
        <Axis NormVector = "-1;-1;-3" />
        <Axis NormVector = "-1;-3;-1" />
        <Axis NormVector = "-3;-1;-1" />
    </Axes>

    <Axes TurningAngles = "0; Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <Macro Name = "Split1" >
            <Split Axis = "id" From = "1" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split1" Repeat = "12" id = "0" />

        <Macro Name = "Split2" >
            <HideContaining Vector = "0;-W; W" />
            <InvertVisibility />
            <Split><Plane NormVector = "-13;-19; 19" NormDistance = " D" /></Split>
            <ShowAll/>
            <Turn NormVector = "1;-1;1" Angle = "2 * Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "Split2" Repeat = "3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <ExecMacro MacroName = "Split2" Repeat = "3" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Split2" Repeat = "3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <ExecMacro MacroName = "Split2" Repeat = "3" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />

        <Macro Name = "Split3" >
            <HideContaining Vector = "0;-A; 0" />
            <InvertVisibility />
            <Split><Plane NormVector = "-5;-7; 5" NormDistance = " D" /></Split>
            <Split><Plane NormVector = " 5;-7;-5" NormDistance = " D" /></Split>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Split3" />
        <Turn NormVector = " 1;-1; 1" Angle = " 2 * Pi / 3" />
        <ExecMacro MacroName = "Split3" />
        <Turn NormVector = "-1;-1; 1" Angle = "-2 * Pi / 3" />
        <ExecMacro MacroName = "Split3" />
        <Turn NormVector = " 1;-1; 1" Angle = " 2 * Pi / 3" />
        <ExecMacro MacroName = "Split3" />
        <Turn NormVector = "-1;-1; 1" Angle = "-2 * Pi / 3" />
        <ExecMacro MacroName = "Split3" />
        <Turn NormVector = " 1;-1; 1" Angle = " 2 * Pi / 3" />
        <ExecMacro MacroName = "Split3" />
        <Turn NormVector = "-1;-1; 1" Angle = "-2 * Pi / 3" />

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
