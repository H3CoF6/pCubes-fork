<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentomino cube</Name>
        <Menu>Other cubes\Unclassified\Pentomino cube</Menu>
        <Inventor>Jonathan Burn</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7512</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * 0.6;
        D2 := W / 3;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1;D1" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2; 2 * Pi / 20; Pi / 2" PlaneDistances = "-D2; D2" TurnAxe1sWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 2"/>
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Spl2itByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi * 2/5"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi * 2/5"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi * 2/5"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi * 2/5"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi * 2/5"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi / 2"/>
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 2"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi / 2"/>
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 2"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi / 2"/>
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 2"/>
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi / 2"/>
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 2"/>
        <Turn Axis = "1" Layer = "0" Angle = "-Pi / 2"/>

        <RemoveGrayParts/>
    </Figure>
</xml>
