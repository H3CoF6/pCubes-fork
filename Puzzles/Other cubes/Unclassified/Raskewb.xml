<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Raskewb</Name>
        <Menu>Other cubes\Unclassified\Raskewb</Menu>
        <Inventor>César Gustavo Hernández Martínez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9522</Link>
    </Interface>

    <Script>
        W := 0.5;
        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.982;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi/4" />
        <Turn NormVector = " 1; 0; 0" Angle = "Pi/2" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi/4 - ArcTan(sqrt(2))" />

        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "3" From = "1" />
        <Turn Axis = "3" Layer = "1" Angle = "Pi" />
        <SplitByAxes/>
        <Undo/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
