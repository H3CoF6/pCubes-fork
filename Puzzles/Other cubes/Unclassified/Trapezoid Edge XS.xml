<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trapezoid Edge XS</Name>
        <Menu>Other cubes\Unclassified\Trapezoid Edge XS</Menu>
        <Inventor>Troy Robinson</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-07-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6211</Link>
    </Interface>

    <Script>
        W := 0.5;
        az := sqrt(2);
        D1 := W * (2 - sqrt(2)) / 2;
        D2 := W * (0.5 + D1);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D2; -D1; D1; D2" TurnAxesWithLayer = "2" >
        <Axis NormVector = "-1;  1;  0" />
        <Axis NormVector = "-1; -1; az" />
        <Axis NormVector = " 1;  1; az" />
    </Axes>


    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "3" />
        <Turn  Axis = "0" Layer = "2" Angle = "-Pi / 4" />

        <Split Axis = "1" From  = "2" />
        <Split Axis = "1" From  = "3" />

        <Split Axis = "2" From  = "1" />
        <Split Axis = "2" From  = "2" />
        <Split Axis = "2" From  = "3" />
        <Split Axis = "2" From  = "4" />

        <Turn  Axis = "0" Layer = "2" Angle = " Pi / 4" />
    </Figure>
</xml>
