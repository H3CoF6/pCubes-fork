<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Halfish Cube 4x4x4</Name>
        <Menu>Other cubes\Unclassified\Halfish Cube 4x4x4</Menu>
        <Inventor>Chester de Guzman</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-02-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6491</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "2" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <Turn Axis = "2" Layer = "0" Angle = "Pi/4" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi/4" />

        <SplitByAxes/>

        <Undo Repeat = "2" />
    </Figure>
</xml>

