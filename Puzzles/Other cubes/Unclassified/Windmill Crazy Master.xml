    <Script>
        W := 0.5;
        A := (sqrt(21) - 3) / 6;
        B := -A / (A + 1);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/4; 0; 1/4" >
        <Axis NormVector = "-A; 1; B" />
        <Axis NormVector = "-B; A; 1" />
        <Axis NormVector = "-1; B; A" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
