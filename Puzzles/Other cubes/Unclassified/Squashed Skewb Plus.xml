<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Squashed Skewb Plus</Name>
        <Menu>Other cubes\Unclassified\Squashed Skewb Plus</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-12-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9438</Link>
    </Interface>

    <Script>
        W := 0.5;
        s2 := sqrt(2);
        D := W / s2;

        az := s2;

        WX := W;
        WY := W;
        WZ := W / az;

        jAngle := ArcCos(-1/3);

        RCut := W * (2 + 1 / s2) / sqrt(3) * 0.97;
        RCu2 := W * s2 * 0.985;
        RCu3 := W * (1 + s2) / 2 * 0.985;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-jAngle; 0; jAngle; Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1; az" />
        <Axis NormVector = "-1; 1; az" />
        <Axis NormVector = "-1;-1; az" />
        <Axis NormVector = " 1;-1; az" />
    </Axes>

    <Axes TurningAngles = "Pi / 2; 0; Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0;-1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0;-1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = "-RCu3" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1;-1" NormDistance = "-RCu3" /> </Cut>
    </Figure>
</xml>
