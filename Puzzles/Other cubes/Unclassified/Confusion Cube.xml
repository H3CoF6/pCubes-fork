<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Confusion Cube</Name>
        <Menu>Other cubes\Unclassified\Confusion Cube</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2626</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * 0.3;
        D2 := W * 0.25;
        RotY := 0.4;
        TrX := -W * 0.2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D2" >
        <Axis NormVector = "   1;           0; 0" />
        <Axis NormVector = "-0.5; sqrt(3) / 2; 0" />
        <Axis NormVector = "-0.5;-sqrt(3) / 2; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 1; 0" Angle = "RotY" />
        <Transfer Vector = "TrX; 0; 0" />
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
