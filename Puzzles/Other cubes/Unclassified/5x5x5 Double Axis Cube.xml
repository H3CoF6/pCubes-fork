<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>5x5x5 Double Axis Cube</Name>
        <Menu>Other cubes\Unclassified\5x5x5 Double Axis Cube</Menu>
        <Inventor>Võ Trần Anh Quân</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2020-01-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7706</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W * 0.2;
        D2 := D1 * 2.9;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "Pi/4" />
        <Turn NormVector = " 0; 1; 0" Angle = "Arcsin(7/9)" />
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/4" />

        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
