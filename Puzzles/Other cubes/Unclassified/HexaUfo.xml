<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>HexaUfo</Name>
        <Menu>Other cubes\Unclassified\HexaUfo</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3255</Link>
    </Interface>

    <Script>
        W := 0.5;

        for i := 0 to 2 do begin
            ax[i] := cos(Pi / 3 * i + Pi/2);
            ay[i] := sin(Pi / 3 * i + Pi/2);
        end;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "Ax[0]; Ay[0]; 0" />
        <Axis NormVector = "Ax[1]; Ay[1]; 0" />
        <Axis NormVector = "Ax[2]; Ay[2]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split><Plane NormVector = " -Ax[0]; -Ay[0]; 0" NormDistance = "0" /></Split> <!--<Split Axis = "0" From = "1" />-->
        <Turn Axis = "0" Angle = "Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-Pi/2" Layer = "1" />
    </Figure>
</xml>
