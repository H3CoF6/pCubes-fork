<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>1x2x3 Plus</Name>
        <Menu>Other cubes\Unclassified\1x2x3 Plus</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6817</Link>
    </Interface>
 
    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        W := 0.5;
        W2 := W / 3 * 2;
        H := W / 3;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "0; Pi" PlaneDistances = "0" >
        <Axis NormVector = "0; 1; 1" BaseVector = "0; W2; 0" />
        <Axis NormVector = "0; 1;-1" BaseVector = "0; W2; 0" />
        <Axis NormVector = "0;-1;-1" BaseVector = "0;-W2; 0" />
        <Axis NormVector = "0;-1; 1" BaseVector = "0;-W2; 0" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W2; -W; -H" />
                <Add Vector = "-W2; -W;  H" />
                <Add Vector = "-W2;  W; -H" />
                <Add Vector = "-W2;  W;  H" />
                <Add Vector = " W2; -W; -H" />
                <Add Vector = " W2; -W;  H" />
                <Add Vector = " W2;  W; -H" />
                <Add Vector = " W2;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>
<!--        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />-->
    </Figure>
</xml>
