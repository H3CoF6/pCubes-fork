<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Rex Cube</Name>
        <Menu>Other cubes\Unclassified\Fisher Rex Cube</Menu>
        <Inventor>TioRubik</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6740</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.2;
        s2 := sqrt(2);
        D := W * (A - B) / (-W + A + s2 * (W - B)) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " s2;  0;  1" />
        <Axis NormVector = "-s2;  0;  1" />
        <Axis NormVector = "  0; s2;  1" />
        <Axis NormVector = "  0;-s2;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
