<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Boob Fusion</Name>
        <Menu>Other cubes\Unclassified\Boob Fusion</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2019-02-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7122</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        W := 0.5;
        D0 := -W;
        D1 := -W / 3;
        D2 :=  W / 3;
        D3 :=  W;
        H := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "D2;D1; H" />
                <Add Vector = "D3;D1; H" />
                <Add Vector = "D3;D3; H" />
                <Add Vector = "D1;D3; H" />
                <Add Vector = "D1;D2; H" />
                <Add Vector = "D0;D2; H" />
                <Add Vector = "D0;D0; H" />
                <Add Vector = "D2;D0; H" />
                <Add Vector = "D2;D1;-H" />
                <Add Vector = "D3;D1;-H" />
                <Add Vector = "D3;D3;-H" />
                <Add Vector = "D1;D3;-H" />
                <Add Vector = "D1;D2;-H" />
                <Add Vector = "D0;D2;-H" />
                <Add Vector = "D0;D0;-H" />
                <Add Vector = "D2;D0;-H" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = " 0; 1; 2; 3; 4; 5; 6; 7" />
                <Face Color = "Colors[4]" VertexIndexes = "15;14;13;12;11;10; 9; 8" />
                <Face Color = "Colors[2]" VertexIndexes = " 1; 0; 8; 9" />
                <Face Color = "Colors[1]" VertexIndexes = " 2; 1; 9;10" />
                <Face Color = "Colors[3]" VertexIndexes = " 3; 2;10;11" />
                <Face Color = "Colors[0]" VertexIndexes = " 4; 3;11;12" />
                <Face Color = "Colors[3]" VertexIndexes = " 5; 4;12;13" />
                <Face Color = "Colors[0]" VertexIndexes = " 6; 5;13;14" />
                <Face Color = "Colors[2]" VertexIndexes = " 7; 6;14;15" />
                <Face Color = "Colors[1]" VertexIndexes = " 0; 7;15; 8" />
             </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
