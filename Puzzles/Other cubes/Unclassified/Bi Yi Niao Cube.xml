<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bi Yi Niao Cube</Name>
        <Menu>Other cubes\Unclassified\Bi Yi Niao Cube</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7006</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.2;
        B := W * 0.3;
        D1 := W * 1.057;

        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D1" >
        <Axis NormVector = "  1; -1;  3" />
        <Axis NormVector = "  1; -3;  1" />
        <Axis NormVector = "  3; -1;  1" />
        <Axis NormVector = "  1;  1; -3" />
        <Axis NormVector = "  1;  3; -1" />
        <Axis NormVector = "  3;  1; -1" />
        <Axis NormVector = " -1;  1;  3" />
        <Axis NormVector = " -1;  3;  1" />
        <Axis NormVector = " -3;  1;  1" />
        <Axis NormVector = " -1; -1; -3" />
        <Axis NormVector = " -1; -3; -1" />
        <Axis NormVector = " -3; -1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes />

        <HideContaining Vector = " W/2; -W/2;  W  " />
        <HideContaining Vector = "-W/2;  W/2;  W  " />
        <HideContaining Vector = "-W/2; -W/2; -W  " />
        <HideContaining Vector = " W/2;  W/2; -W  " />

        <HideContaining Vector = " W  ;  W/2; -W/2" />
        <HideContaining Vector = " W  ; -W/2;  W/2" />
        <HideContaining Vector = "-W  ; -W/2; -W/2" />
        <HideContaining Vector = "-W  ;  W/2;  W/2" />

        <HideContaining Vector = "-W/2;  W  ;  W/2" />
        <HideContaining Vector = " W/2;  W  ; -W/2" />
        <HideContaining Vector = "-W/2; -W  ; -W/2" />
        <HideContaining Vector = " W/2; -W  ;  W/2" />

        <Macro Name = "Split">
            <Turn Axis = "ax1" Layer = "1" To = "1" Angle = "A1" />
            <Split Axis = "ax2" From = "1" />
            <Undo/>

            <Turn Axis = "ax1" Layer = "1" Angle = " A2" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A2" />
            <Turn Axis = "ax1" Layer = "1" Angle = "-A2" />
            <Turn Axis = "ax2" Layer = "1" Angle = " A2" />
            <Split Axis = "ax3" From = "1" />
            <Undo Repeat = "4" />
        </Macro>

        <ExecMacro MacroName = "Split" ax1 = " 0" ax2 = " 1" ax3 = " 2" />
        <ExecMacro MacroName = "Split" ax1 = " 1" ax2 = " 2" ax3 = " 0" />
        <ExecMacro MacroName = "Split" ax1 = " 2" ax2 = " 0" ax3 = " 1" />

        <ExecMacro MacroName = "Split" ax1 = " 3" ax2 = " 4" ax3 = " 5" />
        <ExecMacro MacroName = "Split" ax1 = " 4" ax2 = " 5" ax3 = " 3" />
        <ExecMacro MacroName = "Split" ax1 = " 5" ax2 = " 3" ax3 = " 4" />

        <ExecMacro MacroName = "Split" ax1 = " 6" ax2 = " 7" ax3 = " 8" />
        <ExecMacro MacroName = "Split" ax1 = " 7" ax2 = " 8" ax3 = " 6" />
        <ExecMacro MacroName = "Split" ax1 = " 8" ax2 = " 6" ax3 = " 7" />

        <ExecMacro MacroName = "Split" ax1 = " 9" ax2 = "10" ax3 = "11" />
        <ExecMacro MacroName = "Split" ax1 = "10" ax2 = "11" ax3 = " 9" />
        <ExecMacro MacroName = "Split" ax1 = "11" ax2 = " 9" ax3 = "10" />

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
