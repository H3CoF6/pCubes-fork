<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover Floppy</Name>
        <Menu>Other cubes\Unclassified\Clover Floppy</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8928</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W / 3;

        D := W * 0.85;

        for i := 0 to 3 do begin
            ax[i] := sin(2 * Pi / 8 * (i + 0.5));
            ay[i] := cos(2 * Pi / 8 * (i + 0.5));
        end;
    </Script>

    <Axes TurningAngles = "Pi;0;Pi" PlaneDistances = "-D; D" NormVectors = "ax; ay; 0" />

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
