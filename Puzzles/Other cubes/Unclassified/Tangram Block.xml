<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tangram Block</Name>
        <Menu>Other cubes\Unclassified\Tangram Block</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6239</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        WX := 0.6;
        WY := WX / 2;
        H := WY / sqrt(2);
        D := H;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" FixedLayers = "1">
        <Axis NormVector = "1;-1; 0" />
        <Axis NormVector = "1; 1; 0" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-WX; -WY; -H" />
                <Add Vector = "-WX; -WY;  H" />
                <Add Vector = "-WX;  WY; -H" />
                <Add Vector = "-WX;  WY;  H" />
                <Add Vector = " WX; -WY; -H" />
                <Add Vector = " WX; -WY;  H" />
                <Add Vector = " WX;  WY; -H" />
                <Add Vector = " WX;  WY;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "Pi / 2" />
        <Turn  Axis = "0" Layer = "2" Angle = "Pi / 2" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "1" From  = "2" />
        <Undo  Repeat = "2" />
    </Figure>
</xml>
