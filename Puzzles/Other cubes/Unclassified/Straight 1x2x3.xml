<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Straight 1x2x3</Name>
        <Menu>Other cubes\Unclassified\Straight 1x2x3</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2020-02-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7858</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W  := 0.6;
        W2 := W / 3;
        H  := W / 3 * 2;
        H2 := H / 2;
        ga := Pi * (3 - sqrt(5));
        gb := Pi - ga;

        Wx := W;
        Wy := W2;
        Wz := H;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "H2" FixedLayers = "0" >
        <Axis NormVector = "-sin(ga/2); -cos(ga/2); 0" />
        <Axis NormVector = " sin(ga/2); -cos(ga/2); 0" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "gb" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = "Pi" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 2" />
        <Turn  Axis = "1" Layer = "1" Angle = "Pi / 2" />
        <Split Axis = "2" From  = "1" />
        <Undo Repeat = "3"/>
    </Figure>
</xml>
