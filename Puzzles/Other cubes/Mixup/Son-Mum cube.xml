<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Son-Mum cube</Name>
        <Menu>Other cubes\Mixup\Son-Mum cube</Menu>
        <Programmer>Skallos</Programmer>
        <Added>2016-11-12</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := 3 / (2 + 6 * sqrt(2));
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Turn  Axis = "0" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "-Pi / 4" Layer = "1" />

        <Turn  Axis = "1" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "1" Angle = "-Pi / 4" Layer = "1" />

        <Turn  Axis = "2" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "2" Angle = "-Pi / 4" Layer = "1" />

        <RemoveGrayParts/>
    </Figure>
</xml>
