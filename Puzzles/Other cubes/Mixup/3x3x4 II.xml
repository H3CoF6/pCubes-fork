<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup 3x3x4 II</Name>
        <Menu>Other cubes\Mixup\3x3x4 II</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2612</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.469;
        H := 0.55;

        D1 := 0.179;
        D2 := 0.34;
    </Script>

    <Axes TurningAngles = "Pi; Pi/5; Pi" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/4; Pi/2" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />
        <SplitByAxes/>
        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = "-W;-W; W" />
        <HideContaining Vector = "-W;-W;-W" />

        <RemoveAllVisible/>
        <ShowAll/>

        <Macro Name = "AddPart" >
            <Turn Axis = "2" Angle = "i3*Pi/4" From = "1" To = "2" />
            <Turn Axis = "0" Angle = "i1*Pi/5" Layer = "1" />
            <Turn Axis = "1" Angle = "i2*Pi/5" Layer = "1" />

            <InvertVisibility/>
            <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
            <Cut Axis = "0" From = "1" To = "2" > </Cut>
            <Cut Axis = "1" From = "1" To = "2" > </Cut>
            <Cut Axis = "2" From = "3" > </Cut>

            <Turn Axis = "0" Angle = "Pi/5" Layer = "1" />
            <Cut Axis = "1" To = "1" > </Cut>
            <Cut Axis = "2" From = "3" > </Cut>
            <Turn Axis = "0" Angle = "Pi/5" Layer = "1" />
            <Cut Axis = "2" From = "2" To = "3" > </Cut>
            <Turn Axis = "0" Angle = "-2*Pi/5" Layer = "1" />

            <Turn Axis = "0" Angle = "-Pi/5" Layer = "1" />
            <Cut Axis = "1" From = "2" > </Cut>
            <Cut Axis = "2" From = "3" > </Cut>
            <Turn Axis = "0" Angle = "-Pi/5" Layer = "1" />
            <Cut Axis = "2" From = "2" To = "3" > </Cut>
            <Turn Axis = "0" Angle = "2*Pi/5" Layer = "1" />

            <Turn Axis = "1" Angle = "Pi/5" Layer = "1" />
            <Cut Axis = "0" From = "2" > </Cut>
            <Cut Axis = "2" From = "3" > </Cut>
            <Turn Axis = "1" Angle = "Pi/5" Layer = "1" />
            <Cut Axis = "2" From = "2" To = "3" > </Cut>
            <Turn Axis = "1" Angle = "-2*Pi/5" Layer = "1" />

            <Turn Axis = "1" Angle = "-Pi/5" Layer = "1" />
            <Cut Axis = "0" To = "1" > </Cut>
            <Cut Axis = "2" From = "3" > </Cut>
            <Turn Axis = "1" Angle = "-Pi/5" Layer = "1" />
            <Cut Axis = "2" From = "2" To = "3" > </Cut>
            <Turn Axis = "1" Angle = "2*Pi/5" Layer = "1" />

            <Turn Axis = "1" Angle = "-i2*Pi/5" Layer = "1" />
            <Turn Axis = "0" Angle = "-i1*Pi/5" Layer = "1" />
            <Turn Axis = "2" Angle = "-i3*Pi/4" From = "1" To = "2" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "0" i3 = "0" />

        <ExecMacro MacroName = "AddPart" i1 = "1" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "2" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "3" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "4" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "5" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "6" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "7" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "8" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "9" i2 = "0" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "1" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "2" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "3" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "4" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "6" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "7" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "8" i3 = "0" />
        <ExecMacro MacroName = "AddPart" i1 = "0" i2 = "9" i3 = "0" />

        <ExecMacro MacroName = "AddPart" i1 = "2" i2 = "0" i3 = "1" />
        <ExecMacro MacroName = "AddPart" i1 = "2" i2 = "0" i3 = "3" />
        <ExecMacro MacroName = "AddPart" i1 = "2" i2 = "0" i3 = "5" />
        <ExecMacro MacroName = "AddPart" i1 = "2" i2 = "0" i3 = "7" />
        <ExecMacro MacroName = "AddPart" i1 = "3" i2 = "0" i3 = "1" />
        <ExecMacro MacroName = "AddPart" i1 = "3" i2 = "0" i3 = "3" />
        <ExecMacro MacroName = "AddPart" i1 = "3" i2 = "0" i3 = "5" />
        <ExecMacro MacroName = "AddPart" i1 = "3" i2 = "0" i3 = "7" />

        <Cut Color = "Colors[0]" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[1]" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[2]" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[3]" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[4]" > <Plane NormVector = " 0; 0; 1" NormDistance = "-H" /> </Cut>
        <Cut Color = "Colors[5]" > <Plane NormVector = " 0; 0;-1" NormDistance = "-H" /> </Cut>
    </Figure>
</xml>
