<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup 3x3x3 Master</Name>
        <Aliases>3x3x3 Mixup Ultimate Cube</Aliases>
        <Aliases>3x3x3 Mixup Cube 30-Degree-Turn</Aliases>
        <Menu>Other cubes\Mixup\3x3x3 Master</Menu>
        <Inventor>LimCube</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6003</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9285</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 0.18; //W / (1 + 2 * sqrt(2)) / 2;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/6; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn  Axis = "Ax2" Layer = "1" Angle = " Pi/6" />
            <SplitByAxes/>
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-Pi/3" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
            <RemoveGrayParts/>

            <Turn  Axis = "Ax3" Layer = "1" Angle = " Pi/6" />
            <SplitByAxes/>
            <Turn  Axis = "Ax3" Layer = "1" Angle = "-Pi/3" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
            <RemoveGrayParts/>

            <Turn  Axis = "Ax1" Layer = "1" Angle = " Pi/6" />
            <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <Undo Repeat = "3" />

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <Undo Repeat = "3" />

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "2" Ax2 = "0" Ax3 = "1" />
        <Undo Repeat = "3" />
    </Figure>
</xml>
