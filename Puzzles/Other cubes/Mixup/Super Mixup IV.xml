<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Super Mixup IV</Name>
        <Menu>Other cubes\Mixup\Super Mixup IV</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=106993</Link>
        <Added>2017-01-08</Added>
    </Interface>

    <Script>
        clBlue    := '00FFFF';
        clGreen   := '00FF00';
        clFuchsia := 'FF30FF';
        clOrange  := 'FF800A';
        clYellow  := 'FFFF00';
        clGray    := 'C0C0C0';

        D := (2 * sqrt(2) + 1) / 14;
    </Script>

    <Axes TurningAngles = "Pi / 4; 0; Pi / 4" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1;  0;  0" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 0;  0;  1" />
    </Axes>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = " 0; -1;  1" />
        <Axis NormVector = "-1;  0;  1" />
        <Axis NormVector = "-1;  1;  0" />
        <Axis NormVector = " 1;  1;  0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-0.5; -0.5; -0.5" />
                <Add Vector = "-0.5; -0.5;  0.5" />
                <Add Vector = "-0.5;  0.5; -0.5" />
                <Add Vector = "-0.5;  0.5;  0.5" />
                <Add Vector = " 0.5; -0.5; -0.5" />
                <Add Vector = " 0.5; -0.5;  0.5" />
                <Add Vector = " 0.5;  0.5; -0.5" />
                <Add Vector = " 0.5;  0.5;  0.5" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange " VertexIndexes = "1;0;4;5" />
                <Face Color = "clFuchsia" VertexIndexes = "2;3;7;6" />
                <Face Color = "clGreen  " VertexIndexes = "0;1;3;2" />
                <Face Color = "clBlue   " VertexIndexes = "5;4;6;7" />
                <Face Color = "clGray   " VertexIndexes = "0;2;6;4" />
                <Face Color = "clYellow " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />

        <Turn  Axis = "1" Angle = " Pi / 4" Layer = "0" />
        <Turn  Axis = "1" Angle = "-3*Pi/4" Layer = "2" />
        <Split Axis = "2" From = "2" />
        <Turn  Axis = "1" Angle = "3*Pi/ 4" Layer = "2" />
        <Turn  Axis = "1" Angle = "-Pi / 4" Layer = "0" />

        <Turn  Axis = "2" Angle = "-Pi / 4" Layer = "2" />
        <Turn  Axis = "2" Angle = "3*Pi/ 4" Layer = "0" />
        <Split Axis = "1" From = "2" />
        <Turn  Axis = "2" Angle = "-3*Pi/4" Layer = "0" />
        <Turn  Axis = "2" Angle = " Pi / 4" Layer = "2" />

        <Turn  Axis = "0" Angle = "-Pi / 4" Layer = "2" />
        <Turn  Axis = "0" Angle = "3*Pi/ 4" Layer = "0" />
        <Split Axis = "2" From = "2" />
        <Turn  Axis = "0" Angle = "-3*Pi/4" Layer = "0" />
        <Turn  Axis = "0" Angle = " Pi / 4" Layer = "2" />

        <Turn  Axis = "0" Angle = "Pi" Layer = "0" />
        <Hide  Axis = "0" Layer = "1" />
        <Hide  Axis = "1" Layer = "2" />
        <Hide  Axis = "2" Layer = "0" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "5" From = "1" />
        <Hide  Axis = "2" Layer = "2" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "8" From = "1" />
        <Turn  Axis = "0" Angle = "Pi" Layer = "0" />
        <ShowAll/>

        <Turn  Axis = "2" Angle = "Pi" Layer = "0" />
        <Hide  Axis = "2" Layer = "1" />
        <Hide  Axis = "0" Layer = "2" />
        <Hide  Axis = "1" Layer = "0" />
        <Split Axis = "8" From = "1" />
        <Split Axis = "8" From = "2" />
        <Split Axis = "7" From = "1" />
        <Hide  Axis = "1" Layer = "2" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "4" From = "1" />
        <Turn  Axis = "2" Angle = "Pi" Layer = "0" />
        <ShowAll/>

        <Turn  Axis = "1" Angle = "Pi" Layer = "2" />
        <Hide  Axis = "1" Layer = "1" />
        <Hide  Axis = "0" Layer = "2" />
        <Hide  Axis = "2" Layer = "0" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "6" From = "1" />
        <Hide  Axis = "0" Layer = "0" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "3" From = "2" />
        <Turn  Axis = "1" Angle = "Pi" Layer = "2" />
        <ShowAll/>

        <RemoveGrayParts/>
    </Figure>
</xml>
