<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SlidaBall Cube</Name>
        <Menu>Other cubes\Mixup\SlidaBall (Cornerless Mixup)</Menu>
        <Inventor>Albert Weeda</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-07-22</Added>
        <Link>https://www.kickstarter.com/projects/1053123883/the-slidaball-a-new-approach-to-a-3d-slide-puzzle</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / (1 + sqrt(2));

        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
    </Script>
 
    <Axes TurningAngles = "0; Pi/4; 0" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>

        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = "-W;-W; W" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W;-W;-W" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = "-W;-W; W" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W;-W;-W" />

        <Turn  Axis = "0" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "-Pi / 4" Layer = "1" />

        <Turn  Axis = "1" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "1" Angle = "-Pi / 4" Layer = "1" />

        <Turn  Axis = "2" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "2" Angle = "-Pi / 4" Layer = "1" />

        <RemoveGrayParts/>

        <Turn  Axis = "0" Angle = " Pi / 4" Layer = "1" />
        <Turn  Axis = "1" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "1" Angle = "-Pi / 4" Layer = "1" />
        <Turn  Axis = "2" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "2" Angle = "-Pi / 4" Layer = "1" />
        <Turn  Axis = "0" Angle = "-Pi / 4" Layer = "1" />

        <RemoveGrayParts/>

        <Turn  Axis = "1" Angle = " Pi / 4" Layer = "1" />
        <Turn  Axis = "2" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "2" Angle = "-Pi / 4" Layer = "1" />
        <Turn  Axis = "0" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "-Pi / 4" Layer = "1" />
        <Turn  Axis = "1" Angle = "-Pi / 4" Layer = "1" />

        <RemoveGrayParts/>

        <Turn  Axis = "2" Angle = " Pi / 4" Layer = "1" />
        <Turn  Axis = "0" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "-Pi / 4" Layer = "1" />
        <Turn  Axis = "1" Angle = " Pi / 4" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "1" Angle = "-Pi / 4" Layer = "1" />
        <Turn  Axis = "2" Angle = "-Pi / 4" Layer = "1" />

        <RemoveGrayParts/>

        <ShowAll/>
    </Figure>
</xml>
