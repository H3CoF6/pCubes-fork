<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Shape Shifting 6x6x6</Name>
        <Menu>Other cubes\Mixup\Shape Shifting 6x6x6</Menu>
        <Inventor>Coren Broughton</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-01-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5151</Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>
 
    <Axes TurningAngles = "Pi/2;Pi/4;Pi/4;Pi/4;Pi/4;Pi/2" PlaneDistances = "-1/3; -1/6; 0; 1/6; 1/3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = " Pi/4" Layer = "1" />
        <Turn Axis = "0" Angle = " Pi/4" Layer = "2" />
        <Turn Axis = "0" Angle = " Pi/4" Layer = "3" />
        <Turn Axis = "0" Angle = " Pi/4" Layer = "4" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "0" Angle = "-Pi/4" Layer = "1" />
        <Turn Axis = "0" Angle = "-Pi/4" Layer = "2" />
        <Turn Axis = "0" Angle = "-Pi/4" Layer = "3" />
        <Turn Axis = "0" Angle = "-Pi/4" Layer = "4" />
        <Turn Axis = "1" Angle = " Pi/4" Layer = "1" />
        <Turn Axis = "1" Angle = " Pi/4" Layer = "2" />
        <Turn Axis = "1" Angle = " Pi/4" Layer = "3" />
        <Turn Axis = "1" Angle = " Pi/4" Layer = "4" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "1" Angle = "-Pi/4" Layer = "1" />
        <Turn Axis = "1" Angle = "-Pi/4" Layer = "2" />
        <Turn Axis = "1" Angle = "-Pi/4" Layer = "3" />
        <Turn Axis = "1" Angle = "-Pi/4" Layer = "4" />
        <Turn Axis = "2" Angle = " Pi/4" Layer = "1" />
        <Turn Axis = "2" Angle = " Pi/4" Layer = "2" />
        <Turn Axis = "2" Angle = " Pi/4" Layer = "3" />
        <Turn Axis = "2" Angle = " Pi/4" Layer = "4" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Turn Axis = "2" Angle = "-Pi/4" Layer = "1" />
        <Turn Axis = "2" Angle = "-Pi/4" Layer = "2" />
        <Turn Axis = "2" Angle = "-Pi/4" Layer = "3" />
        <Turn Axis = "2" Angle = "-Pi/4" Layer = "4" />

        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
