<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup 4x4x4 Master II</Name>
        <Menu>Other cubes\Mixup\4x4x4 Master II</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5343</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := 0.18;//1 / (1 + 2 * sqrt(2)) / 2;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/6; Pi/6; Pi/2" PlaneDistances = "-D/2; 0; D/2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "Split13" >
            <Split Axis = "Ax" From = "1" />
            <Split Axis = "Ax" From = "3" />
        </Macro>

        <ExecMacro MacroName = "Split13" Ax = "0" />
        <ExecMacro MacroName = "Split13" Ax = "1" />
        <ExecMacro MacroName = "Split13" Ax = "2" />

        <Macro Name = "Split" >
            <Turn  Axis = "Ax2" From = "1" To = "2" Angle = " Pi/6" />
            <ExecMacro MacroName = "Split13" Ax = "Ax3" />
            <ExecMacro MacroName = "Split13" Ax = "Ax1" />
            <Turn  Axis = "Ax2" From = "1" To = "2" Angle = "-Pi/3" />
            <ExecMacro MacroName = "Split13" Ax = "Ax3" />
            <ExecMacro MacroName = "Split13" Ax = "Ax1" />
            <Undo Repeat = "2" />
            <RemoveGrayParts/>

            <Turn  Axis = "Ax3" From = "1" To = "2" Angle = " Pi/6" />
            <ExecMacro MacroName = "Split13" Ax = "Ax1" />
            <ExecMacro MacroName = "Split13" Ax = "Ax2" />
            <Turn  Axis = "Ax3" From = "1" To = "2" Angle = "-Pi/3" />
            <ExecMacro MacroName = "Split13" Ax = "Ax1" />
            <ExecMacro MacroName = "Split13" Ax = "Ax2" />
            <Undo Repeat = "2" />
            <RemoveGrayParts/>

            <Turn  Axis = "Ax1" From = "1" To = "2" Angle = " Pi/6" />
            <ExecMacro MacroName = "Split13" Ax = "Ax2" />
            <ExecMacro MacroName = "Split13" Ax = "Ax3" />
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <Undo Repeat = "3" />

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <Undo Repeat = "3" />

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "2" Ax2 = "0" Ax3 = "1" />
        <Undo Repeat = "3" />

        <Macro Name = "HideCenter">
            <HideContaining Vector = "Cx[id]; Cy[id]; Cz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCenter" Repeat = "6" id = "0" />

        <Turn  Axis = "0" From = "1" To = "2" Angle = " Pi/6" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "1" From = "2" />
        <Turn  Axis = "0" From = "1" To = "2" Angle = " Pi/6" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "1" From = "2" />
        <Undo Repeat = "2" />

        <Turn  Axis = "2" From = "1" To = "2" Angle = " Pi/6" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "0" From = "2" />
        <Turn  Axis = "2" From = "1" To = "2" Angle = " Pi/6" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "0" From = "2" />
        <Undo Repeat = "2" />

        <Turn  Axis = "1" From = "1" To = "2" Angle = " Pi/6" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "2" From = "2" />
        <Turn  Axis = "1" From = "1" To = "2" Angle = " Pi/6" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "2" From = "2" />
        <Undo Repeat = "2" />

        <ShowAll/>

    </Figure>
</xml>
