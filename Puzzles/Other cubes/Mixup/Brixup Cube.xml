<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Brixup Cube</Name>
        <Menu>Other cubes\Mixup\Brixup Cube</Menu>
        <Inventor>Diogo Sousa</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7887</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/6; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "Pi/6" Layer = "1" />
        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "Pi/6" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "2" />
    </Figure>
</xml>
