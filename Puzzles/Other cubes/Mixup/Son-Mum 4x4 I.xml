<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Son-Mum 4x4 I</Name>
        <Menu>Other cubes\Mixup\Son-Mum 4x4 I</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7903</Link>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=106921</Link>
        <Added>2016-11-24</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := (2 * sqrt(2) - 1) / 7;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/4; Pi/2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <HideContaining Vector = " 0.5;  0.5;    0" />
        <HideContaining Vector = " 0.5; -0.5;    0" />
        <HideContaining Vector = "-0.5;  0.5;    0" />
        <HideContaining Vector = "-0.5; -0.5;    0" />
        <HideContaining Vector = " 0.5;    0;  0.5" />
        <HideContaining Vector = " 0.5;    0; -0.5" />
        <HideContaining Vector = "-0.5;    0;  0.5" />
        <HideContaining Vector = "-0.5;    0; -0.5" />
        <HideContaining Vector = "   0;  0.5;  0.5" />
        <HideContaining Vector = "   0;  0.5; -0.5" />
        <HideContaining Vector = "   0; -0.5;  0.5" />
        <HideContaining Vector = "   0; -0.5; -0.5" />

        <Turn  Axis = "0" Angle = " Pi / 4" From = "1" To = "2" />
        <SplitByAxes/>
        <Turn  Axis = "0" Angle = "-Pi / 4" From = "1" To = "2" />

        <Turn  Axis = "1" Angle = " Pi / 4" From = "1" To = "2" />
        <SplitByAxes/>
        <Turn  Axis = "1" Angle = "-Pi / 4" From = "1" To = "2" />

        <Turn  Axis = "2" Angle = " Pi / 4" From = "1" To = "2" />
        <SplitByAxes/>
        <Turn  Axis = "2" Angle = "-Pi / 4" From = "1" To = "2" />

        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>
</xml>
