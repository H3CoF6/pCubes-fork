<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Son-Mum 4x4 3</Name>
        <Menu>Other cubes\Mixup\Son-Mum 4x4 3</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>Boris</Programmer>
        <Link>https://alnext.ru/itm/3920c234ab4c5</Link>
        <Added>2023-07-17</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := (2 * sqrt(2) - 1) / 7;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/4; Pi/2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "Split" >
            <Split Axis = "ax0" From = "1" />
            <Split Axis = "ax0" From = "3" />
            <Hide  Axis = "ax0" Layers = "0;3" />
            <Split Axis = "ax1" From = "1" />
            <Split Axis = "ax1" From = "2" />
            <Split Axis = "ax1" From = "3" />
            <Split Axis = "ax2" From = "1" />
            <Split Axis = "ax2" From = "2" />
            <Split Axis = "ax2" From = "3" />
            <RemoveGrayParts/>
            <Turn  Axis = "ax0" Layers = "1;2" Angle = " Pi / 4" />
            <Split Axis = "ax1" From = "1" />
            <Split Axis = "ax1" From = "2" />
            <Split Axis = "ax1" From = "3" />
            <Split Axis = "ax2" From = "1" />
            <Split Axis = "ax2" From = "2" />
            <Split Axis = "ax2" From = "3" />
            <RemoveGrayParts/>
            <Undo/>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "Split" ax0 = "0" ax1 = "1" ax2 = "2" />
        <ExecMacro MacroName = "Split" ax0 = "1" ax1 = "2" ax2 = "0" />
        <ExecMacro MacroName = "Split" ax0 = "2" ax1 = "0" ax2 = "1" />
    </Figure>

    <Macros>
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layers = "0-3" Angle = "Pi/2" />
            <Turn Axis = "0" Layers = "1;2" Angle = " Pi/4" />
            <Turn Axis = "2" Layers = "3"   Angle = " Pi  " />
            <Turn Axis = "2" Layers = "1;2" Angle = " Pi/2" />
            <Turn Axis = "1" Layers = "1;2" Angle = "-Pi/2" />
            <Turn Axis = "0" Layers = "2"   Angle = " Pi  " />
            <Turn Axis = "1" Layers = "1;2" Angle = " Pi/2" />
            <Turn Axis = "2" Layers = "1;2" Angle = "-Pi/2" />
            <Turn Axis = "0" Layers = "1;2" Angle = "-Pi/4" />
        </Macro>

        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(4)" Angle = "2*Pi * Random" />
        </Macro>

        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "10" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
