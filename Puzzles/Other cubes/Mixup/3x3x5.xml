<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup 3x3x5</Name>
        <Menu>Other cubes\Mixup\3x3x5</Menu>
        <Inventor>Katelyn Neily</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-09-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5076</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * (sqrt(2) - 1);
        D2 := (W + D1) / 2;

        function GetInt(): integer;
        begin
          p := Pos(',', SColors);
          if p = 0 then begin
            substr := Trim(SColors);
            SColors := '';
          end else begin
            substr := Trim(copy(SColors, 1, p-1));
            Delete(SColors, 1, p);
          end;
          if substr = '-' then
            Result := D2
          else
            Result := W;
        end;

        SColorsUp    := ' , ,-,  ,-, ,  ,-, ';
        SColorsLeft  := ' ,-, ,  ,-,-, -, , ';
        SColorsFace  := '-, ,-,  ,-, , -, , ';
        SColorsRight := ' ,-, ,  ,-, , -, ,-';
        SColorsDown  := ' , , , -,-,-,  ,-, ';
        SColorsBack  := ' , , ,  ,-,-, -, , ';
    </Script>

    <Axes TurningAngles = "Pi/2;Pi/4;Pi/2;Pi/4;Pi/2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <Macro Name = "SplitRow" >
            <HideContaining Vector = "(x - 1) * W; (y - 1) * W; W" />
            <InvertVisibility />
            <Split><Plane NormVector = "0; 0;-1" NormDistance = "-GetInt" /></Split>
            <ShowAll/>
            <Script>Inc(x);</Script>
        </Macro>

        <Macro Name = "SplitFace" >
            <ExecMacro MacroName = "SplitRow" x = "0" y = "2" Repeat = "3" />
            <ExecMacro MacroName = "SplitRow" x = "0" y = "1" Repeat = "3" />
            <ExecMacro MacroName = "SplitRow" x = "0" y = "0" Repeat = "3" />

            <Hide><Plane NormVector = "0;0;1" NormDistance = "D2" /></Hide>
            <InvertVisibility/>
            <Hide><Plane NormVector = "0;0;1" NormDistance = "D1" /></Hide>
            <Split><Plane NormVector = " 1;1;0" NormDistance = "-D1" /></Split>
            <Split><Plane NormVector = " 1;1;0" NormDistance = " D1" /></Split>
            <Split><Plane NormVector = "-1;1;0" NormDistance = "-D1" /></Split>
            <Split><Plane NormVector = "-1;1;0" NormDistance = " D1" /></Split>
            <ShowAll/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitFace" SColors = "SColorsUp" />

        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "SplitFace" SColors = "SColorsFace" />

        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "SplitFace" SColors = "SColorsLeft" />

        <Turn NormVector = "0;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "SplitFace" SColors = "SColorsRight" />

        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "SplitFace" SColors = "SColorsDown" />

        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "SplitFace" SColors = "SColorsBack" />

        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Pattern" >
            <Turn Axis = "2" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "0" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "0" Layers = "0;1" Angle="-Pi/2"/>
            <Turn Axis = "1" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "0" Layers = "0;1" Angle=" Pi/2"/>
            <Turn Axis = "1" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "0" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "1" Layers = "3;4" Angle="-Pi  "/>
            <Turn Axis = "2" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "0" Layers = "0;1" Angle=" Pi/2"/>
            <Turn Axis = "1" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "0" Layers = "0;1" Angle="-Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "0" Layers = "0;1" Angle=" Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "1" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "1" Layers = "0;1" Angle=" Pi/2"/>
            <Turn Axis = "0" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "1" Layers = "0;1" Angle="-Pi/2"/>
            <Turn Axis = "0" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "0" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle="-Pi/2"/>
            <Turn Axis = "0" Layers = "3;4" Angle=" Pi/2"/>
            <Turn Axis = "2" Layers = "3;4" Angle="-Pi/2"/>
        </Macro>

        <Macro Name = "Sc" >
            <Turn Axis = "0" Layers = "Random(5)" Angle = " Pi/4 * Random(8)" />
            <Turn Axis = "Random(2) + 1" Layers = "Random(5)" Angle = "Pi" />
        </Macro>

        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(5)" Angle = "Pi/2 * Random(4)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Pattern" />
            <ExecMacro MacroName = "Sc" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
