<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Son-Mum 3x3x3 Skewb</Name>
        <Menu>Other cubes\Mixup\Son-Mum 3x3x3 Skewb</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-16</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=116032&amp;extra=page%3D1</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.985;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "Split" >
            <Split Axis = "ax" From = "1" To = "1" />
            <Split Axis = "ax" From = "2" To = "2" />
            <Script>Inc(ax);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "3" />

        <Turn Axis = "0" Angle = " Pi / 4" Layer = "1" />
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "3" />
        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "1" />

        <Turn Axis = "1" Angle = " Pi / 4" Layer = "1" />
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "3" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "1" />

        <Turn Axis = "2" Angle = " Pi / 4" Layer = "1" />
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "3" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "1" />

        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
        <RemoveGrayParts/>
    </Figure>
</xml>
