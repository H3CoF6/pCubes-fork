<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda 4x4 Mix</Name>
        <Menu>Other cubes\Bermuda 4x4\Bermuda 4x4 Mix</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=105061</Link>
        <Added>2016-11-30</Added>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi/4; Pi/2; Pi/2; Pi/4" PlaneDistances = "-sqrt(2) / 4; 0; sqrt(2) / 4" >
        <Axis NormVector = " 1;  0;  0" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 0;  0;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
        <Hide Axis = "2" From = "1" To = "2" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "2" Angle = "Pi / 4" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 4" Layer = "3" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <ShowAll/>

        <Hide Axis = "2" Layer = "0" />
        <Hide Axis = "2" Layer = "3" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "0" Layer = "3" />
        <Turn Axis = "1" Angle = "Pi / 4" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi / 4" Layer = "3" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "0" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "3" />
        <ShowAll/>

        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "0" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "3" />

        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <ShowAll/>
    </Figure>
</xml>
