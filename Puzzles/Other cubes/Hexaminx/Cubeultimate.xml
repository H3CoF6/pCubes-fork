<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cubeultimate</Name>
        <Menu>Other Cubes\Hexaminx\Cubeultimate</Menu>
        <Inventor>Jason Smith</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3461</Link>
    </Interface>

    <Script>
        W := 0.5;

        sAngle := 2 * Pi / 5;

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "   0;  ss;  cs" />
        <Axis NormVector = "   0; -ss;  cs" />
        <Axis NormVector = "  ss;  cs;   0" />
        <Axis NormVector = " -ss;  cs;   0" />
        <Axis NormVector = "  cs;   0;  ss" />
        <Axis NormVector = "  cs;   0; -ss" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
