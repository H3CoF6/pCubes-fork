<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexaminx Master</Name>
        <Menu>Other Cubes\Hexaminx\Hexaminx Master</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-19</Added>
    </Interface>

    <Script>
        sAngle := 2 * Pi / 5;

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);
        
        W := 0.5;
        D1 := W / (ss + cs);
        D2 := D1 + 0.041;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "  0; ss; cs" />
        <Axis NormVector = "  0;-ss; cs" />
        <Axis NormVector = " ss; cs;  0" />
        <Axis NormVector = "-ss; cs;  0" />
        <Axis NormVector = " cs;  0; ss" />
        <Axis NormVector = " cs;  0;-ss" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
