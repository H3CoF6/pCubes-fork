<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kilohexaminx Master</Name>
        <Menu>Other Cubes\Hexaminx\Kilohexaminx Master</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4597</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        A := W * 1.17;
        B := W * 0.5;

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);

        D1 := W / (ss + cs);
        D2 := W * cs;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "  0;-ss; cs" />
        <Axis NormVector = "  0; ss; cs" />
        <Axis NormVector = " cs;  0;-ss" />
        <Axis NormVector = " cs;  0; ss" />
        <Axis NormVector = "-ss; cs;  0" />
        <Axis NormVector = " ss; cs;  0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Macro Name = "Split">
            <Split Axis = "id" From = "2" />
            <Split Axis = "id" From = "3" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" id = "0" />

        <HideContaining Vector = "Vx; Vy; Vz" />
        <HideContaining Vector = "Ex; Ey; Ez" />
        <HideContaining Vector = "0;0;0"/>

        <RemoveAllVisible/>
        <ShowAll/>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
