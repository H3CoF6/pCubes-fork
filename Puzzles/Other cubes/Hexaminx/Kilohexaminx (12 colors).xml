<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kilohexaminx (12 colors)</Name>
        <Menu>Other Cubes\Hexaminx\Kilohexaminx (12 colors)</Menu>
        <Inventor>Ben Streeter, JoseRo</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-03-31</Added>
        <Link>https://www.instagram.com/p/CG2p761p6H4/</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2440</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0033EE'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := '8800AA'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0088FF'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF66CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        phi := (Sqrt(5) - 1) / 2; // The golden ratio

        D := W * 0.63;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "   0; Phi;   1" />
        <Axis NormVector = "   0;-Phi;   1" />
        <Axis NormVector = " Phi;   1;   0" />
        <Axis NormVector = "-Phi;   1;   0" />
        <Axis NormVector = "   1;   0; Phi" />
        <Axis NormVector = "   1;   0;-Phi" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[ 5]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />

                <Face Color = "Colors[ 8]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 9]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[11]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />

                <Face Color = "Colors[ 5]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = "0;4;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 8]" VertexIndexes = "4;5;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 7]" VertexIndexes = "5;1;10" InvisibleEdges = "6" />

                <Face Color = "Colors[ 3]" VertexIndexes = "2;3;11" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "3;7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />

                <Face Color = "Colors[ 0]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 9]" VertexIndexes = "6;4;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = "4;0;12" InvisibleEdges = "6" />

                <Face Color = "Colors[ 4]" VertexIndexes = "3;1;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 7]" VertexIndexes = "1;5;13" InvisibleEdges = "6" />
                <Face Color = "Colors[11]" VertexIndexes = "5;7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "7;3;13" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <HideContaining Vector = "Vx; Vy; Vz" />
        <HideContaining Vector = "Ex; Ey; Ez" />
        <HideContaining Vector = "0;0;0"/>
        <RemoveAllVisible/>
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
