<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Hexaminx</Name>
        <Menu>Other Cubes\Hexaminx\Fisher Hexaminx</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6889</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.2;
        D := W * sqrt((5 + sqrt(5)) / 10);

        sAngle := 2 * Pi / 5;
        phi := (sqrt(5) - 1) / 2; // The golden ratio
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "   0; phi;   1" />
        <Axis NormVector = "   0;-phi;   1" />
        <Axis NormVector = " phi;   1;   0" />
        <Axis NormVector = "-phi;   1;   0" />
        <Axis NormVector = "   1;   0; phi" />
        <Axis NormVector = "   1;   0;-phi" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/4" />

        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
