<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Little Chop</Name>
        <Menu>Other cubes\Edge Turning\Master Little Chop</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4016</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3 / sqrt(2);

//        DC1 := W * 0.7;
//        DC2 := W * 2 * sqrt(2) / 3;
//        DC3 := W * sqrt(3)* 2 / 3;
        DCutV := W * 0.9;
        DCutC := W * 0.8;
        DCutE := W * 0.9;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Macro Name = "HidePart1" >
            <HideContaining Vector = "Cx[c] + Cx[ce]/2; Cy[c] + Cy[ce]/2; Cz[c] + Cz[ce]/2" />
        </Macro>
        <Macro Name = "HidePart2" >
            <ExecMacro MacroName = "HidePart1" ce = "c1" />
            <ExecMacro MacroName = "HidePart1" ce = "c2" />
            <ExecMacro MacroName = "HidePart1" ce = "c3" />
            <ExecMacro MacroName = "HidePart1" ce = "c4" />
        </Macro>
        <Macro Name = "HidePartCE" >
            <ExecMacro MacroName = "HidePart2" c = "0" c1 = "2" c2 = "3" c3 = "4" c4 = "5" />
            <ExecMacro MacroName = "HidePart2" c = "1" c1 = "2" c2 = "3" c3 = "4" c4 = "5" />
            <ExecMacro MacroName = "HidePart2" c = "2" c1 = "0" c2 = "1" c3 = "4" c4 = "5" />
            <ExecMacro MacroName = "HidePart2" c = "3" c1 = "0" c2 = "1" c3 = "4" c4 = "5" />
            <ExecMacro MacroName = "HidePart2" c = "4" c1 = "0" c2 = "1" c3 = "2" c4 = "3" />
            <ExecMacro MacroName = "HidePart2" c = "5" c1 = "0" c2 = "1" c3 = "2" c4 = "3" />
        </Macro>

        <Macro Name = "HidePart3" >
            <HideContaining Vector = "(Cx[c] + Vx[v])/2; (Cy[c] + Vy[v])/2; (Cz[c] + Vz[v])/2" />
        </Macro>
        <Macro Name = "HidePart4" >
            <ExecMacro MacroName = "HidePart3" v = "v1" />
            <ExecMacro MacroName = "HidePart3" v = "v2" />
            <ExecMacro MacroName = "HidePart3" v = "v3" />
            <ExecMacro MacroName = "HidePart3" v = "v4" />
        </Macro>
        <Macro Name = "HidePartCV" >
            <ExecMacro MacroName = "HidePart4" c = "0" v1 = "0" v2 = "1" v3 = "2" v4 = "3" />
            <ExecMacro MacroName = "HidePart4" c = "1" v1 = "4" v2 = "5" v3 = "6" v4 = "7" />
            <ExecMacro MacroName = "HidePart4" c = "2" v1 = "0" v2 = "1" v3 = "4" v4 = "5" />
            <ExecMacro MacroName = "HidePart4" c = "3" v1 = "2" v2 = "3" v3 = "6" v4 = "7" />
            <ExecMacro MacroName = "HidePart4" c = "4" v1 = "0" v2 = "2" v3 = "4" v4 = "6" />
            <ExecMacro MacroName = "HidePart4" c = "5" v1 = "1" v2 = "3" v3 = "5" v4 = "7" />
        </Macro>

        <ExecMacro MacroName = "HidePartCE" />
        <ExecMacro MacroName = "HidePartCV" />
        <HideContaining Vector = "Ex; Ey; Ez" />

        <Macro Name = "SplitVertex" >
            <Split> <Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "DCutV" /> </Split>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "SplitVertex" i = "0" Repeat = "8" />
        <RemoveGrayParts/>
        <ShowAll/>

        <HideContaining Vector = "Cx; Cy; Cz" />
        <ExecMacro MacroName = "HidePartCE" />
        <ExecMacro MacroName = "HidePartCV" />
        <InvertVisibility/>
        <Macro Name = "SplitCenter" >
            <Split> <Plane NormVector = "Cx[i]; Cy[i]; Cz[i]" NormDistance = "DCutC" /> </Split>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "SplitCenter" i = "0" Repeat = "6" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Macro Name = "SplitEdge" >
            <HideContaining Vector = "Ex[i]; Ey[i]; Ez[i]" />
            <InvertVisibility/>
            <Split> <Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "DCutE" /> </Split>
            <ShowAll/>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "SplitEdge" i = "0" Repeat = "12" />
        <RemoveGrayParts/>
    </Figure>
</xml>
