<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Little Chop Master Fused</Name>
        <Menu>Other cubes\Edge Turning\Little Chop Master Fused</Menu>
        <Inventor>Scott Bedard</Inventor>
        <Programmer>Julian Wilkinson</Programmer>
        <Added>2020-07-05</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=35862</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3 / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 1; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "0; 0; W" />

        <Macro Name = "Split" >
            <Split><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "D" /></Split>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" i = "0" Repeat = "12" />

        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "RandomTurnNonJumbling" >
            <Turn Axis = "Random(4)" Layer = "1" Angle = "Pi"/>
        </Macro>
        <Macro Name = "Scramble_non_jumbling" Public = "1" Description = "" Sequence = "" >
            <ExecMacro MacroName = "RandomTurnNonJumbling" Repeat = "100" />
        </Macro>

        <Macro Name = "RandomTurn" >
            <Turn Axis = "Random(4)" Layer = "1" Angle = "Pi/3 * Random(6)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "100 random turns" >
            <ExecMacro MacroName = "Scramble_non_jumbling" />
            <ExecMacro MacroName = "RandomTurn" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
