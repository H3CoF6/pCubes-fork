<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Antler Cube</Name>
        <Menu>Other cubes\Edge Turning\Antler Cube</Menu>
        <Inventor>Chandler Griscom</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-10-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12147</Link>
        <Link>https://youtube.com/watch?v=BI6AyC9tjWY</Link>
    </Interface>

    <Script>
        W := 0.5;
        A1 := Arccos(1/3);
        D := W * 0.6;
        dx := W * 0.1;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; 0; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "3"/>
        <Split Axis = "2" From = "3"/>
        <Split><Plane NormVector = "-1; 0;-1" NormDistance = "D" /></Split> <!--<Split Axis = "1" From = "1"/>--> // Goal is to make PartNo = "0"
        <Split><Plane NormVector = " 1; 0;-1" NormDistance = "D" /></Split> <!--<Split Axis = "3" From = "1"/>-->
        <Split><Plane NormVector = "-1;-1; 0" NormDistance = "0" /></Split> <!--<Split Axis = "4" From = "2"/>-->
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = "0" /></Split> <!--<Split Axis = "5" From = "2"/>-->

        <Hide Axis = "1" To = "1" />
        <Hide Axis = "3" To = "1" />
        <HideContaining Vector = "0;0;0" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "2" From = "1" />

        <InvertVisibility/>
        <HideContaining Vector = "0;0;0" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "3" From = "3" />
        <ShowAll/>

        <Macro Name = "SplitE" >
            <HideContaining Vector = " 0; 0; W" />
            <HideContaining Vector = " 0; 0;-W" />
            <InvertVisibility/>
            <Split><Plane NormVector = "-1;-1; 0" NormDistance = "D" /></Split>
            <Split><Plane NormVector = "-1; 1; 0" NormDistance = "D" /></Split>
            <Split><Plane NormVector = " 1; 1; 0" NormDistance = "D" /></Split>
            <Split><Plane NormVector = " 1;-1; 0" NormDistance = "D" /></Split>
            <ShowAll/>
            <Turn NormVector = "1;1;1" Angle = "2*Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "SplitE" Repeat = "3" />

        <Macro Name = "CutE" >
            <HideContaining Vector = " W;-W; W" />
            <HideContaining Vector = "-W;-W; W" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "-D" /> </Cut>
            <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "-D" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi" />
        </Macro>
        <ExecMacro MacroName = "CutE" Repeat = "2" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutE" Repeat = "2" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />

        <HideContaining Vector = "Cx;Cy;Cz" />
        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Macro Name = "SplitV" >
            <HideContaining Vector = "W;W/2;W/2" />
            <InvertVisibility/>
            <Turn NormVector = "0;1;1" Angle = "-A1" />
            <Split><Plane NormVector = " 1; 1; 0" NormDistance = "0" /></Split>
            <Turn NormVector = "0;1;1" Angle = "Pi+2*A1" />
            <Split><Plane NormVector = "-1; 1; 0" NormDistance = "0" /></Split>
            <Turn NormVector = "0;1;1" Angle = "-A1-Pi" />
            <ShowAll/>
        </Macro>
        <Macro Name = "Split4" >
            <ExecMacro MacroName = "SplitV" />
            <Turn NormVector = " 1; 0; 0" Angle = "-Pi/2" />
            <ExecMacro MacroName = "SplitV" />
            <Turn NormVector = " 1; 0; 0" Angle = " Pi/2" />
            <Turn NormVector = " 0; 0; 1" Angle = " Pi" />
        </Macro>
        <ExecMacro MacroName = "Split4" Repeat = "2"  />
        <Turn NormVector = " 1; 1; 0" Angle = " Pi" />
        <ExecMacro MacroName = "Split4" Repeat = "2"  />
        <Turn NormVector = " 1; 1; 0" Angle = " Pi" />
    </Figure>
</xml>
