<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cubic Toru</Name>
        <Menu>Other cubes\Edge Turning\Cubic Toru</Menu>
        <Inventor>Matt Shepit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4247</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        jumAngle := Arccos(1/3);
        E := 7 * sqrt(2) / 48;

        A := W;
        B := W * 0.1;
        C := W * 0.9;
        D := W * 0.5;
    </Script>

    <Axes TurningAngles = "0;Pi" JumbleAngle = "jumAngle" PlaneDistances = "E" NormVectors = "Ex; Ey; Ez" />

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>

        <Macro Name = "HideGray" >
            <HideContaining Vector = " W; 0; W" />
            <HideContaining Vector = " D; 0; W" />
            <HideContaining Vector = " W; 0; D" />
            <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "HideGray" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "HideGray" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "HideGray" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <RemoveGrayParts/>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
    </Figure>

    <Macros>
        <Macro Name = "RandomTurns180" >
            <Turn Axis = "Random(12)" Layer = "1" Angle = "Pi"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(12)" Layer = "1" Angle = "Pi/6 * Random(12)"/>
        </Macro>
        <Macro Name = "Scramble180" Public = "1" >
            <ExecMacro MacroName = "RandomTurns180" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble180" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
