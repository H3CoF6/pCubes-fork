        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 1; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "0; 0; W" />
        <Split><Plane NormVector = "-1;-1; 0" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" /></Split>
        <ShowAll/>
    </Figure>
</xml>
