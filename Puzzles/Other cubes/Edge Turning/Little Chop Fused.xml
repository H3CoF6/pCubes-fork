<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Little Chop Fused</Name>
        <Menu>Other cubes\Edge Turning\Little Chop Fused</Menu>
        <Inventor>Matt Shepit</Inventor>
        <Programmer>Julian Wilkinson</Programmer>
