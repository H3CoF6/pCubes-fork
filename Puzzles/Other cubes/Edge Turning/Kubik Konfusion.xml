<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kubik Konfusion</Name>
        <Menu>Other cubes\Edge Turning\Kubik Konfusion</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4833</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D" >
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 1;  0; -1" />
        <Axis NormVector = "-1; -1;  0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Turn Axis = "0" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-Pi/2" Layer = "1" />

        <Turn Axis = "1" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-Pi/2" Layer = "1" />

        <Turn Axis = "2" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-Pi/2" Layer = "1" />
    </Figure>
</xml>
