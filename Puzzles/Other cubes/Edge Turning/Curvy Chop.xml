<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Chop</Name>
        <Menu>Other cubes\Edge Turning\Curvy Chop</Menu>
        <Inventor>Li Chung Man</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3648</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;

        C := W * (sqrt(2) / 2 + 0.05) ;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "C" FixedLayers = "0" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W" DWZ = "W" />

        <SplitByAxes/>

        <HideContaining Vector = "0; 0; 0" />
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>

        <Turn Axis = "0" Angle = "Pi" Layer = "1" />
        <Turn Axis = "2" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "Pi" Layer = "1" />
        <Turn Axis = "2" Angle = "Pi" Layer = "1" />

        <Turn Axis = "1" Angle = "Pi" Layer = "1" />
        <Turn Axis = "3" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "Pi" Layer = "1" />
        <Turn Axis = "3" Angle = "Pi" Layer = "1" />
    </Figure>

    <Macros>
        <Macro Name = "RandomTurns180" >
            <Turn Axis = "Random(4)" Layer = "1" Angle = "Pi"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(4)" Layer = "1" Angle = "Pi/6 * Random(12)"/>
        </Macro>
        <Macro Name = "Scramble180" Public = "1" >
            <ExecMacro MacroName = "RandomTurns180" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble180" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
