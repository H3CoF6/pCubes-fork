<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Clover</Name>
        <Menu>Other cubes\Edge Turning\Super Clover</Menu>
        <Inventor>rubikonde</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-08</Added>
        <Link>https://www.instagram.com/p/B4ImOpxIYIZ/?igshid=14uvem8iaiik5</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        CColor[0] := '00FF7F';
        CColor[1] := '7F00FF';
        CColor[2] := 'FF007F';
        CColor[3] := '0099FF';

        W := 0.5;
        W1 := W * 0.95;

        <!-- variables chosen in a way to prevent overhang bandaging -->
        A := W * 1.45;
        B := W * 0.171;
        D := A / sqrt(2) * 1.043;

        RCut := (D * sqrt(2) + W1) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <SplitByAxes/>

        <Cut Color = "CColor[0]"> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[1]"> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[2]"> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[3]"> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <Script>
            W := W1;
            include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>

        <RemoveContaining Vector = "Vx; Vy; Vz" />

        <HideAll/>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Split> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Split>
        <Split> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Split>
        <Split> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Split>
        <Split> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Split>
        <HideContaining Vector = "Vx[1]; Vy[1]; Vz[1]" />
        <HideContaining Vector = "Vx[2]; Vy[2]; Vz[2]" />
        <HideContaining Vector = "Vx[4]; Vy[4]; Vz[4]" />
        <HideContaining Vector = "Vx[7]; Vy[7]; Vz[7]" />
        <RemoveAllVisible/>

        <ShowAll/>

        <RemoveContaining Vector = "0; 0; 0" />
        <HideAll/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>

        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <SplitByAxes/>

        <HideContaining Vector = "0; 0; 0" />
        <RemoveAllVisible/>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
