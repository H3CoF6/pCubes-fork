<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Chop Plus</Name>
        <Menu>Other cubes\Edge Turning\Curvy Chop Plus</Menu>
        <Inventor>El_Cubitero</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7917</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;

        A := W * 1.45;
        B := W * 0.171;
        D := A / sqrt(2) + 0.022;

        JAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JAngle" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Cut Color = "clYellow" >
            <Plane>
                <NormVector X = "0" Y = "0" Z = "1" />
                <NormDistance> 0 </NormDistance>
            </Plane>
        </Cut>

        <SplitByAxes/>

        <HideContaining Vector = "0;0;0" />
        <InvertVisibility/>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-A+0.001" /> </Cut>
        <ShowAll />

        <Turn Axis = "0" Angle = "Pi" Layer = "1" />
        <Turn Axis = "2" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "2" />

        <Turn Axis = "1" Angle = "Pi" Layer = "1" />
        <Turn Axis = "3" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "2" />

        <Macro Name = "unbandage" >
            <Turn Axis = "ax1" Layer = "1" Angle = "JAngle" />
            <Turn Axis = "ax2" Layer = "1" Angle = "Pi" />
            <Split Axis = "ax3    " From = "1" />
            <Undo Repeat = "2" />
            <Turn Axis = "ax1" Layer = "1" Angle = "-JAngle" />
            <Turn Axis = "ax4" Layer = "1" Angle = "Pi" />
            <Split Axis = "ax3    " From = "1" />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "unbandage" ax1 = "0" ax2 = "3" ax4 = "1" ax3 = "2" />
        <ExecMacro MacroName = "unbandage" ax1 = "1" ax2 = "0" ax4 = "2" ax3 = "3" />
        <ExecMacro MacroName = "unbandage" ax1 = "2" ax2 = "1" ax4 = "3" ax3 = "0" />
        <ExecMacro MacroName = "unbandage" ax1 = "3" ax2 = "2" ax4 = "0" ax3 = "1" />

        <Turn Axis = "0" Layer = "1" Angle = "Pi" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <ExecMacro MacroName = "unbandage" ax1 = "0" ax2 = "3" ax4 = "1" ax3 = "2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi" />
        <ExecMacro MacroName = "unbandage" ax1 = "2" ax2 = "1" ax4 = "3" ax3 = "0" />
        <Undo Repeat = "3" />

        <ShowAll />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Macros>
        <Macro Name = "RandomTurns180" >
            <Turn Axis = "Random(4)" Layer = "1" Angle = "Pi"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(4)" Layer = "1" Angle = "Pi/6 * Random(12)"/>
        </Macro>
        <Macro Name = "Scramble180" Public = "1" >
            <ExecMacro MacroName = "RandomTurns180" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble180" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
