<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyracue</Name>
        <Menu>Other cubes\Edge Turning\Pyracue</Menu>
        <Inventor>Hiroshi Ishino</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-03-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1356</Link>
    </Interface>

    <Script>
        W := 0.5;
        S2 := sqrt(2);
        D := (S2 - 1) / sqrt(3) / 2;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D" >
        <Axis NormVector = " S2;  0;  1" />
        <Axis NormVector = "-S2;  0;  1" />
        <Axis NormVector = "  0; S2; -1" />
        <Axis NormVector = "  0;-S2; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
