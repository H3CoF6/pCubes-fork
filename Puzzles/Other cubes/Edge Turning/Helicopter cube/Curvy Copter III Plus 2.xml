<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter III Plus 2</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Curvy Copter III Plus 2</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-03-10</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=34176</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.25;
        B := W * 0.2;

        D := W * 0.82;
        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = " 0; -1;  1" />
        <Axis NormVector = "-1;  0;  1" />
        <Axis NormVector = "-1;  1;  0" />
        <Axis NormVector = " 1;  1;  0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = "-W;-W; W" />
        <HideContaining Vector = "-W;-W;-W" />

        <Macro Name = "Split4">
            <Turn  Axis = "1" Layer = "2" Angle = "-JumAngle" />
            <Split Axis = "3" From  = "2" />
            <Undo />

            <Turn  Axis = "3" Layer = "2" Angle = " JumAngle" />
            <Split Axis = "1" From  = "2" />
            <Undo />

            <Turn  Axis = "2" Layer = "2" Angle = " JumAngle" />
            <Split Axis = "0" From  = "2" />
            <Undo />

            <Turn  Axis = "0" Layer = "2" Angle = "-JumAngle" />
            <Split Axis = "2" From  = "2" />
            <Undo />
        </Macro>

        <Macro Name = "Split8">
            <ExecMacro MacroName = "Split4" />
            <Turn Axis = "4" From = "0" To = "2" Angle = "Pi" />
            <Turn Axis = "5" From = "0" To = "2" Angle = "Pi" />
            <ExecMacro MacroName = "Split4" />
            <Turn Axis = "5" From = "0" To = "2" Angle = "Pi" />
            <Turn Axis = "4" From = "0" To = "2" Angle = "Pi" />

            <Turn Axis = "ax" From = "0" To = "2" Angle = "Pi" />
        </Macro>

        <ExecMacro MacroName = "Split8" ax = "2" />
        <ExecMacro MacroName = "Split8" ax = "1" />
        <ExecMacro MacroName = "Split8" ax = "2" />
        <ExecMacro MacroName = "Split8" ax = "1" />
        <ExecMacro MacroName = "Split8" ax = "2" />
        <ExecMacro MacroName = "Split8" ax = "1" />
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
