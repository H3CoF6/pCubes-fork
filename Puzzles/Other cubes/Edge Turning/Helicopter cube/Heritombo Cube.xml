<xml Data_Version = "2" >

    <Interface>
        <Name>Edge Cut 075 (Heritombo Cube Jumbling)</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Heritombo Cube</Menu>
<!--        <Menu>KnightCrawler\Cubic\Edge (12 Axes)\Edge Cut 075 (Heritombo Cube Jumbling)</Menu>-->
        <Inventor>Jason Smith</Inventor>
        <Programmer>KnightCrawler</Programmer>
        <Added>2016-11-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4710</Link>
    </Interface>

    <Script>
        W := 0.5;

        Degree := 75;
        Cut := (180 - Degree) / 180 / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-Cut; Cut" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
