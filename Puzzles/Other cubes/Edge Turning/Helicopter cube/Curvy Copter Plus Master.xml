<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter Plus Master</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Curvy Copter Plus Master</Menu>
        <Inventor>Eitan Cher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4476</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;

        C := sqrt(2) / 4 + 0.015;
        E := C + 0.035;
        D := C - 0.1;

        jumAngle := ArcCos(1 / 3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-C; -E; E; C" FixedLayers = "2" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />

        <HideContaining Vector = " D; D; 0" />
        <HideContaining Vector = "-D; D; 0" />
        <HideContaining Vector = " D;-D; 0" />
        <HideContaining Vector = "-D;-D; 0" />
        <HideContaining Vector = " 0; D; D" />
        <HideContaining Vector = " 0; D;-D" />
        <HideContaining Vector = " 0;-D; D" />
        <HideContaining Vector = " 0;-D;-D" />
        <HideContaining Vector = " D; 0; D" />
        <HideContaining Vector = " D; 0;-D" />
        <HideContaining Vector = "-D; 0; D" />
        <HideContaining Vector = "-D; 0;-D" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <Macro Name = "Split" >
            <Turn  Axis = "Ax1" Layer = "0" Angle = "A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = "A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "3" Angle = "A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "4" Angle = "A * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "3" Angle = "B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "4" Angle = "B * JumAngle" />
            <Split Axis = "Ax1" From  = "1" />
            <Split Axis = "Ax1" From  = "2" />
            <Split Axis = "Ax1" From  = "3" />
            <Split Axis = "Ax1" From  = "4" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "-B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "3" Angle = "-B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "4" Angle = "-B * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "0" Angle = "-A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = "-A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "3" Angle = "-A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "4" Angle = "-A * JumAngle" />
        </Macro>

        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "5" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "0" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "4" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "3" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "5" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "2" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "4" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "1" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "0" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "2" A = "-1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "3" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "1" A = "-1" B = " 1" />
    </Figure>
</xml>
