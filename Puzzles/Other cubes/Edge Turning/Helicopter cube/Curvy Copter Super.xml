<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter Super</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Curvy Copter Super</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1678</Link>
    </Interface>

    <Script>
        W := 0.5;

        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        WM := W * 0.127;
        D := sqrt(2) / 4 + WM / sqrt(2);

        WE := W * 0.5630;
        DCut1 := W;
        DCut2 := W * 1.06;

        Delta := 0.001;
        WD := W + Delta;
        WC := 0.1;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>

        <HideContaining Vector = "0; 0; 0" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />
        <Split> <Plane NormVector = "cx[1]; cy[1]; cz[1]" NormDistance = "-WM" /> </Split>
        <Split> <Plane NormVector = "cx[1]; cy[1]; cz[1]" NormDistance = " WM" /> </Split>
        <Split> <Plane NormVector = "cx[2]; cy[2]; cz[2]" NormDistance = "-WM" /> </Split>
        <Split> <Plane NormVector = "cx[2]; cy[2]; cz[2]" NormDistance = " WM" /> </Split>
        <Split> <Plane NormVector = "cx[5]; cy[5]; cz[5]" NormDistance = "-WM" /> </Split>
        <Split> <Plane NormVector = "cx[5]; cy[5]; cz[5]" NormDistance = " WM" /> </Split>

        <RemoveContaining Vector = "  0;  0; WD" />
        <RemoveContaining Vector = "  0; WC; WD" />
        <RemoveContaining Vector = "  0;-WC; WD" />
        <RemoveContaining Vector = " WC;  0; WD" />
        <RemoveContaining Vector = "-WC;  0; WD" />
        <RemoveContaining Vector = "  0;  0;-WD" />
        <RemoveContaining Vector = "  0; WC;-WD" />
        <RemoveContaining Vector = "  0;-WC;-WD" />
        <RemoveContaining Vector = " WC;  0;-WD" />
        <RemoveContaining Vector = "-WC;  0;-WD" />
        <RemoveContaining Vector = " WD;  0;  0" />
        <RemoveContaining Vector = " WD; WC;  0" />
        <RemoveContaining Vector = " WD;-WC;  0" />
        <RemoveContaining Vector = " WD;  0; WC" />
        <RemoveContaining Vector = " WD;  0;-WC" />
        <RemoveContaining Vector = "-WD;  0;  0" />
        <RemoveContaining Vector = "-WD; WC;  0" />
        <RemoveContaining Vector = "-WD;-WC;  0" />
        <RemoveContaining Vector = "-WD;  0; WC" />
        <RemoveContaining Vector = "-WD;  0;-WC" />
        <RemoveContaining Vector = "  0; WD;  0" />
        <RemoveContaining Vector = " WC; WD;  0" />
        <RemoveContaining Vector = "-WC; WD;  0" />
        <RemoveContaining Vector = "  0; WD; WC" />
        <RemoveContaining Vector = "  0; WD;-WC" />
        <RemoveContaining Vector = "  0;-WD;  0" />
        <RemoveContaining Vector = " WC;-WD;  0" />
        <RemoveContaining Vector = "-WC;-WD;  0" />
        <RemoveContaining Vector = "  0;-WD; WC" />
        <RemoveContaining Vector = "  0;-WD;-WC" />
        <ShowAll/>
    </Figure>
</xml>
