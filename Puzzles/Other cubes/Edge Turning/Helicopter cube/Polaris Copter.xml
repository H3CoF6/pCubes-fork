<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Polaris Copter</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Polaris Copter</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-01-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10726</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3; // W * 1.02 .. W * 4 / 3
        B := A - W;
        C := B * 0.95;

        D := W / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "Hide2" >
            <HideContaining Vector = " W/2*0.99; W/2*0.99; W/2/0.98" />
            <HideContaining Vector = " W/2*0.99; W/2*0.99;-W/2/0.98" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Hide" >
            <ExecMacro MacroName = "Hide2" Repeat = "4" />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        </Macro>

        <LoadFrom File = "Figures\Cube Pillowed 2.xml" />
        <SplitByAxes/>

        <ExecMacro MacroName = "Hide" Repeat = "3" />

        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cube Pillowed 2.xml" />
        <SplitByAxes/>
        <ExecMacro MacroName = "Hide" Repeat = "3" />
        <RemoveAllVisible/>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
