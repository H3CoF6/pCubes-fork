<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter Cube Master</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Helicopter Cube Master</Menu>
        <Inventor>Eitan Cher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3079</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; -D-0.05; D+0.05; D" FixedLayers = "2" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
