<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helio Cube</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Helio Cube</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9587</Link>
    </Interface>
 
    <Script>
        W := 0.35;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / sqrt(2);
        jumAngle := Arccos(1/3);

        W2 := W * 1.5;
        DW := W * 2 / sqrt(3);
        DCut := DW * 7 / 4;
    </Script>

    <Axes TurningAngles = "0;Pi;0" JumbleAngle = "jumAngle" PlaneDistances = " D; D*2" NormVectors = " Ex; Ey; Ez" />
 
    <Figure>
        // inner cube
        <LoadFrom File = "Figures\Cube.xml" />
 
        <SplitByAxes/>

        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "-Vx[i];-Vy[i];-Vz[i]" NormDistance = "-DW" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <HideAll/>

        // outer cube
        <LoadFrom File = "Figures\Cube.xml" W = "W2" />

        <Macro Name = "SplitV" >
            <Split><Plane NormVector = "-Vx[i];-Vy[i];-Vz[i]" NormDistance = "-DCut" /></Split>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "SplitV" i = "0" Repeat = "8" />
        <RemoveContaining Vector = " 0; 0; 0" />

        <ShowAll/>
    </Figure>
</xml>
