<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mezon Helicopter</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Mezon Helicopter</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6015</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />

        <Axis NormVector = " 1;-1; 4" />
        <Axis NormVector = " 1;-4; 1" />
        <Axis NormVector = " 4;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1"/>
        <Split Axis = "0" From = "2"/>
        <Split Axis = "3" From = "1"/>
        <Split Axis = "3" From = "2"/>
        <Split Axis = "5" From = "1"/>
        <Split Axis = "5" From = "2"/>

        <HideContaining Vector = " 0; 0; 0" />
        <Split Axis = "1" From = "1"/>
        <Split Axis = "1" From = "2"/>
        <Split Axis = "2" From = "1"/>
        <Split Axis = "2" From = "2"/>
        <Split Axis = "4" From = "1"/>
        <Split Axis = "4" From = "2"/>
        <ShowAll/>

        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "3" Layer = "0" />
        <Hide Axis = "3" Layer = "2" />
        <Hide Axis = "5" Layer = "0" />
        <Hide Axis = "5" Layer = "2" />

        <Split Axis = "6" From = "1" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "7" From = "2" />
        <Split Axis = "8" From = "1" />
        <Split Axis = "8" From = "2" />
        <ShowAll/>
    </Figure>
</xml>
