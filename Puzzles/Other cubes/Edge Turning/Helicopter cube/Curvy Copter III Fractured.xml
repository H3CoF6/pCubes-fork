<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter III Fractured</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Curvy Copter III Fractured</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-03-10</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=34229</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;

        A := W * 1.25;
        B := W * 0.2;
        D := W * 0.82;

        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <Turn  Axis = "4" Layer = "0" Angle = "-JumAngle" />
        <Turn  Axis = "2" Layer = "2" Angle = " Pi" />
        <Split Axis = "0" From  = "2" />
        <Turn  Axis = "3" Layer = "2" Angle = " Pi" />
        <Split Axis = "1" From  = "1" />
        <Undo Repeat = "2" />
        <Turn  Axis = "3" Layer = "0" Angle = " Pi" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "2" Layer = "0" Angle = " Pi" />
        <Split Axis = "0" From  = "2" />
        <Undo Repeat = "3"/>

        <Turn  Axis = "5" Layer = "0" Angle = "-JumAngle" />
        <Turn  Axis = "3" Layer = "2" Angle = " Pi" />
        <Split Axis = "1" From  = "2" />
        <Turn  Axis = "0" Layer = "2" Angle = " Pi" />
        <Split Axis = "2" From  = "1" />
        <Undo Repeat = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "3" Layer = "0" Angle = " Pi" />
        <Split Axis = "1" From  = "2" />
        <Undo Repeat = "3"/>

        <Turn  Axis = "4" Layer = "2" Angle = " JumAngle" />
        <Turn  Axis = "0" Layer = "2" Angle = " Pi" />
        <Split Axis = "2" From  = "2" />
        <Turn  Axis = "1" Layer = "2" Angle = " Pi" />
        <Split Axis = "3" From  = "1" />
        <Undo Repeat = "2" />
        <Turn  Axis = "1" Layer = "0" Angle = " Pi" />
        <Split Axis = "3" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />
        <Split Axis = "2" From  = "2" />
        <Undo Repeat = "3"/>

        <Turn  Axis = "5" Layer = "2" Angle = " JumAngle" />
        <Turn  Axis = "1" Layer = "2" Angle = " Pi" />
        <Split Axis = "3" From  = "2" />
        <Turn  Axis = "2" Layer = "2" Angle = " Pi" />
        <Split Axis = "0" From  = "1" />
        <Undo Repeat = "2" />
        <Turn  Axis = "2" Layer = "0" Angle = " Pi" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "1" Layer = "0" Angle = " Pi" />
        <Split Axis = "3" From  = "2" />
        <Undo Repeat = "3"/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
