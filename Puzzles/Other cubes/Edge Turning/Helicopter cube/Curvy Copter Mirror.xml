<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter Mirror</Name>
        <Menu>Other cubes\Edge Turning\Helicopter cube\Curvy Copter Mirror</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-11</Added>
        <Link>https://instagram.com/p/CGc6xDEpIgo</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9346</Link>
    </Interface>

    <Script>
        Color := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := Color;

        W := 0.5;

        A := W * 1.2;
        B := W * 0.4;
        D := A / sqrt(2) * 1.04;

        DX := W * 0.02;
        DY := W * 0.03;
        DZ :=-W * 0.04;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Transfer Vector = " DX; DY; DZ" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
