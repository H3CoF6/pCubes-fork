<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter Plus Twist</Name>
        <Menu>Other cubes\Edge Turning\Curvy Copter Plus Twist</Menu>
        <Inventor>Joseph Wong</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6058</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF77BB'; // Pink
        Colors[1] := '8800CC'; // Violett
        Colors[2] := '00BB00'; // Green
        Colors[3] := '0099EE'; // Blue
        Colors[4] := 'AAAAAA'; // Gray
        Colors[5] := 'FFEE00'; // Yellow

        W := 0.5;

        A := W * 1.45;
        B := W * 0.171;
        D := A / sqrt(2) * 1.06;

        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumAngle" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = "-1;-1; 0" />

        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = " 1;-1; 0" />

        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = "-1; 1; 0" />

        <Axis NormVector = " 4; 1; 1" />
        <Axis NormVector = " 1; 4; 1" />
        <Axis NormVector = " 1; 1; 4" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />
        <InvertVisibility/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <HideContaining Vector = "0; 0; 0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Macro Name = "Split" >
            <Turn Axis = "Ax1" Layer = "1" Angle = "A * JumAngle" />
            <Turn Axis = "Ax2" Layer = "1" Angle = "B * JumAngle" />
            <Split Axis = "Ax1" From  = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split" Ax1 = " 1" Ax2 = " 2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 2" Ax2 = " 0" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 0" Ax2 = " 5" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 7" Ax2 = " 5" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 5" Ax2 = " 7" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 9" Ax2 = " 7" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 1" Ax2 = " 3" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 8" Ax2 = " 3" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 3" Ax2 = " 8" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "10" Ax2 = " 8" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 9" Ax2 = "11" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "11" Ax2 = "10" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 6" Ax2 = " 4" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "11" Ax2 = " 6" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 2" Ax2 = " 4" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 4" Ax2 = " 6" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 0" Ax2 = " 1" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "10" Ax2 = " 9" A = " 1" B = "-1" />

        <ExecMacro MacroName = "Split" Ax1 = " 7" Ax2 = " 0" A = "-2" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 6" Ax2 = " 2" A = "-2" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 5" Ax2 = " 9" A = "-2" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 3" Ax2 = "10" A = "-2" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 8" Ax2 = " 1" A = "-2" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = " 4" Ax2 = "11" A = "-2" B = "-1" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
