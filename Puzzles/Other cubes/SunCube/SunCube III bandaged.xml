<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SunCube III bandaged</Name>
        <Menu>Other cubes\SunCube\SunCube III bandaged</Menu>
        <Menu>Other cubes\Mixed\Face-Vertex\SunCube III bandaged</Menu>
        <Inventor>mf8</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-16</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=371149</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D1 := W * (sqrt(2) - 1);
        D2 := (W * 2 - D1) / sqrt(3);
    </Script>
 
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />

        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "6" From = "2" />

        <HideContaining Vector = "Ex; Ey; Ez" />

        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
