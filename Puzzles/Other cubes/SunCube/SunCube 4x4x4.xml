<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SunCube 4x4x4</Name>
        <Menu>Other cubes\SunCube\SunCube 4x4x4</Menu>
        <Menu>Other cubes\Bermuda 4x4\SunCube 4x4x4</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=105092</Link>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-28</Added>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / sqrt(2);
    </Script>
 
    <Axes TurningAngles = "Pi/4; Pi/2; Pi/2; Pi/4" PlaneDistances = "D; 0; -D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "0" Layer = "2" />
        <Turn Axis = "0" Angle = "Pi / 4" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi / 4" Layer = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "0" />
        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "3" />
        <ShowAll/>

        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "1" Layer = "2" />
        <Turn Axis = "1" Angle = "Pi / 4" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi / 4" Layer = "3" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "0" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "3" />
        <ShowAll/>

        <Hide Axis = "2" Layer = "1" />
        <Hide Axis = "2" Layer = "2" />
        <Turn Axis = "2" Angle = "Pi / 4" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 4" Layer = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "0" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "3" />
        <ShowAll/>
    </Figure>

</xml>
