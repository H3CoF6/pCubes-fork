<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SunCube III</Name>
        <Menu>Other cubes\SunCube\SunCube III</Menu>
        <Menu>Other cubes\Mixed\Face-Vertex\SunCube III</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=103552</Link>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-28</Added>
    </Interface>
 
    <Script>
        W := 0.5;
        D1 := W * (sqrt(2) - 1);
        D2 := (2 * W - D1) / sqrt(3);
    </Script>
 
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>

</xml>
