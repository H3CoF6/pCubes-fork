<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Math Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Math Cube</Menu>
        <Inventor>Lawrence Cuthbert</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3965</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W  := 0.5;
        D  := 0.08;
        DX := D * sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D;D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W + DX; -W; -W" />
                <Add Vector = "-W + DX; -W;  W" />
                <Add Vector = "-W + DX;  W; -W" />
                <Add Vector = "-W + DX;  W;  W" />
                <Add Vector = " W + DX; -W; -W" />
                <Add Vector = " W + DX; -W;  W" />
                <Add Vector = " W + DX;  W; -W" />
                <Add Vector = " W + DX;  W;  W" />
            </Vertices>
            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
