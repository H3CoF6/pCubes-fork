<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher cube</Name>
        <Menu>Other cubes\3x3x3 variants\Fisher cube</Menu>
        <Menu>Other cubes\Mixed\Fisher\Fisher cube 3x3x3</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Andrea</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=624</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>

    <!-- Macros added by Minimoed -->
