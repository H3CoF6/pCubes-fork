<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bandsaw Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Bandsaw Cube</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-09-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        Angle := 2 * arctan((3 + sqrt(13)) / sqrt(2));
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "-1; 1; 0" Angle = "Angle" />

        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
