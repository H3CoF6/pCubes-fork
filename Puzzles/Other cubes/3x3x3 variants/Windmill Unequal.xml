<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windmill Unequal</Name>
        <Menu>Other cubes\3x3x3 variants\Windmill Unequal</Menu>
        <Inventor>Moyu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8237</Link>
    </Interface>

    <Script>
        Color := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := Color;

        W := 0.5;
        D := W / 3;

        DX := W * 0.23;
        DY := W * 0.138;
        DZ :=-W * 0.15;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "0.547" />

        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\Cube.xml" />
        <Transfer Vector = " DX; DY; DZ" />

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
