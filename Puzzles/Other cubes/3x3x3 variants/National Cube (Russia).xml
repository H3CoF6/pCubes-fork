<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>National Cube (Russia) </Name>
        <Menu>Other cubes\3x3x3 variants\National Cube (Russia)</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Added>2016-11-25</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=26532</Link>
    </Interface>

    <Script>
        Color1 := 'FFFFFF'; // White
        Color2 := '0039A6'; // Blue
        Color3 := 'D52B1E'; // Red

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 1; 1" Angle = "-0.4" />

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "Color1" />
        <Cut Axis = "2" From = "2" />
        <HideAll/>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "Color2" />
        <Cut Axis = "2" From = "1" To = "2" />
        <HideAll/>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "Color3" />
        <Cut Axis = "2" To = "1" />
        <ShowAll/>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
