<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Case Cube (Cuboid)</Name>
        <Menu>Other cubes\3x3x3 variants\Case Cube (Cuboid)</Menu>
        <Inventor>Jean-Claude Constantin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=884</Link>
    </Interface>

    <Script>
        W := 0.45;
        D := W / 2 / sqrt(2);
        DS2 := W / 4;

        WX := W;
        WY := W + DS2;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 0" BaseVector = " 0;-DS2; 0" />
        <Axis NormVector = "-1; 1; 0" BaseVector = " 0;-DS2; 0" />
        <Axis NormVector = " 0; 0; 1" BaseVector = " 0;-DS2; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = " D * 5 / 2" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = " D * 5 / 2" /></Split>

        <SplitByAxes/>
    </Figure>
</xml>
