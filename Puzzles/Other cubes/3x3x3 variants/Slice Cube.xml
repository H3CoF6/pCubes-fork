<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Slice Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Slice Cube</Menu>
        <Inventor>Nikola Tutic</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2586</Link>
    </Interface>

    <Script>
        W := 0.5;
 
        // init axes
        a[0,0] := 1; a[0,1] := 0; a[0,2] := 0;
        a[1,0] := 0; a[1,1] := 1; a[1,2] := 0;
        a[2,0] := 0; a[2,1] := 0; a[2,2] := 1;

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 1; 0" Angle = " Pi/4" />
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/4" />

        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
