<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Amorphous Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Amorphous Cube</Menu>
        <Inventor>Dario DiBattista</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4341</Link>
    </Interface>

    <Script>
        clGold := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := clGold;

        W := 0.5;
        D := W / 3;

        A1 :=-0.04;
        A2 :=-0.15;
        A3 :=-0.05;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "A1" />
        <Turn NormVector = " 0; 1; 0" Angle = "A2" />
        <Turn NormVector = " 0; 0; 1" Angle = "A3" />

        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
