<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Beveling Axis Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Beveling Axis Cube</Menu>
        <Inventor>Wen Hsi Kang</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-03-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2022</Link>
    </Interface>

    <Script>
        W := 0.5;

        A := W;
        B := -W/(W+1);

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "-A;-1; B" />
        <Axis NormVector = "-B;-A; 1" />
        <Axis NormVector = "-1;-B; A" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
