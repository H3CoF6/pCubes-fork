    </Axes>

    <Figure>
        <Turn NormVector = "1;0;0" Angle = "-arcsin(1/3)" />
        <Turn NormVector = "0;0;1" Angle = "Pi/4" />
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
