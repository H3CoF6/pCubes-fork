<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windmill 3x3x3</Name>
        <Aliases>Windmill cube</Aliases>
        <Menu>Other cubes\3x3x3 variants\Windmill 3x3x3</Menu>
        <Inventor>Katsuhiko Okamoto</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1358</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1 + sqrt(17); 1 - sqrt(17); 0" />
        <Axis NormVector = "sqrt(17) - 1; 1 + sqrt(17); 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
