<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axised Axis Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Axised Axis Cube</Menu>
        <Inventor>Rex Rossano Perez</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2952</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "Pi/4" />
        <Turn NormVector = " 0; 1; 0" Angle = "Arcsin(7/9)" />
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/4" />

        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
