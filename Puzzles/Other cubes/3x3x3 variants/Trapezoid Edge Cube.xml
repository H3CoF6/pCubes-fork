<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trapezoid Edge Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Trapezoid Edge Cube</Menu>
        <Inventor>Troy Robinson</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-03-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5603</Link>
    </Interface>

    <Script>
        W := 0.5;
        az := sqrt(2);
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1;  1;  0" />
        <Axis NormVector = "-1;  1; az" />
        <Axis NormVector = " 1; -1; az" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Turn  Axis = "0" Layer = "1" Angle = "-Pi / 4" />
        <SplitByAxes/>
        <Turn  Axis = "0" Layer = "1" Angle = " Pi / 4" />
    </Figure>
</xml>
