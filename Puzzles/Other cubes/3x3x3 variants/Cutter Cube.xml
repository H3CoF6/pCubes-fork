<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cutter Cube</Name>
        <Menu>Other cubes\3x3x3 variants\Cutter Cube</Menu>
        <Inventor>Ivano Bellio</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-07-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2215</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Layers = "0;2" Angle = " Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "2" Layers = "0;2" Angle = "-Pi / 4" />
    </Figure>
</xml>
