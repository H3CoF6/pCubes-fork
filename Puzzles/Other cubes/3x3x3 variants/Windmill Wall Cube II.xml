<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Windmill Wall Cube II</Name>
        <Menu>Other cubes\3x3x3 variants\Windmill Wall Cube II</Menu>
        <Inventor>Calvin Fan</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4782</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(3) - 1) / 2;
        sAngle := Pi/6;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-sAngle" />
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Layer = "0" Angle = "-sAngle" />
        <Turn Axis = "2" Layer = "2" Angle = "-sAngle" />
        <SplitByAxes/>
        <Undo Repeat = "2" />
    </Figure>
</xml>
