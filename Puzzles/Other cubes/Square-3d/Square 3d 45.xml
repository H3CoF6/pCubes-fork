<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square 3d 45</Name>
        <Class>TSquare3d</Class>
        <Menu>Other cubes\Square 3d\Square 3d 45</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3968</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        pAngle := Pi / 4;
        H := W / cos(pAngle / 2);

        ss := sin(pAngle/2);
        cs := cos(pAngle/2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " ss;  cs; 0" />
        <Axis NormVector = "-ss;  cs; 0" />
        <Axis NormVector = " cs;  ss; 0" />
        <Axis NormVector = " cs; -ss; 0" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; -H" />
                <Add Vector = "Vx[1]; Vy[1];  H" />
                <Add Vector = "Vx[2]; Vy[2]; -H" />
                <Add Vector = "Vx[3]; Vy[3];  H" />
                <Add Vector = "Vx[4]; Vy[4]; -H" />
                <Add Vector = "Vx[5]; Vy[5];  H" />
                <Add Vector = "Vx[6]; Vy[6]; -H" />
                <Add Vector = "Vx[7]; Vy[7];  H" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[1]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[3]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
