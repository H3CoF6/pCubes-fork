<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Baxis Cube</Name>
        <Menu>Other cubes\Axis\Baxis Cube</Menu>
        <Inventor>Gavin Exall (Ex4ll)</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5587</Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = " 1;  2; -2" />
        <Axis NormVector = "-2;  2;  1" />
        <Axis NormVector = " 2;  1;  2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />

        <Hide Axis = "0" From = "0" To = "1" />
        <Hide Axis = "1" From = "2" To = "2" />
        <Split Axis = "2" From = "2" />
        <ShowAll/>

        <Hide Axis = "2" From = "1" To = "2" />
        <Hide Axis = "0" From = "2" To = "2" />
        <Split Axis = "1" From = "1" />
        <ShowAll/>

        <Hide Axis = "1" From = "0" To = "1" />
        <Hide Axis = "2" From = "0" To = "0" />
        <Split Axis = "0" From = "1" />
        <ShowAll/>

        <Hide Axis = "0" From = "2" To = "2" />
        <Hide Axis = "1" From = "2" To = "2" />
        <Hide Axis = "2" From = "0" To = "0" />
        <Split Axis = "0" From = "1" />
        <Hide Axis = "0" From = "1" To = "1" />
        <Split Axis = "1" From = "1" />
        <ShowAll/>

    </Figure>
</xml>
