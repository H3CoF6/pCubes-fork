<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis 7x7x7</Name>
        <Menu>Other cubes\Axis\Axis 7x7x7</Menu>
        <Inventor>Pham Viet Hung</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-06-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5128</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W / 9;
        D2 := 3 * D1;
        D3 := 5 * D1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3;-D2;-D1; D1; D2; D3" >
        <Axis NormVector = "-1; 2; 2"/>
        <Axis NormVector = " 2;-1; 2"/>
        <Axis NormVector = " 2; 2;-1"/>
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
