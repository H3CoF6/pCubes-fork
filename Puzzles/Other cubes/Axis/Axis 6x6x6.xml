<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis 6x6x6</Name>
        <Menu>Other cubes\Axis\Axis 6x6x6</Menu>
        <Inventor>Minh Thang Vo</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3667</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W / 3;
        D2 := W * 0.57;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; 0; D1; D2" >
        <Axis NormVector = "-1;  2;  2"/>
        <Axis NormVector = " 2; -1;  2"/>
        <Axis NormVector = " 2;  2; -1"/>
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
