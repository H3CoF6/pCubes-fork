<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Flox Cube</Name>
        <Menu>Other cubes\Axis\Flox Cube</Menu>
        <Inventor>Carlos Ramírez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9453</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * 0.22;
        D2 := W * 0.48;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = " 1;-2; 2" />
        <Axis NormVector = "-2; 1; 2" />
        <Axis NormVector = "-2;-2;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "2" />
        <Hide Axis = "2" Layer = "2" />

        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <InvertVisibility/>

        <Hide Axis = "1" Layer = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />

        <ShowAll/>
    </Figure>
</xml>
