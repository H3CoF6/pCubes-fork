<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis 2x2x4</Name>
        <Menu>Other cubes\Axis\Axis 2x2x4</Menu>
        <Inventor>SMB Puzzles</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-06-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6765</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 2;  2; -1"/>
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "-1;  2;  2"/>
        <Axis NormVector = " 2; -1;  2"/>
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
