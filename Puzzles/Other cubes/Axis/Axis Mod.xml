<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis Mod</Name>
        <Menu>Other cubes\3x3x3 variants\Axis Mod</Menu>
        <Inventor>Huu Tung Nguyễn</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3248</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        A := (sqrt(3) - 1) / 2;
        B := (sqrt(3) + 1) / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " B; A; 1" />
        <Axis NormVector = " A; B;-1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
