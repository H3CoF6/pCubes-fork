<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

   <Interface>
        <Name>Axis 3x3x5</Name>
        <Menu>Other cubes\Axis\Axis 3x3x5</Menu>
        <Inventor>Ho Nam Hai</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-06-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3247</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W / 3;
        D2 := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "-1;  2;  2"/>
        <Axis NormVector = " 2; -1;  2"/>
        <Axis NormVector = " 2;  2; -1"/>
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />

        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <HideContaining Vector = " W;-W/2; W" />
        <HideContaining Vector = "-W; W/2;-W" />
        <HideContaining Vector = " W/2;-W;-W" />
        <HideContaining Vector = "-W/2; W; W" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>

        <RemoveGrayParts/>
    </Figure>
</xml>
