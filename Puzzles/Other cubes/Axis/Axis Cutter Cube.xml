<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis Cutter Cube</Name>
        <Menu>Other cubes\Axis\Axis Cutter Cube</Menu>
        <Inventor>Michael Womack</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-06-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5311</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 0.383;
    </Script>

    <Axes TurningAngles = "Pi/2;Pi/4;Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "-1;  2;  2" />
        <Axis NormVector = " 2; -1;  2" />
        <Axis NormVector = " 2;  2; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4"/>
        <SplitByAxes/>
        <Undo />
    </Figure>
</xml>
