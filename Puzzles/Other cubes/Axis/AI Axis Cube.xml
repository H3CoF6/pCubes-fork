<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>AI Axis Cube</Name>
        <Menu>Other cubes\Axis\AI Axis Cube</Menu>
        <Inventor>Roberto de la Fuente</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-07-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6081</Link>
    </Interface>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/4; 0; 1/4" >
        <Axis NormVector = " 2;  2; -1" />
        <Axis NormVector = "-1;  2;  2" />
        <Axis NormVector = " 2; -1;  2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W = "0.5" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />

        <Turn  Axis = "0" Layer = "0" Angle = "-Pi/2" />
        <Turn  Axis = "1" Layer = "0" Angle = " Pi  " />

        <Hide  Axis = "2" From = "0" To = "1" />
        <SplitByAxes/>
        <ShowAll/>
        <Turn Angle = "-Pi  " Axis = "1" Layer = "0" />
        <Turn Angle = " Pi/2" Axis = "0" Layer = "0" />

        <RemoveGrayParts/>
    </Figure>
</xml>
