<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis 3x5x7 Cuboid</Name>
        <Menu>Other cubes\Axis\Axis 3x5x7 Cuboid</Menu>
        <Inventor>Jan Bialy</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9603</Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W / 13;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*5;-D*3;-D; D; D*3; D*5" >
        <Axis NormVector = " 1; 2; 2" />
        <Axis NormVector = "-2;-1; 2" />
        <Axis NormVector = "-2; 2;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D * 10" WY = "D * 13" WZ = "D * 9.5" />
    <Script>
    </Script>
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />

        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 7;</Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
