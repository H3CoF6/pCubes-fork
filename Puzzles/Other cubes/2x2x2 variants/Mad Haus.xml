<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mad Haus</Name>
        <Menu>Other cubes\2x2x2 variants\Mad Haus</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1872</Link>
        <Added>2017-09-25</Added>
    </Interface>

    <!--Source : simplified Knightcrawler's code for transformation matrix and Fisher 2x2x2-->
    <Script>
        clGreen  := '009600';
        clYellow := 'FFFF00';
        clBlue   := '0000C8';
        clRed    := 'FF0000';
        clOrange := 'FF800A';
        clWhite  := 'FFFFFF';
        clGold   := 'E0C07D';
        clSilver := 'C0C0C0';

        clUp     := clWhite;
        clDown   := clYellow;
        clLeft   := clRed;
        clRight  := clOrange;
        clFront  := clBlue;
        clBack   := clGreen;

        X1 := -0.75;
        Y1 := -0.75;
        Z1 := -0.5;
        X2 := X1 + 1;
        Y2 := Y1 + 1;
        Z2 := Z1 + 1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "X1; Y1; Z1" />
                <Add Vector = "X1; Y1; Z2" />
                <Add Vector = "X1; Y2; Z1" />
                <Add Vector = "X1; Y2; Z2" />
                <Add Vector = "X2; Y1; Z1" />
                <Add Vector = "X2; Y1; Z2" />
                <Add Vector = "X2; Y2; Z1" />
                <Add Vector = "X2; Y2; Z2" />
            </Vertices>
            <Faces>
                <Face Color = "clFront" VertexIndexes = "1;0;4;5" />
                <Face Color = "clBack"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clLeft"  VertexIndexes = "0;1;3;2" />
                <Face Color = "clRight" VertexIndexes = "5;4;6;7" />
                <Face Color = "clDown"  VertexIndexes = "0;2;6;4" />
                <Face Color = "clUp"    VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
