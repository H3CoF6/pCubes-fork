<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump and Grind 2x2x2 (Mirror)</Name>
        <Menu>Other cubes\2x2x2 variants\Bump and Grind 2x2x2 (Mirror)</Menu>
        <Inventor>Marco Crawley</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3941</Link>
    </Interface>

    <Script>
        MirrorColor := 'C0C0C0';
        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        WX := 0.5;
        WY := WX;
        WZ := WX;

        DWX := WX * 0.24;
        DWY := DWX;
        DWZ := -DWX;

        sa := sin(Pi/8);
        ca := cos(Pi/8);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "-sa; ca; 0" />
        <Axis NormVector = " ca; sa; 0" />
        <Axis NormVector = "  0;  0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "2" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "-Pi/4" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
