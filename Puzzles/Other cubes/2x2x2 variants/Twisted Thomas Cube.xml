    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "35*Pi/180" />
        <Turn NormVector = " 0; 0; 1" Angle = "45*Pi/180" />

        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "1" From = "1" />
        <Turn  Axis = "1" Layer = "0" Angle = " 2 * Pi / 3" />
        <SplitByAxes/>
        <Turn  Axis = "1" Layer = "0" Angle = "-2 * Pi / 3" />
    </Figure>
