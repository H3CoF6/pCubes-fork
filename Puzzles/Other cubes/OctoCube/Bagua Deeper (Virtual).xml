<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bagua Deeper (Virtual)</Name>
        <Menu>Other cubes\OctoCube\Bagua Deeper (Virtual)</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-23</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := 0.15 * W;
        LC := 0.9 * W;
        LE := (LC + D) / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "-W; -D;  W" />
        <HideContaining Vector = " D; -W;  W" />
        <HideContaining Vector = " W;  D;  W" />
        <HideContaining Vector = "-D;  W;  W" />
        <HideContaining Vector = "-W; -D; -W" />
        <HideContaining Vector = " D; -W; -W" />
        <HideContaining Vector = " W;  D; -W" />
        <HideContaining Vector = "-D;  W; -W" />
        <HideContaining Vector = " W;  W;  0" />
        <HideContaining Vector = " W; -W;  0" />
        <HideContaining Vector = "-W;  W;  0" />
        <HideContaining Vector = "-W; -W;  0" />

        <Split> <Plane NormVector = "1; 0; 0" NormDistance = "-LC" /> </Split>
        <Split> <Plane NormVector = "1; 0; 0" NormDistance = " LC" /> </Split>
        <Split> <Plane NormVector = "0; 1; 0" NormDistance = "-LC" /> </Split>
        <Split> <Plane NormVector = "0; 1; 0" NormDistance = " LC" /> </Split>
        <Split> <Plane NormVector = "0; 0; 1" NormDistance = "-LC" /> </Split>
        <Split> <Plane NormVector = "0; 0; 1" NormDistance = " LC" /> </Split>
        <RemoveGrayParts/>
        <ShowAll/>

        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <Split> <Plane NormVector = "0; 1; 1" NormDistance = " LE" /> </Split>
        <Split> <Plane NormVector = "0; 1; 1" NormDistance = "-LE" /> </Split>
        <Split> <Plane NormVector = "0; 1;-1" NormDistance = " LE" /> </Split>
        <Split> <Plane NormVector = "0; 1;-1" NormDistance = "-LE" /> </Split>
        <ShowAll/>

        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "2" />
        <Hide Axis = "2" Layer = "1" />
        <Hide Axis = "0" Layer = "1" />
        <Split> <Plane NormVector = "1; 0; 1" NormDistance = " LE" /> </Split>
        <Split> <Plane NormVector = "1; 0; 1" NormDistance = "-LE" /> </Split>
        <Split> <Plane NormVector = "1; 0;-1" NormDistance = " LE" /> </Split>
        <Split> <Plane NormVector = "1; 0;-1" NormDistance = "-LE" /> </Split>
        <ShowAll/>

        <Hide Axis = "2" Layer = "0" />
        <Hide Axis = "2" Layer = "2" />
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Split> <Plane NormVector = "1; 1; 0" NormDistance = " LE" /> </Split>
        <Split> <Plane NormVector = "1; 1; 0" NormDistance = "-LE" /> </Split>
        <Split> <Plane NormVector = "1;-1; 0" NormDistance = " LE" /> </Split>
        <Split> <Plane NormVector = "1;-1; 0" NormDistance = "-LE" /> </Split>
        <ShowAll/>

        <RemoveGrayParts/>
        <ShowAll/>
        <Turn Axis = "0" Angle =  "Pi / 4" Layer = "0" />
        <Turn Axis = "0" Angle =  "Pi / 4" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "2" />
        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "0" />

        <Turn Axis = "1" Angle =  "Pi / 4" Layer = "0" />
        <Turn Axis = "1" Angle =  "Pi / 4" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "2" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "0" />

        <Turn Axis = "2" Angle =  "Pi / 4" Layer = "0" />
        <Turn Axis = "2" Angle =  "Pi / 4" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "2" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "0" />

        <RemoveGrayParts/>

    </Figure>
</xml>
