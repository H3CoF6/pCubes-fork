<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Uncanny 2x3x3</Name>
        <Menu>Other cubes\Bermuda Cubes\Uncanny 2x3x3</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6916</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) - 1);
        H := W - D;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "-1;  0;  0" />
        <Axis NormVector = " 0; -1;  0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Cut Color = "clYellow"><Plane NormVector = "0;0; 1" NormDistance = "-H" /></Cut>
        <Cut Color = "clWhite "><Plane NormVector = "0;0;-1" NormDistance = "-H" /></Cut>

        <SplitByAxes/>

        <HideContaining Vector = "D / sqrt(2); D / sqrt(2); 0" />
        <Split><Plane NormVector = "1;0;0" NormDistance = "D" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = "D" /></Split>

        <InvertVisibility/>
        <HideContaining Vector = "0;0;0" />
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = "-D" /></Split>
        <ShowAll/>
    </Figure>
</xml>
