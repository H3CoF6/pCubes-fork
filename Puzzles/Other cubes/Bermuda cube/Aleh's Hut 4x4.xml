<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Aleh's Hut 4x4</Name>
        <Menu>Other cubes\Bermuda Cubes\Aleh's Hut 4x4</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-15</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36062</Link>
    </Interface>

    <Script>
        W := 0.5;
        L := W * sqrt(2);
        D := W / 2;

        L1 := D / sqrt(2);
        L2 := L - L1;
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "-1; 0; 0" />
        <Axis NormVector = " 0;-1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " -W; -W; -W" />
                <Add Vector = " -W;  W; -W" />
                <Add Vector = " -D;  W; -W" />
                <Add Vector = "-L1; L2; -W" />
                <Add Vector = "  0;  L; -W" />
                <Add Vector = "  L;  0; -W" />
                <Add Vector = " L2;-L1; -W" />
                <Add Vector = "  W; -D; -W" />
                <Add Vector = "  W; -W; -W" />

                <Add Vector = " -W; -W;  W" />
                <Add Vector = " -W;  W;  W" />
                <Add Vector = " -D;  W;  W" />
                <Add Vector = "-L1; L2;  W" />
                <Add Vector = "  0;  L;  W" />
                <Add Vector = "  L;  0;  W" />
                <Add Vector = " L2;-L1;  W" />
                <Add Vector = "  W; -D;  W" />
                <Add Vector = "  W; -W;  W" />
            </Vertices>

            <Faces>
                <Face Color = "FFFFFF" VertexIndexes = " 0; 1; 2; 3; 4; 5; 6; 7; 8" />
                <Face Color = "FFFF00" VertexIndexes = "17;16;15;14;13;12;11;10; 9" />

                <Face Color = "009600" VertexIndexes = " 1; 0; 9;10"  />
                <Face Color = "0098EE" VertexIndexes = " 2; 1;10;11" />
                <Face Color = "0099EE" VertexIndexes = " 3; 2;11;12" />
                <Face Color = "0198EE" VertexIndexes = " 4; 3;12;13" />
                <Face Color = "C80000" VertexIndexes = " 5; 4;13;14" />
                <Face Color = "0000DD" VertexIndexes = " 6; 5;14;15" />
                <Face Color = "0001DD" VertexIndexes = " 7; 6;15;16" />
                <Face Color = "0100DD" VertexIndexes = " 8; 7;16;17" />
                <Face Color = "FF800B" VertexIndexes = " 0; 8;17; 9" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "2" Layer = "1" Angle = " Pi / 2" />
        <Turn  Axis = "1" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>
        <Undo Repeat = "2" />

        <Turn  Axis = "0" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>
        <Undo />

    </Figure>
</xml>
