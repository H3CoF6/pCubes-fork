<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Asterisk Cube</Name>
        <Menu>Other cubes\Bermuda Cubes\Asterisk Cube</Menu>
        <Inventor>Katelyn Neily</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-07-28</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=9&amp;p=411420</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
                
        <Split Axis = "2" From  = "2" />
        <Split Axis = "0" From  = "1" />
        <HideContaining Vector  = " W; 0;-W" />
        <InvertVisibility/>
        <Split Axis = "1" From  = "1" />
        <Split Axis = "1" From  = "2" />
        <HideContaining Vector  = " W; W;-W" />
        <Split Axis = "2" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <ShowAll/>
        
        <Hide Axis = "2" From = "0" To = "1" />
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "-1;-1; 0" NormDistance = "-D" /></Split>
        <HideContaining Vector  = "-W; 0; W" />
        <HideContaining Vector  = " 0; 0; W" />
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = "-D" /></Split>
        <InvertVisibility/>
        <HideContaining Vector  = "-W; 0; W" />
        <InvertVisibility/>
        <HideContaining Vector  = " W; W; W" />
        <HideContaining Vector  = " W;-W; W" />
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "-D" /></Split>
        <HideContaining Vector  = "-W; 0; W" />
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = "-D" /></Split>
        <ShowAll/>
        
        <HideContaining Vector  = "-W; 0;-W" />
        <InvertVisibility/>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0; 1; 1" NormDistance = "-D" /></Split>
        <HideContaining Vector  = "-W; W;-W" />
        <HideContaining Vector  = "-W; 0; 0" />
        <Split><Plane NormVector = " 0; 1;-1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0;-1; 1" NormDistance = "-D" /></Split>
        <HideContaining Vector  = "-W;-W;-W" />
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D" /></Split>
        <ShowAll/>
        
        <HideContaining Vector  = "-W; W;-W" />
        <InvertVisibility/>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D" /></Split>
        <HideContaining Vector  = "-W; W; 0" />
        <Split><Plane NormVector = " 0;-1;-1" NormDistance = "-D" /></Split>
        <ShowAll/>
        
        <HideContaining Vector  = " W; W;-W" />
        <HideContaining Vector  = " W;-W;-W" />
        <InvertVisibility/>
        <Split><Plane NormVector = "-1; 0; 1" NormDistance = "-D" /></Split>
        <HideContaining Vector  = " 0; W; 0" />
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "-1; 0;-1" NormDistance = "-D" /></Split>
        <HideContaining Vector  = " W; W;-W" />
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D" /></Split>
        <ShowAll/>
                
    </Figure>
</xml>
