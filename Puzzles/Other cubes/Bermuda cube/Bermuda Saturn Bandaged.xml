<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda Saturn Bandaged</Name>
        <Menu>Other cubes\Bermuda Cubes\Bermuda Saturn Bandaged</Menu>
        <Inventor>Lennon (idea)</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-02-17</Added>
        <Link>http://twistypuzzles.ru/forum/index.php/topic,281.msg18067.html#msg18067</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " 3 * Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = " 3 * Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "-Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 2" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = " 3 * Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " Pi / 2" />
        <SplitByAxes/>

        <Undo Repeat = "15"/>
    </Figure>
</xml>
