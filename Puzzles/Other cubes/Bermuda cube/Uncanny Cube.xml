<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Uncanny Cube</Name>
        <Menu>Other cubes\Bermuda Cubes\Uncanny Cube</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-08-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1508</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />

        <Turn  Axis = "1" Layer = "0" Angle = " Pi" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "1" Layer = "0" Angle = " Pi" />

        <Turn  Axis = "2" Layer = "1" Angle = " Pi / 2" />
        <Split Axis = "3" From  = "1" />
        <Split Axis = "3" From  = "2" />
        <Turn  Axis = "2" Layer = "1" Angle = "-Pi / 2" />
    </Figure>
</xml>
