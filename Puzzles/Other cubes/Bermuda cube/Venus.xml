<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda cube - Venus</Name>
        <Menu>Other cubes\Bermuda Cubes\Venus</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Andrea</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2374</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 1" />
        <Axis NormVector = "0; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Hide  Axis = "0" Layer = "0" />
        <Hide  Axis = "0" Layer = "2" />
 	<Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <ShowAll/>

        <HideContaining Vector   = " W; 0; 0" />
        <InvertVisibility/>
        <Split Axis = "1" From  = "1" />
        <Split Axis = "2" From  = "1" />
        <HideContaining Vector   = " W; 0; 0" />
        <SplitByAxes/>
        <ShowAll/>

        <HideContaining Vector   = " W; 0; 0" />
        <InvertVisibility/>
        <Split><Plane NormVector = " 0; 1; 1" NormDistance = " D" /></Split>
        <HideContaining Vector   = " W; 0; 0" />
        <Split><Plane NormVector = " 0; 1;-1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0; 1;-1" NormDistance = "-D" /></Split>
        <ShowAll/>

        <HideContaining Vector   = "-W; 0; 0" />
        <InvertVisibility/>
        <Split Axis = "2" From  = "1" />
        <HideContaining Vector   = "-W; 0; 0" />
        <SplitByAxes/>
        <ShowAll/>

        <HideContaining Vector   = "-W; 0; 0" />
        <InvertVisibility/>
        <Split><Plane NormVector = " 0; 1; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0; 1;-1" NormDistance = " D" /></Split>
        <HideContaining Vector   = "-W; 0; 0" />
        <Split><Plane NormVector = " 0;-1; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0;-1;-1" NormDistance = " D" /></Split>
        <ShowAll/>

 	<Undo/>
    </Figure>
</xml>
