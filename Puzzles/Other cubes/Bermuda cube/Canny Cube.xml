<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Canny Cube</Name>
        <Menu>Other cubes\Bermuda Cubes\Canny Cube</Menu>
        <Inventor>Katelyn Neily</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-06-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5221</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From  = "2" />
        <Hide  Axis = "2" From  = "0" To = "1" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "3" From  = "2" />
        <Split Axis = "4" From  = "1" />
        <Hide  Axis = "1" From  = "1" To = "2" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <ShowAll/>
        <Hide  Axis = "2" From  = "0" To = "1" />
        <Hide  Axis = "1" Layer = "0" />
        <HideContaining Vector  = "0; 0; W" />
        <Split Axis = "3" From  = "1" />
        <Split Axis = "4" From  = "2" />
        <ShowAll/>

        <Turn  Axis = "2" Layer = "2" Angle = "-Pi/2" />
        <Hide  Axis = "2" Layer = "2" />
        <Split Axis = "0" From  = "1" />
        <Hide  Axis = "0" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "Pi / 4" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "2" From  = "1" />
        <HideContaining Vector  = "-W; 0; 0" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "2" From  = "2" />
        <ShowAll/>
        <Undo Repeat = "2" />

        <Hide  Axis = "2" Layer = "2" />
        <Hide  Axis = "0" Layer = "0" />
        <Split Axis = "1" From  = "2" />
        <Hide  Axis = "1" From = "0" To = "1" />
        <Split><Plane NormVector = " 1; 0;-1" NormDistance = " D" /></Split>
        <HideContaining Vector  = "0; W; 0" />
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = " D" /></Split>
        <ShowAll/>

        <Hide  Axis = "2" Layer = "2" />
        <Hide  Axis = "0" Layer = "0" />
        <Hide  Axis = "1" Layer = "2" />
        <Split Axis = "2" From  = "1" />
        <Hide  Axis = "2" Layer = "1" />
        <Split><Plane NormVector = " 1; -1; 0" NormDistance = " D" /></Split>
        <HideContaining Vector  = "0; 0;-W" />
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = " D" /></Split>
        <ShowAll/>

        <Hide  Axis = "2" Layer = "2" />
        <Hide  Axis = "0" Layer = "0" />
        <Hide  Axis = "1" Layer = "2" />
        <Hide  Axis = "2" Layer = "0" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "1" />
        <ShowAll/>

        <HideContaining Vector  = "W; 0; 0" />
        <InvertVisibility/>
        <Split><Plane NormVector = " 1; 0;-1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = " D" /></Split>
        <ShowAll/>

        <HideContaining Vector  = "0;-W; 0" />
        <InvertVisibility/>
        <Split><Plane NormVector = "-1;-1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0;-1;-1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0;-1; 1" NormDistance = " D" /></Split>
        <ShowAll/>

        <RemoveGrayParts/>
    </Figure>
</xml>
