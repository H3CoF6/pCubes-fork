<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher's Golden Cube</Name>
        <Menu>Other cubes\Skewb variants\Fisher's Golden Cube</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=763</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        CutE := W * sqrt(2) * 0.985;
        CutV := (CutE * sqrt(2) - W) * sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "-0.18" />
        <Turn NormVector = " 0; 1; 0" Angle = "-1.20" />
        <Turn NormVector = " 0; 0; 1" Angle = " 1.19" />

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />

        <Split Axis = "2" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi / 2" />
        <SplitByAxes/>
        <Undo/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
