<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Floppy Case Cube</Name>
        <Menu>Other cubes\Vertex Turning\Floppy Case Cube</Menu>
        <Inventor>Kyler van der Gaag</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2290</Link>
    </Interface>

    <Script>
        W := 0.7;
        D := W / sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W * 2 / 3" WY = "W" WZ = "D" />
        <SplitByAxes/>
        <Split> <Plane NormVector = " 1; 1; 0" NormDistance = " D * 3" /></Split>
        <Split> <Plane NormVector = " 1; 1; 0" NormDistance = "-D * 3" /></Split>
        <Split> <Plane NormVector = " 1;-1; 0" NormDistance = " D * 3" /></Split>
        <Split> <Plane NormVector = " 1;-1; 0" NormDistance = "-D * 3" /></Split>
    </Figure>
</xml>
