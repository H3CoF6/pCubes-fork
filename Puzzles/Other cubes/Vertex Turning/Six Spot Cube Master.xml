<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Six Spot Cube Master</Name>
        <Menu>Other cubes\Vertex Turning\Six Spot Cube Master</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-07-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11266</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := A - W;

        D1 := W / sqrt(3) + W * 0.05;
        D2 := W / sqrt(3) - W * 0.05;
    </Script>

    <Axes TurningAngles = "2*Pi / 3" PlaneDistances = " D1; D2" FixedLayers = "0" >
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <Macro Name = "CutUp" >
            <Hide> <Plane NormDistance = "D2" NormVector = " 1; 1; 1" /> </Hide>
            <Hide> <Plane NormDistance = "D2" NormVector = "-1;-1; 1" /> </Hide>
            <Cut>  <Plane NormDistance = "D2" NormVector = "-1; 1; 1" /> </Cut>
            <Cut>  <Plane NormDistance = "D2" NormVector = " 1;-1; 1" /> </Cut>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "CutUp" />
        <Turn NormVector = " 1;-1; 1" Angle = " 2*Pi / 3" />
        <ExecMacro MacroName = "CutUp" />
        <Turn NormVector = "-1;-1; 1" Angle = "-2*Pi / 3" />
        <ExecMacro MacroName = "CutUp" />
        <Turn NormVector = " 1;-1; 1" Angle = " 2*Pi / 3" />
        <ExecMacro MacroName = "CutUp" />
        <Turn NormVector = "-1;-1; 1" Angle = "-2*Pi / 3" />
        <ExecMacro MacroName = "CutUp" />
        <Turn NormVector = " 1;-1; 1" Angle = " 2*Pi / 3" />
        <ExecMacro MacroName = "CutUp" />
        <Turn NormVector = "-1;-1; 1" Angle = "-2*Pi / 3" />
        <HideAll/>


        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />

        <RemoveContaining Vector = " W; W; W" />
        <RemoveContaining Vector = " W;-W;-W" />
        <RemoveContaining Vector = "-W;-W; W" />
        <RemoveContaining Vector = "-W; W;-W" />
        <RemoveContaining Vector = " 0; 0; 0" />
        <Split> <Plane NormDistance = "D2" NormVector = "-1; 1; 1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = " 1;-1; 1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = " 1; 1;-1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = "-1;-1;-1" /> </Split>
        <RemoveContaining Vector = "-A; 0; 0" />
        <RemoveContaining Vector = " A; 0; 0" />
        <RemoveContaining Vector = " 0;-A; 0" />
        <RemoveContaining Vector = " 0; A; 0" />
        <RemoveContaining Vector = " 0; 0;-A" />
        <RemoveContaining Vector = " 0; 0; A" />
        <SplitByAxes/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
