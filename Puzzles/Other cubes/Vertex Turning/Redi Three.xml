<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Redi Three</Name>
        <Menu>Other cubes\Vertex Turning\Redi Three</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-02-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11966</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.2;
        B := W * 0.7;

        D := (A + W) / 2 / sqrt(3);
        E := (A + B + 3 * W) * sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-E;-D; D; E" FixedLayers = "2" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
