<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Circle Skewb</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Circle Skewb</Menu>
        <Inventor>James William Turner</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3633</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.23;
        B := W * 0.5;
        D := W * 2 / sqrt(3);
        RCut := W * 1.3;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitV">
            <HideContaining Vector = "W; W; W" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = " -1; -1;  0.5" NormDistance = "-RCut" /> </Cut>
            <Cut> <Plane NormVector = " -1;  0.5; -1" NormDistance = "-RCut" /> </Cut>
            <Cut> <Plane NormVector = "  0.5; -1; -1" NormDistance = "-RCut" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "1;0;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "SplitV" Ax = "0" Repeat = "4" />
        <Turn NormVector = "0;0;1" Angle = "Pi" />
        <ExecMacro MacroName = "SplitV" Ax = "0" Repeat = "4" />
        <Turn NormVector = "0;0;1" Angle = "Pi" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
