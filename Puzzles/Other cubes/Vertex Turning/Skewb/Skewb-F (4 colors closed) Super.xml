<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb-F (4 colors closed) Super</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb-F (4 colors closed) Super</Menu>
        <Inventor>Claus Simmelkjaer</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-02</Added>
        <Link>https://oliverstickers.com/stickers/special-stickers/scimage-s-designs/scimage-s-dino-skewb-super-4c-closed.html</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF8800'; // clOrange
        Colors[2] := 'FFFF00'; // clYellow
        Colors[3] := '00DD00'; // clGreen

        D1 := W * sqrt(3) / 9;
        D2 := -3 * D1;
        RCut := W * (sqrt(3) - 0.08);
        RCu2 := W * (sqrt(2) - 0.02);

        DH := W * 0.001;
        DW := W * 0.2;
        Angle := Pi * 2 / 3;
    </Script>

    <Axes TurningAngles = "Angle" PlaneDistances = "D1; D2" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" InvisibleEdges = "4" />
                <Face Color = "Colors[0]" VertexIndexes = "3;2;0" InvisibleEdges = "4" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6" InvisibleEdges = "4" />
                <Face Color = "Colors[3]" VertexIndexes = "6;7;5" InvisibleEdges = "4" />
                <Face Color = "Colors[2]" VertexIndexes = "5;1;0" InvisibleEdges = "4" />
                <Face Color = "Colors[1]" VertexIndexes = "0;4;5" InvisibleEdges = "4" />
                <Face Color = "Colors[0]" VertexIndexes = "6;2;3" InvisibleEdges = "4" />
                <Face Color = "Colors[3]" VertexIndexes = "3;7;6" InvisibleEdges = "4" />
                <Face Color = "Colors[0]" VertexIndexes = "0;2;6" InvisibleEdges = "4" />
                <Face Color = "Colors[1]" VertexIndexes = "6;4;0" InvisibleEdges = "4" />
                <Face Color = "Colors[2]" VertexIndexes = "3;1;5" InvisibleEdges = "4" />
                <Face Color = "Colors[3]" VertexIndexes = "5;7;3" InvisibleEdges = "4" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "AddSticker">
            <Part>
                <Vertices>
                    <Add Vector = "-DW + S;-W     ; W     " />
                    <Add Vector = " 0  + S;-W     ; W     " />
                    <Add Vector = "-W     ; 0  + S; W     " />
                    <Add Vector = "-W     ;-DW + S; W     " />
                    <Add Vector = "-DW + S;-W     ; W + DH" />
                    <Add Vector = "-DH + S;-W     ; W + DH" />
                    <Add Vector = "-W     ;-DH + S; W + DH" />
                    <Add Vector = "-W     ;-DW + S; W + DH" />
                </Vertices>

                <Faces>
                    <Face                 VertexIndexes = "3;2;1;0" />
                    <Face Color = "Color" VertexIndexes = "4;5;6;7" InvisibleEdges = "8" />
                    <Face                 VertexIndexes = "0;1;5;4" />
                    <Face                 VertexIndexes = "1;2;6;5" />
                    <Face                 VertexIndexes = "2;3;7;6" />
                    <Face Color = "Color" VertexIndexes = "3;0;4;7" InvisibleEdges = "5" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "StickerColor">
            <ExecMacro MacroName = "AddSticker"  S = "W / 3" />
            <Turn NormVector = "1;1;1" Angle = "Angle" />
        </Macro>

        <ExecMacro MacroName = "StickerColor" Color = "Colors[3]" Repeat = "3" />
        <Turn NormVector = "0;0;1" Angle = "Pi" />
        <ExecMacro MacroName = "StickerColor" Color = "Colors[2]" Repeat = "3" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "StickerColor" Color = "Colors[0]" Repeat = "3" />
        <Turn NormVector = "0;0;1" Angle = "Pi" />
        <ExecMacro MacroName = "StickerColor" Color = "Colors[1]" Repeat = "3" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>

