<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb Master Cube</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb Master Cube</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9084</Link>
    </Interface>

    <Script>
        W := 0.5;
 
        D := W * sqrt(3) / 6;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.982;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; 3*D" > <!-- "-5*D; -D; 3*D" -->
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <Split><Plane NormVector = " 1; 1;-1" NormDistance = "-5*D" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = "-5*D" /></Split>
        <Split><Plane NormVector = "-1;-1;-1" NormDistance = "-5*D" /></Split>
        <Split><Plane NormVector = " 1;-1; 1" NormDistance = "-5*D" /></Split>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
