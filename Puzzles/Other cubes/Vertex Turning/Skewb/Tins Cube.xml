<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tins Cube</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Tins Cube</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-11-22</Added>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?p=425837</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / sqrt(3);

        D1 := D;
        D2 := D * 1.1;
        D3 := D * 2;

        CutV := W * sqrt(3) * 0.96;
        CutE := W * sqrt(2) * 0.982;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D3;-D1; D2; D3" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveContaining Vectors = " Cx; Cy; Cz" />
        <HideAll/>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <SplitByAxes/>
        <HideContaining Vectors = " Cx; Cy; Cz" />
        <RemoveAllVisible/>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = " Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = " Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
