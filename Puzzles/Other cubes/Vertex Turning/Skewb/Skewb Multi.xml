<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb Multi</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb Multi</Menu>
        <Menu>Other forms\Multi-puzzles\Skewb Multi</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-11-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4888</Link>
    </Interface>

    <Script>
        W := 0.5;
 
        D := W * 0.24; // sqrt(3) / 12;
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        C := 1/6;
        D2 := 1 / sqrt(3) - D;

        // central
        DX := 0.04;

        BO := W - D * sqrt(3);//1/4;
        BI := BO - DX;

        RCut := sqrt(3) / 2 - 0.04;
        RCu2 := sqrt(2) / 2 - 0.01;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />

        <Split> <Plane NormDistance = "D2" NormVector = " 1; 1; 1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = " 1; 1;-1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = " 1;-1; 1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = " 1;-1;-1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = "-1; 1; 1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = "-1; 1;-1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = "-1;-1; 1" /> </Split>
        <Split> <Plane NormDistance = "D2" NormVector = "-1;-1;-1" /> </Split>
        <RemoveGrayParts/>

        <Part>
            <Vertices>
                <Add Vector = "-C;-C;-C" />
                <Add Vector = "-C;-C; C" />
                <Add Vector = "-C; C;-C" />
                <Add Vector = "-C; C; C" />
                <Add Vector = " C;-C;-C" />
                <Add Vector = " C;-C; C" />
                <Add Vector = " C; C;-C" />
                <Add Vector = " C; C; C" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Part>
            <Vertices>
                <Add Vector = "-BO;  0; W" />
                <Add Vector = "  0;-BO; W" />
                <Add Vector = " BO;  0; W" />
                <Add Vector = "  0; BO; W" />
                <Add Vector = "-BI;  0; W" />
                <Add Vector = "  0;-BI; W" />
                <Add Vector = " BI;  0; W" />
                <Add Vector = "  0; BI; W" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite" VertexIndexes = "3;0;4;7" />
                <Face Color = "clWhite" VertexIndexes = "0;1;5;4" />
                <Face Color = "clWhite" VertexIndexes = "1;2;6;5" />
                <Face Color = "clWhite" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-BO;  0; -W" />
                <Add Vector = "  0; BO; -W" />
                <Add Vector = " BO;  0; -W" />
                <Add Vector = "  0;-BO; -W" />
                <Add Vector = "-BI;  0; -W" />
                <Add Vector = "  0; BI; -W" />
                <Add Vector = " BI;  0; -W" />
                <Add Vector = "  0;-BI; -W" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow" VertexIndexes = "3;0;4;7" />
                <Face Color = "clYellow" VertexIndexes = "0;1;5;4" />
                <Face Color = "clYellow" VertexIndexes = "1;2;6;5" />
                <Face Color = "clYellow" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "W;-BO;  0" />
                <Add Vector = "W;  0;-BO" />
                <Add Vector = "W; BO;  0" />
                <Add Vector = "W;  0; BO" />
                <Add Vector = "W;-BI;  0" />
                <Add Vector = "W;  0;-BI" />
                <Add Vector = "W; BI;  0" />
                <Add Vector = "W;  0; BI" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange" VertexIndexes = "3;0;4;7" />
                <Face Color = "clOrange" VertexIndexes = "0;1;5;4" />
                <Face Color = "clOrange" VertexIndexes = "1;2;6;5" />
                <Face Color = "clOrange" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-W;-BO;  0" />
                <Add Vector = "-W;  0; BO" />
                <Add Vector = "-W; BO;  0" />
                <Add Vector = "-W;  0;-BO" />
                <Add Vector = "-W;-BI;  0" />
                <Add Vector = "-W;  0; BI" />
                <Add Vector = "-W; BI;  0" />
                <Add Vector = "-W;  0;-BI" />
            </Vertices>

            <Faces>
                <Face Color = "clRed" VertexIndexes = "3;0;4;7" />
                <Face Color = "clRed" VertexIndexes = "0;1;5;4" />
                <Face Color = "clRed" VertexIndexes = "1;2;6;5" />
                <Face Color = "clRed" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "  0; W;-BO" />
                <Add Vector = "-BO; W;  0" />
                <Add Vector = "  0; W; BO" />
                <Add Vector = " BO; W;  0" />
                <Add Vector = "  0; W;-BI" />
                <Add Vector = "-BI; W;  0" />
                <Add Vector = "  0; W; BI" />
                <Add Vector = " BI; W;  0" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen" VertexIndexes = "3;0;4;7" />
                <Face Color = "clGreen" VertexIndexes = "0;1;5;4" />
                <Face Color = "clGreen" VertexIndexes = "1;2;6;5" />
                <Face Color = "clGreen" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "  0;-W;-BO" />
                <Add Vector = " BO;-W;  0" />
                <Add Vector = "  0;-W; BO" />
                <Add Vector = "-BO;-W;  0" />
                <Add Vector = "  0;-W;-BI" />
                <Add Vector = " BI;-W;  0" />
                <Add Vector = "  0;-W; BI" />
                <Add Vector = "-BI;-W;  0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue" VertexIndexes = "3;0;4;7" />
                <Face Color = "clBlue" VertexIndexes = "0;1;5;4" />
                <Face Color = "clBlue" VertexIndexes = "1;2;6;5" />
                <Face Color = "clBlue" VertexIndexes = "2;3;7;6" />
            </Faces>
        </Part>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1;-1" NormDistance = "-RCu2" /> </Cut>
    </Figure>
</xml>
