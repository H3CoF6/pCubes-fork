<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb Bump</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb Bump</Menu>
        <Inventor>Rex Perez</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-03-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6108</Link>
    </Interface>
    
    <Script>
        MirrorColor := 'E0C07D';

        X1 := -1/3 - 0.065;
        Y1 := -2/5;
        Z1 := -8/15;

        X2 := 1 + X1;
        Y2 := 1 + Y1;
        Z2 := 1 + Z1;
    </Script>


    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "X1; Y1; Z1" />
                <Add Vector = "X1; Y1; Z2" />
                <Add Vector = "X1; Y2; Z1" />
                <Add Vector = "X1; Y2; Z2" />
                <Add Vector = "X2; Y1; Z1" />
                <Add Vector = "X2; Y1; Z2" />
                <Add Vector = "X2; Y2; Z1" />
                <Add Vector = "X2; Y2; Z2" />
            </Vertices>
            <Faces>
                <Face Color="MirrorColor" VertexIndexes = "1;0;4;5" />
                <Face Color="MirrorColor" VertexIndexes = "2;3;7;6" />
                <Face Color="MirrorColor" VertexIndexes = "0;1;3;2" />
                <Face Color="MirrorColor" VertexIndexes = "5;4;6;7" />
                <Face Color="MirrorColor" VertexIndexes = "0;2;6;4" />
                <Face Color="MirrorColor" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>

    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
