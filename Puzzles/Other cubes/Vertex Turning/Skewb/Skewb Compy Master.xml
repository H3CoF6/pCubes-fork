<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb Compy Master</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb Compy Master</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-10-06</Added>
    </Interface>

    <Script>
        W := 0.5;
 
        D := sqrt(3) / 12;
        P := sqrt(3) / 4;

        RCut := sqrt(3) / 2 - 0.04;
        RCu2 := sqrt(2) / 2 - 0.01;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D;-P; P; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

   <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1;-1" NormDistance = "-RCu2" /> </Cut>
   </Figure>
</xml>
