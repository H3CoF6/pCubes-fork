<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb-F (12 colors)</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb-F (12 colors)</Menu>
        <Inventor>Claus Simmelkjaer</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-02</Added>
        <Link>https://oliverstickers.com/stickers/special-stickers/scimage-s-designs/scimage-s-dino-skewb-12c.html</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // clRed
        Colors[ 1] := '009600'; // clGreen
        Colors[ 2] := 'DD5500'; // clBrown
        Colors[ 3] := 'FF88DD'; // clRose
        Colors[ 4] := '00DD00'; // clLime
        Colors[ 5] := 'FF8800'; // clOrange
        Colors[ 6] := 'AA00C8'; // clPurple
        Colors[ 7] := 'FFFF00'; // clYellow
        Colors[ 8] := 'AAAA88'; // clGray
        Colors[ 9] := '0000FF'; // clBlue
        Colors[10] := 'FFFFFF'; // clWhite
        Colors[11] := '00AAFF'; // clLightBlue

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D1 := W * sqrt(3) / 9;
        D2 := -3 * D1;
        RCut := W * (sqrt(3) - 0.08);
        RCu2 := W * (sqrt(2) - 0.02);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D1; D2" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = " 1; -1; -1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = "-1;  1; -1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[11]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[ 8]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 9]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[11]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = "0;4;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 8]" VertexIndexes = "4;5;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "5;1;10" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[10]" VertexIndexes = "2;3;11" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = "3;7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[ 9]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                <Face Color = "Colors[ 7]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[ 6]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 7]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "6;4;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = "4;0;12" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[ 1]" VertexIndexes = "3;1;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "1;5;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "5;7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = "7;3;13" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
