<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewb 4-Axes X</Name>
        <Menu>Other cubes\Vertex Turning\Skewb\Skewb 4-Axes X</Menu>
        <Aliases>Compy+Dino+Skewb</Aliases>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9193</Link>
    </Interface>

    <Script>
        W := 0.5;

 
        D := W / sqrt(3) / 5;

        CutV := W * sqrt(3) * 0.95;
        CutE := W * sqrt(2) * 0.982;
        RCut := W * 1.42;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-5 * D; -D; 7 * D" >
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = "-W;-W; W" />
        <Cut><Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /></Cut>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "8" />

        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />
    </Figure>
</xml>
