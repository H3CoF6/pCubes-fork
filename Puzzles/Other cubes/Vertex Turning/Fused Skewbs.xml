<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fused Skewbs</Name>
        <Menu>Other cubes\Vertex Turning\Fused Skewbs</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Ginnanjar Syahfia</Programmer>
        <Added>2019-03-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7293</Link>
    </Interface>

    <Script>
        W := 0.25;

        WX := W;
        WY := W;
        WZ := 3 * W;

        D := W / sqrt(3);
        Ax := W * 2;
        A := 2 * Pi / 3;
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "0" FixedLayers = "0" >
        <Axis NormVector = " 1; 1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = "-1; 1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = " 1;-1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = "-1;-1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = " 1; 1;-1" BaseVector = "0; 0;-Ax" />
        <Axis NormVector = "-1; 1;-1" BaseVector = "0; 0;-Ax" />
        <Axis NormVector = " 1;-1;-1" BaseVector = "0; 0;-Ax" />
        <Axis NormVector = "-1;-1;-1" BaseVector = "0; 0;-Ax" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>

        <Turn Axis = "0" Angle = "A" Layer = "1" />
        <Turn Axis = "2" Angle = "A" Layer = "1" />
        <Turn Axis = "4" Angle = "A" Layer = "1" />
        <Turn Axis = "6" Angle = "A" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "A" Layer = "1" />
        <Turn Axis = "3" Angle = "A" Layer = "1" />
        <Turn Axis = "5" Angle = "A" Layer = "1" />
        <Turn Axis = "7" Angle = "A" Layer = "1" />
        <SplitByAxes/>

        <Undo Repeat = "8"/>

    </Figure>
</xml>
