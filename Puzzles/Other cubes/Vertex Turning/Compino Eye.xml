        <Link></Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        Colors[0] := 'DD0000';
        Colors[2] := '0033EE';
        Colors[3] := '00AA00';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.3;

        D1 := -W / sqrt(3);
        D2 :=  A / sqrt(3) * 1.1;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D1; D2" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
