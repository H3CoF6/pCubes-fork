<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Plus</Name>
        <Menu>Other cubes\Vertex Turning\Dino Plus</Menu>
        <Inventor>Krystian</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6384</Link>
    </Interface>
    <Script>
        clBlack  := '202020';
        clRed    := 'FF0000';
        clGreen  := '00A000';
        clSilver := '606060';
        clCyan   := '009EEE';
        clPurple := '800080';

        H  := 0.5;
        D  := 0.365;

        A1 := 2 * Pi / 3;
        A2 := Pi / 4;
    </Script>

    <Axes TurningAngles = "2*Pi/3" JumbleAngle = "A2" PlaneDistances = "-D;D" FixedLayers = "1">
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " H; H; H" />
                <Add Vector = " H;-H; H" />
                <Add Vector = "-H;-H; H" />
                <Add Vector = "-H; H; H" />
                <Add Vector = " H; H;-H" />
                <Add Vector = " H;-H;-H" />
                <Add Vector = "-H;-H;-H" />
                <Add Vector = "-H; H;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clRed"    VertexIndexes = "3;2;1;0" />
                <Face Color = "clBlack"  VertexIndexes = "0;1;5;4" />
                <Face Color = "clGreen"  VertexIndexes = "1;2;6;5" />
                <Face Color = "clSilver" VertexIndexes = "2;3;7;6" />
                <Face Color = "clPurple" VertexIndexes = "3;0;4;7" />
                <Face Color = "clCyan"   VertexIndexes = "4;5;6;7" />
            </Faces>
        </Part>

        <Split Axis = "1" From  = "2"/>
        <Split Axis = "3" From  = "2"/>
        <Split Axis = "0" From  = "1"/>
        <Split Axis = "2" From  = "1"/>

        <Turn  Axis = "3" Layer = "2" Angle = "A1" />
        <Split Axis = "0" From  = "2"/>
        <Undo/>
        <Turn  Axis = "1" Layer = "2" Angle = "-A1" />
        <Split Axis = "2" From  = "2"/>
        <Undo/>
        <Turn  Axis = "0" Layer = "0" Angle = "-A1" />
        <Split Axis = "3" From  = "1"/>
        <Undo/>
        <Turn  Axis = "2" Layer = "0" Angle = "A1" />
        <Split Axis = "1" From  = "1"/>
        <Undo/>

        /////////////////////////////////////////////

        <Turn  Axis = "3" Layer = "2" Angle = "-A2" />
        <Split Axis = "0" From  = "2"/>
        <Undo/>
        <Turn  Axis = "1" Layer = "2" Angle = "-A2" />
        <Split Axis = "2" From  = "2"/>
        <Undo/>
        <Turn  Axis = "0" Layer = "0" Angle = "A2" />
        <Split Axis = "3" From  = "1"/>
        <Undo/>
        <Turn  Axis = "2" Layer = "0" Angle = "A2" />
        <Split Axis = "1" From  = "1"/>
        <Undo/>

        /////////////////////////////////////////////

        <Hide  Axis = "1" From  = "0" To = "1" />
        <Hide  Axis = "0" From  = "0" To = "1" />
        <Turn  Axis = "0" Layer = "2" Angle = "-A2" />
        <Split Axis = "3" From  = "2"/>
        <Undo/>
        <Turn  Axis = "0" Layer = "2" Angle = "A2" />
        <Split Axis = "2" From  = "1"/>
        <Undo/>
        <ShowAll/>
        <Hide  Axis = "1" From  = "0" To = "1" />
        <Hide  Axis = "3" From  = "1" To = "2" />
        <Turn  Axis = "1" Layer = "2" Angle = "A2" />
        <Split Axis = "0" From  = "2"/>
        <Undo/>
        <ShowAll/>

        <Hide  Axis = "2" From  = "1" To = "2" />
        <Hide  Axis = "0" From  = "0" To = "1" />
        <Turn  Axis = "0" Layer = "2" Angle = "-A2" />
        <Split Axis = "1" From  = "2"/>
        <Undo/>
        <ShowAll/>
        <Hide  Axis = "2" From  = "1" To = "2" />
        <Hide  Axis = "3" From  = "1" To = "2" />
        <Turn  Axis = "2" Layer = "0" Angle = "-A2" />
        <Split Axis = "1" From  = "1"/>
        <Undo/>
        <Turn  Axis = "2" Layer = "0" Angle = "A2" />
        <Split Axis = "0" From  = "2"/>
        <Undo/>
        <ShowAll/>

        <Hide  Axis = "3" From  = "0" To = "1" />
        <Hide  Axis = "2" From  = "0" To = "1" />
        <Turn  Axis = "3" Layer = "2" Angle = "A2" />
        <Split Axis = "0" From  = "2"/>
        <Undo/>
        <Turn  Axis = "3" Layer = "2" Angle = "-A2" />
        <Split Axis = "1" From  = "1"/>
        <Undo/>
        <ShowAll/>
        <Hide  Axis = "3" From  = "0" To = "1" />
        <Hide  Axis = "1" From  = "1" To = "2" />
        <Turn  Axis = "3" Layer = "2" Angle = "A2" />
        <Split Axis = "2" From  = "2"/>
        <Undo/>
        <ShowAll/>

        <Hide  Axis = "0" From  = "1" To = "2" />
        <Hide  Axis = "1" From  = "1" To = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "A2" />
        <Split Axis = "2" From  = "2"/>
        <Undo/>
        <Turn  Axis = "0" Layer = "0" Angle = "-A2" />
        <Split Axis = "3" From  = "1"/>
        <Undo/>
        <ShowAll/>
        <Hide  Axis = "0" From  = "1" To = "2" />
        <Hide  Axis = "2" From  = "0" To = "1" />
        <Turn  Axis = "2" Layer = "2" Angle = "-A2" />
        <Split Axis = "3" From  = "2"/>
        <Undo/>
        <ShowAll/>

        /////////////////////////////////////////////
        <Turn  Axis = "1" Layer = "2" Angle = "-A2" />
        <Hide  Axis = "1" From  = "0" To = "1" />
        <Hide  Axis = "2" From  = "0" To = "1" />
        <Turn  Axis = "2" Layer = "2" Angle = "A2" />
        <Split Axis = "3" From  = "2"/>
        <Undo  Repeat = "2"/>
        <ShowAll/>

        <Turn  Axis = "3" Layer = "2" Angle = "-A2" />
        <Hide  Axis = "3" From  = "0" To = "1" />
        <Hide  Axis = "0" From  = "0" To = "1" />
        <Turn  Axis = "0" Layer = "2" Angle = "A2" />
        <Split Axis = "1" From  = "2"/>
        <Undo  Repeat = "2"/>
        <ShowAll/>

        <Turn  Axis = "0" Layer = "0" Angle = "A2" />
        <Hide  Axis = "0" From  = "1" To = "2" />
        <Hide  Axis = "3" From  = "1" To = "2" />
        <Turn  Axis = "3" Layer = "0" Angle = "-A2" />
        <Split Axis = "2" From  = "1"/>
        <Undo  Repeat = "2"/>
        <ShowAll/>

        <Turn  Axis = "2" Layer = "0" Angle = "A2" />
        <Hide  Axis = "2" From  = "1" To = "2" />
        <Hide  Axis = "1" From  = "1" To = "2" />
        <Turn  Axis = "1" Layer = "0" Angle = "-A2" />
        <Split Axis = "0" From  = "1"/>
        <Undo  Repeat = "2"/>
        <ShowAll/>
    </Figure>
</xml>