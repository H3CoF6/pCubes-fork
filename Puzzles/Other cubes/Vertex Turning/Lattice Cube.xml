<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Lattice Cube</Name>
        <Menu>Other cubes\Vertex Turning\Lattice Cube</Menu>
        <Inventor>Katsuhiko Okamoto</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-10-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1350</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := 1 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; -D/2; D/2; D" FixedLayers = "2" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
