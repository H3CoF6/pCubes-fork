<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ivy Cube (3 colors)</Name>
        <Menu>Other cubes\Vertex Turning\Ivy Cube (3 colors)</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-04</Added>
        <Link>https://www.magiccubemall.com/p/Qiyi-IVY-Magic-Cube-Half-bright_2826991.html</Link>
    </Interface>

    <Script>
        W := 0.5;
        A := W * 1.3;
        B := A - W;
        D := W / sqrt(3);

        clGreen := '00EE00';
        clBlue  := '0000FF';
        clWhite := 'FFFFFF';

        Colors[0] := clWhite;
        Colors[1] := clWhite;
        Colors[2] := clWhite;
        Colors[3] := clWhite;
        Colors[4] := clBlue;
        Colors[5] := clGreen;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D" FixedLayers = "1" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
