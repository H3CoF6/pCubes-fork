<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda Skewb</Name>
        <Menu>Other cubes\Vertex Turning\Bermuda Skewb</Menu>
        <Inventor>Fenz</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5284</Link>
        <Added>2018-12-13</Added>
    </Interface>

    <Script>
        W := 0.5;
        RCut := sqrt(3) / 2 - 0.04;
        RCu2 := sqrt(2) / 2 - 0.01;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />

        <Axis NormVector = " 5;-1; 1" />
        <Axis NormVector = " 5;-1;-1" />
        <Axis NormVector = " 5; 1;-1" />
        <Axis NormVector = " 5; 1; 1" />
        <Axis NormVector = "-1; 5; 1" />
        <Axis NormVector = "-1; 5;-1" />
        <Axis NormVector = " 1; 5;-1" />
        <Axis NormVector = " 1; 5; 1" />
        <Axis NormVector = "-1; 1; 5" />
        <Axis NormVector = "-1;-1; 5" />
        <Axis NormVector = " 1;-1; 5" />
        <Axis NormVector = " 1; 1; 5" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "2" From = "1" />
        <Hide Axis = "2" Layer = "0" />
        <Split Axis = "1" From = "1" />
        <Hide Axis = "1" Layer = "0" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />
        <InvertVisibility/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi / 3" />
        <Split Axis = "3" From = "1" />
        <Hide Axis = "3" Layer = "1" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />
        <Undo/>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>
    </Figure>
</xml>
