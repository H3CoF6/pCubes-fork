<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ripple Cube</Name>
        <Menu>Other cubes\Vertex Turning\Ripple Cube</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7740</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0077EE'; // Blue
        Colors[3] := '00BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        A := W * 1.4;
        B := W * 0.4;
        D1 := W / sqrt(3);
        D2 := (A + B) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
