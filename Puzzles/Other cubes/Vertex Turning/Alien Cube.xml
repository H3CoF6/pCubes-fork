<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Alien Cube</Name>
        <Menu>Other cubes\Vertex Turning\Alien Cube</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8603</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFFFF'; // White
        Colors[1] := '0088FF'; // LightBlue
        Colors[2] := 'FF0000'; // Red
        Colors[3] := 'FFFF00'; // Yellow
        Colors[4] := '00FF00'; // Lime
        Colors[5] := 'FF8800'; // Orange
        Colors[6] := '202020'; // Black

        W := 0.4;
        A := W * 1.6;
        D1 := A / sqrt(3);
        D2 := D1 * 5 / 3;
    </Script>

    <Axes TurningAngles = "2*Pi/3;2*Pi/3; 0; 2*Pi/6" PlaneDistances = "-D2;-D1; D1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; A" />
                <Add Vector = " 0; 0;-A" />
                <Add Vector = " A; 0; 0" />
                <Add Vector = "-A; 0; 0" />
                <Add Vector = " 0; A; 0" />
                <Add Vector = " 0;-A; 0" />
                <Add Vector = " W; W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W;-W;-W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0; 6;10" InvisibleEdges = "5" />
                <Face Color = "Colors[0]" VertexIndexes = "0;10;12" InvisibleEdges = "5" />
                <Face Color = "Colors[0]" VertexIndexes = "0;12; 8" InvisibleEdges = "5" />
                <Face Color = "Colors[0]" VertexIndexes = "0; 8; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[3]" VertexIndexes = "1; 7; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[3]" VertexIndexes = "1; 9;13" InvisibleEdges = "5" />
                <Face Color = "Colors[3]" VertexIndexes = "1;13;11" InvisibleEdges = "5" />
                <Face Color = "Colors[3]" VertexIndexes = "1;11; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[5]" VertexIndexes = "2; 6; 8" InvisibleEdges = "5" />
                <Face Color = "Colors[5]" VertexIndexes = "2; 8; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[5]" VertexIndexes = "2; 9; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[5]" VertexIndexes = "2; 7; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[2]" VertexIndexes = "3;10;11" InvisibleEdges = "5" />
                <Face Color = "Colors[2]" VertexIndexes = "3;11;13" InvisibleEdges = "5" />
                <Face Color = "Colors[2]" VertexIndexes = "3;13;12" InvisibleEdges = "5" />
                <Face Color = "Colors[2]" VertexIndexes = "3;12;10" InvisibleEdges = "5" />
                <Face Color = "Colors[4]" VertexIndexes = "4; 6; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[4]" VertexIndexes = "4; 7;11" InvisibleEdges = "5" />
                <Face Color = "Colors[4]" VertexIndexes = "4;11;10" InvisibleEdges = "5" />
                <Face Color = "Colors[4]" VertexIndexes = "4;10; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[1]" VertexIndexes = "5; 8;12" InvisibleEdges = "5" />
                <Face Color = "Colors[1]" VertexIndexes = "5;12;13" InvisibleEdges = "5" />
                <Face Color = "Colors[1]" VertexIndexes = "5;13; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[1]" VertexIndexes = "5; 9; 8" InvisibleEdges = "5" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "3" From = "3" />

        <Turn Axis = "0" Layer = "3" Angle = "Pi/3" />
        <Turn Axis = "1" Layer = "3" Angle = "Pi/3" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi/3" />
        <Turn Axis = "3" Layer = "3" Angle = "Pi/3" />
        <SplitByAxes />
        <Undo Repeat = "4" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
