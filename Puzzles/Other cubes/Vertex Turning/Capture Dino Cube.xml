<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Capture Dino Cube</Name>
        <Menu>Other cubes\Vertex Turning\Capture Dino Cube</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7615</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.2;
        D := W * sqrt(3) * (2 * A - B) / (2 * A - 3 * B + 4 * W);
        K := W * 1.25;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Macro Name = "Split" >
            <Split Axis = "0" From = "a" />
            <Split Axis = "1" From = "a" />
            <Split Axis = "2" From = "a" />
            <Split Axis = "3" From = "a" />
        </Macro>
        <ExecMacro MacroName = "Split" a = "1" />

        <Macro Name = "Cut1" >
            <Turn  Axis = "0" Layer = "b" Angle = "Pi/3" />
            <ExecMacro MacroName = "Split" />
            <Turn  Axis = "1" Layer = "b" Angle = "Pi/3" />
            <ExecMacro MacroName = "Split" />
            <Turn  Axis = "2" Layer = "b" Angle = "Pi/3" />
            <ExecMacro MacroName = "Split" />
            <Turn  Axis = "3" Layer = "b" Angle = "Pi/3" />
            <ExecMacro MacroName = "Split" />
            <Undo Repeat = "4" />
        </Macro>
        <ExecMacro MacroName = "Cut1" a = "1" b = "0" />
        <HideContaining Vector = " K; 0; 0" />
        <HideContaining Vector = "-K; 0; 0" />
        <HideContaining Vector = " 0; K; 0" />
        <HideContaining Vector = " 0;-K; 0" />
        <HideContaining Vector = " 0; 0; K" />
        <HideContaining Vector = " 0; 0;-K" />
        <SplitByAxes/>
        <ExecMacro MacroName = "Cut1" a = "2" b = "2" />
        <Macro Name = "Cut2" >
            <Turn Axis = "a" Layer = "0" Angle = " Pi/3" />
            <Turn Axis = "b" Layer = "0" Angle = " Pi/3" />
            <Turn Axis = "a" Layer = "0" Angle = "-Pi/3" />
            <Turn Axis = "b" Layer = "0" Angle = "-Pi/3" />
            <SplitByAxes/>
            <Undo Repeat = "4" />
        </Macro>

        <ExecMacro MacroName = "Cut2" a = "0" b = "1" />
        <ExecMacro MacroName = "Cut2" a = "0" b = "2" />
        <ExecMacro MacroName = "Cut2" a = "0" b = "3" />
        <ExecMacro MacroName = "Cut2" a = "1" b = "0" />
        <ExecMacro MacroName = "Cut2" a = "1" b = "2" />
        <ExecMacro MacroName = "Cut2" a = "1" b = "3" />
        <ExecMacro MacroName = "Cut2" a = "2" b = "0" />
        <ExecMacro MacroName = "Cut2" a = "2" b = "1" />
        <ExecMacro MacroName = "Cut2" a = "2" b = "3" />
        <ExecMacro MacroName = "Cut2" a = "3" b = "0" />
        <ExecMacro MacroName = "Cut2" a = "3" b = "1" />
        <ExecMacro MacroName = "Cut2" a = "3" b = "2" />
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
