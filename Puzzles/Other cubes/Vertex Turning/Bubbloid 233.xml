<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bubbloid 233</Name>
        <Menu>Other cubes\Vertex Turning\Bubbloid 233</Menu>
        <Inventor>Carl Hoff</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4914</Link>
    </Interface>

    <Script>
        W := 0.42;

        WX := W;
        WY := W;
        WZ := W * 6 / 5;

        D := W * 7 / 5 / sqrt(3);
        Ax := WZ - W;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 1; 1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = "-1; 1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = " 1;-1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = "-1;-1; 1" BaseVector = "0; 0; Ax" />
        <Axis NormVector = " 1; 1;-1" BaseVector = "0; 0;-Ax" />
        <Axis NormVector = "-1; 1;-1" BaseVector = "0; 0;-Ax" />
        <Axis NormVector = " 1;-1;-1" BaseVector = "0; 0;-Ax" />
        <Axis NormVector = "-1;-1;-1" BaseVector = "0; 0;-Ax" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
        <Macro Name = "Cut">
            <SplitByAxes/>
            <Turn Axis = "a" Angle = " 2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "b" Angle = " 2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "c" Angle = " 2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "d" Angle = " 2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Undo Repeat = "4"/>

            <Turn Axis = "d" Angle = "-2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "c" Angle = "-2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "b" Angle = "-2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a" Angle = "-2 * Pi / 3" Layer = "1" />
            <SplitByAxes/>
            <Undo Repeat = "4"/>
        </Macro>

        <ExecMacro MacroName = "Cut" a = "0" b = "1" c = "5" d = "4"/>
        <ExecMacro MacroName = "Cut" a = "1" b = "3" c = "7" d = "5"/>
        <ExecMacro MacroName = "Cut" a = "3" b = "2" c = "6" d = "7"/>
        <ExecMacro MacroName = "Cut" a = "2" b = "0" c = "4" d = "6"/>
        <Turn Axis = "1" Angle = " 2 * Pi / 3" Layer = "1" />
        <Turn Axis = "2" Angle = " 2 * Pi / 3" Layer = "1" />
        <Turn Axis = "0" Angle = "-2 * Pi / 3" Layer = "1" />
        <Turn Axis = "3" Angle = "-2 * Pi / 3" Layer = "1" />
        <ExecMacro MacroName = "Cut" a = "0" b = "1" c = "5" d = "4"/>
        <ExecMacro MacroName = "Cut" a = "1" b = "3" c = "7" d = "5"/>
        <ExecMacro MacroName = "Cut" a = "3" b = "2" c = "6" d = "7"/>
        <ExecMacro MacroName = "Cut" a = "2" b = "0" c = "4" d = "6"/>
        <Turn Axis = "5" Angle = " 2 * Pi / 3" Layer = "1" />
        <Turn Axis = "6" Angle = " 2 * Pi / 3" Layer = "1" />
        <Turn Axis = "4" Angle = "-2 * Pi / 3" Layer = "1" />
        <Turn Axis = "7" Angle = "-2 * Pi / 3" Layer = "1" />
        <ExecMacro MacroName = "Cut" a = "0" b = "1" c = "5" d = "4"/>
        <ExecMacro MacroName = "Cut" a = "1" b = "3" c = "7" d = "5"/>
        <ExecMacro MacroName = "Cut" a = "3" b = "2" c = "6" d = "7"/>
        <ExecMacro MacroName = "Cut" a = "2" b = "0" c = "4" d = "6"/>
        <Undo Repeat = "8"/>
    </Figure>
</xml>
