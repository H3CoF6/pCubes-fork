<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trinocular Skewb</Name>
        <Menu>Other cubes\Vertex Turning\Trinocular Skewb</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6256</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := W * 0.35;

        D1 := (-2*A^2 + 2*A*B + 2*A*W - 3*B*W + 2*W^2) / (2*A - B) / sqrt(3);
        D2 := 2 * (A - W) / sqrt(3) + D1;
        D3 := 2 * W / sqrt(3) - D1;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D1;D2;D3" FixedLayers = "" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
