<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rex Illusion</Name>
        <Menu>Other cubes\Vertex Turning\Rex Illusion</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-05-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2360</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W * 3 / 2 / sqrt(3);
        RCut := W * 5 / 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi*2/3; 0; Pi*2/3" PlaneDistances = "-D; D">
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <!-- cut vertices -->
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>
    </Figure>
</xml>
