<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bubbloid 122</Name>
        <Menu>Other cubes\Vertex Turning\Bubbloid 122</Menu>
        <Inventor>Carl Hoff</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3326</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.4;
        H0 := 5 * W / 4;
        H := H0 + 0.0005;
        D := sqrt(3) * W / 2;
        A := H0 - W;
        Angle := 2 * Pi / 3;
    </Script>

    <Axes TurningAngles = "Angle" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 1; 1; 1" BaseVector = "0; 0; A" />
        <Axis NormVector = "-1; 1; 1" BaseVector = "0; 0; A" />
        <Axis NormVector = " 1;-1; 1" BaseVector = "0; 0; A" />
        <Axis NormVector = "-1;-1; 1" BaseVector = "0; 0; A" />
        <Axis NormVector = " 1; 1;-1" BaseVector = "0; 0;-A" />
        <Axis NormVector = "-1; 1;-1" BaseVector = "0; 0;-A" />
        <Axis NormVector = " 1;-1;-1" BaseVector = "0; 0;-A" />
        <Axis NormVector = "-1;-1;-1" BaseVector = "0; 0;-A" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-W; -W; -H" />
                  <Add Vector = "-W; -W;  H" />
                  <Add Vector = "-W;  W; -H" />
                  <Add Vector = "-W;  W;  H" />
                  <Add Vector = " W; -W; -H" />
                  <Add Vector = " W; -W;  H" />
                  <Add Vector = " W;  W; -H" />
                  <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                  <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                  <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                  <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                  <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                  <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                  <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Macro Name = "Cut">
            <Turn Axis = "a+0" Angle = " Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+1" Angle = " Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+3" Angle = " Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+2" Angle = " Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+1" Angle = "-Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+0" Angle = "-Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+3" Angle = "-Angle" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "a+2" Angle = "-Angle" Layer = "1" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Cut" Repeat = "2" a = "0"/>
        <ExecMacro MacroName = "Cut" Repeat = "2" a = "4"/>
        <Undo Repeat = "32"/>
        <Turn Axis = "a+1" Angle = "-Angle" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "a+3" Angle = "-Angle" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "a+3" Angle = "Angle" Layer = "1" />
        <Turn Axis = "a+1" Angle = "Angle" Layer = "1" />
        <HideContaining Vector = "0; 0; 0" />
        <Cut Color = "Colors[4]"> <Plane NormVector = "0; 0; 1" NormDistance = "-H0" /> </Cut>
        <Cut Color = "Colors[5]"> <Plane NormVector = "0; 0;-1" NormDistance = "-H0" /> </Cut>
        <ShowAll/>
        <Cut> <Plane NormVector = "0; 0;-1" NormDistance = "-H0" /> </Cut>
        <Cut> <Plane NormVector = "0; 0; 1" NormDistance = "-H0" /> </Cut>
    </Figure>
</xml>
