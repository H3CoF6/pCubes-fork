<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Dino Cube</Name>
        <Menu>Other cubes\Vertex Turning\Crazy Dino Cube</Menu>
        <Inventor>Chris DeAngelis</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-02-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4571</Link>
    </Interface>

    <Script>
        W := 0.5;
        A := Pi * 2 / 3;
        D1 := sqrt(3) / 6;
        D2 := D1 + 0.4;
    </Script>

    <Axes TurningAngles = "0; A; 0; A; 0" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
