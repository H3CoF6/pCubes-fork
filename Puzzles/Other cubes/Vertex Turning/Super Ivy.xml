<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Ivy</Name>
        <Menu>Other cubes\Vertex Turning\Super Ivy</Menu>
        <Inventor>rubikonde</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-08</Added>
        <Link>https://www.instagram.com/p/CFAwMKDp9hE/</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        CColor[0] := '00FF7F';
        CColor[1] := '7F00FF';
        CColor[2] := 'FF007F';
        CColor[3] := '0099FF';

        W := 0.5;
        W1 := W * 0.95;

        A := W * 1.3;
        B := W * 0.63;

        D := W * 0.378;

        RCut := (D * sqrt(3) + 2 * W1) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <SplitByAxes/>

        <RemoveContaining Vector = " W; W; W" />
        <RemoveContaining Vector = " W;-W;-W" />
        <RemoveContaining Vector = "-W; W;-W" />
        <RemoveContaining Vector = "-W;-W; W" />

        <Cut Color = "CColor[0]"> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[1]"> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[2]"> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[3]"> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <HideAll/>


        <LoadFrom File = "Figures\Cube.xml" W = "W1" />

        <SplitByAxes/>

        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = "-W;-W; W" />
        <RemoveAllVisible/>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
