<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Mosaic Cube</Name>
        <Menu>Other cubes\Vertex Turning\Curvy Mosaic Cube</Menu>
        <Inventor>Runchuan Lan</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-10-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6882</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.2;
        B := W * 2 - A;
        D1 := A / sqrt(3);
        D2 := (A + B) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
