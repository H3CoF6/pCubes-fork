<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ivy + Offset Skewb</Name>
        <Menu>Other cubes\Vertex Turning\Ivy + Offset Skewb</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-11-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8996</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 1.3;
        B := A - W;

        D1 := W / sqrt(3);
        D2 := D1 * 0.7;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D1; D2" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
