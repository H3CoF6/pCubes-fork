<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skewbrick</Name>
        <Menu>Other cubes\Vertex Turning\Skewbrick</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1830</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        W := 0.5;
        D0 := -W;
        D1 := -W / 3;
        D2 :=  W / 3;
        D3 :=  W;
        H := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "0; 2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" BaseVector = "D2; D2; 0" />
        <Axis NormVector = "-1;-1; 1" BaseVector = "D1; D1; 0" />
        <Axis NormVector = " 1; 1;-1" BaseVector = "D2; D2; 0" />
        <Axis NormVector = "-1;-1;-1" BaseVector = "D1; D1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "D0; D0; -H" />
                  <Add Vector = "D0; D0;  H" />
                  <Add Vector = "D0; D3; -H" />
                  <Add Vector = "D0; D3;  H" />
                  <Add Vector = "D3; D0; -H" />
                  <Add Vector = "D3; D0;  H" />
                  <Add Vector = "D3; D3; -H" />
                  <Add Vector = "D3; D3;  H" />
            </Vertices>

            <Faces>
                  <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                  <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                  <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                  <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                  <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                  <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Turn Axis = "0" Angle = "2 * Pi / 3" Layer = "1" />
        <Turn Axis = "1" Angle = "2 * Pi / 3" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "2 * Pi / 3" Layer = "1" />
        <Turn Axis = "3" Angle = "2 * Pi / 3" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "2 * Pi / 3" Layer = "1" />
        <Turn Axis = "1" Angle = "2 * Pi / 3" Layer = "1" />
        <SplitByAxes/>

        <Undo Repeat = "6"/>
    </Figure>
</xml>
