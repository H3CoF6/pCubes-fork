<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Compy Cube Master</Name>
        <Menu>Other cubes\Vertex Turning\Compy Cube Master</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7774</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * sqrt(3) * 5 / 12;
        D2 := W * sqrt(3) * 7 / 12;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "1;  1;  1" />
        <Axis NormVector = "1;  1; -1" />
        <Axis NormVector = "1; -1;  1" />
        <Axis NormVector = "1; -1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
