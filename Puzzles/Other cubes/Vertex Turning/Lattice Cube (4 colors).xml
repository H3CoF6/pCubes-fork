<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Lattice Cube (4 colors)</Name>
        <Menu>Other cubes\Vertex Turning\Lattice Cube (4 colors)</Menu>
        <Inventor>Claus Simmelkjaer</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-02</Added>
        <Link>https://oliverstickers.com/stickers/special-stickers/scimage-s-designs/scimage-s-lattice-4c.html</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        Colors[0] := 'FF0000'; // clRed   
        Colors[1] := 'FF8800'; // clOrange
        Colors[2] := 'FFFF00'; // clYellow
        Colors[3] := '00DD00'; // clGreen 

        D1 := W / sqrt(3);
        D2 := D1 * 2;
        Angle := Pi * 2 / 3;
    </Script>

    <Axes TurningAngles = "Angle" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[0]" VertexIndexes = "3;2;0" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6" />
                <Face Color = "Colors[3]" VertexIndexes = "6;7;5" />
                <Face Color = "Colors[2]" VertexIndexes = "5;1;0" />
                <Face Color = "Colors[1]" VertexIndexes = "0;4;5" />
                <Face Color = "Colors[0]" VertexIndexes = "6;2;3" />
                <Face Color = "Colors[3]" VertexIndexes = "3;7;6" />
                <Face Color = "Colors[0]" VertexIndexes = "0;2;6" />
                <Face Color = "Colors[1]" VertexIndexes = "6;4;0" />
                <Face Color = "Colors[2]" VertexIndexes = "3;1;5" />
                <Face Color = "Colors[3]" VertexIndexes = "5;7;3" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>

        <Turn Axis = "1" From = "3" To = "4" Angle = "-Angle" />
        <Turn Axis = "2" From = "3" To = "4" Angle = " Angle" />
        <Turn Axis = "1" From = "3" To = "4" Angle = "-Angle" />
        <Turn Axis = "2" From = "3" To = "4" Angle = " Angle" />
        <Turn Axis = "2" From = "0" To = "1" Angle = "-Angle" />
        <Turn Axis = "1" From = "0" To = "1" Angle = " Angle" />
        <Turn Axis = "2" From = "0" To = "1" Angle = "-Angle" />
        <Turn Axis = "1" From = "0" To = "1" Angle = " Angle" />
        <SaveSolvedState/>
        <Undo Repeat = "10" />

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
