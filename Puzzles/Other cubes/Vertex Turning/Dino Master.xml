<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Master</Name>
        <Menu>Other cubes\Vertex Turning\Dino Master</Menu>
        <Inventor>David Hiraki</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10252</Link>
    </Interface>

    <Script>
        W := 0.5;

        A := Pi * 2 / 3;
        D1 := W * sqrt(3) / 3;
        D2 := D1 + W * 0.26;
    </Script>

    <Axes TurningAngles = "A; A; 0; A; A" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
