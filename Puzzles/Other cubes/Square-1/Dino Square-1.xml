<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Square-1</Name>
        <Menu>Other cubes\Square-1\Dino Square-1</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4280</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        clBlue   := '0000FF';
        clGreen  := '00FF00';
        clYellow := 'FFFF00';
        clOrange := 'F06000';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
                <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
                <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange" VertexIndexes = "1;2;0" InvisibleEdges = "1" />
                <Face Color = "clOrange" VertexIndexes = "2;4;0" InvisibleEdges = "1" />
                <Face Color = "clOrange" VertexIndexes = "4;1;0" InvisibleEdges = "1" />
                <Face Color = "clGreen " VertexIndexes = "1;7;3" InvisibleEdges = "1" />
                <Face Color = "clGreen " VertexIndexes = "2;1;3" InvisibleEdges = "1" />
                <Face Color = "clGreen " VertexIndexes = "7;2;3" InvisibleEdges = "1" />
                <Face Color = "clBlue  " VertexIndexes = "1;4;5" InvisibleEdges = "1" />
                <Face Color = "clBlue  " VertexIndexes = "4;7;5" InvisibleEdges = "1" />
                <Face Color = "clBlue  " VertexIndexes = "7;1;5" InvisibleEdges = "1" />
                <Face Color = "clYellow" VertexIndexes = "2;7;6" InvisibleEdges = "1" />
                <Face Color = "clYellow" VertexIndexes = "4;2;6" InvisibleEdges = "1" />
                <Face Color = "clYellow" VertexIndexes = "7;4;6" InvisibleEdges = "1" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 2" />
        <SplitByAxes/>
        <Undo />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
