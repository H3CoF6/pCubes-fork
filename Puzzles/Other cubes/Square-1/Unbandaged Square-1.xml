<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unbandaged Square-1</Name>
        <Menu>Other cubes\Square-1\Unbandaged Square-1</Menu>
        <Inventor>Chandler Griscom</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3527</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        for i := 0 to 5 do begin
            xa[i] := sin(Pi / 12 * (2*i+1));
            ya[i] := cos(Pi / 12 * (2*i+1));
        end;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "xa[0]; ya[0]; 0" />
        <Axis NormVector = "xa[1]; ya[1]; 0" />
        <Axis NormVector = "xa[2]; ya[2]; 0" />
        <Axis NormVector = "xa[3]; ya[3]; 0" />
        <Axis NormVector = "xa[4]; ya[4]; 0" />
        <Axis NormVector = "xa[5]; ya[5]; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
