<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sq-5 5-layers</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Sq-5 5-layers</Menu>
        <Inventor>Ge Sheng Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12080</Link>
        <Added>2025-02-17</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5;
        sAngle := 9*Pi / 180; // 9 degrees

        DCut := W * 0.2;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-3*D;-D; D; 3*D" TurnAxesWithLayer = "2" NormVectors = "0; 0; 1" />

    <Axes TurningAngles = "Pi" PlaneDistances = "0" NormVectors = " 1; 0; 0" />

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "sAngle*1.5 + Pi/2" />
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "0" Layers = "0;1;3;4" Angle = "sAngle * i" />
            <Split Axis = "1" From = "1" />
        </Macro>
        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "2" />
        <ExecMacro MacroName = "Split" i = "3" />
        <ExecMacro MacroName = "Split" i = "2" />
        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "2" />
        <ExecMacro MacroName = "Split" i = "3" />
        <Undo Repeat = "11" />

        <Macro Name = "Cut" >
            <Turn NormVector = "0;0;1" Angle = "sAngle / 2" />
            <HideContaining Vector = " 0; DCut*2; W" />
            <HideContaining Vector = " 0; DCut*2;-W" />
            <InvertVisibility/>
            <Cut><Plane NormVector = "0;1;0" NormDistance = "DCut" /></Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "sAngle / 2" />
        </Macro>
        <ExecMacro MacroName = "Cut" Repeat = "Round(2*Pi / sAngle)" />
    </Figure>
</xml>
