    <Script>
        MirrorColor := 'E0C07D';

        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;

        WX := W;
        WY := W;
        WZ := W / C15;
        DWX := -0.03;
        DWY := -0.03;
        DWZ := -0.1;

        D := W / 3;

    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

