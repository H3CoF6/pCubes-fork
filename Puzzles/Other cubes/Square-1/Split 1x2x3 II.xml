<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Split 1x2x3 II</Name>
        <Menu>Other cubes\Square-1\Split 1x2x3 II</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6911</Link>
    </Interface>
 
    <Script>
        H := 0.5;
        WX := H / 3;
        WY := H / 3 * sqrt(3);
        WZ := H;
        D := H / 3;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Undo Repeat = "2" />
    </Figure>
</xml>
