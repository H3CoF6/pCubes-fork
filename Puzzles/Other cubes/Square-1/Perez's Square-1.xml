<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Perez's Square-1</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Perez's Square-1</Menu>
        <Inventor>Rex Rossano Perez</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-02-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6067</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.5;
        H := W / C15;
    </Script>

    <Axes TurningAngles = "Pi / 12" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -H" />
                <Add Vector = "-W; -W;  H" />
                <Add Vector = "-W;  W; -H" />
                <Add Vector = "-W;  W;  H" />
                <Add Vector = " W; -W; -H" />
                <Add Vector = " W; -W;  H" />
                <Add Vector = " W;  W; -H" />
                <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "0" Layer = "1" Angle = "5*Pi / 12" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " -Pi /  2" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "  Pi     " />
        <Turn Axis = "0" Layer = "0" Angle = " -Pi /  2" />
        <Turn Axis = "0" Layer = "1" Angle = " -Pi /  3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " -Pi /  3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "2*Pi /  3" />
        <Turn Axis = "0" Layer = "0" Angle = "  Pi /  2" />
        <Turn Axis = "1" Layer = "0" Angle = "  Pi     " />
        <Turn Axis = "0" Layer = "1" Angle = "  Pi / 12" />
    </Figure>
</xml>
