<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Floppy Super Square-4</Name>
        <Menu>Other cubes\Square-1\Floppy Super Square-4</Menu>
        <Inventor>Alexander Sosnovsky</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6785</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 20); // 9 degrees
        C15 := cos (Pi / 20);

        W := 0.5;
        H := W / 3;
        RC := W / 3;
        Delta := 0.002;
    </Script>

    <Axes TurningAngles = "0; Pi/10; 0" PlaneDistances = "-H; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Cut Color = "clYellow" > <Plane NormVector = "0; 0; 1" NormDistance = "-H" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = "0; 0;-1" NormDistance = "-H" /> </Cut>

        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 10" />
        <Split Axis = "1" From = "1" />
        <Undo/>

        <Circle Color = "clWhite " Radius = "RC" Center = "0; 0;  H + Delta" />
        <Circle Color = "clYellow" Radius = "RC" Center = "0; 0; -H - Delta" />
        <Split Axis = "1" From = "1" />
    </Figure>
</xml>
