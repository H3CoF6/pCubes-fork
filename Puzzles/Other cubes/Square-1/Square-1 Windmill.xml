<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Windmill</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Windmill</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4517</Link>
    </Interface>

    <Script>
        W := 0.5;
        H := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 12" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -H" />
                <Add Vector = "-W; -W;  H" />
                <Add Vector = "-W;  W; -H" />
                <Add Vector = "-W;  W;  H" />
                <Add Vector = " W; -W; -H" />
                <Add Vector = " W; -W;  H" />
                <Add Vector = " W;  W; -H" />
                <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "-Pi / 12" />
        <Turn  Axis = "0" Layer = "2" Angle = " Pi / 12" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "-Pi / 6" />
        <Turn  Axis = "0" Layer = "2" Angle = " Pi / 6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "-Pi / 3" />
        <Turn  Axis = "0" Layer = "2" Angle = " Pi / 3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "-Pi / 6" />
        <Turn  Axis = "0" Layer = "2" Angle = " Pi / 6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = " 3 * Pi / 4" />
        <Turn  Axis = "0" Layer = "2" Angle = "-3 * Pi / 4" />
    </Figure>
</xml>
