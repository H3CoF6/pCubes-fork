<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Puckube</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Puckube</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1829</Link>
    </Interface>

    <Script>
        W := 0.5;

        sAngle := 2*Pi / 24;
        for i := 0 to 11 do begin
            xa[i] := sin(sAngle * i);
            ya[i] := cos(sAngle * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi/12" PlaneDistances = "-1/4; 1/4">
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "xa[ 0]; ya[ 0]; 0" />
        <Axis NormVector = "xa[ 1]; ya[ 1]; 0" />
        <Axis NormVector = "xa[ 2]; ya[ 2]; 0" />
        <Axis NormVector = "xa[ 3]; ya[ 3]; 0" />
        <Axis NormVector = "xa[ 4]; ya[ 4]; 0" />
        <Axis NormVector = "xa[ 5]; ya[ 5]; 0" />
        <Axis NormVector = "xa[ 6]; ya[ 6]; 0" />
        <Axis NormVector = "xa[ 7]; ya[ 7]; 0" />
        <Axis NormVector = "xa[ 8]; ya[ 8]; 0" />
        <Axis NormVector = "xa[ 9]; ya[ 9]; 0" />
        <Axis NormVector = "xa[10]; ya[10]; 0" />
        <Axis NormVector = "xa[11]; ya[11]; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />

        <Turn  Axis = "0" Layer = "1" Angle = "-Pi / 12" />
        <Split Axis = "7" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi / 6" />
        <Split Axis = "7" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi / 3" />
        <Split Axis = "7" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi / 6" />
        <Split Axis = "7" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "-Pi * 7 / 12" />

    </Figure>
</xml>
