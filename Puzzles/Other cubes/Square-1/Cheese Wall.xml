<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheese Wall</Name>
        <Menu>Other cubes\Square-1\Cheese Wall</Menu>
        <Inventor>Miller</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2026-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12919</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5;
        RC := W / 2;
        Delta := 0.002;
        for i := 0 to 11 do begin
          ax[i] := sin(Pi/12 * i);
          ay[i] := cos(Pi/12 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi/12" PlaneDistances = "-W;-D*3;-D; D; D*3; W" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" NormVectors = "ax;ay;0" />

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Color = "clWhite " Radius = "RC" Center = "0; 0;  W + Delta" />
        <Circle Color = "clYellow" Radius = "RC" Center = "0; 0; -W - Delta" />

        <Connect Axis = "0" Layers = "0;3;6" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />

        <Turn  Axis = "0" Layers = "1;2;4;5" Angle = "Pi / 2" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layers = "1;5" Angle = "Pi / 4" />
        <Turn  Axis = "0" Layers = "2;4" Angle = "Pi / 3" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layers = "1;5" Angle = "Pi / 4" />
        <Turn  Axis = "0" Layers = "2;4" Angle = "Pi / 3" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" Layers = "1;5" Angle = "Pi / 4" />
        <Split Axis = "1" From = "1" />
		<Undo Repeat = "6" />
    </Figure>

    <Macros>
        <Macro Name = "Setup" >
            <Turn Axis = "0" Layers = "2;4" Angle = "Pi / 2" />
        </Macro>

        <Macro Name = "NoBandage" >
            <Turn Axis = "0" Layer = "1" Angle = "Pi / 4 * Random(8)" />
            <Turn Axis = "0" Layer = "2" Angle = "Pi / 3 * Random(6)" />
            <Turn Axis = "0" Layer = "4" Angle = "Pi / 3 * Random(6)" />
            <Turn Axis = "0" Layer = "5" Angle = "Pi / 4 * Random(8)" />
            <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        </Macro>

        <Macro Name = "RandomTurns" >
            <Turn Axis = "0" Layer = "Random(6)" Angle = "2 * Pi * Random" />
            <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        </Macro>

        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Setup" />
            <ExecMacro MacroName = "NoBandage" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "500" />
        </Macro>
    </Macros>
</xml>
