<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Domino</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Domino</Menu>
        <Inventor>José Manuel Garcéa Mouzo</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2761</Link>
    </Interface>

    <Script>
        S15 := 0;
        C15 := 1;

        W := 0.5;
        W1 := 0.35;
        H := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W1; -W; -H" />
                <Add Vector = "-W1; -W;  H" />
                <Add Vector = "-W1;  W; -H" />
                <Add Vector = "-W1;  W;  H" />
                <Add Vector = " W1; -W; -H" />
                <Add Vector = " W1; -W;  H" />
                <Add Vector = " W1;  W; -H" />
                <Add Vector = " W1;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn  Axis = "0" Layer = "0" Angle = "2 * Pi / 6" />
        <Turn  Axis = "0" Layer = "2" Angle = "2 * Pi / 6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "Pi / 6" />
        <Turn  Axis = "0" Layer = "2" Angle = "Pi / 6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "Pi / 6" />
        <Turn  Axis = "0" Layer = "2" Angle = "Pi / 6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "-4 * Pi / 6" />
        <Turn  Axis = "0" Layer = "2" Angle = "-4 * Pi / 6" />
    </Figure>
</xml>
