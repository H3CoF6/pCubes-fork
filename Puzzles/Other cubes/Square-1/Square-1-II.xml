<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1-II</Name>
        <Menu>Other cubes\Square-1\Square-1-II</Menu>
        <Inventor>Anthony Greenhill</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-09-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=915</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.5;
        H := W * 0.7;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " C15; S15; 0" />
        <Axis NormVector = " C15;-S15; 0" />
        <Axis NormVector = " S15; C15; 0" />
        <Axis NormVector = " S15;-C15; 0" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1"  />
        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
    </Figure>
</xml>
