<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Super (2 layers)</Name>
        <Menu>Other cubes\Square-1\Super (2 layers)</Menu>
        <Inventor>LI CHUNG Man</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1779</Link>
    </Interface>

    <Script>
        W := 0.5;
        H := W / 2;
        RC := W / 2;
        HC := H * 1.008;
    </Script>

    <Axes TurningAngles = "0; Pi/6; Pi/6; 0" PlaneDistances = "-H; 0; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi/12" />

        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />

        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "2" Angle = "Pi / 6" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "2" Angle = "Pi / 3" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "2" Angle = "Pi / 6" />
        <Split Axis = "1" From = "1" />
        <Undo Repeat = "3" />

        <Split Axis = "0" From = "2" />

        <Circle Color = "clWhite " Radius = "RC" Center = " 0; 0; HC" />
        <Circle Color = "clYellow" Radius = "RC" Center = " 0; 0;-HC" />
        <Split Axis = "1" From = "1" />
    </Figure>
</xml>
