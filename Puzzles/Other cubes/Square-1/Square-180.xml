<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-180</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Square-180</Menu>
        <Inventor>Spencer Brodhead</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-10-03</Added>
        <Link>https://www.youtube.com/watch?v=4Ow8corD1l8</Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi/2" />
        <SplitByAxes/>
        <Undo/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <SplitByAxes/>
        <Undo Repeat = "4" />
    </Figure>
</xml>
