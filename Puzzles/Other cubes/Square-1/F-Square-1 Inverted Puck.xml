<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>ϕ-Square-1 Inverted Puck</Name>
        <Menu>Other cubes\Square-1\ϕ-Square-1 Inverted Puck</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-12-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11546</Link>
    </Interface>

    <Script>
        Col[0] := 'FFFF00'; // Yellow
        Col[1] := '0011EE'; // Blue
        Col[2] := 'EE0000'; // Red
        Col[3] := 'CCCCCC'; // White
        Col[4] := 'FFFF99'; // Yellow
        Col[5] := '7780EE'; // Blue
        Col[6] := 'F55555'; // Red
        Col[7] := 'FFFFFF'; // White

        BodyColor := '333333';

        W := 0.5;
        H := W * 0.5;
        H1 := H * 1.2;
        RC := W * 0.8;
    </Script>

    <Axes TurningAngles = "Pi/6" PlaneDistances = "-H; H" TurnAxesWithLayer = "1" FixedLayers = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddQuarter" >
            <HideAll/>
            <Turn NormVector = "0;0;1" Angle = "-Pi / 12" />
            <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "BodyColor" />
            <Turn NormVector = "0;0;1" Angle = " Pi / 12" />

            <Cut Color = "Col[c2]" > <Plane NormVector = " 0; 0; 1" NormDistance = "-H" /> </Cut>
            <Cut Color = "Col[c1]" > <Plane NormVector = " 0; 0;-1" NormDistance = "-H" /> </Cut>

            <Cut InvisibleEdges = "ie1" > <Plane NormVector = " 1; 0; 0" /> </Cut>
            <Cut InvisibleEdges = "ie2" > <Plane NormVector = " 0; 1; 0" /> </Cut>

            <Cylinder Radius = "RC" Color = "Col[c1]" Base = "0; 0; H" Top = "0; 0; H1" > <Top Color = "Col[c1]" /> </Cylinder>
            <Cylinder Radius = "RC" Color = "Col[c2]" Base = "0; 0;-H" Top = "0; 0;-H1" > <Top Color = "Col[c2]" /> </Cylinder>

            <Cut> <Plane NormVector = " 1; 0; 0" /> </Cut>
            <Cut> <Plane NormVector = " 0; 1; 0" /> </Cut>

            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "AddQuarter" c1 = "2" c2 = "6" ie1 = " 0" ie2 = "11" />
        <ExecMacro MacroName = "AddQuarter" c1 = "0" c2 = "4" ie1 = "14" ie2 = " 0" />
        <ExecMacro MacroName = "AddQuarter" c1 = "3" c2 = "7" ie1 = " 0" ie2 = "11" />
        <ExecMacro MacroName = "AddQuarter" c1 = "1" c2 = "5" ie1 = "14" ie2 = " 0" />
        <ShowAll/>

        <Turn Axis = "0" Layers = "0;2" Angle = " Pi / 6" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "0" Layers = "0;2" Angle = " Pi / 2" />
        <Split Axis = "1" From = "1" />
        <Undo Repeat = "2" />

        <Turn NormVector = "0;0;1" Angle = "-Pi / 12" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
