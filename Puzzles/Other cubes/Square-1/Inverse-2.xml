<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Inverse-2</Name>
        <Menu>Other cubes\Square-1\Inverse-2</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-01-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7172</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi/6" PlaneDistances = "-W/3; W/3" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <SplitByAxes/>
        <Undo Repeat = "5" />
    </Figure>
</xml>
