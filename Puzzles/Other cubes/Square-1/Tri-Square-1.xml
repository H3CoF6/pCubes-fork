        <Undo Repeat = "2" />
        <Hide Axis = "1" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "4 * Pi / 6" />
        <SplitByAxes/>
        <InvertVisibility/>
        <Turn Axis = "0" Layer = "1" Angle = "4 * Pi / 6" />
        <SplitByAxes/>
        <Undo Repeat = "3" />
        <ShowAll/>
