<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Super Alternate</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Square-1 Super Alternate</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-08-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6870</Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi/6" PlaneDistances = "-W/2; 0; W/2" TurnAxesWithLayer = "2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "cos(Pi/12); sin(Pi/12); 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <HideContaining Vector = " W;  0; W / 10" />

        <Split><Plane NormVector = "sin(Pi/12 *  1); cos(Pi/12 *  1); 0" /></Split>
        <Split><Plane NormVector = "sin(Pi/12 *  7); cos(Pi/12 *  7); 0" /></Split>
        <Split><Plane NormVector = "sin(Pi/12 * 11); cos(Pi/12 * 11); 0" /></Split>
        <ShowAll/>
    </Figure>
</xml>
