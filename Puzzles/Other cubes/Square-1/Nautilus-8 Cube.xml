<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Nautilus-8 Cube</Name>
        <Menu>Other cubes\Square-1\Nautilus-8 Cube</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>not invented</Inventor>
        <Added>2016-12-14</Added>
    </Interface>

    <Script>
        N := 2 * Pi / 36; // 10 degrees

        for i := 0 to 17 do begin
            ax[i] := sin(N * i);
            ay[i] := cos(N * i);
        end;

        W := 0.5;
        H := 0.5;
    </Script>

    <Axes TurningAngles = "2 * Pi / 36" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "ax[ 0]; ay[ 0]; 0" />
        <Axis NormVector = "ax[ 1]; ay[ 1]; 0" />
        <Axis NormVector = "ax[ 2]; ay[ 2]; 0" />
        <Axis NormVector = "ax[ 3]; ay[ 3]; 0" />
        <Axis NormVector = "ax[ 4]; ay[ 4]; 0" />
        <Axis NormVector = "ax[ 5]; ay[ 5]; 0" />
        <Axis NormVector = "ax[ 6]; ay[ 6]; 0" />
        <Axis NormVector = "ax[ 7]; ay[ 7]; 0" />
        <Axis NormVector = "ax[ 8]; ay[ 8]; 0" />
        <Axis NormVector = "ax[ 9]; ay[ 9]; 0" />
        <Axis NormVector = "ax[10]; ay[10]; 0" />
        <Axis NormVector = "ax[11]; ay[11]; 0" />
        <Axis NormVector = "ax[12]; ay[12]; 0" />
        <Axis NormVector = "ax[13]; ay[13]; 0" />
        <Axis NormVector = "ax[14]; ay[14]; 0" />
        <Axis NormVector = "ax[15]; ay[15]; 0" />
        <Axis NormVector = "ax[16]; ay[16]; 0" />
        <Axis NormVector = "ax[17]; ay[17]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -H" />
                <Add Vector = "-W; -W;  H" />
                <Add Vector = "-W;  W; -H" />
                <Add Vector = "-W;  W;  H" />
                <Add Vector = " W; -W; -H" />
                <Add Vector = " W; -W;  H" />
                <Add Vector = " W;  W; -H" />
                <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split Axis = " 0" From = "1" />
        <Split Axis = " 1" From = "1" />
        <Split Axis = "10" From = "1" />
        <Hide  Axis = " 1" Layer = "0" />

        <Split Axis = " 2" From = "1" />
        <Split Axis = "12" From = "1" />

        <ShowAll/>

        <Hide  Axis = " 1" Layer = "1" />
        <Split Axis = " 3" From = "1" />
        <Split Axis = "14" From = "1" />

        <ShowAll/>

    </Figure>
</xml>
