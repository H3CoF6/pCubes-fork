<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Cube 321</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Cube 321</Menu>
        <Inventor>Scott Elliott</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2082</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.5;
        H := W / C15;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -H" />
                <Add Vector = "-W; -W;  H" />
                <Add Vector = "-W;  W; -H" />
                <Add Vector = "-W;  W;  H" />
                <Add Vector = " W; -W; -H" />
                <Add Vector = " W; -W;  H" />
                <Add Vector = " W;  W; -H" />
                <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Hide  Axis = "0" From  = "0" To = "1" />
        <Turn  Axis = "0" Layer = "2" Angle = "Pi / 2" />
        <Split Axis = "1" From  = "1" />
        <Hide  Axis = "1" Layer = "0" />
        <Split> <Plane NormVector = "C15; -S15; 0" /> </Split>
        <Split> <Plane NormVector = "S15;  C15; 0" /> </Split>
        <Turn  Axis = "0" Angle = "-Pi / 2" Layer = "2" />
        <ShowAll/>

        <Turn  Axis = "0" Layer = "0" Angle = "-Pi / 2" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "2 * Pi / 3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "0" Angle = "-Pi / 6" />
    </Figure>
</xml>
