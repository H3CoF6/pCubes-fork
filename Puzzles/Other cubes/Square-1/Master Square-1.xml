<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Square-1</Name>
        <Menu>Other cubes\Square-1\Master Square-1</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3913</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 8); // 22.5 degrees
        C15 := cos (Pi / 8);

        W := 0.5;
        D := W / 2;

        WX := W;
        WY := W;
        WZ := W / C15;
    </Script>

    <Axes TurningAngles = "Pi / 8" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "3*Pi/8" />
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "0" Angle = "-Pi / 8" />
        <Turn Axis = "0" Layer = "3" Angle = "-Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = "-Pi / 8" />
        <Turn Axis = "0" Layer = "3" Angle = "-Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = "Pi / 4" />
        <Turn Axis = "0" Layer = "3" Angle = "Pi / 4" />
    </Figure>
</xml>
