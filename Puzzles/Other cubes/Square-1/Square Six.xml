<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square Six</Name>
        <Menu>Other cubes\Square-1\Square Six</Menu>
        <Inventor>Manuel García Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-01-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9656</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = " Pi * 5 / 12" />
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi / 6" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = " 2 * Pi / 3" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = " 2 * Pi / 3" />
        <Split Axis = "1" From = "1" />
        <Undo Repeat = "3" />
    </Figure>
</xml>
