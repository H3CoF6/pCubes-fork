<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1.25</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Square-1.25</Menu>
        <Inventor>Jack.S.N.Triton</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7066</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.5;
        H := W / C15;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 6" />
        <SplitByAxes/>
        <HideContaining Vector = " W; -W;  W" />
        <HideContaining Vector = "-W;  W; -W" />
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 6" />
        <SplitByAxes/>
        <ShowAll/>
        <Undo Repeat = "4" />
    </Figure>
</xml>
