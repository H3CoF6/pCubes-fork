<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheese Block</Name>
        <Menu>Other cubes\Square-1\Cheese Block</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-02-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3749</Link>
    </Interface>

    <Script>
        H := 0.5;
        W := H;
        D := H * 1.2;

        for i := 0 to 6 do begin
            ax[i] := cos(2 * Pi / 7 * i);
            ay[i] := sin(2 * Pi / 7 * i);
        end;

        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
    </Script>

    <Axes TurningAngles = "Pi/7" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0">
        <Axis NormVector = " ax[0]; ay[0]; 0" />
        <Axis NormVector = " ax[1]; ay[1]; 0" />
        <Axis NormVector = " ax[2]; ay[2]; 0" />
        <Axis NormVector = " ax[3]; ay[3]; 0" />
        <Axis NormVector = " ax[4]; ay[4]; 0" />
        <Axis NormVector = " ax[5]; ay[5]; 0" />
        <Axis NormVector = " ax[6]; ay[6]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -D; -H" />
                <Add Vector = "-W; -D;  H" />
                <Add Vector = "-W;  D; -H" />
                <Add Vector = "-W;  D;  H" />
                <Add Vector = " W; -D; -H" />
                <Add Vector = " W; -D;  H" />
                <Add Vector = " W;  D; -H" />
                <Add Vector = " W;  D;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
