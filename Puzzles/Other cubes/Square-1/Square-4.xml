<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-4</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Square-4</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6338</Link>
        <Added>2017-08-08</Added>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 10" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "cos(Pi/20); sin(Pi/20); 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <Macro Name = "Split">
            <Turn Axis = "0" Layer = "1" Angle = "Pi / 10" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "20"/>
    </Figure>
</xml>
