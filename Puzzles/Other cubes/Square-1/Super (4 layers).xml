<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Super (4 layers)</Name>
        <Menu>Other cubes\Square-1\Super (4 layers)</Menu>
        <Inventor>James Lee</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1468</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.5;
        H := W;
        D := H / 2;
        RC := W / 2;
        Delta := 0.002;
    </Script>

    <Axes TurningAngles = "0; Pi/6; Pi/6; Pi/6; Pi/6; 0" PlaneDistances = "-H; -D; 0; D; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Cut Color = "clYellow" > <Plane NormVector = "0; 0; 1" NormDistance = "-H" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = "0; 0;-1" NormDistance = "-H" /> </Cut>

        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "4" Angle = "Pi / 6" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "4" Angle = "Pi / 3" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "4" Angle = "Pi / 6" />
        <Split Axis = "1" From = "1" />
        <Turn  Axis = "0" From = "1" To = "4" Angle = "-2 * Pi / 3" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />

        <Circle Color = "clWhite " Radius = "RC" Center = "0; 0;  H + Delta" />
        <Circle Color = "clYellow" Radius = "RC" Center = "0; 0; -H - Delta" />
        <Split Axis = "1" From = "1" />
    </Figure>
</xml>
