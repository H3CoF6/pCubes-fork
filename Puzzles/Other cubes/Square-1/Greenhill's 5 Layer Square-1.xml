<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Greenhill's 5 Layer Square-1</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Greenhill's 5 Layer Square-1</Menu>
        <Inventor>Anthony Greenhill</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-12-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=908</Link>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := 0.44;
        H := W * 1.2;
        D1 := W * 0.25;
        D2 := W * 0.55;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D2; -D1; D1; D2" TurnAxesWithLayer = "2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -H" />
                <Add Vector = "-W; -W;  H" />
                <Add Vector = "-W;  W; -H" />
                <Add Vector = "-W;  W;  H" />
                <Add Vector = " W; -W; -H" />
                <Add Vector = " W; -W;  H" />
                <Add Vector = " W;  W; -H" />
                <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "2" Angle = "-Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "2" Angle = "-Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "2" Angle = "-Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "2" Angle = " Pi * 2 / 3" />
    </Figure>
</xml>
