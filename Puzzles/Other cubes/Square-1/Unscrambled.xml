<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unscrambled</Name>
        <Menu>Other cubes\Square-1\Unscrambled</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2482</Link>
    </Interface>

    <Script>
        W := 0.5;
        H := W / 3;
        D := W * 0.16;
        RC := W * 0.6;
        sAngle := 2 * Pi / 11;

        HC := H * 1.01;


        a0 := -Pi/4 + 3 / 2 * sAngle;
        ss := sin(a0);
        cs := cos(a0);

        WX := W;
        WY := W;
        WZ := H;
    </Script>

    <Axes TurningAngles = "0; sAngle; 0" PlaneDistances = "-H; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D">
        <Axis NormVector = " cs; ss; 0" />
    </Axes>
 
    <Figure>
        <Macro Name = "Cut">
            <Script>
                if i &lt; 0 then begin
                    N := -D;
                    i := -i;
                end else
                    N := D;
                a1 := a0 - i * sAngle/2;
            </Script>

            <Cut><Plane NormVector = "-cos(a1); -sin(a1); 0" NormDistance = "N" /></Cut>
        </Macro>

        <Macro Name = "Part">
            <LoadFrom File = "Figures\Cuboid.xml" />
            <ExecMacro MacroName = "Cut" i = "i1" />
            <ExecMacro MacroName = "Cut" i = "i2" />
            <ExecMacro MacroName = "Cut" i = "i3" />
            <ExecMacro MacroName = "Cut" i = "i4" />
            <HideAll/>
        </Macro>

        <ExecMacro MacroName = "Part" i1 = "  6" i2 = " 20" i3 = " 20" i4 = " 20" />
        <ExecMacro MacroName = "Part" i1 = " -9" i2 = "  0" i3 = "  7" i4 = "  7" />
        <ExecMacro MacroName = "Part" i1 = "-11" i2 = "  2" i3 = "  9" i4 = "  9" />
        <ExecMacro MacroName = "Part" i1 = "-13" i2 = " -3" i3 = " 11" i4 = "  5" />
        <ExecMacro MacroName = "Part" i1 = " 14" i2 = "  6" i3 = "  6" i4 = "  6" />
        <ExecMacro MacroName = "Part" i1 = "-17" i2 = "  8" i3 = " 15" i4 = " 15" />
        <ExecMacro MacroName = "Part" i1 = "-19" i2 = " 10" i3 = " 17" i4 = " 17" />
        <ExecMacro MacroName = "Part" i1 = "-21" i2 = " 12" i3 = " 19" i4 = " 19" />
        <ExecMacro MacroName = "Part" i1 = " -1" i2 = "-13" i3 = " 21" i4 = " 15" />
        <ExecMacro MacroName = "Part" i1 = "  2" i2 = "-15" i3 = " 17" i4 = " 17" />
        <ExecMacro MacroName = "Part" i1 = "  4" i2 = "-17" i3 = " 19" i4 = " 19" />

        <Circle Radius = "RC" Color = "ClWhite"  Center = "0; 0;  HC" />
        <Circle Radius = "RC" Color = "ClYellow" Center = "0; 0; -HC" />
        <Split Axis = "1" From = "1" />
        <ShowAll/>
    </Figure>
</xml>
