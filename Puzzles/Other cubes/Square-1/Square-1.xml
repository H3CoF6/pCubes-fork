<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Square-1</Menu>
        <Inventor>Dr. Vojtech Kopsky, Dr. Harel Hrsel</Inventor>
        <Programmer>Andrea</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1195</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 12" />
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Undo Repeat = "3" />
    </Figure>
</xml>
