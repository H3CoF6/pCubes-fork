<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-Equal</Name>
        <Class>TSquare1</Class>
        <Menu>Other cubes\Square-1\Square-Equal</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6364</Link>
    </Interface>

    <Script>
        S8 := sin (Pi / 8);
        C8 := cos (Pi / 8);

        W := 0.5;

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C8; S8; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "0" Angle = "Pi / 4" />
        <Turn Axis = "0" Layer = "2" Angle = "Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = "Pi / 4" />
        <Turn Axis = "0" Layer = "2" Angle = "Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = "Pi / 4" />
        <Turn Axis = "0" Layer = "2" Angle = "Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = "-Pi * 3 / 4" />
        <Turn Axis = "0" Layer = "2" Angle = "-Pi * 3 / 4" />
    </Figure>
</xml>
