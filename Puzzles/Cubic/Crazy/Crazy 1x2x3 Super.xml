<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 1x2x3 Super</Name>
        <Menu>Cubic\Crazy\Crazy 1x2x3 Super</Menu>
        <Inventor>Jason Gavril</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7647</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        WX := W / 3;
        WY := W * 2 / 3;
        WZ := W;
        D := W / 3;

        R := D * 0.5;
        Delta := 0.002;
        WC := WX + Delta;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Circle Radius = "R" Color = "clOrange" Center =  " WC; 0; 0" />
        <Circle Radius = "R" Color = "clRed   " Center =  "-WC; 0; 0" />
        <SplitByAxes/>
    </Figure>
</xml>
