<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 3x3x5 II Cuboid Cube</Name>
        <Menu>Cubic\Crazy\Witeden Super\Super 3x3x5 II Cuboid Cube</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7861</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 5;

        WX := D * 3;
        WY := WX;
        WZ := D * 5;
        DWZ :=-D;

        RC := W * 0.5;
        WC := 4*D * 1.004;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Circle Radius = "RC" Color = "clWhite " Center = " 0; 0; WC" />
        <SplitByAxes/>
        <Connect Axis = "2" Layers = "3;5" />
    </Figure>
</xml>
