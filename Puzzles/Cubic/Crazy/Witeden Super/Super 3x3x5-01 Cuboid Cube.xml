<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 3x3x5-01 Cuboid Cube</Name>
        <Menu>Cubic\Crazy\Witeden Super\Super 3x3x5-01 Cuboid Cube</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7863</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 5;

        WX := D * 3;
        WY := WX;
        WZ := W;
        DWZ := D;

        RC := W * 0.5;
        WC := WZ * 1.004;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*6;-D*4;-D*2; 0; D*2; D*4; D*6" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Circle Radius = "RC" Color = "clWhite " Center = " 0; 0; WC + D" />
        <Circle Radius = "RC" Color = "clYellow" Center = " 0; 0;-WC + D" />
        <SplitByAxes/>
        <Connect Axis = "2" Layers = "1;2" />
        <Connect Axis = "2" Layers = "5;7" />

        <HideAll/>
        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WZ = "D * 2" DWZ = "-D*6" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <InvertVisibility/>
    </Figure>
</xml>
