<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 3x3x6-00 Cuboid Cube</Name>
        <Menu>Cubic\Crazy\Witeden Super\Super 3x3x6-00 Cuboid Cube</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7864</Link>
    </Interface>
 
    <Script>
        W := 0.55;
        D := W / 6;

        WX := D * 3;
        WY := WX;
        WZ := W;

        RC := W * 0.4;
        WC := WZ * 1.004;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*6;-D*4;-D*2; 0; D*2; D*4; D*6" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Circle Radius = "RC" Color = "clWhite " Center = " 0; 0; WC" />
        <Circle Radius = "RC" Color = "clYellow" Center = " 0; 0;-WC" />
        <SplitByAxes/>
        <Connect Axis = "2" Layers = "0;2" />
        <Connect Axis = "2" Layers = "5;7" />
    </Figure>
</xml>
