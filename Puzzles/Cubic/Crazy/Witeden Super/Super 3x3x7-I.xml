<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 3x3x7-I</Name>
        <Menu>Cubic\Crazy\Witeden Super\Super 3x3x7-I</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2749</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 9;

        WX := W;
        WY := W;
        WZ := D * 7;

        RC := W * 0.8;
        WC := WZ * 1.004;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*7;-D*5;-D*3;-D*1; D*1; D*3; D*5; D*7" TurnAxesWithLayer = "4" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Circle Radius = "RC" Color = "clWhite " Center = " 0; 0; WC" />
        <Circle Radius = "RC" Color = "clYellow" Center = " 0; 0;-WC" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "7" />
        <RemoveGrayParts/>
        <Connect Axis = "2" Layers = "0;2" />
        <Connect Axis = "2" Layers = "6;8" />
    </Figure>
</xml>
