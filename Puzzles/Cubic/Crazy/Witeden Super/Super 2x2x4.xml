<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 2x2x4</Name>
        <Menu>Cubic\Crazy\Witeden Super\Super 2x2x4</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6236</Link>
    </Interface>
 
    <Script>
        W := 0.60;
        Delta := 0.001;
        WX := W / 2 + Delta;
        WY := W / 2 + Delta;
        WZ := W;
        D := W / 2;

        R := W * 0.3;

        ZC := WZ + Delta;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; -D; 0; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Circle Radius = "R" Color = "clWhite " Center = "0; 0; ZC" />
        <Circle Radius = "R" Color = "clYellow" Center = "0; 0;-ZC" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <Connect Layers = "0;2" />
        <Connect Layers = "3;5" />
    </Figure>
</xml>
