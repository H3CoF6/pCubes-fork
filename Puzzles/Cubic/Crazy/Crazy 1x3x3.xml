<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 1x3x3</Name>
        <Menu>Cubic\Crazy\Crazy 1x3x3</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-06-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7486</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W * 0.5;
        D := W / 3;

        R := WZ * 0.85;
        Delta := 0.002;
        WC := W + Delta;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-W; -D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;  0; 0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;  0; 0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0; WC; 0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0;-WC; 0" />

        <SplitByAxes/>

        <Connect Layers = "0;1" />
        <Connect Layers = "2;4" />
    </Figure>
</xml>
