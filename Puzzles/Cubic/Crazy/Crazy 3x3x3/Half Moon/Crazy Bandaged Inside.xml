<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Bandaged Inside</Name>
        <Menu>Cubic\Crazy\Crazy 3x3x3\Half Moon\Crazy Bandaged Inside</Menu>
        <Inventor>David López Tobajas</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11601</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        R := W * 0.8;
        WC := W * 1.004;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W;-D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;  0;  0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;  0;  0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0;-WC;  0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0; WC;  0" />
        <Circle Radius = "R" Color = "clYellow" Center = "  0;  0;-WC" />
        <Circle Radius = "R" Color = "clWhite " Center = "  0;  0; WC" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = " WC; -R; 0" />
        <HideContaining Vector = "  R;-WC; 0" />
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>

        <Connect Axis = "0" Layers = "0;1" />
        <Connect Axis = "0" Layers = "3;4" />
        <Connect Axis = "1" Layers = "0;1" />
        <Connect Axis = "1" Layers = "3;4" />
        <Connect Axis = "2" Layers = "0;2" />
        <Connect Axis = "2" Layers = "3;4" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Cross = 62,0,0
    </SetTextures>
</xml>
