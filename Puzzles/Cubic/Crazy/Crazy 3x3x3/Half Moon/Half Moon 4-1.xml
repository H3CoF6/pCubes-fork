<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 3x3x3 Half Moon 4-1</Name>
        <Menu>Cubic\Crazy\Crazy 3x3x3\Half Moon\Half Moon 4-1</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-10</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        R := W * 0.8;
        Delta := 1.001;
        WC := W * Delta;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; -D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Script> W := W * Delta; </Script>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <Hide Axis = "1" To = "3" />
        <Cut Color = "Colors[1]" Axis = "0" To = "4" />
        <ShowAll/>

        <Hide Axis = "0" To = "3" />
        <Cut Color = "Colors[2]" Axis = "1" From = "1" />
        <ShowAll/>

        <Hide Axis = "1" From = "2" />
        <Cut Color = "Colors[0]" Axis = "0" From = "1" />
        <ShowAll/>

        <Hide Axis = "0" From = "2" />
        <Cut Color = "Colors[3]" Axis = "1" To = "4" />

        <HideAll/>
        <Circle Radius = "R" Color = "clOrange" Center = " WC;  0;  0" />
        <Cut  Axis = "1" From = "3" />
        <SplitByAxes/>

        <HideAll/>
        <Circle Radius = "R" Color =   "clBlue" Center = "  0;-WC;  0" />
        <Cut  Axis = "0" From = "3" />
        <SplitByAxes/>

        <HideAll/>
        <Circle Radius = "R" Color = "clRed" Center = "-WC;  0;  0" />
        <Cut  Axis = "1" To = "2" />
        <SplitByAxes/>

        <HideAll/>
        <Circle Radius = "R" Color =   "clGreen" Center = "  0; WC;  0" />
        <Cut  Axis = "0" To = "2" />
        <SplitByAxes/>

        <ShowAll/>
        <RemoveGrayParts/>

        <HideContaining Vector = "0;0;W" />
        <InvertVisibility/>
        <Cut Axis = "2" From = "4" />
        <ShowAll/>

        <Connect Axis = "2" Layers = "2;4" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Cross = 13,0,0
    </SetTextures>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc" >
            <Turn Axis = "2" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)" />

            <Turn Axis = "0" From = "1" To = "1" Angle = " Pi  " />
            <Turn Axis = "2" From = "1" To = "1" Angle = " Pi/2" />
            <Turn Axis = "1" From = "3" To = "3" Angle = " Pi  " />
            <Turn Axis = "2" From = "1" To = "1" Angle = " Pi  " />
            <Turn Axis = "1" From = "3" To = "3" Angle = " Pi  " />
            <Turn Axis = "2" From = "1" To = "1" Angle = "-Pi/2" />
            <Turn Axis = "0" From = "1" To = "1" Angle = " Pi  " />
        </Macro>

        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "0" Layer = "3" Angle = "-Pi  " />
            <Turn Axis = "0" Layer = "1" Angle = " Pi/2" />
            <Turn Axis = "2" Layer = "1" Angle = " Pi  " />
            <Turn Axis = "0" Layer = "3" Angle = "-Pi  " />
            <Turn Axis = "1" Layer = "3" Angle = "-Pi/2" />
            <Turn Axis = "0" Layer = "3" Angle = "-Pi/2" />
            <Turn Axis = "1" Layer = "3" Angle = " Pi/2" />
            <Turn Axis = "2" Layer = "1" Angle = " Pi  " />
            <Turn Axis = "0" Layer = "3" Angle = " Pi/2" />
            <Turn Axis = "1" Layer = "3" Angle = "-Pi/2" />
            <Turn Axis = "0" Layer = "3" Angle = "-Pi/2" />
            <Turn Axis = "1" Layer = "3" Angle = "-Pi/2" />
            <Turn Axis = "1" Layer = "1" Angle = " Pi  " />
            <ExecMacro MacroName = "Sc" Repeat = "11" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(3) + 1" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
    </Macros>
</xml>
