<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cubazoo</Name>
        <Menu>Cubic\Crazy\Crazy 3x3x3\Cubazoo</Menu>
        <Inventor>David López Tobajas</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9556</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        R := W * 0.8;
        WC := W * 1.004;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "D; W" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;  0;  0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;  0;  0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0;-WC;  0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0; WC;  0" />
        <Circle Radius = "R" Color = "clYellow" Center = "  0;  0;-WC" />
        <Circle Radius = "R" Color = "clWhite " Center = "  0;  0; WC" />

        <SplitByAxes/>

        <Hide Axis = "0" From = "1" />
        <Hide Axis = "1" From = "1" />
        <Hide Axis = "2" From = "1" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Split><Plane NormVector = "1;0;0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;0;1" NormDistance = "-D" /></Split>

        <HideAll/>
        <LoadFrom File = "Figures\Cube.xml" W = "WC" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut Axis = "2" To = "1" />
        <ShowAll/>

        <Connect Layers = "0;2" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Cross = 27,0,0, 41,0,0, 55,0,0
    </SetTextures>
</xml>
