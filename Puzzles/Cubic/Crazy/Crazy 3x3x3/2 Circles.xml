<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 3x3x3 - 2 Circles</Name>
        <Aliases>WitEden Super 3x3x3</Aliases>
        <Menu>Cubic\Crazy\Crazy 3x3x3\2 Circles</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2747</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        Delta := 1.001;
        R := W * 0.8;
        WC := W * Delta;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; -D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Script> W := W * Delta; </Script>
        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Color = "Colors[4]" Axis = "2" From = "1" />
        <Cut Color = "Colors[5]" Axis = "2" To = "4" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <HideAll/>

        <Circle Radius = "R" Color = "Colors[4]" Center = "0; 0;-WC" />
        <Circle Radius = "R" Color = "Colors[5]" Center = "0; 0; WC" />
        <SplitByAxes/>
        <ShowAll/>

        <RemoveGrayParts/>

        <Connect Axis = "2" Layers = "0;2;4" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Cross = 30,0,0, 39,0,0
    </SetTextures>
</xml>
