<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 3x3x3 Ultra - C6</Name>
        <Class>TCrazy3</Class>
        <Menu>Cubic\Crazy\Crazy 3x3x3\Crazy Ultra\C6</Menu>
        <Inventor>madartilect</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-10</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        R := W * 0.8;
        WC := W * 1.004;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; -D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;   0;   0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;   0;   0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0; -WC;   0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0;  WC;   0" />
        <Circle Radius = "R" Color = "clYellow" Center = "  0;   0; -WC" />
        <Circle Radius = "R" Color = "clWhite " Center = "  0;   0;  WC" />

        <SplitByAxes/>

        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossEdge.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Cross = 5,1,0, 16,0,1
    </SetTextures>
</xml>
