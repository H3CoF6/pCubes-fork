<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 3x3x3 Plus - Mercury</Name>
        <Menu>Cubic\Crazy\Crazy 3x3x3\Crazy Plus\Mercury</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2712</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        R := W * 0.8;
        WC := W * 1.004;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; -D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC;   0;   0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC;   0;   0" />
        <Circle Radius = "R" Color = "clBlue  " Center = "  0; -WC;   0" />
        <Circle Radius = "R" Color = "clGreen " Center = "  0;  WC;   0" />
        <Circle Radius = "R" Color = "clYellow" Center = "  0;   0; -WC" />
        <Circle Radius = "R" Color = "clWhite " Center = "  0;   0;  WC" />

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Connect Axis = "0" Layers = "0;2;4" />
        <Connect Axis = "1" Layers = "0;2;4" />
        <Connect Axis = "2" Layers = "0;1" />
        <Connect Axis = "2" Layers = "2;4" />
    </Figure>

    <Textures>
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Cross = 30,0,0, 39,0,0, 48,0,0, 57,0,0, 75,0,0
    </SetTextures>
</xml>
