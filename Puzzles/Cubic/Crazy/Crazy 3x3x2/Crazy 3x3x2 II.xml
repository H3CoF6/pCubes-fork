<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 3x3x2 II</Name>
        <Menu>Cubic\Crazy\Crazy 3x3x2\Crazy 3x3x2 II</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6862</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W * 2 / 3;
        D := W / 3;
        R := W * 0.5;

        Delta := 0.002;
        WC := W + Delta;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-W; -D; D; W" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Circle Radius = "R" Color = "clRed   " Center = "-WC; 0; 0" />
        <Circle Radius = "R" Color = "clOrange" Center = " WC; 0; 0" />
        <Circle Radius = "R" Color = "clGreen " Center = " 0; WC; 0" />
        <Circle Radius = "R" Color = "clBlue  " Center = " 0;-WC; 0" />

        <SplitByAxes/>

        <Connect Axis = "0" Layers  = "0;2;4" />
        <Connect Axis = "1" Layers  = "0;2;4" />
    </Figure>
</xml>
