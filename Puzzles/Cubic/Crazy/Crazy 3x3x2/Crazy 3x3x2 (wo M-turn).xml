<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 3x3x2 (w/o M-turn)</Name>
        <Menu>Cubic\Crazy\Crazy 3x3x2\Crazy 3x3x2 (w/o M-turn)</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-04-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2665</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W * 2 / 3;
        D := W / 3;

        R := W * 0.8;
        WC := WZ * 1.004;
        DCut := W * 1.5; // mark "lock" cube
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-WZ; 0; WZ" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Cut><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /></Cut> <!-- mark "lock" cube -->

        <!-- cutting to assign "0" to block cube -->
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "-D" /></Split>

        <Circle Radius = "R" Color = "clWhite " Center =  "0; 0; WC" />
        <Circle Radius = "R" Color = "clYellow" Center =  "0; 0;-WC" />

        <SplitByAxes/>

        <Connect Axis = "2" Layers = "0;1;3" />
    </Figure>
</xml>
