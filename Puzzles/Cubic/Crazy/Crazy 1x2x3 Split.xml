<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 1x2x3 Split</Name>
        <Menu>Cubic\Crazy\Crazy 1x2x3 Split</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7037</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W / 3 * 2;
        WY := W;
        WZ := W / 3;

        R := WX * 0.8;
        Delta := 0.002;
        WC := WZ + Delta;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-WZ; WZ" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi / 2; 0" PlaneDistances = "-WZ; WZ" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
        <Split Axis = "0" From = "1" />
        <Undo/>

        <SplitByAxes/>

        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Split Axis = "0" From = "1" />
        <Undo/>

        <Circle Radius = "R" Color = "clWhite " Center =  "0; 0;  WC" />
        <Circle Radius = "R" Color = "clYellow" Center =  "0; 0; -WC" />

        <SplitByAxes/>
    </Figure>
</xml>
