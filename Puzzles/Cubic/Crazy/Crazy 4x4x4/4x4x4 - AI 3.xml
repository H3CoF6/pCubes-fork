<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 4x4x4 AI 3</Name>
        <Menu>Cubic\Crazy\Crazy 4x4x4\Crazy 4x4x4 AI 3</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-06-14</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
        R := W * 0.88;
        DC := 1.002;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W;-D; 0; D; W" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />

        <Macro Name = "HideBigCorners">
            <HideContaining Vector = "-W; W; W" />
            <HideContaining Vector = " W;-W; W" />
            <HideContaining Vector = " W; W;-W" />
            <HideContaining Vector = "-W;-W;-W" />
        </Macro>

        <ExecMacro MacroName = "HideBigCorners" />
        <SplitByAxes/>
        <RemoveContaining Vector = "Cx;Cy;Cz" />
        <RemoveContaining Vector = "0;0;0" />
        <HideAll/>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />
        <RemoveContaining Vector = "-W; W; W" />
        <RemoveContaining Vector = " W;-W; W" />
        <RemoveContaining Vector = " W; W;-W" />
        <RemoveContaining Vector = "-W;-W;-W" />
        <SplitByAxes/>
        <HideContaining Vector = "Cx;Cy;Cz" />
        <RemoveAllVisible/>
        <ShowAll/>
        <ExecMacro MacroName = "HideBigCorners" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "R" Color = "Colors[i]" Center = "Cx[i] * DC; Cy[i] * DC; Cz[i] * DC" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" i = "0" Repeat = "6" />

        <SplitByAxes/>

        <Connect Layers = "0;2" />
        <Connect Layers = "3;5" />

        <Turn Angle = "-Pi/2" Axis = "0" From = "1" To = "2" />
        <Turn Angle = "Pi" Axis = "1" From = "1" To = "2" />
        <Cut Axis = "2" From = "3" />
        <Undo Repeat = "2" />

        <ShowAll/>
    </Figure>
</xml>
