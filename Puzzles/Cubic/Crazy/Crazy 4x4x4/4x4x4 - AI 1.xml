<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 4x4x4 AI 1</Name>
        <Menu>Cubic\Crazy\Crazy 4x4x4\Crazy 4x4x4 AI 1</Menu>
        <Inventor>Roberto de la Fuente</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5976</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
        R := W * 0.36;
        DC := 1.002;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W;-D; 0; D; W" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = "-W;-W;-W" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "R" Color = "Colors[i]" Center = "Cx[i] * DC; Cy[i] * DC; Cz[i] * DC" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" i = "0" Repeat = "6" />

        <SplitByAxes />

        <Connect Layers = "0;2" />
        <Connect Layers = "3;5" />

        <Turn Angle = "-Pi/2" Axis = "0" From = "1" To = "2" />
        <Turn Angle = "Pi" Axis = "1" From = "1" To = "2" />
        <Cut Axis = "2" From = "3" />
        <Undo Repeat = "2" />

        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
