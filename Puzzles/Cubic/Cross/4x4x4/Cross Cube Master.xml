<xml Data_Version = "2" >

    <Interface>
        <Name>Master Cross Cube 4x4x4</Name>
        <Menu>Cubic\Cross\4x4x4\Cross Cube Master</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-05</Added>
    </Interface>

    <Script>
        W := 0.55;

        D1 := W / 4;
        D2 := D1 * 2;
        D3 := D1 * 3;
    </Script>
    
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3;-D2;-D1; 0; D1; D2; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Cubic\Cross\_Macro_For_Cross.xml" W1 = "D2" W2 = "W" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "D2" Color = "-1" />
        <SplitByAxes/>
        <Script> W := D2; include 'Figures\Scripts\Cube_Coordinates.inc'; </Script>
        <RemoveContaining Vectors = " Cx; Cy; Cz" />
        <RemoveContaining Vectors = "  0;  0;  0" />
    </Figure>
</xml>
