<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master 4x4x6 Cuboid</Name>
        <Menu>Cubic\Cross\4x4x4\4x4x6 Cuboid</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1803</Link>
    </Interface>

    <Script>
        W := 0.55;

        W1 := W * 2 / 3;
        W2 := W * 3 / 3;

        D1 := W * 1 / 3;
        D2 := W * 2 / 3;

        delta := 0.001;

    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; 0; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Cubic\Cross\_Macro_For_Cross.xml" />
        <RemoveContaining Vector = "  0;  0;  0" />
        <RemoveContaining Vector = "  0; W1;  0" />
        <RemoveContaining Vector = "  0;-W1;  0" />
        <RemoveContaining Vector = "  0;  0; W1" />
        <RemoveContaining Vector = "  0;  0;-W1" />

        <Part>
            <Vertices>
                <Add Vector = " -W1; -W1 - delta; -W1 - delta" />
                <Add Vector = " -W1; -W1 - delta;  W1 + delta" />
                <Add Vector = " -W1;  W1 + delta; -W1 - delta" />
                <Add Vector = " -W1;  W1 + delta;  W1 + delta" />
                <Add Vector = "  W1; -W1 - delta; -W1 - delta" />
                <Add Vector = "  W1; -W1 - delta;  W1 + delta" />
                <Add Vector = "  W1;  W1 + delta; -W1 - delta" />
                <Add Vector = "  W1;  W1 + delta;  W1 + delta" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face                    VertexIndexes = "0;1;3;2" />
                <Face                    VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <HideContaining Vector = "  0;  D2;   0" />
        <HideContaining Vector = "  0; -D2;   0" />
        <HideContaining Vector = "  0;   0;  D2" />
        <HideContaining Vector = "  0;   0; -D2" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
