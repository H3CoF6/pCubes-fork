<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master X-Cube</Name>
        <Menu>Cubic\Cross\4x4x4\X-Cube</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-05</Added>
    </Interface>

    <Script>
        W := 0.55;
        Extra[0] := 1;
        Extra[1] := 1;
        Extra[2] := 1;
        Extra[3] := 1;
        Extra[4] := 0;
        Extra[5] := 0;

        D  := W / 6;
        D1 := D * 2;
        D2 := D * 4;

        delta := 0.001;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; 0; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <!-- Extra blocks -->
        <LoadFrom File = "Puzzles\Cubic\Cross\_Macro_For_Cross.xml" W1 = "D2" W2 = "W" />
        <Macro Name = "Remove" >
            <RemoveContaining Vector = " Cx[i] * (1-Extra[i]); Cy[i] * (1-Extra[i]); Cz[i] * (1-Extra[i])" />
            <Script>Inc(i);</Script>
        </Macro>
        <Script>include 'Figures\Scripts\Cube_Coordinates.inc';</Script>
        <ExecMacro MacroName = "Remove" i = "0" Repeat = "6" />

        <!-- Core -->
        <HideAll/>
        <LoadFrom File = "Figures\Cube.xml" W = "D2 + delta" />
        <Macro Name = "Cut" >
            <Cut><Plane NormVector = "-Cx[i];-Cy[i];-Cz[i]" NormDistance = "-D2 * (2-Extra[i])" /> </Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" Repeat = "6" />
        <ShowAll/>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <!-- Remove invisible parts -->
        <Script> W := D2; include 'Figures\Scripts\Cube_Coordinates.inc'; </Script>
        <HideContaining Vectors = " Cx; Cy; Cz" />
        <InvertVisibility/>
        <RemoveGrayParts/>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveContaining Vector = " 0; 0; 0" />
    </Figure>
</xml>
