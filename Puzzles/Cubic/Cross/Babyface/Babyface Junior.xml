<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Babyface Junior Cube</Name>
        <Menu>Cubic\Cross\Babyface\Babyface Junior</Menu>
        <Inventor>Mike Grimsley</Inventor>
        <Programmer>Evgeniy grigoriev</Programmer>
        <Added>2016-11-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2606</Link>
    </Interface>

    <Script>
        W := 0.5;
        W1 := W * 0.9;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-W1; 0; W1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split> <Plane NormDistance = "W1" NormVector = " 0; 0; 1" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 0; 0;-1" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 1; 0; 0" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = "-1; 0; 0" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 0; 1; 0" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 0;-1; 0" /> </Split>

        <RemoveContaining Vector = " Vx; Vy; Vz" />
        <RemoveContaining Vector = " Ex; Ey; Ez" />

        <SplitByAxes/>
    </Figure>
</xml>
