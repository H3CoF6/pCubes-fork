<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Babyface Cube</Name>
        <Menu>Cubic\Cross\Babyface\Babyface Cube</Menu>
        <Inventor>Jo Jeong-Whi</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3187</Link>
    </Interface>

    <Script>
        W := 0.5;
        W1 := W * 0.9;
        D := W1 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-W1;-D; D; W1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split> <Plane NormDistance = "W1" NormVector = " 0; 0; 1" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 0; 0;-1" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 1; 0; 0" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = "-1; 0; 0" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 0; 1; 0" /> </Split>
        <Split> <Plane NormDistance = "W1" NormVector = " 0;-1; 0" /> </Split>

        <RemoveContaining Vector = " Vx; Vy; Vz" />
        <RemoveContaining Vector = " Ex; Ey; Ez" />

        <SplitByAxes/>

        <RemoveContaining Vector = " D; 0; 0" />
        <RemoveContaining Vector = "-D; 0; 0" />
        <RemoveContaining Vector = " 0; D; 0" />
        <RemoveContaining Vector = " 0;-D; 0" />
        <RemoveContaining Vector = " 0; 0; D" />
        <RemoveContaining Vector = " 0; 0;-D" />
    </Figure>
</xml>
