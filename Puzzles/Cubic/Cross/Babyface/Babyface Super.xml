<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Babyface Super</Name>
        <Menu>Cubic\Cross\Babyface\Babyface Super</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1593</Link>
    </Interface>

    <Script>
        Colors[0] := 'C80000'; // Red
        Colors[1] := 'FF800A'; // Orange
        Colors[2] := '0000C8'; // Blue
        Colors[3] := '009600'; // Green
        Colors[4] := 'FFFF00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        W := 0.5;
        W1 := W * 0.9;
    </Script>

    <Axes TurningAngles = "Pi / 2; 0; Pi / 2" PlaneDistances = "-W1; W1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[4]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />

                <Face Color = "Colors[2]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />

                <Face Color = "Colors[4]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0;4;10" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "4;5;10" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "5;1;10" InvisibleEdges = "6" />

                <Face Color = "Colors[0]" VertexIndexes = "2;3;11" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "3;7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />

                <Face Color = "Colors[2]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "6;4;12" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "4;0;12" InvisibleEdges = "6" />

                <Face Color = "Colors[3]" VertexIndexes = "3;1;13" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "1;5;13" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "5;7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "7;3;13" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <RemoveContaining Vector = " Vx; Vy; Vz" />
        <RemoveContaining Vector = " Ex; Ey; Ez" />
        <SaveSolvedState/>
        <Turn Axis = "0" Layer = "0" Angle = " Pi/2" />
        <Turn Axis = "0" Layer = "2" Angle = "-Pi/2" />
        <Turn Axis = "1" Layer = "0" Angle = " Pi/2" />
        <Turn Axis = "1" Layer = "2" Angle = "-Pi/2" />
        <Turn Axis = "2" Layer = "0" Angle = " Pi/2" />
        <Turn Axis = "2" Layer = "2" Angle = "-Pi/2" />
        <SaveSolvedState/>
        <Undo Repeat = "6" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
