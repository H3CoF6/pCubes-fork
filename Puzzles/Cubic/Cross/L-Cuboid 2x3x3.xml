<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>L-Cuboid 2x3x3</Name>
        <Menu>Cubic\Cross\L-Cuboid 2x3x3</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7439</Link>
    </Interface>

    <Script>
        W := 0.55;
        D := W / 5;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0"  >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Script>
            include 'Figures\Scripts\Cube_Standard_Colors.inc';
            Colors[1] := -1;
            Colors[2] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D * 3" WY = "D * 3" WZ = "D * 2" />

        <Script>
            include 'Figures\Scripts\Cube_Standard_Colors.inc';
            Colors[0] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D" WY = "D * 3" WZ = "D * 2" DWX = "D * 4" />

        <Script>
            include 'Figures\Scripts\Cube_Standard_Colors.inc';
            Colors[3] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D * 3" WY = "D" WZ = "D * 2" DWX = "0" DWY = "-D * 4" />
        <SplitByAxes/>

        <!-- fake cubies -->
        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D * 4" WY = "D * 4" WZ = "D * 2" DWX = "-D" DWY = "D" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />

        <InvertVisibility/>
    </Figure>
</xml>
