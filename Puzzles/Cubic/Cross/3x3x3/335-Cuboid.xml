<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x5 Cuboid</Name>
        <Menu>Cubic\Cross\3x3x3\3x3x5 Cuboid</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=702</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1129</Link>
    </Interface>

    <Script>
        W := 0.55;

        D1 := W / 5;
        D2 := D1 * 3;

        WX := W;
        WY := D2 + 0.001;
        WZ := WY;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <HideContaining Vector = " 0; D2;  0" />
        <HideContaining Vector = " 0;-D2;  0" />
        <HideContaining Vector = " 0;  0; D2" />
        <HideContaining Vector = " 0;  0;-D2" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
