<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cross Cube</Name>
        <Menu>Cubic\Cross\3x3x3\Cross Cube</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1755</Link>
    </Interface>

    <Script>
        W := 0.55;

        W1 := W * 3 / 5;
        W2 := W * 5 / 5;

        D1 := W * 1 / 5;
        D2 := W * 3 / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "w2" WY = "w1" WZ = "w1" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "w1" WY = "w2" WZ = "w1" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "w1" WY = "w1" WZ = "w2" />
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "w1" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "w1" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "w1" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "w1" /></Split>
        <Split><Plane NormVector = " 0; 0;-1" NormDistance = "w1" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "w1" /></Split>
        <RemoveContaining Vector = " 0; 0; 0" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "w1" Color = "-1" />
        <SplitByAxes/>
    </Figure>
</xml>
