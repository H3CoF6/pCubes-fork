<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Shepherd Cross Cube</Name>
        <Menu>Cubic\Cross\3x3x3\Shepherd Cross Cube</Menu>
        <Inventor>Steven Garza</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-05-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4657</Link>
    </Interface>

    <Script>
        W := 0.5;
        da := 0.002;
        D := W / 5;

        Color := 'FFFFFF';
        DCut1 := (W - 3*D*da) / sqrt(1 + da^2) * 0.999;
        DCut2 := (3*D - W*da) / sqrt(1 + da^2) * 0.999;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3 * D; -D; D; 3 * D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "Color" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />

        <Hide Axis = "0" From = "1" To = "3" />
        <Hide Axis = "1" From = "1" To = "3" />
        <Cut  Axis = "0" From = "1" To = "3" />
        <ShowAll/>

        <Hide Axis = "1" From = "1" To = "3" />
        <Hide Axis = "2" From = "1" To = "3" />
        <Cut  Axis = "1" From = "1" To = "3" />
        <ShowAll/>

        <Hide Axis = "2" From = "1" To = "3" />
        <Hide Axis = "0" From = "1" To = "3" />
        <Cut  Axis = "2" From = "1" To = "3" />
        <ShowAll/>

        <Macro Name = "Cut" >
            <Cut Color = "Color"> <Plane NormVector = "0; da; 1" NormDistance = "-DCut1" /> </Cut>
            <Cut Color = "Color"> <Plane NormVector = "0;-da;-1" NormDistance = "-DCut1" /> </Cut>
            <HideContaining Vector = " 0; 0; 3*D" />
            <HideContaining Vector = " 0; 0;-3*D" />
            <Cut Color = "Color"> <Plane NormVector = "0; da; 1" NormDistance = "-DCut2" /> </Cut>
            <Cut Color = "Color"> <Plane NormVector = "0;-da;-1" NormDistance = "-DCut2" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Cut" Repeat = "3" />
        <SplitByAxes/>
    </Figure>

    <Textures>
        <Texture Name = "Arrow" File = "Textures\Arrow.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Arrow =  8,3,3,  5,2,3,  2,3,3,  7,2,1,  4,1,1,  1,2,1,  6,3,1,  3,2,0,  0,3,0, 56,3,1, 55,2,0, 54,3,0, 20,3,2, 19,2,0, 18,3,3, 65,3,3, 64,2,1, 63,3,0, 11,3,2, 10,2,1,  9,3,1
        Arrow = 74,3,1, 77,2,0, 80,3,1, 73,2,3, 76,1,3, 79,2,3, 72,3,3, 75,2,3, 78,3,2, 60,3,3, 61,2,0, 62,3,2, 24,3,0, 25,2,0, 26,3,1, 17,3,1, 16,2,3, 15,3,2, 71,3,0, 70,2,3, 69,3,3
        Arrow = 11,2,1, 14,2,1, 17,2,2, 10,1,0, 13,1,0, 16,1,0,  9,2,0, 12,2,0, 15,2,3, 54,2,1, 57,2,1, 60,2,3, 18,2,1, 21,2,1, 24,2,3,  2,2,2,  1,1,0,  0,2,3, 74,2,1, 73,1,0, 72,2,0
        Arrow = 71,2,1, 68,2,2, 65,2,2, 70,1,0, 67,1,0, 64,1,0, 69,2,0, 66,2,3, 63,2,3, 62,2,1, 59,2,3, 56,2,3, 26,2,1, 23,2,3, 20,2,3, 80,2,2, 79,1,0, 78,2,3,  8,2,1,  7,1,0,  6,2,0
        Arrow = 18,1,0, 21,1,0, 24,1,1, 19,1,1, 22,1,1, 25,1,1, 20,1,3, 23,1,3, 26,1,2,  9,1,0, 12,1,0, 15,1,2, 63,1,0, 66,1,0, 69,1,2,  0,1,1,  3,1,1,  6,1,2, 72,1,0, 75,1,1, 78,1,3
        Arrow = 56,1,0, 59,1,0, 62,1,1, 55,1,3, 58,1,3, 61,1,3, 54,1,3, 57,1,3, 60,1,2, 65,1,0, 68,1,0, 71,1,2, 11,1,0, 14,1,0, 17,1,2,  8,1,1,  5,1,3,  2,1,2, 80,1,0, 77,1,3, 74,1,3
