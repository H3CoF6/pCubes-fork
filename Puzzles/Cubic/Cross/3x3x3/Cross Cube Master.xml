<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cross Cube Master</Name>
        <Menu>Cubic\Cross\3x3x3\Cross Cube Master</Menu>
        <Inventor>Dane Christianson</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5695</Link>
    </Interface>

    <Script>
        W := 0.55;

        W1 := W * 3 / 7;
        W2 := W * 7 / 7;

        D1 := W * 1 / 7;
        D2 := W * 3 / 7;
        D3 := W * 5 / 7;
    </Script>
    
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3;-D2;-D1; D1; D2; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Cubic\Cross\_Macro_For_Cross.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
