<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-1.5 Cube</Name>
        <Menu>Cubic\Cross\3x3x3\X-1.5 Cube</Menu>
        <Inventor>David Marcos</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-01-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6475</Link>
    </Interface>

    <Script>
        W := 0.55;

        D1 := W  / 7;
        D2 := D1 * 3;
        D3 := D1 * 5;

        delta := 0.001;
        W1 := D2 + delta;
        W2 := D3 + delta;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3;-D2;-D1; D1; D2; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <!-- Extras -->
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W2" WY = "D2" WZ = "D2" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "W"  WZ = "D2" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "5" />
        <RemoveContaining Vector = " 0; 0; 0" />

        <!-- Core -->
        <Script>
            for i := 0 to 3 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D2" WZ = "W1" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <HideContaining Vector = "-W1; 0; 0" />
        <HideContaining Vector = " W1; 0; 0" />
        <HideContaining Vector = " 0; 0;-W1" />
        <HideContaining Vector = " 0; 0; W1" />
        <InvertVisibility/>
        <SplitByAxes/>

        <!-- Invisible fake parts, preventing some turns -->
        <HideAll/>
        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D2" WZ = "W" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <RemoveContaining Vector = " 0; 0; 0" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <RemoveContaining Vector = " 0; 0;-W" />
        <RemoveContaining Vector = " 0; 0; W" />
        <InvertVisibility/>
    </Figure>
</xml>
