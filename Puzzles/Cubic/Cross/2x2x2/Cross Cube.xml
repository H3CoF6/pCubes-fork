<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cross Cube Junior</Name>
        <Menu>Cubic\Cross\2x2x2\Cross Cube</Menu>
        <Inventor>Steve Marshall</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-10-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2919</Link>
    </Interface>

    <Script>
        W := 0.55;
        D2 := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Script> include 'Figures\Scripts\Cube_Standard_Colors.inc'; </Script>
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "D2" WZ = "D2" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "W" WZ = "D2" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D2" WZ = "W" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "D2" Color = "-1" />
        <SplitByAxes/>
    </Figure>
</xml>
