<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mini X-Cube Split</Name>
        <Menu>Cubic\Cross\Mini X-Cube Split</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-04-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8818</Link>
    </Interface>

    <Script>
        W := 0.6;
        D  := W / 3;
        H := D * 2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "H" WZ = "D" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <RemoveContaining Vector = " 0; 0; 0" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D" WY = "W" WZ = "H" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <HideContaining Vector = " 0; 0; 0" />
        <Split Axis = "0" From = "2" />
        <ShowAll/>
    </Figure>
</xml>
