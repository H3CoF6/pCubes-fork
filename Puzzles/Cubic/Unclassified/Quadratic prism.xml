    <Script>
        W := 0.5;

        D1 := 0.14;
        D2 := 0.14;
        D3 := 0.18;
    </Script>

    <Axes TurningAngles = "Pi/2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" PlaneDistances = "-D1; D1" />
        <Axis NormVector = "0; 1; 0" PlaneDistances = "-D2; D2" />
        <Axis NormVector = "0; 0; 1" PlaneDistances = "-D3; D3" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
