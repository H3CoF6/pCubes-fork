<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tie Cube</Name>
        <Menu>Cubic\Unclassified\Tie Cube</Menu>
        <Inventor>Jason Halliday</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-03-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2118</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W * 0.6;
        D2 := W / 3;
        D3 := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" PlaneDistances = "-D1; D1" />
        <Axis NormVector = "0; 1; 0" PlaneDistances = "-D2; D2" />
        <Axis NormVector = "0; 0; 1" PlaneDistances = "-D3; D3" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <SplitByAxes/>
        <Undo/>
    </Figure>
</xml>
