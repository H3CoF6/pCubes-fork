<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pythagorean Cube</Name>
        <Menu>Cubic\Unclassified\Pythagorean Cube</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-09-04</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=419128#p419128</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W / 3;
        D2 := W / 5;
        D3 := W / 2
    </Script>

    <Axes TurningAngles = "Pi" NormVectors = " 1; 0; 0" PlaneDistances = "-D1; D1" />
    <Axes TurningAngles = "Pi" NormVectors = " 0; 1; 0" PlaneDistances = "-D2*3;-D2; D2; D2*3" />
    <Axes TurningAngles = "Pi" NormVectors = " 0; 0; 1" PlaneDistances = "-D3; 0; D3" />

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
