<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Trouble - A</Name>
        <Menu>Cubic\Unclassified\Double Trouble - A</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4416</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;
        SL := D * 1.2;
        SW := D * 0.1;
        W1 := W * 1.001;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W;-D; D; W" TurnAxesWithLayer = "2" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D" /> </Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D" /> </Split>
        <RemoveGrayParts/>
        <Connect Axis = "1" Layers = "1;3" />
        <Connect Axis = "1" Layers = "0;2;4" />

        <Macro Name = "AddSticker" >
            <Part>
                <Vertices Vectors = " SL; SW; W1" />
                <Vertices Vectors = "-SL; SW; W1" />
                <Vertices Vectors = "-SL;-SW; W1" />
                <Vertices Vectors = " SL;-SW; W1" />
                <Faces>
                    <Face Color = "Color" VertexIndexes = "0;1;2;3" />
                </Faces>
            </Part>
            <Turn NormVector = "1; 0; 0" Angle = "Pi" />
        </Macro>
        <ExecMacro MacroName = "AddSticker" Color = "000000" />
        <ExecMacro MacroName = "AddSticker" Color = "000001" />
    </Figure>
</xml>
