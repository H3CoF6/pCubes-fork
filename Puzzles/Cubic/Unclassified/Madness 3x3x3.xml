<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Madness 3x3x3</Name>
        <Menu>Cubic\Unclassified\Madness 3x3x3</Menu>
        <Inventor>Li Chung Man</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4834</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        D1 := W / 3;
        D2 := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W*1.01" DWZ = "-W/3" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <RemoveGrayParts/>
    </Figure>
</xml>
