<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Window Real 5x5x5</Name>
        <Menu>Cubic\Unclassified\Window Real 5x5x5</Menu>
        <Inventor>Carl N. Hoff</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4899</Link>
    </Interface>

    <Script>
      W := 0.5;
      D1 := W * 0.2;
      D2 := W * 0.4;
      D3 := W * 0.65;
      D4 := W * 0.85;

      WSmallCube := D1 * 3;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; -D1; D1; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split><Plane NormVector = "1;0;0" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = "1;0;0" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = "0;0;2" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = "0;0;2" NormDistance = " D2" /></Split>

        <Macro Name = "HideCenter" >
            <HideContaining Vector = " Cx[Id]; Cy[Id]; Cz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "HideCenter" Id = "0" Repeat = "6" />

        <RemoveAllVisible/>

        <InvertVisibility/>
        <Split><Plane NormVector = "1;0;0" NormDistance = "-D4" /></Split>
        <Split><Plane NormVector = "1;0;0" NormDistance = " D4" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = "-D4" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = " D4" /></Split>
        <Split><Plane NormVector = "0;0;2" NormDistance = "-D4" /></Split>
        <Split><Plane NormVector = "0;0;2" NormDistance = " D4" /></Split>
        <RemoveGrayParts/>
        <HideAll/>

        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <RemoveGrayParts/>

        <Macro Name = "RemoveCenter" >
            <RemoveContaining Vector = " Cx[Id]; Cy[Id]; Cz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenter" Id = "0" Repeat = "6" />

        <Script>W := WSmallCube;</Script>
        <LoadFrom File = "Figures\Cube.xml" />

        <ShowAll/>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
