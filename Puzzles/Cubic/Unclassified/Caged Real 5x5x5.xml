<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Caged Real 5x5x5</Name>
        <Menu>Cubic\Unclassified\Caged Real 5x5x5</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2019-11-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7614</Link>
    </Interface>

    <Script>
        W := 0.5;
        W1 := W;
        D1 := W / 5;
        D2 := 3 * W / 5;

        W2 := W * 0.35;

        HX := W * 0.1;
        WX := W * 0.1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />

        <HideContaining Vector = "Cx;Cy;Cz" />

        <RemoveGrayParts/>
        <InvertVisibility/>

        <Split> <Plane NormVector = " 1; 0; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = "-1; 0; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0; 1; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0;-1; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0; 0; 1" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0; 0;-1" NormDistance = "W - HX" /> </Split>

        <RemoveGrayParts/>

        <Split Color1 = "Colors[0]" > <Plane NormVector = " 1; 0; 0" NormDistance = "D2 - HX" /> </Split>
        <Split Color1 = "Colors[1]" > <Plane NormVector = "-1; 0; 0" NormDistance = "D2 - HX" /> </Split>
        <Split Color1 = "Colors[2]" > <Plane NormVector = " 0; 1; 0" NormDistance = "D2 - HX" /> </Split>
        <Split Color1 = "Colors[3]" > <Plane NormVector = " 0;-1; 0" NormDistance = "D2 - HX" /> </Split>
        <Split Color1 = "Colors[4]" > <Plane NormVector = " 0; 0; 1" NormDistance = "D2 - HX" /> </Split>
        <Split Color1 = "Colors[5]" > <Plane NormVector = " 0; 0;-1" NormDistance = "D2 - HX" /> </Split>

        <RemoveContaining Vector = "Cx;Cy;Cz" />

        <Script>
            W := W2;
        </Script>
        <LoadFrom File = "Figures\Cube.xml" />
        <ShowAll/>
        <SplitByAxes/>

        <Script> WE := WX; DCut1 := W1 - HX; DCut2 := W1; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := WX; DCut1 := W2; DCut2 := W2 + HX; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <ShowAll/>

        <RemoveGrayParts/>

    </Figure>
</xml>
