<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pseudo 3x3x3</Name>
        <Menu>Cubic\Unclassified\Pseudo 3x3x3</Menu>
        <Inventor>Erlend Fredriksen</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9546</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W" DWZ = "D" />
        <Split><Plane NormVector = "0;0;1" NormDistance = "D*2" /></Split>
        <SplitByAxes/>
    </Figure>
</xml>
