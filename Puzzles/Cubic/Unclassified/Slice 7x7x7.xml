<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Slice 7x7x7</Name>
        <Menu>Cubic\Unclassified\Slice 7x7x7</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3582</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W * 1 / 7;
        D2 := W * 3 / 7;
        D3 := W * 5 / 7;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; -D2; -D1; D1; D2; D3" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Connect Layers = "0;6" />
        <Connect Layers = "1;5" />
        <Connect Layers = "2;4" />
    </Figure>
</xml>
