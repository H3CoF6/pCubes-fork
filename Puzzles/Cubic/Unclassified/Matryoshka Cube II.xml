<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Matryoshka Cube II</Name>
        <Menu>Cubic\Unclassified\Matryoshka Cube II</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6956</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF8800'; // clOrange
        Colors[2] := '0066FF'; // clBlue
        Colors[3] := '00DD00'; // clGreen
        Colors[4] := 'FFFF00'; // clYellow
        Colors[5] := 'FFFFFF'; // clWhite

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        W1 := W;
        D1 := W / 5;
        D2 := 3 * W / 5;
        D3 := 2 * W / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D1; D2; D3;-D3;-D2;-D1" TurnAxesWithLayer = "6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W * 1.1" Color = "-1" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "5" />

        <HideContaining Vector = "Ex; Ey; Ez" />
        <InvertVisibility/>

        <Macro Name = "CutGray">
            <Cut> <Plane NormVector = "-Cx[id]; -Cy[id]; -Cz[id]" NormDistance = "-W" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutGray" Repeat = "6" id = "0" />
        <ShowAll/>

        <Macro Name = "CutColor">
            <Cut Color = "Colors[id]" > <Plane NormVector = "-Cx[id]; -Cy[id]; -Cz[id]" NormDistance = "-W" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" Repeat = "6" id = "0" />

        <RemoveContaining Vector = "Cx;Cy;Cz" />

        <RemoveContaining Vector = "0;0;0" />
        <InvertVisibility/>

        <LoadFrom File = "Figures\Cube.xml" W = "D3" />

        <ShowAll/>

        <HideContaining Vector = " W1; W1; W1" />
        <HideContaining Vector = "-W1; W1; W1" />
        <HideContaining Vector = " W1;-W1; W1" />
        <HideContaining Vector = " W1; W1;-W1" />
        <SplitByAxes/>

        <ShowAll/>
        <HideContaining Vector = " W1; W1; W1" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>
        <HideContaining Vector = "-W1; W1; W1" />
        <HideContaining Vector = " W1;-W1; W1" />
        <HideContaining Vector = " W1; W1;-W1" />
        <InvertVisibility/>
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "6" />
        <ShowAll/>

        <Hide Axis = "0" From = "0" To = "0" />
        <Hide Axis = "0" From = "6" To = "6" />
        <Hide Axis = "1" From = "0" To = "0" />
        <Hide Axis = "1" From = "6" To = "6" />
        <Hide Axis = "2" From = "0" To = "0" />
        <Hide Axis = "2" From = "6" To = "6" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Connect Layers = "0;2;3" />
        <Connect Layers = "1;4;5" />
    </Figure>
</xml>
