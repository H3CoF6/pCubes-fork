<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>180 Cube</Name>
        <Menu>Cubic\Unclassified\180 Cube</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-03-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2366</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" PlaneDistances = "-D; D" />
        <Axis NormVector = "0; 1; 0" PlaneDistances = "-D; D" />
    </Axes>

    <Axes TurningAngles = "Pi" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" PlaneDistances = "-D; D" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Dot"    File = "Textures\Dot.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Dot = 13,0,0, 12,0,0
    </SetTextures>
</xml>
