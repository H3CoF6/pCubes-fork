<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pseudo 2x2x3</Name>
        <Menu>Cubic\Unclassified\Pseudo 2x2x3</Menu>
        <Inventor>Erlend Fredriksen</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-04-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9179</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.3;
        D := W / 1.01;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W / 2 * 3" DWZ = "W / 2" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
    </Figure>
</xml>
