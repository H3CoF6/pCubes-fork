    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        W := 0.5;
        D := W * 2 / 7;
        WX := D / 2 + 0.001;
        WY := D / 2 + 0.001;
        WZ := D / 2;
        AZ := D * 0.0;

        procedure ParseCubie();
        begin
            DWX := -WX + x * WX * 2;
            DWY := -WY + y * WY * 2;
            DWZ := -1.5*D + z * D - AZ;

            Divider := 100000;
            for i := 0 to 5 do begin
                C := SColors div Divider;
                Case c of
                    0: Colors[i] := clRed;
                    1: Colors[i] := clOrange;
                    2: Colors[i] := clBlue;
                    3: Colors[i] := clGreen;
                    4: Colors[i] := clYellow;
                    5: Colors[i] := clWhite;
                    else Colors[i] := -1;
                end;
                SColors := SColors mod Divider;
                Divider := Divider div 10;
            end;
        end;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" BaseVector = "0; 0;-AZ" />
        <Axis NormVector = "0; 1; 0" BaseVector = "0; 0;-AZ" />
        <Axis NormVector = "0; 0; 1" BaseVector = "0; 0;-AZ" />
    </Axes>
 
    <Figure>
        <Macro Name = "AddCubie" >
            <Script> ParseCubie; </Script>
