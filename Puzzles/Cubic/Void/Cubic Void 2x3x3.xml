<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cubic Void 2x3x3</Name>
        <Menu>Cubic\Void\Cubic Void 2x3x3</Menu>
        <Inventor>Ryan Allsop</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2570</Link>
    </Interface>

    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 0; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />

        <RemoveContaining Vector = " 0; 0; 0" />
    </Figure>
</xml>
