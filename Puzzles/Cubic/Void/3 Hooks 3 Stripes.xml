<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3 Hooks 3 Stripes</Name>
        <Menu>Cubic\Void\3 Hooks 3 Stripes</Menu>
        <Inventor>Wu Zhe</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-01-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "2" />

        <HideContaining Vector = " 0;0;0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <RemoveContaining Vector = " Cx; Cy; Cz" />
        <RemoveContaining Vector = "0;0;0" />
        <ShowAll/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <InvertVisibility/>
        <Split InvisibleEdges1 = "10" InvisibleEdges2 = "10" ><Plane NormVector = " 1; 1; 0" NormDistance = " 0" /></Split>
        <Split InvisibleEdges1 = " 5" InvisibleEdges2 = "10" ><Plane NormVector = " 1; 0;-1" NormDistance = " 0" /></Split>
        <Split InvisibleEdges1 = " 5" InvisibleEdges2 = " 5" ><Plane NormVector = " 0; 1; 1" NormDistance = " 0" /></Split>
        <ShowAll/>

        <Macro Name = "CutC" >
            <HideContaining Vector = " W; 0;-W" />
            <HideContaining Vector = " 0;-W;-W" />
            <InvertVisibility/>
            <Cut><Plane NormVector = " 0; 0;-1" NormDistance = " D" /></Cut>
            <ShowAll/>
            <Turn NormVector = " 1;-1; 1" Angle = "2*Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "CutC" Repeat = "3" />
    </Figure>
</xml>
