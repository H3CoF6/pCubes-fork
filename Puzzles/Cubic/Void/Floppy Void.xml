<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Void Floppy</Name>
        <Menu>Cubic\Void\Floppy Void</Menu>
        <Inventor>Murilo Purcineli Semeghini</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-04-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2598</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "D" />
        <SplitByAxes/>

        <RemoveContaining Vector = " 0; 0; 0" />
    </Figure>
</xml>
