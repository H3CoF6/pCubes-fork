<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Cuboid</Name>
        <Menu>Cubic\Void\Cuboid</Menu>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-10-24</Added>
    </Interface>

    <Script>
        WX := 0.4;
        WY := WX;
        WZ := WX * 5 / 4;
        D1 := WX / 2;
        D2 := WX * 5 / 6;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2; D2" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>

        <RemoveContaining Vector = " 0; 0; 0" />

        <RemoveContaining Vector = " WX;   0;   0" />
        <RemoveContaining Vector = "-WX;   0;   0" />
        <RemoveContaining Vector = "   0; WY;   0" />
        <RemoveContaining Vector = "   0;-WY;   0" />
        <RemoveContaining Vector = "   0;   0; WZ" />
        <RemoveContaining Vector = "   0;   0;-WZ" />
    </Figure>
</xml>
