<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Binary Deep Cube</Name>
        <Menu>Cubic\JailBreak\Binary Deep Cube</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2020-01-25</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=35383</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0;-1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "-D" /></Split>
        <HideContaining Vector = " 0; 0; 0" />
        <Split><Plane NormVector = " 0; 0;-1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D" /></Split>
        <ShowAll/>
    </Figure>

    <Textures>
        <Texture Name = "Frame" File = "Puzzles\Cubic\JailBreak\Enabler Cube.vec" />
        <Texture Name = "Cross" File = "Puzzles\Cubic\Crazy\Crazy 3x3x3\CrossFace.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Frame = 0,0,1, 0,1,0, 0,2,1
        Cross = 24,1,0, 24,0,0
    </SetTextures>

</xml>
