<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>JailBreak - Freedom</Name>
        <Class>TJailBreakCube</Class>
        <Menu>Cubic\JailBreak\Freedom</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5188</Link>
    </Interface>
 
    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Key"        File = "Puzzles\Cubic\JailBreak\Key.vec" />
        <Texture Name = "LockClosed" File = "Puzzles\Cubic\JailBreak\LockClosed.vec" />
        <Texture Name = "LockOpened" File = "Puzzles\Cubic\JailBreak\LockOpened.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Key = 22,0,3
        LockClosed = 10,0,3, 21,0,3, 12,0,3, 4,0,3, 15,0,3
    </SetTextures>
</xml>
