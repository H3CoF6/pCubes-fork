<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Enabler Cube</Name>
        <Menu>Cubic\JailBreak\Enabler Cube</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3678</Link>
    </Interface>
 
    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "1/6" TurnAxesWithPartNo = "25" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0;-1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-1/6" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "-1/6" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-1/6" /></Split>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Frame" File = "Puzzles\Cubic\JailBreak\Enabler Cube.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Frame = 25,0,1, 25,1,0, 25,2,1
    </SetTextures>
</xml>
