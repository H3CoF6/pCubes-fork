<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Encourager Cube</Name>
        <Menu>Cubic\JailBreak\Encourager Cube</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9583</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" FixedLayers = "0;2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0;-1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = " D" T1urnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D" /></Split>
        <RemoveGrayParts/>
        <Connect1 Axis = "0" Layers = "0;2" />
        <Connect1 Axis = "1" Layers = "0;2" />
    </Figure>

    <Textures>
        <Texture Name = "Frame" File = "Puzzles\Cubic\JailBreak\Enabler Cube.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Frame = 13,0,1
    </SetTextures>
</xml>
