<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Brick Cube</Name>
        <Menu>Cubic\JailBreak\Brick Cube</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-04</Added>
    </Interface>
 
    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithPartNo = "42" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "1/4" TurnAxesWithPartNo = "42" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <HideContaining Vector = " W;-W; W" />
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-1/4" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " 1/4" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "   0" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-1/4" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "   0" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-1/4" /></Split>
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>

</xml>
