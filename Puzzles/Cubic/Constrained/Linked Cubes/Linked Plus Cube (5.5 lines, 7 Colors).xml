<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Plus Cube (5.5 lines, 7 Colors)</Name>
        <Menu>Cubic\Constrained\Linked Cubes\Linked Plus Cube (5.5 lines, 7 Colors)</Menu>
        <Class>TTenon</Class>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7671</Link>
    </Interface>
 
    <Script>
        clBlack := '202020';
        StickerColor := '800080'; // Violett

        W := 0.5;
        D := W * 0.39;
        D2 := (W - D) / 2; // size of small cubies
        WD := (W + D) / 2; // center of cubies
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "_Macro_For_LinkedCube.xml" />

        // Make Colored cube with gaps and with some black parts (Side^Place, ...)
        <ExecMacro MacroName = "MakeCube" BlackParts = "'00,03,06,07,08,10,11,12,13,16,27,31'" />

        <Hide Axis = "2" Layer = "0" />
        <Hide Axis = "0" To = "1" />
        <Cut><Plane NormVector = "0;0;1" NormDistance = "-D2" /></Cut>
        <ShowAll/>

        // Make Stickers (Side^Place^Rotate, ...)
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile1" SX = "D2" SY = "D2" Places = "'001,080,120,161,221,260,300,381,420,461,500,581'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile2" SX = "D2" SY = "D2" Places = "'062,103,281,320,403,520'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileE" SX = "D"  SY = "D2" Places = "'031,070,110,270,310,351,410,431,510,551'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileH" SX = "D"  SY = "D2" Places = "'131,251'" />

        <SaveSolvedState/>


        <Macro Name = "L " Public = "1" > <Turn Axis = "0" Layer = "0" Angle = " Pi/2" /> </Macro>
        <Macro Name = "L'" Public = "0" > <Turn Axis = "0" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R " Public = "1" > <Turn Axis = "0" Layer = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R'" Public = "0" > <Turn Axis = "0" Layer = "2" Angle = " Pi/2" /> </Macro>
        <Macro Name = "F " Public = "1" > <Turn Axis = "1" Layer = "0" Angle = " Pi/2" /> </Macro>
        <Macro Name = "F'" Public = "0" > <Turn Axis = "1" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "B " Public = "1" > <Turn Axis = "1" Layer = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "B'" Public = "0" > <Turn Axis = "1" Layer = "2" Angle = " Pi/2" /> </Macro>
        <Macro Name = "D " Public = "1" > <Turn Axis = "2" Layer = "0" Angle = " Pi/2" /> </Macro>
        <Macro Name = "D'" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U " Public = "1" > <Turn Axis = "2" Layer = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U'" Public = "0" > <Turn Axis = "2" Layer = "2" Angle = " Pi/2" /> </Macro>
        <Macro Name = "Save" > <SaveSolvedState/>  </Macro>

        <ExecMacro MacroName = "U' B' U D' R U R' U' D B Save" />   FR -> RU
        <ExecMacro MacroName = "B L B' F U' B' U B F' L' Save" />
        <ExecMacro MacroName = "L' D' L R' B L B' L' R D Save" />
        <ExecMacro MacroName = "D F D' U L' D' L D U' F' Save" />
        <ExecMacro MacroName = "F' R' F B' D F D' F' B R Save" />
        <ExecMacro MacroName = "R' D R U U D D L' D' L U U D D Save" />
        <ExecMacro MacroName = "U' B' U D' R U R' U' D B Save" />
        <ExecMacro MacroName = "B L B' F U' B' U B F' L' Save" />
        <ExecMacro MacroName = "L' D' L R' B L B' L' R D Save" />
        <ExecMacro MacroName = "D F D' U L' D' L D U' F' Save" />
        <ExecMacro MacroName = "F' R' F B' D F D' F' B R Save" />
        <Undo Repeat = "114" />

        // Tenons  (Side^Place^Layer, ...)
        <ExecMacro MacroName = "AddTenons"  Places = "'001,081,121,161,221,261,301,381,461,501,581'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'002,012,022,052,082,122,152,162,172,182'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'202,212,222,232,262,302,332,362,372,382'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'422,452,462,472,482,502,532,562,572,582'" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
