<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Cube (6 lines, 6 Colors)</Name>
        <Menu>Cubic\Constrained\Linked Cubes\Linked Cube (6 lines, 6 Colors)</Menu>
        <Class>TTenon</Class>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7670</Link>
    </Interface>
 
    <Script>
        clBlack := '202020';
        StickerColor := 'UseSideColor';

        W := 0.5;
        D := W * 0.39;
        D2 := (W - D) / 2; // size of small cubies
        WD := (W + D) / 2; // center of cubies
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "_Macro_For_LinkedCube.xml" />

        // Make Colored cube with gaps and with some black parts (Side^Place, ...)
        <ExecMacro MacroName = "MakeCube" BlackParts = "'00,01,02,05,06,07,08,10,12,13,16,21,31'" />

        // Make Stickers (Side^Place^Rotate, ...)
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile1" SX = "D2" SY = "D2" Places = "'000,060,101,161,210,261,281,300,320,401,461,520,580'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile2" SX = "D2" SY = "D2" Places = "'020,081,122,203,220,383,422,503,562'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileE" SX = "D"  SY = "D2" Places = "'010,051,070,131,231,251,310,431,510,531,570'" />

        // Tenons  (Side^Place^Layer, ...)
        <ExecMacro MacroName = "AddTenons"  Places = "'001,021,101,121,201,261,321,381,401,421,561,581'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'002,022,052,082,102,112,122,132,162,172,182'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'202,212,222,262,302,312,322,332,352,362,382'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'402,412,422,432,462,472,482,502,532,562,582'" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
