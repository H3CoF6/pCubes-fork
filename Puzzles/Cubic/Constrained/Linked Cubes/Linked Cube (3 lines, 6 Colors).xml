<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Cube (3 lines, 6 Colors)</Name>
        <Menu>Cubic\Constrained\Linked Cubes\Linked Cube (3 lines, 6 Colors)</Menu>
        <Class>TTenon</Class>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7670</Link>
    </Interface>
 
    <Script>
        clBlack := '202020';
        StickerColor := 'UseSideColor';

        W := 0.5;
        D := W * 0.39;
        D2 := (W - D) / 2; // size of small cubies
        WD := (W + D) / 2; // center of cubies
    </Script>

<!--
    <Script> ShowTextures := True; </Script>
    <Textures>
        <Texture Name = "Tenon" File = "Textures\Tenon.vec" />
        <Texture Name = "Groove" File = "Textures\Groove.vec" />
    </Textures>-->

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "_Macro_For_LinkedCube.xml" />

        // Make Colored cube with gaps and with some black parts (Side^Place, ...)
        <ExecMacro MacroName = "MakeCube" BlackParts = "'20,21,22,25,28,11,12'" />

        // Make Stickers (Side^Place^Rotate, ...)
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile1" SX = "D2" SY = "D2" Places = "'120,161,200,281,560,521'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile2" SX = "D2" SY = "D2" Places = "'022,103,220,301,422,581'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileE" SX = "D"  SY = "D2" Places = "'110,131,210,251,570,551'" />

        // Tenons  (Side^Place^Layer, ...)
        <ExecMacro MacroName = "AddTenons"  Places = "'021,101,221,301,421,581'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'002,012,022,052,082,102'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'302,312,322,332,362,222'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'402,412,422,452,482,582'" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
