<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Cube (5 lines, 6 Colors)</Name>
        <Menu>Cubic\Constrained\Linked Cubes\Linked Cube (5 lines, 6 Colors)</Menu>
        <Class>TTenon</Class>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7670</Link>
    </Interface>
 
    <Script>
        clBlack := '202020';
        StickerColor := 'UseSideColor';

        W := 0.5;
        D := W * 0.39;
        D2 := (W - D) / 2; // size of small cubies
        WD := (W + D) / 2; // center of cubies
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "_Macro_For_LinkedCube.xml" />

        // Make Colored cube with gaps and with some black parts (Side^Place, ...)
        <ExecMacro MacroName = "MakeCube" BlackParts = "'00,01,02,03,05,06,08,30,33,36,37'" />

        // Make Stickers (Side^Place^Rotate, ...)
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile1" SX = "D2" SY = "D2" Places = "'061,081,121,181,201,261,301,321,460,480,501,561'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile2" SX = "D2" SY = "D2" Places = "'003,020,362,381,401,522'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileE" SX = "D"  SY = "D2" Places = "'010,031,051,151,231,331,351,370,470,531'" />

        // Tenons  (Side^Place^Layer, ...)
        <ExecMacro MacroName = "AddTenons"  Places = "'061,181,201,321,401,461,481,501,521,561'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'002,032,062,102,112,122,132,152,162,182'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'202,222,232,252,262,272,282,322,352,382'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'402,432,462,482,502,512,522,562'" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
