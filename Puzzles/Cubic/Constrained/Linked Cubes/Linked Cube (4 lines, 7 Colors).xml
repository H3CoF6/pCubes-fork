<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Cube (4 lines, 7 Colors)</Name>
        <Menu>Cubic\Constrained\Linked Cubes\Linked Cube (4 lines, 7 Colors)</Menu>
        <Class>TTenon</Class>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7227</Link>
    </Interface>
 
    <Script>
        clBlack := '202020';
        StickerColor := '800080'; // Violett

        W := 0.5;
        D := W * 0.39;
        D2 := (W - D) / 2; // size of small cubies
        WD := (W + D) / 2; // center of cubies
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "_Macro_For_LinkedCube.xml" />

        // Make Colored cube with gaps and with some black parts (Side^Place, ...)
        <ExecMacro MacroName = "MakeCube" BlackParts = "'20,21,22,23,26,11,12,15,18'" />

        // Make Stickers (Side^Place^Rotate, ...)
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile1" SX = "D2" SY = "D2" Places = "'021,081,100,181,261,220,301,361,560,521'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile2" SX = "D2" SY = "D2" Places = "'120,203,401,483,581'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileE" SX = "D"  SY = "D2" Places = "'051,110,151,210,231,331,570,551'" />

        // Tenons  (Side^Place^Layer, ...)
        <ExecMacro MacroName = "AddTenons"  Places = "'021,101,221,301,401,481,521,561'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'002,012,022,032,062,102,132,162'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'302,312,322,352,382,222,252,282'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'402,412,422,452,482,522,562'" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
