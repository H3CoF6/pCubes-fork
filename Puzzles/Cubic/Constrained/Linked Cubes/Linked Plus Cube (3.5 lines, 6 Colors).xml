<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Plus Cube (3.5 lines, 6 Colors)</Name>
        <Menu>Cubic\Constrained\Linked Cubes\Linked Plus Cube (3.5 lines, 6 Colors)</Menu>
        <Class>TTenon</Class>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7671</Link>
    </Interface>
  
    <Script>
        clBlack := '202020';
        StickerColor := 'UseSideColor';

        W := 0.5;
        D := W * 0.39;
        D2 := (W - D) / 2; // size of small cubies
        WD := (W + D) / 2; // center of cubies
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "_Macro_For_LinkedCube.xml" />

        // Make Colored cube with gaps and with some black parts (Side^Place, ...)
        <ExecMacro MacroName = "MakeCube" BlackParts = "'00,01,02,10,11,12,21,31'" />

        <HideContaining Vector = "W;0;W" />
        <InvertVisibility/>
        <Cut><Plane NormVector = "0;1;0" NormDistance = "-D2" /></Cut>
        <ShowAll/>

        // Make Stickers (Side^Place^Rotate, ...)
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile1" SX = "D2" SY = "D2" Places = "'000,020,100,120,200,220,300,320'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfile2" SX = "D2" SY = "D2" Places = "'503,520,562,581	'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileE" SX = "D"  SY = "D2" Places = "'010,210,310,510,531,570'" />
        <ExecMacro MacroName = "AddStickers" sProfile = "sProfileH" SX = "D"  SY = "D2" Places = "'112,551'" />

        // Tenons  (Side^Place^Layer, ...)
        <ExecMacro MacroName = "AddTenons"  Places = "'001,021,101,121,201,301,321'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'002,012,022,102,112,122'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'202,212,222,302,312,322'" />
        <ExecMacro MacroName = "AddGrooves" Places = "'402,412,422,432,452,462,472,482'" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
