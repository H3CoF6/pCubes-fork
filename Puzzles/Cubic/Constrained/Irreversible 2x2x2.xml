<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Irreversible 2x2x2</Name>
        <Menu>Cubic\Constrained\Irreversible 2x2x2</Menu>
        <Class>TIrreversibleCube</Class>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3964</Link>
    </Interface>
 
    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Irreversible" File = "Irreversible Corner.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Irreversible = 0,0,0, 0,1,0, 0,2,0
        Irreversible = 1,0,0, 1,1,0, 1,2,0
        Irreversible = 2,0,0, 2,1,0, 2,2,0
        Irreversible = 3,0,0, 3,1,0, 3,2,0
        Irreversible = 4,0,0, 4,1,0, 4,2,0
        Irreversible = 5,0,0, 5,1,0, 5,2,0
        Irreversible = 6,0,0, 6,1,0, 6,2,0
        Irreversible = 7,0,0, 7,1,0, 7,2,0
    </SetTextures>

</xml>
