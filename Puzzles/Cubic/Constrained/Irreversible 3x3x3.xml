<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Irreversible 3x3x3</Name>
        <Menu>Cubic\Constrained\Irreversible 3x3x3</Menu>
        <Class>TIrreversibleCube</Class>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-05</Added>
        <Link></Link>
    </Interface>
 
    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Irreversible" File = "Irreversible Corner.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Irreversible =  0,0,0,  0,1,0,  0,2,0
        Irreversible =  2,0,0,  2,1,0,  2,2,0
        Irreversible =  6,0,0,  6,1,0,  6,2,0
        Irreversible =  8,0,0,  8,1,0,  8,2,0
        Irreversible = 17,0,0, 17,1,0, 17,2,0
        Irreversible = 19,0,0, 19,1,0, 19,2,0
        Irreversible = 23,0,0, 23,1,0, 23,2,0
        Irreversible = 25,0,0, 25,1,0, 25,2,0
    </SetTextures>
</xml>
