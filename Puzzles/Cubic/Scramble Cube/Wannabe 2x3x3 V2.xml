<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Wannabe 2x3x3 V2</Name>
        <Menu>Cubic\Scramble Cube\Wannabe 2x3x3 V2</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6258</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Figure>
        <!-- Invisible adhesive pieces -->
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "D*2" DWZ = "D" />
        <SplitByAxes/>
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "D*2" DWZ = "D" />
        <SplitByAxes/>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "D" /></Split>
    </Figure>
</xml>
