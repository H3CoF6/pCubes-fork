<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x3x9</Name>
        <Menu>Cubic\Cuboids\9\3x3x9</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-06-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2222</Link>
    </Interface>

    <Script>
        W := 0.5;

        X := 9;
        Y := 3;
        Z := 3;
        Oversize := 0;

        include 'Puzzles\Cubic\Cuboids\Cuboid Calculation.inc';
    </Script>

    <Axes>
        <Axis TurningAngles = "Ax" NormVector = " 1; 0; 0" PlaneDistances = "DX" />
        <Axis TurningAngles = "Ay" NormVector = " 0; 1; 0" PlaneDistances = "DY" />
        <Axis TurningAngles = "Az" NormVector = " 0; 0; 1" PlaneDistances = "DZ" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Macro Name = "Split" >
            <Split><Plane NormVector = "Cx[c];Cy[c];Cz[c]" NormDistance = "WD * (-L + 2*i)" /></Split>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" c = "1" L = "X" i = "1" Repeat = "X - 1" />
        <ExecMacro MacroName = "Split" c = "3" L = "Y" i = "1" Repeat = "Y - 1" />
        <ExecMacro MacroName = "Split" c = "5" L = "Z" i = "1" Repeat = "Z - 1" />
        <HideAll/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "WD*3" WY = "W" WZ = "WD*3" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "WD*3" WY = "WD*3" WZ = "W" />

        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <InvertVisibility/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)+1" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "0" Layer = "Random(N)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 9;</Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
