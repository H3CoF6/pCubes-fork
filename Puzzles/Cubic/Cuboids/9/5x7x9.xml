<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 5x7x9</Name>
        <Menu>Cubic\Cuboids\9\5x7x9</Menu>
        <Inventor>Grégoire Pfennig, Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3900</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4263</Link>
    </Interface>

    <Script>
        W := 0.5;

        X := 7;
        Y := 9;
        Z := 5;

        include 'Puzzles\Cubic\Cuboids\Cuboid Calculation.inc';
    </Script>

    <Axes>
        <Axis TurningAngles = "Ax" NormVector = " 1; 0; 0" PlaneDistances = "DX" />
        <Axis TurningAngles = "Ay" NormVector = " 0; 1; 0" PlaneDistances = "DY" />
        <Axis TurningAngles = "Az" NormVector = " 0; 0; 1" PlaneDistances = "DZ" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Puzzles\Cubic\Cuboids\Cuboid Splitted.xml" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 9;</Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
