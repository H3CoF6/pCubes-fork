<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 9x11x13</Name>
        <Menu>Cubic\Cuboids\13\9x11x13</Menu>
        <Inventor>Reiden Chea</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8836</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36872</Link>
    </Interface>

    <Script>
        W := 0.5;

        X := 13;
        Y := 11;
        Z := 9;

        include 'Puzzles\Cubic\Cuboids\Cuboid Calculation.inc';
    </Script>

    <Axes>
        <Axis TurningAngles = "Ax" NormVector = " 1; 0; 0" PlaneDistances = "DX" />
        <Axis TurningAngles = "Ay" NormVector = " 0; 1; 0" PlaneDistances = "DY" />
        <Axis TurningAngles = "Az" NormVector = " 0; 0; 1" PlaneDistances = "DZ" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Puzzles\Cubic\Cuboids\Cuboid Splitted.xml" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 13;</Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
