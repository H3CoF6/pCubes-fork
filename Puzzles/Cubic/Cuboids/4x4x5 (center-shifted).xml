<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x4x5 (center-shifted)</Name>
        <Menu>Cubic\Cuboids\Center-shifted\4x4x5 (center-shifted)</Menu>
        <Inventor>Dan Fast</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6664</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 2 / 5;
        dd := 0.001;

        WX := W + dd;
        WY := W / 5 * 4 + dd;
        WZ := W / 5 * 4 + dd;
        DWX := D/2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2*D; -D; 0; D; 2*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
