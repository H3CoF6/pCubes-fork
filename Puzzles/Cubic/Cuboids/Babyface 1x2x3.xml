<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Babyface 1x2x3</Name>
        <Menu>Cubic\Cuboids\Babyface 1x2x3</Menu>
        <Inventor>Edward Ortiz</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2099</Link>
    </Interface>
 
    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        W := 0.55;
        D := W / 3;

        dW := D * 0.1;
        WX := D * 3 + dW;
        WY := D + dW;
        WZ := D * 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Script>
            Colors[4] := -1;
            Colors[5] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <RemoveContaining Vector = "0;0;0" />
        <HideAll/>

        <Script>
            for i := 0 to 3 do
                Colors[i] := -1;
            Colors[4] := clYellow;
            Colors[5] := clWhite;
        </Script>

        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <SplitByAxes/>
        <RemoveContaining Vector = " WX; WY; 0" />
        <RemoveContaining Vector = " WX;-WY; 0" />
        <RemoveContaining Vector = "-WX; WY; 0" />
        <RemoveContaining Vector = "-WX;-WY; 0" />
    </Figure>
</xml>
