<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x6 (center-shifted)</Name>
        <Menu>Cubic\Cuboids\Center-shifted\3x3x6 (center-shifted)</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7843</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 6;

        WX := D * 3;
        WY := D * 3;
        WZ := W;
        DWZ :=-D * 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*6;-D*4;-D*2; 0; D*2; D*4; D*6" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>

        <!-- add invisible bandaging parts -->
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WZ = "D * 3" DWZ = "D * 5" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <InvertVisibility/>
    </Figure>
</xml>
