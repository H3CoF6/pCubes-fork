<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Eccentric Cube 5+1</Name>
        <Menu>Cubic\Cuboids\Eccentric Cube 5+1</Menu>
        <Inventor>Taras Bereznyak</Inventor>
        <Programmer>Taras Bereznyak</Programmer>
        <Added>2026-02-03</Added>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?t=40451</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D1 := W * 0.33;
        D2 := W * 0.11;

        WX := W;
        WY := W;
        WZ := W - D2;
        DWZ := D2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />

        <HideContaining Vectors = "Cx;Cy;Cz" />
        <InvertVisibility/>
        <Split Axis = "2" From = "1" />
        <ShowAll/>

        <RemoveGrayParts/>
    </Figure>
</xml>
