<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>1x1x2 Roadblock</Name>
        <Menu>Cubic\Cuboids\1x1x2 Roadblock</Menu>
        <Inventor>Sam Hardy</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4859</Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W / 6;

        WX := W / 2;
        WY := W / 2;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Undo />
    </Figure>
</xml>
