<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x3x3 Super</Name>
        <Menu>Cubic\Cuboids\2x3x3 Super</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9148</Link>
    </Interface>
 
    <Script>
        Colors[ 0] := 'FFFF00';
        Colors[ 1] := 'FFFFFF';
        Colors[ 2] := 'FF0080';
        Colors[ 3] := '800040';
        Colors[ 4] := '808000';
        Colors[ 5] := '000078';
        Colors[ 6] := 'BF8040';
        Colors[ 7] := '00A600';
        Colors[ 8] := 'C80000';
        Colors[ 9] := '005600';
        Colors[10] := 'FF800A';
        Colors[11] := '0000D8';

        W := 0.5;
        H := W * 2 / 3;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-H" />
                <Add Vector = "-W;-W; H" />
                <Add Vector = "-W; W;-H" />
                <Add Vector = "-W; W; H" />
                <Add Vector = " W;-W;-H" />
                <Add Vector = " W;-W; H" />
                <Add Vector = " W; W;-H" />
                <Add Vector = " W; W; H" />
                <Add Vector = " 0; 0;-H" />
                <Add Vector = " 0; 0; H" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[ 1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[ 2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "2;8;0" InvisibleEdges = "3" />
                <Face Color = "Colors[ 5]" VertexIndexes = "6;8;2" InvisibleEdges = "3" />
                <Face Color = "Colors[ 6]" VertexIndexes = "4;8;6" InvisibleEdges = "3" />
                <Face Color = "Colors[ 7]" VertexIndexes = "0;8;4" InvisibleEdges = "3" />
                <Face Color = "Colors[ 8]" VertexIndexes = "1;9;3" InvisibleEdges = "3" />
                <Face Color = "Colors[ 9]" VertexIndexes = "5;9;1" InvisibleEdges = "3" />
                <Face Color = "Colors[10]" VertexIndexes = "7;9;5" InvisibleEdges = "3" />
                <Face Color = "Colors[11]" VertexIndexes = "3;9;7" InvisibleEdges = "3" />

            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
