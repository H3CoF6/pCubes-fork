<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 4x6x7</Name>
        <Menu>Cubic\Cuboids\7\4x6x7</Menu>
        <Inventor>Claus Wenicker, Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6876</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9503</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        extra := 0.5;
        D := W / (7 + 2 * extra);
        WX := D * (4 + 2 * extra);
        WY := D * (6 + 2 * extra);
        WZ := D * (7 + 2 * extra);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*5;-D*3;-D; D; D*3; D*5" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
        <Hide  Axis = "1" Layers = "0;5" />
        <Hide  Axis = "2" Layers = "0;6" />
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(N)" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script> N := 7; </Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "Sc2" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
