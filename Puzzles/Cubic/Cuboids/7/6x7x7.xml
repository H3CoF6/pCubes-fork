<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 6x7x7</Name>
        <Menu>Cubic\Cuboids\7\6x7x7</Menu>
        <Inventor>Jaybert Christian Estrella, Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7756</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3065</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W / 9;

        WX := W;
        WY := W;
        WZ := W * 8/9;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-5*D;-3*D;-D; D; 3*D; 5*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-4*D;-2*D; 0; 2*D; 4*D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes />
        <RemoveGrayParts/>
    </Figure>
</xml>
