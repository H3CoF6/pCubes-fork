<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 4x4x7</Name>
        <Menu>Cubic\Cuboids\7\4x4x7</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2901</Link>
    </Interface>
 
    <Script>
        W := 0.55;
        D := W / 7;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*5;-D*3;-D; D; D*3; D*5" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D * 4" WY = "D * 4" WZ = "D * 7" />
        <SplitByAxes/>
        <RemoveContaining Vector = " 0; 0; D" />
        <RemoveContaining Vector = " 0; 0;-D" />
    </Figure>
</xml>
