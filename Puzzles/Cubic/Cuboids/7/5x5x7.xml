<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 5x5x7</Name>
        <Menu>Cubic\Cuboids\7\5x5x7</Menu>
        <Inventor>Ola Jansson</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-07-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2414</Link>
    </Interface>
 
    <Script>
        WZ := 0.55;
        WX := WZ * 5 / 7 * 1.001;
        WY := WX;
        D := WZ / 7;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-5*D; -3*D; -D; D; 3*D; 5*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
    </Figure>
</xml>
