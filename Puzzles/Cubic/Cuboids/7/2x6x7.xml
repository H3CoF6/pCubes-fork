<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x6x7</Name>
        <Menu>Cubic\Cuboids\7\2x6x7</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9500</Link>
    </Interface>

    <Script>
        W := 0.5;
        X := 6;
        Y := 7;
        Z := 2;
        Add := 1.2;

        N := Max(x, z);
        WD := W / (N / 2 + Add);
        for i := 0 to N - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);
        for i := 0 to Y - 2 do
            DY[i] := WD * i - WD * (Y / 2 - 1);

        WX := WD * (X / 2 + Add);
        WY := WD * (Y / 2 + Add);
        WZ := WD * (Z / 2 + Add);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "DY" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Macro Name = "Split" >
            <Split><Plane NormVector = "Cx[c];Cy[c];Cz[c]" NormDistance = "WD * (-L / 2 + i)" /></Split>
            <Script>Inc(i);</Script>
        </Macro>

        <ExecMacro MacroName = "Split" c = "1" L = "X" i = "1" Repeat = "X - 1" />
        <ExecMacro MacroName = "Split" c = "3" L = "Y" i = "1" Repeat = "Y - 1" />
        <ExecMacro MacroName = "Split" c = "5" L = "Z" i = "1" Repeat = "Z - 1" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(N)" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script> N := 7; </Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "Sc2" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
