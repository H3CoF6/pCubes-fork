<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x4 (center-shifted)</Name>
        <Menu>Cubic\Cuboids\Center-shifted\2x2x4 (center-shifted)</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-12-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7110</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        D := W / 4;
        H := D * 4;
        delta := 0.002;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3*D;-D; D; 3*D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D * 2" WY = "D * 2" WZ = "H + delta" DWZ = "D - delta" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
