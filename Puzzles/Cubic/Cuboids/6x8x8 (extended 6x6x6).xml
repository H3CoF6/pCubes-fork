<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>6x8x8 (extended 6x6x6)</Name>
        <Menu>Cubic\Cuboids\6x8x8 (extended 6x6x6)</Menu>
        <Inventor>Ilya Toporgilka</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-07-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11862</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W / 4;

        WX := W;
        WY := W;
        WZ := W * 3 / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2*D;-D; 0; D; 2*D " >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>

        <Split><Plane NormVector = "-1; 0; 0" NormDistance = " D * 3" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D * 3" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = " D * 3" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = " D * 3" /></Split>
        <RemoveGrayParts/>
    </Figure>
</xml>
