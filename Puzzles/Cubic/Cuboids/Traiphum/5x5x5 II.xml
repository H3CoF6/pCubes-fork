<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Traiphum 5x5x5 II</Name>
        <Menu>Cubic\Cuboids\Traiphum\5x5x5 II</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3202</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 10;

        WD := 2 * W / N;
        for i := 0 to N - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);

        WX := W * 4/5;
        WY := W * 4/5;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "7" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "7" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "8" />
        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "8" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "6" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "0" Layer = "Random(10)" Angle = "Pi" />
            <Turn Axis = "1" Layer = "Random(10)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(10)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(10)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
