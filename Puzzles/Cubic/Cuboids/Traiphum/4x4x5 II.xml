<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Traiphum 4x4x5 II</Name>
        <Menu>Cubic\Cuboids\Traiphum\4x4x5 II</Menu>
        <Inventor></Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-26</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 8;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <HideContaining Vector = " 0; 0;-W" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "7" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "7" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "7" />
        <RemoveGrayParts/>
        <ShowAll/>
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "5" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "2" Layer = "Random(8)" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "0" Layer = "Random(8)" Angle = "Pi" />
            <Turn Axis = "1" Layer = "Random(8)" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(8)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
