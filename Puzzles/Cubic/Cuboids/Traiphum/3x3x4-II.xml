<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Traiphum 3x3x4 II</Name>
        <Menu>Cubic\Cuboids\Traiphum\3x3x4 II</Menu>
        <Inventor>Vladimir Iaroslavski</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1791</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;

        WD := 2 * W / N;
        for i := 0 to N - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "5" />

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "5" />
        <RemoveGrayParts/>
        <ShowAll/>
        <Split Axis = "2" From = "3" />
    </Figure>
</xml>
