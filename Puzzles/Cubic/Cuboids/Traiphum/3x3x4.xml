<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Traiphum 3x3x4</Name>
        <Menu>Cubic\Cuboids\Traiphum\3x3x4</Menu>
        <Inventor>Vladimir Yaroslavskiy</Inventor>
        <Programmer>Andrea</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4424</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;

        WD := 2 * W / N;
        for i := 0 to N - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "5" />
        <RemoveGrayParts/>

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "1" />
        <RemoveGrayParts/>
        <ShowAll/>
        <Split Axis = "2" From = "3" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "2" Layer = "Random(N)" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(N)" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 6;</Script>
            <ExecMacro MacroName = "Sc1" Repeat = "6" />
            <ExecMacro MacroName = "Sc2" Repeat = "200" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
