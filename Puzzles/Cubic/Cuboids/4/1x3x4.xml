<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 1x3x4</Name>
        <Menu>Cubic\Cuboids\4\1x3x4</Menu>
        <Inventor> Ola Jansson</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1726</Link>
    </Interface>
 
    <Script>
        W := 0.6;
        D := W / 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "D*3" WZ = "D" />
        <SplitByAxes/>
    </Figure>
</xml>
