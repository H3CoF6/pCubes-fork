<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 1x2x4</Name>
        <Menu>Cubic\Cuboids\4\1x2x4</Menu>
        <Inventor>Tanner Frisby</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2361</Link>
    </Interface>
 
    <Script>
        W := 0.6;
        D := W / 2;
        H := W / 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "D" WZ = "H" />
        <SplitByAxes/>
    </Figure>
</xml>
