<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x4x4</Name>
        <Menu>Cubic\Cuboids\4\3x4x4</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=871</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W * 3 / 4" />
        <SplitByAxes/>
    </Figure>
</xml>
