<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x3x4</Name>
        <Menu>Cubic\Cuboids\4\3x3x4</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7113</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2362</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        D1 := W / 3;
        D2 := W * 2 / 3;

        WX := W;
        WY := W;
        WZ := W * 4 / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
