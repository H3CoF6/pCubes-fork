        <Macro Name = "exchange_edges2"   Public = "1" > <ExecMacro MacroName = "b' R2 f' R2 f R2 f' R2 f Rr2 b2 R2 f' R2 f R2 f' R2 f R2 b2 r2 b2 U r2 f2 r2 f2 U'" /> </Macro>
