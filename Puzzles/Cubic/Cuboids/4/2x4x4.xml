<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x4x4</Name>
        <Menu>Cubic\Cuboids\4\2x4x4</Menu>
        <Inventor>Hunter Palshook</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3612</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W / 2;

        WX := W;
        WY := W;
        WZ := W * 3 / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
    </Figure>

    <Macros>
        <Macro Name = "L"   > <Turn Axis = "0" Angle = " Pi / 2" Layer = "0" /> </Macro>
        <Macro Name = "L'"  > <Turn Axis = "0" Angle = "-Pi / 2" Layer = "0" /> </Macro>
