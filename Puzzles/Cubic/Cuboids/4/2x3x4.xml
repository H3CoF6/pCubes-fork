<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x3x4</Name>
        <Menu>Cubic\Cuboids\4\2x3x4</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1288</Link>
    </Interface>
 
    <Script>
        WX := 0.55;
        WY := WX / 4 * 3;
        WZ := WX / 2 + 0.001;
        D1 := WX / 2;
        D2 := WY / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; 0; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
    </Figure>
</xml>
