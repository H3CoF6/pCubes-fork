    <Interface>
        <Name>Caterpillar Cube</Name>
        <Menu>Cubic\Cuboids\Caterpillar Cube</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-04</Added>
        <Link>https://www.cubezz.com/Buy-6016-FanXin+3-color+Caterpillar+2x2x3+Magic+Cube+Puzzle.html</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        clGreen := '00EE00';
        W := 0.4;
        D := W / 2;

        WX := W;
        WY := W;
        WZ := W * 3 / 2;

        for i := 0 to 3 do
            Colors[i] := clGreen;
        Colors[4] := clYellow;
        Colors[5] := clWhite;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
