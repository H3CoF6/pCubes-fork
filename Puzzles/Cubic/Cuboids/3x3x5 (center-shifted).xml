<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x5 (center-shifted)</Name>
        <Menu>Cubic\Cuboids\Center-shifted\3x3x5 (center-shifted)</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7842</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5;
        dd := 0.001;

        WX := W / 5 * 3;
        WY := W / 5 * 3;
        WZ := W + dd;
        DWZ := -D;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-4*D; -2*D; 0; 2*D; 4*D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
