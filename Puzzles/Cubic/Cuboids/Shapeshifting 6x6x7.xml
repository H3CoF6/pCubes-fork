<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Shapeshifting 6x6x7</Name>
        <Menu>Cubic\Cuboids\Shapeshifting 6x6x7</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-07-12</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?t=37855</Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W / 10;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*5;-D*3;-D; 0; D; D*3; D*5" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D*8" WY = "D*8" WZ = "D*10" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "0" From = "7" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "1" From = "7" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "7" />

        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "2" Layer = "Random(8)" Angle = "Pi / 2" />
            <Turn Axis = "0" Layer = "Random(8)" Angle = "Pi" />
            <Turn Axis = "1" Layer = "Random(8)" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(8)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
