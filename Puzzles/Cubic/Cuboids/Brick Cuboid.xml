<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Brick Cuboid</Name>
        <Menu>Cubic\Cuboids\Brick Cuboid</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-03-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7823</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1">
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <SplitByAxes/>
        <Undo />
    </Figure>
</xml>
