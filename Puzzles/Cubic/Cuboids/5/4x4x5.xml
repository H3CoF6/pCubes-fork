<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 4x4x5</Name>
        <Menu>Cubic\Cuboids\5\4x4x5</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1433</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 5;

        WX := D * 4;
        WY := D * 5;
        WZ := D * 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
