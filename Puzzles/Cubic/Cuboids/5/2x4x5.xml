<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x4x5</Name>
        <Menu>Cubic\Cuboids\5\2x4x5</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5642</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W / 5;

        WX := D * 4;
        WY := W;
        WZ := D * 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D * 2; 0; D * 2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D * 3; -D; D; D * 3" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
