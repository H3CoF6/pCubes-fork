<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 4x5x5</Name>
        <Aliases>Giant 4x5x5</Aliases>
        <Menu>Cubic\Cuboids\5\4x5x5</Menu>
        <Inventor>Ilya Toporgilka</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9888</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5;

        WX := W;
        WY := W;
        WZ := D * 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
