<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x3x5</Name>
        <Menu>Cubic\Cuboids\5\3x3x5</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=702</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1129</Link>
    </Interface>
 
    <Script>
        W := 0.6;
        D := W / 5;

        WX := D * 3 * 1.001;
        WY := WX;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <RemoveGrayParts/>
    </Figure>
</xml>
