<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x3x5</Name>
        <Menu>Cubic\Cuboids\5\2x3x5</Menu>
        <Inventor>Chris Witham</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1966</Link>
    </Interface>

    <Script>
        W := 0.5;
        X := 5;
        Y := 3;
        Z := 2;
        Add := 0.05;

        N := Max(x, y);
        WD := W / (N / 2 + Add);
        for i := 0 to X - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);

        WX := WD * (X / 2 + Add);
        WY := WD * (Y / 2 + Add);
        WZ := WD * (Z / 2 + Add);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Macro Name = "Split" >
            <Split Axis = "ax" From = "i" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "0" i = "(X - X) div 2 + 1" Repeat = "X - 1" />
        <ExecMacro MacroName = "Split" ax = "1" i = "(X - Y) div 2 + 1" Repeat = "Y - 1" />
        <ExecMacro MacroName = "Split" ax = "2" i = "(Z - Z) div 2 + 1" Repeat = "Z - 1" />
    </Figure>
</xml>
