<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x4x5</Name>
        <Menu>Cubic\Cuboids\5\3x4x5</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-04-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2223</Link>
    </Interface>
 
    <Script>
        WX := 0.55;
        WY := WX / 5 * 4;
        WZ := WX / 5 * 3 + 0.001;
        D1 := WX / 5;
        D2 := WX * 3 / 5;
        D3 := WY / 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; 0; D3" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <RemoveContaining Vector = "0;0;0" />
    </Figure>
    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(4)" Angle = "Pi" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(4)" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script> N := 5; </Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "Sc2" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
