<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 1x4x5</Name>
        <Menu>Cubic\Cuboids\5\1x4x5</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3611</Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W / 5;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*3;-D*1; D*1; D*3" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "D*4" WZ = "D" />
        <SplitByAxes/>
    </Figure>
</xml>
