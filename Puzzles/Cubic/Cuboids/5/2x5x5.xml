<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x5x5</Name>
        <Menu>Cubic\Cuboids\5\2x5x5</Menu>
        <Inventor>Ola Jansson, Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-06-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1988</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3568</Link>
    </Interface>

    <Script>
        W := 0.5;
        X := 5;
        Y := 5;
        Z := 2;
        Add := 1;

        WD := W / (Y / 2 + Add);
        for i := 0 to Y - 2 do
            D[i] := WD * i - WD * (Y / 2 - 1);

        WX := WD * (X / 2 + Add);
        WY := WD * (Y / 2 + Add);
        WZ := WD * (Z / 2 + Add);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
