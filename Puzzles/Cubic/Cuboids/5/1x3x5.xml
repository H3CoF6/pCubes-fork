<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 1x3x5</Name>
        <Menu>Cubic\Cuboids\5\1x3x5</Menu>
        <Inventor>Mark Segedin, Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2305</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2790</Link>
    </Interface>

    <Script>
        WX := 0.6;
        WY := WX / 5 * 3;
        WZ := WX * 0.3;

        D := WX / 5;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D * 3;-D; D; D * 3" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
