<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x4 AI Cube</Name>
        <Menu>Cubic\Cuboids\3x3x4 AI Cube</Menu>
        <Inventor>Alberto Quevedo</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-12-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9476</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        D1 := W / 3;
        D2 := W * 2 / 3;

        WX := W;
        WY := W;
        WZ := W * 4 / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; 0; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "0" From = "2" />
        <Hide Axis = "0" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" />
        <ShowAll/>
        <HideContaining Vector = " WX; WY; WZ" />
        <HideContaining Vector = "-WX;-WY; WZ" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>
</xml>
