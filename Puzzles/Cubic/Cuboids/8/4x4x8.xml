<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 4x4x8</Name>
        <Menu>Cubic\Cuboids\8\4x4x8</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-07-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3060</Link>
    </Interface>
 
    <Script>
        W := 0.6;

        X := 4;
        Y := 4;
        Z := 8;
        Oversize := 0;

        include 'Puzzles\Cubic\Cuboids\Cuboid Calculation.inc';
    </Script>

    <Axes>
        <Axis TurningAngles = "Ax" NormVector = " 1; 0; 0" PlaneDistances = "DX" />
        <Axis TurningAngles = "Ay" NormVector = " 0; 1; 0" PlaneDistances = "DY" />
        <Axis TurningAngles = "Az" NormVector = " 0; 0; 1" PlaneDistances = "DZ" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Macro Name = "Split" >
            <Split><Plane NormVector = "Cx[c];Cy[c];Cz[c]" NormDistance = "WD * (-L + 2*i)" /></Split>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" c = "1" L = "X" i = "1" Repeat = "X - 1" />
        <ExecMacro MacroName = "Split" c = "3" L = "Y" i = "1" Repeat = "Y - 1" />
        <ExecMacro MacroName = "Split" c = "5" L = "Z" i = "1" Repeat = "Z - 1" />
        <HideAll/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "WD*4" WY = "W" WZ = "WD*4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "WD*4" WZ = "WD*4" />
        <Split Axis = "0" From = "Z / 2 - 1" />
        <Split Axis = "0" From = "Z / 2    " />
        <Split Axis = "0" From = "Z / 2 + 1" />
        <Split Axis = "1" From = "Z / 2 - 1" />
        <Split Axis = "1" From = "Z / 2    " />
        <Split Axis = "1" From = "Z / 2 + 1" />
        <Split Axis = "2" From = "Z / 2 - 1" />
        <Split Axis = "2" From = "Z / 2    " />
        <Split Axis = "2" From = "Z / 2 + 1" />
        <InvertVisibility/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(X)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(Z)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(2)" Layer = "Random(X)" Angle = "2*Pi * Random" />
            <Turn Axis = "2" Layer = "Random(Z)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>X := 4; Z := 8; </Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
