<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Eccentric Cube 4+2</Name>
        <Menu>Cubic\Cuboids\Eccentric Cube 4+2</Menu>
        <Inventor>Taras Bereznyak</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-12-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11774</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D1 := W * 0.22;
        D2 := W * 2 / 3 - D1;

        DW := D1 - W / 3;

        WX := W;
        WY := W;
        WZ := W+DW;
        DWX := DW;
        DWY := DW;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <RemoveGrayParts/>

        <HideContaining Vectors = "Cx;Cy;Cz" />
        <InvertVisibility/>

        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>
</xml>
