<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 1x5x6</Name>
        <Menu>Cubic\Cuboids\6\1x5x6</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3693</Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W / 6;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*4; -D*2; 0; D*2; D*4" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D*3;-D*1; D*1; D*3" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "D*5" WZ = "D" />
        <SplitByAxes/>
    </Figure>
</xml>
