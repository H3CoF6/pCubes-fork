<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x3x6</Name>
        <Menu>Cubic\Cuboids\6\2x3x6</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2696</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        extra := 0*1.1;
        D := W / (6 + 2 * extra);

        WX := D * (3 + 2 * extra);
        WY := D * (2 + 2 * extra);
        WZ := D * (6 + 2 * extra);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Macro Name = "Split" >
            <Split Axis = "0" From = "1" />
            <Split Axis = "0" From = "2" />
            <Split Axis = "1" From = "3" />
            <Split Axis = "2" From = "1" />
            <Split Axis = "2" From = "2" />
            <Split Axis = "2" From = "3" />
            <Split Axis = "2" From = "4" />
            <Split Axis = "2" From = "5" />
        </Macro>

        <LoadFrom File = "Figures\Cuboid.xml" />
        <ExecMacro MacroName = "Split" />

        <HideAll/>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <ExecMacro MacroName = "Split" />
        <InvertVisibility/>
    </Figure>
</xml>
