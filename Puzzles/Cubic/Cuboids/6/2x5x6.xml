<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x5x6</Name>
        <Menu>Cubic\Cuboids\6\2x5x6</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6873</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12269</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        extra := 1.1;
        D := W / (6 + 2 * extra);

        WX := D * (5 + 2 * extra);
        WY := D * (2 + 2 * extra);
        WZ := D * (6 + 2 * extra);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <S1plitByAxes/>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
    </Figure>
</xml>
