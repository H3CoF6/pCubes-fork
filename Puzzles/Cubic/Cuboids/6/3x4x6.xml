<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x4x6</Name>
        <Menu>Cubic\Cuboids\6\3x4x6</Menu>
        <Inventor>Grégoire Pfennig, Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3243</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9683</Link>
    </Interface>
 
    <Script>
        W := 0.55;
        D := W / 6;

        WX := D * 4 + 0.001;
        WY := D * 6;
        WZ := D * 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4;" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(3)" Angle = "Pi" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(3)" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script> N := 6; </Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "Sc2" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
