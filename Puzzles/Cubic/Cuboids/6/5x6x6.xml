<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 5x6x6</Name>
        <Menu>Cubic\Cuboids\6\5x6x6</Menu>
        <Inventor>Ilya Toporgilka</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5441</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 6;

        WX := W;
        WY := W;
        WZ := D * 5;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
