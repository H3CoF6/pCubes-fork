<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x3x6</Name>
        <Menu>Cubic\Cuboids\6\3x3x6</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1880</Link>
    </Interface>
 
    <Script>
        W := 0.6;
        D := W / 6;

        WX := W / 2;
        WY := W / 2;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*4;-D*2; 0; D*2; D*4" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
