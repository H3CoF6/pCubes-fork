<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 5x5x6</Name>
        <Menu>Cubic\Cuboids\6\5x5x6</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-04-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1813</Link>
    </Interface>
 
    <Script>
        W := 0.45;

        WX := W;
        WY := W;
        WZ := W * 6 / 5;

        D1 := W / 5;
        D3 := D1 * 3;
        D2 := D1 * 2;
        D4 := D1 * 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D3;-D1; D1; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D4;-D2; 0; D2; D4" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
