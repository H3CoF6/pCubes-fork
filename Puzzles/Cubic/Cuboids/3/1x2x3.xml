<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 1x2x3</Name>
        <Menu>Cubic\Cuboids\3\1x2x3</Menu>
        <Inventor>Javier Sanz</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1905</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W * 3 / 2" WY = "W" WZ = "D" />
        <SplitByAxes/>
    </Figure>
</xml>
