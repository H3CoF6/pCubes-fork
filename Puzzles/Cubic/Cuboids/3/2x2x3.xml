<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x2x3</Name>
        <Menu>Cubic\Cuboids\3\2x2x3</Menu>
        <Inventor>Katsuhiko Okamoto</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-12-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=24</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        WX := W;
        WY := W;
        WZ := W * 3 / 2;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
