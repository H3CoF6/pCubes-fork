<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half-Turn Domino</Name>
        <Menu>Cubic\Cuboids\Half-Turn Domino</Menu>
        <Inventor>Ryan Beam</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-12-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5719</Link>
    </Interface>
 
    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        H := W * 2 / 3;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />
        <SplitByAxes/>
    </Figure>
</xml>
