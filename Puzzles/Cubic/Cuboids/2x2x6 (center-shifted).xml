<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x6 (center-shifted)</Name>
        <Menu>Cubic\Cuboids\Center-shifted\2x2x6 (center-shifted)</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-12-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7112</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        H := 0.5;
        N := 7;
        WD := 2 * H / N;
        D[0] := -H + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WX := WD;
        WY := WX;
        WZ := WD * 3 * 1.001;
        DWZ := WD / 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />

        <Macro Name = "Split" >
            <Split Axis = "2" From = "i" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" i = "2" Repeat = "N - 2" />
    </Figure>
</xml>
