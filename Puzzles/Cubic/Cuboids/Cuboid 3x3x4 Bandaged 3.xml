<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 3x3x4 Bandaged 3</Name>
        <Menu>Cubic\Cuboids\Cuboid 3x3x4 Bandaged 3</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9315</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        D := W * 2 / 3;

        WX := W;
        WY := W;
        WZ := W * 4 / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D/2; D/2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "3" />
        <HideContaining Vector = " WX; WY; WZ" />
        <HideContaining Vector = "-WX;-WY; WZ" />
        <HideContaining Vector = " WX;-WY;-WZ" />
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
