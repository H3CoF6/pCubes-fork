<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 6x6x6 (Mimic)</Name>
        <Menu>Cubic\Camouflage\6x6x6</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-07-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6798</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W;

        D := W * 2 / 7;
        DWX := -D / 2;
        DWY := -D / 2;
        DWZ :=  D / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2 * D; -D; 0; D; 2 * D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "5" />

        <HideContaining Vector = " D; 0; 0" />
        <HideContaining Vector = " 0; D; 0" />
        <HideContaining Vector = " 0; 0;-D" />
        <InvertVisibility/>
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>
        <RemoveGrayParts/>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
