<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mirror Camouflage 2x4x4</Name>
        <Menu>Cubic\Camouflage\Mirror Camouflage 2x4x4</Menu>
        <Inventor>Xu Hai Kun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10197</Link>
    </Interface>

    <Script>
        Color := 'AAAAAA'; // Silver
        for i := 0 to 5 do
            Colors[i] := Color;

        W := 0.4;
        D := W / 2;

        DX := W * 0.15;
        DY := W * 0.2;
        DZ := W * 0.1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = " DX; DY; DZ" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W * 1.5" WY = "W * 1.5" WZ = "W" />
        <Transfer Vector = "-DX;-DY;-DZ" />

        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "3" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "1" From  = "3" />
        <Split Axis = "2" From  = "2" />

        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
