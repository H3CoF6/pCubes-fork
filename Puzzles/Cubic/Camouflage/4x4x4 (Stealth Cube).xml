<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 4x4x4 (Stealth Cube)</Name>
        <Menu>Cubic\Camouflage\4x4x4 (Stealth Cube)</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-06-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4959</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W;

        D := W / 6;
        DWX := -W / 6;
        DWY := -W / 6;
        DWZ := -W / 6;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3*D; -D; D; 3*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <HideContaining Vector = " D;-D;-D" />
        <HideContaining Vector = "-D; D;-D" />
        <HideContaining Vector = "-D;-D; D" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
