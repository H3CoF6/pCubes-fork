<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>5x6x7 Floppy I-Cube Extreme</Name>
        <Menu>Cubic\Camouflage\5x6x7 Floppy I-Cube Extreme</Menu>
        <Inventor>Liapis Nikolaos</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-10-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4721</Link>
    </Interface>
 
    <Script>
        W := 0.5;

        N := 7;

        WD := W / 9;
        for i := 0 to N - 2 do
            D[i] := 2 * WD * i - WD * (N - 2);

        WX := WD * 7;
        WY := WD * 7;
        WZ := WD * 8;
        DWX :=-WD * 1;
        DWY :=-WD * 1;
        DWZ := WD * 0;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <ShowAll/>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
    </Figure>
</xml>
