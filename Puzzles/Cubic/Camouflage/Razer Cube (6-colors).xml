<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Razer Cube (6-colors)</Name>
        <Menu>Cubic\Camouflage\Razer Cube (6-colors)</Menu>
        <Inventor>Daniel Waxtonz</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9349</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W;
        D := W / 5 * 2;
        DWX := D / 2;
        DWY :=-D / 2;
        DWZ := D / 2;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <Hide Axis = "0" Layers = "3" />
        <Hide Axis = "1" Layers = "0" />
        <Hide Axis = "2" Layers = "3" />
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>

        <Turn NormVector = "-1;0;1" Angle = "Pi" />
    </Figure>
</xml>
