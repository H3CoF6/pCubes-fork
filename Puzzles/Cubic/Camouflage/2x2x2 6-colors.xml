<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 2x2x2 6-colors</Name>
        <Menu>Cubic\Camouflage\2x2x2 6-colors</Menu>
        <Inventor>Unassigned</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-10</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W;

        D := W / 4;
        DWX := -W/4;
        DWY :=  W/4;
        DWZ := -W/4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From  = "1" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "2" From  = "1" />

        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>

        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
