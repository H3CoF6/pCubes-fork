<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 4x4x2</Name>
        <Menu>Cubic\Camouflage\4x4x2</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3850</Link>
    </Interface>

    <Script>
        W := 0.35;
        WX := W * 1.5;
        WY := W * 1.5;
        WZ := W;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />

        <HideContaining Vector = " 0; 0; D" />
        <HideContaining Vector = " 0; 0;-D" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
