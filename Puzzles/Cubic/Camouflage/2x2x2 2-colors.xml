<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 2x2x2 2-colors</Name>
        <Aliases>Corner Pocket</Aliases>
        <Menu>Cubic\Camouflage\2x2x2 2-colors</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4482</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clYellow := 'FFFF00';

        W := 0.5;
        W1 := W * 3 / 4;
        W2 := W * 5 / 4;

        D := W / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W2" Color = "clRed" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />

        <HideContaining Vector = " 0; 0; 0" />

        <Cut Color = "clRed" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clRed" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clRed" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W1" /> </Cut>

        <InvertVisibility/>

        <Cut Color = "clYellow" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W1" /> </Cut>

        <SplitByAxes />
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
