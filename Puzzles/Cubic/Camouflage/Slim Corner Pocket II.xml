<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Slim Corner Pocket II</Name>
        <Menu>Cubic\Camouflage\Slim Corner Pocket II</Menu>
        <Inventor>Cube Plus</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11671</Link>
    </Interface>

    <Script>
        clViolett := '800080';
        clBlue    := '0000C8';
        clYellow  := 'FFFF00';
        clGreen   := '009600';

        W := 0.5;
        W1 := W * 3 / 4;
        W2 := W * 5 / 4;
        W3 := W * 7 / 4;

        D := W / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W3" Color = "clViolett" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />

        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = " 0; 0;-W1" />
        <InvertVisibility/>

        <Cut Color = "clViolett" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clViolett" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clViolett" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clViolett" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clViolett" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W2" /> </Cut>
        <Cut Color = "clViolett" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W1" /> </Cut>

        <InvertVisibility/>

        <Cut Color = "clBlue  " > <Plane NormVector = "-1; 0; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W1" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W2" /> </Cut>
        <SplitByAxes/>

        <ShowAll/>

        <Split Axis = "2" From = "2" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
