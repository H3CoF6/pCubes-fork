<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x4x5 Stealth</Name>
        <Menu>Cubic\Camouflage\3x4x5 Stealth</Menu>
        <Inventor>Mohammad Badir</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-07-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6553</Link>
    </Interface>

    <Script>
        W := 0.5;
        X := 5;
        Y := 3;
        Z := 4;
        Add := 1.0;

        N := 5;
        WD := W / (N / 2 + Add);
        for i := 0 to N - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);

        WX := WD * (X / 2 + Add);
        WY := WD * (Y / 2 + Add);
        WZ := WD * (Z / 2 + Add);

        DX := WD * 0;
        DY := WD * 0;
        DZ := WD * 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Macro Name = "Split" >
            <Split><Plane NormVector = "Cx[c];Cy[c];Cz[c]" NormDistance = "WD * (-L / 2 + i)" /></Split>
            <Script>Inc(i);</Script>
        </Macro>

        <ExecMacro MacroName = "Split" c = "0" i = "1" L = "X" />
        <ExecMacro MacroName = "Split" c = "1" i = "1" L = "X" />
        <ExecMacro MacroName = "Split" c = "2" i = "1" L = "Y" />
        <ExecMacro MacroName = "Split" c = "3" i = "1" L = "Y" />
        <ExecMacro MacroName = "Split" c = "4" i = "1" L = "Z" />
        <ExecMacro MacroName = "Split" c = "5" i = "1" L = "Z" />
        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />
        <ExecMacro MacroName = "Split" c = "0" i = "1" L = "N" />
        <ExecMacro MacroName = "Split" c = "1" i = "1" L = "N" />
        <ExecMacro MacroName = "Split" c = "2" i = "1" L = "N" />
        <ExecMacro MacroName = "Split" c = "3" i = "1" L = "N" />
        <RemoveGrayParts/>
        <ShowAll/>

        <ExecMacro MacroName = "Split" c = "1" L = "X" i = "2" Repeat = "X - 3" />
        <ExecMacro MacroName = "Split" c = "3" L = "Y" i = "2" Repeat = "Y - 3" />
        <ExecMacro MacroName = "Split" c = "5" L = "Z" i = "2" Repeat = "Z - 3" />
        <Transfer Vector = " DX; DY; DZ" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 5;</Script>
            <ExecMacro MacroName = "RandomTurns" Repeat = "2000" />
        </Macro>
    </Macros>
</xml>
