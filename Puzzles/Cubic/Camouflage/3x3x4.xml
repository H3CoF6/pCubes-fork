<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 3x3x4</Name>
        <Menu>Cubic\Camouflage\3x3x4</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3852</Link>
    </Interface>

    <Script>
        W := 0.45;
        WX := W;
        WY := W;
        WZ := W * 6 / 5;

        D := W * 2 / 5;
        DWX := W / 5;
        DWY := W / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <HideContaining Vector = " D/2;-D  ; 0" />
        <HideContaining Vector = "-D  ; D/2; 0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
