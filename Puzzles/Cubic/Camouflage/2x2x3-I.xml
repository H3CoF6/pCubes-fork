<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Camouflage 2x2x3-I</Name>
        <Menu>Cubic\Camouflage\2x2x3-I</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-06-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3846</Link>
    </Interface>

    <Script>
        W := 0.45;
        WX := W;
        WY := W;
        WZ := W * 5/4;

        D := W / 2;
        DWZ := W / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
    </Figure>

</xml>
