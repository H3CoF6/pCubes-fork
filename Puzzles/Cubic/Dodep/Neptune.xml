<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodep - Neptune</Name>
        <Menu>Cubic\Dodep\Neptune</Menu>
        <Class>TDodep</Class>
        <Inventor>Carl N. Hoff</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4775</Link>
    </Interface>
 
    <Script>
        W := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3/10; -1/10; 1/10; 3/10" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Stick1" File = "Puzzles\Cubic\Dodep\Stick1.vec" />
        <Texture Name = "Stick2" File = "Puzzles\Cubic\Dodep\Stick2.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Stick1 = 49,0,1, 43,0,1, 12,0,1
        Stick2 = 85,0,1, 54,0,1, 48,0,1
    </SetTextures>

</xml>
