<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Uniaxial Mercury</Name>
        <Menu>Cubic\Dodep\Uniaxial Mercury</Menu>
        <Inventor>Carl N. Hoff</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3297</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3*D; 3*D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 3*D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = "0; 0; 0" />
        

        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = " D" /></Split>
        <ShowAll/>
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-3*D" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "   D" /></Split>
        <RemoveGrayParts/>
    </Figure>
</xml>
