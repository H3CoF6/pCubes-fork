<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Shepherd 2x2x2</Name>
        <Menu>Cubic\Classic Rubiks\Shepherd 2x2x2</Menu>
        <Inventor>Alistair Shepherd</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2406</Link>
    </Interface>

    <Script>
        W := 0.5;
        da := 0.001;

        Color := 'FFFFFF';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "Color" />

        <Cut Color = "Color"> <Plane NormVector = " 1;-da;  0" NormDistance = "-W" />  </Cut>
        <Cut Color = "Color"> <Plane NormVector = "-1; da;  0" NormDistance = "-W" />  </Cut>
        <Cut Color = "Color"> <Plane NormVector = " 0;  1;-da" NormDistance = "-W" />  </Cut>
        <Cut Color = "Color"> <Plane NormVector = " 0; -1; da" NormDistance = "-W" />  </Cut>
        <Cut Color = "Color"> <Plane NormVector = " da; 0;  1" NormDistance = "-W" />  </Cut>
        <Cut Color = "Color"> <Plane NormVector = "-da; 0; -1" NormDistance = "-W" />  </Cut>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "Arrow" File = "Textures\Arrow.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->

        Arrow = 1,1,1, 5,1,1, 0,1,3, 4,1,2
        Arrow = 3,2,3, 7,2,0, 1,2,2, 5,2,1
        Arrow = 5,0,2, 7,0,2, 4,0,0, 6,0,3
        Arrow = 3,0,2, 1,0,2, 2,0,0, 0,0,3
        Arrow = 7,1,3, 3,1,3, 6,1,1, 2,1,0
        Arrow = 0,2,1, 4,2,2, 2,2,0, 6,2,3
    </SetTextures>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
