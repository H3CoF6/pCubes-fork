<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Simple Overlapping Cube</Name>
        <Menu>Cubic\3x3x3 variants\Super Simple Overlapping Cube</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2352</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        dz := 0.97;
        D := W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddUltimateCube">
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />
                <Vertices Vectors = "Cx; Cy; Cz" />

                <Faces>
                    <Face Color = "Colors[2]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                    <Face Color = "Colors[4]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                    <Face Color = "Colors[3]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                    <Face Color = "Colors[5]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />

                    <Face Color = "Colors[3]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                    <Face Color = "Colors[4]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                    <Face Color = "Colors[2]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                    <Face Color = "Colors[5]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />

                    <Face Color = "Colors[2]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
                    <Face Color = "Colors[1]" VertexIndexes = "0;4;10" InvisibleEdges = "6" />
                    <Face Color = "Colors[3]" VertexIndexes = "4;5;10" InvisibleEdges = "6" />
                    <Face Color = "Colors[0]" VertexIndexes = "5;1;10" InvisibleEdges = "6" />

                    <Face Color = "Colors[3]" VertexIndexes = "2;3;11" InvisibleEdges = "6" />
                    <Face Color = "Colors[1]" VertexIndexes = "3;7;11" InvisibleEdges = "6" />
                    <Face Color = "Colors[2]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                    <Face Color = "Colors[0]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />

                    <Face Color = "Colors[5]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                    <Face Color = "Colors[0]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
                    <Face Color = "Colors[4]" VertexIndexes = "6;4;12" InvisibleEdges = "6" />
                    <Face Color = "Colors[1]" VertexIndexes = "4;0;12" InvisibleEdges = "6" />

                    <Face Color = "Colors[4]" VertexIndexes = "3;1;13" InvisibleEdges = "6" />
                    <Face Color = "Colors[0]" VertexIndexes = "1;5;13" InvisibleEdges = "6" />
                    <Face Color = "Colors[5]" VertexIndexes = "5;7;13" InvisibleEdges = "6" />
                    <Face Color = "Colors[1]" VertexIndexes = "7;3;13" InvisibleEdges = "6" />
                </Faces>
            </Part>
        </Macro>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <SplitByAxes/>
        <HideContaining Vector = "Ex; Ey; Ez" />
        <RemoveAllVisible/>


        <ExecMacro MacroName = "AddUltimateCube"/>
        <SplitByAxes/>
        <HideContaining Vector = "Vx; Vy; Vz" />
        <RemoveAllVisible/>

        <Script>
            W := W * dz;
            include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>
        <ExecMacro MacroName = "AddUltimateCube"/>
        <SplitByAxes/>
        <HideContaining Vector = "Cx; Cy; Cz" />
        <RemoveAllVisible/>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
