<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>One Plane Bumped Cube</Name>
        <Menu>Cubic\3x3x3 variants\One Plane Bumped Cube</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2542</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;
        DWZ := W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
