<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Floppy 2x3x3</Name>
        <Menu>Cubic\3x3x3 variants\Floppy 2x3x3</Menu>
        <Inventor>Oskar Van Deventer</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-05-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2994</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
    </Script>

    <Axes PlaneDistances = " -1/6; 1/6" TurningAngles = "Pi / 2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Color = "clYellow" Axis = "2" From = "1" />

        <Split Axis = "0" From = "1" Color1 =    "clRed" Color2 = "clOrange" />
        <Split Axis = "0" From = "2" Color1 =    "clRed" Color2 = "clOrange" />
        <Split Axis = "1" From = "1" Color1 =   "clBlue" Color2 =  "clGreen" />
        <Split Axis = "1" From = "2" Color1 =   "clBlue" Color2 =  "clGreen" />
        <Split Axis = "2" From = "2" Color1 = "clYellow" Color2 =  "clWhite" />
    </Figure>
</xml>
