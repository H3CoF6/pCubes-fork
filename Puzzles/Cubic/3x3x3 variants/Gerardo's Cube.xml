<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gerardo's Cube</Name>
        <Menu>Cubic\3x3x3 variants\Gerardo's Cube</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2507</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" K = "W * 0.65" Color = "222222" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <RemoveAllVisible/>
        <ShowAll/>
        <RemoveContaining Vector = "-D; 0; 0" />
        <RemoveContaining Vector = " D; 0; 0" />
        <RemoveContaining Vector = " 0;-D; 0" />
        <RemoveContaining Vector = " 0; D; 0" />
        <RemoveContaining Vector = " 0; 0;-D" />
        <RemoveContaining Vector = " 0; 0; D" />

        <LoadFrom File = "Figures\Cube.xml" />
        <Split Color1 = "clRed   " Color2 = "clOrange" Axis = "0" From = "1" />
        <Split Color1 = "clRed   " Color2 = "clOrange" Axis = "0" From = "2" />
        <Split Color1 = "clBlue  " Color2 = "clGreen " Axis = "1" From = "1" />
        <Split Color1 = "clBlue  " Color2 = "clGreen " Axis = "1" From = "2" />
        <Split Color1 = "clYellow" Color2 = "clWhite " Axis = "2" From = "1" />
        <Split Color1 = "clYellow" Color2 = "clWhite " Axis = "2" From = "2" />
        <RemoveContaining Vector = " 0; 0; 0" />
        <RemoveContaining Vector = " 0;-W; W" />
        <RemoveContaining Vector = " 0;-W;-W" />
        <RemoveContaining Vector = " 0; W;-W" />
        <RemoveContaining Vector = " 0; W; W" />
        <RemoveContaining Vector = " W; 0;-W" />
        <RemoveContaining Vector = "-W; 0;-W" />
        <RemoveContaining Vector = "-W; 0; W" />
        <RemoveContaining Vector = " W; 0; W" />
        <RemoveContaining Vector = "-W; W; 0" />
        <RemoveContaining Vector = "-W;-W; 0" />
        <RemoveContaining Vector = " W;-W; 0" />
        <RemoveContaining Vector = " W; W; 0" />
        <ShowAll/>
    </Figure>
</xml>
