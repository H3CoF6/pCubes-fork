<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Four Sided Extended 3x3x3</Name>
        <Menu>Cubic\3x3x3 variants\Four Sided Extended 3x3x3</Menu>
        <Inventor>Jean-Claude Constantin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-01-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4464</Link>
    </Interface>

    <Script>
        W  := 0.7;
        W1 := W * 3 / 5;
        D  := W / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W1" WY = "W1" WZ = "W1" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <RemoveContaining Vector = "0;0;0" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <RemoveContaining Vector = "W1;0;0" />
        <RemoveContaining Vector = "-W1;0;0" />
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "D" WY = "W" WZ = "W1" />
        <Split><Plane NormVector = "0;1;0" NormDistance = "-W1" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = "W1" /></Split>
        <RemoveContaining Vector = "0;0;0" />
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "D" WZ = "W1" />
        <Split><Plane NormVector = "1;0;0" NormDistance = "-W1" /></Split>
        <Split><Plane NormVector = "1;0;0" NormDistance = "W1" /></Split>
        <RemoveContaining Vector = "0;0;0" />
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W1" />
        <Cut><Plane NormVector = "-1; 0; 0" NormDistance = "-W1" /></Cut>
        <Cut><Plane NormVector = " 1; 0; 0" NormDistance = "-W1" /></Cut>
        <Cut><Plane NormVector = " 0;-1; 0" NormDistance = "-W1" /></Cut>
        <Cut><Plane NormVector = " 0; 1; 0" NormDistance = "-W1" /></Cut>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <RemoveContaining Vector = "-W1; W1; 0" />
        <RemoveContaining Vector = "-W1;-W1; 0" />
        <RemoveContaining Vector = " W1;-W1; 0" />
        <RemoveContaining Vector = " W1; W1; 0" />
        <ShowAll/>

        <SplitByAxes/>
   </Figure>
</xml>
