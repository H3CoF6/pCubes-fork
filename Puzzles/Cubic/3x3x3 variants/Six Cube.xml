<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Six Cube</Name>
        <Menu>Cubic\3x3x3 variants\Six Cube</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4293</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.6;
        C[0] := -W;
        C[1] := -W * 2/3;
        C[2] := -W * 1/3;
        C[3] :=  0;
        C[4] :=  W * 1/3;
        C[5] :=  W * 2/3;
        C[6] :=  W;
        D := W / 3;

        WX := W / 3;
        WY := WX;
        WZ := WX / 2;

        procedure SetColors();
        begin
            for i := 0 to 5 do
                Colors[i] := Color;
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddColor">
            <Script>SetColors();</Script>
            <Script> DWX := 2 * WX; DWZ := 3 * WZ; </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Script> DWX := 2 * WX; DWZ := 1 * WZ; </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Script> DWX :=-2 * WX; DWZ := 3 * WZ; </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Script> DWX :=-2 * WX; DWZ := 1 * WZ; </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Turn NormVector = "1;0;0" Angle = "Pi"/>
        </Macro>
        <ExecMacro MacroName = "AddColor" Color = "clRed" />
        <ExecMacro MacroName = "AddColor" Color = "clOrange" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3"/>
        <ExecMacro MacroName = "AddColor" Color = "clBlue" />
        <ExecMacro MacroName = "AddColor" Color = "clGreen" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3"/>
        <ExecMacro MacroName = "AddColor" Color = "clYellow" />
        <ExecMacro MacroName = "AddColor" Color = "clWhite" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3"/>

        <SaveSolvedState/> <!-- first solved state -->

        <Turn Axis = "2" From = "0" To = "2" Angle = "Pi / 2" />
        <SaveSolvedState/> <!-- second solved state -->
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
