<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rubik's 5x3 Cube</Name>
        <Menu>Cubic\3x3x3 variants\Rubik's 5x3 Cube</Menu>
        <Inventor>Duane Cash</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1280</Link>
    </Interface>
 
    <Script>
        W := 0.4;
        D := W / 3;

        WX := 5 * D;
        WY := W;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "D*3" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "D*3" /></Split>
        <SplitByAxes/>
    </Figure>
</xml>
