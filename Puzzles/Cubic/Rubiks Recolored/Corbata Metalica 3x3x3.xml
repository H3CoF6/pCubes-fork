<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corbata Metalica 3x3x3</Name>
        <Menu>Cubic\Rubiks Recolored\Corbata Metalica 3x3x3</Menu>
        <Inventor>Antonio Rodriguez Perez</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-09-17</Added>
        <Link></Link>
    </Interface>

    <Script>
        clRed   := 'C80000';
        clWhite := 'FFFFFF';
        clGol   := 'BF8040';
        clGreen := '005600';
        clBlue  := '000078';
        clLav   := '8661C6';
        
        W := 0.5;
        D := W / 3;

        Vx[ 0] := -W; Vy[ 0] := -W; Vz[ 0] := -W;
        Vx[ 1] := -W; Vy[ 1] := -W; Vz[ 1] :=  W;
        Vx[ 2] := -W; Vy[ 2] :=  W; Vz[ 2] := -W;
        Vx[ 3] := -W; Vy[ 3] :=  W; Vz[ 3] :=  W;
        Vx[ 4] :=  W; Vy[ 4] := -W; Vz[ 4] := -W;
        Vx[ 5] :=  W; Vy[ 5] := -W; Vz[ 5] :=  W;
        Vx[ 6] :=  W; Vy[ 6] :=  W; Vz[ 6] := -W;
        Vx[ 7] :=  W; Vy[ 7] :=  W; Vz[ 7] :=  W;
        
        Ax[ 0] :=  W; Ay[ 0] :=  D; Az[ 0] := -D;
        Ax[ 1] :=  W; Ay[ 1] := -D; Az[ 1] := -D;
        
        Ax[ 2] := -W; Ay[ 2] :=  D; Az[ 2] :=  D;
        Ax[ 3] := -W; Ay[ 3] := -D; Az[ 3] :=  D;
        
        Ax[ 4] :=  D; Ay[ 4] :=  W; Az[ 4] :=  D;
        Ax[ 5] :=  D; Ay[ 5] :=  W; Az[ 5] := -D;
        
        Ax[ 6] := -D; Ay[ 6] := -W; Az[ 6] :=  D;
        Ax[ 7] := -D; Ay[ 7] := -W; Az[ 7] := -D;
        
        Ax[ 8] :=  D; Ay[ 8] :=  D; Az[ 8] :=  W;
        Ax[ 9] := -D; Ay[ 9] :=  D; Az[ 9] :=  W;
        
        Ax[10] :=  D; Ay[10] := -D; Az[10] := -W;
        Ax[11] := -D; Ay[11] := -D; Az[11] := -W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ax; Ay; Az" />

            <Faces>
                <Face Color = "clRed  " VertexIndexes = " 9; 8; 7; 5" InvisibleEdges = "11" />
                <Face Color = "clRed  " VertexIndexes = " 8; 9; 4; 6" InvisibleEdges = "11" />
                <Face Color = "clRed  " VertexIndexes = " 5; 7;16"    InvisibleEdges = "6 " />
                <Face Color = "clRed  " VertexIndexes = " 6; 4;18"    InvisibleEdges = "6 " />
                
                <Face Color = "clLav  " VertexIndexes = "11;10; 2; 0" InvisibleEdges = "11" />
                <Face Color = "clLav  " VertexIndexes = "10;11; 1; 3" InvisibleEdges = "11" />
                <Face Color = "clLav  " VertexIndexes = " 3; 1;17"    InvisibleEdges = "6 " />
                <Face Color = "clLav  " VertexIndexes = " 0; 2;19"    InvisibleEdges = "6 " />
                
                <Face Color = "clGreen" VertexIndexes = "13;12; 7; 6" InvisibleEdges = "11" />
                <Face Color = "clGreen" VertexIndexes = "12;13; 2; 3" InvisibleEdges = "11" />
                <Face Color = "clGreen" VertexIndexes = " 6; 7; 8"    InvisibleEdges = "6 " />
                <Face Color = "clGreen" VertexIndexes = " 3; 2;10"    InvisibleEdges = "6 " />
                
                <Face Color = "clBlue " VertexIndexes = "15;14; 1; 0" InvisibleEdges = "11" />
                <Face Color = "clBlue " VertexIndexes = "14;15; 4; 5" InvisibleEdges = "11" />
                <Face Color = "clBlue " VertexIndexes = " 5; 4; 9"    InvisibleEdges = "6 " />
                <Face Color = "clBlue " VertexIndexes = " 0; 1;11"    InvisibleEdges = "6 " />

                <Face Color = "clGol  " VertexIndexes = "17;16; 7; 3" InvisibleEdges = "11" />
                <Face Color = "clGol  " VertexIndexes = "16;17; 1; 5" InvisibleEdges = "11" />
                <Face Color = "clGol  " VertexIndexes = " 3; 7;12"    InvisibleEdges = "6 " />
                <Face Color = "clGol  " VertexIndexes = " 5; 1;14"    InvisibleEdges = "6 " />
                
                <Face Color = "clWhite" VertexIndexes = "19;18; 4; 0" InvisibleEdges = "11" />
                <Face Color = "clWhite" VertexIndexes = "18;19; 2; 6" InvisibleEdges = "11" />
                <Face Color = "clWhite" VertexIndexes = " 6; 2;13"    InvisibleEdges = "6 " />
                <Face Color = "clWhite" VertexIndexes = " 0; 4;15"    InvisibleEdges = "6 " />
            </Faces>
        </Part>
        
        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
