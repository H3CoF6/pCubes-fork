    <Interface>
        <Name>Superposition</Name>
        <Menu>Cubic\Rubiks Recolored\Superposition</Menu>
        <Inventor>Joseph Bencic</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7462</Link>
    </Interface>

    <Script>
        Colors[0] := '000000';
        Colors[1] := '000001';
        Colors[2] := '000100';
        Colors[3] := '010000';
        Colors[4] := '000101';
        Colors[5] := '010100';

        W := 0.5;
        W0 := W;
        
        D := W / 3;
        DCut := D * 0.1; // inner cut
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W = "W * 1.1" />
        <Script>W := W0;</Script>

        <Cut Color = "Colors[1]" > <Plane NormVector = "-Cx[1];-Cy[1];-Cz[1]" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[2]" > <Plane NormVector = "-Cx[2];-Cy[2];-Cz[2]" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[4]" > <Plane NormVector = "-Cx[4];-Cy[4];-Cz[4]" NormDistance = "-W" /> </Cut>
        <SplitByAxes/>
        <RemoveGrayParts/>

        <HideContaining Vector = " 0; W; W" />
        <HideContaining Vector = "-W;-W; 0" />
        <HideContaining Vector = " W; W; 0" />
        <Cut Color = "Colors[0]" > <Plane NormVector = "-Cx[0];-Cy[0];-Cz[0]" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[5]" > <Plane NormVector = "-Cx[5];-Cy[5];-Cz[5]" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[3]" > <Plane NormVector = "-Cx[3];-Cy[3];-Cz[3]" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <HideContaining Vector = " W; W; 0" />
        <Cut Color = "Colors[2]" > <Plane NormVector = "-Cx[0];-Cy[0];-Cz[0]" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[2]" > <Plane NormVector = "-Cx[5];-Cy[5];-Cz[5]" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[4]" > <Plane NormVector = "-Cx[3];-Cy[3];-Cz[3]" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <Cut Color = "Colors[1]" > <Plane NormVector = "-Cx[3];-Cy[3];-Cz[3]" NormDistance = "-W" /> </Cut>


        // inner cut of centrals for solving procedure to recognize central's orientation
        <Macro Name = "Super">
            <HideContaining Vector = "0; 0; W" />
            <HideContaining Vector = "0; 0;-W" />
            <InvertVisibility/>
            <Split Color1 = "000000" > <Plane NormVector = " 1; 0; 1" NormDistance = " DCut" /> </Split>
            <Split Color2 = "000000" > <Plane NormVector = " 1; 0; 1" NormDistance = "-DCut" /> </Split>
            <RemoveGrayParts/>
            <ShowAll/>
            <Turn NormVector = "1;1;1" Angle = "2 * Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "Super" Repeat = "3" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

