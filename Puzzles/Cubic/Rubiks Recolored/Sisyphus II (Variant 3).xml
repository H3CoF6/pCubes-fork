<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sisyphus II (Variant 3)</Name>
        <Menu>Cubic\Rubiks Recolored\Sisyphus II (Variant 3)</Menu>
        <Inventor>Toni Obermaie</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=30</Link>
    </Interface>

    <Script>
        Color0 := 'FF0000'; // Red
        Color1 := 'FFFF00'; // Yellow
        Color2 := '0000FF'; // Blue

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        L := W * 0.2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Vertices>
                <Add Vector = " 0; 0; W" />

                <Add Vector = " L; L; W" />
                <Add Vector = " L;-L; W" />
                <Add Vector = "-L; L; W" />
                <Add Vector = "-L;-L; W" />

                <Add Vector = " L; W; W" />
                <Add Vector = " L;-W; W" />
                <Add Vector = "-L; W; W" />
                <Add Vector = "-L;-W; W" />
                <Add Vector = " W; L; W" />
                <Add Vector = " W;-L; W" />
                <Add Vector = "-W; L; W" />
                <Add Vector = "-W;-L; W" />

                <Add Vector = " 0; 0;-W" />

                <Add Vector = " L; L;-W" />
                <Add Vector = " L;-L;-W" />
                <Add Vector = "-L; L;-W" />
                <Add Vector = "-L;-L;-W" />

                <Add Vector = " L; W;-W" />
                <Add Vector = " L;-W;-W" />
                <Add Vector = "-L; W;-W" />
                <Add Vector = "-L;-W;-W" />
                <Add Vector = " W; L;-W" />
                <Add Vector = " W;-L;-W" />
                <Add Vector = "-W; L;-W" />
                <Add Vector = "-W;-L;-W" />
            </Vertices>

            <Faces>
                <Face Color = "Color2" VertexIndexes = " 8; 9;13;15;11" InvisibleEdges = "27" />
                <Face Color = "Color1" VertexIndexes = " 8;10;18;17; 9" InvisibleEdges = "27" />
                <Face Color = "Color1" VertexIndexes = " 8;11;19;20;12" InvisibleEdges = "27" />
                <Face Color = "Color2" VertexIndexes = " 8;12;16;14;10" InvisibleEdges = "27" />

                <Face Color = "Color2" VertexIndexes = "21;24;28;26;22" InvisibleEdges = "27" />
                <Face Color = "Color1" VertexIndexes = "21;22;30;31;23" InvisibleEdges = "27" />
                <Face Color = "Color1" VertexIndexes = "21;25;33;32;24" InvisibleEdges = "27" />
                <Face Color = "Color2" VertexIndexes = "21;23;27;29;25" InvisibleEdges = "27" />

                <Face Color = "Color0" VertexIndexes = " 9;17; 7;13" InvisibleEdges = " 9" />
                <Face Color = "Color0" VertexIndexes = "10;14; 5;18" InvisibleEdges = " 9" />
                <Face Color = "Color0" VertexIndexes = "11;15; 3;19" InvisibleEdges = " 9" />
                <Face Color = "Color0" VertexIndexes = "12;20; 1;16" InvisibleEdges = " 9" />

                <Face Color = "Color0" VertexIndexes = "22;26; 6;30" InvisibleEdges = " 9" />
                <Face Color = "Color0" VertexIndexes = "23;31; 4;27" InvisibleEdges = " 9" />
                <Face Color = "Color0" VertexIndexes = "24;32; 2;28" InvisibleEdges = " 9" />
                <Face Color = "Color0" VertexIndexes = "25;29; 0;33" InvisibleEdges = " 9" />

                <Face Color = "Color2" VertexIndexes = "15;13;26;28" InvisibleEdges = "10" />
                <Face Color = "Color1" VertexIndexes = "17;18;31;30" InvisibleEdges = "10" />
                <Face Color = "Color1" VertexIndexes = "20;19;32;33" InvisibleEdges = "10" />
                <Face Color = "Color2" VertexIndexes = "14;16;29;27" InvisibleEdges = "10" />

                <Face Color = "Color0" VertexIndexes = "26;13; 7; 6" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "14;27; 4; 5" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "15;28; 2; 3" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "29;16; 1; 0" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "17;30; 6; 7" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "31;18; 5; 4" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "32;19; 3; 2" InvisibleEdges = " 1" />
                <Face Color = "Color0" VertexIndexes = "20;33; 0; 1" InvisibleEdges = " 1" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
