<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Illusion 5x5x5</Name>
        <Menu>Cubic\Rubiks Recolored\Illusion 5x5x5</Menu>
        <Inventor>Mykola Taradajko</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-09-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4815</Link>
    </Interface>

    <Script>
        clBlack := '444444';
        clWhite := 'FFFFFF';

        W := 0.5;
        D := 2 * W / 5;
        for i := 0 to 3 do
            Dist[i] := -W + D + i * D;

        for i := 0 to 4 do
            Coords[i] := -W + D/2 + i * D;

        OddCubes := 0;
        for i := 0 to 4 do
            for j := 0 to 4 do
                for k := 0 to 4 do
                    if (i=0) or (i=4) or (j=0) or (j=4) or (k=0) or (k=4) then
                        if (i + j + k) mod 2 = 0 then begin
                            OddX[OddCubes] := Coords[i];
                            OddY[OddCubes] := Coords[j];
                            OddZ[OddCubes] := Coords[k];
                            Inc(OddCubes);
                        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "Dist" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>

        <Macro Name = "HideOdd" >
            <HideContaining Vector = "OddX[i]; OddY[i]; OddZ[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideOdd" Repeat = "OddCubes" i = "0" />

        <Cut Color = "clBlack" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <Cut Color = "clWhite" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <HideContaining Vector = " W; W; W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = "-W;-W; W" />
        <Cut Color = "clBlack" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <RemoveGrayParts/>
        <ShowAll/>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
