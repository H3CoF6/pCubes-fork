<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Orange Creamsicle Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Orange Creamsicle Cube</Menu>
        <Inventor>Adam G. Cowan</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2058</Link>
    </Interface>

    <Script>
        Color1 := 'FE8009'; // Orange
        Color2 := 'FFFFFF'; // White

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" >
                <Add Vector = "Ex[ 4]; Ey[ 4]; Ez[ 4]" />
                <Add Vector = "Ex[ 5]; Ey[ 5]; Ez[ 5]" />
                <Add Vector = "Ex[10]; Ey[10]; Ez[10]" />
                <Add Vector = "Ex[11]; Ey[11]; Ez[11]" />
            </Vertices>

            <Faces>
                <Face Color = "Color1" VertexIndexes = " 3; 1; 5; 7" />
                <Face Color = "Color1" VertexIndexes = " 8; 9; 7; 5" InvisibleEdges = "1" />
                <Face Color = "Color1" VertexIndexes = "11; 8; 5; 1" InvisibleEdges = "1" />
                <Face Color = "Color1" VertexIndexes = "10;11; 1; 3" InvisibleEdges = "1" />
                <Face Color = "Color1" VertexIndexes = " 9;10; 3; 7" InvisibleEdges = "1" />
                <Face Color = "Color2" VertexIndexes = " 0; 2; 6; 4" />
                <Face Color = "Color2" VertexIndexes = " 9; 8; 4; 6" InvisibleEdges = "1" />
                <Face Color = "Color2" VertexIndexes = " 8;11; 0; 4" InvisibleEdges = "1" />
                <Face Color = "Color2" VertexIndexes = "11;10; 2; 0" InvisibleEdges = "1" />
                <Face Color = "Color2" VertexIndexes = "10; 9; 6; 2" InvisibleEdges = "1" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
