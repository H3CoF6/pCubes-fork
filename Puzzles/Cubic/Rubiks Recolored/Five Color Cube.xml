<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Five Color Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Five Color Cube</Menu>
        <Inventor>Andrey Mosaltzev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-09-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10332</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF800A'; // Orange
        Colors[1] := '00AA00'; // Green 
        Colors[2] := 'FFFFFF'; // White 
        Colors[3] := 'B40078'; // clViolett
        Colors[4] := 'B40078'; // clViolett
        Colors[5] := 'FFFF00'; // Yellow

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W * 1.1" WY = "W * 1.1" WZ = "W" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = " W; W; 0" />
        <HideContaining Vector = "-W;-W; 0" />
        <Cut Color = "Colors[2]" ><Plane NormVector = " 1; 0; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[2]" ><Plane NormVector = " 0;-1; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[1]" ><Plane NormVector = "-1; 0; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[1]" ><Plane NormVector = " 0; 1; 0" NormDistance = "-W" /></Cut>
        <InvertVisibility/>
        <Cut Color = "Colors[0]" ><Plane NormVector = " 1; 0; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[0]" ><Plane NormVector = " 0;-1; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[0]" ><Plane NormVector = "-1; 0; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[0]" ><Plane NormVector = " 0; 1; 0" NormDistance = "-W" /></Cut>
        <ShowAll/>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
