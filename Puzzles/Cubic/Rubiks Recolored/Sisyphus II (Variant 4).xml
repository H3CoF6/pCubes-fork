<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sisyphus II (Variant 4)</Name>
        <Menu>Cubic\Rubiks Recolored\Sisyphus II (Variant 4)</Menu>
        <Inventor>Toni Obermaie</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=30</Link>
    </Interface>

    <Script>
        Color0 := '0000FF'; // Blue
        Color1 := '007700'; // Green

        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Color0" VertexIndexes = "0;1;3" InvisibleEdges = "4" />
                <Face Color = "Color1" VertexIndexes = "3;2;0" InvisibleEdges = "4" />
                <Face Color = "Color1" VertexIndexes = "5;4;6" InvisibleEdges = "4" />
                <Face Color = "Color0" VertexIndexes = "6;7;5" InvisibleEdges = "4" />
                <Face Color = "Color0" VertexIndexes = "5;1;0" InvisibleEdges = "4" />
                <Face Color = "Color1" VertexIndexes = "0;4;5" InvisibleEdges = "4" />
                <Face Color = "Color1" VertexIndexes = "6;2;3" InvisibleEdges = "4" />
                <Face Color = "Color0" VertexIndexes = "3;7;6" InvisibleEdges = "4" />
                <Face Color = "Color1" VertexIndexes = "0;2;6" InvisibleEdges = "4" />
                <Face Color = "Color1" VertexIndexes = "6;4;0" InvisibleEdges = "4" />
                <Face Color = "Color0" VertexIndexes = "3;1;5" InvisibleEdges = "4" />
                <Face Color = "Color0" VertexIndexes = "5;7;3" InvisibleEdges = "4" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
