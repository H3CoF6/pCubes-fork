<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Checkered 4x4x4</Name>
        <Menu>Cubic\Rubiks Recolored\Checkered 4x4x4</Menu>
        <Inventor>Anele Biscarra</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9108</Link>
    </Interface>

    <Script>
        W := 0.5;

        N := 4;
        D := W / 2;

        for i := 0 to 3 do
            Coords[i] := -W + D/2 + i * D;

        OddCubes := 0;
        for i := 0 to N - 1 do
            for j := 0 to N - 1 do
                for k := 0 to N - 1 do
                    if (i = 0) or (i = N - 1) or
                       (j = 0) or (j = N - 1) or
                       (k = 0) or (k = N - 1) then
                        if (i + j + k) mod 2 = 0 then begin
                            OddX[OddCubes] := Coords[i];
                            OddY[OddCubes] := Coords[j];
                            OddZ[OddCubes] := Coords[k];
                            Inc(OddCubes);
                        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-W / 3; W / 3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "SplitStickers" >
            <Split><Plane NormVector = "1; 0; 0" NormDistance = "-D" /></Split>
            <Split><Plane NormVector = "1; 0; 0" NormDistance = " 0" /></Split>
            <Split><Plane NormVector = "1; 0; 0" NormDistance = " D" /></Split>
            <Split><Plane NormVector = "0; 1; 0" NormDistance = "-D" /></Split>
            <Split><Plane NormVector = "0; 1; 0" NormDistance = " 0" /></Split>
            <Split><Plane NormVector = "0; 1; 0" NormDistance = " D" /></Split>
            <Split><Plane NormVector = "0; 0; 1" NormDistance = "-D" /></Split>
            <Split><Plane NormVector = "0; 0; 1" NormDistance = " 0" /></Split>
            <Split><Plane NormVector = "0; 0; 1" NormDistance = " D" /></Split>
            <RemoveGrayParts/>
        </Macro>
        <ExecMacro MacroName = "SplitStickers" />

        <Macro Name = "HideOdd" >
            <HideContaining Vector = "OddX[i]; OddY[i]; OddZ[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideOdd" Repeat = "OddCubes" i = "0" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            Colors[0] := clOrange;
            Colors[1] := clRed;
            Colors[2] := clGreen;
            Colors[3] := clBlue;
            Colors[4] := clWhite;
            Colors[5] := clYellow;
        </Script>
        <LoadFrom File = "Figures\Cube.xml" />
        <ExecMacro MacroName = "SplitStickers" />

        <ExecMacro MacroName = "HideOdd" Repeat = "OddCubes" i = "0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
