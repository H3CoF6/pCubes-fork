<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ultimate Cube Any size</Name>
        <Menu>Cubic\Rubiks Recolored\Ultimate Cube Any size</Menu>
        <Inventor>different</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-26</Added>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        N := 2;
        RequestNumbers('Enter cube size (2-20)', 'Size:', N);
        N := Max(Min(N, 20), 2);

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />

                <Face Color = "Colors[2]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />

                <Face Color = "Colors[0]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;4;10" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "4;5;10" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "5;1;10" InvisibleEdges = "6" />

                <Face Color = "Colors[0]" VertexIndexes = "2;3;11" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "3;7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />

                <Face Color = "Colors[0]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "6;4;12" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "4;0;12" InvisibleEdges = "6" />

                <Face Color = "Colors[0]" VertexIndexes = "3;1;13" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "1;5;13" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "5;7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "7;3;13" InvisibleEdges = "6" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
