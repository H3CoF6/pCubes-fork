<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rubik's cube 17x17x17 AC</Name>
        <Aliases>Over the Top</Aliases>
        <Menu>Cubic\Rubiks Recolored\17x17x17 AC</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-05-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1996</Link>
    </Interface>

    <Script>
        W := 0.5;

        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        N := 17;
        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
		
        <Split Axis = "0" From = "1"/>
        <Split Axis = "1" From = "1"/>
        <Split Axis = "2" From = "1"/>
        <Split Axis = "0" From = "N-1"/>
        <Split Axis = "1" From = "N-1"/>
        <Split Axis = "2" From = "N-1"/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Macro Name = "HideCenter" >
            <HideContaining Vector = "Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideCenter" i = "0" Repeat = "6" />

        <Macro Name = "CutGray" >
            <Cut> <Plane NormVector = "Cx[i]; Cy[i]; Cz[i]" NormDistance = "-W" /> </Cut>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "CutGray" i = "0" Repeat = "6" />

        <InvertVisibility/>

        <Macro Name = "CutColor" >
            <Cut Color = "Colors[i]" > <Plane NormVector = "Cx[i]; Cy[i]; Cz[i]" NormDistance = "-W" /> </Cut>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" i = "0" Repeat = "6" />

        <ShowAll/>
        <SplitByAxes/>
   </Figure>
</xml>
