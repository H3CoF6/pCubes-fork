<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Four-colour 4x4x4 cube</Name>
        <Menu>Cubic\Rubiks Recolored\Four-colour 4x4x4 cube</Menu>
        <Inventor>Mykola Taradajko</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-08-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4826</Link>
    </Interface>

    <Script>
        Color0 := 'C80000'; // Red
        Color1 := 'FFFFFF'; // White
        Color2 := '0000C8'; // Blue
        Color3 := '009600'; // Green

        W := 0.5;
        D := W / 2;
        D1:= W / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddLayer">
            <Script>
                for i := 0 to 5 do
                    Colors[i] := Color;
            </Script>
            <Transfer Vector = " 0; 0; DZ" />
            <LoadFrom File = "Figures\Cuboid.xml" WZ = "D1"/>
            <Transfer Vector = " 0; 0;-DZ" />
            <Split Color1 = "Color" Color2 = "Color" Axis = "0" From = "2" />
            <Split Color1 = "Color" Color2 = "Color" Axis = "1" From = "2" />
            <Split Color1 = "Color" Color2 = "Color"><Plane NormVector = "-1; 0; 0" NormDistance = "D" /> </Split>
            <Split Color1 = "Color" Color2 = "Color"><Plane NormVector = " 0;-1; 0" NormDistance = "D" /> </Split>
            <Split Color1 = "Color" Color2 = "Color" Axis = "0" From = "3" />
            <Split Color1 = "Color" Color2 = "Color" Axis = "1" From = "3" />
        </Macro>
        <ExecMacro MacroName = "AddLayer" Color = "Color0" DZ = "D1+D" />
        <ExecMacro MacroName = "AddLayer" Color = "Color1" DZ = "D1" />
        <ExecMacro MacroName = "AddLayer" Color = "Color2" DZ = "D1-D" />
        <ExecMacro MacroName = "AddLayer" Color = "Color3" DZ = "D1-D*2" />

        <RemoveContaining Vector = "0;0;0" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
