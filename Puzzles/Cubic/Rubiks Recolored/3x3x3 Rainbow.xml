<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x3 Rainbow</Name>
        <Menu>Cubic\Rubiks Recolored\3x3x3 Rainbow</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-28</Added>
    </Interface>

     <Script>
        Color1 := 'DC0000'; // clRed
        Color2 := 'FF9600'; // clOrange
        Color3 := 'E6C800'; // clYellow
        Color4 := '009600'; // clGreen
        Color5 := '0000C8'; // clBlue
        Color6 := 'B40078'; // clViolett

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;

        Ex[ 0] :=  D; Ey[ 0] := -W; Ez[ 0] :=  W;
        Ex[ 1] :=  D; Ey[ 1] :=  W; Ez[ 1] :=  W;
        Ex[ 2] := -W; Ey[ 2] :=  D; Ez[ 2] :=  W;
        Ex[ 3] :=  W; Ey[ 3] :=  D; Ez[ 3] :=  W;
        Ex[ 4] :=  W; Ey[ 4] := -W; Ez[ 4] :=  D;
        Ex[ 5] :=  W; Ey[ 5] :=  W; Ez[ 5] :=  D;
        Ex[ 6] :=  D; Ey[ 6] :=  W; Ez[ 6] := -W;
        Ex[ 7] :=  D; Ey[ 7] := -W; Ez[ 7] := -W;
        Ex[ 8] :=  W; Ey[ 8] :=  D; Ez[ 8] := -W;
        Ex[ 9] := -W; Ey[ 9] :=  D; Ez[ 9] := -W;
        Ex[10] := -W; Ey[10] :=  W; Ez[10] :=  D;
        Ex[11] := -W; Ey[11] := -W; Ez[11] :=  D;

        Fx[ 0] := -D; Fy[ 0] := -W; Fz[ 0] :=  W;
        Fx[ 1] := -D; Fy[ 1] :=  W; Fz[ 1] :=  W;
        Fx[ 2] := -W; Fy[ 2] := -D; Fz[ 2] :=  W;
        Fx[ 3] :=  W; Fy[ 3] := -D; Fz[ 3] :=  W;
        Fx[ 4] :=  W; Fy[ 4] := -W; Fz[ 4] := -D;
        Fx[ 5] :=  W; Fy[ 5] :=  W; Fz[ 5] := -D;
        Fx[ 6] := -D; Fy[ 6] :=  W; Fz[ 6] := -W;
        Fx[ 7] := -D; Fy[ 7] := -W; Fz[ 7] := -W;
        Fx[ 8] :=  W; Fy[ 8] := -D; Fz[ 8] := -W;
        Fx[ 9] := -W; Fy[ 9] := -D; Fz[ 9] := -W;
        Fx[10] := -W; Fy[10] :=  W; Fz[10] := -D;
        Fx[11] := -W; Fy[11] := -W; Fz[11] := -D;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithPartNo = "2" > // Turn... - for Solving
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ex; Ey; Ez" />
            <Vertices Vectors = "Fx; Fy; Fz" />

            <Faces>
                <Face Color = "Color1" VertexIndexes = " 1; 19; 20" InvisibleEdges = "2" />
                <Face Color = "Color1" VertexIndexes = " 1; 20; 22" InvisibleEdges = "2" />
                <Face Color = "Color1" VertexIndexes = " 1; 22; 19" InvisibleEdges = "2" />

                <Face Color = "Color2" VertexIndexes = "19; 31;  8; 20" InvisibleEdges = "10" />
                <Face Color = "Color2" VertexIndexes = "20;  8; 10; 22" InvisibleEdges = "10" />
                <Face Color = "Color2" VertexIndexes = "22; 10; 31; 19" InvisibleEdges = "10" />

                <Face Color = "Color3" VertexIndexes = "31;  0;  5;  8" InvisibleEdges = "10" />
                <Face Color = "Color3" VertexIndexes = " 8;  5;  3; 10" InvisibleEdges = "10" />
                <Face Color = "Color3" VertexIndexes = "10;  3;  0; 31" InvisibleEdges = "10" />

                <Face Color = "Color4" VertexIndexes = " 0; 27; 12;  5" InvisibleEdges = "10" />
