                <Face Color = "Color4" VertexIndexes = " 5; 23; 21;  3" InvisibleEdges = "10" />
                <Face Color = "Color4" VertexIndexes = " 3; 21; 18"     InvisibleEdges = "2 " />
                <Face Color = "Color4" VertexIndexes = " 3; 18; 29;  0" InvisibleEdges = "10" />
                <Face Color = "Color4" VertexIndexes = " 0; 29; 27"     InvisibleEdges = "2 " />

                <Face Color = "Color5" VertexIndexes = "27; 15; 24; 12" InvisibleEdges = "10" />
                <Face Color = "Color5" VertexIndexes = "12; 24; 11; 23" InvisibleEdges = "10" />
                <Face Color = "Color5" VertexIndexes = "23; 11;  9; 21" InvisibleEdges = "10" />
                <Face Color = "Color5" VertexIndexes = "21;  9; 30; 18" InvisibleEdges = "10" />
                <Face Color = "Color5" VertexIndexes = "18; 30; 17; 29" InvisibleEdges = "10" />
                <Face Color = "Color5" VertexIndexes = "29; 17; 15; 27" InvisibleEdges = "10" />

                <Face Color = "Color6" VertexIndexes = " 4; 24; 15"     InvisibleEdges = "2 " />
                <Face Color = "Color6" VertexIndexes = "24;  4;  7; 11" InvisibleEdges = "10" />
                <Face Color = "Color6" VertexIndexes = " 7;  9; 11"     InvisibleEdges = "2 " />
                <Face Color = "Color6" VertexIndexes = " 9;  7;  2; 30" InvisibleEdges = "10" />
                <Face Color = "Color6" VertexIndexes = " 2; 17; 30"     InvisibleEdges = "2 " />
                <Face Color = "Color6" VertexIndexes = "17;  2;  4; 15" InvisibleEdges = "10" />

                <Face Color = "Color3" VertexIndexes = " 4; 28; 13;  7" InvisibleEdges = "10" />
                <Face Color = "Color3" VertexIndexes = " 7; 13; 26;  2" InvisibleEdges = "10" />
                <Face Color = "Color3" VertexIndexes = " 2; 26; 28;  4" InvisibleEdges = "10" />

                <Face Color = "Color2" VertexIndexes = "28; 16; 25; 13" InvisibleEdges = "10" />
                <Face Color = "Color2" VertexIndexes = "13; 25; 14; 26" InvisibleEdges = "10" />
                <Face Color = "Color2" VertexIndexes = "26; 14; 16; 28" InvisibleEdges = "10" />

                <Face Color = "Color1" VertexIndexes = " 6; 25; 16" InvisibleEdges = "2" />
                <Face Color = "Color1" VertexIndexes = " 6; 14; 25" InvisibleEdges = "2" />
                <Face Color = "Color1" VertexIndexes = " 6; 16; 14" InvisibleEdges = "2" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
