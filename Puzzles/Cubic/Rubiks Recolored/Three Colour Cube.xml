<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Three Colour Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Three Colour Cube</Menu>
        <Inventor>Georges Helm</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=187</Link>
    </Interface>

    <Script>
        C1 := '222222';
        C2 := 'FFFFFF';
        C3 := '888888';

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "MonoCube" >
            <HideAll/>
            <Script>
                for i := 0 to 5 do
                  Colors[i] := Color;
            </Script>
            <LoadFrom File = "Figures\Cube.xml" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "MonoCube" Color = "C1" />
        <Cut Axis = "2" From = "2" />
        <ExecMacro MacroName = "MonoCube" Color = "C2" />
        <Cut Axis = "2" From = "1" To = "2" />
        <ExecMacro MacroName = "MonoCube" Color = "C3" />
        <Cut Axis = "2" To = "1" />
        <ShowAll/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
