<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Colors Inside Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Colors Inside Cube</Menu>
        <Inventor>Christophe Woittequand</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-08-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2081</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />

        <Split Axis = "0" From = "1" Color1 = "clRed   " Color2 = "clOrange" />
        <Split Axis = "0" From = "2" Color1 = "clRed   " Color2 = "clOrange" />
        <Split Axis = "1" From = "1" Color1 = "clBlue  " Color2 = "clGreen " />
        <Split Axis = "1" From = "2" Color1 = "clBlue  " Color2 = "clGreen " />
        <Split Axis = "2" From = "1" Color1 = "clYellow" Color2 = "clWhite " />
        <Split Axis = "2" From = "2" Color1 = "clYellow" Color2 = "clWhite " />

        <RemoveContaining Vector  = " 0; 0; 0" />
        <RemoveContaining Vectors = "Cx;Cy;Cz" />

        <HideAll/>

        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <SplitByAxes/>
        <HideContaining Vectors = "Cx;Cy;Cz" />

        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>
