<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3-color Cross Cube</Name>
        <Menu>Cubic\Rubiks Recolored\3-color Cross Cube</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-04</Added>
        <Link>https://cubezz.com/Buy-6011-FanXin+3-color+Cross+3x3x3+Magic+Cube+Puzzle.html</Link>
    </Interface>

    <Script>
        Color1 := 'FFFF00';
        Color2 := 'FF0000';
        Color3 := '00AAFF';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <Macro Name ="Body">
            <Part>
                <Vertices>
                    <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                    <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                    <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                    <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                    <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                    <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
                    <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
                    <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
                </Vertices>

                <Faces>
                    <Face Color = "C1" VertexIndexes = "0;1;3;2" />
                    <Face Color = "C1" VertexIndexes = "5;4;6;7" />
                    <Face Color = "C2" VertexIndexes = "1;0;4;5" />
                    <Face Color = "C2" VertexIndexes = "2;3;7;6" />
                    <Face Color = "C1" VertexIndexes = "0;2;6;4" />
                    <Face Color = "C1" VertexIndexes = "3;1;5;7" />
                </Faces>
            </Part>
        </Macro>

        <Script> C1 := Color1; C2 := Color1; </Script>
        <ExecMacro MacroName = "Body"/>
        <SplitByAxes/>
        <Macro Name = "HideCorners">
            <HideContaining Vector = "Vx[id]; Vy[id]; Vz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCorners" Repeat = "8" id = "0" />
        <RemoveAllVisible/>

        <Script>
            C1 := Color2;
            C2 := Color3;
        </Script>

        <ExecMacro MacroName = "Body"/>
        <SplitByAxes/>

        <RemoveContaining Vector = "Vx; Vy; Vz" />

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
