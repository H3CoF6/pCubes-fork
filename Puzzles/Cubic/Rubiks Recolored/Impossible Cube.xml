<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Impossible Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Impossible Cube</Menu>
        <Inventor>Ultraco</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-08-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4742</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clBlue   := '0000FF';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" >
                <Add Vector = " D;-W;-W" />
                <Add Vector = "-W; D;-W" />
                <Add Vector = "-W;-W; D" />
                <Add Vector = " D; W; W" />
                <Add Vector = "-W;-D; W" />
                <Add Vector = "-W; W;-D" />
                <Add Vector = "-D;-W; W" />
                <Add Vector = " W; D; W" />
                <Add Vector = " W;-W;-D" />
                <Add Vector = "-D; W;-W" />
                <Add Vector = " W;-D;-W" />
                <Add Vector = " W; W; D" />

                <Add Vector = " W; D;-D" />
                <Add Vector = " W;-D; D" />
                <Add Vector = "-W; D; D" />
                <Add Vector = "-W;-D;-D" />
                <Add Vector = "-D; W; D" />
                <Add Vector = " D; W;-D" />
                <Add Vector = "-D;-W;-D" />
                <Add Vector = " D;-W; D" />
                <Add Vector = " D;-D; W" />
                <Add Vector = "-D; D; W" />
                <Add Vector = "-D;-D;-W" />
                <Add Vector = " D; D;-W" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = " 0; 8;10" InvisibleEdges = "2" />
                <Face Color = "clRed   " VertexIndexes = " 0; 9; 8" InvisibleEdges = "2" />
                <Face Color = "clYellow" VertexIndexes = " 0;10; 9" InvisibleEdges = "2" />
                <Face Color = "clBlue  " VertexIndexes = " 3;11;13" InvisibleEdges = "2" />
                <Face Color = "clYellow" VertexIndexes = " 3;12;11" InvisibleEdges = "2" />
                <Face Color = "clRed   " VertexIndexes = " 3;13;12" InvisibleEdges = "2" />
                <Face Color = "clYellow" VertexIndexes = " 5;14;16" InvisibleEdges = "2" />
                <Face Color = "clBlue  " VertexIndexes = " 5;15;14" InvisibleEdges = "2" />
                <Face Color = "clWhite " VertexIndexes = " 5;16;15" InvisibleEdges = "2" />
                <Face Color = "clRed   " VertexIndexes = " 6;17;19" InvisibleEdges = "2" />
                <Face Color = "clWhite " VertexIndexes = " 6;18;17" InvisibleEdges = "2" />
                <Face Color = "clBlue  " VertexIndexes = " 6;19;18" InvisibleEdges = "2" />

                <Face Color = "clRed   " VertexIndexes = " 1;10;26;27;14" InvisibleEdges = "14" />
                <Face Color = "clBlue  " VertexIndexes = " 1;12;22;23;10" InvisibleEdges = "14" />
                <Face Color = "clWhite " VertexIndexes = " 1;14;28;29;12" InvisibleEdges = "14" />
                <Face Color = "clWhite " VertexIndexes = " 2; 9;23;22;13" InvisibleEdges = "14" />
                <Face Color = "clYellow" VertexIndexes = " 2;13;24;25;17" InvisibleEdges = "14" />
                <Face Color = "clBlue  " VertexIndexes = " 2;17;31;30; 9" InvisibleEdges = "14" />
                <Face Color = "clYellow" VertexIndexes = " 4; 8;30;31;18" InvisibleEdges = "14" />
                <Face Color = "clBlue  " VertexIndexes = " 4;16;27;26; 8" InvisibleEdges = "14" />
                <Face Color = "clRed   " VertexIndexes = " 4;18;20;21;16" InvisibleEdges = "14" />
                <Face Color = "clRed   " VertexIndexes = " 7;11;29;28;15" InvisibleEdges = "14" />
                <Face Color = "clYellow" VertexIndexes = " 7;15;21;20;19" InvisibleEdges = "14" />
                <Face Color = "clWhite " VertexIndexes = " 7;19;25;24;11" InvisibleEdges = "14" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveGrayParts/>
        <S1aveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "AdjoiningFacesHaveSameColors" />
    <P1rocedures CheckSolved = "CheckSavedStates" />
</xml>
