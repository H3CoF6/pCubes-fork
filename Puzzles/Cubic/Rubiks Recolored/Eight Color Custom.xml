                <Face Color = "C2" VertexIndexes = "4;23;08;20" InvisibleEdges = "9" />
                <Face Color = "C3" VertexIndexes = "0;16;09;24" InvisibleEdges = "9" />
                <Face Color = "C3" VertexIndexes = "3;24;09;15" InvisibleEdges = "9" />
                <Face Color = "C3" VertexIndexes = "5;15;09;16" InvisibleEdges = "9" />
                <Face Color = "C4" VertexIndexes = "1;18;10;22" InvisibleEdges = "9" />
