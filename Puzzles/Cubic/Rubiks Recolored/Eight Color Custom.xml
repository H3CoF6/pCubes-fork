<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Eight Color Any size</Name>
        <Menu>Cubic\Rubiks Recolored\Eight Color Any size</Menu>
        <Inventor>different</Inventor>
        <Programmer>xchemist + Skallos</Programmer>
        <Added>2020-06-28</Added>
    </Interface>

    <Script>
        C1 := '009600';
        C2 := 'FF800A';
        C3 := 'FFFF00';
        C4 := 'FFFFFF';
        C5 := 'C80000';
        C6 := '00DD00';
        C7 := '0066FF';
        C8 := '0000C8';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        N := 3;
        RequestNumbers('Enter cube size (3-20', 'Size:', N);
        N := Max(Min(N, 20), 3);

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "C1" VertexIndexes = "0;25;07;16" InvisibleEdges = "9" />
                <Face Color = "C1" VertexIndexes = "2;14;07;25" InvisibleEdges = "9" />
                <Face Color = "C1" VertexIndexes = "5;16;07;14" InvisibleEdges = "9" />
