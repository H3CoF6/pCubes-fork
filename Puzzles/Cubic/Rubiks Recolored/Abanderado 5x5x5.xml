<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Abanderado 5x5x5</Name>
        <Menu>Cubic\Rubiks Recolored\Abanderado 5x5x5</Menu>
        <Inventor>Antonio Rodriguez Perez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9099</Link>
    </Interface>

    <Script>
        Colors[0] := 'C80000'; // clRed
        Colors[1] := 'FF8E01'; // clOrange
        Colors[2] := '0019FF'; // clBlue
        Colors[3] := '04A42A'; // clGreen
        Colors[4] := 'ECE300'; // clYellow
        Colors[5] := 'FFFFFF'; // clWhite

        ColorsS := 'robgyw';

        W := 0.5;
        D := W / 5;

        function GetInt(): integer;
        begin
          substr := copy(SColors, 1, 1);
          Delete(SColors, 1, 1);
          if substr = ' ' then begin
            substr := copy(SColors, 1, 1);
            Delete(SColors, 1, 1);
          end;
          Result := Pos(substr, ColorsS) - 1;
        end;

        SColorsUp    := 'brwog brwog brwog brwog brwog';
        SColorsLeft  := 'owgyr owgyr owgyr owgyr owgyr';
        SColorsFace  := 'yyyyy bbbbb rrrrr ggggg wwwww';
        SColorsRight := 'owbyr owbyr owbyr owbyr owbyr';
        SColorsDown  := 'goyrb goyrb goyrb goyrb goyrb';
        SColorsBack  := 'yyyyy bbbbb ooooo ggggg wwwww';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3*D;-D; D; 3*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W * 1.1" Color = "-1" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />

        <Macro Name = "CutRow" >
            <HideContaining Vector = "(x - 2) * 2 * D; (y - 2) * 2 * D; W" />
            <InvertVisibility />
            <Cut Color = "Colors[GetInt]"><Plane NormVector = "0;0;-1" NormDistance = "-W" /></Cut>
            <ShowAll/>
            <Script>Inc(x);</Script>
        </Macro>

        <Macro Name = "CutFace" >
            <ExecMacro MacroName = "CutRow" x = "0" y = "4" Repeat = "5" />
            <ExecMacro MacroName = "CutRow" x = "0" y = "3" Repeat = "5" />
            <ExecMacro MacroName = "CutRow" x = "0" y = "2" Repeat = "5" />
            <ExecMacro MacroName = "CutRow" x = "0" y = "1" Repeat = "5" />
            <ExecMacro MacroName = "CutRow" x = "0" y = "0" Repeat = "5" />
        </Macro>

        <ExecMacro MacroName = "CutFace" SColors = "SColorsUp" />

        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "CutFace" SColors = "SColorsFace" />

        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "CutFace" SColors = "SColorsLeft" />
        
        <Turn NormVector = "0;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutFace" SColors = "SColorsRight" />

        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "CutFace" SColors = "SColorsDown" />

        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "CutFace" SColors = "SColorsBack" />
        
        <Turn NormVector = "1;0;0" Angle = "-Pi/2" />

        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
