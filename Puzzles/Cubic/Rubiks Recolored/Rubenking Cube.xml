<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rubenking Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Rubenking Cube</Menu>
        <Inventor>Neil J. Rubenking</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=246</Link>
    </Interface>

    <Script>
        W  := 0.5;
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clYellow" VertexIndexes = "0;1;3" InvisibleEdges = "4" />
                <Face Color = "clOrange" VertexIndexes = "3;2;0" InvisibleEdges = "4" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "6;7;5" InvisibleEdges = "4" />
                <Face Color = "clWhite"  VertexIndexes = "5;1;0" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "0;4;5" InvisibleEdges = "4" />
                <Face Color = "clWhite"  VertexIndexes = "6;2;3" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "3;7;6" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "0;2;6" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "6;4;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "3;1;5" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "5;7;3" InvisibleEdges = "4" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <SaveSolvedState/>
        <Turn Axis = "2" From = "0" To = "2" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
