<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Illusion 6x6x6</Name>
        <Menu>Cubic\Rubiks Recolored\Illusion 6x6x6</Menu>
        <Inventor>Patricio Sidgman Rivera</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-05-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7994</Link>
    </Interface>

    <Script>
        clBlack := '444444';
        clWhite := 'FFFFFF';

        W := 0.5;

        N := 6;
        D := 2 * W / N;
        for i := 0 to N - 2 do
            Dist[i] := -W + D + i * D;

        for i := 0 to N - 1 do
            Coords[i] := -W + D/2 + i * D;

        OddCubes := 0;
        for i := 0 to N - 1 do
            for j := 0 to N - 1 do
                for k := 0 to N - 1 do
                    if (i = 0) or (i = N - 1) or
                       (j = 0) or (j = N - 1) or
                       (k = 0) or (k = N - 1) then begin
                        if (i + j + k) mod 2 = 0 then begin
                            OddX[OddCubes] := Coords[i];
                            OddY[OddCubes] := Coords[j];
                            OddZ[OddCubes] := Coords[k];
                            Inc(OddCubes);
                        end;
                    end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "Dist" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>

        <Macro Name = "HideOdd" >
            <HideContaining Vector = "OddX[i]; OddY[i]; OddZ[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideOdd" Repeat = "OddCubes" i = "0" />

        <Cut Color = "clWhite" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>

        <InvertVisibility/>
        <Cut Color = "clBlack" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>

        <ShowAll/>
        <RemoveGrayParts/>

        <SaveSolvedState/>

        <Turn Axis = "0" From = "0" To = "N - 1" Angle = "Pi/2" />
        <SaveSolvedState/>

        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
