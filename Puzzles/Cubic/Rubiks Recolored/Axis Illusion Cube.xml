<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis Illusion Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Axis Illusion Cube</Menu>
        <Inventor>Marco Crawley</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5443</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        DCut := D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" InvisibleEdges1 = "15" InvisibleEdges2 = "15" />
        <Split Axis = "0" From = "2" InvisibleEdges1 = "15" InvisibleEdges2 = "15" />
        <Split Axis = "1" From = "1" InvisibleEdges1 = "15" InvisibleEdges2 = "15" />
        <Split Axis = "1" From = "2" InvisibleEdges1 = "15" InvisibleEdges2 = "15" />
        <Split Axis = "2" From = "1" InvisibleEdges1 = "15" InvisibleEdges2 = "15" />
        <Split Axis = "2" From = "2" InvisibleEdges1 = "15" InvisibleEdges2 = "15" />
        <RemoveGrayParts/>

        <Split> <Plane NormVector = "-1; 2; 2" NormDistance = " DCut" /> </Split>
        <Split> <Plane NormVector = "-1; 2; 2" NormDistance = "-DCut" /> </Split>
        <Split> <Plane NormVector = " 2;-1; 2" NormDistance = " DCut" /> </Split>
        <Split> <Plane NormVector = " 2;-1; 2" NormDistance = "-DCut" /> </Split>
        <Split> <Plane NormVector = " 2; 2;-1" NormDistance = " DCut" /> </Split>
        <Split> <Plane NormVector = " 2; 2;-1" NormDistance = "-DCut" /> </Split>

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
