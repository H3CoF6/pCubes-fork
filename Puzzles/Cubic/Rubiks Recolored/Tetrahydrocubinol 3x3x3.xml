    <Interface>
        <Name>Tetrahydrocubinol 3x3x3</Name>
        <Menu>Cubic\Rubiks Recolored\Tetrahydrocubinol 3x3x3</Menu>
        <Inventor>Fabio Bini Graciose</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5429</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        dW := 0.0002501;
        W1 := W + dW * 1;

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
                <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
                <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
            </Vertices>

            <Faces>
                <Face Color = "FFFFFF" VertexIndexes = "0;1;3;2" />
                <Face Color = "FFFFFE" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFEFF" VertexIndexes = "1;0;4;5" />
                <Face Color = "FEFFFF" VertexIndexes = "2;3;7;6" />
                <Face Color = "FFFEFE" VertexIndexes = "0;2;6;4" />
                <Face Color = "FEFEFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Macro Name = "Super">
            <InvertVisibility/>

            <Part>
                <Vertices>
                    <Add Vector = "-DCut2; -WE; -WE" />
                    <Add Vector = "-DCut2; -WE;  WE" />
                    <Add Vector = "-DCut2;  WE; -WE" />
                    <Add Vector = "-DCut2;  WE;  WE" />
                    <Add Vector = " DCut2; -WE; -WE" />
                    <Add Vector = " DCut2; -WE;  WE" />
                    <Add Vector = " DCut2;  WE; -WE" />
                    <Add Vector = " DCut2;  WE;  WE" />
                </Vertices>

                <Faces>
                    <Face Color = "FFFFFF" VertexIndexes = "0;1;3;2" />
                    <Face Color = "FFFFFE" VertexIndexes = "5;4;6;7" />
                    <Face Color = "FFFEFF" VertexIndexes = "1;0;4;5" />
                    <Face Color = "FEFFFF" VertexIndexes = "2;3;7;6" />
                    <Face Color = "FFFEFE" VertexIndexes = "0;2;6;4" />
                    <Face Color = "FEFEFF" VertexIndexes = "3;1;5;7" />
                </Faces>
            </Part>

            <Part>
                <Vertices>
                    <Add Vector = "-WE; -DCut2; -WE" />
                    <Add Vector = "-WE; -DCut2;  WE" />
                    <Add Vector = "-WE;  DCut2; -WE" />
                    <Add Vector = "-WE;  DCut2;  WE" />
                    <Add Vector = " WE; -DCut2; -WE" />
                    <Add Vector = " WE; -DCut2;  WE" />
                    <Add Vector = " WE;  DCut2; -WE" />
                    <Add Vector = " WE;  DCut2;  WE" />
                </Vertices>

                <Faces>
                    <Face Color = "FFFFFF" VertexIndexes = "0;1;3;2" />
                    <Face Color = "FFFFFE" VertexIndexes = "5;4;6;7" />
                    <Face Color = "FFFEFF" VertexIndexes = "1;0;4;5" />
                    <Face Color = "FEFFFF" VertexIndexes = "2;3;7;6" />
                    <Face Color = "FFFEFE" VertexIndexes = "0;2;6;4" />
                    <Face Color = "FEFEFF" VertexIndexes = "3;1;5;7" />
                </Faces>
            </Part>

            <Part>
                <Vertices>
                    <Add Vector = "-WE; -WE; -DCut2" />
                    <Add Vector = "-WE; -WE;  DCut2" />
                    <Add Vector = "-WE;  WE; -DCut2" />
                    <Add Vector = "-WE;  WE;  DCut2" />
                    <Add Vector = " WE; -WE; -DCut2" />
                    <Add Vector = " WE; -WE;  DCut2" />
                    <Add Vector = " WE;  WE; -DCut2" />
                    <Add Vector = " WE;  WE;  DCut2" />
                </Vertices>

                <Faces>
                    <Face Color = "FFFFFF" VertexIndexes = "0;1;3;2" />
                    <Face Color = "FFFFFE" VertexIndexes = "5;4;6;7" />
                    <Face Color = "FFFEFF" VertexIndexes = "1;0;4;5" />
                    <Face Color = "FEFFFF" VertexIndexes = "2;3;7;6" />
                    <Face Color = "FFFEFE" VertexIndexes = "0;2;6;4" />
                    <Face Color = "FEFEFF" VertexIndexes = "3;1;5;7" />
                </Faces>
            </Part>

            <Split> <Plane NormVector = " 1; 0; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = "-1; 0; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0; 1; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0;-1; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0; 0; 1" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0; 0;-1" NormDistance = "DCut1" /> </Split>
            <RemoveContaining Vector = " 0; 0; 0" />
        </Macro>
        <ExecMacro MacroName = "Super" WE = "D" DCut1 = "W" DCut2 = "W1" />
        <ShowAll/>
        <SplitByAxes/>
    </Figure>

