<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rainbow Type 3x3x3</Name>
        <Menu>Cubic\Rubiks Recolored\Rainbow Type 3x3x3</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-31</Added>
        <Link>https://www.magiccubemall.com/p/Z-cube-Rainbow-Type-3x3x3-Magic-Cube-Puzzle-Cube-Intelligent-Toys-Black_2387778.html</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=9&amp;t=16939&amp;p=208125&amp;hilit=mastermorphcube#p208125</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clBlue   := '0000FF';
        clGreen  := '00DD00';

        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "0;1;3" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "3;2;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "5;4;6" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "6;7;5" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "5;1;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "0;4;5" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "6;2;3" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "3;7;6" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "0;2;6" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "6;4;0" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "3;1;5" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "5;7;3" InvisibleEdges = "4" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <SaveSolvedState/>
        <Turn Axis = "2" From = "0" To = "2" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
