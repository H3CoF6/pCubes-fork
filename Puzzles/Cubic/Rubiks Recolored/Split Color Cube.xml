<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Split Color Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Split Color Cube</Menu>
        <Inventor>Georges Helm</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=138</Link>
    </Interface>

    <Script>
        W := 0.5;

        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W/3;

        C1 := 'DD0000';
        C2 := 'FFFFFF';
        C3 := 'FFFF00';
        C4 := 'FF8800';
        C5 := '0033EE';
        C6 := '00BB00';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0">
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "C1" VertexIndexes = "07; 09; 24; 25" InvisibleEdges = "4"/>
                <Face Color = "C1" VertexIndexes = "10; 12; 19; 18" InvisibleEdges = "4"/>

                <Face Color = "C2" VertexIndexes = "13; 12; 20; 15" InvisibleEdges = "4"/>
                <Face Color = "C2" VertexIndexes = "07; 06; 21; 14" InvisibleEdges = "4"/>

                <Face Color = "C3" VertexIndexes = "10; 11; 14; 21" InvisibleEdges = "4"/>
                <Face Color = "C3" VertexIndexes = "08; 09; 15; 20" InvisibleEdges = "4"/>

                <Face Color = "C4" VertexIndexes = "07; 11; 17; 16" InvisibleEdges = "4"/>
                <Face Color = "C4" VertexIndexes = "08; 12; 22; 23" InvisibleEdges = "4"/>

                <Face Color = "C5" VertexIndexes = "16; 17; 13; 09" InvisibleEdges = "1"/>
                <Face Color = "C5" VertexIndexes = "23; 22; 10; 06" InvisibleEdges = "1"/>

                <Face Color = "C6" VertexIndexes = "18; 19; 13; 11" InvisibleEdges = "1"/>
                <Face Color = "C6" VertexIndexes = "25; 24; 08; 06" InvisibleEdges = "1"/>
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
