<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

<!-- question: does it have the only solution? -->

    <Interface>
        <Name>Maze 3x3x3</Name>
        <Menu>Cubic\Rubiks Recolored\Maze 3x3x3</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-09-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=933</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        DCut := W * 0.1;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "CutCenter" > <!-- for "Solving" to work -->
            <HideContaining Vector = "Cx[c]; Cy[c]; Cz[c]" />
            <InvertVisibility/>
            <Cut><Plane NormVector = "Ex[e]; Ey[e]; Ez[e]" NormDistance = "DCut" /></Cut>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "CutCenter" c = "0" e = "2" />
        <ExecMacro MacroName = "CutCenter" c = "1" e = "3" />
        <ExecMacro MacroName = "CutCenter" c = "1" e = "8" />
        <ExecMacro MacroName = "CutCenter" c = "2" e = "0" />
        <ExecMacro MacroName = "CutCenter" c = "2" e = "7" />
        <ExecMacro MacroName = "CutCenter" c = "3" e = "1" />
        <ExecMacro MacroName = "CutCenter" c = "4" e = "6" />
        <ExecMacro MacroName = "CutCenter" c = "5" e = "0" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Textures>
        <Texture Name = "I" File = "Textures\Maze 3x3x3\I.vec" />
        <Texture Name = "R" File = "Textures\Maze 3x3x3\R.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        I =  3,0,0,  2,1,0, 11,0,0, 19,1,1, 10,0,1, 18,1,1,  0,1,0, 18,0,1, 21,0,1
        I = 19,2,0,  0,2,1,  9,1,1, 23,2,1,  7,0,0,  6,1,1, 14,0,1,  7,1,0,  8,1,0
        R =  1,1,1,  9,0,1, 17,1,3, 19,0,0, 22,0,3, 25,0,1, 24,0,0, 23,0,1, 20,0,0
        R = 17,0,1, 11,1,2,  2,2,3,  5,1,1, 13,0,0, 22,1,2, 25,2,3, 16,1,0,  8,2,3
        R = 17,2,0, 20,1,3, 12,0,1,  3,1,0,  6,2,1, 14,1,0,  0,0,2,  6,0,2,  4,0,2
        R =  1,0,0,  2,0,0,  5,0,2,  8,0,2, 16,0,1, 25,1,2, 15,0,0, 24,1,2, 23,1,0
    </SetTextures>
