    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[2]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[0]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
