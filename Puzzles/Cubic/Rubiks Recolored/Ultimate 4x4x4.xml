<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ultimate 4x4x4</Name>
        <Menu>Cubic\Rubiks Recolored\Ultimate 4x4x4</Menu>
