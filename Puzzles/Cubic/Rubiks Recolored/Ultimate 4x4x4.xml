                <Face Color = "Colors[5]" VertexIndexes = "5;1;10" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[0]" VertexIndexes = "2;3;11" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "3;7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />
                                                                                        
                <Face Color = "Colors[0]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
