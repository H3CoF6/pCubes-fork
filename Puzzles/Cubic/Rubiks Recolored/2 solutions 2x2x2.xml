<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2 solutions 2x2x2</Name>
        <Menu>Cubic\Rubiks Recolored\2 solutions 2x2x2</Menu>
        <Inventor>Todd Hancock</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-12-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9409</Link>
    </Interface>

    <Script>
        Colors[0,0] := 'C80001';
        Colors[0,1] := 'C80002';
        Colors[0,2] := 'C80003';
        Colors[0,3] := 'C80004';
        Colors[1,0] := 'FF810A';
        Colors[1,1] := 'FF820A';
        Colors[1,2] := 'FF830A';
        Colors[1,3] := 'FF840A';
        Colors[2,0] := '0100C8';
        Colors[2,1] := '0200C8';
        Colors[2,2] := '0300C8';
        Colors[2,3] := '0400C8';
        Colors[3,0] := '019600';
        Colors[3,1] := '029600';
        Colors[3,2] := '039600';
        Colors[3,3] := '049600';
        Colors[4,0] := 'FFFF01';
        Colors[4,1] := 'FFFF02';
        Colors[4,2] := 'FFFF03';
        Colors[4,3] := 'FFFF04';
        Colors[5,0] := 'FAFFFF';
        Colors[5,1] := 'FBFFFF';
        Colors[5,2] := 'FCFFFF';
        Colors[5,3] := 'FDFFFF';

        W := 0.5;
        WX := W * 0.3;
        WY := WX;
        WZ := W * 0.01;
        DWX := W / 2;
        DWY := DWX;
        DWZ := W + WZ;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Script>
            for i := 0 to 5 do begin
                Color[i] := Colors[i];
                Colors[i] := -1;
            end;
        </Script>

        <Macro Name = "AddSticker" >
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "AddSticker" i = "0" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddSticker" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "AddSticker" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddSticker" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "AddSticker" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddSticker" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

        <Macro Name = "R " > <Turn Axis = "0" Layer = "1" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R'" > <Turn Axis = "0" Layer = "1" Angle = " Pi/2" /> </Macro>
        <Macro Name = "F2" > <Turn Axis = "1" Layer = "0" Angle = " Pi " /> </Macro>
        <Macro Name = "F'" > <Turn Axis = "1" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U " > <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U2" > <Turn Axis = "2" Layer = "1" Angle = " Pi  " /> </Macro>
        <Macro Name = "U'" > <Turn Axis = "2" Layer = "1" Angle = " Pi/2" /> </Macro>

        <ExecMacro MacroName = "R F2 U' F2 R' F' U2 F' U F'" />

        <Macro Name = "CutStickers" >
            <HideContaining Vector = " W/2; W/2; W" />
            <InvertVisibility/>
            <Cut Color = "Colors[c,0]" ><Plane BaseVector = "-W;-W; W" NormVector = "WZ/2;WZ/2;-1" NormDistance = "-c*WZ/10" /></Cut>
            <ShowAll/>
            <HideContaining Vector = " W/2;-W/2; W" />
            <InvertVisibility/>
            <Cut Color = "Colors[c,1]" ><Plane BaseVector = "-W;-W; W" NormVector = "WZ/2;WZ/2;-1" NormDistance = "-c*WZ/10" /></Cut>
            <ShowAll/>
            <HideContaining Vector = "-W/2;-W/2; W" />
            <InvertVisibility/>
            <Cut Color = "Colors[c,2]" ><Plane BaseVector = "-W;-W; W" NormVector = "WZ/2;WZ/2;-1" NormDistance = "-c*WZ/10" /></Cut>
            <ShowAll/>
            <HideContaining Vector = "-W/2; W/2; W" />
            <InvertVisibility/>
            <Cut Color = "Colors[c,3]" ><Plane BaseVector = "-W;-W; W" NormVector = "WZ/2;WZ/2;-1" NormDistance = "-c*WZ/10" /></Cut>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "CutStickers" c = "3" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutStickers" c = "2" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutStickers" c = "1" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutStickers" c = "0" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutStickers" c = "5" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutStickers" c = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <Undo Repeat = "20" />
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameDirectionOrCountUniquePlanes = 12" />
</xml>
