<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Polar Cube</Name>
        <Menu>Cubic\Rubiks Recolored\Polar Cube</Menu>
        <Inventor>Aleksandr Ermolenko</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5360</Link>
    </Interface>

    <Script>
        Color    := '4FCFDF';
        clWhite  := 'FFFFFF';
        clYellow := 'FFFF00';
        W := 0.5;
        D := W / 3;
        DCut1 := W*0.5;
        DCut2 := W*0.6;
        DCut3 := W*0.1;
        DCut4 := W*0.3;

        WX := W;
        WY := W;
        WZ := W;
        for i := 0 to 5 do
            Colors[i] := Color;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>

        // internal cuts for solving procedure
        <Macro Name = "CutUEdge">
            <HideContaining Vector = "W; 0; W" />
            <InvertVisibility/>
            <Cut Color = "Color" > <Plane NormVector = "W; 0; W/2" NormDistance = "DCut1" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <Macro Name = "CutDEdge">
            <HideContaining Vector = "W; 0; W" />
            <InvertVisibility/>
            <Cut Color = "Color" > <Plane NormVector = "W/2; 0; W" NormDistance = "DCut1" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <Macro Name = "CutVertex">
            <HideContaining Vector = "W; W; W" />
            <InvertVisibility/>
            <Cut Color = "Color" > <Plane NormVector = "W; W; W/2" NormDistance = "DCut2" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <Macro Name = "CutCenter">
            <HideContaining Vector = "W; 0; 0" />
            <InvertVisibility/>
            <Cut Color = "Color" > <Plane NormVector = "W; 0; -W" NormDistance = "DCut3" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <Macro Name = "CutCEdge">
            <HideContaining Vector = "W; W; 0" />
            <InvertVisibility/>
            <Cut Color = "Color" > <Plane NormVector = "W; W; -W" NormDistance = "DCut4" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <ExecMacro MacroName = "CutUEdge"  Repeat = "4" Color = "clWhite " Layer = "2" />
        <ExecMacro MacroName = "CutVertex" Repeat = "4" Color = "clWhite " Layer = "2" />
        <ExecMacro MacroName = "CutCenter" Repeat = "4" Color = "clWhite " Layer = "1" />
        <ExecMacro MacroName = "CutCEdge"  Repeat = "4" Color = "clWhite " Layer = "1" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutDEdge"  Repeat = "4" Color = "clWhite " Layer = "0" />
        <ExecMacro MacroName = "CutVertex" Repeat = "4" Color = "clYellow" Layer = "0" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Textures>
        <Texture Name = "ArrayE"  File = "Textures\Polar Cube\ArrayE.vec" />
        <Texture Name = "ArrayV"  File = "Textures\Polar Cube\ArrayV.vec" />
        <Texture Name = "LetterN" File = "Textures\Polar Cube\LetterN.vec" />
        <Texture Name = "LetterS" File = "Textures\Polar Cube\LetterS.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        ArrayE  =  17,1,2, 23,1,0, 11,1,3,  5,1,2
        ArrayE  =   2,0,1, 11,0,0, 20,0,0,  1,0,3, 10,0,3, 19,0,3,  0,0,2,  9,0,3, 18,0,3
        ArrayE  =  20,1,1, 23,0,0, 26,1,0, 19,1,3, 22,0,3, 25,1,3, 18,1,2, 21,0,3, 24,1,3
        ArrayE  =  26,0,1, 17,0,1,  8,0,0, 25,0,3, 16,0,3,  7,0,3, 24,0,2, 15,0,2,  6,0,3
        ArrayE  =   8,1,1,  5,0,1,  2,1,0,  7,1,3,  4,0,3,  1,1,3,  6,1,2,  3,0,2,  0,1,3
        ArrayE  =   9,1,0,  3,1,2, 21,1,0, 15,1,1

        ArrayV  =   8,2,2, 26,2,2,  2,2,2, 20,2,2,  0,2,0, 18,2,0,  6,2,0, 24,2,0

        LetterN = 14,0,1
        LetterS = 12,0,3
    </SetTextures>

</xml>
