<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Cubo Magico</Name>
        <Menu>Cubic\Rubiks Recolored\Master Cubo Magico</Menu>
        <Inventor>Ernő Rubik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3078</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite     
        Colors[ 1] := 'C0C0C0'; // clSilver    
        Colors[ 2] := '0000FF'; // clBlue      
        Colors[ 3] := 'FF0000'; // clRed       
        Colors[ 4] := '776633'; // clBrown     
        Colors[ 5] := 'FFFF00'; // clYellow         
        Colors[ 6] := 'FF8800'; // clOrange    
        Colors[ 7] := '009600'; // clGreen     
        Colors[ 8] := 'FF00FF'; // clFuchsia   
        Colors[ 9] := '0088DD'; // clLightBlue 
        Colors[10] := '00CC55'; // clLightGreen
        Colors[11] := 'FFAAAA'; // clRose	    

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[ 7]" VertexIndexes = "0;1; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = "1;3; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 9]" VertexIndexes = "3;2; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "2;0; 8" InvisibleEdges = "6" />

                <Face Color = "Colors[ 1]" VertexIndexes = "5;4; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[11]" VertexIndexes = "4;6; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "6;7; 9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "7;5; 9" InvisibleEdges = "6" />

                <Face Color = "Colors[ 7]" VertexIndexes = "1;0;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "0;4;10" InvisibleEdges = "6" />
