                <Face Color = "Colors[ 2]" VertexIndexes = "7;6;11" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = "6;2;11" InvisibleEdges = "6" />

                <Face Color = "Colors[ 4]" VertexIndexes = "0;2;12" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = "2;6;12" InvisibleEdges = "6" />
                <Face Color = "Colors[11]" VertexIndexes = "6;4;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "4;0;12" InvisibleEdges = "6" />

                <Face Color = "Colors[ 5]" VertexIndexes = "3;1;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 8]" VertexIndexes = "1;5;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "5;7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = "7;3;13" InvisibleEdges = "6" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
