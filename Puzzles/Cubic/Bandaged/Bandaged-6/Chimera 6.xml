<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chimera 6</Name>
        <Menu>Cubic\Bandaged\Cube 6x6x6\Chimera 6</Menu>
        <Inventor>Andrey Polyakov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-04-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3856</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('211=100, 305, 155, 350');
        ParseTxt('121=010, 530, 515, 035');
        ParseTxt('112=001, 053, 551, 503');
        ParseTxt('221=110, 330, 135, 315');
        ParseTxt('122=011, 033, 513, 531');
        ParseTxt('212=101, 303, 351, 153');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "0" From = "3" To = "5" Angle = "-Pi/2"/>
            <Turn Axis = "1" From = "0" To = "2" Angle = "-Pi/2"/>
            <Turn Axis = "0" From = "3" To = "5" Angle = "Pi/2"/>
            <Turn Axis = "1" From = "0" To = "2" Angle = "Pi/2"/>
            <Turn Axis = "0" From = "3" To = "5" Angle = "-Pi/2"/>
            <Turn Axis = "1" From = "0" To = "2" Angle = "-Pi/2"/>
            <Turn Axis = "0" From = "3" To = "5" Angle = "Pi/2"/>
            <Turn Axis = "1" From = "0" To = "2" Angle = "Pi/2"/>

            <Turn Axis = "2" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "0" From = "3" To = "4" Angle = "Pi/2"/>
            <Turn Axis = "0" From = "5" To = "5" Angle = "Pi/2"/>
            <Turn Axis = "1" From = "3" To = "4" Angle = "Pi"/>
            <Turn Axis = "1" From = "5" To = "5" Angle = "Pi"/>

            <ExecMacro MacroName = "Sc1" Repeat = "50" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
