<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dia-6</Name>
        <Menu>Cubic\Bandaged\Cube 6x6x6\Dia-6</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4683</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('121=523, 503, 105, 033, 031, 034, 014, 013, 125, 011, 511, 524, 032, 502, 012, 522, 504');
        ParseTxt('112=302, 053, 304, 402, 453, 542, 544, 051, 451, 353, 103, 153, 202, 253, 204, 251, 351, 151, 404');
        ParseTxt('211=330, 350, 150, 435, 215, 310, 345, 340, 401, 130, 235, 110, 140, 201, 320, 425, 120, 225, 415');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox element
        <HideContaining Vector = " W;-W;W/2" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = "W_D * 5" DWY = "-W_D * 4" DWZ = "W_D * 3" />
        <InvertVisibility/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "RandomTurns" Repeat = "10000" />
        </Macro>
    </Macros>
</xml>
