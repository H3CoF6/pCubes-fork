<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Special (v1, 6-colors)</Name>
        <Aliases>3 Quads, 3 Stripes</Aliases>
        <Aliases>Quads 3</Aliases>
        <Menu>Cubic\Bandaged\Cube 3x3x3\Special (v1, 6-colors)</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-05-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4481</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveContaining Vector = " 0; 0; 0" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
    </Figure>
</xml>
