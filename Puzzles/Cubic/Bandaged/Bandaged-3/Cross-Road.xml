<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cross-Road</Name>
        <Menu>Cubic\Bandaged\Cube 3x3x3\Cross-Road</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3572</Link>
    </Interface>

    <Script>
        W := 0.5;

        D := W / 3;
        WX := W * 0.1;
        WY := WX;
        WZ := WX;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <HideAll/>

        <Macro Name = "AddInvisibleCubie" >
            <Script> DWX := x * D; DWY := y * D; DWZ := z * D; </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
        </Macro>

        <ExecMacro MacroName = "AddInvisibleCubie" x = "-2" y = "-2" z = " 1" />
        <ExecMacro MacroName = "AddInvisibleCubie" x = "-2" y = " 0" z = " 1" />
        <ExecMacro MacroName = "AddInvisibleCubie" x = "-2" y = " 2" z = " 1" />

        <ExecMacro MacroName = "AddInvisibleCubie" x = "-2" y = "-1" z = "-2" />
        <ExecMacro MacroName = "AddInvisibleCubie" x = " 0" y = "-1" z = "-2" />
        <ExecMacro MacroName = "AddInvisibleCubie" x = " 2" y = "-1" z = "-2" />

        <ExecMacro MacroName = "AddInvisibleCubie" x = " 1" y = " 2" z = "-2" />
        <ExecMacro MacroName = "AddInvisibleCubie" x = " 1" y = " 2" z = " 0" />
        <ExecMacro MacroName = "AddInvisibleCubie" x = " 1" y = " 2" z = " 2" />

        <InvertVisibility/>
    </Figure>

    <Textures>
        <Texture Name = "Lock" File = "Textures\Lock.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Lock =  0,1,1,  9,0,1, 17,1,0
        Lock =  2,2,0,  5,1,0,  8,2,1
        Lock = 23,0,1, 24,0,0, 25,0,0
    </SetTextures>
</xml>
