<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Special (v2, 6-colors)</Name>
        <Menu>Cubic\Bandaged\Cube 3x3x3\Special (v2, 6-colors)</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "2" />

        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "0" />
        <Split Axis = "2" From = "1" />
        <Hide Axis = "2" Layer = "0" />
        <SplitByAxes/>

        <ShowAll/>

        <RemoveContaining Vector = " 0; 0; 0" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
    </Figure>
</xml>
