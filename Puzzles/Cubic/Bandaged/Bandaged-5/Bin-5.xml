<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bin-5</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\Bin-5</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-04-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2054</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('121=022, 002, 024, 004, 402, 000, 422, 020, 421, 401, 001, 021, 423, 003, 023, 403');
        ParseTxt('211=324, 120, 100, 140, 124, 320, 300, 340, 110, 310, 114, 130, 330, 134, 334, 314');
        ParseTxt('112=203, 101, 143, 301, 343, 201, 241, 041, 441, 141, 341, 243, 043, 443, 103, 303');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox element
        <HideContaining Vector = " W;-W; W/2" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = " W_D * 4" DWY = "-W_D * 3" DWZ = " W_D * 2" />
        <InvertVisibility/>
    </Figure>
</xml>
