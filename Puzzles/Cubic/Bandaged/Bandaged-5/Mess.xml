<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mess</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\Mess</Menu>
        <Inventor>José Manuel Garcéa Mouzo</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-05-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=854</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('221=000,300,001,301,002,302,003,303,004,304');
        ParseTxt('221=030,330,031,331,032,332,033,333,034,334');
        ParseTxt('112=200,020,240,420,203,023,243,423');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(5)" Angle = "Pi"/>
            <Turn Axis = "2" Layer = "Random(5)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(5)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "0" Layer = "2" Angle = "Pi/2"/>
            <Turn Axis = "1" Layer = "2" Angle = "Pi/2"/>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "50" />
        </Macro>
    </Macros>
</xml>
