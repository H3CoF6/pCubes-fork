<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x5 - II</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\3x3x5 - II</Menu>
        <Inventor>Anthony Greenhill</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-05-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=855</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('331=110,114');
        ParseTxt('311=100,101,102,103,104,140,141,142,143,144');
        ParseTxt('131=010,011,012,013,014,410,411,412,413,414');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(5)" Angle = "Pi"/>
            <Turn Axis = "2" Layer = "Random(5)" Angle = "Pi / 2"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(5)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "50" />
        </Macro>
    </Macros>
</xml>
