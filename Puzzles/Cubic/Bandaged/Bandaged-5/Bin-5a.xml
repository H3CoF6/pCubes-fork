<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bin-5a</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\Bin-5a</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-16</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('121=002, 220, 400, 120, 300, 402, 000, 020, 224, 024, 124, 401, 001, 023, 423, 403');
        ParseTxt('211=320, 100, 102, 142, 140, 340, 324, 344, 110, 114, 330, 334, 101, 141, 343, 314');
        ParseTxt('112=421, 441, 203, 003, 103, 301, 341, 431, 021, 041, 031, 243, 043, 143, 013, 303');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox element
        <HideContaining Vector = " W;-W; W/2" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = " W_D * 4" DWY = "-W_D * 3" DWZ = " W_D * 2" />
        <InvertVisibility/>
    </Figure>
</xml>
