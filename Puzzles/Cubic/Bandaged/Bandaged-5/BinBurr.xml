<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>BinBurr</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\BinBurr</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-16</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('121=420, 224, 024, 124, 324, 012, 000, 204, 004, 104, 020, 120, 011, 003, 023, 403');
        ParseTxt('211=102, 100, 144, 140, 302, 220, 300, 340, 110, 310, 230, 101, 141, 301, 103, 314');
        ParseTxt('112=421, 001, 242, 441, 423, 443, 142, 411, 431, 433, 041, 341, 031, 043, 343, 303');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox element
        <HideContaining Vector = " W;-W; W/2" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = " W_D * 4" DWY = "-W_D * 3" DWZ = " W_D * 2" />
        <InvertVisibility/>
    </Figure>
</xml>
