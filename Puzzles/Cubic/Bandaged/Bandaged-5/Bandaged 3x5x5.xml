<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bandaged 3x5x5</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\3x5x5</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-05-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2699</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('112=023, 423, 203, 003, 403, 243, 043, 443, 103, 143, 303, 343, 013, 413, 033, 433, 020, 420, 200, 000, 400, 240, 040, 440, 100, 140, 300, 340, 010, 410, 030, 430');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(5)" Angle = "Pi"/>
            <Turn Axis = "2" Layer = "Random(5)" Angle = "Pi/2 * Random(4)"/>

            <Turn Axis = "0" Layer = "3" Angle = " Pi/2"/>
            <Turn Axis = "2" Layer = "2" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "0" Layer = "3" Angle = "-Pi/2"/>
            <Turn Axis = "2" Layer = "2" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "0" Layer = "2" Angle = " Pi/2"/>
            <Turn Axis = "2" Layer = "2" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "0" Layer = "2" Angle = "-Pi/2"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(5)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "500" />
        </Macro>
    </Macros>
</xml>
