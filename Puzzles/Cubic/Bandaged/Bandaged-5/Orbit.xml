<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Orbit</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\Orbit</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-16</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 5;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('112=102, 413, 030');
        ParseTxt('131=104');
        ParseTxt('121=310, 330, 411, 013, 033, 304, 130');
        ParseTxt('211=110, 134, 334, 101, 301, 143, 303, 041');
        ParseTxt('113=010, 341, 431');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox element
        <HideContaining Vector = " W/2;-W; W" />
        <HideContaining Vector = "-W/2; W;-W" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <Split Axis = "1" From = "4" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = " W_D * 2" DWY = "-W_D * 3" DWZ = " W_D * 4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = "-W_D * 2" DWY = " W_D * 3" DWZ = "-W_D * 4" />
        <InvertVisibility/>
    </Figure>
</xml>
