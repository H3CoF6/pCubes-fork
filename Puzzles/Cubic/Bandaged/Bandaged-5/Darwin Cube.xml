<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Darwin Cube</Name>
        <Menu>Cubic\Bandaged\Cube 5x5x5\Darwin Cube</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8931</Link>
    </Interface>

    <Script>
        clOuter  := 'EED9A4';
        clOuter  := '5500CD';
        clBlue   := '0000C8';
        clOrange := 'FF800A';
        clWhite  := 'FFFFFF';

        W := 0.42;
        D1 := W / 5;
        D2 := W * 3 / 5;

        W0 := W;
        W1 := W / 5 * 7;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W = "W1" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />

        <HideContaining Vector = "0;0;0" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "4" />
        <Cut Color = "Colors[1]"><Plane NormVector = "-1; 0; 0" NormDistance = "-W0" /> </Cut>
        <Cut Color = "Colors[3]"><Plane NormVector = " 0;-1; 0" NormDistance = "-W0" /> </Cut>
        <Cut Color = "Colors[4]"><Plane NormVector = " 0; 0; 1" NormDistance = "-W0" /> </Cut>

        <InvertVisibility/>
        <Cut Color = "Colors[0]"><Plane NormVector = " 1; 0; 0" NormDistance = "-W0" /> </Cut>
        <Cut Color = "Colors[2]"><Plane NormVector = " 0; 1; 0" NormDistance = "-W0" /> </Cut>
        <Cut Color = "Colors[5]"><Plane NormVector = " 0; 0;-1" NormDistance = "-W0" /> </Cut>
        <SplitByAxes/>
        <ShowAll/>
        <RemoveGrayParts/>
        <Turn NormVector = "0;0;1" Angle = "Pi/2" />
    </Figure>
</xml>
