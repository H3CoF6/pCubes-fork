<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x3 I-cube</Name>
        <Menu>Cubic\Bandaged\3x3x3 I-cube</Menu>
        <Inventor>Matthew Street</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5694</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <RemoveGrayParts/>
        <HideContaining Vector = " 0; 0; -W" />
        <InvertVisibility/>
        <Cut Axis = "2" To = "1" />
        <ShowAll/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "RandomTurns" >
            <Turn Axis = "0" Layer = "Random(3)" Angle = "2*Pi * Random" />
            <Turn Axis = "1" Layer = "Random(3)" Angle = "2*Pi * Random" />
            <Turn Axis = "2" Layer = "Random(4)" Angle = "2*Pi * Random" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "2" Layer = "0" Angle = "2*Pi * Random" />
            <Turn Axis = "2" Layer = "1" Angle = "2*Pi * Random" />
            <Turn Axis = "2" Layer = "2" Angle = "2*Pi * Random" />
            <Turn Axis = "2" Layer = "3" Angle = "2*Pi * Random" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
