<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x4 Split</Name>
        <Menu>Cubic\Bandaged\Cuboids\3x3x4 Split</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-07-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1890</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 8;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WX := W / 4 * 3;
        WY := WX;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "5" />
        <HideContaining Vector = "0;0;0"/>
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "4" />
        <ShowAll/>
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>
    </Figure>
</xml>
