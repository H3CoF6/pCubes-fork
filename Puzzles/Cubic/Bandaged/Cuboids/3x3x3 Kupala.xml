<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x3 Kupala</Name>
        <Menu>Cubic\Bandaged\Cuboids\3x3x3 Kupala</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-07-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5053</Link>
    </Interface>

    <Script>
        W := 0.65;
        N := 5;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WX := W / 5 * 3;
        WY := W;
        WZ := WX;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Hide Axis = "1" From = "0" To = "1" />
        <Split Axis = "0" From = "3" />
        <ShowAll/>
        <Hide Axis = "1" From = "3" To = "4" />
        <Split Axis = "0" From = "2" />
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
