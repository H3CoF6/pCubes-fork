<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Split 1x2x3 I</Name>
        <Menu>Cubic\Bandaged\Cuboids\Split 1x2x3 I</Menu>
        <Inventor>Jonathan Burn</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4946</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := D * 2;
        WY := W;
        WZ := D;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Split Axis = "0" From = "1" />
        <Undo/>
    </Figure>
</xml>
