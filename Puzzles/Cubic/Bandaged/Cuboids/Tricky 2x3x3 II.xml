<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tricky 2x3x3 II</Name>
        <Menu>Cubic\Bandaged\Cuboids\Tricky 2x3x3 II</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2021-04-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8233</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        N := 6;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WZ := W / 3 * 2 * 1.001;
        WX := W;
        WY := WX;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " W;-W; 0" />
        <HideContaining Vector = "-W; W; 0" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "5" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "5" />
        <ShowAll/>
    </Figure>
</xml>
