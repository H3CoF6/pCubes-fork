<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x4x4 AI</Name>
        <Menu>Cubic\Bandaged\Cuboids\2x4x4 AI</Menu>
        <Inventor>Roberto de la Fuente</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-07-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6181</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "2" From  = "2" />
        <HideContaining Vector = "-W;-W; WZ" />
        <HideContaining Vector = " W; W; WZ" />
        <HideContaining Vector = " W;-W;-WZ" />
        <HideContaining Vector = "-W; W;-WZ" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "3" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "1" From  = "3" />
        <ShowAll/>
    </Figure>
</xml>
