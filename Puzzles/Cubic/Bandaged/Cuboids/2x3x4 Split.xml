<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x3x4 Split</Name>
        <Menu>Cubic\Bandaged\Cuboids\2x3x4 Split</Menu>
        <Inventor>Ryan Beam</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6451</Link>
    </Interface>

    <Script>
        W := 0.55;
        D1 := W / 2;
        D2 := W / 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; 0; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W / 4 * 3" WZ = "W / 2 + 0.001" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <HideContaining Vector = " WX; 0; 0" />
        <HideContaining Vector = "-WX; 0; 0" />
        <Split Axis = "1" From = "2" />
        <ShowAll/>
    </Figure>
</xml>
