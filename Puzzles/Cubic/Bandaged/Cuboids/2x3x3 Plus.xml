<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x3x3 Plus</Name>
        <Menu>Cubic\Bandaged\Cuboids\2x3x3 Plus</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-07-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6766</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WX := W;
        WY := WX;
        WZ := W / 3 * 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "3" />
        <HideContaining Vector = " W; W; 0" />
        <HideContaining Vector = " W;-W; 0" />
        <HideContaining Vector = "-W; W; 0" />
        <HideContaining Vector = "-W;-W; 0" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />
        <HideContaining Vector = " W; 0; WZ" />
        <HideContaining Vector = " 0; W; WZ" />
        <HideContaining Vector = "-W; 0; WZ" />
        <HideContaining Vector = " 0;-W; WZ" />
        <HideContaining Vector = " W; 0;-WZ" />
        <HideContaining Vector = " 0; W;-WZ" />
        <HideContaining Vector = "-W; 0;-WZ" />
        <HideContaining Vector = " 0;-W;-WZ" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>
</xml>
