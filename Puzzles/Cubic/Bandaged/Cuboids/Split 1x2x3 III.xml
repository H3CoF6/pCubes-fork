<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Split 1x2x3 III</Name>
        <Menu>Cubic\Bandaged\Cuboids\Split 1x2x3 III</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7036</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := D * 2;
        WY := W;
        WZ := D;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />

        <Hide Axis = "2" Layer = "1" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" />
        <ShowAll/>
    </Figure>
</xml>
