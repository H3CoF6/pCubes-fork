<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x3 Kolas</Name>
        <Menu>Cubic\Bandaged\Cuboids\3x3x3 Kolas</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5052</Link>
    </Interface>

    <Script>
        W := 0.45;
        D := W / 3;

        WX := W * 4 / 3;
        WY := W * 4 / 3;
        WZ := W;
        DWX :=-D;
        DWY := D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = "0; 0; 0" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
