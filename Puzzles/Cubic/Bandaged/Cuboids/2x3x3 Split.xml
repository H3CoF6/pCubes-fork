<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x3x3 Split</Name>
        <Menu>Cubic\Bandaged\Cuboids\2x3x3 Split</Menu>
        <Inventor>José Manuel Garcéa Mouzo</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-07-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1904</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W / 3 * 2" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <HideContaining Vector = " 0; 0; 0" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <InvertVisibility/>
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>
</xml>
