<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x3x3 Quartered Edges</Name>
        <Menu>Cubic\Bandaged\Cuboids\2x3x3 Quartered Edges</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-05-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7458</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-2*D;-D; D; 2*D" TurnAxesWithLayer = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2"/>
        <Split Axis = "0" From = "3"/>
        <Split Axis = "1" From = "2"/>
        <Split Axis = "1" From = "3"/>
        <Split Axis = "2" From = "1"/>

        <Turn Axis = "0" Layer = "2" Angle = "Pi/2" />
        <Split Axis = "2" From = "1"/>
        <Split Axis = "1" From = "1"/>
        <Split Axis = "1" From = "4"/>
        <Undo/>
        <Turn Axis = "1" Layer = "2" Angle = "Pi/2" />
        <Split Axis = "2" From = "1"/>
        <Split Axis = "0" From = "1"/>
        <Split Axis = "0" From = "4"/>
        <Undo/>
    </Figure>
</xml>
