<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x4x6 Protocuboid</Name>
        <Menu>Cubic\Bandaged\Cuboids\3x4x6 Protocuboid</Menu>
        <Inventor>Matthew Street</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5697</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 8;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WX := W / 4 * 3;
        WY := WX;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "6" />
        <HideContaining Vector =" WX;  0; 0" />
        <HideContaining Vector ="-WX;  0; 0" />
        <HideContaining Vector ="  0; WY; 0" />
        <HideContaining Vector ="  0;-WY; 0" />
        <InvertVisibility/>
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "6" />
        <ShowAll/>
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(8)" Angle = "Pi"/>
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(2)" Layer = "Random(8)" Angle = "Pi"/>
            <Turn Axis = "2" Layer = "Random(8)" Angle = "Pi / 2"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(8)" Angle = "Pi/2 * (Random(3) + 1)"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "Sc2" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "500" />
        </Macro>
    </Macros>
</xml>
