<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>1x2x3 Mashup</Name>
        <Menu>Cubic\Bandaged\Cuboids\1x2x3 Mashup</Menu>
        <Inventor>Jonathan Burn</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4946</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        D := W / 3;

        WX := W / 3 + 0.001;
        WY := WX * 2;
        WZ := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 2" />
        <Split Axis = "1" From = "1" />
        <Undo/>
    </Figure>
</xml>
