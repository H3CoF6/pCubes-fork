<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x3 Uvaha</Name>
        <Menu>Cubic\Bandaged\Cuboids\3x3x3 Uvaha</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6977</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W * 4/3;
        DWZ := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Split Axis = "2" From = "2" />
        <InvertVisibility />
        <Split Axis = "2" From = "1" />
        <ShowAll/>
        <HideContaining Vector = "0;0;0" />
        <InvertVisibility />
        <Split Axis = "2" From = "2" />
        <ShowAll/>
    </Figure>
</xml>
