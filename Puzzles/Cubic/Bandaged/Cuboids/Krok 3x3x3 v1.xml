<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Krok 3x3x3 v1</Name>
        <Menu>Cubic\Bandaged\Cuboids\Krok 3x3x3 v1</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6953</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 2;

        WX := W;
        WY := W;
        WZ := W * 5/4;
        DWZ := W / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />

        <HideContaining Vector = "0;0;0" />
        <InvertVisibility />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
        <RemoveGrayParts />
        <ShowAll/>

        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
    </Figure>
</xml>
