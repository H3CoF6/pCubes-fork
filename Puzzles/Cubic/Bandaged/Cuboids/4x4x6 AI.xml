<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x4x6 AI</Name>
        <Menu>Cubic\Bandaged\Cuboids\4x4x6 AI</Menu>
        <Inventor>James Ruley Rourke</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8697</Link>
    </Interface>

    <Script>
        WZ := 0.6;
        WX := WZ / 1.5 * 1.02;
        WY := WX;
        D := WZ / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*2;-D; 0; D; D*2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From  = "3" />
        <Split Axis = "1" From  = "3" />
        <Split Axis = "2" From  = "3" />
        <HideContaining Vector = "-WX;-WX; WX" />
        <HideContaining Vector = " WX; WX; WX" />
        <HideContaining Vector = " WX;-WX;-WX" />
        <HideContaining Vector = "-WX; WX;-WX" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "4" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "1" From  = "4" />
        <Split Axis = "2" From  = "1" />
        <Split Axis = "2" From  = "2" />
        <Split Axis = "2" From  = "4" />
        <Split Axis = "2" From  = "5" />
        <ShowAll/>
    </Figure>
</xml>
