<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x4x4 Gorgon</Name>
        <Menu>Cubic\Bandaged\Cuboids\4x4x4 Gorgon</Menu>
        <Inventor>Andrey Polyakov</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-11-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4620</Link>
    </Interface>
 
    <Script>
        W := 0.45;
        D := W / 4;

        WX := W;
        WY := W;
        WZ := W * 5 / 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D * 2; 0; D * 2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D * 3; -D; D; D * 3" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "2" />
        <ShowAll/>
    </Figure>
</xml>
