<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x3 (bandaged 3x3x3)</Name>
        <Menu>Cubic\Bandaged\Cuboids\2x2x3 (bandaged 3x3x3)</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5368</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 4;

        WX := W;
        WY := W;
        WZ := D * 3;
        DWX := -D;
        DWY := D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
    </Figure>
</xml>
