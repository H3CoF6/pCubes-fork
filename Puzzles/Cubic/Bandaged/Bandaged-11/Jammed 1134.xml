        <Macro Name = "Scramble" Public = "1" >
            <Script>
                procedure Prepare();
                begin
                    Count := Length(S) div 4;
                    for i := 0 to Count - 1 do begin
                        ax[i]    := StrToInt(copy(S, i * 4 + 1, 1));
                        FromL[i] := HexToInt(copy(S, i * 4 + 2, 1));
                        ToL[i]   := HexToInt(copy(S, i * 4 + 3, 1));
                        Sign     :=          copy(S, i * 4 + 4, 1);
                        Case Sign of
                        '-': A[i] := -Pi/2;
                        '+': A[i] :=  Pi/2;
                        '|': A[i] :=  Pi;
                        end;
                    end;
                end;
            </Script>

