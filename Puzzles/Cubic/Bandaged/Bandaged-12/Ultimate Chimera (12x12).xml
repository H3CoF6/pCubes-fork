<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ultimate Chimera (12x12)</Name>
        <Menu>Cubic\Bandaged\Cube 12x12x12\Ultimate Chimera (12x12)</Menu>
        <Inventor>El Cubitero</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-09-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8383</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 6;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-5*D;-4*D;-3*D;-2*D;-D; 0; D; 2*D; 3*D; 4*D; 5*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Split3" >
            <Split Axis = "0" From = "L" />
            <Split Axis = "1" From = "L" />
            <Split Axis = "2" From = "L" />
            <Split Axis = "0" From = "12 - L" />
            <Split Axis = "1" From = "12 - L" />
            <Split Axis = "2" From = "12 - L" />
        </Macro>

        <LoadFrom File = "Figures\Cube.xml" />
        <ExecMacro MacroName = "Split3" L = "6" />

        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W; W; W" />
        <InvertVisibility/>
        <ExecMacro MacroName = "Split3" L = "3" />
        <RemoveGrayParts/>
        <ShowAll/>

        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = "-W; W;-W" />
        <InvertVisibility/>
        <ExecMacro MacroName = "Split3" L = "2" />
        <ExecMacro MacroName = "Split3" L = "4" />
        <RemoveGrayParts/>
        <ShowAll/>

        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = "-W;-W; W" />
        <InvertVisibility/>
        <ExecMacro MacroName = "Split3" L = "1" />
        <ExecMacro MacroName = "Split3" L = "2" />
        <ExecMacro MacroName = "Split3" L = "3" />
        <ExecMacro MacroName = "Split3" L = "4" />
        <ExecMacro MacroName = "Split3" L = "5" />
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->

        <Macro Name = "Preset" >
            <Turn Axis = "0" Layers = "6-11" Angle = " Pi  " />
            <Turn Axis = "1" Layers = "6-11" Angle = "-Pi/2" />
            <Turn Axis = "2" Layers = "0-5 " Angle = " Pi  " />
            <Turn Axis = "0" Layers = "0-5 " Angle = "-Pi/2" />
        </Macro>

        <Macro Name = "RotateR" >
            <Turn Axis = "0" Layers = "6-11" Angle = "-Pi/2" />
            <Turn Axis = "1" Layers = "0-5 " Angle = "-Pi/2" />
            <Turn Axis = "0" Layers = "6-11" Angle = " Pi/2" />
            <Turn Axis = "1" Layers = "0-5 " Angle = " Pi/2" />
            <Turn Axis = "0" Layers = "6-11" Angle = "-Pi/2" />
            <Turn Axis = "1" Layers = "0-5 " Angle = "-Pi/2" />
            <Turn Axis = "0" Layers = "6-11" Angle = " Pi/2" />
            <Turn Axis = "1" Layers = "0-5 " Angle = " Pi/2" />
        </Macro>

        <Macro Name = "OneIterate" >
            <Script>
                Ax := Random(3);
                Angle := Random(4) * Pi / 2;
            </Script>
            <Turn Axis = "Ax" Layers = "0-11" Angle = "Angle" />
            <ExecMacro MacroName = "RotateR" />
            <Turn Axis = "Ax" Layers = "0-11" Angle = "-Angle" />
            <Turn Axis = "2" Layers = "Random(12)" Angle = "Pi" />
        </Macro>

        <Macro Name = "TwoIterates" >
            <ExecMacro MacroName = "OneIterate" />
            <Turn Axis = "0" Layers = "6-11" Angle = "-Pi/2" />
            <Turn Axis = "0" Layers = "0-5 " Angle = " Pi/2" />
            <ExecMacro MacroName = "OneIterate" />
            <Turn Axis = "0" Layers = "0-5 " Angle = "-Pi/2" />
            <Turn Axis = "0" Layers = "6-11" Angle = " Pi/2" />
        </Macro>

        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(11)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>

        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Preset" />
            <ExecMacro MacroName = "TwoIterates" Repeat = "100" />
            <Turn Axis = "0" Layers = "6-11" Angle = "Pi" />
            <Turn Axis = "1" Layers = "10-11" Angle = "Pi/2" />
            <Turn Axis = "2" Layers = "6-11" Angle = "-Pi/2" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
