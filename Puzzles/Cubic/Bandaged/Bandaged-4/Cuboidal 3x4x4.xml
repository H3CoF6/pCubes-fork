<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboidal 3x4x4</Name>
        <Menu>Cubic\Bandaged\Cube 4x4x4\Cuboidal 3x4x4</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8871</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 2;
        WX := W;
        WY := W;
        WZ := W * 1.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />
    </Figure>
</xml>
