        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>

        <Hide Axis = "2" Layers = "1;2" />
        <Hide Axis = "2" Layers = "4;5" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "5" />

        <Hide Axis = "0" Layers = "1;2" />
        <Hide Axis = "0" Layers = "4;5" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "5" />
        <ShowAll/>
    </Figure>
</xml>
