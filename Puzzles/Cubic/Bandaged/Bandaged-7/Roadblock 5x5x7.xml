        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D*2;-D; D; D*2; D*3" >
