<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Maze 7x7x7</Name>
        <Menu>Cubic\Bandaged\Cube 7x7x7\Maze 7x7x7</Menu>
        <Inventor>Yo-Han Park</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2021-09-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8512</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        W := 0.5;
        N := 7;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('211=030,530,036,536');
        ParseTxt('121=310,340,316,346');
        ParseTxt('112=300,305,360,365');
        ParseTxt('211=103,403,163,463');
        ParseTxt('121=003,053,603,653');
        ParseTxt('112=031,034,631,634');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />

        <!-- almost copy of Cubic_Bandaged.xml -->

        <Macro Name = "RemovePartsX" >
            <RemoveContaining Vector = "ccx; ccy; ccz" />
            <Script>ccx := ccx + WD;</Script>
        </Macro>

        <Macro Name = "RemovePartsY" >
            <ExecMacro MacroName = "RemovePartsX" Repeat = "wx" ccx = "-W + WD / 2 + x * WD" />
            <Script>ccy := ccy + WD;</Script>
        </Macro>

        <Macro Name = "RemovePartsZ" >
            <ExecMacro MacroName = "RemovePartsY" Repeat = "wy" ccy = "-W + WD / 2 + y * WD" />
            <Script>ccz := ccz + WD;</Script>
        </Macro>

        <Macro Name = "RemoveParts" >
            <ExecMacro MacroName = "RemovePartsZ" Repeat = "wz" ccz = "-W + WD / 2 + z * WD" />
        </Macro>

        <!-- add cubie with known bounds -->
        <Macro Name = "AddCubie" >
            <ExecMacro MacroName = "RemoveParts" wx = "SizesX[i]" wy = "SizesY[i]" wz = "SizesZ[i]" x = "CoordX[i]" y = "CoordY[i]" z = "CoordZ[i]" />

            <Script>
                if x      = 0 then cl := clRed    else cl := -1;
                if x + wx = N then cr := clOrange else cr := -1;
                if y      = 0 then cf := clBlue   else cf := -1;
                if y + wy = N then cb := clGreen  else cb := -1;
                if z      = 0 then cd := clYellow else cd := -1;
                if z + wz = N then cu := clWhite  else cu := -1;

                if (wy = 2) or (wz = 2) then begin
                    if (x      = 0)  then cl := MirrorColor;
                    if (x + wx = N)  then cr := MirrorColor;
                end;

                if (wz = 2) or (wx = 2) then begin
                    if (y      = 0)  then cf := MirrorColor;
                    if (y + wy = N)  then cb := MirrorColor;
                end;

                if (wx = 2) or (wy = 2) then begin
                    if (z      = 0)  then cd := MirrorColor;
                    if (z + wz = N)  then cu := MirrorColor;
                end;

                x1 := -W + x * wd;  x2 := x1 + wx * wd;
                y1 := -W + y * wd;  y2 := y1 + wy * wd;
                z1 := -W + z * wd;  z2 := z1 + wz * wd;
            </Script>
            <Part>
                <Vertices>
                    <Add Vector = "x1; y1; z1" />
                    <Add Vector = "x1; y1; z2" />
                    <Add Vector = "x1; y2; z1" />
                    <Add Vector = "x1; y2; z2" />
                    <Add Vector = "x2; y1; z1" />
                    <Add Vector = "x2; y1; z2" />
                    <Add Vector = "x2; y2; z1" />
                    <Add Vector = "x2; y2; z2" />
                </Vertices>

                <Faces>
                    <Face Color = "cf" VertexIndexes = "1;0;4;5" />
                    <Face Color = "cb" VertexIndexes = "2;3;7;6" />
                    <Face Color = "cl" VertexIndexes = "0;1;3;2" />
                    <Face Color = "cr" VertexIndexes = "5;4;6;7" />
                    <Face Color = "cd" VertexIndexes = "0;2;6;4" />
                    <Face Color = "cu" VertexIndexes = "3;1;5;7" />
                </Faces>
            </Part>
            <Script> Inc(i); </Script>
        </Macro>

        <ExecMacro MacroName = "AddCubie" i = "0" Repeat = "pCount" />
        <SaveSolvedState/>
        <Turn Axis = "0" Layers = "0-6" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
