<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>OctoMix Asymmetric</Name>
        <Menu>Cubic\Bandaged\Cube 7x7x7\OctoMix Asymmetric</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-22</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 7;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('121=603, 020, 300, 356, 556, 000, 110, 643, 011, 210, 446, 623, 320, 610, 625, 046, 002, 022, 624, 604, 654, 605');
        ParseTxt('311=160, 150, 161, 140, 162');
        ParseTxt('131=040');
        ParseTxt('211=536, 166, 563, 400, 001, 130, 100, 201, 430, 526, 546, 102, 164, 516');
        ParseTxt('112=665, 655, 051, 463, 405, 465, 041, 644, 631, 601, 363, 064, 503, 564, 403, 044, 505');
        ParseTxt('212=401');
        ParseTxt('122=611');
        ParseTxt('221=410');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox element
        <HideContaining Vector = " W;-W; W*0.6" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = "W_D * 6" DWY = "-W_D * 5" DWZ = "W_D * 4" />
        <InvertVisibility/>
    </Figure>
</xml>
