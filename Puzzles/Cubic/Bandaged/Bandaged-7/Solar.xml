<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Solar</Name>
        <Menu>Cubic\Bandaged\Cube 7x7x7\Solar</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-06-22</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 7;
        W_D := W / N;

        include 'Figures\Scripts\Cubic_Bandaged.inc';

        ParseTxt('121=033, 330, 053, 350, 550, 035, 015, 055, 136, 316, 116, 631, 605, 051');
        ParseTxt('311=030, 165, 336, 156');
        ParseTxt('211=163, 010, 465, 210, 410, 201, 401, 403, 456, 516, 050');
        ParseTxt('112=563, 013, 031, 561, 011, 635, 305, 103, 655, 101, 105, 651, 633, 303, 653, 505, 160');
        ParseTxt('113=361');
        ParseTxt('131=520, 603, 601');
        //ParseTxt('222=505, 050');
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cubic_Bandaged_Autofill.xml" />
        <LoadFrom File = "Figures\Cubic_Bandaged.xml" />

        // split and glue paradox elements
        <HideContaining Vector = " W;-W; W*0.6" />
        <HideContaining Vector = "-W; W;-W*0.6" />
        <InvertVisibility/>
        <Split Axis = "1" From = "1" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <Split Axis = "1" From = "6" Color1 = "-2" Color2 = "-2" InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" />
        <HideAll/>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = " W_D * 6" DWY = "-W_D * 5" DWZ = " W_D * 4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W_D" WY = "W_D*2" WZ = "W_D" DWX = "-W_D * 6" DWY = " W_D * 5" DWZ = "-W_D * 4" />
        <InvertVisibility/>
    </Figure>
</xml>
