<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pretender Cube</Name>
        <Menu>Cubic\Bandaged\Pretender Cube</Menu>
        <Inventor>Adam Zamora</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2019-02-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2460</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W / 4;
        D2 := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; D1; D2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <Split><Plane NormDistance = "-D1" NormVector = " 1; 0; 0" /></Split>
        <Split><Plane NormDistance = "-D1" NormVector = " 0; 1; 0" /></Split>
        <Split><Plane NormDistance = "-D1" NormVector = " 0; 0;-1" /></Split>
        <RemoveGrayParts/>
    </Figure>
</xml>
