                        FromL[i] := StrToInt(copy(S, i * 4 + 2, 1));
                        ToL[i]   := StrToInt(copy(S, i * 4 + 3, 1));
                        Sign     :=          copy(S, i * 4 + 4, 1);
                        Case Sign of
                        '-': A[i] := -Pi/2;
                        '+': A[i] :=  Pi/2;
                        '|': A[i] :=  Pi;
                        end;
                    end;
                end;
