<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x4x4 Floppy I-Cube</Name>
        <Menu>Cubic\Bandaged\3x4x4 Floppy I-Cube</Menu>
        <Inventor>Liapis Nikolaos</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-10-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8504</Link>
    </Interface>
 
    <Script>
        W := 0.5;

        N := 4;

        WD := W / 4;
        for i := 0 to N - 2 do
            D[i] := 2 * WD * i - WD * (N - 2);

        WX  := WD * 4;
        WY  := WD * 4;
        WZ  := WD * 3.5;
        DWX :=-WD * 0;
        DWY :=-WD * 0;
        DWZ :=-WD * 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <RemoveGrayParts/>

        // inner cut centers
        <HideContaining Vector = "DWX;DWY;WZ+DWZ" />
        <InvertVisibility/>
        <Split Axis = "2" From = "3" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
    </Figure>
</xml>
