<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Linked Trominoes</Name>
        <Menu>Cubic\2x2x2 variants\Linked Trominoes</Menu>
        <Inventor>Javier Alla La</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9896</Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W / 4;

        WX := D * 3;
        WY := WX;
        WZ := WX;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D" DWY = " D" DWZ = " D" />
        <SplitByAxes/>

        <RemoveContaining Vector = " 0; W; W" />
        <RemoveContaining Vector = " W; 0; W" />
        <RemoveContaining Vector = " W; W; 0" />
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D" DWY = "-D" DWZ = "-D" />
        <SplitByAxes/>

        <RemoveContaining Vector = " 0;-W;-W" />
        <RemoveContaining Vector = "-W; 0;-W" />
        <RemoveContaining Vector = "-W;-W; 0" />
        <ShowAll/>
    </Figure>
</xml>
