<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fused 3x3x3</Name>
        <Menu>Cubic\Multi-core\Fused 3x3x3</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=452</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6639</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4;
        D2 := D * 2;
        D3 := D * 3;
        A := Pi / 2;

        WX := D3;
        WY := D3;
        WZ := D3;
    </Script>
 
    <Axes TurningAngles = "0; A" PlaneDistances = "D" >
        <Axis NormVector = "-1; 0; 0" BaseVector = "-D; D; D" />
        <Axis NormVector = " 0; 1; 0" BaseVector = "-D; D; D" />
        <Axis NormVector = " 0; 0; 1" BaseVector = "-D; D; D" />

        <Axis NormVector = " 1; 0; 0" BaseVector = " D;-D;-D" />
        <Axis NormVector = " 0;-1; 0" BaseVector = " D;-D;-D" />
        <Axis NormVector = " 0; 0;-1" BaseVector = " D;-D;-D" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D" DWY = " D" DWZ = " D" />
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D" DWY = "-D" DWZ = "-D" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Split><Plane NormVector = "1;0;0"/></Split>
        <Split><Plane NormVector = "0;1;0"/></Split>
        <Split><Plane NormVector = "0;0;1"/></Split>

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "D2" />
    </Figure>
</xml>
