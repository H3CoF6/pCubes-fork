<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rubik's SpeedFusion Cube</Name>
        <Menu>Cubic\Multi-core\Rubik's SpeedFusion Cube</Menu>
        <Inventor>Duane Cash</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1283</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 4;
        D2 := D * 2;
        D3 := D * 3;
        A := Pi / 2;

        WX := D3;
        WY := D3;
        WZ := D3;
    </Script>
 
    <Axes TurningAngles = "0; A" PlaneDistances = "D" >
    </Axes>
 
    <Axes TurningAngles = "0; A; A" PlaneDistances = "-D; D" >
        <Axis NormVector = "-1; 0; 0" BaseVector = "-D2; D2; D2" />
        <Axis NormVector = " 0; 1; 0" BaseVector = "-D2; D2; D2" />
        <Axis NormVector = " 0; 0; 1" BaseVector = "-D2; D2; D2" />

        <Axis NormVector = " 1; 0; 0" BaseVector = " D2;-D2;-D2" />
        <Axis NormVector = " 0;-1; 0" BaseVector = " D2;-D2;-D2" />
        <Axis NormVector = " 0; 0;-1" BaseVector = " D2;-D2;-D2" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D2" DWY = " D2" DWZ = " D2" />
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D2" DWY = "-D2" DWZ = "-D2" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <RemoveContaining Vector = "0; 0; 0" />

        <LoadFrom File = "Figures\CubeMono.xml" Width = "D" Color = "-1" />
    </Figure>
</xml>
