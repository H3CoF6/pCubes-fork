<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Diogen 25</Name>
        <Menu>Cubic\Multi-core\Diogen 25</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7167</Link>
    </Interface>

    <Script>
        W := 0.55;
        D := W / 5;
        D2 := D * 2;
        D3 := D * 3;
        D4 := D * 4;
        A := Pi / 2;
    </Script>
 
    <Axes>
        <Axis TurningAngles = "A; 0   " NormVector = " 1; 0; 0" BaseVector = "-D;-D2; 0" PlaneDistances = "-D   " />
        <Axis TurningAngles = "A; A; 0" NormVector = " 0; 1; 0" BaseVector = "-D;-D2; 0" PlaneDistances = "-D; D" />

        <Axis TurningAngles = "0; A   " NormVector = " 1; 0; 0" BaseVector = " D; D2; 0" PlaneDistances = " D   " />
        <Axis TurningAngles = "0; A; A" NormVector = " 0; 1; 0" BaseVector = " D; D2; 0" PlaneDistances = "-D; D" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D3" WZ = "D3" DWX = " 0" DWY = " 0" DWZ = " 0" />
        <Split><Plane NormVector = "0;1;0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = " D" /></Split>
        <HideContaining Vector = " 0; 0; 0" />
        <Split><Plane NormVector = "1;0;0" NormDistance = " 0" /></Split>
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "D " WY = "D3" WZ = "D3" DWX = " D3" DWY = " 0" DWZ = " 0" />
        <Split><Plane NormVector = "0;1;0" NormDistance = " D" /></Split>
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "D " WY = "D3" WZ = "D3" DWX = "-D3" DWY = " 0" DWZ = " 0" />
        <Split><Plane NormVector = "0;1;0" NormDistance = "-D" /></Split>
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "D4" WY = "D" WZ = "D3" DWX = "0" DWY = "-D4" DWZ = " 0" />
        <Split><Plane NormVector = "1;0;0" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = "1;0;0" NormDistance = "0" /></Split>
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "D4" WY = "D" WZ = "D3" DWX = "0" DWY = " D4" DWZ = " 0" />
        <Split><Plane NormVector = "1;0;0" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = "1;0;0" NormDistance = "0" /></Split>
        <ShowAll/>

        <HideContaining Vector = " 0; 0; 0" />
        <Split><Plane NormVector = "0;0;1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;0;1" NormDistance = " D" /></Split>
        <ShowAll/>
    </Figure>
</xml>
