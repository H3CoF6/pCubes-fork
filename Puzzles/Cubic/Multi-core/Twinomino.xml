<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Twinomino</Name>
        <Menu>Cubic\Multi-core\Twinomino</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>madartilect</Programmer>
        <Added>2024-04-08</Added>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes>
        <Axis TurningAngles = " 0; Pi/2" NormVector = " 0; 1; 0" BaseVector = " 0; 0; 0" PlaneDistances = "D" />
        <Axis TurningAngles = " 0; Pi/2" NormVector = "-1; 0; 0" BaseVector = " 0; 0; 0" PlaneDistances = "D" />
        <Axis TurningAngles = " 0; Pi  " NormVector = " 0;-1; 0" BaseVector = "-D; 0; 0" PlaneDistances = "D" />
        <Axis TurningAngles = " 0; Pi  " NormVector = " 1; 0; 0" BaseVector = " 0; D; 0" PlaneDistances = "D" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " D; W; W" />
                <Add Vector = " D; W;-W" />
                <Add Vector = " D;-W; W" />
                <Add Vector = " D;-W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W;-W;-W" />

                <Add Vector = " D; W; W" />
                <Add Vector = " D; W;-W" />
                <Add Vector = " W; W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " D;-D; W" />
                <Add Vector = " D;-D;-W" />
                <Add Vector = " W;-D; W" />
                <Add Vector = " W;-D;-W" />
            </Vertices>

            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 4; 5; 7; 6 "/>
                <Face Color = "clBlue  " VertexIndexes = " 6; 7; 3; 2 "/>
                <Face Color = "clOrange" VertexIndexes = " 2; 3;13;12 "/>
                <Face Color = "clBlue  " VertexIndexes = "12;13;15;14 "/>
                <Face Color = "clOrange" VertexIndexes = "14;15;11;10 "/>
                <Face Color = "clGreen " VertexIndexes = " 5; 4;10;11 "/>
                <Face Color = "clYellow" VertexIndexes = " 7; 5;11;15;13; 3 "/>
                <Face Color = "clWhite " VertexIndexes = " 2;12;14;10; 4; 6 "/>
            </Faces>
        </Part>
        <SplitByAxes/>

        <HideContaining Vector = "0;0;0" />
        <Split><Plane NormVector = "0;0;1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;0;1" NormDistance = " D" /></Split>
        <ShowAll/>
    </Figure>
</xml>
