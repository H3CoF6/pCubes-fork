<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Siamese Domino</Name>
        <Menu>Cubic\Multi-core\Siamese Domino</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2867</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4;
        D2 := D * 2;
        D3 := D * 3;
        A := Pi;
    </Script>

    <Axes>
        <Axis TurningAngles = "    0; A" NormVector = " 1; 0; 0" BaseVector = " D; D2; 0" PlaneDistances = "    D" />
        <Axis TurningAngles = " 0; A; A" NormVector = " 0; 1; 0" BaseVector = " D; D2; 0" PlaneDistances = "-D; D" />

        <Axis TurningAngles = " A; 0   " NormVector = " 1; 0; 0" BaseVector = "-D;-D2; 0" PlaneDistances = "-D   " />
        <Axis TurningAngles = " A; A; 0" NormVector = " 0; 1; 0" BaseVector = "-D;-D2; 0" PlaneDistances = "-D; D" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D3" WY = "D3" WZ = "D2" DWX = " D " DWY = " D2" DWZ = "0" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D3" WY = "D3" WZ = "D2" DWX = "-D " DWY = "-D2" DWZ = "0" />
        <SplitByAxes/>

        <RemoveContaining Vector = " 0; 0; 0" />
        <Split><Plane NormVector = " 0; 0; 1" /></Split>

        <Script>
            for i := 0 to 3 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D" WZ = "D2" DWX = "0" DWY = "0" DWZ = "0" />
        <Split><Plane NormVector = " 1; 0; 0" /></Split>
    </Figure>
</xml>
