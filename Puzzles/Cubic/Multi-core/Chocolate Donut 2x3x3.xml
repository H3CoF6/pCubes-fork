<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chocolate Donut 2x3x3</Name>
        <Menu>Cubic\Multi-core\Chocolate Donut 2x3x3</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6846</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        H := W * 2 / 4;
        D := W / 2;
        B := H * 3 / 2;
        Delta := W / 10;
    </Script>

    <Axes TurningAngles = "0;Pi;0" PlaneDistances = "0; D" >
        <Axis NormVector = "-1; 0; 0" BaseVector = " 0; B; 0" />
        <Axis NormVector = " 1; 0; 0" BaseVector = " 0;-B; 0" />
        <Axis NormVector = " 0;-1; 0" BaseVector = "-B; 0; 0" />
        <Axis NormVector = " 0; 1; 0" BaseVector = " B; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />
        <SplitByAxes/>
        <RemoveContaining Vector = "-D/2;  -D; 0" />
        <RemoveContaining Vector = " D/2;   D; 0" />
        <RemoveContaining Vector = "   D;-D/2; 0" />
        <RemoveContaining Vector = "  -D; D/2; 0" />
    </Figure>
</xml>
