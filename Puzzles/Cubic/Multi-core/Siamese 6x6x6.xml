<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Siamese 6x6x6</Name>
        <Menu>Cubic\Multi-core\Siamese 6x6x6</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1650</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 9;
        D2 := D * 2;
        D3 := D * 3;
        D4 := D * 4;
        D6 := D * 6;
        A := Pi / 2;
    </Script>

    <Axes>
        <Axis TurningAngles = " 0; A; A; A" NormVector = " 1; 0; 0" BaseVector = " D3; D3; 0" PlaneDistances = "0; D2; D4" />
        <Axis TurningAngles = " 0; A; A; A" NormVector = " 0; 1; 0" BaseVector = " D3; D3; 0" PlaneDistances = "0; D2; D4" />

        <Axis TurningAngles = " A; A; A; 0" NormVector = " 1; 0; 0" BaseVector = "-D3;-D3; 0" PlaneDistances = "-D4;-D2; 0" />
        <Axis TurningAngles = " A; A; A; 0" NormVector = " 0; 1; 0" BaseVector = "-D3;-D3; 0" PlaneDistances = "-D4;-D2; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D6" WY = "WX" WZ = "WX" DWX = " D3" DWY = " D3" DWZ = "0" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D6" WY = "WX" WZ = "WX" DWX = "-D3" DWY = "-D3" DWZ = "0" />
        <SplitByAxes/>

        <RemoveContaining Vector = " 0; 0; 0" />

        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D4" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " 0 " /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D4" /></Split>

        <Script>
            for i := 0 to 3 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D3" WY = "D3" WZ = "D6" DWX = "0" DWY = "0" DWZ = "0" />

        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D " /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D " /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D " /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = " D " /></Split>

        <RemoveGrayParts/>
    </Figure>
</xml>
