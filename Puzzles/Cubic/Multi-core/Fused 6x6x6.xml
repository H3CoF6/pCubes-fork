<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fused 6x6x6</Name>
        <Menu>Cubic\Multi-core\Fused 6x6x6</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2501</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 9;
        D2 := D * 2;
        D3 := D * 3;
        D4 := D * 4;
        D6 := D * 6;
        A := Pi / 2;

        WX := D6;
        WY := D6;
        WZ := D6;
    </Script>
 
    <Axes TurningAngles = "0; A; A; A" PlaneDistances = "0; D2; D4" >
        <Axis NormVector = " 1; 0; 0" BaseVector = " D3; D3; D3" />
        <Axis NormVector = " 0; 1; 0" BaseVector = " D3; D3; D3" />
        <Axis NormVector = " 0; 0; 1" BaseVector = " D3; D3; D3" />

        <Axis NormVector = "-1; 0; 0" BaseVector = "-D3;-D3;-D3" />
        <Axis NormVector = " 0;-1; 0" BaseVector = "-D3;-D3;-D3" />
        <Axis NormVector = " 0; 0;-1" BaseVector = "-D3;-D3;-D3" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D3" DWY = " D3" DWZ = " D3" />
        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D3" DWY = "-D3" DWZ = "-D3" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Split> <Plane NormVector = "1;0;0" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "1;0;0" NormDistance = " D" /> </Split>
        <Split> <Plane NormVector = "0;1;0" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0;1;0" NormDistance = " D" /> </Split>
        <Split> <Plane NormVector = "0;0;1" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0;0;1" NormDistance = " D" /> </Split>

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "D3" />
    </Figure>
</xml>
