<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fused 2x2x2</Name>
        <Menu>Cubic\Multi-core\Fused 2x2x2</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=703</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        D2 := D * 2;
        A := Pi / 2;

        WX := D2;
        WY := D2;
        WZ := D2;
    </Script>
 
    <Axes TurningAngles = "0; A" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" BaseVector = " D; D; D" />
        <Axis NormVector = " 0; 1; 0" BaseVector = " D; D; D" />
        <Axis NormVector = " 0; 0; 1" BaseVector = " D; D; D" />

        <Axis NormVector = "-1; 0; 0" BaseVector = "-D;-D;-D" />
        <Axis NormVector = " 0;-1; 0" BaseVector = "-D;-D;-D" />
        <Axis NormVector = " 0; 0;-1" BaseVector = "-D;-D;-D" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D" DWY = " D" DWZ = " D" />
        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D" DWY = "-D" DWZ = "-D" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "D" />
    </Figure>
</xml>
