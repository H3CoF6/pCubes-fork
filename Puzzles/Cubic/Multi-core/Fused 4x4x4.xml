<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fused 4x4x4</Name>
        <Menu>Cubic\Multi-core\Fused 4x4x4</Menu>
        <Inventor>Ton Dennenbroek</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2020-09-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=660</Link>
    </Interface>

    <Script>
        W  := 0.5;

        D  := W / 6;
        D2 := D * 2;
        D4 := D * 4;
        A := Pi / 2;
    </Script>

    <Axes TurningAngles = "0; A; A" PlaneDistances = " 0; D2" >
        <Axis NormVector = "-1; 0; 0" BaseVector = "-D2; D2; D2" />
        <Axis NormVector = " 0; 1; 0" BaseVector = "-D2; D2; D2" />
        <Axis NormVector = " 0; 0; 1" BaseVector = "-D2; D2; D2" />

        <Axis NormVector = " 1; 0; 0" BaseVector = " D2;-D2;-D2" />
        <Axis NormVector = " 0;-1; 0" BaseVector = " D2;-D2;-D2" />
        <Axis NormVector = " 0; 0;-1" BaseVector = " D2;-D2;-D2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D4" WY = "WX" WZ = "WX" DWX = "-D2" DWY = " D2" DWZ = " D2" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D4" WY = "WX" WZ = "WX" DWX = " D2" DWY = "-D2" DWZ = "-D2" />

        <SplitByAxes/>
        <RemoveContaining Vector = " 0; 0; 0" />

        <Split><Plane NormVector = " 1; 0; 0" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" /></Split>
        <RemoveGrayParts/>

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "D2" />

    </Figure>
</xml>
