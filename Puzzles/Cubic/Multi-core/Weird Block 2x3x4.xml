<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Weird Block 2x3x4</Name>
        <Menu>Cubic\Multi-core\Weird Block 2x3x4</Menu>
        <Inventor>Volker Kienert</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3280</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W / 4;
        D2 := D1 * 2;
        A := Pi / 2;
    </Script>

    <Axes>
        <Axis TurningAngles = " 0; A" NormVector = " 1; 0; 0" BaseVector = " D1; D2; 0" PlaneDistances = "0" />
        <Axis TurningAngles = " 0; A" NormVector = " 0; 1; 0" BaseVector = " D1; D2; 0" PlaneDistances = "0" />

        <Axis TurningAngles = " 0; A" NormVector = "-1; 0; 0" BaseVector = "-D1;-D2; 0" PlaneDistances = "0" />
        <Axis TurningAngles = " 0; A" NormVector = " 0;-1; 0" BaseVector = "-D1;-D2; 0" PlaneDistances = "0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D1 * 3" WY = "D1 * 4" WZ = "D1 * 2" />
        <SplitByAxes/>

        <Split><Plane NormVector = " 0; 1; 0" NormDistance = " 0" /></Split>
        <HideContaining Vector = " 0; 0; 0" />
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " 0" /></Split>
        <HideAll/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = " D2" WY = "D1" WZ = "D2" DWX = "-D1" DWY = " D1*3" DWZ = "0" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = " D2" WY = "D1" WZ = "D2" DWX = " D1" DWY = "-D1*3" DWZ = "0" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = " D1" WY = "D2" WZ = "D2" DWX = " D2" DWY = "    0" DWZ = "0" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = " D1" WY = "D2" WZ = "D2" DWX = "-D2" DWY = "    0" DWZ = "0" />
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " 0" /></Split>
        <InvertVisibility/>
    </Figure>
</xml>
