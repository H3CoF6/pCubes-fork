<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fused 5x5x5</Name>
        <Menu>Cubic\Multi-core\Fused 5x5x5</Menu>
        <Inventor>Tyler Robbins</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=411</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 7;
        D2 := D * 2;
        D3 := D * 3;
        D4 := D * 4;
        D5 := D * 5;
        A := Pi / 2;

        WX := D5;
        WY := D5;
        WZ := D5;
    </Script>
 
    <Axes TurningAngles = "0; A; A" PlaneDistances = "D; D3" >
        <Axis NormVector = " 1; 0; 0" BaseVector = " D2; D2; D2" />
        <Axis NormVector = " 0; 1; 0" BaseVector = " D2; D2; D2" />
        <Axis NormVector = " 0; 0; 1" BaseVector = " D2; D2; D2" />

        <Axis NormVector = "-1; 0; 0" BaseVector = "-D2;-D2;-D2" />
        <Axis NormVector = " 0;-1; 0" BaseVector = "-D2;-D2;-D2" />
        <Axis NormVector = " 0; 0;-1" BaseVector = "-D2;-D2;-D2" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D2" DWY = " D2" DWZ = " D2" />
        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D2" DWY = "-D2" DWZ = "-D2" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Split> <Plane NormVector = "1;0;0" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "1;0;0" NormDistance = " D" /> </Split>
        <Split> <Plane NormVector = "0;1;0" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0;1;0" NormDistance = " D" /> </Split>
        <Split> <Plane NormVector = "0;0;1" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0;0;1" NormDistance = " D" /> </Split>

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "D3" />
    </Figure>
</xml>
