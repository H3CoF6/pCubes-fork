<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rubik's Fusion+ Cube</Name>
        <Menu>Cubic\Multi-core\Rubik's Fusion+ Cube</Menu>
        <Inventor>Duane Cash</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1282</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 4;
        D2 := D * 2;
        D3 := D * 3;
        A := Pi / 2;

        WX := D3;
        WY := D3;
        WZ := D3;
    </Script>
 
    <Axes TurningAngles = "0; A" PlaneDistances = "D" >
        <Axis NormVector = "-1; 0; 0" BaseVector = "-D; D; D2" />
        <Axis NormVector = " 0; 1; 0" BaseVector = "-D; D; D2" />
        <Axis NormVector = " 1; 0; 0" BaseVector = " D;-D;-D2" />
        <Axis NormVector = " 0;-1; 0" BaseVector = " D;-D;-D2" />
    </Axes>
 
    <Axes TurningAngles = "0; A; A" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" BaseVector = "-D; D; D2" />
        <Axis NormVector = " 0; 0;-1" BaseVector = " D;-D;-D2" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" DWX = "-D" DWY = " D" DWZ = " D2" />
        <LoadFrom File = "Figures\Cuboid.xml" DWX = " D" DWY = "-D" DWZ = "-D2" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Split><Plane NormVector = "1;0;0"/></Split>
        <Split><Plane NormVector = "0;1;0"/></Split>
        <RemoveGrayParts/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D2" WZ = "D" DWX = "0" DWY = "0" DWZ = "0" />
    </Figure>
</xml>
