<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dice cube 3x3x3</Name>
        <Menu>Cubic\Domino\Dice cube 3x3x3</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-03-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4592</Link>
    </Interface>

    <Script>
        W := 0.5;
        Color1 := '1E1F1F';
        Color2 := '1F1E1F';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-W/3; W/3" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Script> W := 0.6; </Script>
        <LoadFrom File = "Figures\Cube.xml" />
        <Script> W := 0.5; </Script>
        <Script> include 'Figures\Scripts\Cube_Coordinates.inc'; </Script>
        <SplitByAxes/>

        <HideContaining Vector = " 0; 0; W" />
        <Cut Color = "Color1" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <InvertVisibility/>
        <Cut Color = "Color2" > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <HideContaining Vector = "-W;-W; W" />
        <HideContaining Vector = " W;-W;-W" />
        <Cut Color = "Color1" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <InvertVisibility/>
        <Cut Color = "Color2" > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = " W; W; W" />
        <Cut Color = "Color1" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <InvertVisibility/>
        <Cut Color = "Color2" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <HideContaining Vector = "-W;-W;-W" />
        <HideContaining Vector = "-W;-W; W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = "-W; W; W" />
        <Cut Color = "Color1" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <InvertVisibility/>
        <Cut Color = "Color2" > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = " W; W; W" />
        <Cut Color = "Color1" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <InvertVisibility/>
        <Cut Color = "Color2" > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <HideContaining Vector = "-W;-W;-W" />
        <HideContaining Vector = " 0;-W;-W" />
        <HideContaining Vector = " W;-W;-W" />
        <HideContaining Vector = "-W; W;-W" />
        <HideContaining Vector = " 0; W;-W" />
        <HideContaining Vector = " W; W;-W" />
        <Cut Color = "Color1" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <InvertVisibility/>
        <Cut Color = "Color2" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>
        <ShowAll/>

        <SaveSolvedState/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />

        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Turn Axis = "0" Layer = "0" Angle = "-Pi/2" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Turn Axis = "1" Layer = "0" Angle = "Pi" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Turn Axis = "0" Layer = "0" Angle = "Pi/2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi" />

        <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <SaveSolvedState/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />

        <Undo Repeat = "24" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Textures>
        <Texture Name = "Dice" File = "Puzzles\Cubic\Domino\Dice.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Dice = 14,5,0
        Dice = 2,4,0, 18,3,0
        Dice = 18,4,0, 22,5,0, 26,4,0
        Dice = 0,4,0, 2,5,0, 6,3,0, 8,4,0
        Dice = 6,4,0, 8,5,0, 16,5,0, 24,4,0, 26,5,0
        Dice = 0,5,0, 6,5,0, 9,5,0, 15,5,0, 18,5,0, 24,5,0
    </SetTextures>
</xml>
