<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Domino 2x3x4</Name>
        <Menu>Cubic\Domino\Domino 2x3x4</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3716</Link>
    </Interface>
 
    <Script>
        clBlack0 := '101010';
        clBlack1 := '101011';
        clBlack2 := '101110';
        clBlack3 := '111010';
        clBlack4 := '111110';
        clWhite0 := 'FFFFFF';
        clWhite1 := 'FEFFFF';
        clWhite2 := 'FFFEFF';
        clWhite3 := 'FFFFFE';
        clWhite4 := 'FFFEFE';

        WX := 0.55;
        WY := WX / 4 * 3;
        H := WX / 2 + 0.001;
        D1 := WX / 2;
        D2 := WY / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; 0; D1" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; D2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; 0; D1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-WX; -WY;  0" />
                <Add Vector = "-WX; -WY;  H" />
                <Add Vector = "-WX;  WY;  0" />
                <Add Vector = "-WX;  WY;  H" />
                <Add Vector = " WX; -WY;  0" />
                <Add Vector = " WX; -WY;  H" />
                <Add Vector = " WX;  WY;  0" />
                <Add Vector = " WX;  WY;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite1" VertexIndexes = "1;0;4;5" />
                <Face Color = "clWhite2" VertexIndexes = "2;3;7;6" />
                <Face Color = "clWhite3" VertexIndexes = "0;1;3;2" />
                <Face Color = "clWhite4" VertexIndexes = "5;4;6;7" />
                <Face Color = "clWhite0" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite0" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Color1 = "clWhite0" Color2 = "clWhite0" Axis = "0" From = "1" />
        <Split Color1 = "clWhite0" Color2 = "clWhite0" Axis = "0" From = "2" />
        <Split Color1 = "clWhite0" Color2 = "clWhite0" Axis = "0" From = "3" />
        <Split Color1 = "clWhite1" Color2 = "clWhite1" Axis = "1" From = "1" />
        <Split Color1 = "clWhite2" Color2 = "clWhite2" Axis = "1" From = "2" />
        <HideAll/>

        <Part>
            <Vertices>
                <Add Vector = "-WX; -WY; -H" />
                <Add Vector = "-WX; -WY;  0" />
                <Add Vector = "-WX;  WY; -H" />
                <Add Vector = "-WX;  WY;  0" />
                <Add Vector = " WX; -WY; -H" />
                <Add Vector = " WX; -WY;  0" />
                <Add Vector = " WX;  WY; -H" />
                <Add Vector = " WX;  WY;  0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlack1" VertexIndexes = "1;0;4;5" />
                <Face Color = "clBlack2" VertexIndexes = "2;3;7;6" />
                <Face Color = "clBlack3" VertexIndexes = "0;1;3;2" />
                <Face Color = "clBlack4" VertexIndexes = "5;4;6;7" />
                <Face Color = "clBlack0" VertexIndexes = "0;2;6;4" />
                <Face Color = "clBlack0" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Color1 = "clBlack0" Color2 = "clBlack0" Axis = "0" From = "1" />
        <Split Color1 = "clBlack0" Color2 = "clBlack0" Axis = "0" From = "2" />
        <Split Color1 = "clBlack0" Color2 = "clBlack0" Axis = "0" From = "3" />
        <Split Color1 = "clBlack1" Color2 = "clBlack1" Axis = "1" From = "1" />
        <Split Color1 = "clBlack2" Color2 = "clBlack2" Axis = "1" From = "2" />
        <ShowAll/>

        <SaveSolvedState/>

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

