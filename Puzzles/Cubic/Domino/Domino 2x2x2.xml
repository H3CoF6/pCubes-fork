<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Domino 2x2x2</Name>
        <Menu>Cubic\Domino\Domino 2x2x2</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4832</Link>
    </Interface>
 
    <Script>
        clBlack0 := '101010';
        clBlack1 := '101011';
        clBlack2 := '101110';
        clBlack3 := '111010';
        clBlack4 := '111110';
        clWhite0 := 'FFFFFF';
        clWhite1 := 'FEFFFF';
        clWhite2 := 'FFFEFF';
        clWhite3 := 'FFFFFE';
        clWhite4 := 'FFFEFE';

        W := 0.5;
        H := W;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W;-W; H" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = "-W; W; H" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " W;-W; H" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " W; W; H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite1" VertexIndexes = "1;0;4;5" />
                <Face Color = "clWhite2" VertexIndexes = "2;3;7;6" />
                <Face Color = "clWhite3" VertexIndexes = "0;1;3;2" />
                <Face Color = "clWhite4" VertexIndexes = "5;4;6;7" />
                <Face Color = "clWhite0" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite0" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Color1 = "clWhite0" Color2 = "clWhite0" Axis = "0" From = "1" />
        <Split Color1 = "clWhite0" Color2 = "clWhite0" Axis = "1" From = "1" />
        <HideAll/>

        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-H" />
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W; W;-H" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = " W;-W;-H" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " W; W;-H" />
                <Add Vector = " W; W; 0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlack1" VertexIndexes = "1;0;4;5" />
                <Face Color = "clBlack2" VertexIndexes = "2;3;7;6" />
                <Face Color = "clBlack3" VertexIndexes = "0;1;3;2" />
                <Face Color = "clBlack4" VertexIndexes = "5;4;6;7" />
                <Face Color = "clBlack0" VertexIndexes = "0;2;6;4" />
                <Face Color = "clBlack0" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Color1 = "clBlack0" Color2 = "clBlack0" Axis = "0" From = "1" />
        <Split Color1 = "clBlack0" Color2 = "clBlack0" Axis = "1" From = "1" />
        <ShowAll/>

        <SaveSolvedState/>

		<Turn Axis = "0" Layer = "1" Angle = " Pi" />
		<Turn Axis = "1" Layer = "0" Angle = " Pi" />
		<Turn Axis = "0" Layer = "0" Angle = " Pi" />
        <SaveSolvedState/>

		<Turn Axis = "0" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = "-Pi/2" />
		<Turn Axis = "1" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = " Pi/2" />
		<Turn Axis = "0" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = "-Pi/2" />
		<Turn Axis = "1" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = " Pi/2" />
		<Turn Axis = "0" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "0" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = "-Pi/2" />
		<Turn Axis = "1" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = " Pi/2" />
		<Turn Axis = "0" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = "-Pi/2" />
		<Turn Axis = "1" Layer = "1" Angle = " Pi  " />
		<Turn Axis = "2" Layer = "0" Angle = " Pi/2" />
		<Turn Axis = "0" Layer = "1" Angle = " Pi  " />
        <SaveSolvedState/>

		<Turn Axis = "0" Layer = "1" Angle = " Pi" />
		<Turn Axis = "1" Layer = "0" Angle = " Pi" />
		<Turn Axis = "0" Layer = "0" Angle = " Pi" />
        <SaveSolvedState/>

        <Undo Repeat = "25" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Textures>
        <Texture Name = "Black_1" File = "Puzzles\Cubic\Domino\Black_1.vec" />
        <Texture Name = "Black_2" File = "Puzzles\Cubic\Domino\Black_2.vec" />
        <Texture Name = "Black_3" File = "Puzzles\Cubic\Domino\Black_3.vec" />
        <Texture Name = "Black_4" File = "Puzzles\Cubic\Domino\Black_4.vec" />

        <Texture Name = "White_1" File = "Puzzles\Cubic\Domino\White_1.vec" />
        <Texture Name = "White_2" File = "Puzzles\Cubic\Domino\White_2.vec" />
        <Texture Name = "White_3" File = "Puzzles\Cubic\Domino\White_3.vec" />
        <Texture Name = "White_4" File = "Puzzles\Cubic\Domino\White_4.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Black_1 = 1,3,0
        Black_2 = 3,3,1
        Black_3 = 0,3,1
        Black_4 = 2,3,0

        White_1 = 5,2,0
        White_2 = 7,2,1
        White_3 = 4,2,1
        White_4 = 6,2,0
    </SetTextures>
</xml>
