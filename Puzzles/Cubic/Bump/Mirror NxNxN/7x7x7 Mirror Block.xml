<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>7x7x7 Mirror Block</Name>
        <Menu>Cubic\Bump\NxNxN\7x7x7 Mirror Block</Menu>
        <Inventor>JGOM</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5371</Link>
    </Interface>

    <Script>
        Color := 'AAAAAA'; // Silver

        W := 0.5;

        N := 7;
        WD := 2 * W / (N + 2);
        for i := 0 to N - 2 do
            D[i] := WD * (-N / 2 + 1 + i);

        DWX :=-W * 0.12;
        DWY := W * 0.08;
        DWZ :=-W * 0.04;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = " DWX; DWY; DWZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" />
        <Transfer Vector = "-DWX;-DWY;-DWZ" />

        <!-- at first cut central big gray cube to save time and memory -->
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "0" From = "N-1" />
        <Split Axis = "1" From = "N-1" />
        <Split Axis = "2" From = "N-1" />
        <RemoveContaining Vector = "0; 0; 0" />

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
