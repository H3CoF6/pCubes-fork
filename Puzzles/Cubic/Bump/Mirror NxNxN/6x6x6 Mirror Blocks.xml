<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 6x6x6 (Mirror Blocks)</Name>
        <Aliases>Devil's Blocks</Aliases>
        <Menu>Cubic\Bump\NxNxN\6x6x6 (Mirror Blocks)</Menu>
        <Inventor>Sebastian Häfner</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-11-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6026</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;
        DWX := -W * 0.05;
        DWY := -W * 0.1;
        DWZ := -W * 0.15;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2 * D; -D; 0; D; 2 * D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
