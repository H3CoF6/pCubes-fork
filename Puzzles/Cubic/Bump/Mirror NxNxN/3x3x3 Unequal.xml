<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 3x3x3 Unequal</Name>
        <Menu>Cubic\Bump\NxNxN\3x3x3 (Unequal)</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-08-31</Added>
    </Interface>

    <Script>
        clGold := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := clGold;

        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;
        DWZ :=-W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <SplitByAxes/>

        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
