<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x2 Symmetric Mirror Blocks</Name>
        <Menu>Cubic\Bump\NxNxN\2x2x2 Symmetric Mirror Blocks</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8230</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        WX := W;
        WY := W;
        WZ := W;

        DWX :=-W / 3;
        DWY := W / 3;
        DWZ :=-W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
