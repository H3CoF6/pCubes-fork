<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 5x5x5 (Mirror Block)</Name>
        <Menu>Cubic\Bump\NxNxN\5x5x5 (Mirror Block)</Menu>
        <Inventor>JGOM</Inventor>
        <Programmer>martinss</Programmer>
        <Added>2015-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5040</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W / 5;

        WX := W;
        WY := W;
        WZ := W;
        DWX := -W * 0.1;
        DWY := -W * 0.2;
        DWZ := -W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3 * D; -D; D; 3 * D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
