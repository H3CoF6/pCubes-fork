<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 4x4x4 (Master Mirror Block)</Name>
        <Menu>Cubic\Bump\NxNxN\4x4x4 (Master Mirror Block)</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>martinss</Programmer>
        <Added>2015-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4671</Link>
    </Interface>

    <Script>
        clGold := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := clGold;

        W := 0.5;
        D := W / 2;

        WX := W;
        WY := W;
        WZ := W;
        DWX :=-W * 0.1;
        DWY :=-W * 0.2;
        DWZ :=-W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

   <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>