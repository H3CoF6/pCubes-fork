<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 2x2x2 (Junior Bump Cube)</Name>
        <Menu>Cubic\Bump\NxNxN\2x2x2 (Junior Bump Cube)</Menu>
        <Inventor>Thomas de Bruin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2576</Link>
    </Interface>

    <Script>
        clGold   := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := clGold;

        W := 0.5;

        WX := W;
        WY := W;
        WZ := W;
        DWX := -W * 0.1;
        DWY := -W * 0.25;
        DWZ := -W * 0.4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
