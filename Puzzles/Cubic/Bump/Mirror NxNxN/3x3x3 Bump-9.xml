<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 3x3x3 Bump-9</Name>
        <Menu>Cubic\Bump\NxNxN\3x3x3 (Bump-9)</Menu>
        <Inventor>Sigurd Wedel</Inventor>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-09-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1579</Link>
    </Interface>

    <Script>
        clGold   := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := clGold;

        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;
        DWX := W * 0.3;
        DWY := W * 0.3;
        DWZ := W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>

    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
