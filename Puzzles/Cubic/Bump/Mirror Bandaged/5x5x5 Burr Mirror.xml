<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>5x5x5 Burr Mirror</Name>
        <Menu>Cubic\Bump\Bandaged\5x5x5 Burr Mirror</Menu>
        <Inventor>Manish Rathod</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11215</Link>
    </Interface>

    <Script>
        MirrorColor := 'AB4DAD';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W * 0.12;

        WX := W;
        WY := W;
        WZ := W;
        DWX := -W * 0.03;
        DWY := -W * 0.12;
        DWZ := -W * 0.15;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <Turn Axis = "2" Layers = "1;3" Angle = "Pi/2" />
        

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />

        <HideContaining Vector = "0;0;D*3+0.1" />
        <HideContaining Vector = "0;0;-D*3-0.1" />

        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />

        <InvertVisibility/>
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Hide Axis = "1" Layers = "0;4" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <InvertVisibility/>
        <Hide Axis = "0" Layers = "0;4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Undo Repeat = "2" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
