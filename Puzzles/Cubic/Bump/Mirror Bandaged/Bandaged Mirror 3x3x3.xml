<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bandaged Mirror 3x3x3</Name>
        <Menu>Cubic\Bump\Bandaged\Bandaged Mirror 3x3x3</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-01-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9962</Link>
    </Interface>

    <Script>
        MirrorColor := '7070CD';

        W := 0.5;
        D := W / 3;

        DX := W * 0.1;
        DY :=-W * 0.25;
        DZ :=-W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />
        <Transfer Vector = " DX; DY; DZ" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = " D;-D; D" />
        <SplitByAxes/>
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
