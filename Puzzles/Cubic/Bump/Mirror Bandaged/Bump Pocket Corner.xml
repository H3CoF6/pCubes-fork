<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump Pocket Corner</Name>
        <Menu>Cubic\Bump\Bandaged\Bump Pocket Corner</Menu>
        <Menu>Cubic\Camouflage\Bump Pocket Corner</Menu>
        <Inventor>Daniel Martin Ramos Aguila</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6717</Link>
    </Interface>

    <Script>
        for i := 0 to 5 do
            Colors[i] := 'F0A0A0';

        W := 0.5;
        D := W * 0.3;

        WX := W;
        WY := W;
        WZ := W;
        DWX :=-W * 0.1;
        DWY := W * 0.2;
        DWZ :=-W * 0.4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />

        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <SplitByAxes />
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
