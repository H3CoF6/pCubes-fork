<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mirror Bicube</Name>
        <Menu>Cubic\Bump\Bandaged\Mirror Bicube</Menu>
        <Inventor>Daniel Martin Ramos Aguila</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6105</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';
        W := 0.5;

        Wx := W;
        Wy := W;
        Wz := W;
        DWX := -W/15;
        DWY :=  W/5;
        DWZ := -W/3;

        for i := 0 to 5 do
            Colors[i] := MirrorColor;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "2" />

        <Hide Axis = "0" From = "0" To = "1" />
        <Hide Axis = "1" From = "0" To = "0" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>

        <Hide Axis = "2" From = "0" To = "1" />
        <Hide Axis = "0" From = "2" To = "2" />
        <Split Axis = "1" From = "2" />
        <ShowAll/>

        <Hide Axis = "1" From = "1" To = "2" />
        <Hide Axis = "2" From = "2" To = "2" />
        <Split Axis = "0" From = "1" />
        <ShowAll/>

        <Hide Axis = "0" From = "2" To = "2" />
        <Hide Axis = "1" From = "0" To = "0" />
        <Hide Axis = "2" From = "2" To = "2" />
        <Split Axis = "0" From = "1" />
        <Hide Axis = "0" From = "1" To = "1" />
        <Split Axis = "1" From = "2" />
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
