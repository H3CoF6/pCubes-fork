<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>AI Cube Mirror 2x2x4</Name>
        <Menu>Cubic\Bandaged\Cube 4x4x4\AI Cube Mirror 2x2x4</Menu>
        <Menu>Cubic\Bump\Bandaged\AI Cube Mirror 2x2x4</Menu>
        <Inventor>Daniel Martin Ramos Aguila</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-08-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7778</Link>
    </Interface>

    <Script>
        clViolett := '800080';

        W := 0.5;
        D := W / 2;

        DX := W * 0.14;
        DY :=-W * 0.1;
        DZ := W * 0.04;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = " DX; DY; DZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "clViolett" />
        <Transfer Vector = "-DX;-DY;-DZ" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <HideContaining Vector = " D; D; D" />
        <HideContaining Vector = " D;-D;-D" />
        <HideContaining Vector = "-D; D;-D" />
        <HideContaining Vector = "-D;-D; D" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
