<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Mirror 4x4x4 Cube</Name>
        <Menu>Cubic\Bump\Bandaged\Super Mirror 4x4x4 Cube</Menu>
        <Menu>Cubic\Bandaged\Cube 7x7x7\Super Mirror 4x4x4 Cube</Menu>
        <Inventor>Lee Zhen Xing</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-10-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11431</Link>
    </Interface>

    <Script>
        Color1 := 'E0C07D'; // Gold
        Color2 := 'AAAAAA'; // Silver

        W := 0.5;

        N := 7;
        WD := 2 * W / (N + 2);
        for i := 0 to N - 2 do
            D[i] := WD * (-N / 2 + 1 + i);

        DWX :=-W * 0.08;
        DWY :=-W * 0.04;
        DWZ := W * 0.12;

        W0 := W;
        W := WD / 2 * 5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddCube" >
            <Transfer Vector = " DWX; DWY; DWZ" />
            <LoadFrom File = "Figures\CubeMono.xml" Width = "W0" />
            <Transfer Vector = "-DWX;-DWY;-DWZ" />
            <Split Axis = "0" From = "1" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "2" From = "1" />
            <Split Axis = "0" From = "N-1" />
            <Split Axis = "1" From = "N-1" />
            <Split Axis = "2" From = "N-1" />
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "AddCube" Color = "Color1" />
        <HideContaining Vector = " Cx; Cy; Cz" />
        <RemoveAllVisible/>
        <ShowAll/>
        <Turn Axis = "2" Layers = "1-5" Angle = "Pi" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "4" />
        <Undo/>
        <HideAll/>
        
        <ExecMacro MacroName = "AddCube" Color = "Color2" />
        <RemoveContaining Vector = " Cx; Cy; Cz" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "4" />
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
