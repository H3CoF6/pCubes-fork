<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Quad 3 Bump Cube</Name>
        <Menu>Cubic\Bump\Bandaged\Quad 3 Bump Cube</Menu>
        <Menu>Cubic\Bandaged\Cube 3x3x3\Quad 3 Bump Cube</Menu>
        <Inventor>Joachim Solborg</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-06-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8663</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';
        BorderColor := 'C80000';

        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;

        DWX := W * 0.3;
        DWY := W * 0.2;
        DWZ :=-W * 0.1;

        procedure SetColor(Color);
        begin
            for i := 0 to 5 do
                Colors[i] := Color;
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Cube">
            <Script> SetColor(Color); </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Split Axis = "0" From = "1" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "2" From = "2" />
        </Macro>

        <ExecMacro MacroName = "Cube" Color = "BorderColor"/>
        <HideContaining Vector = "DWX - W;  0;  0" />
        <HideContaining Vector = " 0; DWY - W;  0" />
        <HideContaining Vector = " 0;  0; DWZ + W" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "Cube" Color = "MirrorColor"/>
        <RemoveContaining Vector = "DWX - W;  0;  0" />
        <RemoveContaining Vector = " 0; DWY - W;  0" />
        <RemoveContaining Vector = " 0;  0; DWZ + W" />
        <SplitByAxes/>

        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
