<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x5x5 Bump Cuboid</Name>
        <Alias>I-Cube Bumpoid 4x5x5</Alias>
        <Menu>Cubic\Bump\Cuboids\4x5x5 Bump Cuboid</Menu>
        <Inventor>Reiden Chea</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6393</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W / 5;

        X := 5;
        Y := 5;
        Z := 4;

        Add := 1.1;

        WX := D * (X + Add);
        WY := D * (Y + Add);
        WZ := D * (Z + Add);

        DWX := W * 0.04;
        DWY := W * 0.08;
        DWZ := W * 0.12;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D*3;-D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*2; 0; D*2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
