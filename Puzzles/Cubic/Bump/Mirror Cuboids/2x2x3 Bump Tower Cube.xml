<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 2x2x3</Name>
        <Aliases>Bump Tower Cube</Aliases>
        <Menu>Cubic\Bump\Cuboids\2x2x3 (Bump Tower Cube)</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3410</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6346</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;
        DWX := -W * 0.1;
        DWY := -W * 0.25;
        DWZ := -W * 0.4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
