<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x4x6 Mirror</Name>
        <Menu>Cubic\Bump\Cuboids\4x4x6 Mirror</Menu>
        <Inventor>Adriano Pallares</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9121</Link>
    </Interface>
 
    <Script>
        MirrorColor := 'E0C07D';
        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W  := 0.55;
        WX := W * 2 / 3 * 1.15;
        WY := W * 2 / 3 * 1.1;
        WZ := W * 1.1;
        DWX :=-W * 0.05;
        DWY := W * 0.06;
        DWZ :=-W * 0.07;
        D1 := W / 3;
        D2 := 2 * D1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; 0; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
