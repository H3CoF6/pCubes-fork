<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump 3x3x2 (2/3 Bump Cube)</Name>
        <Menu>Cubic\Bump\Cuboids\3x3x2 (2/3 Bump Cube)</Menu>
        <Inventor>Hidetoshi Takeji</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4126</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W * 2 / 3;
        DWX := -W * 0.1;
        DWY := -W * 0.25;
        DWZ := -W * 2 / 15;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
