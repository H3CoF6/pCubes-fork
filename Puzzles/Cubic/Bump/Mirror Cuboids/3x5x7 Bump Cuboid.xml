<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x5x7 Bump Cuboid</Name>
        <Menu>Cubic\Bump\Cuboids\3x5x7 Bump Cuboid</Menu>
        <Inventor>Casey Weaver</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6314</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7317</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        X := 5;
        Y := 7;
        Z := 3;

        Add := 1.3;

        N := Max(Max(x, y), z);
        WD := W / (N / 2 + Add);
        for i := 0 to N - 2 do
            D[i] := WD * i - WD * (N / 2 - 1);

        WX := WD * (X / 2 + Add);
        WY := WD * (Y / 2 + Add);
        WZ := WD * (Z / 2 + Add);

        DX := W * 0.01;
        DY := W * 0.02;
        DZ := W * 0.03;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = " DX; DY; DZ" />
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Macro Name = "Split" >
            <Transfer Vector = "-DX;-DY;-DZ" />
            <Split><Plane NormVector = "Cx[c];Cy[c];Cz[c]" NormDistance = "WD * (-L / 2 + i)" /></Split>
            <Transfer Vector = " DX; DY; DZ" />
            <Script>Inc(i);</Script>
        </Macro>

        <ExecMacro MacroName = "Split" c = "0" i = "1" L = "X" />
        <ExecMacro MacroName = "Split" c = "1" i = "1" L = "X" />
        <ExecMacro MacroName = "Split" c = "2" i = "1" L = "Y" />
        <ExecMacro MacroName = "Split" c = "3" i = "1" L = "Y" />
        <ExecMacro MacroName = "Split" c = "4" i = "1" L = "Z" />
        <ExecMacro MacroName = "Split" c = "5" i = "1" L = "Z" />
        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />
        <ExecMacro MacroName = "Split" c = "0" i = "1" L = "N" />
        <ExecMacro MacroName = "Split" c = "1" i = "1" L = "N" />
        <ExecMacro MacroName = "Split" c = "4" i = "1" L = "N" />
        <ExecMacro MacroName = "Split" c = "5" i = "1" L = "N" />
        <RemoveGrayParts/>
        <ShowAll/>

        <ExecMacro MacroName = "Split" c = "1" L = "X" i = "2" Repeat = "X - 3" />
        <ExecMacro MacroName = "Split" c = "3" L = "Y" i = "2" Repeat = "Y - 3" />
        <ExecMacro MacroName = "Split" c = "5" L = "Z" i = "2" Repeat = "Z - 3" />

        <Transfer Vector = "-DX;-DY;-DZ" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>N := 7;</Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
