<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x3 Color Blocks</Name>
        <Menu>Cubic\Bump\3x3x3 Color Blocks</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-01-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10779</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W;
        DWX :=-W * 0.1;
        DWY :=-W * 0.23;
        DWZ := W * 0.35;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        
        <SplitByAxes/>

        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
