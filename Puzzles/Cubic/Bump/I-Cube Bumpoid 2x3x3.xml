<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>I-Cube Bumpoid 2x3x3</Name>
        <Menu>Cubic\Bump\I-Cube Bumpoid 2x3x3</Menu>
        <Inventor>Reiden Chea</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5683</Link>
    </Interface>

    <Script>
        MirrorColor := 'E0C07D';

        for i := 0 to 5 do
            Colors[i] := MirrorColor;

        W := 0.5;
        D := W / 3;

        WX := W * 1.1;
        WY := W * 1.1;
        WZ := W * 0.8;
        DWX := -W * 0.1;
        DWY := -W * 0.07;
        DWZ := -W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
      
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />
</xml>
