<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x9 Cubic Bump</Name>
        <Menu>Cubic\3x3xN Cube\3x3x9 Bump</Menu>
        <Inventor>Matthew Street</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6347</Link>
    </Interface>

    <Script>
        MirrorColor := '800080';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        N := 9;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        DX := W * 0.2;
        DY := W * 0.12;
        DZ := W * 0.10;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "MirrorColor" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "8" />

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "8" />
        <RemoveGrayParts/>
        <ShowAll/>
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "7" />

        <HideContaining Vector = " 0; 0; W" />
        <InvertVisibility/>
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <ShowAll/>

        <HideContaining Vector = " 0; 0;-W" />
        <InvertVisibility/>
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <ShowAll/>
        <Transfer Vector = " DX; DY; DZ" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 6" />

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "0" Layers = "3-5" Angle = " Pi/2" />
            <Turn Axis = "2" Layers = "3-5" Angle = " Pi/2" />
            <Turn Axis = "0" Layers = "3-5" Angle = "-Pi/2" />

            <Turn Axis = "0" Layer = "0" Angle = "Pi" />

            <Turn Axis = "2" Layer = "0" Angle = "Pi   * Random(2)" />
            <Turn Axis = "2" Layer = "1" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "2" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "3" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "4" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "5" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "6" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "7" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "8" Angle = "Pi   * Random(2)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(9)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "2" Layer = "0" Angle = "Pi/2" />
            <ExecMacro MacroName = "Sc1" Repeat = "20" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
