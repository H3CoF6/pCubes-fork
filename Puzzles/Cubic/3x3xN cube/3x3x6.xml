<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

Problem: Manual scrambling

    <Interface>
        <Name>3x3x6 Cubic</Name>
        <Menu>Cubic\3x3xN Cube\3x3x6</Menu>
        <Inventor>Cube4You</Inventor>
        <Programmer>Andre Kutepow</Programmer>
        <Added>2017-09-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4011</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 18;

        D := 2 * W / N;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*7; -D*6; -D*5; -D*3; D*3; D*5; D*6; D*7" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />

        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "8" />

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0;-W" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "8" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>

        <RemoveGrayParts/>
    </Figure>

    <!-- Scramble macro -->
    <Macros>
        <Macro Name = "Exch" >
            <Turn Axis = "0" Layers = "5-8" Angle = "-Pi    " />
            <Turn Axis = "2" Layers = "0-3" Angle = "-Pi / 2" />
            <Turn Axis = "0" Layers = "5-8" Angle = " Pi    " />
            <Turn Axis = "2" Layers = "0-3" Angle = " Pi    " />
            <Turn Axis = "0" Layers = "5-8" Angle = " Pi    " />
            <Turn Axis = "2" Layers = "0-3" Angle = " Pi / 2" />
            <Turn Axis = "0" Layers = "5-8" Angle = " Pi    " />
            <Turn Axis = "2" Layers = "0-3" Angle = "-Pi / 2" />
            <Turn Axis = "0" Layers = "5-8" Angle = " Pi    " />
            <Turn Axis = "2" Layers = "0-3" Angle = "-Pi    " />
            <Turn Axis = "0" Layers = "5-8" Angle = " Pi    " />
            <Turn Axis = "2" Layers = "0-3" Angle = " Pi / 2" />
            <Turn Axis = "0" Layers = "5-8" Angle = " Pi    " />
        </Macro>
        <Macro Name = "Horz" >
            <Turn Axis = "2" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Sc1" >
            <ExecMacro MacroName = "Exch" />
            <ExecMacro MacroName = "Horz" Repeat = "N" />
            <Turn Axis = "0" Layers = "0-8" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script> N := 9; </Script>
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
