<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Slim 3x3x6</Name>
        <Menu>Cubic\3x3xN cube\Slim 3x3x6</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7034</Link>
    </Interface>

    <Script>
        W := 0.5;

        WX := W;
        WY := W;
        WZ := W / 3 * 2;

        D1 := WZ / 3;
        D2 := D1 * 2;
        D3 := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D3; D3" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; 0; D1; D2" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
