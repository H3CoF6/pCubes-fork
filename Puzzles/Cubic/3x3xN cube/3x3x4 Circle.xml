<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x4 Circle</Name>
        <Menu>Cubic\3x3xN Cube\3x3x4 Circle</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1804</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W;

        D1 := W / 2;
        D2 := W / 3;
        R := W * 0.8;
        WC := WZ * 1.004;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D2; D2" TurnAxesWithPartNo = "33" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2 * D1; -D1; 0; D1; 2 * D1" TurnAxesWithPartNo = "33" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Circle Radius = "R" Color = "clWhite " Center = " 0; 0; WC" />
        <Circle Radius = "R" Color = "clYellow" Center = " 0; 0;-WC" />
        <SplitByAxes/>
        <Connect Axis = "2" Layers = "0;2;5" />
    </Figure>
</xml>
