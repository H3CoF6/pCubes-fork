<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>RoadBlock I</Name>
        <Menu>Cubic\3x3xN Cube\RoadBlock I</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2734</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 9;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>

        <Hide Axis = "2" From = "3" To = "5" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <ShowAll/>
        <Hide Axis = "0" From = "3" To = "5" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <ShowAll/>
        <Hide Axis = "1" From = "3" To = "5" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <ShowAll/>
    </Figure>

</xml>
