<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x7 Cubic Super</Name>
        <Menu>Cubic\3x3xN Cube\3x3x7 Super</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-07-08</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 9;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "8" />

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "8" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "7" />

        <Hide Axis = "2" From = "0" To = "2" />
        <Hide Axis = "2" From = "6" To = "8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "7" />
        <Split Axis = "1" From = "8" />
        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "8" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>

    <Macros>
        <Macro Name = "L " > <Turn Axis = "0" From = "0" To = "2" Angle = " Pi/2" /> </Macro>
        <Macro Name = "L'" > <Turn Axis = "0" From = "0" To = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "E2" > <Turn Axis = "2" From = "3" To = "5" Angle = " Pi  " /> </Macro>
        <Macro Name = "R " > <Turn Axis = "0" From = "6" To = "8" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R'" > <Turn Axis = "0" From = "6" To = "8" Angle = " Pi/2" /> </Macro>

        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <ExecMacro MacroName = "L E2 L' R E2 R'" /> // exchange edges

            <Turn Axis = "2" Layer = "0" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "1" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "2" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "6" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "7" Angle = "Pi/2 * Random(4)" />
            <Turn Axis = "2" Layer = "8" Angle = "Pi/2 * Random(4)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(9)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
