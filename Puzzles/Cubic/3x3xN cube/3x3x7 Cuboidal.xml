<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x7 Cuboidal</Name>
        <Menu>Cubic\3x3xN Cube\3x3x7 Cuboidal</Menu>
        <Inventor>Matthew Street</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-18</Added>
    </Interface>

    <Script>
        W := 0.5;
        N := 9;

        WD := 2 * W / N;
        for i := 0 to 2 do
            D[i] := -W + WD + WD * i;
        for i := 5 to 7 do
            D[i-2] := -W + WD + WD * i;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" TurnAxesWithLayer = "3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Turn Axis = "0" Layer = "3" Angle = "Pi/2" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi/2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "0" From = "6" />
        <Undo Repeat = "2" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "1" Layer = "Random(7)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(7)" Angle = "Pi" />
            <Turn Axis = "0" Layer = "Random(7)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(7)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "0" Layer = "3" Angle = "Pi/2" />
            <Turn Axis = "2" Layer = "3" Angle = "Pi/2" />
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
