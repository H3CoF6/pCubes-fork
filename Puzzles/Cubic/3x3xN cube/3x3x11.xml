<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x11</Name>
        <Menu>Cubic\3x3xN Cube\3x3x11</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8093</Link>
    </Interface>

    <Script>
        W := 0.5;
        DZ := W * 0.996;
        N := 9;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;

        WX := W;
        WY := W;
        WZ := W + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-DZ; D; DZ" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "7" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "7" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "10" />

        <HideContaining Vector = "Vx;Vy;Vz" />
        <HideContaining Vector = "Ex;Ey;Ez" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "9" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "9" />
        <RemoveGrayParts/>
        <ShowAll/>
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "6" />
        <Split Axis = "2" From = "7" />
        <Split Axis = "2" From = "8" />
        <Split Axis = "2" From = "9" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(11)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(11)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(11)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "200" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
