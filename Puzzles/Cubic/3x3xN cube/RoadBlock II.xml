<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>RoadBlock II</Name>
        <Menu>Cubic\3x3xN Cube\RoadBlock II</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2735</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 9;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "6" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "6" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "6" />
        <RemoveGrayParts/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "8" />
        <Split Axis = "2" From = "8" />
        <RemoveGrayParts/>
        <ShowAll/>
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <RemoveGrayParts/>
        <Hide Axis = "2" From = "0" To = "6" />
        <HideContaining Vector = " 0; 0; W" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "5" />
        <ShowAll/>
    </Figure>

    <Macros>
        <Macro Name = "L " > <Turn Axis = "0" From = "0" To = "2" Angle = " Pi/2" /> </Macro>
        <Macro Name = "L'" > <Turn Axis = "0" From = "0" To = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "M " > <Turn Axis = "0" From = "3" To = "5" Angle = " Pi/2" /> </Macro>
        <Macro Name = "M'" > <Turn Axis = "0" From = "3" To = "5" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R " > <Turn Axis = "0" From = "6" To = "8" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R2" > <Turn Axis = "0" From = "6" To = "8" Angle = " Pi  " /> </Macro>
        <Macro Name = "R'" > <Turn Axis = "0" From = "6" To = "8" Angle = " Pi/2" /> </Macro>
        <Macro Name = "D " > <Turn Axis = "2" From = "0" To = "2" Angle = " Pi/2" /> </Macro>
        <Macro Name = "D2" > <Turn Axis = "2" From = "0" To = "2" Angle = " Pi  " /> </Macro>
        <Macro Name = "D'" > <Turn Axis = "2" From = "0" To = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "E " > <Turn Axis = "2" From = "3" To = "5" Angle = " Pi/2" /> </Macro>
        <Macro Name = "E'" > <Turn Axis = "2" From = "3" To = "5" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U'" > <Turn Axis = "2" From = "6" To = "8" Angle = " Pi/2" /> </Macro>
        <Macro Name = "F2" > <Turn Axis = "1" From = "0" To = "2" Angle = " Pi  " /> </Macro>
        <Macro Name = "S " > <Turn Axis = "1" From = "3" To = "5" Angle = " Pi/2" /> </Macro>
        <Macro Name = "S'" > <Turn Axis = "1" From = "3" To = "5" Angle = "-Pi/2" /> </Macro>

        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <ExecMacro MacroName = "L' D2 L D L' D2 R D' L D R2 E R U' R' E' R M F2 M' S' M F2 M' S " />
            <Turn Axis = "2" Layer = "0" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "1" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "2" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "3" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "4" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "5" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "6" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(9)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "40" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
