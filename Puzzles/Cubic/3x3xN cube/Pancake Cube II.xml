<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pancake Cube II</Name>
        <Menu>Cubic\3x3xN Cube\Pancake Cube II</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4765</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 27;

        L1 := N / 3;
        L2 := 2 * L1;
        HD := 2 * W / N;
        D[0] := -W + HD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + HD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "L1" />
        <Split Axis = "0" From = "L2" />
        <Split Axis = "1" From = "L1" />
        <Split Axis = "1" From = "L2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "N-1" />
        <RemoveGrayParts/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "N-1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "N-1" />
        <RemoveGrayParts/>
        <ShowAll/>

        <Macro Name = "Split">
            <Split Axis = "2" From = "i" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" i = "2" Repeat = "N-3" />
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(N)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(N)" Angle = "Pi/2 * Random(4)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(N)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" N = "27" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
