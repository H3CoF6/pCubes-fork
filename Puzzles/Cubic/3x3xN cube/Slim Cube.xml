<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Slim Cube</Name>
        <Menu>Cubic\3x3xN cube\Slim Cube</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2028</Link>
    </Interface>

    <Script>
        W := 0.5;
        WX := W;
        WY := W;
        WZ := W / 3;

        D1 := WZ / 3;
        D2 := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi " PlaneDistances = "-D2; D2" >
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
