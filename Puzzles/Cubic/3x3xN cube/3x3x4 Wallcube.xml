<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x4 Wallcube</Name>
        <Menu>Cubic\3x3xN Cube\3x3x4 Wallcube</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1791</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Turn  Axis = "0" Layers = "0;4" Angle = "Pi/2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "5" />
        <RemoveGrayParts/>

        <Split Axis = "2" From = "3" />
        <Undo/>
    </Figure>
</xml>
