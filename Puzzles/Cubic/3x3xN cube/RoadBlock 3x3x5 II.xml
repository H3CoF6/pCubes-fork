<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>RoadBlock 3x3x5 II</Name>
        <Menu>Cubic\3x3xN Cube\RoadBlock 3x3x5 II</Menu>
        <Inventor>Ting Huang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11905</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 6;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <HideContaining Vectors = "Ex;Ey;Ez" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>
        <HideContaining Vectors = "Cx;Cy;Cz" />
        <InvertVisibility/>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "5" />
        <ShowAll/>
        <RemoveGrayParts/>

    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "1" Layers = "2;3" Angle = " Pi/2" />
            <Turn Axis = "0" Layers = "4;5" Angle = " Pi  " />
            <Turn Axis = "1" Layers = "2;3" Angle = "-Pi/2" />
            <Turn Axis = "2" Layer = "Random(6)" Angle = "Pi/2 * Random(4)" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
