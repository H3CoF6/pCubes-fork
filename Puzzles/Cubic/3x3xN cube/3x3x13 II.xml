<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x13 II</Name>
        <Menu>Cubic\3x3xN Cube\3x3x13 II</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-06-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8478</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 13;
        WX := W / N * 9;
        WY := WX;
        WZ := W;

        WD := 2 * W / N;
        D[0] := -W + WD;
        for i := 1 to N - 2 do
            D[i] := D[i-1] + WD;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "1" From = "8" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "8" />
        <Split Axis = "2" From = "9" />
        <Split Axis = "2" From = "10" />
        <Split Axis = "2" From = "11" />
        <Split Axis = "2" From = "12" />

        <Hide  Axis = "2" To   = "4" />
        <Hide  Axis = "2" From = "8" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "9" />
        <Split Axis = "1" From = "10" />
        <Hide  Axis = "1" To   = "4" />
        <Hide  Axis = "1" From = "8" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "10" />
        <ShowAll/>
        <HideContaining Vector = "0;0;D[0]" />
        <HideContaining Vector = "0;0;-D[0]" />
        <RemoveGrayParts/>
        <HideAll/>

        <!-- Invisible parts to prevent some moves -->
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />

        <Split Axis = "0" From = "5" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "1" From = "8" />
        <RemoveContaining Vector = "0;0;0" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Split Axis = "2" From = "8" />
        <Split Axis = "2" From = "9" />
        <Split Axis = "2" From = "10" />
        <Split Axis = "2" From = "11" />
        <Split Axis = "2" From = "12" />

        <Turn  Axis = "0" Layers = "8-12" Angle = "Pi/2" />
        <Turn  Axis = "1" Layers = "5-7" Angle = "Pi" />
        <Turn  Axis = "0" Layers = "8-12" Angle = "-Pi/2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "9" />
        <Split Axis = "2" From = "10" />
        <Undo  Repeat = "3" />

        <Turn  Axis = "0" Layers = "0-4" Angle = "Pi/2" />
        <Turn  Axis = "1" Layers = "5-7" Angle = "Pi" />
        <Turn  Axis = "0" Layers = "0-4" Angle = "-Pi/2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "9" />
        <Split Axis = "2" From = "10" />
        <Undo  Repeat = "3" />

        <Turn  Axis = "0" Layers = "5-7" Angle = "Pi/2" />
        <Turn  Axis = "1" Layers = "5-7" Angle = "Pi/2" />
        <Turn  Axis = "0" Layers = "5-7" Angle = "-Pi/2" />
        <Turn  Axis = "1" Layers = "5-7" Angle = "-Pi/2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "10" />
        <RemoveContaining Vector = "0;0;D[3]" />
        <RemoveContaining Vector = "0;0;D[8]" />
        <Undo  Repeat = "4" />

        <Turn  Axis = "1" Layers = "5-7" Angle = "Pi/2" />
        <Turn  Axis = "0" Layers = "5-7" Angle = "Pi/2" />
        <Turn  Axis = "1" Layers = "5-7" Angle = "-Pi/2" />
        <Turn  Axis = "0" Layers = "5-7" Angle = "-Pi/2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "10" />
        <RemoveContaining Vector = "0;0;D[3]" />
        <RemoveContaining Vector = "0;0;D[8]" />
        <Undo  Repeat = "4" />

        <InvertVisibility/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(2) * 12" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(5)" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "Random(5)+8" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "0" Layers = "8-12" Angle = "Pi/2" />
            <Turn Axis = "1" Layers = "5-7" Angle = "Pi" />
            <Turn Axis = "0" Layers = "8-12" Angle = "-Pi/2" />
            <Turn Axis = "2" Layer = "3" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "4" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "8" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "9" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "0" Layers = "8-12" Angle = "Pi/2" />
            <Turn Axis = "1" Layers = "5-7" Angle = "Pi" />
            <Turn Axis = "0" Layers = "8-12" Angle = "-Pi/2" />
            <Turn Axis = "2" Layers = "5-7" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(3)" Layer = "Random(13)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Sc1" Repeat = "50" />
            <ExecMacro MacroName = "Sc2" Repeat = "10" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
