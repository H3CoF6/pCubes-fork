<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Latch Cube II</Name>
        <Menu>Cubic\Latch Cube\Latch Cube II</Menu>
        <Class>TLatch</Class>
        <Inventor>Katsuhiko Okamoto</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-03-27</Added>
        <Link>https://www.hknowstore.com/locale/en-US/categoryofcorp.aspx?corpname=nowstore&amp;search=latch</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Textures>
        <Texture Name = "BlackEdge"               File = "Puzzles\Cubic\Latch Cube\BlackEdge.vec"      />
        <Texture Name = "BlackCorner"             File = "Puzzles\Cubic\Latch Cube\BlackCorner.vec"    />
        <Texture Name = "BlackArrowEdge Lock CW"  File = "Puzzles\Cubic\Latch Cube\BlackArrowEdge.vec" />
        <Texture Name = "WhiteEdge"               File = "Puzzles\Cubic\Latch Cube\WhiteEdge.vec"      />
        <Texture Name = "WhiteCorner"             File = "Puzzles\Cubic\Latch Cube\WhiteCorner.vec"    />
        <Texture Name = "WhiteArrowEdge Lock CCW" File = "Puzzles\Cubic\Latch Cube\WhiteArrowEdge.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->

        <!-- blue side -->
        WhiteArrowEdge Lock CCW = 9,0,1, 11,0,0
        WhiteCorner = 0,1,0, 2,1,0, 17,1,0, 19,1,0
        WhiteEdge = 18,1,2, 1,1,0

        <!-- green side -->
        BlackArrowEdge Lock CW = 14,0,0, 16,0,1
        BlackCorner = 8,1,0, 23,1,0, 25,1,0, 6,1,0
        BlackEdge = 7,1,2, 24,1,0
    </SetTextures>
</xml>
