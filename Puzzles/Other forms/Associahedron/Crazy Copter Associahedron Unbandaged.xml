    <Script>
        Colors[0] := '0000A0'; // Blue
        Colors[1] := '008000'; // Green
        Colors[2] := '800080'; // Violett
        Colors[3] := '2828FF'; // LightBlue
        Colors[4] := '00FF00'; // LightGreen
        Colors[5] := 'FF0080'; // LightViolett
        Colors[6] := 'FFFF00'; // Yellow
        Colors[7] := 'FF0000'; // Red
        Colors[8] := 'FF6000'; // Orange

        K  := 0.3;

        s2 := sqrt(2);
        s3 := sqrt(3);
        C0 := K * s3 * (3 * s2 - 4) / 2;
        C1 := K * s3 / 2;
        C2 := K * 3 * (2 - s2) / 2;
        C3 := K * 3 * (s2 - 1);
        C4 := K * s3;
        C5 := K * s3 * (3 * s2 - 2) / 2;
        C6 := K * 3 * s2 / 2;
        C7 := K * (3 * s2 - 2);
        C8 := K * 3 / 2;

        f := 1.268;
        N1 := K * f;
        N0 := N1 * s3 / 2;
        N2 := N1 / 2;

        A := ArcCos(-3 / 5);

        D1 := C5 * 4 / 7;
        D2 := C5 * 4 / 7 * 1.275;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "A" PlaneDistances = "-D1" >
        <Axis NormVector = " 1;  0;  0" />
        <Axis NormVector = "-1;-s3;  0" />
