                <Add Vector = " C4;  0;-C3" />
                <Add Vector = "-C1;-C8;-C3" />
                <Add Vector = "-C1; C8;-C3" />

                <Add Vector = "  0;  0;-C7" />

                <Add Vector = "-N1;  0; N0" />
                <Add Vector = " N2;-N0; N0" />
                <Add Vector = " N2; N0; N0" />
                <Add Vector = "-N1;  0;-N0" />
                <Add Vector = " N2;-N0;-N0" />
                <Add Vector = " N2; N0;-N0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 2;15" InvisibleEdges = "7" />
