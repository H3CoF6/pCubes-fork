        <Axis NormVector = "-1;  0; s3" />
    </Axes>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "A" PlaneDistances = "-D1" >
        <Axis NormVector = "1; s3; 2*s3" />
        <Axis NormVector = "1; s3;-2*s3" />
        <Axis NormVector = "1;-s3; 2*s3" />
        <Axis NormVector = "1;-s3;-2*s3" />
    </Axes>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D2" >
        <Axis NormVector = " 1;  0; 0" />
        <Axis NormVector = "-1;-s3; 0" />
        <Axis NormVector = "-1; s3; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C7" />

                <Add Vector = " C4;  0; C3" />
