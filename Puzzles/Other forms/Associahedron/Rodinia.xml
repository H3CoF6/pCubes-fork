<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rodinia</Name>
        <Menu>Other forms\Associahedron\Rodinia</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-06-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11158</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clLightGreen   := '00FF00';

        K  := 0.3;

        s2 := sqrt(2);
        s3 := sqrt(3);
        C0 := K * s3 * (3 * s2 - 4) / 2;
        C1 := K * s3 / 2;
        C2 := K * 3 * (2 - s2) / 2;
        C3 := K * 3 * (s2 - 1);
        C4 := K * s3;
        C5 := K * s3 * (3 * s2 - 2) / 2;
        C6 := K * 3 * s2 / 2;
        C7 := K * (3 * s2 - 2);
        C8 := K * 3 / 2;

        A1 := ArcCos(-(s2 + 3) / 7);
        A2 := 2 * A1;

        D1 := K * 3 * sqrt(5 + 3 * s2) / sqrt(42);
        D2 := C3;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1;A2" PlaneDistances = "D1" FixedLayers = "0" >
        <Axis NormVector = " C4;  0; C3" />
        <Axis NormVector = "-C1;-C8; C3" />
        <Axis NormVector = "-C1; C8; C3" />
        <Axis NormVector = " C4;-C3;  0" />
        <Axis NormVector = " C0;-C6;  0" />
        <Axis NormVector = "-C5;-C2;  0" />
        <Axis NormVector = "-C5; C2;  0" />
        <Axis NormVector = " C0; C6;  0" />
        <Axis NormVector = " C4; C3;  0" />
        <Axis NormVector = " C4;  0;-C3" />
        <Axis NormVector = "-C1;-C8;-C3" />
        <Axis NormVector = "-C1; C8;-C3" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = " D2" >
        <Axis NormVector = " 0; 0; C7" />
        <Axis NormVector = " 0; 0;-C7" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C7" />

                <Add Vector = " C4;  0; C3" />
                <Add Vector = "-C1;-C8; C3" />
                <Add Vector = "-C1; C8; C3" />

                <Add Vector = " C4;-C3;  0" />
                <Add Vector = " C0;-C6;  0" />
                <Add Vector = "-C5;-C2;  0" />
                <Add Vector = "-C5; C2;  0" />
                <Add Vector = " C0; C6;  0" />
                <Add Vector = " C4; C3;  0" />

                <Add Vector = " C4;  0;-C3" />
                <Add Vector = "-C1;-C8;-C3" />
                <Add Vector = "-C1; C8;-C3" />

                <Add Vector = "  0;  0;-C7" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = " 0; 2; 5; 4; 1" />
                <Face Color = "clGreen       " VertexIndexes = " 0; 3; 7; 6; 2" />
                <Face Color = "clViolett     " VertexIndexes = " 0; 1; 9; 8; 3" />

                <Face Color = "clLightBlue   " VertexIndexes = "13; 10; 4; 5; 11" />
                <Face Color = "clLightGreen  " VertexIndexes = "13; 11; 6; 7; 12" />
                <Face Color = "clLightViolett" VertexIndexes = "13; 12; 8; 9; 10" />

                <Face Color = "clYellow      " VertexIndexes = " 1; 4; 10; 9" />
                <Face Color = "clRed         " VertexIndexes = " 2; 6; 11; 5" />
                <Face Color = "clOrange      " VertexIndexes = " 3; 8; 12; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Cut4" >
            <Hide Axis = "Ax12" To    = "0" />
            <Hide Axis = "Ax0"  To    = "0" />
            <Turn Axis = "Ax0"  Layer = "1" Angle = " A1" />
            <Cut  Axis = "Ax3"  From  = "1" />
            <Undo/>
            <ShowAll/>

            <Hide Axis = "Ax3"  From  = "1" />
            <Hide Axis = "Ax8"  From  = "1" />
            <Hide Axis = "Ax0"  To    = "0" />
            <Turn Axis = "Ax0"  Layer = "1" Angle = " A1" />
            <Cut  Axis = "Ax12" To    = "1" />
            <Undo/>
            <Turn Axis = "Ax0"  Layer = "1" Angle = "-A1" />
            <Cut  Axis = "Ax12" To    = "1" />
            <Undo/>
            <ShowAll/>

            <Hide Axis = "Ax0"  To    = "0" />
            <Hide Axis = "Ax3"  To    = "0" />
            <Turn Axis = "Ax0"  Layer = "1" Angle = " A1" />
            <Cut  Axis = "Ax12" To    = "1" />
            <Undo/>
            <Turn Axis = "Ax3"  Layer = "1" Angle = " A1" />
            <Turn Axis = "Ax4"  Layer = "1" Angle = " A1" />
            <Turn Axis = "Ax1"  Layer = "1" Angle = "-A1" />
            <Cut  Axis = "Ax12" To    = "1" />
            <Undo Repeat = "3" />
            <ShowAll/>

            <Hide Axis = "Ax0"  To    = "0" />
            <Hide Axis = "Ax8"  To    = "0" />
            <Turn Axis = "Ax0"  Layer = "1" Angle = "-A1" />
            <Cut  Axis = "Ax12" To    = "1" />
            <Undo/>
            <Turn Axis = "Ax8"  Layer = "1" Angle = "-A1" />
            <Turn Axis = "Ax7"  Layer = "1" Angle = "-A1" />
            <Turn Axis = "Ax2"  Layer = "1" Angle = " A1" />
            <Cut  Axis = "Ax12" To    = "1" />
            <Undo Repeat = "3" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Cut4" Ax0 = " 0" Ax1 = " 1" Ax2 = " 2" Ax3 = "3" Ax4 = "4" Ax7 = "7" Ax8 = "8" Ax12 = "12" />
        <ExecMacro MacroName = "Cut4" Ax0 = " 1" Ax1 = " 2" Ax2 = " 0" Ax3 = "5" Ax4 = "6" Ax7 = "3" Ax8 = "4" Ax12 = "12" />
        <ExecMacro MacroName = "Cut4" Ax0 = " 2" Ax1 = " 0" Ax2 = " 1" Ax3 = "7" Ax4 = "8" Ax7 = "5" Ax8 = "6" Ax12 = "12" />
        <ExecMacro MacroName = "Cut4" Ax0 = " 9" Ax1 = "11" Ax2 = "10" Ax3 = "8" Ax4 = "7" Ax7 = "4" Ax8 = "3" Ax12 = "13" />
        <ExecMacro MacroName = "Cut4" Ax0 = "11" Ax1 = "10" Ax2 = " 9" Ax3 = "6" Ax4 = "5" Ax7 = "8" Ax8 = "7" Ax12 = "13" />
        <ExecMacro MacroName = "Cut4" Ax0 = "10" Ax1 = " 9" Ax2 = "11" Ax3 = "4" Ax4 = "3" Ax7 = "6" Ax8 = "5" Ax12 = "13" />
    </Figure>
</xml>
