<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Basic Gem</Name>
        <Menu>Other forms\Associahedron\Basic Gem</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-01-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7188</Link>
    </Interface>

    <Script>
        Colors[0] := '0000A0'; // clBlue
        Colors[1] := '008000'; // clGreen
        Colors[2] := '800080'; // clViolett
        Colors[3] := '2828FF'; // clLightBlue
        Colors[4] := '00FF00'; // clLightGreen
        Colors[5] := 'FF0080'; // clLightViolett
        Colors[6] := 'FFFF00'; // clYellow
        Colors[7] := 'FF0000'; // clRed
        Colors[8] := 'FF6000'; // clOrange

        K  := 0.3;

        s2 := sqrt(2);
        s3 := sqrt(3);
        C0 := K * s3 * (3 * s2 - 4) / 2;
        C1 := K * s3 / 2;
        C2 := K * 3 * (2 - s2) / 2;
        C3 := K * 3 * (s2 - 1);
        C4 := K * s3;
        C5 := K * s3 * (3 * s2 - 2) / 2;
        C6 := K * 3 * s2 / 2;
        C7 := K * (3 * s2 - 2);
        C8 := K * 3 / 2;

        D1 := C5 * 2 / 7;
        D2 := C5 * 4 / 7;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi/2" PlaneDistances = "-D2; D1" >
        <Axis NormVector = " 1;  0; 0" />
        <Axis NormVector = "-1;-s3; 0" />
        <Axis NormVector = "-1; s3; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C7" />

                <Add Vector = " C4;  0; C3" />
                <Add Vector = "-C1;-C8; C3" />
                <Add Vector = "-C1; C8; C3" />

                <Add Vector = " C4;-C3;  0" />
                <Add Vector = " C0;-C6;  0" />
                <Add Vector = "-C5;-C2;  0" />
                <Add Vector = "-C5; C2;  0" />
                <Add Vector = " C0; C6;  0" />
                <Add Vector = " C4; C3;  0" />

                <Add Vector = " C4;  0;-C3" />
                <Add Vector = "-C1;-C8;-C3" />
                <Add Vector = "-C1; C8;-C3" />

                <Add Vector = "  0;  0;-C7" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 2; 5; 4; 1" />
                <Face Color = "Colors[1]" VertexIndexes = " 0; 3; 7; 6; 2" />
                <Face Color = "Colors[2]" VertexIndexes = " 0; 1; 9; 8; 3" />
                <Face Color = "Colors[3]" VertexIndexes = "13;10; 4; 5;11" />
                <Face Color = "Colors[4]" VertexIndexes = "13;11; 6; 7;12" />
                <Face Color = "Colors[5]" VertexIndexes = "13;12; 8; 9;10" />
                <Face Color = "Colors[6]" VertexIndexes = " 1; 4;10; 9" />
                <Face Color = "Colors[7]" VertexIndexes = " 2; 6;11; 5" />
                <Face Color = "Colors[8]" VertexIndexes = " 3; 8;12; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn  Axis = "0" Layer = "2" Angle = "Pi/2" />
        <SplitByAxes/>
        <Undo/>
        <Turn  Axis = "1" Layer = "2" Angle = "Pi/2" />
        <SplitByAxes/>
        <Undo/>
        <Turn  Axis = "2" Layer = "2" Angle = "Pi/2" />
        <SplitByAxes/>
        <Undo/>
    </Figure>
</xml>
