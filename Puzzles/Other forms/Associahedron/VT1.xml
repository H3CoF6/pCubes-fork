<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Associahedron VT1</Name>
        <Menu>Other forms\Associahedron\VT1</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-05-13</Added>
        <Link></Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clLightGreen   := '00FF00';

        K  := 0.3;

        s2 := sqrt(2);
        s3 := sqrt(3);
        C0 := K * s3 * (3 * s2 - 4) / 2;
        C1 := K * s3 / 2;
        C2 := K * 3 * (2 - s2) / 2;
        C3 := K * 3 * (s2 - 1);
        C4 := K * s3;
        C5 := K * s3 * (3 * s2 - 2) / 2;
        C6 := K * 3 * s2 / 2;
        C7 := K * (3 * s2 - 2);
        C8 := K * 3 / 2;

        A1 := ArcCos(-(s2 + 3) / 7);
        A2 := 2 * A1;

        D  := K * 1.5;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1;A2" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " C4;  0; C3" />
        <Axis NormVector = "-C1;-C8; C3" />
        <Axis NormVector = "-C1; C8; C3" />
        <Axis NormVector = " C4;-C3;  0" />
        <Axis NormVector = " C0;-C6;  0" />
        <Axis NormVector = "-C5;-C2;  0" />
        <Axis NormVector = "-C5; C2;  0" />
        <Axis NormVector = " C0; C6;  0" />
        <Axis NormVector = " C4; C3;  0" />
        <Axis NormVector = " C4;  0;-C3" />
        <Axis NormVector = "-C1;-C8;-C3" />
        <Axis NormVector = "-C1; C8;-C3" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C7" />

                <Add Vector = " C4;  0; C3" />
                <Add Vector = "-C1;-C8; C3" />
                <Add Vector = "-C1; C8; C3" />

                <Add Vector = " C4;-C3;  0" />
                <Add Vector = " C0;-C6;  0" />
                <Add Vector = "-C5;-C2;  0" />
                <Add Vector = "-C5; C2;  0" />
                <Add Vector = " C0; C6;  0" />
                <Add Vector = " C4; C3;  0" />

                <Add Vector = " C4;  0;-C3" />
                <Add Vector = "-C1;-C8;-C3" />
                <Add Vector = "-C1; C8;-C3" />

                <Add Vector = "  0;  0;-C7" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = " 0; 2; 5; 4; 1" />
                <Face Color = "clGreen       " VertexIndexes = " 0; 3; 7; 6; 2" />
                <Face Color = "clViolett     " VertexIndexes = " 0; 1; 9; 8; 3" />

                <Face Color = "clLightBlue   " VertexIndexes = "13; 10; 4; 5; 11" />
                <Face Color = "clLightGreen  " VertexIndexes = "13; 11; 6; 7; 12" />
                <Face Color = "clLightViolett" VertexIndexes = "13; 12; 8; 9; 10" />

                <Face Color = "clYellow      " VertexIndexes = " 1; 4; 10; 9" />
                <Face Color = "clRed         " VertexIndexes = " 2; 6; 11; 5" />
                <Face Color = "clOrange      " VertexIndexes = " 3; 8; 12; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "0"  Layer = "1" Angle = " A1" />
        <Split Axis = "3"  From  = "1"/>
        <Turn  Axis = "0"  Layer = "1" Angle = "-A1" />

        <Turn  Axis = "9"  Layer = "1" Angle = "-A1" />
        <Split Axis = "3"  From  = "1"/>
        <Turn  Axis = "9"  Layer = "1" Angle = " A1" />

        <Turn  Axis = "1"  Layer = "1" Angle = " A1" />
        <Split Axis = "5"  From  = "1"/>
        <Turn  Axis = "1"  Layer = "1" Angle = "-A1" />

        <Turn  Axis = "10" Layer = "1" Angle = "-A1" />
        <Split Axis = "5"  From  = "1"/>
        <Turn  Axis = "10" Layer = "1" Angle = " A1" />

        <Turn  Axis = "2"  Layer = "1" Angle = " A1" />
        <Split Axis = "7"  From  = "1"/>
        <Turn  Axis = "2"  Layer = "1" Angle = "-A1" />

        <Turn  Axis = "11" Layer = "1" Angle = "-A1" />
        <Split Axis = "7"  From  = "1"/>
        <Turn  Axis = "11" Layer = "1" Angle = " A1" />
    </Figure>
</xml>
