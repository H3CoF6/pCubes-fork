<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hadron</Name>
        <Menu>Other forms\Associahedron\Hadron</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-06-21</Added>
        <Link>http://twistypuzzles.com/museum/museum_showitem.php?pkey=8894</Link>
    </Interface>

    <Script>
        Colors[0] := '0000A0'; // Blue
        Colors[1] := '008000'; // Green
        Colors[2] := '800080'; // Violett
        Colors[3] := '2828FF'; // LightBlue
        Colors[4] := '00FF00'; // LightGreen
        Colors[5] := 'FF0080'; // LightViolett
        Colors[6] := 'FFFF00'; // Yellow
        Colors[7] := 'FF0000'; // Red
        Colors[8] := 'FF6000'; // Orange

        K  := 0.3;

        D1 := K * 0.975;
        D2 := K * 0.93;

        s2 := sqrt(2);
        s3 := sqrt(3);

        C0 := K * s3 * (3 * s2 - 4) / 2;
        C1 := K * s3 / 2;
        C2 := K * 3 * (2 - s2) / 2;
        C3 := K * 3 * (s2 - 1);
        C4 := K * s3;
        C5 := K * s3 * (3 * s2 - 2) / 2;
        C6 := K * 3 * s2 / 2;
        C7 := K * (3 * s2 - 2);
        C8 := K * 3 / 2;

        N0 := K * 1.5; // pillow
        N1 := N0 / 2;
        N2 := N0 * s3 / 2;

        A1 := ArcCos( 1 / 8);
        A2 := ArcCos(-3 / 4);

        for i := 0 to 2 do begin
            ax[i] := cos(2*Pi/3 * i);
            ay[i] := sin(2*Pi/3 * i);
            aax[i] := -ax[i];
            aay[i] := -ay[i];
        end;
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D1" NormVectors = "ax; ay; 0" />
    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D2" NormVectors = "aax; aay; s3/2" />
    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D2" NormVectors = "aax; aay;-s3/2" />

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C7" />

                <Add Vector = " C4;  0; C3" />
                <Add Vector = "-C1;-C8; C3" />
                <Add Vector = "-C1; C8; C3" />

                <Add Vector = " C4;-C3;  0" />
                <Add Vector = " C0;-C6;  0" />
                <Add Vector = "-C5;-C2;  0" />
                <Add Vector = "-C5; C2;  0" />
                <Add Vector = " C0; C6;  0" />
                <Add Vector = " C4; C3;  0" />

                <Add Vector = " C4;  0;-C3" />
                <Add Vector = "-C1;-C8;-C3" />
                <Add Vector = "-C1; C8;-C3" />

                <Add Vector = "  0;  0;-C7" />

                <Add Vector = "-N0;  0; N2" />
                <Add Vector = " N1;-N2; N2" />
                <Add Vector = " N1; N2; N2" />
                <Add Vector = "-N0;  0;-N2" />
                <Add Vector = " N1;-N2;-N2" />
                <Add Vector = " N1; N2;-N2" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 2; 15" InvisibleEdges = "7" />
                <Face Color = "Colors[0]" VertexIndexes = " 2; 5; 15" InvisibleEdges = "7" />
                <Face Color = "Colors[0]" VertexIndexes = " 5; 4; 15" InvisibleEdges = "7" />
                <Face Color = "Colors[0]" VertexIndexes = " 4; 1; 15" InvisibleEdges = "7" />
                <Face Color = "Colors[0]" VertexIndexes = " 1; 0; 15" InvisibleEdges = "7" />

                <Face Color = "Colors[1]" VertexIndexes = " 0; 3; 14" InvisibleEdges = "7" />
                <Face Color = "Colors[1]" VertexIndexes = " 3; 7; 14" InvisibleEdges = "7" />
                <Face Color = "Colors[1]" VertexIndexes = " 7; 6; 14" InvisibleEdges = "7" />
                <Face Color = "Colors[1]" VertexIndexes = " 6; 2; 14" InvisibleEdges = "7" />
                <Face Color = "Colors[1]" VertexIndexes = " 2; 0; 14" InvisibleEdges = "7" />

                <Face Color = "Colors[2]" VertexIndexes = " 0; 1; 16" InvisibleEdges = "7" />
                <Face Color = "Colors[2]" VertexIndexes = " 1; 9; 16" InvisibleEdges = "7" />
                <Face Color = "Colors[2]" VertexIndexes = " 9; 8; 16" InvisibleEdges = "7" />
                <Face Color = "Colors[2]" VertexIndexes = " 8; 3; 16" InvisibleEdges = "7" />
                <Face Color = "Colors[2]" VertexIndexes = " 3; 0; 16" InvisibleEdges = "7" />

                <Face Color = "Colors[3]" VertexIndexes = "13;10; 18" InvisibleEdges = "7" />
                <Face Color = "Colors[3]" VertexIndexes = "10; 4; 18" InvisibleEdges = "7" />
                <Face Color = "Colors[3]" VertexIndexes = " 4; 5; 18" InvisibleEdges = "7" />
                <Face Color = "Colors[3]" VertexIndexes = " 5;11; 18" InvisibleEdges = "7" />
                <Face Color = "Colors[3]" VertexIndexes = "11;13; 18" InvisibleEdges = "7" />

                <Face Color = "Colors[4]" VertexIndexes = "13;11; 17" InvisibleEdges = "7" />
                <Face Color = "Colors[4]" VertexIndexes = "11; 6; 17" InvisibleEdges = "7" />
                <Face Color = "Colors[4]" VertexIndexes = " 6; 7; 17" InvisibleEdges = "7" />
                <Face Color = "Colors[4]" VertexIndexes = " 7;12; 17" InvisibleEdges = "7" />
                <Face Color = "Colors[4]" VertexIndexes = "12;13; 17" InvisibleEdges = "7" />

                <Face Color = "Colors[5]" VertexIndexes = "13;12; 19" InvisibleEdges = "7" />
                <Face Color = "Colors[5]" VertexIndexes = "12; 8; 19" InvisibleEdges = "7" />
                <Face Color = "Colors[5]" VertexIndexes = " 8; 9; 19" InvisibleEdges = "7" />
                <Face Color = "Colors[5]" VertexIndexes = " 9;10; 19" InvisibleEdges = "7" />
                <Face Color = "Colors[5]" VertexIndexes = "10;13; 19" InvisibleEdges = "7" />

                <Face Color = "Colors[6]" VertexIndexes = " 1; 4;10; 9" />
                <Face Color = "Colors[7]" VertexIndexes = " 2; 6;11; 5" />
                <Face Color = "Colors[8]" VertexIndexes = " 3; 8;12; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "RemovePart" >
            <Hide Axis = "ax1" From = "1" To = "2" />
            <Hide Axis = "ax2" From = "1" To = "2" />
            <Hide Axis = "ax3" From = "0" To = "0" />
            <Cut  Axis = "ax4" From = "0" To = "1" />
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "RemovePart" ax1 = "0" ax2 = "2" ax3 = "4" ax4 = "7" />
        <ExecMacro MacroName = "RemovePart" ax1 = "0" ax2 = "1" ax3 = "5" ax4 = "8" />
        <ExecMacro MacroName = "RemovePart" ax1 = "2" ax2 = "1" ax3 = "3" ax4 = "6" />

        <Macro Name = "Split" >
            <Turn  Axis = "ax1" Layer = "1" Angle = "A" />
            <Turn  Axis = "ax2" Layer = "1" Angle = "B" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Split" ax1 = "3" ax2 = "5" A = " A1" B = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "3" A = "-A1" B = " A1" />
        <ExecMacro MacroName = "Split" ax1 = "3" ax2 = "4" A = " A2" B = " A1" />
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "3" A = "-A2" B = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "5" A = " A2" B = " A1" />
        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "4" A = "-A2" B = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = "6" ax2 = "8" A = " A2" B = " A1" />
        <ExecMacro MacroName = "Split" ax1 = "8" ax2 = "6" A = "-A2" B = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = "7" ax2 = "8" A = " A1" B = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = "8" ax2 = "7" A = "-A1" B = " A1" />
        <ExecMacro MacroName = "Split" ax1 = "8" ax2 = "6" A = " A1" B = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "4" A = " A1" B = "-A1" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
