<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Neutrino</Name>
        <Menu>Other forms\Associahedron\Neutrino</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8821</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36785</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clLightGreen   := '00FF00';

        H  := 0.67;
        R := H * sqrt(3);
        RCut := R / 2;

        for i := 0 to 2 do begin
            x[i] := R * cos(2*Pi/3 * i);
            y[i] := R * sin(2*Pi/3 * i);
            ax[i] := -cos(2*Pi/3 * i);
            ay[i] := -sin(2*Pi/3 * i);
        end;
        az := sqrt(3) / 2;

        A1 := ArcCos(1 / 8);
        A2 := Pi - A1 / 2;
    </Script>

    <Axes TurningAngles = "0; Pi / 2" NormVectors = " x; y; 0" PlaneDistances = "0" TurnAxesWithPartNo = "7" />

    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" NormVectors = "ax; ay; az" PlaneDistances = "0" TurnAxesWithPartNo = "7" />
    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" NormVectors = "ax; ay;-az" PlaneDistances = "0" TurnAxesWithPartNo = "7" />

    <Figure>
        <Part>
            <Vertices Vectors = " 0; 0; H" />
            <Vertices Vectors = " x; y; 0" />
            <Vertices Vectors = " 0; 0;-H" />

            <Faces>
                <Face Color = "clViolett     " VertexIndexes = " 1; 2; 0" />
                <Face Color = "clGreen       " VertexIndexes = " 2; 3; 0" />
                <Face Color = "clBlue        " VertexIndexes = " 3; 1; 0" />

                <Face Color = "clLightViolett" VertexIndexes = " 2; 1; 4" />
                <Face Color = "clLightGreen  " VertexIndexes = " 3; 2; 4" />
                <Face Color = "clLightBlue   " VertexIndexes = " 1; 3; 4" />
            </Faces>
        </Part>

        <Cut Color = "clYellow" > <Plane NormVector = "ax[0]; ay[0]; 0" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "clOrange" > <Plane NormVector = "ax[1]; ay[1]; 0" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = "ax[2]; ay[2]; 0" NormDistance = "-RCut" /> </Cut>

        <SplitByAxes/>
    </Figure>
</xml>
