<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Associahedron Skewb II</Name>
        <Menu>Other forms\Associahedron\Skewb II</Menu>
        <Menu>Other forms\Skewb variants\Associahedron\Associahedron II</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-07-30</Added>
        <Link></Link>
    </Interface>

    <Script>
        clBlue         := '0000A0';
        clGreen        := '008000';
        clViolett      := '800080';
        clLightBlue    := '2828FF';
        clLightGreen   := '00FF00';
        clLightViolett := 'FF0080';
        clYellow       := 'FFFF00';
        clRed          := 'FF0000';
        clOrange       := 'FF6000';

        K  := 0.3;

        s2 := sqrt(2);
        s3 := sqrt(3);
        C0 := K * s3 * (3 * s2 - 4) / 2;
        C1 := K * s3 / 2;
        C2 := K * 3 * (2 - s2) / 2;
        C3 := K * 3 * (s2 - 1);
        C4 := K * s3;
        C5 := K * s3 * (3 * s2 - 2) / 2;
        C6 := K * 3 * s2 / 2;
        C7 := K * (3 * s2 - 2);
        C8 := K * 3 / 2;

        D1 := s3 + 1;
        D2 := s3 - 1;
        D3 := 2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "-D1; D2; D3" />
        <Axis NormVector = " D2; D1; D3" />
        <Axis NormVector = "-D1; D2;-D3" />
        <Axis NormVector = " D2; D1;-D3" />
    </Axes>

    <Figure>
        <Turn NormVector = "-C1; C8; 0" Angle = "Pi/4" />
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C7" />

                <Add Vector = " C4;  0; C3" />
                <Add Vector = "-C1;-C8; C3" />
                <Add Vector = "-C1; C8; C3" />

                <Add Vector = " C4;-C3;  0" />
                <Add Vector = " C0;-C6;  0" />
                <Add Vector = "-C5;-C2;  0" />
                <Add Vector = "-C5; C2;  0" />
                <Add Vector = " C0; C6;  0" />
                <Add Vector = " C4; C3;  0" />

                <Add Vector = " C4;  0;-C3" />
                <Add Vector = "-C1;-C8;-C3" />
                <Add Vector = "-C1; C8;-C3" />

                <Add Vector = "  0;  0;-C7" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = " 0; 2; 5; 4; 1" />
                <Face Color = "clGreen       " VertexIndexes = " 0; 3; 7; 6; 2" />
                <Face Color = "clViolett     " VertexIndexes = " 0; 1; 9; 8; 3" />

                <Face Color = "clLightBlue   " VertexIndexes = "13; 10; 4; 5; 11" />
                <Face Color = "clLightGreen  " VertexIndexes = "13; 11; 6; 7; 12" />
                <Face Color = "clLightViolett" VertexIndexes = "13; 12; 8; 9; 10" />

                <Face Color = "clYellow      " VertexIndexes = " 1; 4; 10; 9" />
                <Face Color = "clRed         " VertexIndexes = " 2; 6; 11; 5" />
                <Face Color = "clOrange      " VertexIndexes = " 3; 8; 12; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
