<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Symmetrical Associahedron Skewb</Name>
        <Menu>Other forms\Associahedron\Symmetrical Associahedron Skewb</Menu>
        <Menu>Other forms\Skewb variants\Associahedron\Symmetrical Associahedron Skewb</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-07-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11272</Link>
    </Interface>

    <Script>
        Colors[0] := '008000'; // Green
        Colors[1] := '800080'; // Violett
        Colors[2] := '0000A0'; // Blue
        Colors[3] := '00FF00'; // LightGreen
        Colors[4] := 'FF0080'; // LightViolett
        Colors[5] := '2828FF'; // LightBlue
        Colors[6] := 'FFFF00'; // Yellow
        Colors[7] := 'FF0000'; // Red
        Colors[8] := 'FF6000'; // Orange

        H := 0.67;
        R := H * sqrt(3);
        DCut := R / 2; <!-- for regular associahedron DCut := H / (3 * s2 - 2) * s3; -->

        sAngle := 2 * Pi / 3;
        for i := 0 to 2 do begin
            A := sAngle * i + Pi/2;
            x[i] := R * sin(A);
            y[i] := R * cos(A);
        end;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "-1; 1;-1" /> <!-- " 1  ;  0  ; -s2/4" -->
        <Axis NormVector = "-1;-1; 1" /> <!-- "-1/2;-s3/2; -s2/4" -->
        <Axis NormVector = " 1;-1;-1" /> <!-- "-1/2; s3/2; -s2/4" -->
        <Axis NormVector = " 1; 1; 1" /> <!-- " 0  ;  0  ;   1  " -->
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "ArcTan(sqrt(2))" />

        <Part>
            <Vertices Vectors = " x; y; 0" />
            <Vertices Vectors = " 0; 0; H" />
            <Vertices Vectors = " 0; 0;-H" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "2;1;3" />
                <Face Color = "Colors[1]" VertexIndexes = "0;2;3" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;3" />
                <Face Color = "Colors[3]" VertexIndexes = "1;2;4" />
                <Face Color = "Colors[4]" VertexIndexes = "2;0;4" />
                <Face Color = "Colors[5]" VertexIndexes = "0;1;4" />
            </Faces>
        </Part>

        <Cut Color = "Colors[6]" ><Plane NormVector = "-x[0];-y[0]; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[7]" ><Plane NormVector = "-x[1];-y[1]; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[8]" ><Plane NormVector = "-x[2];-y[2]; 0" NormDistance = "-DCut" /> </Cut>

        <SplitByAxes/>
    </Figure>
</xml>
