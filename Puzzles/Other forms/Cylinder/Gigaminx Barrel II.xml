<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gigaminx Barrel II</Name>
        <Menu>Other forms\Cylinder\Gigaminx Barrel II</Menu>
        <Inventor>Alberto Quevedo</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-01-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9667</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF6000'; // Orange
        Colors[ 1] := '00FF00'; // LightGreen
        Colors[ 2] := 'FF0080'; // LightViolett
        Colors[ 3] := 'FFFF00'; // Yellow
        Colors[ 4] := '0000A0'; // Blue
        Colors[ 5] := 'FF0000'; // Red
        Colors[ 6] := '008000'; // Green
        Colors[ 7] := '800080'; // Violett
        Colors[ 8] := 'BBBBBB'; // Gray
        Colors[ 9] := '3868BF'; // LightBlue
        Colors[10] := '00DCB4'; // Cyan
        Colors[11] := 'FFFFFF'; // White

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        D1 := R * 0.7;
        D2 := R * 0.77;

        R2 := R * 0.7;
        H := D2;
        H2 := H * 1.1;
        D := R / 3;

        N := 60;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2 * Pi / N * i);
            y[i] := R * sin(2 * Pi / N * i);
            x2[i] := R2 * cos(2 * Pi / N * i);
            y2[i] := R2 * sin(2 * Pi / N * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;

        function Priv(ax);
        begin
            if ax &lt; 6 then begin
                if ax + dax &lt; 6 then
                    Result := ax + dax
                else
                    Result := ax + dax - 5
            end else begin
                if ax + dax &lt; 11 then
                    Result := ax + dax
                else
                    Result := ax + dax - 5
            end;
        end;
    </Script>

    <Axes TurningAngles = "0; sAngle; sAngle" PlaneDistances = "D2; D1" NormVectors = " Cx; Cy; Cz" />

    <Figure>
        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Color" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Macro Name = "AddCylinder" >
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "Colors[11]" VertexIndexes = "FromTo( 0, N - 1)" />
                    <ExecMacro MacroName = "AddFace" i = "0" Repeat = "N" />
                    <Face Color = "Colors[10]" VertexIndexes = "FromTo( 2 * N - 1, N)" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "AddZ" >
            <ExecMacro MacroName = "AddCylinder" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Turn Axis = "Priv( 6)" Layers = "1-2" Angle = " sAngle" />
            <Cut  Axis = "Priv( 3)" From = "1" />
            <Undo/>

            <Turn Axis = "Priv( 2)" Layers = "1-2" Angle = " sAngle" />
            <Cut  Axis = "Priv(10)" From = "1" />
            <Undo/>

            <Turn Axis = "Priv( 2)" Layers = "2" Angle = " sAngle" />
            <Turn Axis = "Priv( 3)" Layers = "2" Angle = "-sAngle" />
            <Cut Axis = "0" To = "1" />
            <Undo Repeat = "2" />
            <Turn Axis = "Priv( 6)" Layers = "2" Angle = " sAngle" />
            <Turn Axis = "Priv(10)" Layers = "2" Angle = "-sAngle" />
            <Cut Axis = "11" To = "1" />
            <Undo Repeat = "2" />

            <RemoveGrayParts/>
            <HideAll/>
        </Macro>

        <Macro Name = "AddD" >
            <ExecMacro MacroName = "AddCylinder" />
            <Cut Axis = "Priv( 1)" To = "1" />
            <Cut Axis = "Priv( 2)" To = "1" />
            <Cut Axis = "Priv( 4)" To = "1" />
            <Cut Axis = "Priv( 5)" To = "1" />
            <Cut Axis = "Priv( 7)" To = "1" />
            <Cut Axis = "Priv( 8)" To = "1" />
            <Cut Axis = "Priv( 9)" To = "1" />
            <Cut Axis = "Priv(10)" To = "1" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Turn Axis = "Priv( 3)" Layers = "2" Angle = " sAngle" />
            <Cut Axis = "0" To = "1" />
            <Undo/>
            <Turn Axis = "Priv( 6)" Layers = "2" Angle = " sAngle" />
            <Cut Axis = "11" To = "1" />
            <Undo/>
            <RemoveContaining Vector = " 0; 0;-H" />
            <RemoveContaining Vector = " 0; 0; H" />
            <HideAll/>
        </Macro>

        <ExecMacro MacroName = "AddZ" Color = "Colors[0]" dax = "0" />
        <ExecMacro MacroName = "AddD" Color = "Colors[1]" />
        <ExecMacro MacroName = "AddZ" Color = "Colors[2]" dax = "1" />
        <ExecMacro MacroName = "AddD" Color = "Colors[3]" />
        <ExecMacro MacroName = "AddZ" Color = "Colors[4]" dax = "2" />
        <ExecMacro MacroName = "AddD" Color = "Colors[5]" />
        <ExecMacro MacroName = "AddZ" Color = "Colors[6]" dax = "3" />
        <ExecMacro MacroName = "AddD" Color = "Colors[7]" />
        <ExecMacro MacroName = "AddZ" Color = "Colors[8]" dax = "4" />
        <ExecMacro MacroName = "AddD" Color = "Colors[9]" />

        <Part>
            <Vertices Vectors = "x2; y2; H2" />
            <Vertices Vectors = "x2; y2;-H2" />

            <Faces>
                <Face Color = "Colors[11]" VertexIndexes = "FromTo( 0, N - 1)" />
                <ExecMacro MacroName = "AddFace" i = "0" Repeat = "N" Color = "-1" />
                <Face Color = "Colors[10]" VertexIndexes = "FromTo( 2 * N - 1, N)" />
            </Faces>
        </Part>
        <Split Axis = " 0" From = "2" />
        <Split Axis = "11" From = "2" />
        <RemoveContaining Vector = " 0; 0; 0" />
        <SplitByAxes/>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
