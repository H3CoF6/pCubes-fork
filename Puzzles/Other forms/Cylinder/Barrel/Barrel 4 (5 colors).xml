    <Script>
        Colors[0] := 'AA00CC';
        Colors[1] := '0055EE';
        Colors[2] := 'EE0011';
        Colors[3] := 'FFEE00';
        Colors[4] := '00CC00';

        H := 0.5;
        R := H / 1.4;
        D := H / 3;

        for i := 0 to 59 do begin
            x[i] := R * cos(2 * Pi / 60 * (i+0.5));
            y[i] := R * sin(2 * Pi / 60 * (i+0.5));
        end;

        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);

        W := H / 1.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

