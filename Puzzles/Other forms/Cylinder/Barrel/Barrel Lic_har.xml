<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Barrel Lic.har </Name>
        <Menu>Other forms\Cylinder\Barrel\Barrel Lic.har</Menu>
        <Menu>Other forms\2x2x2 variants\Barrel Lic.har</Menu>
        <Inventor>Carlos Ramírez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-12-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9445</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        R := 0.6;
        H := R * 0.9;
        D := H / 5;

        N := 40;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2 * Pi / N * i);
            y[i] := R * sin(2 * Pi / N * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;

        RCut := R * 0.6;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "-1; 1; 0" Angle = "-ArcTan(sqrt(2))" />
        <Turn NormVector = "0;0;1" Angle = " Pi/2" />

        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Colors[c]" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = "FromTo(0, N - 1)" />
                <ExecMacro MacroName = "AddFace" i = "N/8" c = "3" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"           c = "0" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"           c = "2" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"           c = "1" Repeat = "N/4" />
                <Face Color = "Colors[4]" VertexIndexes = "FromTo(2 * N - 1, N)" />
            </Faces>
        </Part>

        <SplitByAxes />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
