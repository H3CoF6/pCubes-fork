        Colors[4] := '0055EE'; // Blue
        Colors[5] := 'AA00CC'; // Violett

        H := 0.5115;
        R := H / 1.37;
        D := H * 0.143;

        for i := 0 to 29 do begin
            x[i] := R * cos(2 * Pi / 30 * i);
            y[i] := R * sin(2 * Pi / 30 * i);
        end;

        az := sqrt(2) / 4;
        bz := sqrt(3) / 2;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

