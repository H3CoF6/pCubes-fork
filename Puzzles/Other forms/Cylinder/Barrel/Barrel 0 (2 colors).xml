<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Barrel #0 (2 colors)</Name>
        <Menu>Other forms\Cylinder\Barrel\Barrel #0 (2 colors)</Menu>
        <Menu>Other forms\2x2x2 variants\Barrel #0 (2 colors)</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4750</Link>
    </Interface>

    <Script>
        Colors0 := 'FFFFFF';
        Colors1 := '333333';

        H := 0.53;
        R := H / sqrt(2);

        N := 30;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2 * Pi / 30 * i);
            y[i] := R * sin(2 * Pi / 30 * i);
        end;

        for i := 0 to 2 do begin
            ax[i] := cos(2 * Pi / 3 * i);
            ay[i] := sin(2 * Pi / 3 * i);
        end;
        az := 1 / sqrt(2);

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "ax[0]; ay[0]; az" />
        <Axis NormVector = "ax[1]; ay[1]; az" />
        <Axis NormVector = "ax[2]; ay[2]; az" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Color" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Macro Name = "Body">
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "Color" VertexIndexes = "FromTo(0, 29)" />
                    <ExecMacro MacroName = "AddFace" i = "0" Repeat = "N" />
                    <Face Color = "Color" VertexIndexes = "FromTo(59, 30)" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "Construction" >
            <RemoveAllVisible/>

            <ExecMacro MacroName = "Body" Color = "Colors1" />
            <Cut Axis = "axis" To = "1" />
            <HideAll/>

            <ExecMacro MacroName = "Body" Color = "Colors0" />
            <Cut Axis = "axis" From = "1" />
            <ShowAll/>
            <SplitByAxes/>
            <SaveSolvedState/>
        </Macro>

        <ExecMacro MacroName = "Construction" axis = "2" />
        <ExecMacro MacroName = "Construction" axis = "1" />
        <ExecMacro MacroName = "Construction" axis = "0" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
