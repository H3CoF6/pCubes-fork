        Colors[1] := '00BB00'; // Green;

        clWhite := 'FFFFFF';
        clCream := 'FFFFAA';
        clBlack := '333333';
        clNoColor := -1;

        R := 0.5;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        fAngle := Pi * 2 / 5;
        for i := 0 to 59 do begin
            x[i] := R * cos(2 * Pi / 60 * (i+15));
            y[i] := R * sin(2 * Pi / 60 * (i+15));
        end;

        D := 0;
        H := R * 1;

        sAngle := 2 * Pi / 5;

        s3 := sqrt(3);
        s5 := sqrt(5);
        DCut :=  -0.2;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" TurnAxesWithPartNo = "0" >
