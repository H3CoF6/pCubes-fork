                    <Face Color = "Color" VertexIndexes = "118;119;59;58" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "119; 60; 0;59" InvisibleEdges = "10" />

                    <Face Color = "clDown" VertexIndexes = "FromTo(119, 60)" />
                </Faces>
            </Part>
        </Macro>

        // Red
        <ExecMacro MacroName = "Body" Color = "Colors[0]" clUp = "Colors[1]" clDown = "Colors[2]" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /></Hide>
        <InvertVisibility/>
        <RemoveAllVisible/>

        // Green
        <ExecMacro MacroName = "Body" Color = "Colors[1]"  />
        <SplitByAxes/>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /></Hide>
        <RemoveAllVisible/>

        // Blue
        <ExecMacro MacroName = "Body" Color = "Colors[2]"  />
        <SplitByAxes/>
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /></Hide>
        <RemoveAllVisible/>

        <ShowAll/>

        <RemoveContaining Vector = " Ax[0]; Ay[0]; Az[0]" />
        <RemoveContaining Vector = " Ax[1]; Ay[1]; Az[1]" />
        <RemoveContaining Vector = " Ax[2]; Ay[2]; Az[2]" />
        <RemoveContaining Vector = "-Ax[0];-Ay[0];-Az[0]" />
        <RemoveContaining Vector = "-Ax[1];-Ay[1];-Az[1]" />
        <RemoveContaining Vector = "-Ax[2];-Ay[2];-Az[2]" />
        <HideAll/>

        <ExecMacro MacroName = "Body" Color = "-1" />
        <SplitByAxes/>
        <HideContaining Vector = " Ax[0]; Ay[0]; Az[0]" />
        <HideContaining Vector = " Ax[1]; Ay[1]; Az[1]" />
        <HideContaining Vector = " Ax[2]; Ay[2]; Az[2]" />
        <HideContaining Vector = "-Ax[0];-Ay[0];-Az[0]" />
        <HideContaining Vector = "-Ax[1];-Ay[1];-Az[1]" />
        <HideContaining Vector = "-Ax[2];-Ay[2];-Az[2]" />
        <RemoveAllVisible />
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
