<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Barrelminx II (3 colors)</Name>
        <Menu>Other forms\Cylinder\Barrel\Barrelminx II (3 colors)</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6845</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000';
        Colors[1] := '00CC00';
        Colors[2] := '0055EE';

        R := 0.55;

        sAngle := 2 * Pi / 5;
        s5 := sqrt(5);

        H := R * 1.1;
        D := (R - H / (3+s5)) / sqrt(1 + 1/(3+s5)^2);

        for i := 0 to 2 do begin
            Ax[i] := D * sin(2 * Pi / 3 * i);
            Ay[i] := D * cos(2 * Pi / 3 * i);
            Az[i] := D * 1/(3-s5);
        end;

        for i := 3 to 5 do begin
            Ax[i] := sin(2 * Pi / 3 * (i+0.5));
            Ay[i] := cos(2 * Pi / 3 * (i+0.5));
            Az[i] := 1/(3+s5);
        end;

        for i := 0 to 59 do begin
            x[i] := R * cos(2 * Pi / 60 * i);
            y[i] := R * sin(2 * Pi / 60 * i);
        end;
        DCut := R * 0.18;

        function FromTo(iFrom, iTo);
        begin
          Result := IntToStr(iFrom);
          for i := iFrom + 1 to iTo do
              Result := Result + ';' + IntToStr(i);
          for i := iFrom - 1 downto iTo do
              Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " Ax[0]; Ay[0]; Az[0]" />
        <Axis NormVector = " Ax[1]; Ay[1]; Az[1]" />
        <Axis NormVector = " Ax[2]; Ay[2]; Az[2]" />
        <Axis NormVector = " Ax[3]; Ay[3]; Az[3]" />
        <Axis NormVector = " Ax[4]; Ay[4]; Az[4]" />
        <Axis NormVector = " Ax[5]; Ay[5]; Az[5]" />
    </Axes>

    <Figure>
        <Macro Name = "Body" >
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "clUp" VertexIndexes = "FromTo(0, 59)" />

                    <Face Color = "Color" VertexIndexes = "60;61; 1; 0" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "61;62; 2; 1" InvisibleEdges = "10" />
