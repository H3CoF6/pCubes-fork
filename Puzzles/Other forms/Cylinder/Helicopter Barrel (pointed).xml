<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter Barrel (pointed)</Name>
        <Menu>Other forms\Cylinder\Helicopter Barrel (pointed)</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-12-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9373</Link>
    </Interface>
 
    <Script>
        Colors[0] := 'FFFF00'; // Yellow
        Colors[1] := 'FFFFFF'; // White
        Colors[2] := '9900DD'; // Violett
        Colors[3] := 'EE22BB'; // Pink
        Colors[4] := 'FF7700'; // Orange
        Colors[5] := '00AA00'; // Green
        Colors[6] := '0033EE'; // Blue
        Colors[7] := 'DD0011'; // Red

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / sqrt(2);
        jumAngle := Arccos(1/3);

        R := W;
        H := W;
        N := 40;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2 * Pi / N * i);
            y[i] := R * sin(2 * Pi / N * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>
 
    <Axes TurningAngles = "0;Pi" JumbleAngle = "jumAngle" PlaneDistances = "D" NormVectors = "Ex; Ey; Ez" />
 
    <Figure>
        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Colors[c]" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Macro Name = "MonoCylinder" >
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "Colors[c]" VertexIndexes = "FromTo(0, N - 1)" />
                    <ExecMacro MacroName = "AddFace" i = "0" Repeat = "N" />
                    <Face Color = "Colors[c]" VertexIndexes = "FromTo(2 * N - 1, N)" />
                </Faces>
            </Part>
            <SplitByAxes/>
            <RemoveGrayParts/>
            <HideContaining Vector = " 0;-R; H/2" />
            <HideContaining Vector = " 0; R; H/2" />
            <HideContaining Vector = "-R; 0;-H/2" />
            <HideContaining Vector = " R; 0;-H/2" />
            <RemoveAllVisible/>
        </Macro>

        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveContaining Vectors = "Vx;Vy;Vz" />
        <Hide><Plane NormVector = "-1; 0; 0" NormDistance = "-W * 0.2" /></Hide>
        <Hide><Plane NormVector = " 1; 0; 0" NormDistance = "-W * 0.2" /></Hide>
        <Hide><Plane NormVector = " 0;-1; 0" NormDistance = "-W * 0.2" /></Hide>
        <Hide><Plane NormVector = " 0; 1; 0" NormDistance = "-W * 0.2" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-W * 0.2" /></Hide>
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-W * 0.2" /></Hide>
        <HideContaining Vector = "-W;-W; 0" />
        <HideContaining Vector = "-W; W; 0" />
        <HideContaining Vector = " W;-W; 0" />
        <HideContaining Vector = " W; W; 0" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Part>
            <Vertices Vectors = " x; y; H" />
            <Vertices Vectors = " x; y;-H" />

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "FromTo(0, N - 1)" />
                <ExecMacro MacroName = "AddFace" i = "0" c = "3" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"         c = "4" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"         c = "2" Repeat = "N/4" />
                <ExecMacro MacroName = "AddFace"         c = "5" Repeat = "N/4" />
                <Face Color = "Colors[0]" VertexIndexes = "FromTo(2 * N - 1, N)" />
            </Faces>
        </Part>
 
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-W * 0.2" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-W * 0.2" /></Hide>
        <RemoveAllVisible/>

        <ExecMacro MacroName = "MonoCylinder" c = "7" />
        <Turn NormVector = "0;0;1" Angle = " Pi/2" />
        <ExecMacro MacroName = "MonoCylinder" c = "6" />
        <Turn NormVector = "0;0;1" Angle = "-Pi/2" />

        <Part>
            <Vertices>
                <Add Vector = "-W;-W; 0;" />
                <Add Vector = " W; W; 0;" />
                <Add Vector = " W;-W; 0;" />
                <Add Vector = "-W; W; 0;" />
                <Add Vector = " 0; 0;-W;" />
                <Add Vector = " 0; 0; W;" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[7]" VertexIndexes = "0;2;5" />
                <Face Color = "Colors[6]" VertexIndexes = "5;2;1" />
                <Face Color = "Colors[7]" VertexIndexes = "5;1;3" />
                <Face Color = "Colors[6]" VertexIndexes = "5;3;0" />
                <Face Color = "Colors[6]" VertexIndexes = "4;2;0" />
                <Face Color = "Colors[7]" VertexIndexes = "4;1;2" />
                <Face Color = "Colors[6]" VertexIndexes = "4;3;1" />
                <Face Color = "Colors[7]" VertexIndexes = "4;0;3" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />

        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Macros>
        <Macro Name = "Mezon" Public = "1" Description = "Mezon pattern (without colors' order)" >
            <Script> jumAngle := Arccos(1/3); </Script>

            <Turn Axis =  "3" Layer = "1" Angle = "-jumAngle"/>
            <Turn Axis =  "0" Layer = "1" Angle = " Pi"/>
            <Turn Axis = "11" Layer = "1" Angle = " Pi+jumAngle"/>
            <Turn Axis =  "7" Layer = "1" Angle = "-jumAngle"/>
            <Turn Axis = "11" Layer = "1" Angle = "-jumAngle"/>
            <Turn Axis =  "7" Layer = "1" Angle = " Pi+jumAngle"/>
            <Turn Axis =  "3" Layer = "1" Angle = " Pi+jumAngle"/>
            <Turn Axis =  "4" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "3" Layer = "1" Angle = "-jumAngle"/>
            <Turn Axis =  "0" Layer = "1" Angle = " jumAngle"/>
            <Turn Axis = "11" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "0" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "9" Layer = "1" Angle = " Pi"/>
            <Turn Axis = "11" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "9" Layer = "1" Angle = " Pi-jumAngle"/>
            <Turn Axis = "10" Layer = "1" Angle = "jumAngle"/>
            <Turn Axis =  "9" Layer = "1" Angle = " Pi"/>
            <Turn Axis = "10" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "9" Layer = "1" Angle = " Pi+jumAngle"/>
            <Turn Axis = "10" Layer = "1" Angle = "-jumAngle"/>
            <Turn Axis =  "6" Layer = "1" Angle = " Pi"/>
            <Turn Axis = "10" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "6" Layer = "1" Angle = " Pi-jumAngle"/>
            <Turn Axis = "11" Layer = "1" Angle = "-jumAngle"/>
            <Turn Axis =  "0" Layer = "1" Angle = " Pi"/>
            <Turn Axis = "11" Layer = "1" Angle = " Pi"/>
            <Turn Axis =  "9" Layer = "1" Angle = " jumAngle"/>
            <Turn Axis =  "5" Layer = "1" Angle = " jumAngle"/>
        </Macro>
        <Macro Name = "RandomTurns180" >
            <Turn Axis = "Random(12)" Layer = "1" Angle = "Pi"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(12)" Layer = "1" Angle = "Pi/6 * Random(12)"/>
        </Macro>
        <Macro Name = "Scramble180" Public = "1" >
            <ExecMacro MacroName = "RandomTurns180" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble180" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
