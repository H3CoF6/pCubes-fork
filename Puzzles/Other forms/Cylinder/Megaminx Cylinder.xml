                <Face Color = "Colors[1]" VertexIndexes = "52;53;13;12" InvisibleEdges = "10" />
                <Face Color = "Colors[1]" VertexIndexes = "53;54;14;13" InvisibleEdges = "10" />
                <Face Color = "Colors[1]" VertexIndexes = "54;55;15;14" InvisibleEdges = "10" />
                <Face Color = "Colors[1]" VertexIndexes = "55;56;16;15" InvisibleEdges = " 8" />
                <Face Color = "Colors[2]" VertexIndexes = "56;57;17;16" InvisibleEdges = " 2" />
                <Face Color = "Colors[2]" VertexIndexes = "57;58;18;17" InvisibleEdges = "10" />
                <Face Color = "Colors[2]" VertexIndexes = "58;59;19;18" InvisibleEdges = "10" />
                <Face Color = "Colors[2]" VertexIndexes = "59;60;20;19" InvisibleEdges = "10" />
