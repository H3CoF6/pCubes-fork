                <Face Color = "Colors[4]" VertexIndexes = "72;73;33;32" InvisibleEdges = " 2" />
                <Face Color = "Colors[4]" VertexIndexes = "73;74;34;33" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "74;75;35;34" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "75;76;36;35" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "76;77;37;36" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "77;78;38;37" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "78;79;39;38" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "79;40; 0;39" InvisibleEdges = " 8" />

                <Face Color = "clOrange" VertexIndexes = "FromTo(79, 40)" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
