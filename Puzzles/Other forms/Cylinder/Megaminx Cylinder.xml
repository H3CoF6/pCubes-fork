                <Face Color = "Colors[2]" VertexIndexes = "61;62;22;21" InvisibleEdges = "10" />
                <Face Color = "Colors[2]" VertexIndexes = "62;63;23;22" InvisibleEdges = "10" />
                <Face Color = "Colors[2]" VertexIndexes = "63;64;24;23" InvisibleEdges = " 8" />
                <Face Color = "Colors[3]" VertexIndexes = "64;65;25;24" InvisibleEdges = " 2" />
                <Face Color = "Colors[3]" VertexIndexes = "65;66;26;25" InvisibleEdges = "10" />
                <Face Color = "Colors[3]" VertexIndexes = "66;67;27;26" InvisibleEdges = "10" />
                <Face Color = "Colors[3]" VertexIndexes = "67;68;28;27" InvisibleEdges = "10" />
                <Face Color = "Colors[3]" VertexIndexes = "68;69;29;28" InvisibleEdges = "10" />
                <Face Color = "Colors[3]" VertexIndexes = "69;70;30;29" InvisibleEdges = "10" />
