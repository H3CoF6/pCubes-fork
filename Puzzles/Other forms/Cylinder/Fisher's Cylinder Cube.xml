<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher's Cylinder Cube</Name>
        <Menu>Other forms\Cylinder\Fisher's Cylinder Cube</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-09-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=764</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clYellow := 'FFFF00';

        R := 0.5;
        H := R;

        D := H / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Cylinder Radius = "R" Color = "clGreen"  Base = " 0; 0; D" Top = " 0; 0; H" TopColor  = "clRed"    />
        <Cylinder Radius = "R" Color = "clYellow" Base = " 0; 0;-D" Top = " 0; 0; D" />
        <Cylinder Radius = "R" Color = "clBlue"   Base = " 0; 0;-H" Top = " 0; 0;-D" BaseColor = "clOrange" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
