<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2 Layer Puck</Name>
        <Menu>Other forms\Cylinder\2 Layer Puck</Menu>
        <Inventor>Mariusz Dabrowski</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3138</Link>
    </Interface>

    <Script>
        Colors[ 0] := '990099'; // Violett
        Colors[ 1] := 'E30000'; //
        Colors[ 2] := 'FF800A'; // Orange
        Colors[ 3] := 'FFBF05'; //
        Colors[ 4] := 'FFFF00'; // Yellow
        Colors[ 5] := 'AFFF00'; //
        Colors[ 6] := '00FF00'; // LightGreen
        Colors[ 7] := '00BA00'; //
        Colors[ 8] := '009600'; // Green
        Colors[ 9] := '006B64'; //
        Colors[10] := '1C34C3'; // Blue
        Colors[11] := '0000C8'; //

        Colors[12] := '7F7F7F'; // Gray
        Colors[13] := 'FFFFFF'; // White

        N := 12;

        R := 0.6;
        R1 := R * 0.6;
        R2 := R * 0.3;
        H := R * 0.25;
        H1 := H * 1.002;
        H2 := H1 + H1 - H;
        Angle := 2 * Pi / N;
        ca := cos(Angle / 2);
        sa := sin(Angle / 2);
    </Script>

    <Axes TurningAngles = "0; Angle; Angle; 0" PlaneDistances = "-H;0; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "Angle / 2" />

        <Macro Name = "AddSector" >
            <Cylinder Radius = "R" Color = "Colors[i]" Base = " 0; 0; H" Top = " 0; 0;-H" >
                <Base Color = "Colors[i]"/>
                <Top  Color = "Colors[i]" />
            </Cylinder>

            <Cylinder Radius = "R1" >
                <Base X = "0" Y = "0" Z = " H"/>
                <Top  X = "0" Y = "0" Z = " H1" Color = "Colors[i]" />
            </Cylinder>

            <Cylinder Radius = "R1" >
                <Base X = "0" Y = "0" Z = "-H"/>
                <Top  X = "0" Y = "0" Z = "-H1" Color = "Colors[i]" />
            </Cylinder>

            <Cut> <Plane NormVector = "-ca; -sa; 0" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = " ca; -sa; 0" NormDistance = "0" /> </Cut>
            <Turn NormVector = "0; 0; 1" Angle = "Angle" />
            <HideAll/>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddSector" i = "0" Repeat = "N" />

        <ShowAll/>
        <Turn NormVector = "0; 0; 1" Angle = "-Angle / 2"/>

        <Circle Radius = "R2" Color = "Colors[N]"     Center = "0; 0;-H2" />
        <Circle Radius = "R2" Color = "Colors[N + 1]" Center = "0; 0; H2" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
