<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Column Pentultimate Master (3 colors)</Name>
        <Menu>Other forms\Cylinder\Column\Column Pentultimate Master (3 colors)</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-21</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := '0099FF'; // LightBlue;
        Colors[2] := 'FF7700'; // Orange;
        Colors[1] := '00BB00'; // Green;

        R := 0.5;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        H := R * sqrt(5) / 2;
        D := R * 0.096;

        for i := 0 to 39 do begin
            x[i] := R * cos(2 * Pi / 40 * i);
            y[i] := R * sin(2 * Pi / 40 * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "Cylinder" >
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "cl" VertexIndexes = "FromTo(0, 39)" />

                    <Face Color = "cl" VertexIndexes = "40;41; 1; 0" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "41;42; 2; 1" InvisibleEdges = "10" />
