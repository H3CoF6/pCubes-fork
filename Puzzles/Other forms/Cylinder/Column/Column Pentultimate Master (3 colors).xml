                    <Face Color = "cl" VertexIndexes = "79;40; 0;39" InvisibleEdges = "10" />

                    <Face Color = "cl" VertexIndexes = "FromTo(79, 40)" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Cylinder" cl = "Colors[0]" />
        <Cut Axis = "0" From = "2" />
        <HideAll/>

        <ExecMacro MacroName = "Cylinder" cl = "Colors[1]" />
        <Cut Axis = "0" To = "1" />
        <HideAll/>

        <ExecMacro MacroName = "Cylinder" cl = "Colors[2]" />
        <Cut Axis = "0" From = "1" To = "2" />
