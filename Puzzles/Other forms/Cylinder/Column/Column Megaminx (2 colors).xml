                    <Face Color = "cl" VertexIndexes = "77;78;38;37" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "78;79;39;38" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "79;40; 0;39" InvisibleEdges = "10" />

                    <Face Color = "cl" VertexIndexes = "79;78;77;76;75;74;73;72;71;70;69;68;67;66;65;64;63;62;61;60;59;58;57;56;55;54;53;52;51;50;49;48;47;46;45;44;43;42;41;40" />
                </Faces>
            </Part>
        </Macro>
        <ExecMacro MacroName = "Cylinder" cl = "Colors[0]" />

        <SplitByAxes/>

        <Macro Name = "HideCenters">
            <HideContaining Vector = "f*cx[id]; f*cy[id]; f*cz[id]" />
            <Script>Inc(id);</Script>
        </Macro>

        <Macro Name = "HideEdges">
            <HideContaining Vector = "f*ex[id]; f*ey[id]; f*ez[id]" />
            <Script>Inc(id);</Script>
        </Macro>

        <Macro Name = "Hide" >
            <ExecMacro MacroName = "HideCenters" id = " 0" Repeat = "12" />
            <ExecMacro MacroName = "HideEdges"   id = "25" Repeat = " 5" />
            <ExecMacro MacroName = "HideEdges"   id = " 0" Repeat = " 5" />
            <ExecMacro MacroName = "HideEdges"   id = "10" Repeat = " 5" />
            <ExecMacro MacroName = "HideEdges"   id = "15" Repeat = " 5" />
        </Macro>
        <ExecMacro MacroName = "Hide" />

        <InvertVisibility/>
        <RemoveAllVisible/>
        <ShowAll/>

        <InvertVisibility/>
        <ExecMacro MacroName = "Cylinder" cl = "Colors[1]" />
        <SplitByAxes/>

        <ExecMacro MacroName = "Hide" />
        <RemoveAllVisible/>
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
