<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mini Megaminx Cylinder</Name>
        <Menu>Other forms\Cylinder\Mini Megaminx Cylinder</Menu>
        <Inventor>Nathan Wilson</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-20</Added>
        <Link>https://www.youtube.com/watch?v=HRCCTLLyZLg</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := '9900CC'; // Violett
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := '00AA00'; // Green
        Colors[4] := '0077EE'; // Blue
        Colors[5] := '00CC00'; // Lightgreen
        Colors[6] := 'FF800A'; // Orange
        Colors[7] := '00CCCC'; // Cyan
        Colors[8] := 'EEBB00'; // LightBlue
        Colors[9] := 'FF00FF'; // Pink
        clWhite   := 'FFFFFF'; // White

        R := 0.5;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * 0.7;
        H := D;

        R1 := R * 0.85;
        H1 := H * 1.08;

        for i := 0 to 39 do begin
            x[i] := R * cos(2 * Pi / 40 * (i+10));
            y[i] := R * sin(2 * Pi / 40 * (i+10));
        end;

        DCut := D;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>

        <Macro Name = "Body" >
            <Part>
                <Vertices Vectors = "x; y; HC" />
                <Vertices Vectors = "x; y;-HC" />
                <Vertices Vectors = "0; 0;-HC" />
                <Faces>
                    <Face Color = "clWhite" VertexIndexes = "FromTo(0, 39)" />

                    <Face Color = "Colors[0]" VertexIndexes = "40;41; 1; 0" InvisibleEdges = " a" />
                    <Face Color = "Colors[0]" VertexIndexes = "41;42; 2; 1" InvisibleEdges = "10" />
                    <Face Color = "Colors[0]" VertexIndexes = "42;43; 3; 2" InvisibleEdges = "10" />
                    <Face Color = "Colors[0]" VertexIndexes = "43;44; 4; 3" InvisibleEdges = "10" />
                    <Face Color = "Colors[0]" VertexIndexes = "44;45; 5; 4" InvisibleEdges = "10" />
                    <Face Color = "Colors[0]" VertexIndexes = "45;46; 6; 5" InvisibleEdges = "10" />
                    <Face Color = "Colors[0]" VertexIndexes = "46;47; 7; 6" InvisibleEdges = "10" />
                    <Face Color = "Colors[0]" VertexIndexes = "47;48; 8; 7" InvisibleEdges = " b" />
                    <Face Color = "Colors[1]" VertexIndexes = "48;49; 9; 8" InvisibleEdges = " a" />
                    <Face Color = "Colors[1]" VertexIndexes = "49;50;10; 9" InvisibleEdges = "10" />
                    <Face Color = "Colors[1]" VertexIndexes = "50;51;11;10" InvisibleEdges = "10" />
                    <Face Color = "Colors[1]" VertexIndexes = "51;52;12;11" InvisibleEdges = "10" />
                    <Face Color = "Colors[1]" VertexIndexes = "52;53;13;12" InvisibleEdges = "10" />
                    <Face Color = "Colors[1]" VertexIndexes = "53;54;14;13" InvisibleEdges = "10" />
                    <Face Color = "Colors[1]" VertexIndexes = "54;55;15;14" InvisibleEdges = "10" />
                    <Face Color = "Colors[1]" VertexIndexes = "55;56;16;15" InvisibleEdges = " b" />
                    <Face Color = "Colors[2]" VertexIndexes = "56;57;17;16" InvisibleEdges = " a" />
                    <Face Color = "Colors[2]" VertexIndexes = "57;58;18;17" InvisibleEdges = "10" />
                    <Face Color = "Colors[2]" VertexIndexes = "58;59;19;18" InvisibleEdges = "10" />
                    <Face Color = "Colors[2]" VertexIndexes = "59;60;20;19" InvisibleEdges = "10" />
                    <Face Color = "Colors[2]" VertexIndexes = "60;61;21;20" InvisibleEdges = "10" />
                    <Face Color = "Colors[2]" VertexIndexes = "61;62;22;21" InvisibleEdges = "10" />
                    <Face Color = "Colors[2]" VertexIndexes = "62;63;23;22" InvisibleEdges = "10" />
                    <Face Color = "Colors[2]" VertexIndexes = "63;64;24;23" InvisibleEdges = " b" />
                    <Face Color = "Colors[3]" VertexIndexes = "64;65;25;24" InvisibleEdges = " a" />
                    <Face Color = "Colors[3]" VertexIndexes = "65;66;26;25" InvisibleEdges = "10" />
                    <Face Color = "Colors[3]" VertexIndexes = "66;67;27;26" InvisibleEdges = "10" />
                    <Face Color = "Colors[3]" VertexIndexes = "67;68;28;27" InvisibleEdges = "10" />
                    <Face Color = "Colors[3]" VertexIndexes = "68;69;29;28" InvisibleEdges = "10" />
                    <Face Color = "Colors[3]" VertexIndexes = "69;70;30;29" InvisibleEdges = "10" />
                    <Face Color = "Colors[3]" VertexIndexes = "70;71;31;30" InvisibleEdges = "10" />
                    <Face Color = "Colors[3]" VertexIndexes = "71;72;32;31" InvisibleEdges = " b" />
                    <Face Color = "Colors[4]" VertexIndexes = "72;73;33;32" InvisibleEdges = " a" />
                    <Face Color = "Colors[4]" VertexIndexes = "73;74;34;33" InvisibleEdges = "10" />
                    <Face Color = "Colors[4]" VertexIndexes = "74;75;35;34" InvisibleEdges = "10" />
                    <Face Color = "Colors[4]" VertexIndexes = "75;76;36;35" InvisibleEdges = "10" />
                    <Face Color = "Colors[4]" VertexIndexes = "76;77;37;36" InvisibleEdges = "10" />
                    <Face Color = "Colors[4]" VertexIndexes = "77;78;38;37" InvisibleEdges = "10" />
                    <Face Color = "Colors[4]" VertexIndexes = "78;79;39;38" InvisibleEdges = "10" />
                    <Face Color = "Colors[4]" VertexIndexes = "79;40; 0;39" InvisibleEdges = " b" />

                    <Face Color = "Colors[9]" VertexIndexes = "40;FromTo(79,72);80" />
                    <Face Color = "Colors[8]" VertexIndexes = "FromTo(72,64);80" />
                    <Face Color = "Colors[7]" VertexIndexes = "FromTo(64,56);80" />
                    <Face Color = "Colors[6]" VertexIndexes = "FromTo(56,48);80" />
                    <Face Color = "Colors[5]" VertexIndexes = "FromTo(48,40);80" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Body" HC = "H" a = "2" b = "8" />
        <HideAll/>

        <Script>
            Colors[0] := Colors[5];
            Colors[1] := Colors[6];
            Colors[2] := Colors[7];
            Colors[3] := Colors[8];
            Colors[4] := Colors[9];

            for i := 0 to 39 do begin
                x[i] := R1 / R * x[i];
                y[i] := R1 / R * y[i];
            end;
        </Script>
        <ExecMacro MacroName = "Body" HC = "H1" a = "10" b = "10" />
        <Cut> <Plane NormVector = "-Cx[0];-Cy[0];-Cz[0]" NormDistance = "D" /> </Cut>
        <HideAll/>

        <Script>
            for i := 0 to 4 do
                Colors[i] := clWhite;
        </Script>
        <ExecMacro MacroName = "Body" HC = "H1" a = "10" b = "10" />
        <Cut Color = "clWhite" > <Plane NormVector = " Cx[0]; Cy[0]; Cz[0]" NormDistance = "D" /> </Cut>

        <ShowAll/>
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
