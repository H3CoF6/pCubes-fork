<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Germany Puck</Name>
        <Menu>Other forms\Cylinder\Germany Puck</Menu>
        <Inventor>Zoltán Pataki, Udulo Mszmp and Géza Csomós</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1032</Link>
    </Interface>

    <Script>
        Colors[0] := 'DD0000'; // clRed
        Colors[1] := '222222'; // clBlack
        Colors[2] := 'FFFF00'; // clYellow

        ColorUp   := '232323';
        ColorDown := '666666';

        N := 12;

        R := 0.6;
        R1 := R * 0.5;
        H := R * 0.25;
        H1 := H * 1.005;
        Angle := 2 * Pi / N;

        ca := cos(Angle / 2);
        sa := sin(Angle / 2);
    </Script>

    <Axes TurningAngles = "0; Angle; 0" PlaneDistances = "-H; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "Angle / 2" />
        <Macro Name = "AddSector" >
            <Cylinder Radius = "R" Color = "Colors[c]" >
               <Base X = "0" Y = "0" Z = " H" Color = "Colors[c]"/>
               <Top  X = "0" Y = "0" Z = "-H" Color = "Colors[c]" />
            </Cylinder>
            <Cut> <Plane NormVector = "-ca; -sa; 0" /> </Cut>
            <Cut> <Plane NormVector = " ca; -sa; 0" /> </Cut>
            <Turn NormVector = "0; 0; 1" Angle = "Angle" />
            <HideAll/>
        </Macro>
        <ExecMacro MacroName = "AddSector" c = "2" />
        <ExecMacro MacroName = "AddSector" c = "2" />
        <ExecMacro MacroName = "AddSector" c = "2" />
        <ExecMacro MacroName = "AddSector" c = "2" />
        <ExecMacro MacroName = "AddSector" c = "1" />
        <ExecMacro MacroName = "AddSector" c = "1" />
        <ExecMacro MacroName = "AddSector" c = "1" />
        <ExecMacro MacroName = "AddSector" c = "1" />
        <ExecMacro MacroName = "AddSector" c = "0" />
        <ExecMacro MacroName = "AddSector" c = "0" />
        <ExecMacro MacroName = "AddSector" c = "0" />
        <ExecMacro MacroName = "AddSector" c = "0" />

        <ShowAll/>
        <Turn NormVector = "0; 0; 1" Angle = "-Angle / 2" />

        <Circle Radius = "R1" Color = "ColorUp  " Center =  " 0; 0; H1" />
        <Circle Radius = "R1" Color = "ColorDown" Center =  " 0; 0;-H1" />

        <SplitByAxes/>

        <SaveSolvedState/>
        <Macro Name = "SolvedStates">
            <Turn Axis = "0" Layer = "1" Angle = "Angle" />
            <SaveSolvedState/>
        </Macro>
        <ExecMacro MacroName = "SolvedStates" Repeat = "3" />
        <Undo Repeat = "3" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
