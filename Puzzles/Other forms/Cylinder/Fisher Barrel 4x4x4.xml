<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Barrel 4x4x4</Name>
        <Menu>Other forms\Cylinder\Fisher Barrel 4x4x4</Menu>
        <Inventor>Carlos Ramirez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-02-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9695</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        H := 0.5;
        R := H;

        N := 60;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2*Pi / N * i);
            y[i] := R * sin(2*Pi / N * i);
        end;

        D := H * 0.5;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Color" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = "FromTo( 0, N - 1)" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[3]" i = "0" Repeat = "N div 4" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[0]" Repeat = "N div 4" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[2]" Repeat = "N div 4" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[1]" Repeat = "N div 4" />
                <Face Color = "Colors[4]" VertexIndexes = "FromTo( 2 * N - 1, N)" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
