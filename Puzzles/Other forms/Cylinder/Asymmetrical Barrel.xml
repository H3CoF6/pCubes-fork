<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Asymmetrical Barrel</Name>
        <Menu>Other forms\Cylinder\Asymmetrical Barrel</Menu>
        <Menu>Other forms\3x3x3 variants\Cylinder\Asymmetrical Barrel</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6629</Link>
    </Interface>

    <Script>
        Colors[0] := '0055EE'; // Blue
        Colors[1] := 'FF7700'; // Orange
        Colors[2] := '00AA00'; // Green
        clYellow  := 'FFEE00';
        clWhite   := 'FFFFFF';
              
        R := 0.5;
        H := R;
        D := R / 3;

        for i := 0 to 39 do begin
            x[i] := R * cos(2 * Pi / 40 * i);
            y[i] := R * sin(2 * Pi / 40 * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "-1; 2; 2" />
        <Axis NormVector = " 2;-1; 2" />
        <Axis NormVector = " 2; 2;-1" />
    </Axes>

    <Figure>
        <Macro Name = "Body" >
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "clWhite" VertexIndexes = "FromTo(0, 39)" />

                    <Face Color = "Color" VertexIndexes = "40;41; 1; 0" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "41;42; 2; 1" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "42;43; 3; 2" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "43;44; 4; 3" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "44;45; 5; 4" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "45;46; 6; 5" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "46;47; 7; 6" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "47;48; 8; 7" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "48;49; 9; 8" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "49;50;10; 9" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "50;51;11;10" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "51;52;12;11" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "52;53;13;12" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "53;54;14;13" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "54;55;15;14" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "55;56;16;15" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "56;57;17;16" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "57;58;18;17" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "58;59;19;18" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "59;60;20;19" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "60;61;21;20" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "61;62;22;21" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "62;63;23;22" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "63;64;24;23" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "64;65;25;24" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "65;66;26;25" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "66;67;27;26" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "67;68;28;27" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "68;69;29;28" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "69;70;30;29" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "70;71;31;30" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "71;72;32;31" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "72;73;33;32" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "73;74;34;33" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "74;75;35;34" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "75;76;36;35" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "76;77;37;36" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "77;78;38;37" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "78;79;39;38" InvisibleEdges = "10" />
                    <Face Color = "Color" VertexIndexes = "79;40; 0;39" InvisibleEdges = "10" />

                    <Face Color = "clYellow" VertexIndexes = "FromTo(79, 40)" />
                </Faces>
            </Part>
        </Macro>

        <Turn NormVector = "1;0;0" Angle = "Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "Pi/4" />

        <ExecMacro MacroName = "Body" Color = "Colors[0]" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "2" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "Body" Color = "Colors[1]" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "1" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "Body" Color = "Colors[2]" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "0" />
        <RemoveAllVisible/>

        <ShowAll/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
