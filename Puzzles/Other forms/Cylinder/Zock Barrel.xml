<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Zock Barrel</Name>
        <Menu>Other forms\Cylinder\Zock Barrel</Menu>
        <Inventor>Javier Alla La</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-12-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11545</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clViolet := '990099';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        H := 0.5;
        R := H;

        N := 40;
        for i := 0 to N - 1 do begin
            x[i] := R * cos(2*Pi / N * (i+0));
            y[i] := R * sin(2*Pi / N * (i+0));
        end;

        D := x[N/5];

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" NormVectors = " 1; 0; 0" TurnAxesWithLayer = "0" />

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Color" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Macro Name = "AddCylinder" >
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "clWhite" VertexIndexes = "FromTo(0, N - 1)" />
                    <ExecMacro MacroName = "AddFace" i = "N/20" Color = "clRed"    Repeat = "N/4" />
                    <ExecMacro MacroName = "AddFace"            Color = "clGreen"  Repeat = "N/4" />
                    <ExecMacro MacroName = "AddFace"            Color = "clBlue"   Repeat = "N/4" />
                    <ExecMacro MacroName = "AddFace"            Color = "clViolet" Repeat = "N/4" />
                    <Face Color = "clYellow" VertexIndexes = "FromTo(2 * N - 1, N)" />
                </Faces>
            </Part>

            <Split Axis = "1" From = "1" />
            <Split Axis = "1" From = "2" />
            <Turn Axis = "1" Layers = "0;2" Angle = "Pi/2" />
            <SplitByAxes/>
            <Undo/>
        </Macro>

        <ExecMacro MacroName = "AddCylinder" />
        <SaveSolvedState/>

        <Turn Axis = "1" Layers = "1" Angle = "Pi/2" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <Undo/>
        <RemoveAllVisible/>
        <Turn NormVector = "0;0;1" Angle = "-Pi/2" />
        <ExecMacro MacroName = "AddCylinder" />
        <RemoveContaining Vector = " 0; 0;-D" />
        <RemoveContaining Vector = " 0; 0; D" />
        <RemoveContaining Vector = "-D; 0; 0" />
        <RemoveContaining Vector = " D; 0; 0" />
        <Turn NormVector = "0;0;1" Angle = " Pi/2" />
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
