<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Shark Fin Soup</Name>
        <Menu>Other forms\Cylinder\Shark Fin Soup</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5375</Link>
        <Added>2016-12-04</Added>
    </Interface>

    <Script>
        clGreen  := '009600';
        clRed    := 'FF0000';
        clGold   := 'E0C07D';

        R := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6;1/6">
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Cylinder Radius = "R" Color = "clGreen">
            <Base X = "1/6" Y = "1/6" Z = " 0.5" Color = "clGold" />
            <Top  X = "1/6" Y = "1/6" Z = " 1/6" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clGreen">
            <Base X = "1/6" Y = "1/6" Z = " 1/6" />
            <Top  X = "1/6" Y = "1/6" Z = "-1/6" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clGreen">
            <Base X = "1/6" Y = "1/6" Z = "-1/6" />
            <Top  X = "1/6" Y = "1/6" Z = "-0.5" Color = "clRed " />
        </Cylinder>

        <Split Axis = "0" From = "2" Color1 = "7F7F7F" Color2 = "7F7F7E" />
        <Split Axis = "1" From = "2" Color1 = "7F7F7D" Color2 = "7F7F7C" />

        <Split2ByAxes/>

    </Figure>
</xml>
