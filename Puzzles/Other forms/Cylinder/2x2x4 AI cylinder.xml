                <Face Color = "clYellow" VertexIndexes = "79;78;77;76;75;74;73;72;71;70;69;68;67;66;65;64;63;62;61;60;59;58;57;56;55;54;53;52;51;50;49;48;47;46;45;44;43;42;41;40" />
            </Faces>
        </Part>

        <Split><Plane NormVector = "1;0;0" NormDistance = "0" /></Split>
        <Split><Plane NormVector = "0;1;0" NormDistance = "0" /></Split>
        <Split><Plane NormVector = "0;0;1" NormDistance = "0" /></Split>
        <HideContaining Vector = " D; D; D" />
        <HideContaining Vector = " D;-D;-D" />
        <HideContaining Vector = "-D; D;-D" />
        <HideContaining Vector = "-D;-D; D" />
        <SplitByAxes/>
        <ShowAll/>

        <Split><Plane NormVector = "0;0;1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;0;1" NormDistance = " D" /></Split>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
