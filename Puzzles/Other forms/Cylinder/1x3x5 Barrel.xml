<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>1x3x5 Barrel</Name>
        <Menu>Other forms\Cylinder\1x3x5 Barrel</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-02-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1706</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        R := 0.6;
        H := 0.5;
        H2 := H + 0.002;

        for i := 0 to 3 do begin
            ax[i] := R * cos(Pi / 2 * i);
            ay[i] := R * sin(Pi / 2 * i);
        end;

        D := R / 3;
        DC := R / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "-0.2; -0.08; 0.08; 0.2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Script> Color := clRed; i := 0; </Script>
        <Cylinder Radius = "R" Color = "Color" >
            <Base X = "0" Y = "0" Z = "-H" Color = "clWhite " />
            <Top  X = "0" Y = "0" Z = " H" Color = "clYellow" />
        </Cylinder>
        <Cut Color = "Color"> <Plane NormVector = "ax[i]; ay[i]; 0" NormDistance = "DC" /> </Cut>
        <Hide Axis = "0" From = "0" To = "2" />

        <Script> Color := clGreen; i := 1; </Script>
        <Cylinder Radius = "R" Color = "Color" >
            <Base X = "0" Y = "0" Z = "-H" Color = "clWhite " />
            <Top  X = "0" Y = "0" Z = " H" Color = "clYellow" />
        </Cylinder>
        <Cut Color = "Color"> <Plane NormVector = "ax[i]; ay[i]; 0" NormDistance = "DC" /> </Cut>
        <Hide Axis = "0" From = "0" To = "2" />

        <Script> Color := clOrange; i := 2; </Script>
        <Cylinder Radius = "R" Color = "Color" >
            <Base X = "0" Y = "0" Z = "-H" Color = "clWhite " />
            <Top  X = "0" Y = "0" Z = " H" Color = "clYellow" />
        </Cylinder>
        <Cut Color = "Color"> <Plane NormVector = "ax[i]; ay[i]; 0" NormDistance = "DC" /> </Cut>
        <Hide Axis = "0" From = "0" To = "2" />

        <Script> Color := clBlue; i := 3; </Script>
        <Cylinder Radius = "R" Color = "Color" >
            <Base X = "0" Y = "0" Z = "-H" Color = "clWhite " />
            <Top  X = "0" Y = "0" Z = " H" Color = "clYellow" />
        </Cylinder>
        <Cut Color = "Color"> <Plane NormVector = "ax[i]; ay[i]; 0" NormDistance = "DC" /> </Cut>

        <ShowAll/>

        <Circle Radius = "R" Color = "clYellow" > <Center X =  "0" Y =  "0" Z = " H2" /> </Circle>
        <Circle Radius = "R" Color = "clWhite " > <Center X =  "0" Y =  "0" Z = "-H2" /> </Circle>

        <!-- Special for Solving -->
        <Split Axis = "0" From = "1" Color2 = "clOrange" />
        <Split Axis = "0" From = "2" Color1 = "clRed   " />

        <Part>
            <Vertices>
                <Add Vector = "-DC; -DC; -H" />
                <Add Vector = "-DC; -DC; H" />
                <Add Vector = "-DC; DC; -H" />
                <Add Vector = "-DC; DC; H" />
                <Add Vector = "DC; -DC; -H" />
                <Add Vector = "DC; -DC; H" />
                <Add Vector = "DC; DC; -H" />
                <Add Vector = "DC; DC; H" />
            </Vertices>

            <Faces>
                <Face VertexIndexes = "1;0;4;5" />
                <Face VertexIndexes = "2;3;7;6" />
                <Face VertexIndexes = "0;1;3;2" />
                <Face VertexIndexes = "5;4;6;7" />
                <Face VertexIndexes = "0;2;6;4" />
                <Face VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

    </Figure>
</xml>
