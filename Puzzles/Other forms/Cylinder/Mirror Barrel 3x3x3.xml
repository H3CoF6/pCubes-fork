    <Interface>
        <Name>Mirror Barrel 3x3x3</Name>
        <Menu>Other forms\Cylinder\Mirror Barrel 3x3x3</Menu>
        <Menu>Other forms\3x3x3 variants\Cylinder\Mirror Barrel</Menu>
        <Inventor>not invented</Inventor>
