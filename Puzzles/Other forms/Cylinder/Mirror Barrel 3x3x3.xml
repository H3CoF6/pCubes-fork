        <Link></Link>
    </Interface>

    <Script>
        Color := '888888'; // Silver

        R := 0.5;
        H := R;
        D := R / 3;

        DX := R * 0.2;
        DY := R * 0.1;
        DZ := R * 0.3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Cylinder Radius = "R" Color = "Color" Base = " DX; DY; DZ - H" BaseColor = "Color" Top = " DX; DY; DZ + H" TopColor = "Color" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
