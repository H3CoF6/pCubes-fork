<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>24 Cylinder X</Name>
        <Menu>Other forms\Cylinder\24 Cylinder X</Menu>
        <Inventor>Zhanqiang Li</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6219</Link>
    </Interface>

    <Script>
        Colors[0] := 'C80000'; // Red
        Colors[1] := 'FF800A'; // Orange
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := '009600'; // Green
        Colors[4] := '0000C8'; // Blue
        Colors[5] := '800080'; // Violett

        R := 0.5;
        H := R;

        Sector := 2*Pi / 3;
        for i := 0 to 2 do begin
            ax[i] := cos(Sector * i);
            ay[i] := sin(Sector * i);
        end;

        s2 := sqrt(2);
        s6 := sin(Pi/6);
        c6 := cos(Pi/6);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " ax[0]; ay[0]; 0" />
        <Axis NormVector = " ax[1]; ay[1]; 0" />
        <Axis NormVector = " ax[2]; ay[2]; 0" />

        <Axis NormVector = " ay[0]; ax[0]; s2" />
        <Axis NormVector = " ay[1]; ax[1]; s2" />
        <Axis NormVector = " ay[2]; ax[2]; s2" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "Pi/6" />

        <Macro Name = "AddSector" >
            <Cylinder Radius = "R" Color = "Colors[i]" >
               <Base X = "0" Y = "0" Z = " H" Color = "Colors[i]"/>
               <Top  X = "0" Y = "0" Z = "-H" Color = "Colors[i]" />
            </Cylinder>
            <Cut> <Plane NormVector = "-c6;-s6; 0" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = " c6;-s6; 0" NormDistance = "0" /> </Cut>
            <Turn NormVector = "0; 0; 1" Angle = "Pi/3" />
            <HideAll/>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddSector" i = "0" Repeat = "6" />
        <Turn NormVector = "0; 0; 1" Angle = "-Pi/6" />

        <ShowAll/>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
