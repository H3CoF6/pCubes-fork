<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megamitosis</Name>
        <Menu>Other forms\Multi-core\Megamitosis</Menu>
        <Inventor>Jay Matthews</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-02-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6333</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D := (Rsin + R2sin) / 2 + R * 0.05;
        DD := (RSin - D) / As / 2;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D">
        <Axis NormVector = " Cx[ 0]; Cy[ 0]; Cz[ 0]" BaseVector = " 0; 0; DD" />
        <Axis NormVector = " Cx[ 1]; Cy[ 1]; Cz[ 1]" BaseVector = " 0; 0; DD" />
        <Axis NormVector = " Cx[ 2]; Cy[ 2]; Cz[ 2]" BaseVector = " 0; 0; DD" />
        <Axis NormVector = " Cx[ 3]; Cy[ 3]; Cz[ 3]" BaseVector = " 0; 0; DD" />
        <Axis NormVector = " Cx[ 4]; Cy[ 4]; Cz[ 4]" BaseVector = " 0; 0; DD" />
        <Axis NormVector = " Cx[ 5]; Cy[ 5]; Cz[ 5]" BaseVector = " 0; 0; DD" />
        <Axis NormVector = " Cx[ 6]; Cy[ 6]; Cz[ 6]" BaseVector = " 0; 0;-DD" />
        <Axis NormVector = " Cx[ 7]; Cy[ 7]; Cz[ 7]" BaseVector = " 0; 0;-DD" />
        <Axis NormVector = " Cx[ 8]; Cy[ 8]; Cz[ 8]" BaseVector = " 0; 0;-DD" />
        <Axis NormVector = " Cx[ 9]; Cy[ 9]; Cz[ 9]" BaseVector = " 0; 0;-DD" />
        <Axis NormVector = " Cx[10]; Cy[10]; Cz[10]" BaseVector = " 0; 0;-DD" />
        <Axis NormVector = " Cx[11]; Cy[11]; Cz[11]" BaseVector = " 0; 0;-DD" />
    </Axes>

    <Figure>
        <Transfer Vector = " 0; 0;-DD" />
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Transfer Vector = " 0; 0; DD" />

        <Transfer Vector = " 0; 0; DD" />
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Transfer Vector = " 0; 0;-DD" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0"/>

        <Macro Name = "Split" >
            <Turn Axis = "ax" Layer = "1" Angle = "2 * sAngle" />
            <SplitByAxes/>
            <Undo/>
            <Script>Inc(Ax);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "1" Repeat = "10" />

    </Figure>
</xml>
