<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Siamese Confused Pillows</Name>
        <Menu>Other forms\Multi-core\Siamese Confused Pillows</Menu>
        <Inventor>Benjy Oliver</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3395</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFA500'; // Bright orange
        Colors[ 2] := '0000FF'; // Blue
        Colors[ 3] := 'FFFF00'; // Yellow
        Colors[ 4] := 'FF5C00'; // Orange
        Colors[ 5] := '1D9F00'; // Green
        Colors[ 6] := 'A020F0'; // Light purple
        Colors[ 7] := '800080'; // Purple

        W := 0.33;
        D := W / 3;
        D1 := D * sqrt(2);
        D2 := D1 * 2;
        D3 := D1 * 3;
        D4 := D1 * 4;
        D5 := D1 * 5;
    </Script>

    <Axes TurningAngles = "0; Pi / 2; Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "-1; 0;-1" BaseVector = "-D2; 0; 0" />
        <Axis NormVector = "-1; 0; 1" BaseVector = "-D2; 0; 0" />
        <Axis NormVector = " 1; 0; 1" BaseVector = " D2; 0; 0" />
        <Axis NormVector = " 1; 0;-1" BaseVector = " D2; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D3;-D; D2" />
                <Add Vector = "-D1;-D; D2" />
                <Add Vector = " D1;-D; D2" />
                <Add Vector = " D3;-D; D2" />
                <Add Vector = "-D3; D; D2" />
                <Add Vector = "-D1; D; D2" />
                <Add Vector = " D1; D; D2" />
                <Add Vector = " D3; D; D2" />
                <Add Vector = "-D4;-W; D1" />
                <Add Vector = "  0;-W; D1" />
                <Add Vector = " D4;-W; D1" />
                <Add Vector = "-D4; W; D1" />
                <Add Vector = "  0; W; D1" />
                <Add Vector = " D4; W; D1" />
                <Add Vector = "-D5;-D;  0" />
                <Add Vector = " D5;-D;  0" />
                <Add Vector = "-D5; D;  0" />
                <Add Vector = " D5; D;  0" />
                <Add Vector = "-D4;-W;-D1" />
                <Add Vector = "  0;-W;-D1" />
                <Add Vector = " D4;-W;-D1" />
                <Add Vector = "-D4; W;-D1" />
                <Add Vector = "  0; W;-D1" />
                <Add Vector = " D4; W;-D1" />
                <Add Vector = "-D3;-D;-D2" />
                <Add Vector = "-D1;-D;-D2" />
                <Add Vector = " D1;-D;-D2" />
                <Add Vector = " D3;-D;-D2" />
                <Add Vector = "-D3; D;-D2" />
                <Add Vector = "-D1; D;-D2" />
                <Add Vector = " D1; D;-D2" />
                <Add Vector = " D3; D;-D2" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 8; 9; 1" />
                <Face Color = "Colors[0]" VertexIndexes = " 2; 9;10; 3" />
                <Face Color = "Colors[0]" VertexIndexes = " 4; 5;12;11" />
                <Face Color = "Colors[0]" VertexIndexes = " 6; 7;13;12" />
                <Face Color = "Colors[0]" VertexIndexes = " 2; 3; 7; 6" />
                <Face Color = "Colors[0]" VertexIndexes = " 0; 1; 5; 4" />
                <Face Color = "Colors[1]" VertexIndexes = " 1; 9;12; 5" />
                <Face Color = "Colors[1]" VertexIndexes = " 2; 6;12; 9" />
                <Face Color = "Colors[2]" VertexIndexes = " 0; 4;11;16;14; 8" />
                <Face Color = "Colors[2]" VertexIndexes = " 3;10;15;17;13; 7" />
                <Face Color = "Colors[3]" VertexIndexes = " 8;14;18" />
                <Face Color = "Colors[3]" VertexIndexes = "10;20;15" />
                <Face Color = "Colors[3]" VertexIndexes = " 8;18;20;10" />
                <Face Color = "Colors[4]" VertexIndexes = "11;21;16" />
                <Face Color = "Colors[4]" VertexIndexes = "13;17;23" />
                <Face Color = "Colors[4]" VertexIndexes = "11;13;23;21" />
                <Face Color = "Colors[5]" VertexIndexes = "18;24;25;19" />
                <Face Color = "Colors[5]" VertexIndexes = "19;26;27;20" />
                <Face Color = "Colors[5]" VertexIndexes = "21;22;29;28" />
                <Face Color = "Colors[5]" VertexIndexes = "22;23;31;30" />
                <Face Color = "Colors[5]" VertexIndexes = "24;28;29;25" />
                <Face Color = "Colors[5]" VertexIndexes = "26;30;31;27" />
                <Face Color = "Colors[6]" VertexIndexes = "19;25;29;22" />
                <Face Color = "Colors[6]" VertexIndexes = "19;22;30;26" />
                <Face Color = "Colors[7]" VertexIndexes = "14;16;21;28;24;18" />
                <Face Color = "Colors[7]" VertexIndexes = "15;20;27;31;23;17" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "1" Layers = "1;2" Angle = " Pi/2" />
        <Turn Axis = "2" Layers = "1;2" Angle = "-Pi/2" />
        <SplitByAxes/>
        <Undo/>
        <Undo/>

        <Turn Axis = "0" Layers = "1;2" Angle = " Pi/2" />
        <Turn Axis = "3" Layers = "1;2" Angle = "-Pi/2" />
        <SplitByAxes/>
        <Undo/>
        <Undo/>

        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
