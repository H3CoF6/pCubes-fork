<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Siamese Octagons 1</Name>
        <Menu>Other forms\Multi-core\Siamese Octagons 1</Menu>
        <Inventor>Benjy Oliver</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3398</Link>
    </Interface>

    <Script>
        Colors[ 0] := '800080'; // purple
        Colors[ 1] := 'FFA500'; // bright orange
        Colors[ 2] := -1;
        Colors[ 3] := '1D9F00'; // green
        Colors[ 4] := 'FFFF00'; // yellow
        Colors[ 5] := 'FFFFFF'; // white
        Colors[ 6] := '87FF4A'; // bright green
        Colors[ 7] := '0000FF'; // Blue
        Colors[ 8] := 'A020F0'; // light purple
        Colors[ 9] := -1;
        Colors[10] := 'FF0000'; // red
        Colors[11] := 'D2B48C'; // tan
        Colors[12] := '00FFFF'; // aqua
        Colors[13] := 'FF5C00'; // orange
        Colors[14] := 'FFFF80'; // bright yellow
        Colors[15] := '4169E1'; // light blue

        W := 0.5;
        D := W / 5;
        D2 := D * 2;
        D3 := D * 3;
        DCut := D2 * sqrt(2);
        A := Pi / 2;
    </Script>
 
    <Axes>
        <Axis TurningAngles = "A; 0"    NormVector = " 1; 0; 0" BaseVector = "-D;-D2; 0" PlaneDistances = "-D"    />
        <Axis TurningAngles = "A; A; 0" NormVector = " 0; 1; 0" BaseVector = "-D;-D2; 0" PlaneDistances = "-D; D" />

        <Axis TurningAngles = "0; A"    NormVector = " 1; 0; 0" BaseVector = " D; D2; 0" PlaneDistances = " D"    />
        <Axis TurningAngles = "0; A; A" NormVector = " 0; 1; 0" BaseVector = " D; D2; 0" PlaneDistances = "-D; D" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D3" WY = "WX" WZ = "WX" DWX = " D" DWY = " D2" DWZ = "0" />

        <Cut Color = "Colors[10]"><Plane NormVector = "-1; 1; 0" BaseVector = " D; D2; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[11]"><Plane NormVector = "-1;-1; 0" BaseVector = " D; D2; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[12]"><Plane NormVector = " 1;-1; 0" BaseVector = " D; D2; 0" NormDistance = "-DCut" /></Cut>
        <HideAll/>

        <Script>
            for i := 0 to 3 do
                Colors[i] := Colors[i + 6];
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D3" WY = "WX" WZ = "WX" DWX = "-D" DWY = "-D2" DWZ = "0" />
        <Cut Color = "Colors[13]"><Plane NormVector = "-1; 1; 0" BaseVector = "-D;-D2; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[14]"><Plane NormVector = " 1; 1; 0" BaseVector = "-D;-D2; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[15]"><Plane NormVector = " 1;-1; 0" BaseVector = "-D;-D2; 0" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <SplitByAxes/>

        <RemoveContaining Vector = "0; 0; 0" />

        <Split><Plane NormVector = "0;0;1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "0;0;1" NormDistance = " D" /></Split>

        <Script>
            for i := 0 to 3 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "D2" WY = "D" WZ = "D3" DWX = "0" DWY = "0" DWZ = "0" />

        <Split><Plane NormVector = "1;0;0"/></Split>
        <RemoveGrayParts/>
    </Figure>
</xml>
