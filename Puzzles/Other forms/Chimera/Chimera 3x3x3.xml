<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chimera 3x3x3</Name>
        <Menu>Other forms\Chimera\Chimera 3x3x3</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7587</Link>
    </Interface>

    <Script>
        W := 0.38;
        D := W / 2;

        OW := W * 2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        // cube part
        <LoadFrom File = "Figures\Cube.xml" />
        <Cut> <Plane NormVector = "-1; -1; -1" /> </Cut>

        <InvertVisibility/>

        // octahedron part
        <Part>
            <Vertices>
                <Add Vector = "-OW;  0;  0" />
                <Add Vector = " OW;  0;  0" />
                <Add Vector = "  0;-OW;  0" />
                <Add Vector = "  0; OW;  0" />
                <Add Vector = "  0;  0;-OW" />
                <Add Vector = "  0;  0; OW" />
            </Vertices>

            <Faces>
                <Face Color = "FFFFFF" VertexIndexes = "0;2;5" />
                <Face Color = "FF77EE" VertexIndexes = "5;2;1" />
                <Face Color = "0077FF" VertexIndexes = "5;1;3" />
                <Face Color = "999999" VertexIndexes = "5;3;0" />
                <Face Color = "      " VertexIndexes = "4;2;0" />
                <Face Color = "FF800A" VertexIndexes = "4;1;2" />
                <Face Color = "AA00CC" VertexIndexes = "4;3;1" />
                <Face Color = "009600" VertexIndexes = "4;0;3" />
            </Faces>
        </Part>
        <Cut> <Plane NormVector = "1; 1; 1" /> </Cut>

        <ShowAll/>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
