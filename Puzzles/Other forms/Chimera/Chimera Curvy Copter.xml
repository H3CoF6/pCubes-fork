<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chimera Curvy Copter</Name>
        <Menu>Other forms\Chimera\Chimera Curvy Copter</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7683</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * (sqrt(2) / 2 + 0.12);
        OW := W * 2;
        CW := OW * 0.7;
        DW := W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        // cube part
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
        <SplitByAxes/>
        <HideContaining Vector = "0; 0; 0" />
        <RemoveAllVisible/>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />
        <ShowAll/>
        <Cut> <Plane NormVector = "-1; -1; -1" /> </Cut>

        <InvertVisibility/>

        // octahedron part
        <Part>
            <Vertices>
                <Add Vector = "-OW;  0;  0" />
                <Add Vector = " OW;  0;  0" />
                <Add Vector = "  0;-OW;  0" />
                <Add Vector = "  0; OW;  0" />
                <Add Vector = "  0;  0;-OW" />
                <Add Vector = "  0;  0; OW" />
            </Vertices>

            <Faces>
                <Face Color = "FFFFFF" VertexIndexes = "0;2;5" />
                <Face Color = "FF77EE" VertexIndexes = "5;2;1" />
                <Face Color = "0077FF" VertexIndexes = "5;1;3" />
                <Face Color = "999999" VertexIndexes = "5;3;0" />
                <Face Color = "      " VertexIndexes = "4;2;0" />
                <Face Color = "FF800A" VertexIndexes = "4;1;2" />
                <Face Color = "AA00CC" VertexIndexes = "4;3;1" />
                <Face Color = "009600" VertexIndexes = "4;0;3" />
            </Faces>
        </Part>
        <Cut> <Plane NormVector = "1; 1; 1" /> </Cut>
        <ShowAll/>
        <SplitByAxes/>
        <SaveSolvedState/>

        <RemoveContaining Vector = " OW;  0;  0" />
        <RemoveContaining Vector = " CW;-DW;  0" />
        <RemoveContaining Vector = " CW; DW;  0" />
        <RemoveContaining Vector = " CW;  0;-DW" />
        <RemoveContaining Vector = " CW;  0; DW" />

        <RemoveContaining Vector = "  0; OW;  0" />
        <RemoveContaining Vector = "-DW; CW;  0" />
        <RemoveContaining Vector = " DW; CW;  0" />
        <RemoveContaining Vector = "  0; CW;-DW" />
        <RemoveContaining Vector = "  0; CW; DW" />

        <RemoveContaining Vector = "  0;  0; OW" />
        <RemoveContaining Vector = "-DW;  0; CW" />
        <RemoveContaining Vector = " DW;  0; CW" />
        <RemoveContaining Vector = "  0;-DW; CW" />
        <RemoveContaining Vector = "  0; DW; CW" />

    <SaveSolvedState/>

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
