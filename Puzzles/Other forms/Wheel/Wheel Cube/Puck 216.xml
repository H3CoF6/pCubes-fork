<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Puck 2/16</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Puck 2/16</Menu>
        <Menu>Other forms\Square-1\Puck 2/16</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-07-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2732</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W  := 0.48;
        Wc := 0.54;
        R  := W * 0.8;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi/8" PlaneDistances = "-W; W" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -W" />
                <Add Vector = "-W; -W;  W" />
                <Add Vector = "-W;  W; -W" />
                <Add Vector = "-W;  W;  W" />
                <Add Vector = " W; -W; -W" />
                <Add Vector = " W; -W;  W" />
                <Add Vector = " W;  W; -W" />
                <Add Vector = " W;  W;  W" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "W" />
            <Top  X = "0" Y = "0" Z = "Wc" Color = "clWhite" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-W" />
            <Top  X = "0" Y = "0" Z = "-Wc" Color = "clYellow" />
        </Cylinder>

        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi / 8" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi / 8" />
        <SplitByAxes/>
    </Figure>
</xml>
