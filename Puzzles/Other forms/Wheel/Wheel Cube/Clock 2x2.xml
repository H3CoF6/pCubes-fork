<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clock 2x2</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Clock 2x2</Menu>
        <Menu>Other forms\Square-1\Clock 2x2</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6692</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W  := 0.48;
        W1 := W + 0.001;
        Wc := 0.54;
        R  := W * 0.8;
    </Script>

    <Axes TurningAngles = "Pi/6; Pi/2; Pi/2; Pi/6" PlaneDistances = "-W; 0; W" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W1; -W1; -W" />
                <Add Vector = "-W1; -W1;  W" />
                <Add Vector = "-W1;  W1; -W" />
                <Add Vector = "-W1;  W1;  W" />
                <Add Vector = " W1; -W1; -W" />
                <Add Vector = " W1; -W1;  W" />
                <Add Vector = " W1;  W1; -W" />
                <Add Vector = " W1;  W1;  W" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "W" />
            <Top  X = "0" Y = "0" Z = "Wc" Color = "clWhite" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-W" />
            <Top  X = "0" Y = "0" Z = "-Wc" Color = "clYellow" />
        </Cylinder>

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 6" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi / 6" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 6" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi / 6" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
    </Figure>
</xml>
