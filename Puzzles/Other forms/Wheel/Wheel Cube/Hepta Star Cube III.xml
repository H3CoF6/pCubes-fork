<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hepta Star Cube III</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Hepta Star Cube III</Menu>
        <Programmer>Skallos</Programmer>
        <Inventor>not invented</Inventor>
        <Added>2017-11-04</Added>
    </Interface>

    <Script>
        W := 0.425;
        RC := W * 0.8;
        Sc := 1.3;
        D := W * 0.1;
        sAngle := 2 * Pi / 7;
    </Script>

    <Axes TurningAngles = "Pi/14; Pi/2; 0; Pi/2; Pi/14" PlaneDistances = "-W; -D; D; W" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Macro Name = "AddCircle" >
            <HideAll/>

            <Cylinder Radius = "RC" Color = "Colors[i]" >
                <Base X = "Cx[i]" Y = "Cy[i]" Z = "Cz[i]" />
                <Top  X = "Cx[i] * Sc" Y = "Cy[i] * Sc" Z = "Cz[i] * Sc" Color = "Colors[i]" />
            </Cylinder>

            <Script>
                ax := i div 2;
                Layer := (i mod 2) * 4;
                cut := (ax + 1) mod 3;
            </Script>

            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Turn  Axis = "ax"  Layer = "Layer" Angle = "sAngle" />
            <Split Axis = "cut" From  = "2" />
            <Undo/>

            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" i = "0" Repeat = "6" />
        <ShowAll/>

    </Figure>

    <Macros>
        <Macro Name = "Red" >
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/14"/>
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/14"/>
            <Turn Axis = "0" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/14"/>
            <Turn Axis = "1" Layer = "0" Angle = " Pi/14"/>
            <Turn Axis = "0" Layer = "0" Angle = "2*Pi/7 * (Random(6) + 1)"/>
        </Macro>
        <Macro Name = "Orange" >
            <Turn Axis = "1" Layer = "0" Angle = " Pi/14"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/14"/>
            <Turn Axis = "2" Layer = "0" Angle = " Pi/7"/>
            <Turn Axis = "2" Layer = "4" Angle = " Pi/7"/>
            <Turn Axis = "0" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "4" Angle = "-Pi/7"/>
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/7"/>
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/14"/>
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "0" Layer = "4" Angle = "2*Pi/7 * (Random(6) + 1)"/>
        </Macro>
        <Macro Name = "Blue" >
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/14"/>
            <Turn Axis = "2" Layer = "4" Angle = "-Pi/14"/>
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "4" Angle = " Pi/14"/>
            <Turn Axis = "2" Layer = "0" Angle = " Pi/14"/>
            <Turn Axis = "1" Layer = "0" Angle = "2*Pi/7 * (Random(6) + 1)"/>
        </Macro>
        <Macro Name = "Green" >
            <Turn Axis = "2" Layer = "0" Angle = " Pi/14"/>
            <Turn Axis = "2" Layer = "4" Angle = " Pi/14"/>
            <Turn Axis = "0" Layer = "0" Angle = " Pi/7"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/7"/>
            <Turn Axis = "1" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/7"/>
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/7"/>
            <Turn Axis = "2" Layer = "4" Angle = "-Pi/14"/>
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/14"/>
            <Turn Axis = "1" Layer = "4" Angle = "2*Pi/7 * (Random(6) + 1)"/>
        </Macro>
        <Macro Name = "Yellow" >
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/14"/>
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/14"/>
            <Turn Axis = "2" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/14"/>
            <Turn Axis = "0" Layer = "0" Angle = " Pi/14"/>
            <Turn Axis = "2" Layer = "0" Angle = "2*Pi/7 * (Random(6) + 1)"/>
        </Macro>
        <Macro Name = "White" >
            <Turn Axis = "0" Layer = "0" Angle = " Pi/14"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/14"/>
            <Turn Axis = "1" Layer = "0" Angle = " Pi/7"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/7"/>
            <Turn Axis = "2" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/7"/>
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/7"/>
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/14"/>
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/14"/>
            <Turn Axis = "2" Layer = "4" Angle = "2*Pi/7 * (Random(6) + 1)"/>
        </Macro>

        <Macro Name = "RandomTurn" >
            <ExecMacro MacroName = "Red" />
            <ExecMacro MacroName = "Orange" />
            <ExecMacro MacroName = "Blue" />
            <ExecMacro MacroName = "Green" />
            <ExecMacro MacroName = "Yellow" />
            <ExecMacro MacroName = "White" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "" >
            <ExecMacro MacroName = "RandomTurn" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
