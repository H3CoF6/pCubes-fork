<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Time Machine 4x4x4</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Time Machine 4x4x4</Menu>
        <Inventor>Silvestre Cruz Quiroz</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11351</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        clBlue1   := '0000C9';
        clGreen1  := '009601';
        clRed1    := 'C80001';
        clOrange1 := 'FF800B';
        clYellow1 := 'FFFF01';
        clWhite1  := 'FFFFFE';

        W := 0.4;

        RC := W * 0.7;
        WC := W * 1.3;
        RC2 := W * 0.3;
        WC2 := WC * 1.001;

        C := 0.001;
        DC := (-RC * C + WC) / sqrt(C^2 + 1) * 0.99;

        N := 5;
        for i := 0 to N do begin
            x[i] := RC * cos(2*Pi / 12 / N * i);
            y[i] := RC * sin(2*Pi / 12 / N * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = " Pi/2; Pi/6; Pi/2; Pi/2; Pi/2; Pi/2; Pi/6; Pi/2" PlaneDistances = "-WC;-W;-RC; 0; RC; W; WC" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace" >
            <Face Color = "Color" VertexIndexes = " i + N + 1; i + N + 2; i + 1; i" InvisibleEdges = "10" />
            <Script> Inc(i); </Script>
        </Macro>

        <Macro Name = "AddSector" >
            <Part>
                <Vertices Vectors = "-W ; x; y" /> 0..N
                <Vertices Vectors = "-WC; x; y" /> N+1..2*N + 1
                <Vertices Vectors = "-W ; 0; 0" /> 2*N + 2
                <Vertices Vectors = "-WC; 0; 0" /> 2*N + 3

                <Faces>
                    <Face Color = "-1"     VertexIndexes = "2*N + 3; FromTo(2*N+1,N+1)" />
                    <Face Color = "Color2" VertexIndexes = "2*N + 2; FromTo(0,N)" />
                    <Face Color = "Color1" VertexIndexes = " N + 1; N + 2; 1; 0" InvisibleEdges = "2" />
                    <ExecMacro MacroName = "AddFace" Color = "Color1" Repeat = "N - 2" i = "1" />
                    <Face Color = "Color" VertexIndexes = "2 * N; 2 * N + 1; N; N - 1" InvisibleEdges = "8" />
                    <Face VertexIndexes = "2*N + 2; 2*N + 3; N + 1; 0" />
                    <Face VertexIndexes = "2*N + 3; 2*N + 2; N; 2 * N + 1" />
                </Faces>
            </Part>
            <Turn NormVector = "1;0;0" Angle = "-Pi/6" />
        </Macro>

        <Macro Name = "AddCircle" >
            <ExecMacro MacroName = "AddSector" Repeat = "12" />
            <Cut Color = "Color3" > <Plane NormVector = " 1;-C; 0" NormDistance = "-DC" /> </Cut>
            <Turn NormVector = "0;0;1" Angle = " Pi" />
        </Macro>
        <ExecMacro MacroName = "AddCircle" Color1 = "Colors[0]" Color2 = "Colors[1]" Color3 = "clRed1   " />
        <ExecMacro MacroName = "AddCircle" Color1 = "Colors[1]" Color2 = "Colors[0]" Color3 = "clOrange1" />
        <Turn NormVector = "1;1;1" Angle = "-2*Pi/3" />
        <ExecMacro MacroName = "AddCircle" Color1 = "Colors[2]" Color2 = "Colors[3]" Color3 = "clBlue1  " />
        <ExecMacro MacroName = "AddCircle" Color1 = "Colors[3]" Color2 = "Colors[2]" Color3 = "clGreen1 " />
        <Turn NormVector = "1;1;1" Angle = "-2*Pi/3" />
        <ExecMacro MacroName = "AddCircle" Color1 = "Colors[4]" Color2 = "Colors[5]" Color3 = "clYellow1" />
        <ExecMacro MacroName = "AddCircle" Color1 = "Colors[5]" Color2 = "Colors[4]" Color3 = "clWhite1 " />
        <Turn NormVector = "1;1;1" Angle = "-2*Pi/3" />

        <Macro Name = "AddCircle2" >
            <Circle Color = "Colors[i]" Radius = "RC2" Center = "-WC2;0;0" />
            <Turn NormVector = "0;0;1" Angle = " Pi" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle2" i = "0" />
        <ExecMacro MacroName = "AddCircle2" />
        <Turn NormVector = "1;1;1" Angle = "-2*Pi/3" />
        <ExecMacro MacroName = "AddCircle2" />
        <ExecMacro MacroName = "AddCircle2" />
        <Turn NormVector = "1;1;1" Angle = "-2*Pi/3" />
        <ExecMacro MacroName = "AddCircle2" />
        <ExecMacro MacroName = "AddCircle2" />
        <Turn NormVector = "1;1;1" Angle = "-2*Pi/3" />


        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <Connect Layers = "0;2" />
        <Connect Layers = "5;7" />
    </Figure>

