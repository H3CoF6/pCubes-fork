<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Cube V</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Star Cube V</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Added>2018-08-31</Added>
        <Link></Link>
    </Interface>

   <Script>
      clBlue   := '0000C8';
      clGreen  := '009600';
      clRed    := 'C80000';
      clOrange := 'FF800A';
      clYellow := 'FFFF00';
      clWhite  := 'FFFFFF';

      Width := 0.95;
      CylinderWidth := 0.03;
      R := 0.31;
      D := 0.425;
      D2 := 1/2 * Width;
      D3 := D2 + CylinderWidth;
   </Script>

    <Axes TurningAngles = "Pi/10; 0; Pi/10" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D2; -D2; -D2" />
                <Add Vector = "-D2; -D2; D2" />
                <Add Vector = "-D2; D2; -D2" />
                <Add Vector = "-D2; D2; D2" />
                <Add Vector = "D2; -D2; -D2" />
                <Add Vector = "D2; -D2; D2" />
                <Add Vector = "D2; D2; -D2" />
                <Add Vector = "D2; D2; D2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "D2" Y = "0" Z = "0" />
            <Top  X = "D3" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "-D2" Y = "0" Z = "0" />
            <Top  X = "-D3" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "D2" Z = "0" />
            <Top  X = "0" Y = "D3" Z = "0" Color = "clGreen" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-D2" Z = "0" />
            <Top  X = "0" Y = "-D3" Z = "0" Color = "clBlue" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "D2" />
            <Top  X = "0" Y = "0" Z = "D3" Color = "clWhite" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-D2" />
            <Top  X = "0" Y = "0" Z = "-D3" Color = "clYellow" />
        </Cylinder>

        <Macro Name = "SplitPart">
            <Split Axis = "3" From = "2" />
            <Split Axis = "6" From = "1" />
            <Split Axis = "8" From = "1" />
            <Turn Axis = "0" Angle = "2*Pi/5" Layer = "2" />
            <Turn Axis = "1" Angle = "2*Pi/5" Layer = "2" />
            <Turn Axis = "2" Angle = "2*Pi/5" Layer = "2" />
            <Turn Axis = "0" Angle = "2*Pi/5" Layer = "0" />
            <Turn Axis = "1" Angle = "2*Pi/5" Layer = "0" />
            <Turn Axis = "2" Angle = "2*Pi/5" Layer = "0" />
        </Macro>

        <ExecMacro MacroName = "SplitPart" Repeat="5"/>

    </Figure>
</xml>
