<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Time Machop</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Time Machop</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-07-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11856</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Colors[10] := 'C80001';
        Colors[11] := 'FF810A';
        Colors[12] := '0001C8';
        Colors[13] := '009601';
        Colors[14] := 'FFFF01';
        Colors[15] := 'FFFFFE';

        W := 0.425;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        CylinderWidth := W / 6;
        D2 := W + CylinderWidth;
        Sc := (W + CylinderWidth) / W;
        RC := W * 0.8;
        Sc2 := Sc * 1.005;
        Rc2 := W * 0.4;

        C := 0.001;
        DC := (-RC * C + W + CylinderWidth) / sqrt(C^2 + 1) * 0.99;
    </Script>

    <Axes TurningAngles = " 0; Pi/6; 0; Pi/6; 0" PlaneDistances = "-D2;-W; W; D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Axes TurningAngles = " 0; Pi/6; 0; Pi/6; 0" PlaneDistances = "-D2;-W; W; D2" >
        <Axis NormVector = "-2; 2; 1" />
        <Axis NormVector = " 2; 2; 1" />
        <Axis NormVector = " 2;-2; 1" />
        <Axis NormVector = "-2;-2; 1" />
        <Axis NormVector = " 1;-2; 2" />
        <Axis NormVector = " 1; 2; 2" />
        <Axis NormVector = " 1; 2;-2" />
        <Axis NormVector = " 1;-2;-2" />
        <Axis NormVector = " 2; 1;-2" />
        <Axis NormVector = " 2; 1; 2" />
        <Axis NormVector = "-2; 1; 2" />
        <Axis NormVector = "-2; 1;-2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "AddCircle1" >
            <Cylinder Radius = "RC" Color = "Colors[i]" >
            <Base X = "Cx[i]" Y = "Cy[i]" Z = "Cz[i]" />
            <Top  X = "Cx[i] * Sc" Y = "Cy[i] * Sc" Z = "Cz[i] * Sc" Color = "Colors[i]" />
            </Cylinder>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle1" i = "0" Repeat = "6" />

        <Cut Color = "Colors[10]" > <Plane NormVector = " 1;-C; 0" NormDistance = "-DC" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "-1; C; 0" NormDistance = "-DC" /> </Cut>
        <Cut Color = "Colors[12]" > <Plane NormVector = " 0; 1;-C" NormDistance = "-DC" /> </Cut>
        <Cut Color = "Colors[13]" > <Plane NormVector = " 0;-1; C" NormDistance = "-DC" /> </Cut>
        <Cut Color = "Colors[14]" > <Plane NormVector = "-C; 0; 1" NormDistance = "-DC" /> </Cut>
        <Cut Color = "Colors[15]" > <Plane NormVector = " C; 0;-1" NormDistance = "-DC" /> </Cut>

        <Macro Name = "AddCircle2" >
            <Circle Radius = "RC2" Color = "Colors[i]" Center = " Cx[i] * Sc2; Cy[i] * Sc2; Cz[i] * Sc2;" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle2" i = "0" Repeat = "6" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "8" From = "1" />


        <S1plitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <Turn Axis = "0" Layer = "3" Angle = "Pi/6" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/6" />
        <Turn Axis = "1" Layer = "3" Angle = "Pi/6" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/6" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi/6" />
        <S1plitByAxes/>
        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "8" From = "1" />

        <Turn Axis = "0" Layer = "1" Angle = "Pi/6" />
        <Turn Axis = "0" Layer = "3" Angle = "Pi/6" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/6" />
        <Turn Axis = "1" Layer = "3" Angle = "Pi/6" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/6" />
        <Turn Axis = "2" Layer = "3" Angle = "Pi/6" />
        <S1plitByAxes/>
        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "8" From = "1" />
    </Figure>


    <Textures>
        <Texture Name = "tm_01" File = "Puzzles\Other forms\Wheel\Wheel Cube\tm_01.vec" />
        <Texture Name = "tm_02" File = "Puzzles\Other forms\Wheel\Wheel Cube\tm_02.vec" />
