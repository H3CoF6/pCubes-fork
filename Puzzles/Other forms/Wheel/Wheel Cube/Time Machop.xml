    <Macros>
        <Macro Name = "Edge" >
            <Turn Axis = "Random(6) + 3" Layer = "Random(2)" Angle = "Pi" />
            <Turn Axis = "Random(3)" Layer = "Random(2) * 2 + 1" Angle = "Pi/6 * (Random(11) + 1)" />
        </Macro>
        <Macro Name = "RandomTurn" >
            <Turn Axis = "Random(6) + 3" Layer = "Random(2)" Angle = "2*Pi * Random" />
            <Turn Axis = "Random(3)" Layer = "Random(2) * 2 + 1" Angle = "Pi/6 * (Random(11) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "" >
            <ExecMacro MacroName = "Edge" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurn" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
