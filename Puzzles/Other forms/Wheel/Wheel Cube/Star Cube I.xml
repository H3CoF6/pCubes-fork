<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Cube I</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Star Cube I</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Added>2016-11-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2060</Link>
    </Interface>

   <Script>
      clBlue   := '0000C8';
      clGreen  := '009600';
      clRed    := 'C80000';
      clOrange := 'FF800A';
      clYellow := 'FFFF00';
      clWhite  := 'FFFFFF';

      Width := 0.95;
      CylinderWidth := 0.05;
      R := Width / 7 / cos(3 * Pi / 8);
      D1 := 1/6 * Width;
      D2 := 1/2 * Width;
      D3 := D2 + CylinderWidth;
   </Script>

    <Axes TurningAngles = "Pi/10; Pi/2; 0; Pi/2; Pi/10" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D2; -D2; -D2" />
                <Add Vector = "-D2; -D2; D2" />
                <Add Vector = "-D2; D2; -D2" />
                <Add Vector = "-D2; D2; D2" />
                <Add Vector = "D2; -D2; -D2" />
                <Add Vector = "D2; -D2; D2" />
                <Add Vector = "D2; D2; -D2" />
                <Add Vector = "D2; D2; D2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "D2" Y = "0" Z = "0" />
            <Top  X = "D3" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "-D2" Y = "0" Z = "0" />
            <Top  X = "-D3" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "D2" Z = "0" />
            <Top  X = "0" Y = "D3" Z = "0" Color = "clGreen" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-D2" Z = "0" />
            <Top  X = "0" Y = "-D3" Z = "0" Color = "clBlue" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "D2" />
            <Top  X = "0" Y = "0" Z = "D3" Color = "clWhite" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-D2" />
            <Top  X = "0" Y = "0" Z = "-D3" Color = "clYellow" />
        </Cylinder>

        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "4" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "4" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "4" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "1" Angle = "2*Pi/5" Layer = "4" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "2" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "0" From = "2" />

        <Turn Axis = "2" Angle = "1*Pi/10" Layer = "0" />
        <Turn Axis = "2" Angle = "1*Pi/10" Layer = "4" />

        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "0" Angle = "2*Pi/5" Layer = "4" />
        <Split Axis = "1" From = "2" />

    </Figure>

    <Procedures CheckSolved = "EachColorHasSameDirection" />

    <Macros>
        <Macro Name = "Red" >
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "2" Layer = "4" Angle = "-Pi/10"/>
            <Turn Axis = "0" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "4" Angle = " Pi/10"/>
            <Turn Axis = "2" Layer = "0" Angle = " Pi/10"/>
            <Turn Axis = "0" Layer = "0" Angle = "2*Pi/5 * (Random(4) + 1)"/>
        </Macro>
        <Macro Name = "Orange" >
            <Turn Axis = "1" Layer = "0" Angle = " Pi/5"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/5"/>
            <Turn Axis = "2" Layer = "0" Angle = " Pi/10"/>
            <Turn Axis = "2" Layer = "4" Angle = " Pi/10"/>
            <Turn Axis = "0" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "2" Layer = "4" Angle = "-Pi/10"/>
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/5"/>
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/5"/>
            <Turn Axis = "0" Layer = "4" Angle = "2*Pi/5 * (Random(4) + 1)"/>
        </Macro>
        <Macro Name = "Blue" >
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "1" Layer = "0" Angle = "2*Pi/5 * (Random(4) + 1)"/>
        </Macro>
        <Macro Name = "Green" >
            <Turn Axis = "2" Layer = "0" Angle = " Pi/5"/>
            <Turn Axis = "2" Layer = "4" Angle = " Pi/5"/>
            <Turn Axis = "0" Layer = "0" Angle = " Pi/5"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/5"/>
            <Turn Axis = "1" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/5"/>
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/5"/>
            <Turn Axis = "2" Layer = "4" Angle = "-Pi/5"/>
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/5"/>
            <Turn Axis = "1" Layer = "4" Angle = "2*Pi/5 * (Random(4) + 1)"/>
        </Macro>
        <Macro Name = "Yellow" >
            <Turn Axis = "0" Layer = "0" Angle = " Pi/10"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/10"/>
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/10"/>
            <Turn Axis = "2" Layer = "1" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/10"/>
            <Turn Axis = "1" Layer = "0" Angle = " Pi/10"/>
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/10"/>
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "2" Layer = "0" Angle = "2*Pi/5 * (Random(4) + 1)"/>
        </Macro>
        <Macro Name = "White" >
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/10"/>
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "1" Layer = "0" Angle = " Pi/10"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/10"/>
            <Turn Axis = "2" Layer = "3" Angle = " Pi/2 * (Random(3) + 1)"/>
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/10"/>
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/10"/>
            <Turn Axis = "0" Layer = "0" Angle = " Pi/10"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/10"/>
            <Turn Axis = "2" Layer = "4" Angle = "2*Pi/5 * (Random(4) + 1)"/>
        </Macro>

        <Macro Name = "RandomTurn" >
            <ExecMacro MacroName = "Red" />
            <ExecMacro MacroName = "Orange" />
            <ExecMacro MacroName = "Blue" />
            <ExecMacro MacroName = "Green" />
            <ExecMacro MacroName = "Yellow" />
            <ExecMacro MacroName = "White" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "" >
            <ExecMacro MacroName = "RandomTurn" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
