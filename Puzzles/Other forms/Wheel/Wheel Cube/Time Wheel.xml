<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Time Wheel</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Time Wheel</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-04-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4891</Link>
    </Interface>

    <Script>
        W := 0.425;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        CylinderWidth := W / 3;
        RC := W * 0.8;
        Wc := W + CylinderWidth;
        Sc := 1.3;

        D1 := W / 3;
        D2 := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "AddCircle" >
            <Cylinder Radius = "RC" Color = "Colors[i]" >
                <Base X = "Cx[i]" Y = "Cy[i]" Z = "Cz[i]" />
                <Top  X = "Cx[i] * Sc" Y = "Cy[i] * Sc" Z = "Cz[i] * Sc" Color = "Colors[i]" />
            </Cylinder>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" Repeat = "6" i = "0" />

        <SplitByAxes/>
   </Figure>
</xml>
