<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>CheeseBlock</Name>
        <Menu>Other forms\Wheel\Wheel Cube\CheeseBlock</Menu>
        <Inventor>Matt Shepit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1864</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        Width := 0.85;
        CylinderWidth := Width / 6;
        R := Width * 0.4;
        W2 := Width / 2;
        Wc := W2 + CylinderWidth;
    </Script>

    <Axes TurningAngles = "Pi/6;Pi/2;Pi/2;Pi/6" PlaneDistances = "-W2; 0; W2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W2; -W2; -W2" />
                <Add Vector = "-W2; -W2;  W2" />
                <Add Vector = "-W2;  W2; -W2" />
                <Add Vector = "-W2;  W2;  W2" />
                <Add Vector = " W2; -W2; -W2" />
                <Add Vector = " W2; -W2;  W2" />
                <Add Vector = " W2;  W2; -W2" />
                <Add Vector = " W2;  W2;  W2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "W2" Y = "0" Z = "0" />
            <Top  X = "Wc" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "-W2" Y = "0" Z = "0" />
            <Top  X = "-Wc" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "W2" Z = "0" />
            <Top  X = "0" Y = "Wc" Z = "0" Color = "clGreen" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-W2" Z = "0" />
            <Top  X = "0" Y = "-Wc" Z = "0" Color = "clBlue" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "W2" />
            <Top  X = "0" Y = "0" Z = "Wc" Color = "clWhite" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-W2" />
            <Top  X = "0" Y = "0" Z = "-Wc" Color = "clYellow" />
        </Cylinder>

        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "Pi / 3" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi / 3" Layer = "3" />
        <Turn Axis = "2" Angle = "Pi / 3" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 3" Layer = "3" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "Pi / 3" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi / 3" Layer = "3" />
        <Turn Axis = "2" Angle = "Pi / 3" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 3" Layer = "3" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "2" Angle = "Pi / 6" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 6" Layer = "3" />

        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "Pi / 3" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi / 3" Layer = "3" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "Pi / 3" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi / 3" Layer = "3" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = "Pi / 6" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi / 6" Layer = "3" />
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameDirection" />
</xml>
