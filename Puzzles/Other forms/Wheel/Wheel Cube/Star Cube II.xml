<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Cube II</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Star Cube II</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Added>2017-02-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4612</Link>
    </Interface>

   <Script>
      clBlue   := '0000C8';
      clGreen  := '009600';
      clRed    := 'C80000';
      clOrange := 'FF800A';
      clYellow := 'FFFF00';
      clWhite  := 'FFFFFF';

      Width := 0.95;
      CylinderWidth := 0.05;
      R := Width / 7 / cos(3 * Pi / 8);
      D1 := 0.415 * Width;
      D2 := 0.5 * Width;
      D3 := D2 + CylinderWidth;
   </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/10; 0; Pi/10" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D2;-D2;-D2" />
                <Add Vector = "-D2;-D2; D2" />
                <Add Vector = "-D2; D2;-D2" />
                <Add Vector = "-D2; D2; D2" />
                <Add Vector = " D2;-D2;-D2" />
                <Add Vector = " D2;-D2; D2" />
                <Add Vector = " D2; D2;-D2" />
                <Add Vector = " D2; D2; D2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "D2" Y = "0" Z = "0" />
            <Top  X = "D3" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "-D2" Y = "0" Z = "0" />
            <Top  X = "-D3" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "D2" Z = "0" />
            <Top  X = "0" Y = "D3" Z = "0" Color = "clGreen" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-D2" Z = "0" />
            <Top  X = "0" Y = "-D3" Z = "0" Color = "clBlue" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "D2" />
            <Top  X = "0" Y = "0" Z = "D3" Color = "clWhite" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-D2" />
            <Top  X = "0" Y = "0" Z = "-D3" Color = "clYellow" />
        </Cylinder>

        <Split Axis = "1" From = "2" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "2" />

        <Split Axis = "1" From = "1" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "0" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "0" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "0" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "0" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "4" Angle = "2*Pi/5" Layer = "0" />
        <Turn Axis = "5" Angle = "2*Pi/5" Layer = "2" />
        <Turn Axis = "6" Angle = "2*Pi/5" Layer = "0" />
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameDirection" />

    <Macros>
        <Macro Name = "TurnVertex" >
            <Turn Axis = "4" Layer = "0" Angle = " Pi/2 * i0 + Random(5) * 2 * Pi / 5"/>
            <Turn Axis = "4" Layer = "2" Angle = "-Pi/2 * i1 + Random(5) * 2 * Pi / 5"/>
            <Turn Axis = "5" Layer = "0" Angle = " Pi/2 * i2 + Random(5) * 2 * Pi / 5"/>
            <Turn Axis = "5" Layer = "2" Angle = "-Pi/2 * i3 + Random(5) * 2 * Pi / 5"/>
            <Turn Axis = "6" Layer = "0" Angle = " Pi/2 * i4 + Random(5) * 2 * Pi / 5"/>
            <Turn Axis = "6" Layer = "2" Angle = "-Pi/2 * i5 + Random(5) * 2 * Pi / 5"/>
            <Turn Axis = "Ax" Layer = "L" Angle = "2*Pi/3 * (Random(2) + 1)"/>
            <Turn Axis = "6" Layer = "2" Angle = " Pi/2 * i5"/>
            <Turn Axis = "6" Layer = "0" Angle = "-Pi/2 * i4"/>
            <Turn Axis = "5" Layer = "2" Angle = " Pi/2 * i3"/>
            <Turn Axis = "5" Layer = "0" Angle = "-Pi/2 * i2"/>
            <Turn Axis = "4" Layer = "2" Angle = " Pi/2 * i1"/>
            <Turn Axis = "4" Layer = "0" Angle = "-Pi/2 * i0"/>
        </Macro>

        <Macro Name = "AllVertices" >
            <ExecMacro MacroName = "TurnVertex" Ax = "0" L = "2" i0 = "0" i1 = "1" i2 = "0" i3 = "2" i4 = "0" i5 = "3" />
            <ExecMacro MacroName = "TurnVertex" Ax = "1" L = "2" i0 = "0" i1 = "0" i2 = "0" i3 = "0" i4 = "0" i5 = "0" />
            <ExecMacro MacroName = "TurnVertex" Ax = "2" L = "2" i0 = "2" i1 = "0" i2 = "3" i3 = "0" i4 = "0" i5 = "1" />
            <ExecMacro MacroName = "TurnVertex" Ax = "3" L = "2" i0 = "1" i1 = "0" i2 = "0" i3 = "3" i4 = "0" i5 = "2" />
            <ExecMacro MacroName = "TurnVertex" Ax = "0" L = "0" i0 = "3" i1 = "0" i2 = "2" i3 = "0" i4 = "1" i5 = "0" />
            <ExecMacro MacroName = "TurnVertex" Ax = "1" L = "0" i0 = "0" i1 = "0" i2 = "0" i3 = "0" i4 = "0" i5 = "0" />
            <ExecMacro MacroName = "TurnVertex" Ax = "2" L = "0" i0 = "0" i1 = "2" i2 = "0" i3 = "1" i4 = "3" i5 = "0" />
            <ExecMacro MacroName = "TurnVertex" Ax = "3" L = "0" i0 = "0" i1 = "3" i2 = "1" i3 = "0" i4 = "2" i5 = "0" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "" >
            <ExecMacro MacroName = "AllVertices" Repeat = "10" />
        </Macro>
    </Macros>
</xml>
