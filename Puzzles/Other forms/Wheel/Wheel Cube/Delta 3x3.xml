<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Delta 3x3</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Delta 3x3</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8629</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=408160#p408160</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0033EE'; // Blue
        Colors[3] := '00BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
        RC := D * 2;
        W1 := W * 1.1;

        N := 60;
        for i := 0 to N - 1 do begin
            x[i] := RC * cos(2 * Pi / N * i);
            y[i] := RC * sin(2 * Pi / N * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "0; Pi/2; Pi/6" PlaneDistances = "D; W" NormVectors = "Cx;Cy;Cz" />

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />
        <RemoveContaining Vector = "Cx;Cy;Cz" />

        <Macro Name = "AddFace" >
            <Script>
                i1 := i mod N;
                i2 := (i + 1) mod N;
                Inc(i);
            </Script>
            <Face Color = "Color" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
        </Macro>

        <Macro Name = "Cylinder">
            <Part>
                <Vertices Vectors = "x; y; W1" />
                <Vertices Vectors = "x; y; W" />

                <Faces>
                    <Face Color = "Color" VertexIndexes = "FromTo(0, N - 1)" />
                    <ExecMacro MacroName = "AddFace" i = "0" Color = "Color"   Repeat = "N" />
                    <Face                 VertexIndexes = "FromTo(2 * N - 1, N)" />
                </Faces>
            </Part>
        </Macro>


        <Macro Name = "Rotate" >
            <Turn NormVector = "0;0;1" Angle = "2*Pi/3" />
            <Split><Plane NormVector = "1;0;0" NormDistance = "-D" /></Split>
        </Macro>

        <Macro Name = "AddCircle" >
            <HideAll/>
            <ExecMacro MacroName = "Cylinder" Color = "Colors[c]" />
            <ExecMacro MacroName = "Rotate" Repeat = "3" i = "5" s1 = "0" />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "AddCircle" c = "5" />
        <ExecMacro MacroName = "AddCircle" c = "3" />
        <ExecMacro MacroName = "AddCircle" c = "1" />
        <Turn NormVector = "1;-1;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddCircle" c = "4" />
        <ExecMacro MacroName = "AddCircle" c = "0" />
        <ExecMacro MacroName = "AddCircle" c = "2" />
        <Turn NormVector = "1;-1;0" Angle = "Pi" />
        <ShowAll/>

        <Turn Axis = "0" Layer = "2" Angle = "Pi/2" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi/2" />
        <Turn Axis = "4" Layer = "2" Angle = "Pi/2" />
    </Figure>

    <Macros>
        <Macro Name = "CTurn" >
            <Turn Axis = "0" Layer = "2" Angle = "Pi/6 * n0 + 2 * Pi / 3 * Random(3)" />
            <Turn Axis = "1" Layer = "2" Angle = "Pi/6 * n1 + 2 * Pi / 3 * Random(3)" />
            <Turn Axis = "2" Layer = "2" Angle = "Pi/6 * n2 + 2 * Pi / 3 * Random(3)" />
            <Turn Axis = "3" Layer = "2" Angle = "Pi/6 * n3 + 2 * Pi / 3 * Random(3)" />
            <Turn Axis = "4" Layer = "2" Angle = "Pi/6 * n4 + 2 * Pi / 3 * Random(3)" />
            <Turn Axis = "5" Layer = "2" Angle = "Pi/6 * n5 + 2 * Pi / 3 * Random(3)" />
            <Turn Axis = "ax" Layer = "1" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "RandomTurn" >
            <ExecMacro MacroName = "CTurn" ax = "0" n0 = "0" n1 = "0" n2 = "3" n3 = "3" n4 = "2" n5 = "0" />
            <ExecMacro MacroName = "CTurn" ax = "1" n0 = "2" n1 = "2" n2 = "2" n3 = "2" n4 = "2" n5 = "2" />
            <ExecMacro MacroName = "CTurn" ax = "2" n0 = "0" n1 = "2" n2 = "0" n3 = "0" n4 = "3" n5 = "1" />
            <ExecMacro MacroName = "CTurn" ax = "3" n0 = "2" n1 = "2" n2 = "2" n3 = "2" n4 = "2" n5 = "2" />
            <ExecMacro MacroName = "CTurn" ax = "4" n0 = "3" n1 = "1" n2 = "3" n3 = "1" n4 = "0" n5 = "0" />
            <ExecMacro MacroName = "CTurn" ax = "5" n0 = "2" n1 = "2" n2 = "2" n3 = "2" n4 = "2" n5 = "2" />
            <ExecMacro MacroName = "CTurn" ax = "0" n0 = "3" n1 = "3" n2 = "0" n3 = "2" n4 = "1" n5 = "1" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "RandomTurn" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
