<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Sun Dial</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Master Sun Dial</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-04-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7379</Link>
    </Interface>

    <Script>
        W := 0.425;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        CylinderWidth := W * 0.2;
        CylinderWidth2 := W * 0.2;
        D := W;
        R := W * 0.87;
        R2 := W * 0.45;
        R3 := W * 0.28;

        C1 := 0.001;
        D1 := W + CylinderWidth;
        Sc1 := D1 / W;
        DC := (-R * C1 + D1) / sqrt(C1^2 + 1) * 0.99;
        DS := (-D1 + 2*R * C1) * 0.99*0.999;

        C2 := 0.002;
        D2 := D1 + CylinderWidth2;
        Sc2 := D2 / W;
        DC2 := (-R2 * C2 + D2) / sqrt(C2^2 + 1) * 0.99;
        DS2 := (-D2 + 2*R2 * C2) * 0.99*0.999;
        Sc3 := Sc2 * 1.001;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/6; Pi/6; Pi/2; Pi/2; Pi/6; Pi/6; Pi/2" PlaneDistances = "-D2;-D1;-D; 0; D; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "AddCircle" >
            <Cylinder Radius = "R" Color = "Colors[i]" >
                <Base X = "Cx[i]" Y = "Cy[i]" Z = "Cz[i]" />
                <Top  X = "Cx[i] * Sc1" Y = "Cy[i] * Sc1" Z = "Cz[i] * Sc1" Color = "Colors[i]" />
            </Cylinder>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" i = "0" Repeat = "6" />

        <Cut Color = "0000C9" > <Plane NormVector = "  0;  1;-C1" NormDistance = "-DC" /> </Cut>
        <Cut Color = "009601" > <Plane NormVector = "  0; -1; C1" NormDistance = "-DC" /> </Cut>
        <Cut Color = "C80001" > <Plane NormVector = "  1;-C1;  0" NormDistance = "-DC" /> </Cut>
        <Cut Color = "FF800B" > <Plane NormVector = " -1; C1;  0" NormDistance = "-DC" /> </Cut>
        <Cut Color = "FFFF01" > <Plane NormVector = "-C1;  0;  1" NormDistance = "-DC" /> </Cut>
        <Cut Color = "FFFFFE" > <Plane NormVector = " C1;  0; -1" NormDistance = "-DC" /> </Cut>

        <Split Color1 = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "DS" /> </Split>
        <Split Color1 = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "DS" /> </Split>
        <Split Color1 = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "DS" /> </Split>
        <Split Color1 = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "DS" /> </Split>
        <Split Color1 = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "DS" /> </Split>
        <Split Color1 = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "DS" /> </Split>

        <Macro Name = "AddCircle2" >
            <Cylinder Radius = "R2" Color = "Colors[i]" >
                <Base X = "Cx[i] * Sc1" Y = "Cy[i] * Sc1" Z = "Cz[i] * Sc1" />
                <Top  X = "Cx[i] * Sc2" Y = "Cy[i] * Sc2" Z = "Cz[i] * Sc2" Color = "Colors[i]" />
            </Cylinder>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle2" i = "0" Repeat = "6" />

        <Cut Color = "0000CA" > <Plane NormVector = "  0;  1;-C2" NormDistance = "-DC2" /> </Cut>
        <Cut Color = "009602" > <Plane NormVector = "  0; -1; C2" NormDistance = "-DC2" /> </Cut>
        <Cut Color = "C80002" > <Plane NormVector = "  1;-C2;  0" NormDistance = "-DC2" /> </Cut>
        <Cut Color = "FF800C" > <Plane NormVector = " -1; C2;  0" NormDistance = "-DC2" /> </Cut>
        <Cut Color = "FFFF02" > <Plane NormVector = "-C2;  0;  1" NormDistance = "-DC2" /> </Cut>
        <Cut Color = "FFFFFD" > <Plane NormVector = " C2;  0; -1" NormDistance = "-DC2" /> </Cut>

        <Split Color1 = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "DS2" /> </Split>
        <Split Color1 = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "DS2" /> </Split>
        <Split Color1 = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "DS2" /> </Split>
        <Split Color1 = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "DS2" /> </Split>
        <Split Color1 = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "DS2" /> </Split>
        <Split Color1 = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "DS2" /> </Split>

        <SplitByAxes/>
        <Turn Axis = "0" From = "1" To = "2" Angle = "Pi/6" />
        <Turn Axis = "0" From = "5" To = "6" Angle = "Pi/6" />
        <Turn Axis = "1" From = "1" To = "2" Angle = "Pi/6" />
        <Turn Axis = "1" From = "5" To = "6" Angle = "Pi/6" />
        <Turn Axis = "2" From = "1" To = "2" Angle = "Pi/6" />
        <Turn Axis = "2" From = "5" To = "6" Angle = "Pi/6" />
        <SplitByAxes/>
        <Turn Axis = "0" From = "1" To = "2" Angle = "Pi/6" />
        <Turn Axis = "0" From = "5" To = "6" Angle = "Pi/6" />
        <Turn Axis = "1" From = "1" To = "2" Angle = "Pi/6" />
        <Turn Axis = "1" From = "5" To = "6" Angle = "Pi/6" />
        <Turn Axis = "2" From = "1" To = "2" Angle = "Pi/6" />
        <Turn Axis = "2" From = "5" To = "6" Angle = "Pi/6" />
        <SplitByAxes/>
        <Undo Repeat = "12" />

        <Macro Name = "AddCircle3" >
            <Circle Radius = "R3" Color = "Colors[i]" Center = " Cx[i] * Sc3; Cy[i] * Sc3; Cz[i] * Sc3" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle3" i = "0" Repeat = "6" />
        <SplitByAxes/>
        <Connect Axis = "0" Layers = "0;3" />
        <Connect Axis = "0" Layers = "4;7" />
        <Connect Axis = "1" Layers = "0;3" />
        <Connect Axis = "1" Layers = "4;7" />
        <Connect Axis = "2" Layers = "0;3" />
        <Connect Axis = "2" Layers = "4;7" />
    </Figure>

