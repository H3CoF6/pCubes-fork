<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X Star Cube</Name>
        <Menu>Other forms\Wheel\X Star Cube</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>not invented</Inventor>
        <Added>2017-10-29</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=74728</Link>
    </Interface>

   <Script>
      clBlue   := '0000C8';
      clGreen  := '009600';
      clRed    := 'C80000';
      clOrange := 'FF800A';
      clYellow := 'FFFF00';
      clWhite  := 'FFFFFF';

      Width := 0.95;
      CylinderWidth := 0.1;
      R := Width / 7 / cos(3 * Pi / 8);
      D1 := Width / 6;
      D2 := Width / 2;
      D3 := D2 + CylinderWidth;
      D4 := D2 + 0.01;
   </Script>

    <Axes TurningAngles = "Pi/10; Pi/2; 0; Pi/2; Pi/10" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D2; -D2; -D4" />
                <Add Vector = "-D2; -D2;  D4" />
                <Add Vector = "-D2;  D2; -D4" />
                <Add Vector = "-D2;  D2;  D4" />
                <Add Vector = " D2; -D2; -D4" />
                <Add Vector = " D2; -D2;  D4" />
                <Add Vector = " D2;  D2; -D4" />
                <Add Vector = " D2;  D2;  D4" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "D2" Y = "0" Z = "0" />
            <Top  X = "D3" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "-D2" Y = "0" Z = "0" />
            <Top  X = "-D3" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "D2" Z = "0" />
            <Top  X = "0" Y = "D3" Z = "0" Color = "clGreen" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-D2" Z = "0" />
            <Top  X = "0" Y = "-D3" Z = "0" Color = "clBlue" />
        </Cylinder>

        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "0" Layer = "4" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "4" Angle = "2*Pi/5" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "0" Layer = "4" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "4" Angle = "2*Pi/5" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "0" Layer = "4" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "4" Angle = "2*Pi/5" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "2" />
        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "0" Layer = "4" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "0" Angle = "2*Pi/5" />
        <Turn  Axis = "1" Layer = "4" Angle = "2*Pi/5" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "2" />
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameDirection" />

    <Macros>
        <Macro Name = "TurnVertex" >
            <Turn Axis = "0" Layer = "0" Angle = " Pi/2 * i0 + Random(5) * 2 * Pi / 5" />
            <Turn Axis = "0" Layer = "4" Angle = "-Pi/2 * i1 + Random(5) * 2 * Pi / 5" />
            <Turn Axis = "1" Layer = "0" Angle = " Pi/2 * i2 + Random(5) * 2 * Pi / 5" />
            <Turn Axis = "1" Layer = "4" Angle = "-Pi/2 * i3 + Random(5) * 2 * Pi / 5" />
            <Turn Axis = "Ax" Layer = "L" Angle = "Pi/2 * k * Random(4/k)"/>
            <Turn Axis = "1" Layer = "4" Angle = " Pi/2 * i3"/>
            <Turn Axis = "1" Layer = "0" Angle = "-Pi/2 * i2"/>
            <Turn Axis = "0" Layer = "4" Angle = " Pi/2 * i1"/>
            <Turn Axis = "0" Layer = "0" Angle = "-Pi/2 * i0"/>
        </Macro>

        <Macro Name = "AllVertices" >
            <ExecMacro MacroName = "TurnVertex" Ax = "0" L = "1" i0 = "0" i1 = "0" i2 = "0" i3 = "0" k = "2" />
            <ExecMacro MacroName = "TurnVertex" Ax = "0" L = "3" i0 = "0" i1 = "0" i2 = "2" i3 = "2" k = "2" />
            <ExecMacro MacroName = "TurnVertex" Ax = "1" L = "1" i0 = "0" i1 = "0" i2 = "0" i3 = "0" k = "2" />
            <ExecMacro MacroName = "TurnVertex" Ax = "1" L = "3" i0 = "2" i1 = "2" i2 = "0" i3 = "0" k = "2" />
            <ExecMacro MacroName = "TurnVertex" Ax = "2" L = "0" i0 = "1" i1 = "3" i2 = "3" i3 = "1" k = "1" />
            <ExecMacro MacroName = "TurnVertex" Ax = "2" L = "2" i0 = "3" i1 = "1" i2 = "1" i3 = "3" k = "1" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "" >
            <ExecMacro MacroName = "AllVertices" Repeat = "20" />
        </Macro>
    </Macros>
</xml>
