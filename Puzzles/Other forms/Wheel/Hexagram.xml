<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagram</Name>
        <Menu>Other forms\Wheel\Hexagram</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6857</Link>
    </Interface>

    <Script>
        W := 0.5;
        R := W * 0.8;
        D := W * sqrt(3) / 3;
        D1 := W * 0.6;
        DC := D * 1.2;
        incline := arccos(sqrt(2/3));

        sAngle := Pi / 3;
        for i := 0 to 5 do begin
            y[i] := R * cos(sAngle * i);
            z[i] := R * sin(sAngle * i);
        end;

        Colors[0] := 'FF0000';
        Colors[1] := 'AF0000';
        Colors[2] := '7F0000';

        Colors[3] := '00FF00';
        Colors[4] := '00AF00';
        Colors[5] := '007F00';

        Colors[6] := '0000FF';
        Colors[7] := '0000AF';
        Colors[8] := '00007F';

        Colors[9] := 'FFFF00';
        Colors[10] := 'AFAF00';
        Colors[11] := '7F7F00';

        Colors[12] := '202020';
    </Script>


    <Axes TurningAngles = "Pi / 3; 0; 2*Pi/3" PlaneDistances = "-D; D1" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>

        <Macro Name = "sixp">

            <Turn NormVector = "0;0;1" Angle = "A2" />
            <Turn NormVector = "0;1;0" Angle = "A1" />

            <Part>
                <Vertices>
                    <Add Vector = " D ;  y[0]; z[0]" />
                    <Add Vector = " D ;  y[1]; z[1]" />
                    <Add Vector = " D ;  y[2]; z[2]" />
                    <Add Vector = " D ;  y[3]; z[3]" />
                    <Add Vector = " D ;  y[4]; z[4]" />
                    <Add Vector = " D ;  y[5]; z[5]" />
                    <Add Vector = " DC;  y[0]; z[0]" />
                    <Add Vector = " DC;  y[1]; z[1]" />
                    <Add Vector = " DC;  y[2]; z[2]" />
                    <Add Vector = " DC;  y[3]; z[3]" />
                    <Add Vector = " DC;  y[4]; z[4]" />
                    <Add Vector = " DC;  y[5]; z[5]" />
                </Vertices>
                <Faces>
                    <Face Color = "Color" VertexIndexes = " 6; 7; 8; 9;10;11" />
                    <Face Color = "Color" VertexIndexes = " 0; 1; 7; 6" />
                    <Face Color = "Color" VertexIndexes = " 1; 2; 8; 7" />
                    <Face Color = "Color" VertexIndexes = " 2; 3; 9; 8" />
                    <Face Color = "Color" VertexIndexes = " 3; 4;10; 9" />
                    <Face Color = "Color" VertexIndexes = " 4; 5;11;10" />
                    <Face Color = "Color" VertexIndexes = " 5; 0; 6;11" />
                    <Face Color = "IntColor" VertexIndexes = " 5; 4; 3; 2; 1; 0" />
                </Faces>
            </Part>

            <Turn NormVector = "0;1;0" Angle = "-A1" />
            <Turn NormVector = "0;0;1" Angle = "-A2" />
        </Macro>

        <Macro Name = "fig">
            <InvertVisibility/>
            <Part>
                <Vertices>
                    <Add Vector = " W; -W;  W" />
                    <Add Vector = "-W;  W;  W" />
                    <Add Vector = " W;  W; -W" />
                    <Add Vector = "-W; -W; -W" />
                </Vertices>

                <Faces>
                    <Face Color = "C1" VertexIndexes = "0;1;3" />
                    <Face Color = "C2" VertexIndexes = "1;2;3" />
                    <Face Color = "C3" VertexIndexes = "0;3;2" />
                    <Face Color = "C4" VertexIndexes = "0;2;1" />
                </Faces>
            </Part>

            <ExecMacro MacroName = "sixp" Color = "C3" IntColor = "Colors[6]" A2 = "   Pi/4" A1 = "-incline" />
            <ExecMacro MacroName = "sixp" Color = "C2" IntColor = "Colors[3]" A2 = "-3*Pi/4" A1 = "-incline" />
            <ExecMacro MacroName = "sixp" Color = "C4" IntColor = "Colors[9]" A2 = "  -Pi/4" A1 = " incline" />
            <ExecMacro MacroName = "sixp" Color = "C1" IntColor = "Colors[0]" A2 = " 3*Pi/4" A1 = " incline" />

            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "fig" C1 = "-1" C2 = "Colors[3]" C3 = "Colors[6]" C4 = "Colors[9]" />
        <Cut Axis = "0" From = "2" />
        <ShowAll/>

        <ExecMacro MacroName = "fig" C1 = "Colors[0]" C2 = "Colors[4]" C3 = "Colors[7]" C4 = "-1" />
        <Cut Axis = "1" From = "2" />
        <ShowAll/>

        <ExecMacro MacroName = "fig" C1 = "Colors[1]" C2 = "Colors[5]" C3 = "-1" C4 = "Colors[10]" />
        <Cut Axis = "2" From = "2" />
        <ShowAll/>

        <ExecMacro MacroName = "fig" C1 = "Colors[2]" C2 = "-1" C3 = "Colors[8]" C4 = "Colors[11]" />
        <Cut Axis = "3" From = "2" />
        <ShowAll/>

        <Script> Colors[0] := Colors[12]; Colors[3] := Colors[12]; Colors[6] := Colors[12]; Colors[9] := Colors[12]; </Script>

        <ExecMacro MacroName = "fig" C1 = "Colors[12]" C2 = "Colors[12]" C3 = "Colors[12]" C4 = "Colors[12]" />
        <Cut Axis = "0" To = "2" />
        <Cut Axis = "1" To = "2" />
        <Cut Axis = "2" To = "2" />
        <Cut Axis = "3" To = "2" />
        <ShowAll/>

        <Turn  Axis = "0" Layer = "0" Angle = "sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "sAngle" />
        <Turn  Axis = "2" Layer = "0" Angle = "sAngle" />
        <Turn  Axis = "3" Layer = "0" Angle = "sAngle" />
        <SplitByAxes/>
        <Undo  Repeat = "4" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
