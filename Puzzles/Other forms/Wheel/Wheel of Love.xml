<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Wheel Of Love</Name>
        <Menu>Other forms\Wheel\Wheel Cube\Wheel Of Love</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-10-29</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=74728</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Width := 0.85;
        CylinderWidth := Width / 6;
        D1 := Width / 6;
        D2 := Width / 2;
        D3 := D2 + CylinderWidth;
        R := D1 / cos(3 * Pi / 8);
        P := D1 / sqrt(2);
        Q := D1 * sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi/4; Pi/2; Pi/2; Pi/2; Pi/4" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D2; -D2; -D2" />
                <Add Vector = "-D2; -D2;  D2" />
                <Add Vector = "-D2;  D2; -D2" />
                <Add Vector = "-D2;  D2;  D2" />
                <Add Vector = " D2; -D2; -D2" />
                <Add Vector = " D2; -D2;  D2" />
                <Add Vector = " D2;  D2; -D2" />
                <Add Vector = " D2;  D2;  D2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "D2" Y = "0" Z = "0" />
            <Top  X = "D3" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "-D2" Y = "0" Z = "0" />
            <Top  X = "-D3" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "D2" Z = "0" />
            <Top  X = "0" Y = "D3" Z = "0" Color = "clGreen" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-D2" Z = "0" />
            <Top  X = "0" Y = "-D3" Z = "0" Color = "clBlue" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "D2" />
            <Top  X = "0" Y = "0" Z = "D3" Color = "clWhite" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-D2" />
            <Top  X = "0" Y = "0" Z = "-D3" Color = "clYellow" />
        </Cylinder>

        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "Pi/2" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi/2" Layer = "4" />
        <Turn Axis = "2" Angle = "Pi/2" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi/2" Layer = "4" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = "3*Pi/4" Layer = "0" />
        <Turn Axis = "1" Angle = "3*Pi/4" Layer = "4" />
        <Turn Axis = "2" Angle = "3*Pi/4" Layer = "0" />
        <Turn Axis = "2" Angle = "3*Pi/4" Layer = "4" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Angle = " Pi/4" Layer = "0" />
        <Turn Axis = "1" Angle = "-Pi/4" Layer = "4" />
        <Turn Axis = "2" Angle = "-Pi/4" Layer = "0" />
        <Turn Axis = "2" Angle = " Pi/4" Layer = "4" />
        <Split Axis = "0" From = "3" />
        <Undo Repeat = "12"/>
        <Turn Axis = "1" Angle = "3*Pi/4" Layer = "0" />
        <Turn Axis = "1" Angle = "3*Pi/4" Layer = "4" />
        <Turn Axis = "2" Angle = "3*Pi/4" Layer = "0" />
        <Turn Axis = "2" Angle = "3*Pi/4" Layer = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "1" From = "3" />
        <Turn Axis = "0" Angle = "3*Pi/4" Layer = "0" />
        <Turn Axis = "0" Angle = "3*Pi/4" Layer = "4" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "0" Angle = "Pi" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi" Layer = "4" />
        <Turn Axis = "1" Angle = "Pi" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi" Layer = "4" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "0" Angle = "Pi/2" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi/2" Layer = "4" />
        <Turn Axis = "2" Angle = "Pi" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi" Layer = "4" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Angle = " Pi/4" Layer = "0" />
        <Turn Axis = "0" Angle = "-Pi/4" Layer = "4" />
        <Turn Axis = "1" Angle = "-Pi/4" Layer = "0" />
        <Turn Axis = "1" Angle = " Pi/4" Layer = "4" />
        <Turn Axis = "2" Angle = " Pi/4" Layer = "0" />
        <Turn Axis = "2" Angle = "-Pi/4" Layer = "4" />
        <HideContaining Vector = " -P; -P; D2" />
        <HideContaining Vector = "  P; -P;-D2" />
        <HideContaining Vector = "  P; D2;  P" />
        <HideContaining Vector = " -P;-D2;  P" />
        <HideContaining Vector = " D2; -P;  P" />
        <HideContaining Vector = "-D2; -P; -P" />
        <SplitByAxes/>
        <ShowAll/>
        <Turn Axis = "1" Angle = "  -Pi/4" Layer = "0" />
        <Turn Axis = "2" Angle = "  -Pi/4" Layer = "4" />
        <Turn Axis = "1" Angle = "-3*Pi/4" Layer = "4" />
        <Turn Axis = "2" Angle = "-3*Pi/4" Layer = "0" />
        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "0" Layer = "3" />
        <Hide Axis = "0" Layer = "4" />
        <HideContaining Vector = "Q;-D2;  0" />
        <HideContaining Vector = "Q; D2;  0" />
        <HideContaining Vector = "Q;  0;-D2" />
        <HideContaining Vector = "Q;  0; D2" />
        <SplitByAxes/>
        <ShowAll/>
        <Turn Axis = "0" Angle = "-3*Pi/4" Layer = "0" />
        <Turn Axis = "0" Angle = "  -Pi/4" Layer = "4" />
        <Hide Axis = "2" Layer = "0" />
        <Hide Axis = "2" Layer = "1" />
        <Hide Axis = "2" Layer = "2" />
        <Hide Axis = "2" Layer = "4" />
        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "4" />
        <Turn Axis = "2" Angle = "Pi/2" Layer = "1" />
        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "4" />
        <SplitByAxes/>
        <Undo Repeat = "3"/>
        <ShowAll/>
        <Undo Repeat = "24"/>
    </Figure>
</xml>
