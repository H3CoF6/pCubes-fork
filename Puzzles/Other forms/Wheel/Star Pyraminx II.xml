<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Pyraminx II</Name>
        <Menu>Other forms\Wheel\Star Pyraminx II</Menu>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Added>2017-12-16</Added>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clYellow := 'FFFF00';

        D := sqrt(3) / 6;

        R := 0.37;

        N := 1 / 6;
        M := N + 0.05;
    </Script>

    <Axes TurningAngles = "2*Pi/15" PlaneDistances = "-D" FixedLayers = "1">
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1;  0;  0" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 0;  0;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0.5; -0.5;  0.5" />
                <Add Vector = "-0.5;  0.5;  0.5" />
                <Add Vector = " 0.5;  0.5; -0.5" />
                <Add Vector = "-0.5; -0.5; -0.5" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "0;1;3" />
                <Face Color = "clGreen"  VertexIndexes = "1;2;3" />
                <Face Color = "clRed"    VertexIndexes = "0;3;2" />
                <Face Color = "clYellow" VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "N" Y = "N" Z = "N" />
            <Top  X = "M" Y = "M" Z = "M" Color = "clYellow" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "-N" Y = "-N" Z = "N" />
            <Top  X = "-M" Y = "-M" Z = "M" Color = "clBlue" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "N" Y = "-N" Z = "-N" />
            <Top  X = "M" Y = "-M" Z = "-M" Color = "clRed" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "-N" Y = "N" Z = "-N" />
            <Top  X = "-M" Y = "M" Z = "-M" Color = "clGreen" />
        </Cylinder>

        <Macro Name = "SplitPart">
            <Split  Axis = "4" From = "1" />
            <Turn Axis = "0" Angle = "2*Pi/5" Layer = "0" />
            <Turn Axis = "1" Angle = "2*Pi/5" Layer = "0" />
            <Turn Axis = "2" Angle = "2*Pi/5" Layer = "0" />
            <Turn Axis = "3" Angle = "2*Pi/5" Layer = "0" />
        </Macro>
        <ExecMacro MacroName = "SplitPart" Repeat = "5" />

    </Figure>
</xml>
