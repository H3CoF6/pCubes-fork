<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>'Stickerless' Super I-Cube</Name>
        <Menu>Other forms\Wheel\Super cube\'Stickerless' Super I-Cube</Menu>
        <Inventor>Evgeniy Grigoriev + Aleh Hladzilin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-10</Added>
        <Link>http://www.hknowstore.com/locale/en-US/item.aspx?corpname=nowstore&amp;itemid=055ad4da-f735-4036-bc4e-d7a98c926d44</Link> Calvin's 3x3x5 Super Cuboid Stickerless Full Set
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        Width := 0.85;
        CylinderWidth := Width / 6;
        BlockWidth := Width / 3;
        R := Width * 0.4;
        W2 := Width / 2;
        Wc := W2 + CylinderWidth;
        Wd := W2 + BlockWidth;

        L := 13 / 12;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/2 * Width; -1/6 * Width; 1/6 * Width; 1/2 * Width" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
           <Part>
               <Vertices>
                   <Add Vector = "-W2; -W2; -W2" />
                   <Add Vector = "-W2; -W2;  W2" />
                   <Add Vector = "-W2;  W2; -W2" />
                   <Add Vector = "-W2;  W2;  W2" />
                   <Add Vector = " W2; -W2; -W2" />
                   <Add Vector = " W2; -W2;  W2" />
                   <Add Vector = " W2;  W2; -W2" />
                   <Add Vector = " W2;  W2;  W2" />
               </Vertices>

               <Faces>
                   <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                   <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                   <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                   <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                   <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                   <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
               </Faces>
           </Part>

           <Part>
               <Vertices>
                   <Add Vector = " W2; -W2; -W2" />
                   <Add Vector = " W2; -W2;  W2" />
                   <Add Vector = " W2;  W2; -W2" />
                   <Add Vector = " W2;  W2;  W2" />
                   <Add Vector = " Wd; -W2; -W2" />
                   <Add Vector = " Wd; -W2;  W2" />
                   <Add Vector = " Wd;  W2; -W2" />
                   <Add Vector = " Wd;  W2;  W2" />
               </Vertices>

               <Faces>
                   <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                   <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                   <Face                    VertexIndexes = "0;1;3;2" />
                   <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                   <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                   <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
               </Faces>
           </Part>

           <Cylinder Radius = "R" Color = "clRed" >
               <Base X = "-W2" Y = "0" Z = "0" />
               <Top X = "-Wc" Y = "0" Z = "0" Color = "clRed" />
           </Cylinder>

           <Cylinder Radius = "R" Color = "clGreen" >
               <Base X = "0" Y = "W2" Z = "0" />
               <Top X = "0" Y = "Wc" Z = "0" Color = "clGreen" />
           </Cylinder>

           <Cylinder Radius = "R" Color = "clBlue" >
               <Base X = "0" Y = "-W2" Z = "0" />
               <Top X = "0" Y = "-Wc" Z = "0" Color = "clBlue" />
           </Cylinder>

           <Cylinder Radius = "R" Color = "clWhite" >
               <Base X = "0" Y = "0" Z = "W2" />
               <Top X = "0" Y = "0" Z = "Wc" Color = "clWhite" />
           </Cylinder>

           <Cylinder Radius = "R" Color = "clYellow" >
               <Base X = "0" Y = "0" Z = "-W2" />
               <Top X = "0" Y = "0" Z = "-Wc" Color = "clYellow" />
           </Cylinder>

        <SplitByAxes/>
   </Figure>

   <Procedures CheckSolved = "EachColorHasSameDirection" />
</xml>
