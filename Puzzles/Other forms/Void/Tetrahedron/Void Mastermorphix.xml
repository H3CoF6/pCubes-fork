<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Mastermorphix</Name>
        <Menu>Other forms\Void\Tetrahedron\Void Mastermorphix</Menu>
        <Inventor>Jay Hensley</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1808</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 0.2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
        <RemoveContaining Vector = " D; 0; 0" />
        <RemoveContaining Vector = "-D; 0; 0" />
        <RemoveContaining Vector = " 0; D; 0" />
        <RemoveContaining Vector = " 0;-D; 0" />
        <RemoveContaining Vector = " 0; 0; D" />
        <RemoveContaining Vector = " 0; 0;-D" />
    </Figure>
</xml>
