<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Star Wheel Dodecahedron</Name>
        <Menu>Other forms\Void\Dodecahedron\Void Star Wheel Dodecahedron</Menu>
        <Inventor>Linxiao Xu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-02</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=401064</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := '0000CC'; // clBlue
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '00AA00'; // clGreen
        Colors[ 5] := '800080'; // clViolett
        Colors[ 6] := 'FFFFAA'; // clCream
        Colors[ 7] := '0066CC'; // clLightBlue
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := '00FF00'; // clLightGreen
        Colors[10] := 'FF88CC'; // clLightViolett
        Colors[11] := '666666'; // clGray

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * 0.90;
        RC := R * 0.4565;
        Sc := 1.07;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D" NormVectors = "Vx; Vy; Vz" />
    <Axes TurningAngles = "0; sAngle/2" PlaneDistances = "RSin" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <Macro Name = "Dodecahedron" >
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />

                <Faces>
                    <Face Color = "Colors[ 0]" VertexIndexes = "4;3;2;1;0" />
                    <Face Color = "Colors[ 1]" VertexIndexes = "0;1;6;10;5" />
                    <Face Color = "Colors[ 2]" VertexIndexes = "1;2;7;11;6" />
                    <Face Color = "Colors[ 3]" VertexIndexes = "2;3;8;12;7" />
                    <Face Color = "Colors[ 4]" VertexIndexes = "3;4;9;13;8" />
                    <Face Color = "Colors[ 5]" VertexIndexes = "4;0;5;14;9" />
                    <Face Color = "Colors[ 6]" VertexIndexes = "18;17;12;8;13" />
                    <Face Color = "Colors[ 7]" VertexIndexes = "19;18;13;9;14" />
                    <Face Color = "Colors[ 8]" VertexIndexes = "15;19;14;5;10" />
                    <Face Color = "Colors[ 9]" VertexIndexes = "16;15;10;6;11" />
                    <Face Color = "Colors[10]" VertexIndexes = "17;16;11;7;12" />
                    <Face Color = "Colors[11]" VertexIndexes = "15;16;17;18;19" />
                </Faces>
            </Part>
        </Macro>
        <ExecMacro MacroName = "Dodecahedron" />

        <SplitByAxes/>
<!--        <RemoveContaining1 Vector = "0;0;0" />-->

        <Macro Name = "AddCircle" >
            <Cylinder Radius = "RC" Color = "Colors[i]" Base = "Cx[i]; Cy[i]; Cz[i]" Top = "Cx[i] * Sc; Cy[i] * Sc; Cz[i] * Sc" >
                <Top Color = "Colors[i]" />
            </Cylinder>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" Repeat = "12" i = "0" />

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "ax" Layer = "1" Angle = "sAngle/2" />
            <Script> Inc(ax); </Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "12" ax = "20" />
        <SplitByAxes/>
        <Undo Repeat = "12"/>

        <Macro Name = "Remove">
            <HideContaining Vector = "Cx[id]; Cy[id]; Cz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Remove" Repeat = "12" id = "0" />
   </Figure>
</xml>
