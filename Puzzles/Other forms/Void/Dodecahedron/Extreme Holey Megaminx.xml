<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Extreme Holey Megaminx</Name>
        <Menu>Other forms\Void\Dodecahedron\Extreme Holey Megaminx</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3573</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
    </Script>               

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Turn Angle = " sAngle" Axis = "0" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "0" Layer = "2" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "1" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "1" Layer = "2" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "2" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "2" Layer = "2" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "0" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "0" Layer = "2" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "1" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "1" Layer = "2" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "2" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "2" Layer = "2" />
        <SplitByAxes/>
        <Undo Repeat = "12" />

        <RemoveContaining Vector = " Cx[ 0]; Cy[ 0]; Cz[ 0]" />
        <RemoveContaining Vector = " Cx[ 3]; Cy[ 3]; Cz[ 3]" />
        <RemoveContaining Vector = " Cx[ 5]; Cy[ 5]; Cz[ 5]" />
        <RemoveContaining Vector = " Cx[ 8]; Cy[ 8]; Cz[ 8]" />
        <RemoveContaining Vector = " Cx[10]; Cy[10]; Cz[10]" />
        <RemoveContaining Vector = " Cx[11]; Cy[11]; Cz[11]" />
   </Figure>
</xml>
