<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Siamese Void Pentagons</Name>
        <Menu>Other forms\Void\Dodecahedron\Siamese Void Pentagons</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3581</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "8" />

        <RemoveContaining Vector =  " Cx[0]; Cy[0]; Cz[0]" />
        <RemoveContaining Vector =  " Cx[3]; Cy[3]; Cz[3]" />

   </Figure>
</xml>
