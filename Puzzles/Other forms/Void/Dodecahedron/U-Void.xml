<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>U-Void</Name>
        <Menu>Other forms\Void\Dodecahedron\U-Void</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3586</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
    </Axes>
    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" >
        <Axis NormVector = "Cx[ 3]; Cy[ 3]; Cz[ 3]" />
        <Axis NormVector = "Cx[10]; Cy[10]; Cz[10]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Turn Angle = "-sAngle" Axis = "0" Layer = "2" />
        <Turn Angle = " sAngle" Axis = "2" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "0" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "2" />
        <Turn Angle = " sAngle" Axis = "2" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "0" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "2" />
        <Turn Angle = " sAngle" Axis = "2" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "0" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-sAngle" Axis = "0" Layer = "2" />
        <Turn Angle = " sAngle" Axis = "2" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = " sAngle" Axis = "0" Layer = "0" />
        <Turn Angle = " sAngle" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "16" />

        <RemoveContaining Vector =  " Cx[ 0]; Cy[ 0]; Cz[ 0]" />
        <RemoveContaining Vector =  " Cx[ 3]; Cy[ 3]; Cz[ 3]" />
        <RemoveContaining Vector =  " Cx[10]; Cy[10]; Cz[10]" />
        <RemoveContaining Vector =  " Cx[11]; Cy[11]; Cz[11]" />

   </Figure>
</xml>
