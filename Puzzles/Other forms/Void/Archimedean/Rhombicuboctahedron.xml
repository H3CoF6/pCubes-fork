<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Rhombicuboctahedron</Name>
        <Menu>Other forms\Void\Archimedean\Rhombicuboctahedron</Menu>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-10-24</Added>
    </Interface>

    <Script>
        W := 0.45;

        C0 := W * (1 + sqrt(2)) / 2;
        C1 := W * 0.5;

        D1 := W * 1.08;
        D2 := (D1 + 2 * C1) / sqrt(3);
        D3 := (D1 +  C1) / sqrt(2);


//        D2 := W * 1.2;
//        D3 := W * 1.116;

        R1 := W * 1.2;
        R2 := W * 0.84;
        R3 := W * 0.72;

    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
    
    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>
    
    <Axes TurningAngles = "Pi" PlaneDistances = "-D3; D3" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 0;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;  C1;  C0" />
                <Add Vector = " C1;  C1; -C0" />
                <Add Vector = " C1; -C1;  C0" />
                <Add Vector = " C1; -C1; -C0" />
                <Add Vector = "-C1;  C1;  C0" />
                <Add Vector = "-C1;  C1; -C0" />
                <Add Vector = "-C1; -C1;  C0" />
                <Add Vector = "-C1; -C1; -C0" />
                <Add Vector = " C0;  C1;  C1" />
                <Add Vector = " C0;  C1; -C1" />
                <Add Vector = " C0; -C1;  C1" />
                <Add Vector = " C0; -C1; -C1" />
                <Add Vector = "-C0;  C1;  C1" />
                <Add Vector = "-C0;  C1; -C1" />
                <Add Vector = "-C0; -C1;  C1" />
                <Add Vector = "-C0; -C1; -C1" />
                <Add Vector = " C1;  C0;  C1" />
                <Add Vector = " C1;  C0; -C1" />
                <Add Vector = " C1; -C0;  C1" />
                <Add Vector = " C1; -C0; -C1" />
                <Add Vector = "-C1;  C0;  C1" />
                <Add Vector = "-C1;  C0; -C1" />
                <Add Vector = "-C1; -C0;  C1" />
                <Add Vector = "-C1; -C0; -C1" />
            </Vertices>

            <Faces>
                <Face Color = "FFFFFF" VertexIndexes = "  0;  4;  6;  2 " />
                <Face Color = "FFFF00" VertexIndexes = "  1;  3;  7;  5 " />
                <Face Color = "0000C8" VertexIndexes = "  8; 10; 11;  9 " />
                <Face Color = "009600" VertexIndexes = " 12; 13; 15; 14 " />
                <Face Color = "FF800A" VertexIndexes = " 16; 17; 21; 20 " />
                <Face Color = "FF0000" VertexIndexes = " 18; 22; 23; 19 " />
                <Face Color = "00ffff" VertexIndexes = "  0;  2; 10;  8 " />
                <Face Color = "ffbf80" VertexIndexes = "  0; 16; 20;  4 " />
                <Face Color = "7e0000" VertexIndexes = "  7;  3; 19; 23 " />
                <Face Color = "003f00" VertexIndexes = "  7; 15; 13;  5 " />
                <Face Color = "00007e" VertexIndexes = " 11;  3;  1;  9 " />
                <Face Color = "ff007e" VertexIndexes = " 11; 10; 18; 19 " />
                <Face Color = "00ff00" VertexIndexes = " 12; 14;  6;  4 " />
                <Face Color = "aaaa55" VertexIndexes = " 12; 20; 21; 13 " />
                <Face Color = "804000" VertexIndexes = " 17;  1;  5; 21 " />
                <Face Color = "ff7e3f" VertexIndexes = " 17; 16;  8;  9 " />
                <Face Color = "7e7e00" VertexIndexes = " 22; 14; 15; 23 " />
                <Face Color = "ff7e7e" VertexIndexes = " 22; 18;  2;  6 " />
                <Face Color = "ff7eff" VertexIndexes = "  0;  8; 16 " />
                <Face Color = "ff3f3f" VertexIndexes = "  1; 17;  9 " />
                <Face Color = "ff00ff" VertexIndexes = "  2; 18; 10 " />
                <Face Color = "7e007e" VertexIndexes = "  3; 11; 19 " />
                <Face Color = "c3c388" VertexIndexes = "  4; 20; 12 " />
                <Face Color = "77773c" VertexIndexes = "  5; 13; 21 " />
                <Face Color = "bd7e00" VertexIndexes = "  6; 14; 22 " />
                <Face Color = "7e3f00" VertexIndexes = "  7; 23; 15 " />

            </Faces>
        </Part>

        <SplitByAxes/>

        <RemoveContaining Vector = "   0;   0;   0" />

        <RemoveContaining Vector = "   0;   0;  R1" />
        <RemoveContaining Vector = "   0;   0; -R1" />
        <RemoveContaining Vector = "   0;  R1;   0" />
        <RemoveContaining Vector = "   0; -R1;   0" />
        <RemoveContaining Vector = "  R1;   0;   0" />
        <RemoveContaining Vector = " -R1;   0;   0" />

        <RemoveContaining Vector = "   0;  R2;  R2" />
        <RemoveContaining Vector = "  R2;   0;  R2" />
        <RemoveContaining Vector = "   0; -R2;  R2" />
        <RemoveContaining Vector = " -R2;   0;  R2" />
        <RemoveContaining Vector = " -R2;  R2;   0" />
        <RemoveContaining Vector = "  R2;  R2;   0" />
        <RemoveContaining Vector = "   0; -R2; -R2" />
        <RemoveContaining Vector = " -R2;   0; -R2" />
        <RemoveContaining Vector = "   0;  R2; -R2" />
        <RemoveContaining Vector = "  R2;   0; -R2" />
        <RemoveContaining Vector = "  R2; -R2;   0" />
        <RemoveContaining Vector = " -R2; -R2;   0" />
                                         
        <RemoveContaining Vector = "  R3;  R3;  R3" />
        <RemoveContaining Vector = " -R3;  R3;  R3" />
        <RemoveContaining Vector = " -R3; -R3;  R3" />
        <RemoveContaining Vector = "  R3; -R3;  R3" />
        <RemoveContaining Vector = " -R3; -R3; -R3" />
        <RemoveContaining Vector = "  R3; -R3; -R3" />
        <RemoveContaining Vector = "  R3;  R3; -R3" />
        <RemoveContaining Vector = " -R3;  R3; -R3" />

    </Figure>
</xml>
