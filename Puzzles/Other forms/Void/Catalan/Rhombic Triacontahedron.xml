<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Rhombic Triacontahedron</Name>
        <Menu>Other forms\Void\Catalan\Rhombic Triacontahedron</Menu>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-10-24</Added>
    </Interface>

    <Script>
        Scale := 0.4;

        B0 := (1 + sqrt(5)) / 4 * Scale;
        B1 := (3 + sqrt(5)) / 4 * Scale;
        B2 := (1 + sqrt(5)) / 2 * Scale;
        B3 := 0.5 * Scale;

        D := 1.34 * Scale;

        S := 0.9;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "  0;  0; B2" />
        <Axis NormVector = " B2;  0;  0" />
        <Axis NormVector = "  0; B2;  0" />
        <Axis NormVector = " B3; B0; B1" />
        <Axis NormVector = " B3; B0;-B1" />
        <Axis NormVector = " B3;-B0; B1" />
        <Axis NormVector = " B3;-B0;-B1" />
        <Axis NormVector = " B1; B3; B0" />
        <Axis NormVector = " B1; B3;-B0" />
        <Axis NormVector = " B1;-B3; B0" />
        <Axis NormVector = " B1;-B3;-B0" />
        <Axis NormVector = " B0; B1; B3" />
        <Axis NormVector = " B0; B1;-B3" />
        <Axis NormVector = " B0;-B1; B3" />
        <Axis NormVector = " B0;-B1;-B3" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Triacontahedron.xml" />

        <SplitByAxes/>
        <RemoveContaining Vector = "    0;    0;    0" />
        <RemoveContaining Vector = "  0*S;  0*S; B2*S" />
        <RemoveContaining Vector = "  0*S;  0*S;-B2*S" />
        <RemoveContaining Vector = " B2*S;  0*S;  0*S" />
        <RemoveContaining Vector = "-B2*S;  0*S;  0*S" />
        <RemoveContaining Vector = "  0*S; B2*S;  0*S" />
        <RemoveContaining Vector = "  0*S;-B2*S;  0*S" />
        <RemoveContaining Vector = " B3*S; B0*S; B1*S" />
        <RemoveContaining Vector = " B3*S; B0*S;-B1*S" />
        <RemoveContaining Vector = " B3*S;-B0*S; B1*S" />
        <RemoveContaining Vector = " B3*S;-B0*S;-B1*S" />
        <RemoveContaining Vector = "-B3*S; B0*S; B1*S" />
        <RemoveContaining Vector = "-B3*S; B0*S;-B1*S" />
        <RemoveContaining Vector = "-B3*S;-B0*S; B1*S" />
        <RemoveContaining Vector = "-B3*S;-B0*S;-B1*S" />
        <RemoveContaining Vector = " B1*S; B3*S; B0*S" />
        <RemoveContaining Vector = " B1*S; B3*S;-B0*S" />
        <RemoveContaining Vector = " B1*S;-B3*S; B0*S" />
        <RemoveContaining Vector = " B1*S;-B3*S;-B0*S" />
        <RemoveContaining Vector = "-B1*S; B3*S; B0*S" />
        <RemoveContaining Vector = "-B1*S; B3*S;-B0*S" />
        <RemoveContaining Vector = "-B1*S;-B3*S; B0*S" />
        <RemoveContaining Vector = "-B1*S;-B3*S;-B0*S" />
        <RemoveContaining Vector = " B0*S; B1*S; B3*S" />
        <RemoveContaining Vector = " B0*S; B1*S;-B3*S" />
        <RemoveContaining Vector = " B0*S;-B1*S; B3*S" />
        <RemoveContaining Vector = " B0*S;-B1*S;-B3*S" />
        <RemoveContaining Vector = "-B0*S; B1*S; B3*S" />
        <RemoveContaining Vector = "-B0*S; B1*S;-B3*S" />
        <RemoveContaining Vector = "-B0*S;-B1*S; B3*S" />
        <RemoveContaining Vector = "-B0*S;-B1*S;-B3*S" />
    </Figure>
</xml>
