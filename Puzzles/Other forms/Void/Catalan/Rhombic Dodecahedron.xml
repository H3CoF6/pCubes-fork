<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Rhombic Dodecahedron</Name>
        <Menu>Other forms\Void\Catalan\Rhombic Dodecahedron</Menu>
        <Programmer>Knightcrawler</Programmer>
        <Added>2016-10-24</Added>
    </Interface>

    <Script>
        D := 0.4;
        DR := 0.35;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
    </Axes>

   <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        <SplitByAxes/>

        <RemoveContaining Vector = "   0;   0;   0" />
        <RemoveContaining Vector = "   0;  DR;  DR" />
        <RemoveContaining Vector = "  DR;   0;  DR" />
        <RemoveContaining Vector = "   0; -DR;  DR" />
        <RemoveContaining Vector = " -DR;   0;  DR" />
        <RemoveContaining Vector = " -DR;  DR;   0" />
        <RemoveContaining Vector = "  DR;  DR;   0" />
        <RemoveContaining Vector = "   0; -DR; -DR" />
        <RemoveContaining Vector = " -DR;   0; -DR" />
        <RemoveContaining Vector = "   0;  DR; -DR" />
        <RemoveContaining Vector = "  DR;   0; -DR" />
        <RemoveContaining Vector = "  DR; -DR;   0" />
        <RemoveContaining Vector = " -DR; -DR;   0" />
   </Figure>
</xml>
