<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Void Windmill Cube</Name>
        <Menu>Other forms\Void\Void Windmill Cube</Menu>
        <Inventor>Jay Hensley Okamoto</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7923</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1 + sqrt(17); 1 - sqrt(17); 0" />
        <Axis NormVector = "sqrt(17) - 1; 1 + sqrt(17); 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = " 0; 0; 0" />

        <RemoveContaining Vector = " W/2;   0;  0" />
        <RemoveContaining Vector = "-W/2;   0;  0" />
        <RemoveContaining Vector = "   0; W/2;  0" />
        <RemoveContaining Vector = "   0;-W/2;  0" />
        <RemoveContaining Vector = "   0;   0;  W" />
        <RemoveContaining Vector = "   0;   0; -W" />
    </Figure>
</xml>
