<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Solar Eclipse</Name>
        <Menu>Other forms\Dipyramid\Triangular\Solar Eclipse</Menu>
        <Inventor>Sukjae Lee</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-10-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12070</Link>
        <Link>https://www.twistypuzzles.com/forum/viewtopic.php?p=430632</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clViolett := '800080';

        R := 0.9;
        H := R / sqrt(3);

        for i := 0 to 2 do begin
            x[i] := R * sin(2 * Pi / 3 * i);
            y[i] := R * cos(2 * Pi / 3 * i);
        end;

        D1 := R / 7;
        D2 := R * 0.12;
    </Script>

    <Axes TurningAngles = "   Pi / 2" PlaneDistances = " D1    " FixedLayers = "0" NormVectors = " x; y; 0" />
    <Axes TurningAngles = " 2*Pi / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" NormVectors = " 0; 0; 1" />

    <Figure>
        <Part>
            <Vertices Vectors = " x; y; 0" />
            <Vertices Vectors = " 0; 0; H" />
            <Vertices Vectors = " 0; 0;-H" />

            <Faces>
                <Face Color = "clOrange " VertexIndexes = "0;3;1" />
                <Face Color = "clYellow " VertexIndexes = "1;3;2" />
                <Face Color = "clRed    " VertexIndexes = "2;3;0" />

                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen  " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue   " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "0" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Undo/>

        <Turn Axis = "1" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Undo/>

        <Turn Axis = "2" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Undo/>
    </Figure>
</xml>
