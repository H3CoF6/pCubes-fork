<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Constellation Six</Name>
        <Menu>Other forms\Dipyramid\Triangular\Constellation Six</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1789</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clViolett := '800080';

        R := 0.8;
        H  := R / sqrt(3);
        TC := -2 / 7;
        RC := R * 0.154;

        for i := 0 to 2 do begin
            x[i] := R * sin(i * 2 * Pi / 3);
            y[i] := R * cos(i * 2 * Pi / 3);
        end;
        az := R * sqrt(3)/2;
    </Script>

    <Axes TurningAngles = "0; Pi/2"  PlaneDistances = "0" >
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " x[0]; y[0]; 0" />
                <Add Vector = " x[1]; y[1]; 0" />
                <Add Vector = " x[2]; y[2]; 0" />

                <Add Vector = " 0; 0;  H" />
                <Add Vector = " 0; 0; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow " VertexIndexes = "2;1;3" />
                <Face Color = "clRed    " VertexIndexes = "0;2;3" />
                <Face Color = "clOrange " VertexIndexes = "1;0;3" />

                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen  " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue   " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <Macro Name = "Split21" >
            <Split Axis = "0" From  = "1" />
            <Turn  Axis = "0" Layer = "1" Angle = "Pi/2" />
            <Split Axis = "1" From  = "1" />
            <Turn  Axis = "1" Layer = "1" Angle = "Pi/2" />
            <Split Axis = "2" From  = "1" />
            <Turn  Axis = "2" Layer = "1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "Split21" Repeat = "6" />
        <Undo Repeat = "18" />

        <HideContaining Vector = "  0;   0;  H" />
        <HideContaining Vector = "  0;   0; -H" />

        <Macro Name = "Hide0" >
            <HideContaining Vector = "x[Ax1]+k*(x[Ax2]-x[Ax1]); y[Ax1]+k*(y[Ax2]-y[Ax1]); 0" />
            <HideContaining Vector = "x[Ax2]+k*(x[Ax1]-x[Ax2]); y[Ax2]+k*(y[Ax1]-y[Ax2]); 0" />
        </Macro>
        <ExecMacro MacroName = "Hide0" Ax1 = "0" Ax2 = "1" k = "1/3" />
        <ExecMacro MacroName = "Hide0" Ax1 = "1" Ax2 = "2" />
        <ExecMacro MacroName = "Hide0" Ax1 = "2" Ax2 = "0" />

        <Macro Name = "Hide1" >
            <HideContaining Vector = "x[Ax]-k*x[Ax]; y[Ax]-k*y[Ax];  k*H" />
            <HideContaining Vector = "x[Ax]-k*x[Ax]; y[Ax]-k*y[Ax]; -k*H" />
        </Macro>
        <ExecMacro MacroName = "Hide1" Ax = "0" k = "1/2" />
        <ExecMacro MacroName = "Hide1" Ax = "1" />
        <ExecMacro MacroName = "Hide1" Ax = "2" />

        <RemoveAllVisible/>
        <ShowAll/>

        <Circle Radius = "RC" Color = "clYellow " Center = "TC * x[0]; TC * y[0]; -TC * az" />
        <Circle Radius = "RC" Color = "clRed    " Center = "TC * x[1]; TC * y[1]; -TC * az" />
        <Circle Radius = "RC" Color = "clOrange " Center = "TC * x[2]; TC * y[2]; -TC * az" />
        <Circle Radius = "RC" Color = "clGreen  " Center = "TC * x[0]; TC * y[0];  TC * az" />
        <Circle Radius = "RC" Color = "clBlue   " Center = "TC * x[1]; TC * y[1];  TC * az" />
        <Circle Radius = "RC" Color = "clViolett" Center = "TC * x[2]; TC * y[2];  TC * az" />
    </Figure>
</xml>
