<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Insanity Plus</Name>
        <Menu>Other forms\Dipyramid\Triangular\Insanity Plus</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5208</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clViolett := '800080';

        R := 0.9;
        H := R / sqrt(3);

        for i := 0 to 2 do begin
            x[i] := R * sin(2 * Pi / 3 * i);
            y[i] := R * cos(2 * Pi / 3 * i);
            nx[i] := -sin(2 * Pi / 3 * i);
            ny[i] := -cos(2 * Pi / 3 * i);
        end;
        nz := sqrt(3)/2;

        A1 := ArcCos(1/8);
        A2 := ArcCos(-3/4);

        D1 := -R / 2 / sqrt(7);
        D2 := R / 4;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2;0;A2;A1" PlaneDistances = "D1" FixedLayers = "1">
        <Axis NormVector = " nx[0]; ny[0];  nz" />
        <Axis NormVector = " nx[1]; ny[1];  nz" />
        <Axis NormVector = " nx[2]; ny[2];  nz" />
        <Axis NormVector = " nx[0]; ny[0]; -nz" />
        <Axis NormVector = " nx[1]; ny[1]; -nz" />
        <Axis NormVector = " nx[2]; ny[2]; -nz" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "D2" FixedLayers = "0">
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  0" />
                <Add Vector = "x[1]; y[1];  0" />
                <Add Vector = "x[2]; y[2];  0" />
                <Add Vector = "   0;    0;  H" />
                <Add Vector = "   0;    0; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange " VertexIndexes = "0;3;1" />
                <Face Color = "clYellow " VertexIndexes = "1;3;2" />
                <Face Color = "clRed    " VertexIndexes = "2;3;0" />
                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen  " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue   " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
