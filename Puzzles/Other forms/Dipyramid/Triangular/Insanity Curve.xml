<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Insanity Curve</Name>
        <Menu>Other forms\Dipyramid\Triangular\Insanity Curve</Menu>
        <Inventor>Adrián Cures</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9073</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clViolett := '800080';

        R := 0.9;
        H := R / sqrt(3);

        for i := 0 to 2 do begin
            x[i] := R * sin(2 * Pi / 3 * i);
            y[i] := R * cos(2 * Pi / 3 * i);
            nx[i] := -sin(2 * Pi / 3 * i);
            ny[i] := -cos(2 * Pi / 3 * i);
        end;
        nz := sqrt(3)/2;

        A1 := ArcCos(1/8);
        A2 := ArcCos(-3/4);

        D := -R/2/sqrt(7);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2;0;A2;A1" PlaneDistances = "D" FixedLayers = "1" >
        <Axis NormVector = " nx[0]; ny[0];  nz" />
        <Axis NormVector = " nx[1]; ny[1];  nz" />
        <Axis NormVector = " nx[2]; ny[2];  nz" />
        <Axis NormVector = " nx[0]; ny[0]; -nz" />
        <Axis NormVector = " nx[1]; ny[1]; -nz" />
        <Axis NormVector = " nx[2]; ny[2]; -nz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  0" />
                <Add Vector = "x[1]; y[1];  0" />
                <Add Vector = "x[2]; y[2];  0" />
                <Add Vector = "   0;    0;  H" />
                <Add Vector = "   0;    0; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange " VertexIndexes = "0;3;1" />
                <Face Color = "clYellow " VertexIndexes = "1;3;2" />
                <Face Color = "clRed    " VertexIndexes = "2;3;0" />
                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen  " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue   " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "Ax4" Layer = "0" Angle = "A1" />
            <Turn Axis = "Ax3" Layer = "0" Angle = "A2" />
            <Split Axis = "Ax0" From = "1" />
            <Undo Repeat = "2" />

            <Turn Axis = "Ax1" Layer = "0" Angle = "-A1" />
            <Turn Axis = "Ax0" Layer = "0" Angle = "A1" />
            <Split Axis = "Ax1" From = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split" Ax0 = "0" Ax1 = "1" Ax2 = "2" Ax3 = "3" Ax4 = "4" Ax5 = "5" />
        <ExecMacro MacroName = "Split" Ax0 = "1" Ax1 = "2" Ax2 = "0" Ax3 = "4" Ax4 = "5" Ax5 = "3" />
        <ExecMacro MacroName = "Split" Ax0 = "2" Ax1 = "0" Ax2 = "1" Ax3 = "5" Ax4 = "3" Ax5 = "4" />
    </Figure>
</xml>
