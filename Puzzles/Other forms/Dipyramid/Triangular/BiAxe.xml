<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>BiAxe</Name>
        <Menu>Other forms\Dipyramid\Triangular\BiAxe</Menu>
        <Menu>Other forms\Bi Axes\BiAxe</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1934</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clViolett := '800080';

        H := 0.4;
        s5 := sqrt(5);
        r := H * sqrt(1 + s5) / 2;
        a := H * sqrt(2) * (s5 + 3) / 4;
        V := H * sqrt(1 + s5 / 2);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" FixedLayers = "0" >
        <Axis NormVector = " a;-r; 0" />
        <Axis NormVector = "-a;-r; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; H" />
                <Add Vector = " a;-r; 0" />
                <Add Vector = "-a;-r; 0" />
                <Add Vector = " 0; V; 0" />
                <Add Vector = " 0; 0;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange " VertexIndexes = "0;2;1" />
                <Face Color = "clYellow " VertexIndexes = "0;3;2" />
                <Face Color = "clRed    " VertexIndexes = "0;1;3" />

                <Face Color = "clViolett" VertexIndexes = "1;2;4" />
                <Face Color = "clGreen  " VertexIndexes = "2;3;4" />
                <Face Color = "clBlue   " VertexIndexes = "3;1;4" />
            </Faces>
        </Part>

        <Macro Name = "Split" >
            <SplitByAxes/>
            <Turn Axis = "1" Angle = " Pi/2" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "0" Angle = " Pi/2" Layer = "1" />
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "10" />
        <Undo Repeat = "20" />
    </Figure>
</xml>
