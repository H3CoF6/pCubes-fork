<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rounded Madness</Name>
        <Menu>Other forms\Dipyramid\Triangular\Rounded Madness</Menu>
        <Inventor>Linxiao Xu</Inventor>
        <Programmer>Linxiao Xu</Programmer>
        <Added>2024-02-04</Added>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?t=39225</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clViolett := '800080';

        R := 0.9;
        H := R / sqrt(3);

        for i := 0 to 2 do begin
            A := 2 * Pi / 3 * i;
            x[i] := R * sin(A);
            y[i] := R * cos(A);
            nx[i] := -sin(A);
            ny[i] := -cos(A);
        end;
        nz := sqrt(3) / 2;

        A1 := ArcCos( 1 / 8);
        A2 := ArcCos(-3 / 4);

        D := R * 0.135;
    </Script>

    <Axes TurningAngles = " 0; 2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "D" >
        <Axis NormVector = " nx[0]; ny[0]; nz" />
        <Axis NormVector = " nx[1]; ny[1]; nz" />
        <Axis NormVector = " nx[2]; ny[2]; nz" />
        <Axis NormVector = " nx[0]; ny[0];-nz" />
        <Axis NormVector = " nx[1]; ny[1];-nz" />
        <Axis NormVector = " nx[2]; ny[2];-nz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " x[0]; y[0]; 0" />
                <Add Vector = " x[1]; y[1]; 0" />
                <Add Vector = " x[2]; y[2]; 0" />
                <Add Vector = "    0;    0; H" />
                <Add Vector = "    0;    0;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange " VertexIndexes = "0;3;1" />
                <Face Color = "clYellow " VertexIndexes = "1;3;2" />
                <Face Color = "clRed    " VertexIndexes = "2;3;0" />
                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen  " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue   " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split12" >
            <Turn  Axis = "ax1" Layer = "1" Angle = " A2" />
            <Turn  Axis = "ax2" Layer = "1" Angle = "-A2" />
            <Split Axis = "ax5" From  = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split12" ax1 = "0" ax2 = "2" ax5 = "5" />
        <ExecMacro MacroName = "Split12" ax1 = "2" ax2 = "1" ax5 = "4" />
        <ExecMacro MacroName = "Split12" ax1 = "1" ax2 = "0" ax5 = "3" />
        <ExecMacro MacroName = "Split12" ax1 = "3" ax2 = "4" ax5 = "1" />
        <ExecMacro MacroName = "Split12" ax1 = "4" ax2 = "5" ax5 = "2" />
        <ExecMacro MacroName = "Split12" ax1 = "5" ax2 = "3" ax5 = "0" />

        <Macro Name = "Split2" >
            <Turn  Axis = "ax1" Layer = "1" Angle = " A1" />
            <Turn  Axis = "ax2" Layer = "1" Angle = "-A1" />
            <Split Axis = "ax1" From  = "1" />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split2" ax1 = "0" ax2 = "1" />
        <ExecMacro MacroName = "Split2" ax1 = "1" ax2 = "2" />
        <ExecMacro MacroName = "Split2" ax1 = "2" ax2 = "0" />
        <ExecMacro MacroName = "Split2" ax1 = "4" ax2 = "3" />
        <ExecMacro MacroName = "Split2" ax1 = "5" ax2 = "4" />
        <ExecMacro MacroName = "Split2" ax1 = "3" ax2 = "5" />
    </Figure>
</xml>
