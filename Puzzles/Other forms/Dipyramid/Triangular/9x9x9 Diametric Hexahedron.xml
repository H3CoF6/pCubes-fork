<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>9x9x9 Diametric Hexahedron</Name>
        <Menu>Other forms\Dipyramid\Triangular\9x9x9 Diametric Hexahedron</Menu>
        <Inventor>Spencer Brodhead</Inventor>
        <Added>2022-02-15</Added>
        <Programmer>Boris</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6928</Link>
    </Interface>

    <Script>
        Colors[0] := '4040F0'; // Blue
        Colors[1] := 'FFFF00'; // Yellow
        Colors[2] := 'FF0000'; // Red
        Colors[3] := '40A040'; // Green
        Colors[4] := 'FFFFFF'; // White
        Colors[5] := 'FF6000'; // Orange

        R := 0.7;
        H := R / sqrt(2);
        D := H * sqrt(3) / 32;

        for i := 0 to 2 do begin
            x[i] := R * sin(2 * Pi / 3 * i);
            y[i] := R * cos(2 * Pi / 3 * i);
        end;

        hz := H * 5 / 32;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*7;-D*5;-D*3;-D; D; D*3; D*5; D*7"  >
        <Axis NormVector = "x[0]; y[0];-H" BaseVector = " 0; 0; hz" />
        <Axis NormVector = "x[1]; y[1];-H" BaseVector = " 0; 0; hz" />
        <Axis NormVector = "x[2]; y[2];-H" BaseVector = " 0; 0; hz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; 0" />
            <Vertices Vectors = "0; 0; H" />
            <Vertices Vectors = "0; 0;-H" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;3;1" />
                <Face Color = "Colors[1]" VertexIndexes = "1;3;2" />
                <Face Color = "Colors[2]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[3]" VertexIndexes = "0;1;4" />
                <Face Color = "Colors[4]" VertexIndexes = "1;2;4" />
                <Face Color = "Colors[5]" VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
