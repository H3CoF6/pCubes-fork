<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Diametric Hexahedron 3x3x3</Name>
        <Menu>Other forms\Dipyramid\Triangular\Diametric Hexahedron 3x3x3</Menu>
        <Menu>Other forms\3x3x3 variants\Dipyramid\Diametric Hexahedron 3x3x3</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-05-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3789</Link>
    </Interface>

    <Script>
        Colors[0] := '4040F0'; // Blue
        Colors[1] := 'FFFF00'; // Yellow
        Colors[2] := 'FF0000'; // Red
        Colors[3] := '40A040'; // Green
        Colors[4] := 'FFFFFF'; // White
        Colors[5] := 'FF6000'; // Orange

        R := 0.7;
        H := R / sqrt(2);

        for i := 0 to 2 do begin
            x[i] := R * sin( 2 * Pi / 3 * i);
            y[i] := R * cos( 2 * Pi / 3 * i);
        end;

        hz := -H / 8;

        D  := R * sqrt(6) / 16;
    </Script>

    <Axes TurningAngles = " Pi / 2" PlaneDistances = "-D; D"  >
        <Axis NormVector = " x[0]; y[0];-H" BaseVector = " 0; 0; hz" />
        <Axis NormVector = " x[1]; y[1];-H" BaseVector = " 0; 0; hz" />
        <Axis NormVector = " x[2]; y[2];-H" BaseVector = " 0; 0; hz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " x; y; 0" />
            <Vertices Vectors = " 0; 0; H" />
            <Vertices Vectors = " 0; 0;-H" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;3;1" />
                <Face Color = "Colors[1]" VertexIndexes = "1;3;2" />
                <Face Color = "Colors[2]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[3]" VertexIndexes = "0;1;4" />
                <Face Color = "Colors[4]" VertexIndexes = "1;2;4" />
                <Face Color = "Colors[5]" VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
