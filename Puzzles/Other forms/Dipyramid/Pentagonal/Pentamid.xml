<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentamid</Name>
        <Menu>Other forms\Dipyramid\Pentagonal\Pentamid</Menu>
        <Menu>Other forms\Johnson Solids\(J13) Pentagonal Dipyramid\Pentamid</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2047</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clViolett      := '800080';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clOrange       := 'FF6000';
        clLightBlue    := '2828FF';
        clLightViolett := 'FF0080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';

        R := 0.7;
        H := 0.68;
        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;
        D1 := R / 4;
        D2 := H * (5 - sqrt(5)) / 8;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "  0;  0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1" FixedLayers = "1" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0 ;   0 ; H" />

                <Add Vector = "x[0]; y[0]; 0" />
                <Add Vector = "x[1]; y[1]; 0" />
                <Add Vector = "x[2]; y[2]; 0" />
                <Add Vector = "x[3]; y[3]; 0" />
                <Add Vector = "x[4]; y[4]; 0" />

                <Add Vector = "  0 ;   0 ; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clRed         " VertexIndexes = "1;2;0" />
                <Face Color = "clLightViolett" VertexIndexes = "2;3;0" />
                <Face Color = "clBrown       " VertexIndexes = "3;4;0" />
                <Face Color = "clOrange      " VertexIndexes = "4;5;0" />
                <Face Color = "clYellow      " VertexIndexes = "5;1;0" />

                <Face Color = "clBlue        " VertexIndexes = "2;1;6" />
                <Face Color = "clViolett     " VertexIndexes = "3;2;6" />
                <Face Color = "clLightBlue   " VertexIndexes = "4;3;6" />
                <Face Color = "clGreen       " VertexIndexes = "5;4;6" />
                <Face Color = "clLightGreen  " VertexIndexes = "1;5;6" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
