<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Collider-10 unbandaged</Name>
        <Menu>Other forms\Dipyramid\Pentagonal\Collider-10 unbandaged</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-12-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9415</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clViolett      := '800080';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clOrange       := 'FF6000';
        clLightBlue    := '2828FF';
        clLightViolett := 'FF0080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';

        R := 0.5;
        H := R * 1.0;
        sAngle := 2*Pi/5;

        for i := 0 to 4 do begin
            x[i] := R * cos(sAngle * i);
            y[i] := R * sin(sAngle * i);

            ax[i] :=-cos(sAngle * i);
            ay[i] :=-sin(sAngle * i);
        end;

        az := sin(Pi/5);
        D := H * az / sqrt(1 + az^2);

        A1 := ArcCos((sqrt(5) - 5) / 8);
        A2 := ArcCos(-(1 + 5 * sqrt(5)) / 16);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D" FixedLayers = "0" NormVectors = "ax; ay; az" />
    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D" FixedLayers = "0" NormVectors = "ax; ay;-az" />

    <Figure>
        <Part>
            <Vertices Vectors = " 0; 0; H" />
            <Vertices Vectors = " 0; 0;-H" />
            <Vertices Vectors = " x; y; 0" />
            <Faces>
                <Face Color = "clRed         " VertexIndexes = "0;2;3" />
                <Face Color = "clLightViolett" VertexIndexes = "0;3;4" />
                <Face Color = "clBrown       " VertexIndexes = "0;4;5" />
                <Face Color = "clOrange      " VertexIndexes = "0;5;6" />
                <Face Color = "clYellow      " VertexIndexes = "0;6;2" />

                <Face Color = "clBlue        " VertexIndexes = "1;2;6" />
                <Face Color = "clViolett     " VertexIndexes = "1;6;5" />
                <Face Color = "clLightBlue   " VertexIndexes = "1;5;4" />
                <Face Color = "clGreen       " VertexIndexes = "1;4;3" />
                <Face Color = "clLightGreen  " VertexIndexes = "1;3;2" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "ax1" Layers = "1" Angle = "-A2" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A2" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A2" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A2" />
            <SplitByAxes/>
            <Undo Repeat = "4" />
        </Macro>
        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "1" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "3" />
        <ExecMacro MacroName = "Split" ax1 = "4" ax2 = "0" />

        <ExecMacro MacroName = "Split" ax1 = "6" ax2 = "5" />
        <ExecMacro MacroName = "Split" ax1 = "8" ax2 = "7" />
        <ExecMacro MacroName = "Split" ax1 = "5" ax2 = "9" />
    </Figure>
</xml>
