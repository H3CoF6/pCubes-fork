<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentagonal Dipyramid Skewb</Name>
        <Menu>Other forms\Dipyramid\Pentagonal\Pentagonal Dipyramid Skewb</Menu>
        <Menu>Other forms\Skewb variants\Dipyramid\Pentagonal Dipyramid Skewb</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3951</Link>
    </Interface>

    <Script>
        R := 0.4;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        DCut := RSin;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
        <Axis NormVector = "Vx[6]; Vy[6]; Vz[6]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>
        <Cut Color = "Colors[9] " > <Plane NormVector = "-cx[1 ]; -cy[1 ]; -cz[1 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[6] " > <Plane NormVector = "-cx[2 ]; -cy[2 ]; -cz[2 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[3] " > <Plane NormVector = "-cx[3 ]; -cy[3 ]; -cz[3 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[4] " > <Plane NormVector = "-cx[4 ]; -cy[4 ]; -cz[4 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[0] " > <Plane NormVector = "-cx[5 ]; -cy[5 ]; -cz[5 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[2] " > <Plane NormVector = "-cx[1 ]; -cy[1 ];  cz[1 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[1] " > <Plane NormVector = "-cx[2 ]; -cy[2 ];  cz[2 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[8] " > <Plane NormVector = "-cx[3 ]; -cy[3 ];  cz[3 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[5] " > <Plane NormVector = "-cx[4 ]; -cy[4 ];  cz[4 ]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "-cx[5 ]; -cy[5 ];  cz[5 ]" NormDistance = "-DCut" /> </Cut>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
