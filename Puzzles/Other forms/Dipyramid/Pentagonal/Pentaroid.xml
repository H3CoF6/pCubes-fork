<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentaroid</Name>
        <Menu>Other forms\Dipyramid\Pentagonal\Pentaroid</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7570</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00'; // clYellow  
        Colors[1] := '0000A0'; // clBlue    
        Colors[2] := 'FF6000'; // clOrange  
        Colors[3] := 'FF0000'; // clRed     
        Colors[4] := '008000'; // clGreen   
        Colors[5] := 'FFFFFF'; // clWhite   
        Colors[6] := '800080'; // clViolett 
        Colors[7] := 'FF0080'; // clLightViolett
        Colors[8] := '3868BF'; // clLightBlue
        Colors[9] := '00DCB4'; // clCyan

        R := 0.65;
        H := 0.6;

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;

        D1 := R * 0.16;
        D2 := R * 0.4;
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "-D1;D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "0;Pi" PlaneDistances = "D2" >
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
        <Axis NormVector = " x[3]; y[3]; 0" />
        <Axis NormVector = " x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0 ;   0 ;  H" />
                <Add Vector = "x[0]; y[0];  0" />
                <Add Vector = "x[1]; y[1];  0" />
                <Add Vector = "x[2]; y[2];  0" />
                <Add Vector = "x[3]; y[3];  0" />
                <Add Vector = "x[4]; y[4];  0" />
                <Add Vector = "  0 ;   0 ; -H" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;2;0" />
                <Face Color = "Colors[1]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[2]" VertexIndexes = "3;4;0" />
                <Face Color = "Colors[3]" VertexIndexes = "4;5;0" />
                <Face Color = "Colors[4]" VertexIndexes = "5;1;0" />
                <Face Color = "Colors[5]" VertexIndexes = "2;1;6" />
                <Face Color = "Colors[6]" VertexIndexes = "3;2;6" />
                <Face Color = "Colors[7]" VertexIndexes = "4;3;6" />
                <Face Color = "Colors[8]" VertexIndexes = "5;4;6" />
                <Face Color = "Colors[9]" VertexIndexes = "1;5;6" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
