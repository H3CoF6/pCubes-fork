<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy-10 Master</Name>
        <Menu>Other forms\Dipyramid\Pentagonal\Curvy-10 Master</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5389</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red         
        Colors[1] := 'FFFF00'; // Yellow      
        Colors[2] := 'FF6000'; // Orange      
        Colors[3] := '800000'; // Brown       
        Colors[4] := 'FF0080'; // LightViolett

        Colors[5] := '00FF00'; // LightGreen  
        Colors[6] := '0000A0'; // Blue        
        Colors[7] := '800080'; // Violett     
        Colors[8] := '2828FF'; // LightBlue   
        Colors[9] := '008000'; // Green       

        R := 0.58;

        H := R * sqrt(1 + 2 / sqrt(5));

        for i := 0 to 4 do begin
            x[i] := R * sin(2 * Pi / 5 * (i + 0.5));
            y[i] := R * cos(2 * Pi / 5 * (i + 0.5));
        end;

        D1 := R * 0.39;
        D2 := R * 0.52;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "D1; D2" FixedLayers = "0" >
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
        <Axis NormVector = " x[3]; y[3]; 0" />
        <Axis NormVector = " x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; H" />
                <Add Vector = " 0; 0;-H" />
            </Vertices>
            <Vertices Vectors = "x; y; 0" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 3; 2" />
                <Face Color = "Colors[1]" VertexIndexes = " 0; 4; 3" />
                <Face Color = "Colors[2]" VertexIndexes = " 0; 5; 4" />
                <Face Color = "Colors[3]" VertexIndexes = " 0; 6; 5" />
                <Face Color = "Colors[4]" VertexIndexes = " 0; 2; 6" />

                <Face Color = "Colors[5]" VertexIndexes = " 1; 2; 3" />
                <Face Color = "Colors[6]" VertexIndexes = " 1; 3; 4" />
                <Face Color = "Colors[7]" VertexIndexes = " 1; 4; 5" />
                <Face Color = "Colors[8]" VertexIndexes = " 1; 5; 6" />
                <Face Color = "Colors[9]" VertexIndexes = " 1; 6; 2" />
            </Faces>
        </Part>

        <Macro Name = "Split" >
            <Split Axis = "Ax1" From = "1" />
            <Hide  Axis = "Ax1" From = "1" To = "2" />
            <Split Axis = "Ax2" From = "1" />
            <Split Axis = "Ax2" From = "2" />
            <Turn  Axis = "Ax2" From = "1" To = "2" Angle = "-Pi/2" />
            <Split Axis = "Ax1" From = "1" />
            <Turn  Axis = "Ax2" From = "1" To = "2" Angle = "Pi" />
            <Split Axis = "Ax1" From = "1" />
            <Undo Repeat = "2" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "0" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "1" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "2" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "3" />
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "4" />
    </Figure>
</xml>
