<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheese Gem</Name>
        <Menu>Other forms\Dipyramid\Pentagonal\Cheese Gem</Menu>
        <Menu>Other forms\Johnson Solids\(J13) Pentagonal Dipyramid\Cheese Gem</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-03-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7362</Link>
    </Interface>

    <Script>
        clViolett      := '990099';
        clRed          := 'EE0000';
        clOrange       := 'FFBB00';
        clLightBlue    := '0044FF';
        clLightGreen   := '00EE00';

        R := 0.7;
        H := 0.65;
        for i := 0 to 4 do begin
            x[i] :=  R * cos(2 * Pi / 5 * i);
            y[i] :=  R * sin(2 * Pi / 5 * i);
            xa[i] :=  R * cos(2 * Pi / 5 * (i + 0.25)) ;
            ya[i] :=  R * sin(2 * Pi / 5 * (i + 0.25)) ;
        end;
    </Script>

    <Axes TurningAngles = "2 * Pi / 10" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "xa[0]; ya[0]; 0" />
        <Axis NormVector = "xa[1]; ya[1]; 0" />
        <Axis NormVector = "xa[2]; ya[2]; 0" />
        <Axis NormVector = "xa[3]; ya[3]; 0" />
        <Axis NormVector = "xa[4]; ya[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; H" />
                <Add Vector = " 0; 0;-H" />
            </Vertices>

            <Vertices Vectors = "x; y; 0" />

            <Faces>
                <Face Color = "clRed       " VertexIndexes = "2;3;0" />
                <Face Color = "clViolett   " VertexIndexes = "3;4;0" />
                <Face Color = "clOrange    " VertexIndexes = "4;5;0" />
                <Face Color = "clLightBlue " VertexIndexes = "5;6;0" />
                <Face Color = "clLightGreen" VertexIndexes = "6;2;0" />

                <Face Color = "clRed       " VertexIndexes = "3;2;1" />
                <Face Color = "clViolett   " VertexIndexes = "4;3;1" />
                <Face Color = "clOrange    " VertexIndexes = "5;4;1" />
                <Face Color = "clLightBlue " VertexIndexes = "6;5;1" />
                <Face Color = "clLightGreen" VertexIndexes = "2;6;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
        <Turn Axis = "0" From = "0" To = "1" Angle = "2*Pi/10" />
        <SaveSolvedState/>
        <Undo />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
