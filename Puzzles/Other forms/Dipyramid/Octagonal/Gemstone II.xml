<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Gemstone II</Name>
        <Menu>Other forms\Dipyramid\Octagonal\Gemstone II</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-04-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4709</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clGolden       := 'AABB20';
        clPurple       := '800080';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '8000CF';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';
        clPink         := 'FF69B4';
        clOlive        := '808000';

        R  := 0.6;
        R2 := R / sqrt(2);
        H :=  R * sqrt(sqrt(2) + 1);
        nz := R / H * cos (Pi / 8);

        for i := 0 to 7 do begin
            nx[i] := cos(Pi / 4 * (i + 0.5));
            ny[i] := sin(Pi / 4 * (i + 0.5));
        end;

        A1 := ArcCos((sqrt(2) - 1) / 2);
        A2 := ArcCos(-sqrt(2) + 1 / 2); // = 2 * A1
        A3 := ArcCos(sqrt(2) - 2);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1;A2;A3" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " nx[0]; ny[0]; nz" />
        <Axis NormVector = " nx[1]; ny[1]; nz" />
        <Axis NormVector = " nx[2]; ny[2]; nz" />
        <Axis NormVector = " nx[3]; ny[3]; nz" />
        <Axis NormVector = " nx[4]; ny[4]; nz" />
        <Axis NormVector = " nx[5]; ny[5]; nz" />
        <Axis NormVector = " nx[6]; ny[6]; nz" />
        <Axis NormVector = " nx[7]; ny[7]; nz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;   0;  H" />
                <Add Vector = "  0;   0; -H" />
                <Add Vector = "  R;   0;  0" />
                <Add Vector = " -R;   0;  0" />
                <Add Vector = "  0;   R;  0" />
                <Add Vector = "  0;  -R;  0" />
                <Add Vector = " R2;  R2;  0" />
                <Add Vector = " R2; -R2;  0" />
                <Add Vector = "-R2;  R2;  0" />
                <Add Vector = "-R2; -R2;  0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  "       VertexIndexes = "0; 2; 6" />
                <Face Color = "clGreen "       VertexIndexes = "0; 6; 4" />
                <Face Color = "clRed   "       VertexIndexes = "0; 4; 8" />
                <Face Color = "clOrange"       VertexIndexes = "0; 8; 3" />
                <Face Color = "clYellow"       VertexIndexes = "0; 3; 9" />
                <Face Color = "clWhite "       VertexIndexes = "0; 9; 5" />
                <Face Color = "clGolden"       VertexIndexes = "0; 5; 7" />
                <Face Color = "clPurple"       VertexIndexes = "0; 7; 2" />

                <Face Color = "clLightBlue"    VertexIndexes = "1; 2; 7" />
                <Face Color = "clLightGreen"   VertexIndexes = "1; 7; 5" />
                <Face Color = "clBrown "       VertexIndexes = "1; 5; 9" />
                <Face Color = "clViolett"      VertexIndexes = "1; 9; 3" />
                <Face Color = "clLightViolett" VertexIndexes = "1; 3; 8" />
                <Face Color = "clCyan "        VertexIndexes = "1; 8; 4" />
                <Face Color = "clPink "        VertexIndexes = "1; 4; 6" />
                <Face Color = "clOlive"        VertexIndexes = "1; 6; 2" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
