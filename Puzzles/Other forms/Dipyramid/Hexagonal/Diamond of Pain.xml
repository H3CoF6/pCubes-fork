<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Diamond of Pain</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\Diamond of Pain</Menu>
        <Inventor>Nico Bayer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6323</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        R := 0.6;

        H := R * sqrt(3) * 3 / 5;
        D := H * 0.4;

        for i := 0 to 5 do begin
            Vx[i] := R * sin(Pi/3 * i);
            Vy[i] := R * cos(Pi/3 * i);
        end;

    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi/6; 0" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "  0;  0;  H" />
            <Vertices Vectors = "  0;  0; -H" />
            <Vertices Vectors = " Vx; Vy;  0" />
            <Faces>
                <Face Color = "clYellow      " VertexIndexes = " 0; 3; 2" />
                <Face Color = "clBlue        " VertexIndexes = " 0; 2; 7" />
                <Face Color = "clOrange      " VertexIndexes = " 0; 7; 6" />
                <Face Color = "clRed         " VertexIndexes = " 0; 6; 5" />
                <Face Color = "clGreen       " VertexIndexes = " 0; 5; 4" />
                <Face Color = "clWhite       " VertexIndexes = " 0; 4; 3" />
                <Face Color = "clLightViolett" VertexIndexes = " 1; 3; 4" />
                <Face Color = "clLightBlue   " VertexIndexes = " 1; 4; 5" />
                <Face Color = "clViolett     " VertexIndexes = " 1; 5; 6" />
                <Face Color = "clBrown       " VertexIndexes = " 1; 6; 7" />
                <Face Color = "clLightGreen  " VertexIndexes = " 1; 7; 2" />
                <Face Color = "clCyan        " VertexIndexes = " 1; 2; 3" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Undo Repeat = "2" />
    </Figure>
</xml>
