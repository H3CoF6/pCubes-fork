<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Gemstone I</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\Gemstone I</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4563</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        R := 0.7;
        H := R;
        pA := R / 2;
        pB := R * sqrt(3) / 2;

        nZ := sqrt(3) / 2;
        nA := 1;
        nB := sqrt(3) / 2;
        nC := 1 / 2;

        A1 := ArcCos(-3/4);
        A2 := ArcCos(1/8);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2; pi" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "  0; nA; nZ" />
        <Axis NormVector = " nB; nC; nZ" />
        <Axis NormVector = " nB;-nC; nZ" />
        <Axis NormVector = "  0;-nA; nZ" />
        <Axis NormVector = "-nB;-nC; nZ" />
        <Axis NormVector = "-nB; nC; nZ" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;   0;  H" />
                <Add Vector = "  R;   0;  0" />
                <Add Vector = " pA; -pB;  0" />
                <Add Vector = "-pA; -pB;  0" />
                <Add Vector = " -R;   0;  0" />
                <Add Vector = "-pA;  pB;  0" />
                <Add Vector = " pA;  pB;  0" />
                <Add Vector = "  0;   0; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  "       VertexIndexes = "0;2;1" />
                <Face Color = "clGreen "       VertexIndexes = "0;3;2" />
                <Face Color = "clRed   "       VertexIndexes = "0;4;3" />
                <Face Color = "clOrange"       VertexIndexes = "0;5;4" />
                <Face Color = "clYellow"       VertexIndexes = "0;6;5" />
                <Face Color = "clWhite "       VertexIndexes = "0;1;6" />

                <Face Color = "clLightBlue"    VertexIndexes = "7;1;2" />
                <Face Color = "clLightGreen"   VertexIndexes = "7;2;3" />
                <Face Color = "clBrown "       VertexIndexes = "7;3;4" />
                <Face Color = "clViolett"      VertexIndexes = "7;4;5" />
                <Face Color = "clLightViolett" VertexIndexes = "7;5;6" />
                <Face Color = "clCyan "        VertexIndexes = "7;6;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
