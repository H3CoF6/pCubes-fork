<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fracture-12</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\Fracture-12</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-04-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4145</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'F0E68C'; // Khaki
        Colors[ 1] := '0000A0'; // Blue
        Colors[ 2] := '00FFFF'; // Cyan
        Colors[ 3] := '2828FF'; // LightBlue
        Colors[ 4] := '008000'; // Green
        Colors[ 5] := '00FF00'; // LightGreen
        Colors[ 6] := 'FF0080'; // LightViolett
        Colors[ 7] := '800000'; // Brown
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := 'FFFF00'; // Yellow
        Colors[10] := '800080'; // Violett
        Colors[11] := 'FF0000'; // Red

        Colors[12] := '202020'; // Black1
        Colors[13] := '202021'; // Black2

        R := 0.7;
        H1 := R * sqrt(3);
        H2 := H1 / 2;

        D := R / 2;

        for i := 0 to 5 do begin
            x[i] := R * sin(2*Pi / 6 * i);
            y[i] := R * cos(2*Pi / 6 * i);
        end;
    </Script>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D" NormVectors = "x; y; 0" />

    <Figure>
        <Part>
            <Vertices Vectors = " 0; 0;-H1" />
            <Vertices Vectors = " x; y;  0" />
            <Vertices Vectors = " 0; 0; H1" />
            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "0;1;2" />
                <Face Color = "Colors[ 1]" VertexIndexes = "0;2;3" />
                <Face Color = "Colors[ 2]" VertexIndexes = "0;3;4" />
                <Face Color = "Colors[ 3]" VertexIndexes = "0;4;5" />
                <Face Color = "Colors[ 4]" VertexIndexes = "0;5;6" />
                <Face Color = "Colors[ 5]" VertexIndexes = "0;6;1" />
                <Face Color = "Colors[ 6]" VertexIndexes = "7;1;6" />
                <Face Color = "Colors[ 7]" VertexIndexes = "7;6;5" />
                <Face Color = "Colors[ 8]" VertexIndexes = "7;5;4" />
                <Face Color = "Colors[ 9]" VertexIndexes = "7;4;3" />
                <Face Color = "Colors[10]" VertexIndexes = "7;3;2" />
                <Face Color = "Colors[11]" VertexIndexes = "7;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cut Color = "Colors[12]"> <Plane NormVector = " 0; 0; 1" NormDistance = "-H2" /> </Cut>
        <Cut Color = "Colors[13]"> <Plane NormVector = " 0; 0;-1" NormDistance = "-H2" /> </Cut>

        <Macro Name = "Split" >
            <Turn  Axis = "ax"             Layer = "1" Angle = " Pi" />
            <Turn  Axis = "(ax + 1) mod 6" Layer = "1" Angle = " Pi/2" />
            <Split Axis = "ax"             From  = "1" />
            <Split Axis = "(ax + 2) mod 6" From  = "1" />
            <Undo Repeat = "2" />
            <Script>Inc(ax);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "6" />
    </Figure>
</xml>
