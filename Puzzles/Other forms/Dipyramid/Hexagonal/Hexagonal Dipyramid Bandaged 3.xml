<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagonal Dipyramid Bandaged 3</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\Hexagonal Dipyramid Bandaged 3</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9222</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W; W; W" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue " VertexIndexes = "1;0;4;5" />
                <Face Color = "clBlue " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed  " VertexIndexes = "0;1;3;2" />
                <Face Color = "clRed  " VertexIndexes = "5;4;6;7" />
                <Face Color = "clWhite" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Cut Color = "clOrange" > <Plane NormVector = " 2; 2;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clOrange" > <Plane NormVector = "-2;-2; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen"  > <Plane NormVector = " 2;-1; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen"  > <Plane NormVector = "-2; 1;-2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "-1; 2; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 1;-2;-2" NormDistance = "-W" /> </Cut>

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />

        <HideContaining Vector = "Cx; Cy; Cz" />

        <InvertVisibility/>
        <SplitByAxes/>
        <RemoveGrayParts/>
        <ShowAll/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "-ArcTan(sqrt(2))" />
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
