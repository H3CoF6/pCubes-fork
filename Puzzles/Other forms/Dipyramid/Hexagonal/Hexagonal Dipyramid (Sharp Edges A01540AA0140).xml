<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagonal Dipyramid (Sharp Edges A01540AA0140)</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\Hexagonal Dipyramid (Sharp Edges A01540AA0140)</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3303</Link>
    </Interface>

    <Script>
        Colors[0] := 'C80000'; // Red   
        Colors[1] := '009600'; // Green 
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := 'FF6600'; // Orange
        Colors[4] := '0000C8'; // Blue  
        Colors[5] := 'FFFFFF'; // White 

        R := 0.7;
        H := R / sqrt(2);

        D := R * 0.22;

        for i := 0 to 5 do begin
            x[i] := R * sin(2*Pi / 6 * i);
            y[i] := R * cos(2*Pi / 6 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 1; 0" Angle = "-Pi / 4" />
        <Turn NormVector = " 1; 0; 0" Angle = "arctan(1/sqrt(2))" />
        <Part>
            <Vertices Vectors = " 0; 0;-H" />
            <Vertices Vectors = " x; y; 0" />
            <Vertices Vectors = " 0; 0; H" />
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;2" />
                <Face Color = "Colors[1]" VertexIndexes = "0;2;3" />
                <Face Color = "Colors[2]" VertexIndexes = "0;3;4" />
                <Face Color = "Colors[3]" VertexIndexes = "0;4;5" />
                <Face Color = "Colors[4]" VertexIndexes = "0;5;6" />
                <Face Color = "Colors[5]" VertexIndexes = "0;6;1" />
                <Face Color = "Colors[0]" VertexIndexes = "7;5;4" />
                <Face Color = "Colors[1]" VertexIndexes = "7;6;5" />
                <Face Color = "Colors[2]" VertexIndexes = "7;1;6" />
                <Face Color = "Colors[3]" VertexIndexes = "7;2;1" />
                <Face Color = "Colors[4]" VertexIndexes = "7;3;2" />
                <Face Color = "Colors[5]" VertexIndexes = "7;4;3" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
