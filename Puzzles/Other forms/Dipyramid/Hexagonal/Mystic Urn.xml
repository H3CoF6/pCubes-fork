<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mystic Urn</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\Mystic Urn</Menu>
        <Inventor>Matt Galla</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-08-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7232</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=386865</Link>
        <Link>https://youtube.com/watch?v=IEjojQHjsIM</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clViolett      := '800080';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clOrange       := 'FF6000';
        clLightBlue    := '2828FF';
        clLightViolett := 'FF0080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00FFFF';
        clKhaki        := 'F0E68C';
        clTop          := 'FFFFFF'; // clWhite
        clBottom       := '555555'; // clGray

        R := 0.6;

        H := R * sqrt(3) * 3 / 5;
        BH := R * sqrt(3);

        for i := 0 to 5 do begin
            Vx[i] := R * sin(Pi/3 * i);
            Vy[i] := R * cos(Pi/3 * i);

            Ax[i] := cos(Pi/3 * i);
            Ay[i] := sin(Pi/3 * i);
        end;
        Az := 0.5;

        D := R * 3 * sqrt(15) / 25;

        A1 := ArcCos(-1/4);
        A2 := A1 * 2;

    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " Ax[0]; Ay[0]; Az" />
        <Axis NormVector = " Ax[1]; Ay[1]; Az" />
        <Axis NormVector = " Ax[2]; Ay[2]; Az" />
        <Axis NormVector = " Ax[3]; Ay[3]; Az" />
        <Axis NormVector = " Ax[4]; Ay[4]; Az" />
        <Axis NormVector = " Ax[5]; Ay[5]; Az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0;  BH" />
                <Add Vector = " 0; 0; -BH" />

                <Add Vector = " Vx[0]; Vy[0]; 0" />
                <Add Vector = " Vx[1]; Vy[1]; 0" />
                <Add Vector = " Vx[2]; Vy[2]; 0" />
                <Add Vector = " Vx[3]; Vy[3]; 0" />
                <Add Vector = " Vx[4]; Vy[4]; 0" />
                <Add Vector = " Vx[5]; Vy[5]; 0" />
            </Vertices>
            <Faces>
                <Face Color = "clRed         " VertexIndexes = " 0; 3; 2" />
                <Face Color = "clLightViolett" VertexIndexes = " 0; 2; 7" />
                <Face Color = "clBrown       " VertexIndexes = " 0; 7; 6" />
                <Face Color = "clOrange      " VertexIndexes = " 0; 6; 5" />
                <Face Color = "clYellow      " VertexIndexes = " 0; 5; 4" />
                <Face Color = "clViolett     " VertexIndexes = " 0; 4; 3" />

                <Face Color = "clBlue        " VertexIndexes = " 1; 3; 4" />
                <Face Color = "clCyan        " VertexIndexes = " 1; 4; 5" />
                <Face Color = "clLightBlue   " VertexIndexes = " 1; 5; 6" />
                <Face Color = "clGreen       " VertexIndexes = " 1; 6; 7" />
                <Face Color = "clLightGreen  " VertexIndexes = " 1; 7; 2" />
                <Face Color = "clKhaki       " VertexIndexes = " 1; 2; 3" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cut Color = "clTop   "> <Plane NormVector = "  0;  0; -1" NormDistance = "-H" /> </Cut>
        <Cut Color = "clBottom"> <Plane NormVector = "  0;  0;  1" NormDistance = "-H" /> </Cut>

    </Figure>
</xml>
