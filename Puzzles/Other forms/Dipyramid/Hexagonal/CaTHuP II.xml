<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>CaTHuP II</Name>
        <Menu>Other forms\Dipyramid\Hexagonal\CaTHuP II</Menu>
        <Inventor>Jonathan Burn</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8551</Link>
        <Link>https://youtube.com/watch?v=ijeV0gogHng</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // Red
        Colors[ 1] := '00AA00'; // Green
        Colors[ 2] := 'FFFF00'; // Yellow
        Colors[ 3] := 'FF6000'; // Orange
        Colors[ 4] := '0033EE'; // Blue
        Colors[ 5] := 'FFFFFF'; // White
        Colors[ 6] := 'FF88DD'; // Rose
        Colors[ 7] := '00AAFF'; // LightBlue
        Colors[ 8] := '333333'; // Black
        Colors[ 9] := '8800EE'; // Violett
        Colors[10] := '00DDCC'; // Cyan
        Colors[11] := 'FF3399'; // LightViolett

        R := 0.7;

        H1 := R * 0.95;
        H2 := R * 0.75;
        D1 :=-R * 0.51;
        D2 := R * 0.11;

        for i := 0 to 5 do begin
            x[i] := R * cos(2 * Pi / 6 * i);
            y[i] := R * sin(2 * Pi / 6 * i);
        end;

        for i := 0 to 5 do begin
            ax[i] := cos(2 * Pi / 6 * i);
            ay[i] := sin(2 * Pi / 6 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D1" FixedLayers = "1" NormVectors = "ax; ay; 0" />

    <Axes TurningAngles = "2*Pi/6" PlaneDistances = "D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; H1" />
                <Add Vector = " 0; 0;-H2" />
            </Vertices>
            <Vertices Vectors = "x; y; 0" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "0;2;3" />
                <Face Color = "Colors[ 1]" VertexIndexes = "0;3;4" />
                <Face Color = "Colors[ 2]" VertexIndexes = "0;4;5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "0;5;6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "0;6;7" />
                <Face Color = "Colors[ 5]" VertexIndexes = "0;7;2" />

                <Face Color = "Colors[ 6]" VertexIndexes = "1;3;2" />
                <Face Color = "Colors[ 7]" VertexIndexes = "1;4;3" />
                <Face Color = "Colors[ 8]" VertexIndexes = "1;5;4" />
                <Face Color = "Colors[ 9]" VertexIndexes = "1;6;5" />
                <Face Color = "Colors[10]" VertexIndexes = "1;7;6" />
                <Face Color = "Colors[11]" VertexIndexes = "1;2;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn Axis = "2" Layer = "0" Angle = " Pi"/>
        <Turn Axis = "1" Layer = "0" Angle = "-Pi"/>
        <Turn Axis = "3" Layer = "0" Angle = " Pi"/>
        <Turn Axis = "2" Layer = "0" Angle = " Pi"/>
        <Turn Axis = "3" Layer = "0" Angle = "-Pi"/>
        <Turn Axis = "1" Layer = "0" Angle = " Pi"/>
        <SplitByAxes/>
        <Undo Repeat = "6" />

        <Turn Axis = "0" Layer = "0" Angle = " Pi"/>
        <Turn Axis = "4" Layer = "0" Angle = "-Pi"/>
        <Turn Axis = "5" Layer = "0" Angle = "-Pi"/>
        <Turn Axis = "0" Layer = "0" Angle = "-Pi"/>
        <Turn Axis = "4" Layer = "0" Angle = " Pi"/>
        <Turn Axis = "5" Layer = "0" Angle = "-Pi"/>
        <SplitByAxes/>
        <Undo Repeat = "6" />
    </Figure>
</xml>
