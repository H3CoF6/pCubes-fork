<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis Hexagonal Dipyramid</Name>
        <Menu>Other forms\3x3x3 variants\Dipyramid\Axis Hexagonal Dipyramid</Menu>
        <Menu>Other forms\Dipyramid\Hexagonal\Axis Hexagonal Dipyramid</Menu>
        <Inventor>Rafael Gulluni</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9204</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "-2;-1; 2" />
        <Axis NormVector = " 1; 2; 2" />
        <Axis NormVector = "-2; 2;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W; W; W" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue " VertexIndexes = "1;0;4;5" />
                <Face Color = "clBlue " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed  " VertexIndexes = "0;1;3;2" />
                <Face Color = "clRed  " VertexIndexes = "5;4;6;7" />
                <Face Color = "clWhite" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Cut Color = "clOrange" > <Plane NormVector = " 2; 2;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clOrange" > <Plane NormVector = "-2;-2; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 2;-1; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = "-2; 1;-2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "-1; 2; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 1;-2;-2" NormDistance = "-W" /> </Cut>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Undo />

        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "-ArcTan(sqrt(2))" />
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
