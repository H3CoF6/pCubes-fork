<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octahedral Mixup I Cube</Name>
        <Menu>Other forms\Dipyramid\Tetragonal\Octahedral Mixup I Cube</Menu>
        <Inventor>You YuChun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-07-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6569</Link>
    </Interface>
 
    <Script>
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';

        W := 0.6;
        s2 := sqrt(2);
        D := W * (1 - 1 / s2);
        DCut := D * s2 * 1.1;

        CutV1 := W * s2 * 0.95;
        CutV2 := W * 0.95;
        CutE1 := W * 0.98;
        CutE2 := W * sqrt(2/3) * 0.985;
    </Script>

    <Axes TurningAngles = " Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " 0; 0; W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;4" />
                <Face Color = "Colors[1]" VertexIndexes = "1;2;4" />
                <Face Color = "Colors[2]" VertexIndexes = "2;3;4" />
                <Face Color = "Colors[3]" VertexIndexes = "3;0;4" />
                <Face Color = "Colors[4]" VertexIndexes = "1;0;5" />
                <Face Color = "Colors[5]" VertexIndexes = "2;1;5" />
                <Face Color = "Colors[6]" VertexIndexes = "3;2;5" />
                <Face Color = "Colors[7]" VertexIndexes = "0;3;5" />
            </Faces>
        </Part>

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />

        <SplitByAxes/>

        <RemoveGrayParts/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Undo/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Undo/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <Undo/>

        <RemoveGrayParts/>

        <Macro Name = "Cut" >
            <HideContaining Vector = " 0; 0; DCut" />
            <InvertVisibility/>
            <Cut><Plane NormVector = " 0; 1; 1" NormDistance = "D" /></Cut>
            <Cut><Plane NormVector = " 0;-1; 1" NormDistance = "D" /></Cut>
            <Cut><Plane NormVector = " 1; 0; 1" NormDistance = "D" /></Cut>
            <Cut><Plane NormVector = "-1; 0; 1" NormDistance = "D" /></Cut>
            <ShowAll/>
            <Turn NormVector = "0;1;0" Angle = "Pi/4" />
        </Macro>
        <ExecMacro MacroName = "Cut" Repeat = "8" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "Cut" Repeat = "8" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "Cut" Repeat = "8" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layers = "0;2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <RemoveAllVisible/>
        <ShowAll/>
        <Undo/>

        <!-- cut edges and vertices for better control -->
        <Cut><Plane NormVector = " 1; 1; 0" NormDistance = "-CutV1" /></Cut>
        <Cut><Plane NormVector = " 1;-1; 0" NormDistance = "-CutV1" /></Cut>
        <Cut><Plane NormVector = "-1;-1; 0" NormDistance = "-CutV1" /></Cut>
        <Cut><Plane NormVector = "-1; 1; 0" NormDistance = "-CutV1" /></Cut>

        <Cut><Plane NormVector = " 1; 0; 0" NormDistance = "-CutE1" /></Cut>
        <Cut><Plane NormVector = "-1; 0; 0" NormDistance = "-CutE1" /></Cut>
        <Cut><Plane NormVector = " 0; 1; 0" NormDistance = "-CutE1" /></Cut>
        <Cut><Plane NormVector = " 0;-1; 0" NormDistance = "-CutE1" /></Cut>

        <Cut><Plane NormVector = " 0; 0; 1" NormDistance = "-CutV2" /></Cut>
        <Cut><Plane NormVector = " 0; 0;-1" NormDistance = "-CutV2" /></Cut>

        <Cut><Plane NormVector = "-1;-1;-2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = " 1;-1;-2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = "-1; 1;-2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = " 1; 1;-2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = "-1;-1; 2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = " 1;-1; 2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = "-1; 1; 2" NormDistance = "-CutE2" /></Cut>
        <Cut><Plane NormVector = " 1; 1; 2" NormDistance = "-CutE2" /></Cut>
    </Figure>
</xml>
