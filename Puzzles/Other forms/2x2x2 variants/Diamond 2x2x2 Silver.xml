<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Diamond 2x2x2 Silver</Name>
        <Menu>Other forms\2x2x2 variants\Diamond 2x2x2 Silver</Menu>
        <Inventor>Kyler van der Gaag</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1533</Link>
    </Interface>

    <Script>
        clSilver := '8888AA';
        clBlack  := '202020';
        clBottom := '7777BB';
        Colors[0] := clBlack;
        Colors[1] := clSilver;
        Colors[2] := clSilver;
        Colors[3] := clSilver;
        Colors[4] := clSilver;
        Colors[5] := clSilver;

        W := 0.5;
        DCut := W * sqrt(3) / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Color = "clSilver" > <Plane NormVector = " 2; 2;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clSilver" > <Plane NormVector = "-2;-2; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clSilver" > <Plane NormVector = " 2;-1; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clSilver" > <Plane NormVector = "-2; 1;-2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlack " > <Plane NormVector = "-1; 2; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clSilver" > <Plane NormVector = " 1;-2;-2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBottom" > <Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /></Cut>
        <SplitByAxes/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "-ArcTan(sqrt(2))" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
