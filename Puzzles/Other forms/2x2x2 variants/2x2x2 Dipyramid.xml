<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x2 Dipyramid</Name>
        <Menu>Other forms\2x2x2 variants\2x2x2 Dipyramid</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-04-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11821</Link>
        <Link>https://www.twistypuzzles.com/forum/viewtopic.php?p=428669</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';

        W := 0.6;
        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector  = " Cx[2]; Cy[2]; Cz[2]" />
                <Add Vector  = " Cx[3]; Cy[3]; Cz[3]" />
                <Add Vector  = " Cx[4]; Cy[4]; Cz[4]" />
                <Add Vector  = " Cx[5]; Cy[5]; Cz[5]" />
                <Add Vector  = " Ex[2]; Ey[2]; Ez[2]" />
                <Add Vector  = " Ex[4]; Ey[4]; Ez[4]" />
                <Add Vector  = " Ex[5]; Ey[5]; Ez[5]" />
                <Add Vector  = " Ex[9]; Ey[9]; Ez[9]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0;5;3;4" />
                <Face Color = "Colors[3]" VertexIndexes = "5;0;7;2" />
                <Face Color = "Colors[5]" VertexIndexes = "6;1;4;3" />
                <Face Color = "Colors[7]" VertexIndexes = "1;6;2;7" />
                <Face Color = "Colors[0]" VertexIndexes = "5;6;3" />
                <Face Color = "Colors[2]" VertexIndexes = "6;5;2" />
                <Face Color = "Colors[4]" VertexIndexes = "7;4;1" />
                <Face Color = "Colors[6]" VertexIndexes = "4;7;0" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
