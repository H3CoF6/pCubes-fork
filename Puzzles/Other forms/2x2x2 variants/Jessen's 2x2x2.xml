<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Jessen's 2x2x2</Name>
        <Menu>Other forms\2x2x2 variants\Jessen's 2x2x2</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>zse</Programmer>
        <Added>2020-02-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7875</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        clCyan := '00FFFF';

        W1 := 0.3;
        W2 := W1 * 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W2;  0; W1" />
                <Add Vector = " W2;  0;-W1" />
                <Add Vector = "-W2;  0; W1" />
                <Add Vector = "-W2;  0;-W1" />
                <Add Vector = " W1; W2;  0" />
                <Add Vector = " W1;-W2;  0" />
                <Add Vector = "-W1; W2;  0" />
                <Add Vector = "-W1;-W2;  0" />
                <Add Vector = "  0; W1; W2" />
                <Add Vector = "  0; W1;-W2" />
                <Add Vector = "  0;-W1; W2" />
                <Add Vector = "  0;-W1;-W2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"  VertexIndexes = " 0; 2;10" />
                <Face Color = "clWhite"  VertexIndexes = " 0; 8; 2" />
                <Face Color = "clOrange" VertexIndexes = " 0; 5; 4" />
                <Face Color = "clOrange" VertexIndexes = " 5; 1; 4" />
                <Face Color = "clYellow" VertexIndexes = " 3; 1;11" />
                <Face Color = "clYellow" VertexIndexes = " 3; 9; 1" />
                <Face Color = "clRed"    VertexIndexes = " 3; 7; 6" />
                <Face Color = "clRed"    VertexIndexes = " 2; 6; 7" />
                <Face Color = "clBlue"   VertexIndexes = "10; 7;11" />
                <Face Color = "clBlue"   VertexIndexes = "10;11; 5" />
                <Face Color = "clGreen"  VertexIndexes = " 4; 9; 8" />
                <Face Color = "clGreen"  VertexIndexes = " 8; 9; 6" />
                <Face Color = "clCyan"   VertexIndexes = " 0;10; 5" />
                <Face Color = "clCyan"   VertexIndexes = " 0; 4; 8" />
                <Face Color = "clCyan"   VertexIndexes = " 3;11; 7" />
                <Face Color = "clCyan"   VertexIndexes = " 3; 6; 9" />
                <Face Color = "clCyan"   VertexIndexes = " 2; 7;10" />
                <Face Color = "clCyan"   VertexIndexes = " 5;11; 1" />
                <Face Color = "clCyan"   VertexIndexes = " 4; 1; 9" />
                <Face Color = "clCyan"   VertexIndexes = " 8; 6; 2" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <SaveSolvedState/>
        <Turn Axis = "2" From = "0" To = "1" Angle = "Pi / 2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
