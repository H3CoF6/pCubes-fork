    // based on Rhomdo Celestial by Evgeniy Grigoriev

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        K   := 1 / 50;
        pAx := K * 20;
        pBx := K * 10;
        pCx := K * 21;
        pDx := K *  6;
        pEx := K * 15;
        pFx := K * 25;
        pGx := K *  5;
        pHx := K * 20;
        pIx := K * 27;
        pJx := K *  9;
        pKx := K * 18;
        pLx := K * 30;
        pMx := K * 15;
        nAx := K * 22;
        nBx := K * 11;
        nCx := K * 23;
        nDx := K * 10;
        nEx := K * 13;
        nFx := K * 24;
        nGx := K * 12;

        K3  := K  * sqrt(3);
        pBy := K3 * 10;
        pCy := K3 *  3;
        pDy := K3 * 12;
        pEy := K3 *  9;
        pFy := K3 *  5;
        pGy := K3 * 15;
        pHy := K3 * 10;
        pIy := K3 *  3;
        pJy := K3 * 15;
        pKy := K3 * 12;
        pMy := K3 * 15;
        nBy := K3 * 11;
        nCy := K3;
        nDy := K3 * 12;
        nEy := K3 * 11;
        nGy := K3 * 12;

        K2  := K  * sqrt(2) / 2;
        pAz := K2 * 35;
        pCz := K2 * 30;
        pFz := K2 * 25;
        pIz := K2 * 18;
        pLz := K2 * 15;
        nAz := K2 * 25;
        nCz := K2 * 23;
        nFz := K2 * 21;

        H   := K2 * 45;

        D   := K3 * 12;

        nA  := sqrt(3) / 2;
        nB  := 1 / 2;
        nz  := sqrt(2);

        A1  := Arccos(1 / 3);
        A2  := 2 * A1;
        A3  := Pi - A1;
    </Script>

    <Axes TurningAngles = "Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3; Pi" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "  0;  1; 0" />
        <Axis NormVector = "-nA;-nB; 0" />
        <Axis NormVector = " nA;-nB; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "  1;  0; nz" />
        <Axis NormVector = "-nB;-nA; nz" />
        <Axis NormVector = "-nB; nA; nz" />
        <Axis NormVector = "  1;  0;-nz" />
        <Axis NormVector = "-nB;-nA;-nz" />
        <Axis NormVector = "-nB; nA;-nz" />
    </Axes>

    <Figure>
