                <Add Vector = " pGx;-pGy;-pFz" />
                <Add Vector = " pHx;-pHy;-pFz" />
                <Add Vector = " pHx; pHy;-pFz" />
                <Add Vector = " pGx; pGy;-pFz" />

                <Add Vector = "-pCx; pCy;-pCz" />
                <Add Vector = "-pCx;-pCy;-pCz" />
                <Add Vector = " pDx;-pDy;-pCz" />
                <Add Vector = " pEx;-pEy;-pCz" />
                <Add Vector = " pEx; pEy;-pCz" />
                <Add Vector = " pDx; pDy;-pCz" />

                <Add Vector = "-pAx;   0;-pAz" />
                <Add Vector = " pBx;-pBy;-pAz" />
                <Add Vector = " pBx; pBy;-pAz" />

                <Add Vector = "   0;   0;-  H" />

                <Add Vector = "-nAx;   0; nAz" />
                <Add Vector = " nBx;-nBy; nAz" />
                <Add Vector = " nBx; nBy; nAz" />

                <Add Vector = "-nCx; nCy; nCz" />
