<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhomdo Comet</Name>
        <Menu>Other forms\Comet\Rhomdo Comet</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8847</Link>
