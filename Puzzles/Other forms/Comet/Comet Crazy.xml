    <Script>
        clRed          := 'C80000';
        clLightBlue    := '0000D8';
        clLightGreen   := '00A600';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clBrown        := 'BF8040';
        clViolett      := '800040';
        clOlive        := '808000';
        clGreen        := '005600';
        clYellow       := 'FFFF00';
        clOrange       := 'FF800A';
        clBlue         := '000078';

        k := 1 / 80;
        p0 := k * 45;
        p1 := k * 48;
        p2 := k * 50;
        p3 := k * 12;
        p4 := k * 30;
        p5 := k * 10;
        p6 := k * 2;
        p7 := k * 46;

        D  := k * 24 * sqrt(2);

        A1 := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "A1" PlaneDistances = "-D; D" > 
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
        <Axis NormVector = "1; 0; 1" />
        <Axis NormVector = "1; 0;-1" />
        <Axis NormVector = "0; 1; 1" />
        <Axis NormVector = "0; 1;-1" />
    </Axes>

    <Figure>
