<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Astroid Attack</Name>
        <Menu>Other forms\Comet\Astroid Attack</Menu>
        <Menu>Other forms\Trapezohedron\Face Turning\Astroid Attack</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-05-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1496</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00'; // Yellow
        Colors[1] := '0000A0'; // Blue
        Colors[2] := 'FF6000'; // Orange
        Colors[3] := 'FF0000'; // Red
        Colors[4] := '008000'; // Green
        Colors[5] := '00FFFF'; // Cyan
        Colors[6] := '800080'; // Violett
        Colors[7] := 'FF69B4'; // Pink

        R := 0.65;

        s2 := sqrt(2);
        ss2 := sqrt(sqrt(2));

        pX0 := R * (3 * s2 - 4) / 6;
        pZ0 := R * (5 * s2 - 3) / 6 * ss2;

        pX1 := R * (2 - s2) / 2;
        pZ1 := R * (3 - s2) / 2 * ss2;

        pX2 := R * 1 / 3;
        pZ2 := R * (3 + s2) / 6 * ss2;

        pX3 := R * s2 / 2;
        pZ3 := R * (s2 - 1) / 2 * ss2;

        pX4 := R;
        pX5 := R * s2 / 6;
        pX6 := R * (s2 - 1);
        pX7 := R * (3 - 2 * s2) / 3;

        az := ss2 / 2;
        ax2 := s2 / 2;

        D := -R * sqrt(32 + 13 * s2 ) / 6 / sqrt(7);

        A1 := ArcCos((s2 - 1) / 2);      // 1.36
        A2 := ArcCos(s2 - 2);            // 2.19
        A3 := ArcCos((-2 * s2 + 1) / 2); // 2.72
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" FixedLayers = "1" >
        <Axis NormVector = "  -1;   0;-az" />
        <Axis NormVector = "   0;   1;-az" />
        <Axis NormVector = "   1;   0;-az" />
        <Axis NormVector = "   0;  -1;-az" />
        <Axis NormVector = "-ax2; ax2; az" />
        <Axis NormVector = " ax2; ax2; az" />
        <Axis NormVector = " ax2;-ax2; az" />
        <Axis NormVector = "-ax2;-ax2; az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " pX0;  pX0;  pZ0" />
                <Add Vector = " pX0; -pX0;  pZ0" />
                <Add Vector = "-pX0; -pX0;  pZ0" />
                <Add Vector = "-pX0;  pX0;  pZ0" />
                <Add Vector = " pX1;  pX1;  pZ1" />
                <Add Vector = " pX2;    0;  pZ2" />
                <Add Vector = " pX1; -pX1;  pZ1" />
                <Add Vector = "   0; -pX2;  pZ2" />
                <Add Vector = "-pX1; -pX1;  pZ1" />
                <Add Vector = "-pX2;    0;  pZ2" />

                <Add Vector = "-pX1;  pX1;  pZ1" />
                <Add Vector = "   0;  pX2;  pZ2" />
                <Add Vector = " pX3;  pX3;  pZ3" />
                <Add Vector = " pX4;    0; -pZ3" />
                <Add Vector = " pX3; -pX3;  pZ3" />
                <Add Vector = "   0; -pX4; -pZ3" />
                <Add Vector = "-pX3; -pX3;  pZ3" />
                <Add Vector = "-pX4;    0; -pZ3" />
                <Add Vector = "-pX3;  pX3;  pZ3" />
                <Add Vector = "   0;  pX4; -pZ3" />

                <Add Vector = " pX5;  pX5; -pZ2" />
                <Add Vector = " pX6;    0; -pZ1" />
                <Add Vector = " pX5; -pX5; -pZ2" />
                <Add Vector = "   0; -pX6; -pZ1" />
                <Add Vector = "-pX5; -pX5; -pZ2" />
                <Add Vector = "-pX6;    0; -pZ1" />
                <Add Vector = "-pX5;  pX5; -pZ2" />
                <Add Vector = "   0;  pX6; -pZ1" />
                <Add Vector = " pX7;    0; -pZ0" />
                <Add Vector = "   0; -pX7; -pZ0" />

                <Add Vector = "-pX7;    0; -pZ0" />
                <Add Vector = "   0;  pX7; -pZ0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "14;13;12;  4; 5; 6 " />
                <Face Color = "Colors[1]" VertexIndexes = "16;15;14;  6; 7; 8 " />
                <Face Color = "Colors[2]" VertexIndexes = "18;17;16;  8; 9;10 " />
                <Face Color = "Colors[3]" VertexIndexes = "12;19;18; 10;11; 4 " />

                <Face Color = "Colors[4]" VertexIndexes = "13;14;15; 23;22;21 " />
                <Face Color = "Colors[5]" VertexIndexes = "15;16;17; 25;24;23 " />
                <Face Color = "Colors[6]" VertexIndexes = "17;18;19; 27;26;25 " />
                <Face Color = "Colors[7]" VertexIndexes = "19;12;13; 21;20;27 " />

                <Face VertexIndexes = " 3; 2; 1; 0" />
                <Face VertexIndexes = " 0; 1; 5" />
                <Face VertexIndexes = " 1; 2; 7" />
                <Face VertexIndexes = " 2; 3; 9" />
                <Face VertexIndexes = " 3; 0;11" />
                <Face VertexIndexes = " 0; 5; 4;11" />
                <Face VertexIndexes = " 1; 7; 6; 5" />
                <Face VertexIndexes = " 2; 9; 8; 7" />
                <Face VertexIndexes = " 3;11;10; 9" />

                <Face VertexIndexes = " 28;29;30;31" />
                <Face VertexIndexes = " 29;28;22" />
                <Face VertexIndexes = " 30;29;24" />
                <Face VertexIndexes = " 31;30;26" />
                <Face VertexIndexes = " 28;31;20" />
                <Face VertexIndexes = " 20;21;22;28" />
                <Face VertexIndexes = " 22;23;24;29" />
                <Face VertexIndexes = " 24;25;26;30" />
                <Face VertexIndexes = " 26;27;20;31" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Hide Axis = "ax1" From = "1" />
            <Turn  Axis = "ax0" Layer = "0" Angle = "-A1" />
            <Split Axis = "ax1" From  = "1" />
            <Undo/>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Split" ax0 = "0" ax1 = "1" />
        <ExecMacro MacroName = "Split" ax0 = "1" ax1 = "2" />
        <ExecMacro MacroName = "Split" ax0 = "2" ax1 = "3" />
        <ExecMacro MacroName = "Split" ax0 = "3" ax1 = "0" />
        <ExecMacro MacroName = "Split" ax0 = "5" ax1 = "4" />
        <ExecMacro MacroName = "Split" ax0 = "6" ax1 = "5" />
        <ExecMacro MacroName = "Split" ax0 = "7" ax1 = "6" />
        <ExecMacro MacroName = "Split" ax0 = "4" ax1 = "7" />
    </Figure>
</xml>
