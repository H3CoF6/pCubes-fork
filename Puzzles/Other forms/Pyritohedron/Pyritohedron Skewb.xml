<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyritohedron Skewb</Name>
        <Menu>Other forms\Pyritohedron\Pyritohedron Skewb</Menu>
        <Menu>Other forms\Skewb variants\Pyritohedron Skewb</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-29</Added>
        <Link></Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clLightBlue    := '2828FF';
        clBlue         := '0000A0';
        clBrown        := '800000';
        clOrange       := 'FF6000';
        clLightViolett := 'FF0080';
        clRed          := 'FF0000';
        clLightGreen   := '00FF00';
        clGreen        := '008000';
        clViolett      := '800080';
        clCyan         := '00DCB4';
        clWhite        := 'FFFFFF';

        R := 0.8;

        k := 0.77;
        b := (R * k);
        c := (R * sqrt(3 / 4 - k^2));
        a := (R * k^2 / (2 * k - sqrt(3 / 4 - k^2)));
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; c; b" />
                <Add Vector = " 0;-c; b" />
                <Add Vector = " 0;-c;-b" />
                <Add Vector = " 0; c;-b" />

                <Add Vector = " c; b; 0" />
                <Add Vector = "-c; b; 0" />
                <Add Vector = "-c;-b; 0" />
                <Add Vector = " c;-b; 0" />

                <Add Vector = " b; 0; c" />
                <Add Vector = " b; 0;-c" />
                <Add Vector = "-b; 0;-c" />
                <Add Vector = "-b; 0; c" />

                <Add Vector = " a; a; a" />
                <Add Vector = " a; a;-a" />
                <Add Vector = " a;-a; a" />
                <Add Vector = " a;-a;-a" />
                <Add Vector = "-a; a; a" />
                <Add Vector = "-a; a;-a" />
                <Add Vector = "-a;-a; a" />
                <Add Vector = "-a;-a;-a" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = "1;18;6;7;14" />
                <Face Color = "clBrown       " VertexIndexes = "0;12;4;5;16" />
                <Face Color = "clCyan        " VertexIndexes = "2;15;7;6;19" />
                <Face Color = "clLightBlue   " VertexIndexes = "3;17;5;4;13" />
                <Face Color = "clLightViolett" VertexIndexes = "7;15;9;8;14" />
                <Face Color = "clLightGreen  " VertexIndexes = "4;12;8;9;13" />
                <Face Color = "clGreen       " VertexIndexes = "6;18;11;10;19" />
                <Face Color = "clViolett     " VertexIndexes = "5;17;10;11;16" />
                <Face Color = "clYellow      " VertexIndexes = "0;1;14;8;12" />
                <Face Color = "clRed         " VertexIndexes = "1;0;16;11;18" />
                <Face Color = "clOrange      " VertexIndexes = "2;3;13;9;15" />
                <Face Color = "clWhite       " VertexIndexes = "3;2;19;10;17" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
