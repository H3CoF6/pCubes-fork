<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Vulcano</Name>
        <Menu>Other forms\Cross\Vulcano</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-05-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1724</Link>
    </Interface>

    <Script>
        clRed := 'C80000';
        clGreen := '009600';
        clBlue := '0000C8';
        clYellow := 'EDFF11';

        N := 6;

        W := 0.75;
        W1 := W * (N - 2) / N;
        W2 := W * (N - 4) / N;

        D0 := -sqrt(3) / 3 * W;
        D := -4 * D0 / N;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D; D0 + 3*D" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W2; -W1; -W1" />
                <Add Vector = " W1;  W2; -W1" />
                <Add Vector = " W1; -W1;  W2" />
                <Add Vector = "-W2; -W2; -W2" />
                <Add Vector = " W2;  W2; -W2" />
                <Add Vector = " W2; -W2;  W2" />
            </Vertices>
            <Faces>
                <Face Color =  "clGreen" VertexIndexes = "0;1;2" />
                <Face Color =    "clRed" VertexIndexes = "0;2;5;3" />
                <Face Color = "clYellow" VertexIndexes = "2;1;4;5" />
                <Face Color =   "clBlue" VertexIndexes = "1;0;3;4" />
                <Face                    VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = " W2; -W1;  W1" />
                <Add Vector = "-W1;  W2;  W1" />
                <Add Vector = "-W1; -W1; -W2" />
                <Add Vector = " W2; -W2;  W2" />
                <Add Vector = "-W2;  W2;  W2" />
                <Add Vector = "-W2; -W2; -W2" />
            </Vertices>
            <Faces>
                <Face Color =    "clRed" VertexIndexes = "0;1;2" />
                <Face Color =  "clGreen" VertexIndexes = "0;2;5;3" />
                <Face Color =   "clBlue" VertexIndexes = "2;1;4;5" />
                <Face Color = "clYellow" VertexIndexes = "1;0;3;4" />
                <Face                    VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = " W2;  W1; -W1" />
                <Add Vector = "-W1; -W2; -W1" />
                <Add Vector = "-W1;  W1;  W2" />
                <Add Vector = " W2;  W2; -W2" />
                <Add Vector = "-W2; -W2; -W2" />
                <Add Vector = "-W2;  W2;  W2" />
            </Vertices>
            <Faces>
                <Face Color =   "clBlue" VertexIndexes = "0;1;2" />
                <Face Color = "clYellow" VertexIndexes = "0;2;5;3" />
                <Face Color =    "clRed" VertexIndexes = "2;1;4;5" />
                <Face Color =  "clGreen" VertexIndexes = "1;0;3;4" />
                <Face                    VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-W2;  W1;  W1" />
                <Add Vector = " W1; -W2;  W1" />
                <Add Vector = " W1;  W1; -W2" />
                <Add Vector = "-W2;  W2;  W2" />
                <Add Vector = " W2; -W2;  W2" />
                <Add Vector = " W2;  W2; -W2" />
            </Vertices>
            <Faces>
                <Face Color = "clYellow" VertexIndexes = "0;1;2" />
                <Face Color =   "clBlue" VertexIndexes = "0;2;5;3" />
                <Face Color =  "clGreen" VertexIndexes = "2;1;4;5" />
                <Face Color =    "clRed" VertexIndexes = "1;0;3;4" />
                <Face                    VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "W2; -W2; W2" />
                <Add Vector = "-W2; W2; W2" />
                <Add Vector = "W2; W2; -W2" />
                <Add Vector = "-W2; -W2; -W2" />
            </Vertices>
            <Faces>
                <Face VertexIndexes = "0;1;3" />
                <Face VertexIndexes = "1;2;3" />
                <Face VertexIndexes = "0;3;2" />
                <Face VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

    </Figure>
</xml>
