<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octrignis</Name>
        <Menu>Other forms\Cross\Octrignis</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3082</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 8;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <HideContaining Vectors = "Cx; Cy; Cz" />
        <RemoveAllVisible/>

        <LoadFrom File = "Figures\Octahedron.xml" />
        <Split Color1 = "Colors[4]" Axis = "0" From = "1" />
        <Split Color2 = "Colors[2]" Axis = "0" From = "2" />
        <Split Color1 = "Colors[5]" Axis = "1" From = "1" />
        <Split Color2 = "Colors[3]" Axis = "1" From = "2" />
        <Split Color1 = "Colors[6]" Axis = "2" From = "1" />
        <Split Color2 = "Colors[0]" Axis = "2" From = "2" />
        <Split Color1 = "Colors[7]" Axis = "3" From = "1" />
        <Split Color2 = "Colors[1]" Axis = "3" From = "2" />
        <HideContaining Vectors = "Ex; Ey; Ez" />
        <RemoveAllVisible/>
        <ShowAll/>

        <R1emoveGrayParts/>
    </Figure>
</xml>
