<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-Square-1</Name>
        <Menu>Other forms\Cross\X-Square-1</Menu>
        <Inventor>CME</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-01-01</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=34058</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.55;

        W1 := W * 0.6;
        W2 := W * 1.0;
        W3 := W * 0.54;

        D := W1;

        delta := 0.001;
    </Script>

    <Axes TurningAngles = "Pi/12; Pi/2; Pi/2; Pi/12" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " -W2; -W3; -W3" />
                <Add Vector = " -W2; -W3;  W3" />
                <Add Vector = " -W2;  W3; -W3" />
                <Add Vector = " -W2;  W3;  W3" />
                <Add Vector = "  W2; -W3; -W3" />
                <Add Vector = "  W2; -W3;  W3" />
                <Add Vector = "  W2;  W3; -W3" />
                <Add Vector = "  W2;  W3;  W3" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <RemoveContaining Vector = "  0;  0; 0" />

        <Part>
            <Vertices>
                <Add Vector = " -W3; -W2; -W3" />
                <Add Vector = " -W3; -W2;  W3" />
                <Add Vector = " -W3;  W2; -W3" />
                <Add Vector = " -W3;  W2;  W3" />
                <Add Vector = "  W3; -W2; -W3" />
                <Add Vector = "  W3; -W2;  W3" />
                <Add Vector = "  W3;  W2; -W3" />
                <Add Vector = "  W3;  W2;  W3" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "3" />
        <RemoveContaining Vector = "  0;  0; 0" />
        <HideAll/>

        <Part>
            <Vertices>
                <Add Vector = " -W1; -W1; -W1 - delta" />
                <Add Vector = " -W1; -W1;  W1 + delta" />
                <Add Vector = " -W1;  W1; -W1 - delta" />
                <Add Vector = " -W1;  W1;  W1 + delta" />
                <Add Vector = "  W1; -W1; -W1 - delta" />
                <Add Vector = "  W1; -W1;  W1 + delta" />
                <Add Vector = "  W1;  W1; -W1 - delta" />
                <Add Vector = "  W1;  W1;  W1 + delta" />
            </Vertices>

            <Faces>
                <Face                    VertexIndexes = "1;0;4;5" />
                <Face                    VertexIndexes = "2;3;7;6" />
                <Face                    VertexIndexes = "0;1;3;2" />
                <Face                    VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Axis = "2" From = "2" />
        <ShowAll/>

        <Turn Axis = "0" Layer = "0" Angle = "Pi/12" />
        <Turn Axis = "0" Layer = "3" Angle = "-Pi/12" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Layer = "0" Angle = "Pi/3" />
        <Turn Axis = "0" Layer = "3" Angle = "-Pi/3" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Layer = "0" Angle = "Pi/6" />
        <Turn Axis = "0" Layer = "3" Angle = "-Pi/6" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "0" Layer = "0" Angle = "Pi/3" />
        <Turn Axis = "0" Layer = "3" Angle = "-Pi/3" />
        <Split Axis = "1" From = "2" />
        <Undo Repeat = "8" />

        <Turn Axis = "1" Layer = "0" Angle = "Pi/12" />
        <Turn Axis = "1" Layer = "3" Angle = "-Pi/12" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Layer = "0" Angle = "Pi/3" />
        <Turn Axis = "1" Layer = "3" Angle = "-Pi/3" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Layer = "0" Angle = "Pi/6" />
        <Turn Axis = "1" Layer = "3" Angle = "-Pi/6" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Layer = "0" Angle = "Pi/3" />
        <Turn Axis = "1" Layer = "3" Angle = "-Pi/3" />
        <Split Axis = "0" From = "2" />
        <Undo Repeat = "8" />
    </Figure>
</xml>
