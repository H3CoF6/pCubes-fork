<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentaflake AC</Name>
        <Menu>Other forms\Tricky Disky\Pentaflake AC</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := '008800'; // clGreen
        Colors[1] := 'DD0000'; // clRed
        Colors[2] := 'FFFF00'; // clYellow
        Colors[3] := '00BBFF'; // clLightBlue
        Colors[4] := '7700DD'; // clViolett

        Colors[6] := '0000EE'; // clBlue
        Colors[7] := 'FF6600'; // clOrange

        R := 0.4;
        H := R * 0.32;
        HC := H * 1.002;

        R1 := R * 1.275;
        R2 := R * 2.025;

        RC := R * 0.09;
        RC1  := R * 0.29;
        RC2 := R * 0.425;
        RCut := R * 0.13;

        for i := 0 to 39 do begin
            x[i] := R * cos(2 * Pi / 40 * (i+10));
            y[i] := R * sin(2 * Pi / 40 * (i+10));
        end;

        for i := 0 to 4 do begin
            ax[i] := cos(2*Pi / 5 * (i+0.25));
            ay[i] := sin(2*Pi / 5 * (i+0.25));
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "0;Pi/2" PlaneDistances = "R1" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
        <Axis NormVector = "ax[3]; ay[3]; 0" />
        <Axis NormVector = "ax[4]; ay[4]; 0" />
    </Axes>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "Pi/5" />
        <Macro Name = "AddSector" >
            <Cylinder Radius = "RC1" Color = "Colors[i]">
                <Base X = "0" Y = "-R1" Z = "0" Color = "Colors[i]"/>
                <Top  X = "0" Y = "-R2" Z = "0" Color = "Colors[i]"/>
            </Cylinder>

            <Cut Color = "Colors[7]"> <Plane NormVector = "0; 0; 1" NormDistance = "-RCut" /> </Cut>
            <Cut Color = "Colors[6]"> <Plane NormVector = "0; 0;-1" NormDistance = "-RCut" /> </Cut>
            <Split> <Plane NormVector = "1; 0; 0" /> </Split>

            <Cylinder Radius = "RC" Base = "0;-R; 0" Top = "0; -R1; 0" />
            <SplitByAxes/>
            <Turn NormVector = "0; 0; 1" Angle = "2*Pi/5" />
            <HideAll/>

            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddSector" i = "0" Repeat = "5" />

        <Turn NormVector = "0; 0; 1" Angle = "-Pi/5" />

        <ShowAll/>

        <Circle Radius = "RC2" Color = "Colors[6]" Center = "0; 0; HC" />
        <Circle Radius = "RC2" Color = "Colors[7]" Center = "0; 0;-HC" />

        <HideAll/>

        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "0; 0; H" />
            <Vertices Vectors = "0; 0;-H" />
            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "FromTo(0,8);80"     InvisibleEdges = "768" />
                <Face Color = "Colors[0]" VertexIndexes = "FromTo(8,16);80"    InvisibleEdges = "768" />
                <Face Color = "Colors[4]" VertexIndexes = "FromTo(16,24);80"   InvisibleEdges = "768" />
                <Face Color = "Colors[3]" VertexIndexes = "FromTo(24,32);80"   InvisibleEdges = "768" />
                <Face Color = "Colors[2]" VertexIndexes = "FromTo(32,39);0;80" InvisibleEdges = "768" />

                <Face Color = "Colors[1]" VertexIndexes = "40;41; 1; 0" InvisibleEdges = "10" />
