                <Face Color = "Colors[2]" VertexIndexes = "78;79;39;38" InvisibleEdges = "10" />
                <Face Color = "Colors[2]" VertexIndexes = "79;40; 0;39" InvisibleEdges = "10" />

                <Face Color = "Colors[2]" VertexIndexes = "40;FromTo(79,72);81" InvisibleEdges = "768" />
                <Face Color = "Colors[3]" VertexIndexes = "FromTo(72,64);81"    InvisibleEdges = "768" />
                <Face Color = "Colors[4]" VertexIndexes = "FromTo(64,56);81"    InvisibleEdges = "768" />
                <Face Color = "Colors[0]" VertexIndexes = "FromTo(56,48);81"    InvisibleEdges = "768" />
                <Face Color = "Colors[1]" VertexIndexes = "FromTo(48,40);81"    InvisibleEdges = "768" />
            </Faces>
        </Part>

        <ShowAll/>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
