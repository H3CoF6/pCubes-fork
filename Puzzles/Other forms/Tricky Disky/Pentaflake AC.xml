                <Face Color = "Colors[0]" VertexIndexes = "55;56;16;15" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "56;57;17;16" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "57;58;18;17" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "58;59;19;18" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "59;60;20;19" InvisibleEdges = "10" />
                <Face Color = "Colors[4]" VertexIndexes = "60;61;21;20" InvisibleEdges = "10" />
