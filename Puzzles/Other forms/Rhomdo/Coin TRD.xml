<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Coin TRD</Name>
        <Menu>Other forms\Rhomdo\Coin TRD</Menu>
        <Inventor>Linxiao Xu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7958</Link>
    </Interface>

    <Script>
        Colors[ 0] := '00AA00'; // clGreen
        Colors[ 1] := '999999'; // clSilver
        Colors[ 2] := '8800CC'; // clViolett
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '222222'; // clBlack
        Colors[ 5] := '00FF00'; // clLightGreen
        Colors[ 6] := 'FF55CC'; // clLightViolett
        Colors[ 7] := 'FFFF00'; // clYellow
        Colors[ 8] := '0066FF'; // clLightBlue
        Colors[ 9] := '0011EE'; // clBlue
        Colors[10] := 'FFAA00'; // clGold
        Colors[11] := 'FF6600'; // clOrange

        R := 0.6;
        H2 := R / sqrt(8);
        H0 := H2 * 3;
        H1 := H2 * 2;

        D := R * sqrt(3) / 2;

        for i := 0 to 2 do begin
            x1[i] := R * cos(Pi * 2 / 3 * i + Pi / 3);
            y1[i] :=-R * sin(Pi * 2 / 3 * i + Pi / 3);
            x2[i] := R * cos(Pi * 2 / 3 * i);
            y2[i] :=-R * sin(Pi * 2 / 3 * i);

            ax[i] :=-sin(Pi * 2 / 3 * i);
            ay[i] := cos(Pi * 2 / 3 * i);
        end;

        az := R * sqrt(2);

        A := Arccos(1/3);

        RC := R * 0.46;
        KC := 1.025;

        C1 := R * sqrt(3) / 2;
        C2 := 1/2;

        D1 := R * sqrt(8) / 3;
        D2 := R * sqrt(2/3);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-Pi+A; -A; 0; A; Pi-A" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "x2[0]; y2[0]; az" />
        <Axis NormVector = "x2[1]; y2[1]; az" />
        <Axis NormVector = "x2[2]; y2[2]; az" />
        <Axis NormVector = "x2[0]; y2[0];-az" />
        <Axis NormVector = "x2[1]; y2[1];-az" />
        <Axis NormVector = "x2[2]; y2[2];-az" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D1" FixedLayers = "0" >
        <Axis NormVector = "x2[0]; y2[0]; H2" />
        <Axis NormVector = "x2[1]; y2[1]; H2" />
        <Axis NormVector = "x2[2]; y2[2]; H2" />
        <Axis NormVector = "x2[0]; y2[0];-H2" />
        <Axis NormVector = "x2[1]; y2[1];-H2" />
        <Axis NormVector = "x2[2]; y2[2];-H2" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = "x1[0]; y1[0]; H1" />
        <Axis NormVector = "x1[1]; y1[1]; H1" />
        <Axis NormVector = "x1[2]; y1[2]; H1" />
        <Axis NormVector = "x1[0]; y1[0];-H1" />
        <Axis NormVector = "x1[1]; y1[1];-H1" />
        <Axis NormVector = "x1[2]; y1[2];-H1" />
    </Axes>

    <Figure>
        <Macro Name = "Body">
            <Part>
                <Vertices Vectors = " 0;  0; H0" />
                <Vertices Vectors = "x1; y1; H1" />
                <Vertices Vectors = "x2; y2; H2" />
                <Vertices Vectors = "x2; y2;-H2" />
                <Vertices Vectors = "x1; y1;-H1" />
                <Vertices Vectors = " 0;  0;-H0" />

                <Faces>
                    <Face Color = "Colors[ 0]" VertexIndexes = " 0; 3; 6; 2" />
                    <Face Color = "Colors[ 1]" VertexIndexes = " 0; 1; 4; 3" />
                    <Face Color = "Colors[ 2]" VertexIndexes = " 0; 2; 5; 1" />
                    <Face Color = "Colors[ 3]" VertexIndexes = " 2; 6; 9;11" />
                    <Face Color = "Colors[ 4]" VertexIndexes = " 3;12; 9; 6" />
                    <Face Color = "Colors[ 5]" VertexIndexes = " 3; 4; 7;12" />
                    <Face Color = "Colors[ 6]" VertexIndexes = " 1;10; 7; 4" />
                    <Face Color = "Colors[ 7]" VertexIndexes = " 1; 5; 8;10" />
                    <Face Color = "Colors[ 8]" VertexIndexes = " 2;11; 8; 5" />
                    <Face Color = "Colors[ 9]" VertexIndexes = "13;11; 9;12" />
                    <Face Color = "Colors[10]" VertexIndexes = "13;12; 7;10" />
                    <Face Color = "Colors[11]" VertexIndexes = "13;10; 8;11" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Body" />
        <SplitByAxes/>
        <RemoveContaining Vector = " 0; 0; 0" />

        <Macro Name = "AddCircle" >
            <Cylinder Radius = "RC" Color = "Colors[cl]" >
                <Base X = "x   " Y = "y   " Z = "z   " />
                <Top  X = "x*KC" Y = "y*KC" Z = "z*KC" Color = "Colors[cl]" />
            </Cylinder>
        </Macro>

        <ExecMacro MacroName = "AddCircle" cl = " 4" x = " ax[0]*C1" y = " ay[0]*C1" z = "0" />
        <ExecMacro MacroName = "AddCircle" cl = " 8" x = " ax[1]*C1" y = " ay[1]*C1" z = "0" />
        <ExecMacro MacroName = "AddCircle" cl = " 6" x = " ax[2]*C1" y = " ay[2]*C1" z = "0" />
        <ExecMacro MacroName = "AddCircle" cl = " 7" x = "-ax[0]*C1" y = "-ay[0]*C1" z = "0" />
        <ExecMacro MacroName = "AddCircle" cl = " 5" x = "-ax[1]*C1" y = "-ay[1]*C1" z = "0" />
        <ExecMacro MacroName = "AddCircle" cl = " 3" x = "-ax[2]*C1" y = "-ay[2]*C1" z = "0" />

        <ExecMacro MacroName = "AddCircle" cl = " 1" x = " x2[0]*C2" y = " y2[0]*C2" z = " az*C2" />
        <ExecMacro MacroName = "AddCircle" cl = " 2" x = " x2[1]*C2" y = " y2[1]*C2" z = " az*C2" />
        <ExecMacro MacroName = "AddCircle" cl = " 0" x = " x2[2]*C2" y = " y2[2]*C2" z = " az*C2" />
        <ExecMacro MacroName = "AddCircle" cl = "10" x = " x2[0]*C2" y = " y2[0]*C2" z = "-az*C2" />
        <ExecMacro MacroName = "AddCircle" cl = "11" x = " x2[1]*C2" y = " y2[1]*C2" z = "-az*C2" />
        <ExecMacro MacroName = "AddCircle" cl = " 9" x = " x2[2]*C2" y = " y2[2]*C2" z = "-az*C2" />

        <SplitByAxes/>
        <InvertVisibility/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>

        <ExecMacro MacroName = "Body" />
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>
</xml>
