<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhomdo Transformer</Name>
        <Menu>Other forms\Rhomdo\Rhomdo Transformer</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4866</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        K := 1.2;
        p0 := K * 3 / 2 / sqrt(8);
        p1 := K / sqrt(8);
        p2 := K / 2 / sqrt(8);
        pA := K / 2;
        pB1:= K / 4;
        pB2:= K * sqrt(3) / 4;

        nA := K * 3 / 8;
        nB := K * sqrt(3) / 8;
        nC := K * sqrt(3) / 4;
        nD := K / 8;
        nE := K / sqrt(8);
        nF := K / 4;

        D  := K * sqrt(3) / 6;

        A1 := Arccos(1/3);
        A2 := 2 * Arccos(1/3);
        A3 := Pi - A1;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles="-A3; -A2; -A1; 0; A1; A2; A3; Pi" PlaneDistances = "-D; D" FixedLayers = "1">
        <Axis NormVector = "  0; nC; 0" />
        <Axis NormVector = " nA; nB; 0" />
        <Axis NormVector = " nA;-nB; 0" />
        <Axis NormVector = " nF;  0; nE" />
        <Axis NormVector = "-nD;-nB; nE" />
        <Axis NormVector = "-nD; nB; nE" />
        <Axis NormVector = " nF;  0;-nE" />
        <Axis NormVector = "-nD;-nB;-nE" />
        <Axis NormVector = "-nD; nB;-nE" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "   0;   0; p0" />
        <Axis NormVector = "-pB1; pB2; p2" />
        <Axis NormVector = "  pA;   0; p2" />
        <Axis NormVector = "-pB1;-pB2; p2" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0;  p0" />

                <Add Vector = " -pA;    0;  p1" />
                <Add Vector = " pB1;  pB2;  p1" />
                <Add Vector = " pB1; -pB2;  p1" />

                <Add Vector = "-pB1;  pB2;  p2" />
                <Add Vector = "  pA;    0;  p2" />
                <Add Vector = "-pB1; -pB2;  p2" />

                <Add Vector = "-pB1;  pB2; -p2" />
                <Add Vector = "  pA;    0; -p2" />
                <Add Vector = "-pB1; -pB2; -p2" />

                <Add Vector = " -pA;    0; -p1" />
                <Add Vector = " pB1;  pB2; -p1" />
                <Add Vector = " pB1; -pB2; -p1" />

                <Add Vector = "   0;    0; -p0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = "0;2;4;1" />
                <Face Color = "clGreen       " VertexIndexes = "0;3;5;2" />
                <Face Color = "clViolett     " VertexIndexes = "0;1;6;3" />

                <Face Color = "clOrange      " VertexIndexes = "1;4;7;10" />
                <Face Color = "clRed         " VertexIndexes = "2;11;7;4" />
                <Face Color = "clWhite       " VertexIndexes = "2;5;8;11" />
                <Face Color = "clYellow      " VertexIndexes = "3;12;8;5" />
                <Face Color = "clCyan        " VertexIndexes = "3;6;9;12" />
                <Face Color = "clBrown       " VertexIndexes = "1;10;9;6" />

                <Face Color = "clLightBlue   " VertexIndexes = "13;10;7;11" />
                <Face Color = "clLightGreen  " VertexIndexes = "13;11;8;12" />
                <Face Color = "clLightViolett" VertexIndexes = "13;12;9;10" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />

        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "7" From = "2" />
        <Split Axis = "8" From = "2" />

        <Split Axis = "9" From = "1" />
        <Turn  Axis = "9" Angle ="pi/3" Layer = "0" />
        <Split Axis = "10" From = "1" />
        <Split Axis = "11" From = "1" />
        <Split Axis = "12" From = "1" />
        <Turn  Axis = "9" Angle ="-pi/3" Layer = "0" />
    </Figure>
</xml>
