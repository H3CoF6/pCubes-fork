<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hadron-DTR</Name>
        <Menu>Other forms\Rhomdo\Hadron-DTR</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-06-21</Added>
        <Link>http://twistypuzzles.com/museum/museum_showitem.php?pkey=8936</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        s2 := sqrt(2);
        s3 := sqrt(3);

        K  := 0.3;

        pA := K * 2;
        pB := K;
        pC := K * s3;

        H  := K * s2 * 3 / 2;
        H1 := H / 3;
        H2 := H * 2 / 3;

        D1 := 1.06 * K;
        D2 := 1.06 * K;

        A1 := ArcCos( 1 / 8);
        A2 := ArcCos(-3 / 4);

        for i := 0 to 2 do begin
            ax[i] := cos(2*Pi/3 * i);
            ay[i] := sin(2*Pi/3 * i);
            aax[i] := -ax[i];
            aay[i] := -ay[i];
        end;
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D1" NormVectors = "ax; ay; 0" />
    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D2" NormVectors = "aax; aay; s3/2" />
    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D2" NormVectors = "aax; aay;-s3/2" />

    <Figure>

        <Turn NormVector = "0;0;1" Angle = "Pi/3" />
        <Part>
            <Vertices>
                <Add Vector = "  0;  0;  H" />

                <Add Vector = "-pA;  0; H2" />
                <Add Vector = " pB; pC; H2" />
                <Add Vector = " pB;-pC; H2" />

                <Add Vector = "-pB; pC; H1" />
                <Add Vector = " pA;  0; H1" />
                <Add Vector = "-pB;-pC; H1" />

                <Add Vector = "-pB; pC;-H1" />
                <Add Vector = " pA;  0;-H1" />
                <Add Vector = "-pB;-pC;-H1" />

                <Add Vector = "-pA;  0;-H2" />
                <Add Vector = " pB; pC;-H2" />
                <Add Vector = " pB;-pC;-H2" />

                <Add Vector = "  0;  0; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = "0;2;4;1" />
                <Face Color = "clGreen       " VertexIndexes = "0;3;5;2" />
                <Face Color = "clViolett     " VertexIndexes = "0;1;6;3" />

                <Face Color = "clOrange      " VertexIndexes = "1;4;7;10" />
                <Face Color = "clRed         " VertexIndexes = "2;11;7;4" />
                <Face Color = "clWhite       " VertexIndexes = "2;5;8;11" />
                <Face Color = "clYellow      " VertexIndexes = "3;12;8;5" />
                <Face Color = "clCyan        " VertexIndexes = "3;6;9;12" />
                <Face Color = "clBrown       " VertexIndexes = "1;10;9;6" />

                <Face Color = "clLightBlue   " VertexIndexes = "13;10;7;11" />
                <Face Color = "clLightGreen  " VertexIndexes = "13;11;8;12" />
                <Face Color = "clLightViolett" VertexIndexes = "13;12;9;10" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
