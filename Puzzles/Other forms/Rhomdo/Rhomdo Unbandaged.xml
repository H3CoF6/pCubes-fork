<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhomdo Unbandaged</Name>
        <Menu>Other forms\Rhomdo\Rhomdo Unbandaged</Menu>
        <Inventor>Eric Vergo</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3117</Link>
    </Interface>

    <Script>
        Colors[ 0] := '0000A0'; // Blue
        Colors[ 1] := '008000'; // Green
        Colors[ 2] := '800080'; // Violett
        Colors[ 3] := 'FF6000'; // Orange
        Colors[ 4] := 'FF0000'; // Red
        Colors[ 5] := 'FFFFFF'; // White
        Colors[ 6] := 'FFFF00'; // Yellow
        Colors[ 7] := '00DCB4'; // Cyan
        Colors[ 8] := '800000'; // Brown
        Colors[ 9] := '2828FF'; // LightBlue
        Colors[10] := '00FF00'; // LightGreen
        Colors[11] := 'FF0080'; // LightViolett

        R := 0.6;
        H0 := R / sqrt(8);
        H1 := H0 * 2;
        H2 := H0 * 3;

        D := R / sqrt(3);

        for i := 0 to 2 do begin
            x1[i] := R * cos(Pi * 2 / 3 * i + Pi / 3);
            y1[i] :=-R * sin(Pi * 2 / 3 * i + Pi / 3);

            x2[i] := R * cos(Pi * 2 / 3 * i);
            y2[i] :=-R * sin(Pi * 2 / 3 * i);

            ax[i] :=-sin(Pi * 2 / 3 * i);
            ay[i] := cos(Pi * 2 / 3 * i);
        end;

        az := R * sqrt(2);

        A := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-2 * A; -Pi + A; -A; 0; A; Pi - A; A * 2; Pi" PlaneDistances = "-D; D" FixedLayers = "1" NormVectors = " ax; ay; 0" />
    <Axes TurningAngles = "Pi" JumbleAngle = "A" PlaneDistances = "D" FixedLayers = "0" NormVectors = " x2; y2; az" />
    <Axes TurningAngles = "Pi" JumbleAngle = "A" PlaneDistances = "D" FixedLayers = "0" NormVectors = " x2; y2;-az" />

    <Figure>
        <Part>
            <Vertices Vectors = " 0;  0; H2" />
            <Vertices Vectors = "x1; y1; H1" />
            <Vertices Vectors = "x2; y2; H0" />
            <Vertices Vectors = "x2; y2;-H0" />
            <Vertices Vectors = "x1; y1;-H1" />
            <Vertices Vectors = " 0;  0;-H2" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 3; 6; 2" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 1; 4; 3" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0; 2; 5; 1" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 2; 6; 9;11" />
                <Face Color = "Colors[ 4]" VertexIndexes = " 3;12; 9; 6" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 3; 4; 7;12" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 1;10; 7; 4" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 1; 5; 8;10" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 2;11; 8; 5" />
                <Face Color = "Colors[ 9]" VertexIndexes = "13;11; 9;12" />
                <Face Color = "Colors[10]" VertexIndexes = "13;12; 7;10" />
                <Face Color = "Colors[11]" VertexIndexes = "13;10; 8;11" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn  Axis = "ax1" Layer = "l1" Angle = "Pi" />
            <Turn  Axis = "ax2" Layer = "l2" Angle = "a2" />
            <Split Axis = "ax3" From  = "f3" />
            <Undo Repeat = "2" />
        </Macro>

        <Script> l1 := 0; l2 := 2; f3 := 1; </Script>
        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "1" ax3 = "0" a2 = "-A" />
        <ExecMacro MacroName = "Split" ax1 = "0" ax2 = "1" ax3 = "0" a2 = " A" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "0" ax3 = "2" a2 = " A" />
        <ExecMacro MacroName = "Split" ax1 = "2" ax2 = "0" ax3 = "2" a2 = "-A" />
        <ExecMacro MacroName = "Split" ax1 = "1" ax2 = "2" ax3 = "1" a2 = " A" />
        <ExecMacro MacroName = "Split" ax1 = "1" ax2 = "2" ax3 = "1" a2 = "-A" />
    </Figure>
</xml>
