                <Add Vector = "-pB1; -pB2; -p2" />

                <Add Vector = " -pA;    0; -p1" />
                <Add Vector = " pB1;  pB2; -p1" />
                <Add Vector = " pB1; -pB2; -p1" />

                <Add Vector = "   0;    0; -p0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = "0;2;4;1" />
                <Face Color = "clGreen       " VertexIndexes = "0;3;5;2" />
                <Face Color = "clViolett     " VertexIndexes = "0;1;6;3" />

                <Face Color = "clOrange      " VertexIndexes = "1;4;7;10" />
                <Face Color = "clRed         " VertexIndexes = "2;11;7;4" />
                <Face Color = "clWhite       " VertexIndexes = "2;5;8;11" />
                <Face Color = "clYellow      " VertexIndexes = "3;12;8;5" />
                <Face Color = "clCyan        " VertexIndexes = "3;6;9;12" />
                <Face Color = "clBrown       " VertexIndexes = "1;10;9;6" />

                <Face Color = "clLightBlue   " VertexIndexes = "13;10;7;11" />
                <Face Color = "clLightGreen  " VertexIndexes = "13;11;8;12" />
                <Face Color = "clLightViolett" VertexIndexes = "13;12;9;10" />
            </Faces>
        </Part>

