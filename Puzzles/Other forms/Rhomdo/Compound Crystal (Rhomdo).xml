    <Script>
        clYellow       := 'FFFF00';
        clOrange       := 'FF6000';
        clGreen        := '008000';
        clLightViolett := 'FF0080';
        clViolett      := '800080';
        clLightGreen   := '00FF00';
        clBlue         := '0000A0';
        clRed          := 'FF0000';
        clWhite        := 'FFFFFF';
        clLightBlue    := '2828FF';
        clBrown        := '800000';
        clCyan         := '00DCB4';

        K := 0.6;
        p0 := K * 3 / 2 / sqrt(2);
        p1 := K / sqrt(2);
        p2 := K / 2 / sqrt(2);
        pA := K;
        pB1:= K / 2;
        pB2:= K * sqrt(3) / 2;

        nA := K * 3 / 4;
        nB := K * sqrt(3) / 4;
        nC := K * sqrt(3) / 2;
        nD := K / 4;
        nE := K / sqrt(2);
        nF := K / 2;

        D1 := K * 7 / 6 / sqrt(2);
        D2 := K * sqrt(6) / 4;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; p0" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D1" FixedLayers = "0" >
        <Axis NormVector = "-pB1; pB2; p2" />
        <Axis NormVector = "  pA;   0; p2" />
        <Axis NormVector = "-pB1;-pB2; p2" />
        <Axis NormVector = "-pB1; pB2;-p2" />
        <Axis NormVector = "  pA;   0;-p2" />
        <Axis NormVector = "-pB1;-pB2;-p2" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = "-pA;   0; p1" />
        <Axis NormVector = "pB1; pB2; p1" />
        <Axis NormVector = "pB1;-pB2; p1" />
        <Axis NormVector = "-pA;   0;-p1" />
        <Axis NormVector = "pB1; pB2;-p1" />
        <Axis NormVector = "pB1;-pB2;-p1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0;  p0" />

                <Add Vector = " -pA;    0;  p1" />
                <Add Vector = " pB1;  pB2;  p1" />
                <Add Vector = " pB1; -pB2;  p1" />

                <Add Vector = "-pB1;  pB2;  p2" />
                <Add Vector = "  pA;    0;  p2" />
                <Add Vector = "-pB1; -pB2;  p2" />

                <Add Vector = "-pB1;  pB2; -p2" />
