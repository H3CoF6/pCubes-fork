<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Propello Tetrahedron Skewb</Name>
        <Menu>Other forms\Propellor Solids\Propello Tetrahedron\Propello Tetrahedron Skewb</Menu>
        <Menu>Other forms\Skewb variants\Propellor Solids\Propello Tetrahedron Skewb</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-29</Added>
        <Link></Link>
    </Interface>

    <Script>
        clCyan      := '00FFFF';
        clTeal      := '008080';
        clBlue      := '0000FF';
        clNavy      := '000080';
        clRed       := 'FF0000';
        clBrown     := '800000';
        clCoral     := 'FF7F50';
        clYellow    := 'FFFF00';
        clOlive     := '808000';
        clOrange    := 'FF6000';
        clLime      := '00FF00';
        clGreen     := '008000';
        clDarkGreen := '006400';
        clFuchsia   := 'FF00FF';
        clPurple    := '800080';
        clPink      := 'FF69B4';

        K  := 0.6;

        C0 := K * ((4 * (11 + 3 * sqrt(69)))^(1/3) - (4 * (3 * sqrt(69) - 11))^(1/3) - 1) / 3;
        C1 := K * ((4 * (25 + 3 * sqrt(69)))^(1/3) + (4 * (25 - 3 * sqrt(69)))^(1/3) - 5) / 3;
        C2 := K * ((4 * (371 + 33*sqrt(69)))^(1/3) + (4 * (371 - 33*sqrt(69)))^(1/3) - 1) / 33;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C0;  K" />
                <Add Vector = " C1;-C0; -K" />
                <Add Vector = "-C1;-C0;  K" />
                <Add Vector = "-C1; C0; -K" />
                <Add Vector = "  K; C1; C0" />
                <Add Vector = "  K;-C1;-C0" />
                <Add Vector = " -K;-C1; C0" />
                <Add Vector = " -K; C1;-C0" />
                <Add Vector = " C0;  K; C1" />
                <Add Vector = " C0; -K;-C1" />
                <Add Vector = "-C0; -K; C1" />
                <Add Vector = "-C0;  K;-C1" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow   " VertexIndexes = "12; 0; 2;10" />
                <Face Color = "clOrange   " VertexIndexes = "12;10; 9; 5" />
                <Face Color = "clOlive    " VertexIndexes = "12; 5; 4; 0" />
                <Face Color = "clLime     " VertexIndexes = "13; 1; 3;11" />
                <Face Color = "clGreen    " VertexIndexes = "13;11; 8; 4" />
                <Face Color = "clDarkGreen" VertexIndexes = "13; 4; 5; 1" />
                <Face Color = "clRed      " VertexIndexes = "14; 2; 0; 8" />
                <Face Color = "clBrown    " VertexIndexes = "14; 8;11; 7" />
                <Face Color = "clCoral    " VertexIndexes = "14; 7; 6; 2" />
                <Face Color = "clFuchsia  " VertexIndexes = "15; 3; 1; 9" />
                <Face Color = "clPurple   " VertexIndexes = "15; 9;10; 6" />
                <Face Color = "clPink     " VertexIndexes = "15; 6; 7; 3" />
                <Face Color = "clCyan     " VertexIndexes = " 0; 4; 8" />
                <Face Color = "clTeal     " VertexIndexes = " 1; 5; 9" />
                <Face Color = "clBlue     " VertexIndexes = " 2; 6;10" />
                <Face Color = "clNavy     " VertexIndexes = " 3; 7;11" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
