<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Propello 2x2x2</Name>
        <Menu>Other forms\Propellor Solids\Propello 2x2x2</Menu>
        <Menu>Other forms\2x2x2 variants\Propello 2x2x2</Menu>
        <Inventor>not invented</Inventor>
        <Added>2020-06-29</Added>
        <Programmer>Skallos</Programmer>
        <Link></Link>
    </Interface>

    <Script>
        clWhite        := 'F0F0F0';
        clCyan         := '00FFFF';
        clDeepSky      := '00BFFF';
        clTeal         := '008080';
        clBlue         := '0000FF';
        clCoral        := 'FF7F50';
        clRed          := 'FF0000';
        clCrimson      := 'DC143C';
        clIndian       := 'CD5C5C';
        clBrown        := '800000';
        clSeaGreen     := '2E8B57';
        clAquaMarine   := '66CDAA';
        clDarkSeaGreen := '8FBC8F';
        clYellow       := 'FFFF00';
        clOrange       := 'FF6000';
        clKhaki        := 'F0E68C';
        clGolden       := 'DDBB20';
        clOlive        := '808000';
        clGreenYellow  := 'ADFF2F';
        clLime         := '00FF00';
        clGreen        := '008000';
        clDarkGreen    := '006400';
        clPink         := 'FF69B4';
        clFuchsia      := 'FF00FF';
        clPale         := 'D07090';
        clOrchid       := 'DA70D6';
        clPurple       := '800080';
        clIndigo       := '4B0082';
        clDarkSlate    := '483D8B';
        clSlate        := '6A5ACD';

        K  := 0.55;

        // Propello Cube (canonical)

        C0 := K * 0.169629045867;
        C1 := K * 0.481689876410;
        C2 := K * 0.587800511503;
        C3 := K * 0.932523685962;
    </Script>


    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "1;0;0" /> <!-- blue   -->
        <Axis NormVector = "0;1;0" /> <!-- orange -->
        <Axis NormVector = "0;0;1" /> <!-- white  -->
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C0; C3" />
                <Add Vector = " C1;-C0;-C3" />
                <Add Vector = "-C1;-C0; C3" />
                <Add Vector = "-C1; C0;-C3" />
                <Add Vector = " C3; C1; C0" />
                <Add Vector = " C3;-C1;-C0" />
                <Add Vector = "-C3;-C1; C0" />
                <Add Vector = "-C3; C1;-C0" />
                <Add Vector = " C0; C3; C1" />
                <Add Vector = " C0;-C3;-C1" />
                <Add Vector = "-C0;-C3; C1" />
                <Add Vector = "-C0; C3;-C1" />
                <Add Vector = " C0;-C1; C3" />
                <Add Vector = " C0; C1;-C3" />
                <Add Vector = "-C0; C1; C3" />
                <Add Vector = "-C0;-C1;-C3" />
                <Add Vector = " C3;-C0; C1" />
                <Add Vector = " C3; C0;-C1" />
                <Add Vector = "-C3; C0; C1" />
                <Add Vector = "-C3;-C0;-C1" />
                <Add Vector = " C1;-C3; C0" />
                <Add Vector = " C1; C3;-C0" />
                <Add Vector = "-C1; C3; C0" />
                <Add Vector = "-C1;-C3;-C0" />
                <Add Vector = " C2; C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2;-C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2; C2;-C2" />
                <Add Vector = "-C2;-C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite       " VertexIndexes = " 2;12; 0;14" />
                <Face Color = "clYellow      " VertexIndexes = " 3;13; 1;15" />
                <Face Color = "clBlue        " VertexIndexes = " 4;16; 5;17" />
                <Face Color = "clGreen       " VertexIndexes = " 7;19; 6;18" />
                <Face Color = "clOrange      " VertexIndexes = " 8;21;11;22" />
                <Face Color = "clRed         " VertexIndexes = " 9;20;10;23" />
                <Face Color = "clPink        " VertexIndexes = "24; 0;16; 4" />
                <Face Color = "clPurple      " VertexIndexes = "24; 4;21; 8" />
                <Face Color = "clFuchsia     " VertexIndexes = "24; 8;14; 0" />
                <Face Color = "clSeaGreen    " VertexIndexes = "25;13;11;21" />
                <Face Color = "clDarkSeaGreen" VertexIndexes = "25;21; 4;17" />
                <Face Color = "clAquaMarine  " VertexIndexes = "25;17; 1;13" />
                <Face Color = "clGreenYellow " VertexIndexes = "26;12;10;20" />
                <Face Color = "clLime        " VertexIndexes = "26;20; 5;16" />
                <Face Color = "clDarkGreen   " VertexIndexes = "26;16; 0;12" />
                <Face Color = "clIndigo      " VertexIndexes = "27; 1;17; 5" />
                <Face Color = "clDarkSlate   " VertexIndexes = "27; 5;20; 9" />
                <Face Color = "clSlate       " VertexIndexes = "27; 9;15; 1" />
                <Face Color = "clCrimson     " VertexIndexes = "28;14; 8;22" />
                <Face Color = "clCoral       " VertexIndexes = "28;22; 7;18" />
                <Face Color = "clIndian      " VertexIndexes = "28;18; 2;14" />
                <Face Color = "clCyan        " VertexIndexes = "29; 3;19; 7" />
                <Face Color = "clDeepSky     " VertexIndexes = "29; 7;22;11" />
                <Face Color = "clTeal        " VertexIndexes = "29;11;13; 3" />
                <Face Color = "clKhaki       " VertexIndexes = "30; 2;18; 6" />
                <Face Color = "clGolden      " VertexIndexes = "30; 6;23;10" />
                <Face Color = "clOlive       " VertexIndexes = "30;10;12; 2" />
                <Face Color = "clPale        " VertexIndexes = "31;15; 9;23" />
                <Face Color = "clOrchid      " VertexIndexes = "31;23; 6;19" />
                <Face Color = "clBrown       " VertexIndexes = "31;19; 3;15" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
