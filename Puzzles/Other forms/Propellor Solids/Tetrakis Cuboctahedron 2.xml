<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrakis Cuboctahedron 2</Name>
        <Menu>Other forms\Propellor Solids\Tetrakis Cuboctahedron 2</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-08-27</Added>
        <Link>http://dmccooey.com/polyhedra/TetrakisCuboctahedron.html</Link>
    </Interface>

    <Script>
        clPurple      := '800080';
        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clOrchid      := 'DA70D6';
        clKhaki       := 'F0E68C';
        clGolden      := 'DDBB20';
        clOlive       := '808000';
        clCoral       := 'FF7F50';
        clGainsboro   := 'C0C0C0';
        clSilver      := 'A0A0A0';
        clGray        := '707070';
        clBlack       := '202020';
        clGreenYellow := 'ADFF2F';
        clDarkGreen   := '006400';
        clSea         := '3cb371';
        clSeaGreen    := '2E8B57';
        clCrimson     := 'DC143C';
        clIndian      := 'CD5C5C';
        clBrown       := '800000';
        clPale        := 'D07090';
        clDeepSky     := '00BFFF';
        clTeal        := '008080';
        clNavy        := '000080';
        clAquaMarine  := '66CDAA';
        clLime        := '00FF00';
        clRed         := 'FF0000';
        clYellow      := 'FFFF00';
        clBlue        := '0000FF';
        clGreen       := '008000';
        clOrange      := 'FF6000';
        clCyan        := '00FFFF';
        clWhite       := 'F0F0F0';

        K  := 0.45;

// TetrakisCuboctahedron (canonical)

        C0 := K;
        C1 := K * (3 - sqrt(3));

        D := K * 0.927374983757683;

        s := 3.355301397608119909925; // s^3 - 3 * x^2 - 4 = 0    s := 1 + (3 - 2 sqrt(2))^(1/3) + (3 + 2 sqrt(2))^(1/3)

        A1 := 2.31535958038656406;  //  2* a^3 - 3* a^2 + 2 = 0    a=-0.677650698804059954  cos(A1) = a
        A2 := 2 * Pi - 2 * A1;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " s; 1; 1" />
        <Axis NormVector = " s;-1; 1" />
        <Axis NormVector = " s; 1;-1" />
        <Axis NormVector = " s;-1;-1" />

        <Axis NormVector = " 1; s; 1" />
        <Axis NormVector = "-1; s; 1" />
        <Axis NormVector = " 1; s;-1" />
        <Axis NormVector = "-1; s;-1" />

        <Axis NormVector = " 1; 1; s" />
        <Axis NormVector = "-1; 1; s" />
        <Axis NormVector = " 1;-1; s" />
        <Axis NormVector = "-1;-1; s" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C1" />
                <Add Vector = "  0;  0;-C1" />
                <Add Vector = " C1;  0;  0" />
                <Add Vector = "-C1;  0;  0" />
                <Add Vector = "  0; C1;  0" />
                <Add Vector = "  0;-C1;  0" />
                <Add Vector = " C0;  0; C0" />
                <Add Vector = " C0;  0;-C0" />
                <Add Vector = "-C0;  0; C0" />
                <Add Vector = "-C0;  0;-C0" />
                <Add Vector = " C0; C0;  0" />
                <Add Vector = " C0;-C0;  0" />
                <Add Vector = "-C0; C0;  0" />
                <Add Vector = "-C0;-C0;  0" />
                <Add Vector = "  0; C0; C0" />
                <Add Vector = "  0; C0;-C0" />
                <Add Vector = "  0;-C0; C0" />
                <Add Vector = "  0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clPurple     " VertexIndexes = "0; 6;14" />
                <Face Color = "clPink       " VertexIndexes = "0;14; 8" />
                <Face Color = "clFuchsia    " VertexIndexes = "0; 8;16" />
                <Face Color = "clOrchid     " VertexIndexes = "0;16; 6" />
                <Face Color = "clKhaki      " VertexIndexes = "1; 9;15" />
                <Face Color = "clGolden     " VertexIndexes = "1;15; 7" />
                <Face Color = "clOlive      " VertexIndexes = "1; 7;17" />
                <Face Color = "clCoral      " VertexIndexes = "1;17; 9" />
                <Face Color = "clGainsboro  " VertexIndexes = "2; 7;10" />
                <Face Color = "clSilver     " VertexIndexes = "2;10; 6" />
                <Face Color = "clGray       " VertexIndexes = "2; 6;11" />
                <Face Color = "clBlack      " VertexIndexes = "2;11; 7" />
                <Face Color = "clGreenYellow" VertexIndexes = "3; 8;12" />
                <Face Color = "clDarkGreen  " VertexIndexes = "3;12; 9" />
                <Face Color = "clSea        " VertexIndexes = "3; 9;13" />
                <Face Color = "clSeaGreen   " VertexIndexes = "3;13; 8" />
                <Face Color = "clCrimson    " VertexIndexes = "4;10;15" />
                <Face Color = "clIndian     " VertexIndexes = "4;15;12" />
                <Face Color = "clBrown      " VertexIndexes = "4;12;14" />
                <Face Color = "clPale       " VertexIndexes = "4;14;10" />
                <Face Color = "clDeepSky    " VertexIndexes = "5;11;16" />
                <Face Color = "clTeal       " VertexIndexes = "5;16;13" />
                <Face Color = "clNavy       " VertexIndexes = "5;13;17" />
                <Face Color = "clAquaMarine " VertexIndexes = "5;17;11" />
                <Face Color = "clLime       " VertexIndexes = "6;10;14" />
                <Face Color = "clRed        " VertexIndexes = "7;11;17" />
                <Face Color = "clYellow     " VertexIndexes = "8;13;16" />
                <Face Color = "clBlue       " VertexIndexes = "9;12;15" />
                <Face Color = "clGreen      " VertexIndexes = "7;15;10" />
                <Face Color = "clOrange     " VertexIndexes = "6;16;11" />
                <Face Color = "clCyan       " VertexIndexes = "8;14;12" />
                <Face Color = "clWhite      " VertexIndexes = "9;17;13" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
