<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrakis Cuboctahedron</Name>
        <Menu>Other forms\Propellor Solids\Tetrakis Cuboctahedron</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-02-02</Added>
        <Link>http://dmccooey.com/polyhedra/TetrakisCuboctahedron.html</Link>
    </Interface>

    <Script>
        clPurple      := '800080';
        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clOrchid      := 'DA70D6';
        clKhaki       := 'F0E68C';
        clGolden      := 'DDBB20';
        clOlive       := '808000';
        clCoral       := 'FF7F50';
        clGainsboro   := 'C0C0C0';
        clSilver      := 'A0A0A0';
        clGray        := '707070';
        clBlack       := '202020';
        clGreenYellow := 'ADFF2F';
        clDarkGreen   := '006400';
        clSea         := '3cb371';
        clSeaGreen    := '2E8B57';
        clCrimson     := 'DC143C';
        clIndian      := 'CD5C5C';
        clBrown       := '800000';
        clPale        := 'D07090';
        clDeepSky     := '00BFFF';
        clTeal        := '008080';
        clNavy        := '000080';
        clAquaMarine  := '66CDAA';
        clLime        := '00FF00';
        clRed         := 'FF0000';
        clYellow      := 'FFFF00';
        clBlue        := '0000FF';
        clGreen       := '008000';
        clOrange      := 'FF6000';
        clCyan        := '00FFFF';
        clWhite       := 'F0F0F0';

        K  := 0.45;

// TetrakisCuboctahedron (canonical)

        s3 := sqrt(3);
        s2 := 2 + s3;

        C0 := K;
        C1 := K * (3 - s3);

        D1 := K * 2/11 * (2 * s3 + 1);
        D2 := K * sqrt((15 + 8 * s3) / 33);

        // Calc all Jumble Angle
        A1 := ArcCos(-(2 - s3) / 4); // AngleV(1,0,2);   // pink-purp
        A2 := ArcCos(-2 * (4 + s3) / 13); // AngleV(1,13,14); // yel-lime

        B1 := ArcCos((14 - 3 * s3) / 26); // AngleV(12,0,5); // sea-pink - need 2 steps
        B2 := 2*Pi/3;
        B3 := B1 + B2;
        B4 := B1 + 2 * B2;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1;A2" PlaneDistances = "-D2;D2" FixedLayers = "1">
        <Axis NormVector = " 1; 1;s2" />
        <Axis NormVector = "-1; 1;s2" />
        <Axis NormVector = "-1;-1;s2" />
        <Axis NormVector = " 1;-1;s2" />
        <Axis NormVector = "s2; 1;-1" />
        <Axis NormVector = "s2; 1; 1" />
        <Axis NormVector = "s2;-1; 1" />
        <Axis NormVector = "s2;-1;-1" />
        <Axis NormVector = " 1;s2;-1" />
        <Axis NormVector = "-1;s2;-1" />
        <Axis NormVector = "-1;s2; 1" />
        <Axis NormVector = " 1;s2; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-B4;-B3;-B2;-B1; 0; B1;B2;B3;B4" PlaneDistances = "-D1;D1" FixedLayers = "1">
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C1" />
                <Add Vector = "  0;  0;-C1" />
                <Add Vector = " C1;  0;  0" />
                <Add Vector = "-C1;  0;  0" />
                <Add Vector = "  0; C1;  0" />
                <Add Vector = "  0;-C1;  0" />
                <Add Vector = " C0;  0; C0" />
                <Add Vector = " C0;  0;-C0" />
                <Add Vector = "-C0;  0; C0" />
                <Add Vector = "-C0;  0;-C0" />
                <Add Vector = " C0; C0;  0" />
                <Add Vector = " C0;-C0;  0" />
                <Add Vector = "-C0; C0;  0" />
                <Add Vector = "-C0;-C0;  0" />
                <Add Vector = "  0; C0; C0" />
                <Add Vector = "  0; C0;-C0" />
                <Add Vector = "  0;-C0; C0" />
                <Add Vector = "  0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clPurple     " VertexIndexes = " 0; 6;14" />
                <Face Color = "clPink       " VertexIndexes = " 0;14; 8" />
                <Face Color = "clFuchsia    " VertexIndexes = " 0; 8;16" />
                <Face Color = "clOrchid     " VertexIndexes = " 0;16; 6" />
                <Face Color = "clKhaki      " VertexIndexes = " 1; 9;15" />
                <Face Color = "clGolden     " VertexIndexes = " 1;15; 7" />
                <Face Color = "clOlive      " VertexIndexes = " 1; 7;17" />
                <Face Color = "clCoral      " VertexIndexes = " 1;17; 9" />
                <Face Color = "clGainsboro  " VertexIndexes = " 2; 7;10" />
                <Face Color = "clSilver     " VertexIndexes = " 2;10; 6" />
                <Face Color = "clGray       " VertexIndexes = " 2; 6;11" />
                <Face Color = "clBlack      " VertexIndexes = " 2;11; 7" />
                <Face Color = "clGreenYellow" VertexIndexes = " 3; 8;12" />
                <Face Color = "clDarkGreen  " VertexIndexes = " 3;12; 9" />
                <Face Color = "clSea        " VertexIndexes = " 3; 9;13" />
                <Face Color = "clSeaGreen   " VertexIndexes = " 3;13; 8" />
                <Face Color = "clCrimson    " VertexIndexes = " 4;10;15" />
                <Face Color = "clIndian     " VertexIndexes = " 4;15;12" />
                <Face Color = "clBrown      " VertexIndexes = " 4;12;14" />
                <Face Color = "clPale       " VertexIndexes = " 4;14;10" />
                <Face Color = "clDeepSky    " VertexIndexes = " 5;11;16" />
                <Face Color = "clTeal       " VertexIndexes = " 5;16;13" />
                <Face Color = "clNavy       " VertexIndexes = " 5;13;17" />
                <Face Color = "clAquaMarine " VertexIndexes = " 5;17;11" />
                <Face Color = "clLime       " VertexIndexes = " 6;10;14" />
                <Face Color = "clRed        " VertexIndexes = " 7;11;17" />
                <Face Color = "clYellow     " VertexIndexes = " 8;13;16" />
                <Face Color = "clBlue       " VertexIndexes = " 9;12;15" />
                <Face Color = "clGreen      " VertexIndexes = "10; 7;15" />
                <Face Color = "clOrange     " VertexIndexes = "11; 6;16" />
                <Face Color = "clCyan       " VertexIndexes = "12; 8;14" />
                <Face Color = "clWhite      " VertexIndexes = "13; 9;17" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
