<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mastermorphix Fused</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Mastermorphix Fused</Menu>
        <Inventor>Jay Hensley</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7874</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 0.1;
    </Script>

    <Axes TurningAngles = " Pi/2" PlaneDistances = "-D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0;-1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
        <HideContaining Vector = " W;-W; W" />
        <Split> <Plane NormVector = " 1; 0; 0" NormDistance = " D" /> </Split>
        <Split> <Plane NormVector = " 0; 1; 0" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = " 0; 0; 1" NormDistance = " D" /> </Split>
        <ShowAll/>
    </Figure>
</xml>
