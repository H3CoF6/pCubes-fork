<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mastermorphix 3x3x5</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Mastermorphix 3x3x5</Menu>
        <Inventor>Kyler van der Gaag</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2281</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W * 0.2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D*2;-D; D; D*2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
    </Figure>
</xml>
