<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Centre Pyramid II</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Camouflage\Centre Pyramid II</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-08-05</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=115587&amp;extra=page%3D2</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />

        <HideContaining Vector = "-W; W; W" />
        <HideContaining Vector = " W;-W; W" />
        <HideContaining Vector = " W; W;-W" />
        <HideContaining Vector = "-W;-W;-W" />

        <SplitByAxes/>

        <RemoveGrayParts/>
        <ShowAll/>
    </Figure>
</xml>
