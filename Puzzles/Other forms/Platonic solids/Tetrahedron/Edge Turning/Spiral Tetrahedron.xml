<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Spiral Tetrahedron</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Spiral Tetrahedron</Menu>
        <Inventor>Marlon Macatangay</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5005</Link>
    </Interface>

    <Script>
        Cut := 0.1;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-Cut; Cut" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <LoadFrom1> Figures\Cube.xml </LoadFrom1>

        <Split Axis = "1" From = "2" />
        <Hide Axis = "1" From = "0" To = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "2" From = "1" />
        <Hide Axis = "0" From = "2" To = "3" />
        <Split Axis = "2" From = "2" />
        <Hide Axis = "2" From = "2" To = "3" />
        <Split Axis = "0" From = "1" />
        <ShowAll/>

        <Hide Axis = "1" From = "2" To = "3" />
        <Split Axis = "0" From = "1" />
        <Hide Axis = "0" From = "1" To = "3" />
        <Split Axis = "2" From = "2" />
        <Hide Axis = "2" From = "2" To = "3" />
        <Split Axis = "1" From = "1" />
        <Hide Axis = "1" Layer = "0" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>

        <Hide Axis = "1" From = "2" To = "3" />
        <Hide Axis = "0" Layer = "0" />
        <Split Axis = "1" From = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Split Axis = "2" From = "1" />
        <Hide Axis = "2" Layer = "0" />
        <Split Axis = "0" From = "2" />
        <ShowAll/>

        <Hide Axis = "1" From = "2" To = "3" />
        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "1" Layer = "0" />
        <Split Axis = "2" From = "2" />
        <Hide Axis = "2" Layer = "2" />
        <Split Axis = "0" From = "2" />
        <Hide Axis = "0" Layer = "2" />
        <Split Axis = "2" From = "1" />
        <ShowAll/>

    </Figure>
</xml>
