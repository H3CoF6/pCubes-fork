<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mastermorphix Big</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Mastermorphix Big</Menu>
        <Menu>Other forms\3x3x3 variants\Platonic\Mastermorphix Big</Menu>
        <Inventor>Chiu Chiung Yi</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2668</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 6;
        T := D;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = "-T;-T;-T" />
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D * 2" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = " D * 2" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D * 2" /></Split>

        <SplitByAxes/>
    </Figure>
</xml>
