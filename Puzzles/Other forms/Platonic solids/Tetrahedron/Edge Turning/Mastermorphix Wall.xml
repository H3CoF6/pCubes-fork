<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mastermorphix Wall</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Mastermorphix Wall</Menu>
        <Inventor>Benjy Oliver</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4617</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 6;
        Cut := 0.1131;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-Cut; Cut" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "1; -1; 1" />
                <Add Vector = "-1; 1; 1" />
                <Add Vector = "1; 1; -1" />
                <Add Vector = "-1; -1; -1" />
            </Vertices>

            <Faces>
                <Face VertexIndexes = "0;1;3" />
                <Face VertexIndexes = "1;2;3" />
                <Face VertexIndexes = "0;3;2" />
                <Face VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn Axis = "2" Angle = "Pi/4" Layer = "1" />

        <Cut Color = "C80000" > <Plane NormVector = " 1;  1; -1" NormDistance = "-D" /> </Cut>
        <Cut Color = "0000C8" > <Plane NormVector = "-1; -1; -1" NormDistance = "-D" /> </Cut>
        <Cut Color = "009600" > <Plane NormVector = "-1;  1;  1" NormDistance = "-D" /> </Cut>
        <Cut Color = "FFFF00" > <Plane NormVector = " 1; -1;  1" NormDistance = "-D" /> </Cut>


        <S1plitByAxes/>
    </Figure>
</xml>
