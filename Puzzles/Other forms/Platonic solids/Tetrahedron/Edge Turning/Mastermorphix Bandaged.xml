<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mastermorphix Bandaged</Name>
        <Menu>Other forms\Tetrahedron\Edge Turning\Mastermorphix Bandaged</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9264</Link>
    </Interface>

    <Script>
        W := 0.5;
        Cut := W * 0.25;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-Cut; Cut" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = "0;0;0" />

        <SplitByAxes/>
        <ShowAll/>
        <Turn NormVector = "0;0;1" Angle = "Pi" />
    </Figure>
</xml>
