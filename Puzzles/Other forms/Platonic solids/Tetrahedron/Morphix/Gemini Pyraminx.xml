<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gemini Pyraminx</Name>
        <Aliases>Binary Star Pyraminx</Aliases>
        <Menu>Other forms\Tetrahedron\Morphix\Gemini Pyraminx</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-03-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8447</Link>
    </Interface>

    <Script>
        Color := '333333';

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';

        D := W * 0.3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
            </Vertices>

            <Faces>
                <Face Color = "Color" VertexIndexes = "1;2;3" />
                <Face Color = "Color" VertexIndexes = "0;3;2" />
                <Face Color = "Color" VertexIndexes = "0;1;3" />
                <Face Color = "Color" VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 4" />
</xml>
