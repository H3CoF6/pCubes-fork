<xml Data_Version = "2" >

    <Interface>
        <Name>Axis Tetrahedron</Name>
        <Menu>Other forms\Tetrahedron\Axis Tetrahedron</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-02-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3821</Link>
    </Interface>

    <Script>
        N := 4;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D" >
        <Axis NormVector = "-1/3;  5/3; -1/3" />
        <Axis NormVector = "  -1;   -1;   -1" />
        <Axis NormVector = "-1/3; -1/3;  5/3" />
        <Axis NormVector = " 5/3; -1/3; -1/3" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
