<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triangulum</Name>
        <Menu>Other forms\Tetrahedron\Triangulum</Menu>
        <Inventor>Ryan Binter</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-02-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3209</Link>
    </Interface>

    <Script>
        W := 0.5;
        sAngle := 2 * Pi / 5;

        Phi := (Sqrt(5) - 1) / 2;

        D := W * 0.18;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "   0; Phi;   1" />
        <Axis NormVector = "   0;-Phi;   1" />
        <Axis NormVector = " Phi;   1;   0" />
        <Axis NormVector = "-Phi;   1;   0" />
        <Axis NormVector = "   1;   0; Phi" />
        <Axis NormVector = "   1;   0;-Phi" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <RemoveContaining Vector = " Vx; Vy; Vz" />
    </Figure>
</xml>
