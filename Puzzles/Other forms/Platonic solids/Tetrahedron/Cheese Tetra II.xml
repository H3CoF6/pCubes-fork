<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheese Tetra II</Name>
        <Menu>Other forms\Tetrahedron\Cheese Tetra II</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-06-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11196</Link>
    </Interface>

    <Script>
        W := 0.5;
        s2 := sqrt(2);
        RCut := W * 0.96;

        for i := 0 to 2 do begin
            ax[i] := cos(Pi / 3 * (2 * i + 1));
            ay[i] := sin(Pi / 3 * (2 * i + 1));
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" NormVectors = "ax; ay; 0" />

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-Pi/12" />
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
