        <Split Axis = "3" From = "1" />
        <Split Axis = "0" From = "1" />
        <Turn Axis = "1" Angle = "-Pi / 3" Layer = "1" />

        <Turn Axis = "2" Angle = "Pi / 3" Layer = "1" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Turn Axis = "2" Angle = "-Pi / 3" Layer = "1" />

        <Turn Axis = "3" Angle = "Pi / 3" Layer = "1" />
