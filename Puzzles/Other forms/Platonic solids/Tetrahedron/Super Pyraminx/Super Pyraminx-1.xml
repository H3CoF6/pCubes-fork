<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Pyraminx-1</Name>
        <Menu>Other forms\Tetrahedron\Super Pyraminx\Super Pyraminx-1</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-29</Added>
    </Interface>

    <Script>
        D := sqrt(3) / 18;
    </Script>

    <Axes TurningAngles = "2 * Pi / 6" PlaneDistances = "D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Angle = "Pi / 3" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-Pi / 3" Layer = "1" />

        <Turn Axis = "1" Angle = "Pi / 3" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-Pi / 3" Layer = "1" />

        <Turn Axis = "2" Angle = "Pi / 3" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-Pi / 3" Layer = "1" />

        <Turn Axis = "3" Angle = "Pi / 3" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "3" Angle = "-Pi / 3" Layer = "1" />

    </Figure>
</xml>
