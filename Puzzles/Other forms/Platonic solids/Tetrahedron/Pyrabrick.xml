<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyrabrick</Name>
        <Menu>Other forms\Tetrahedron\Pyrabrick</Menu>
        <Menu>Other forms\Skewb variants\Tetrahedron\Pyrabrick</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-24</Added>
    </Interface>

    <Script>
        W := 0.5;
        s2 := sqrt(2);
        RCut := W * 0.96;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "  0;-s2;  1" />
        <Axis NormVector = "-s2;  0;  1" />
        <Axis NormVector = "  0; s2;  1" />
        <Axis NormVector = " s2;  0;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
        <Cut><Plane NormVector = " 1; 0; 0" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = "-1; 0; 0" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 0; 1; 0" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 0;-1; 0" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 0; 0; 1" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 0; 0;-1" NormDistance = "-RCut" /></Cut>
    </Figure>
</xml>
