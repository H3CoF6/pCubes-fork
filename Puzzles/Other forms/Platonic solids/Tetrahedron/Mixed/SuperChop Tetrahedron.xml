<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Superchop Tetrahedron</Name>
        <Menu>Other forms\Tetrahedron\Mixed\Superchop Tetrahedron</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4717</Link>
    </Interface>

    <Script>
        RCut := 0.47;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  0;  0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;  0;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;  0; -1" NormDistance = "-RCut" /> </Cut>
    </Figure>
</xml>
