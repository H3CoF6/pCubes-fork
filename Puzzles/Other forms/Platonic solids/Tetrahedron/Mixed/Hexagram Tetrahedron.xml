<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagram Tetrahedron</Name>
        <Menu>Other forms\Tetrahedron\Mixed\Hexagram Tetrahedron</Menu>
        <Inventor>limCube</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-09-07</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := -W * sqrt(3) / 9;
        RCut := W * 0.94;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector =  "1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector =  "1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />

        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />

        <RemoveGrayParts/>

        <HideContaining Vector = " Cx[0]; Cy[0]; Cz[0]" />
        <HideContaining Vector = " Cx[1]; Cy[1]; Cz[1]" />
        <HideContaining Vector = " Cx[2]; Cy[2]; Cz[2]" />
        <HideContaining Vector = " Cx[3]; Cy[3]; Cz[3]" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "3" From = "2" />

        <ShowAll/>

        <!-- cut edges for better control -->
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-RCut" /> </Cut>
    </Figure>
</xml>
