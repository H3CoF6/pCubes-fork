<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trefoil Tetrahedron</Name>
        <Menu>Other forms\Tetrahedron\Mixed\Trefoil Tetrahedron</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-09-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9046</Link>
    </Interface>

    <Script>
        W := 0.5;
        RCut := 0.47;
        D := W / 3 / sqrt(3);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "3" From = "2" />

        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />
        <RemoveGrayParts/>

        <HideContaining Vector = " Vx; Vy; Vz" />
        <SplitByAxes/>

        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-RCut" /> </Cut>
    </Figure>
</xml>
