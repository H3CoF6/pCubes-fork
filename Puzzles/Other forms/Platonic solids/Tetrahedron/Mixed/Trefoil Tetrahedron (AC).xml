<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trefoil Tetrahedron (AC)</Name>
        <Menu>Other forms\Tetrahedron\Mixed\Trefoil Tetrahedron (AC)</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2026-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9046</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // Red
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '007700'; // Green
        Colors[ 3] := 'FFFFFF'; // White
        Colors[ 4] := '0000FF'; // Blue
        Colors[ 5] := 'F48CF1'; // LightViolett
        Colors[ 6] := 'FFF08F'; // LightYellow
        Colors[ 7] := '00FF00'; // LightGreen
        Colors[ 8] := '4B464B'; // Gray
        Colors[ 9] := '7777FF'; // LightBlue
        Colors[10] := '6C0389'; // Violett
        Colors[11] := 'FF6A00'; // Orange

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';

        D := W / 3 / sqrt(3);
        RCut := W * 0.94;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx;Vy;Vz" />
            <Vertices Vectors = "Ex;Ey;Ez" />
            <Vertices Vectors = "Cx;Cy;Cz" />

            <Faces>
                <Face Color = "Colors[ 7]" VertexIndexes = "0;6;11;5" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "0;9;12;6" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "0;5;13;9" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = "1;9;13;7" InvisibleEdges = "6" />
                <Face Color = "Colors[ 8]" VertexIndexes = "1;4;12;9" InvisibleEdges = "6" />
                <Face Color = "Colors[11]" VertexIndexes = "1;7;10;4" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = "2;7;13;5" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "2;8;10;7" InvisibleEdges = "6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "2;5;11;8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = "3;6;12;4" InvisibleEdges = "6" />
                <Face Color = "Colors[ 9]" VertexIndexes = "3;4;10;8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = "3;8;11;6" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "3" From = "2" />

        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />
        <RemoveGrayParts/>

        <HideContaining Vector = " Vx; Vy; Vz" />
        <SplitByAxes/>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-RCut" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
