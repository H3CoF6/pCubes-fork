<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Polaris Pyraminx</Name>
        <Menu>Other forms\Tetrahedron\Mixed\Polaris Pyraminx</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7782</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00'; // Yellow
        Colors[1] := 'EE0000'; // Red
        Colors[2] := '00EE00'; // Green
        Colors[3] := '0011EE'; // Blue

        K  := 0.5;

        C0 := K * 2.5 / 5;
        C1 := K;

        D := K / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " C1; C1; C1" />
        <Axis NormVector = " C1;-C1;-C1" />
        <Axis NormVector = "-C1;-C1; C1" />
        <Axis NormVector = "-C1; C1;-C1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/4" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "  0; 0;C1" />
        <Axis NormVector = "  0;C1; 0" />
        <Axis NormVector = "  C1; 0;0" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "sqrt(3) / 6" FixedLayers = "0" >
        <Axis NormVector = "-C1;-C1;-C1" />
        <Axis NormVector = "-C1; C1; C1" />
        <Axis NormVector = " C1; C1;-C1" />
        <Axis NormVector = " C1;-C1; C1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "4;0;2" InvisibleEdges = "5" />
                <Face Color = "Colors[0]" VertexIndexes = "4;2;1" InvisibleEdges = "5" />
                <Face Color = "Colors[0]" VertexIndexes = "4;1;0" InvisibleEdges = "5" />

                <Face Color = "Colors[1]" VertexIndexes = "5;0;1" InvisibleEdges = "5" />
                <Face Color = "Colors[1]" VertexIndexes = "5;1;3" InvisibleEdges = "5" />
                <Face Color = "Colors[1]" VertexIndexes = "5;3;0" InvisibleEdges = "5" />

                <Face Color = "Colors[2]" VertexIndexes = "6;0;3" InvisibleEdges = "5" />
                <Face Color = "Colors[2]" VertexIndexes = "6;3;2" InvisibleEdges = "5" />
                <Face Color = "Colors[2]" VertexIndexes = "6;2;0" InvisibleEdges = "5" />

                <Face Color = "Colors[3]" VertexIndexes = "7;1;2" InvisibleEdges = "5" />
                <Face Color = "Colors[3]" VertexIndexes = "7;2;3" InvisibleEdges = "5" />
                <Face Color = "Colors[3]" VertexIndexes = "7;3;1" InvisibleEdges = "5" />
            </Faces>
        </Part>

        <Macro Name = "Split" >
            <Split Axis = "ax" From ="1" />
            <Script>Inc(ax);</Script>
        </Macro>

        <ExecMacro MacroName = "Split" ax = "0" Repeat = "4" />

        <Turn Axis = "0" Layer = "1" Angle = "Pi/3" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/3" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/3" />
        <Turn Axis = "3" Layer = "1" Angle = "Pi/3" />

        <ExecMacro MacroName = "Split" ax = "0" Repeat = "7" />

        <Undo Repeat = "4" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
