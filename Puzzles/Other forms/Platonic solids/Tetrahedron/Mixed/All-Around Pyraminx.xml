<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>All-Around Pyraminx</Name>
        <Menu>Other forms\Tetrahedron\Mixed\All-Around Pyraminx</Menu>
        <Inventor>Jonathan Burn</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2025-02-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6931</Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 3;
        D1 := W * 0.3;
        D2 := ( 2 * D1 + W) / sqrt(3);
        D3 := (-2 * D1 + W) / sqrt(3);

        DCut := W * 0.92;
        DCut2 := W * sqrt(2) * 0.89;
        DCut3 := (W + D1) / sqrt(1.5) * 0.86;
        DCut4 := (W - D1) / sqrt(1.5) * 0.75
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2;-D3; D3; D2" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1; D1" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Macro Name = "SplitByAxes" >
            <Split Axis = "0" From = "3" />
            <Split Axis = "0" From = "4" />
            <Split Axis = "1" From = "3" />
            <Split Axis = "1" From = "4" />
            <Split Axis = "2" From = "3" />
            <Split Axis = "2" From = "4" />
            <Split Axis = "3" From = "3" />
            <Split Axis = "3" From = "4" />

            <Split Axis = "4" From = "1" />
            <Split Axis = "4" From = "2" />
            <Split Axis = "5" From = "1" />
            <Split Axis = "5" From = "2" />
            <Split Axis = "6" From = "1" />
            <Split Axis = "6" From = "2" />
        </Macro>

        <ExecMacro MacroName = "SplitByAxes" />
        <RemoveContaining Vector = "Cx;Cy;Cz" />

        <Hide Axis = "4" Layers = "0;2" />
        <Hide Axis = "5" Layers = "0;2" />
        <Hide Axis = "6" Layers = "0;2" />
        <RemoveAllVisible />
        <ShowAll/>

        <Hide Axis = "0" Layers = "3;4" />
        <Hide Axis = "1" Layers = "3;4" />
        <Hide Axis = "2" Layers = "3;4" />
        <Hide Axis = "3" Layers = "3;4" />
        <RemoveAllVisible />

        <HideAll/>

        <Script>
            Colors[0] := -1;
            Colors[1] := -1;
            Colors[2] := -1;
            Colors[3] := -1;
        </Script>

        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <ExecMacro MacroName = "SplitByAxes" />

        <HideContaining Vector = "Cx;Cy;Cz" />
        <RemoveAllVisible />
        <ShowAll/>

        <!-- cut edges for better control -->
        <Macro Name = "Cut" >
            <Hide> <Plane NormVector = " 1;-1; 1" NormDistance = " D3"    /> </Hide>
            <Cut>  <Plane NormVector = " 1; 2; 1" NormDistance = "-DCut3" /> </Cut>
            <Hide> <Plane NormVector = " 1;-1; 1" NormDistance = " D2"    /> </Hide>
            <Cut>  <Plane NormVector = " 1; 2; 1" NormDistance = "-DCut4" /> </Cut>
            <ShowAll/>
            <Cut>  <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut"  /> </Cut>
            <Cut>  <Plane NormVector = "-1; 0;-1" NormDistance = "-DCut2" /> </Cut>
            <Turn NormVector = " 1;-1; 1" Angle = "2*Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "Cut" Repeat = "3" />
        <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "3" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "3" />
        <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "3" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
    </Figure>
</xml>
