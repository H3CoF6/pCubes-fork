<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda Tetrahedral 2</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Bermuda\Bermuda Tetrahedral 2</Menu>
        <Inventor>Fenz</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-12-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4794</Link>
    </Interface>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Split Axis = "0" From = "1"/>
        <Split Axis = "2" From = "1"/>
        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />
        <Split Axis = "2" From = "1"/>
        <Undo/>

        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "3" From = "1"/>
        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "1" From = "1"/>
        <Turn  Axis = "0" Layer = "0" Angle = "2*Pi/3" />

        <Turn  Axis = "2" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "0" From = "1"/>
        <Turn  Axis = "2" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "0" From = "1"/>
        <Turn  Axis = "2" Layer = "0" Angle = "2*Pi/3" />

        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />

        <Turn  Axis = "2" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "0" From = "1"/>
        <Turn  Axis = "2" Layer = "0" Angle = "2*Pi/3" />
        <Split Axis = "0" From = "1"/>
        <Turn  Axis = "2" Layer = "0" Angle = "2*Pi/3" />

        <Turn  Axis = "0" Layer = "0" Angle = " Pi" />
    </Figure>
</xml>
