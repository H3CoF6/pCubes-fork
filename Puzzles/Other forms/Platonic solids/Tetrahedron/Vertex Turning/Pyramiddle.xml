<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyramiddle</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Pyramiddle</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>KnightCrawler</Programmer>
        <Added>2016-11-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1054</Link>
    </Interface>

    <Script>
        D1 := 0.15;
        D2 := 1/sqrt(3) - D1;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D1; D2" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
