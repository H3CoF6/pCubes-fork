        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "1;2;4" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "3;1;4" InvisibleEdges = "6" />
