<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrahedron Royal</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetrahedron\Tetrahedron Royal</Menu>
        <Inventor>Andrew Cormier</Inventor>
        <Programmer>KnightCrawler</Programmer>
        <Added>2016-11-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2006</Link>
    </Interface>

    <Script>
        N := 4;
        D0 := -sqrt(3) / 6;
        D := 2 * sqrt(3) / 3 / (3 * N + 1);
        D1 := D0 + D;
        D2 := D0 + 2 * D;
        D3 := D0 + 3 * D;
        D4 := D0 + 4 * D;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D1; D2; D3; D4" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>
    </Figure>

</xml>
