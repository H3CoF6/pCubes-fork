<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrahedron Princess</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetrahedron\Tetrahedron Princess</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-07-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11313</Link>
    </Interface>

    <Script>
        N := 5;
        D0 := -sqrt(3) / 6;
        WD := 2 / sqrt(3) / (3 * N + 1);
        for i := 0 to N - 1 do
            D[i] := D0 + WD * (i + 1);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
