<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Duo II</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetrahedron\Pyraminx Duo II</Menu>
        <Menu>Other forms\Skewb variants\Tetrahedron\Pyraminx Duo II</Menu>
        <Inventor>Martin Guadalupe Bueno Alcantar</Inventor>
