        <Added>2020-02-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7804</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Tetrahedron_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "1;11;4; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "2;12;4;11" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "3; 8;4;12" InvisibleEdges = "6" />

                <Face Color = "Colors[2]" VertexIndexes = "3;12;5;10" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "2; 9;5;12" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0;10;5; 9" InvisibleEdges = "6" />

                <Face Color = "Colors[2]" VertexIndexes = "3;10;6; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0;13;6;10" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "1; 8;6;13" InvisibleEdges = "6" />

                <Face Color = "Colors[3]" VertexIndexes = "0; 9;7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "1;13;7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "2;11;7; 9" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />

        <InvertVisibility/>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face VertexIndexes = "1;2;3" />
                <Face VertexIndexes = "0;3;2" />
                <Face VertexIndexes = "0;1;3" />
                <Face VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <HideContaining Vector = " 0; 0;-W" />

        <RemoveContaining Vector = "0;0;0" />

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
