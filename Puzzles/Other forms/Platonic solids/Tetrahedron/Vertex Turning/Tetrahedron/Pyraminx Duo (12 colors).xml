<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Duo (12 colors)</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetrahedron\Pyraminx Duo (12 colors)</Menu>
        <Menu>Other forms\Skewb variants\Tetrahedron\Pyraminx Duo (12 colors)</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-19</Added>
        <Link>https://oliverstickers.com/pyraminx-duo-12-color.html</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFAA'; // cream
        Colors[ 1] := '666666'; // gray
        Colors[ 2] := 'FF88CC'; // light violette
        Colors[ 3] := '00FF00'; // light green
        Colors[ 4] := 'FF6000'; // orange
        Colors[ 5] := 'FFFF00'; // yellow
        Colors[ 6] := '0000C8'; // blue
        Colors[ 7] := 'FFFFFF'; // white
        Colors[ 8] := 'FF0000'; // red
        Colors[ 9] := '800080'; // violette
        Colors[10] := '00AA00'; // green
        Colors[11] := '0066CC'; // light blue

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 1;11; 4; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 2;12; 4;11" InvisibleEdges = "6" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 3; 8; 4;12" InvisibleEdges = "6" />

                <Face Color = "Colors[ 3]" VertexIndexes = " 3;12; 5;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 4]" VertexIndexes = " 2; 9; 5;12" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 0;10; 5; 9" InvisibleEdges = "6" />

                <Face Color = "Colors[ 6]" VertexIndexes = " 3;10; 6; 8" InvisibleEdges = "6" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 0;13; 6;10" InvisibleEdges = "6" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 1; 8; 6;13" InvisibleEdges = "6" />

                <Face Color = "Colors[ 9]" VertexIndexes = " 0; 9; 7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[10]" VertexIndexes = " 1;13; 7;11" InvisibleEdges = "6" />
                <Face Color = "Colors[11]" VertexIndexes = " 2;11; 7; 9" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />

        <InvertVisibility/>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face VertexIndexes = "1;2;3" />
                <Face VertexIndexes = "0;3;2" />
                <Face VertexIndexes = "0;1;3" />
                <Face VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <HideContaining Vector = " 0; 0;-W" />

        <RemoveContaining Vector = "0;0;0" />

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
