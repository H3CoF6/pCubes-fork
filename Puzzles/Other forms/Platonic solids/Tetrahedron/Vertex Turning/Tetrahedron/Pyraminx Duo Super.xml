<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Duo Super</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetrahedron\Pyraminx Duo Super</Menu>
        <Menu>Other forms\Skewb variants\Tetrahedron\Pyraminx Duo Super</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4714</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Tetrahedron_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';

        k := 1.15;
        RCut := W * k / sqrt(3);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>

        // Form centers

        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <Sp1litByAxes/>

        <Macro Name = "Split" >
            <Cut Color = "Colors[Id]" > <Plane NormVector = "-Cx[Id]; -Cy[Id]; -Cz[Id]" NormDistance = "-RCut" /> </Cut>
            <Split Color2 = "Colors[Id]" > <Plane NormVector = "Cx[Id]; Cy[Id]; Cz[Id]" NormDistance = "0" /> </Split>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "4" id = "0" />

            <HideContaining Vector = "Cx; Cy; Cz" />
        <RemoveAllVisible/>

        // Vertices

        <Macro Name = "Tetrahedron">
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />

                <Faces>
                    <Face Color = "Colors[0]" VertexIndexes = "1;2;3" />
                    <Face Color = "Colors[1]" VertexIndexes = "0;3;2" />
                    <Face Color = "Colors[2]" VertexIndexes = "0;1;3" />
                    <Face Color = "Colors[3]" VertexIndexes = "0;2;1" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Tetrahedron" />
        <SplitByAxes/>

        <HideContaining Vector = "Vx; Vy; Vz" />
        <RemoveAllVisible/>

        // Edges

        <Script>
            for i := 0 to 3 do
                Colors[ i] := '-1';
        </Script>
        <ExecMacro MacroName = "Tetrahedron" />
        <SplitByAxes/>

        <HideContaining Vector = "Ex; Ey; Ez" />
        <RemoveAllVisible/>

        <ShowAll/>
    </Figure>
</xml>
