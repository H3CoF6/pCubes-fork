<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Duo</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetrahedron\Pyraminx Duo</Menu>
        <Menu>Other forms\Skewb variants\Tetrahedron\Pyraminx Duo</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4714</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Tetrahedron_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;2;3" />
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" />
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[3]" VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />

        <InvertVisibility/>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face VertexIndexes = "1;2;3" />
                <Face VertexIndexes = "0;3;2" />
                <Face VertexIndexes = "0;1;3" />
                <Face VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <HideContaining Vector = " 0; 0;-W" />

        <RemoveContaining Vector = "0;0;0" />

        <ShowAll/>

    </Figure>
</xml>
