<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Pyraminx C</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Crazy\Crazy Pyraminx C</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2019-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6699</Link>
    </Interface>

    <Script>
        Colors[0] := '0066EE'; // clBlue
        Colors[1] := '009900'; // clGreen
        Colors[2] := 'FF1100'; // clRed
        Colors[3] := 'FFEE00'; // clYellow

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';

        D := W * 4 * sqrt(3) / 9;
        D0 := -W * sqrt(3) / 3;

        RC := W * 0.55;
        Sc := 1.001;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D0; D0 + D; D0 + 2 * D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;2;3" /> // clBlue
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" /> // clGreen
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" /> // clRed
                <Face Color = "Colors[3]" VertexIndexes = "0;2;1" /> // clYellow
            </Faces>
        </Part>

        <Circle Radius = "RC" Color = "Colors[0]" Center = "Cx[0] * Sc; Cy[0] * Sc; Cz[0] * Sc" />
        <Circle Radius = "RC" Color = "Colors[1]" Center = "Cx[1] * Sc; Cy[1] * Sc; Cz[1] * Sc" />
        <Circle Radius = "RC" Color = "Colors[2]" Center = "Cx[2] * Sc; Cy[2] * Sc; Cz[2] * Sc" />
        <Circle Radius = "RC" Color = "Colors[3]" Center = "Cx[3] * Sc; Cy[3] * Sc; Cz[3] * Sc" />

        <SplitByAxes/>

        <!-- remove small artefacts -->
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <Hide Axis = "3" Layer = "1" />
        <RemoveAllVisible/>

        <ShowAll/>

        <Connect Axis = "0" Layers = "0;1" />
        <Connect Axis = "1" Layers = "0;2" />
        <Connect Axis = "2" Layers = "0;1" />
        <Connect Axis = "3" Layers = "0;1" />
    </Figure>
</xml>
