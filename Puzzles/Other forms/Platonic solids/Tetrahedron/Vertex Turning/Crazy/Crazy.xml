<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrahedron Crazy</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Crazy\Crazy</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3714</Link>
    </Interface>

    <Script>
        W := 0.5;

        RC := W * 0.7;
        DC := W / 3 * 1.001;

        R := sqrt(3) * W;
        D1 := -R / 3;
        D2 := 0;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D1; D2" TurnAxesWithLayer = "2" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Circle Radius = "RC" Color = "Colors[0]" Center = "-DC; DC;-DC" />
        <Circle Radius = "RC" Color = "Colors[1]" Center = " DC;-DC;-DC" />
        <Circle Radius = "RC" Color = "Colors[2]" Center = "-DC;-DC; DC" />
        <Circle Radius = "RC" Color = "Colors[3]" Center = " DC; DC; DC" />

        <SplitByAxes/>

        <Connect Layers = "0;2" />
    </Figure>

    <Textures>
        <Texture Name = "Triangle" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Crazy\Triangle.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Triangle = 20,0,0, 27,0,0, 34,0,0, 41,0,0
    </SetTextures>

</xml>
