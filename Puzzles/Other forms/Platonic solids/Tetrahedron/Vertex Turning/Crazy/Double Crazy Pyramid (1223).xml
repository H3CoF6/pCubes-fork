<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Crazy Pyramid (1223)</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Crazy\Double Crazy Pyramid (1223)</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-03</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := '0011EE'; // Blue
        Colors[1] := '00EE00'; // Green
        Colors[2] := 'EE0000'; // Red
        Colors[3] := 'FFFF00'; // Yellow

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';
        L := 1.001;

        R := sqrt(3) * W;
        R1 := W * 0.67;
        R2 := W * 0.45;

        D1 := -W / sqrt(3);
        D2 := D1 * L^2;
        D3 := W * 0.08;
        L2 := L^3;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D1; D2; D3" TurnAxesWithLayer = "3" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;2;3" /> // Blue
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" /> // Green
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" /> // Red
                <Face Color = "Colors[3]" VertexIndexes = "0;2;1" /> // Yellow
            </Faces>
        </Part>

        <Macro Name = "AddCircles" >
            <Circle Radius = "R1" Color = "Colors[i]" > <Center X = "Cx[i] * L " Y =  "Cy[i] * L " Z =  "Cz[i] * L " /> </Circle>
            <Circle Radius = "R2" Color = "Colors[i]" > <Center X = "Cx[i] * L2" Y =  "Cy[i] * L2" Z =  "Cz[i] * L2" /> </Circle>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircles" Repeat = "4" i = "0" />

        <SplitByAxes/>

        <Connect Axis = "0" Layers = "0;3" />
        <Connect Axis = "0" Layers = "1;2" />
        <Connect Axis = "1" Layers = "0;1;3" />
        <Connect Axis = "2" Layers = "0;1;3" />
        <Connect Axis = "3" Layers = "0;1;2" />
    </Figure>

    <Textures>
        <Texture Name = "Dot" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Crazy\Textures\Dot.vec" />
        <Texture Name = "RingAndDot" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Crazy\Textures\RingAndDot.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Dot = 56,0,0
        RingAndDot = 42,0,0, 70,0,0
    </SetTextures>
</xml>
