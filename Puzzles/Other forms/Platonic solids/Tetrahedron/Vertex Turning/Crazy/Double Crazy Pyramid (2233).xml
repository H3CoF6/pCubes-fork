<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Crazy Pyramid (2233)</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Crazy\Double Crazy Pyramid (2233)</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11604</Link>
    </Interface>

    <Script>
        Colors[0] := '0011EE'; // Blue
        Colors[1] := '00EE00'; // Green
        Colors[2] := 'EE0000'; // Red
        Colors[3] := 'FFFF00'; // Yellow

        W := 0.5;
        include 'Figures\Scripts\Tetrahedron_Coordinates.inc';
        L := 1.001;

        R1 := W * 0.67;
        R2 := W * 0.45;

        D1 := -W / sqrt(3);
        D2 := D1 * L^2;
        D3 := W * 0.08;
        L2 := L^3;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = " D1; D2; D3" TurnAxesWithLayer = "3" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Macro Name = "AddCircles" >
            <Circle Radius = "R1" Color = "Colors[i]" Center = "Cx[i] * L ; Cy[i] * L ; Cz[i] * L " />
            <Circle Radius = "R2" Color = "Colors[i]" Center = "Cx[i] * L2; Cy[i] * L2; Cz[i] * L2" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircles" i = "0" Repeat = "4" />

        <SplitByAxes/>

        <Connect Axis = "0" Layers = "0;3" />
        <Connect Axis = "0" Layers = "1;2" />
        <Connect Axis = "1" Layers = "0;3" />
        <Connect Axis = "1" Layers = "1;2" />
        <Connect Axis = "2" Layers = "0;1;3" />
        <Connect Axis = "3" Layers = "0;1;3" />
    </Figure>

    <Textures>
        <Texture Name = "Dot" File = "Textures\Dot.vec" />
        <Texture Name = "RingAndDot" File = "Textures\RingAndDot.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Dot = 56,0,0, 70,0,0
        RingAndDot = 28,0,0, 42,0,0
    </SetTextures>
</xml>
