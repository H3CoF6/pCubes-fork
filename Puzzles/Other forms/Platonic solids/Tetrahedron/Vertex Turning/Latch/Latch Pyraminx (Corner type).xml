<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Latch Pyraminx (Corner type)</Name>
        <Class>TLatch</Class>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Latch\Latch Pyraminx (Corner type)</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-01-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3653</Link>
    </Interface>

    <Script>
        N := 3;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D" FixedLayers = "1">
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>

    <Textures>
        <Texture Name = "BlackArrow Lock CW" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Latch\BlackArrowCorner.vec" />
        <Texture Name = "WhiteArrow Lock CCW" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Latch\WhiteArrowCorner.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        BlackArrow Lock CW = 3,2,2, 1,2,0, 10,0,1, 6,0,2
        WhiteArrow Lock CCW = 3,1,0, 1,1,0, 10,1,2, 6,1,0
    </SetTextures>
</xml>
