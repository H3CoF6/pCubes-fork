<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Latch Pyraminx (Edge type)</Name>
        <Class>TLatch</Class>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Latch\Latch Pyraminx (Edge type)</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-01-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3653</Link>
    </Interface>

    <Script>
        Delta := 0.001;
        D := 2 * sqrt(3) / 9;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D - delta; D0 + 2*D + delta" FixedLayers = "1">
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
        <RemoveContaining Vector = "Cx[0]; Cy[0]; Cz[0]" />
        <RemoveContaining Vector = "Cx[1]; Cy[1]; Cz[1]" />
        <RemoveContaining Vector = "Cx[2]; Cy[2]; Cz[2]" />
        <RemoveContaining Vector = "Cx[3]; Cy[3]; Cz[3]" />
    </Figure>

    <Textures>
        <Texture Name = "BlackArrow Lock CW" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Latch\BlackArrowEdge.vec" />
        <Texture Name = "WhiteArrow Lock CCW" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Latch\WhiteArrowEdge.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        BlackArrow Lock CW = 8,0,1, 12,0,2, 12,1,1, 11,1,2
        WhiteArrow Lock CCW = 8,1,2, 7,1,1, 7,0,0, 11,0,1
    </SetTextures>
</xml>
