<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Latch Pyraminx Master I</Name>
        <Class>TLatch</Class>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Latch\Latch Pyraminx Master I</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-04-23</Added>
        <Link></Link>
    </Interface>

    <Script>
        N := 4;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D; D0 + 3*D" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Textures>
        <Texture Name = "BlackArrowCorner Lock CW" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Latch\BlackArrowCorner.vec" />
        <Texture Name = "WhiteArrowCorner Lock CCW" File = "Puzzles\Other forms\Platonic solids\Tetrahedron\Vertex Turning\Latch\WhiteArrowCorner.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        BlackArrowCorner Lock CW = 28,0,1, 32,0,1, 7,1,1, 5,1,1
        WhiteArrowCorner Lock CCW = 7,0,2, 5,0,2, 28,1,2, 32,1,2
    </SetTextures>
</xml>
