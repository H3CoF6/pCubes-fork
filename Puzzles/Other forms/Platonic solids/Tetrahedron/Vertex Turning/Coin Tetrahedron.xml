<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Coin Tetrahedron</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Coin Tetrahedron</Menu>
        <Programmer>xchemist</Programmer>
        <Inventor>unknown</Inventor>
        <Added>2020-03-06</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := '0000C8'; // Blue  
        Colors[1] := '009600'; // Green 
        Colors[2] := 'C80000'; // Red   
        Colors[3] := 'FFFF00'; // Yellow

        W := 0.5;

        D :=  W / sqrt(3);
        R :=  W * 0.759;

        N := W / 3;
        M := N * 1.138;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Macro Name = "Tetrahedron">
            <Part>
                <Vertices>
                    <Add Vector = " W;-W; W" />
                    <Add Vector = "-W; W; W" />
                    <Add Vector = " W; W;-W" />
                    <Add Vector = "-W;-W;-W" />
                </Vertices>

                <Faces>
                    <Face Color = "Colors[0]" VertexIndexes = "0;1;3" />
                    <Face Color = "Colors[1]" VertexIndexes = "1;2;3" />
                    <Face Color = "Colors[2]" VertexIndexes = "0;3;2" />
                    <Face Color = "Colors[3]" VertexIndexes = "0;2;1" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Tetrahedron" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />

        <Cylinder Radius = "R" Color = "Colors[0]" >
            <Base X = "-N" Y = "-N" Z = "N" />
            <Top  X = "-M" Y = "-M" Z = "M" Color = "Colors[0]" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "Colors[2]" >
            <Base X = "N" Y = "-N" Z = "-N" />
            <Top  X = "M" Y = "-M" Z = "-M" Color = "Colors[2]" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "Colors[1]" >
            <Base X = "-N" Y = "N" Z = "-N" />
            <Top  X = "-M" Y = "M" Z = "-M" Color = "Colors[1]" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "Colors[3]" >
            <Base X = "N" Y = "N" Z = "N" />
            <Top  X = "M" Y = "M" Z = "M" Color = "Colors[3]" />
        </Cylinder>

        <SplitByAxes/>
        <InvertVisibility/>

        <Script>
            for i := 0 to 3 do
              Colors[i] := -1;
        </Script>
        <ExecMacro MacroName = "Tetrahedron" />

        <SplitByAxes/>
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>

        <ShowAll/>
    </Figure>
</xml>
