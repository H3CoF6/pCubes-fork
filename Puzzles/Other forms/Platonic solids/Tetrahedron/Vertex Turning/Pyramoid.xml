<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyramoid</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Pyramoid</Menu>
        <Inventor>E-Cubes Designer X</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-12</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=33601</Link>
    </Interface>

    <Script>
        N := 4;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D; D0 + 3*D" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Split Axis = "0" From = "1" Color1 = "Colors[2]" />
        <Split Axis = "1" From = "1" Color1 = "Colors[3]" />
        <Split Axis = "2" From = "1" Color1 = "Colors[1]" />
        <Split Axis = "3" From = "1" Color1 = "Colors[0]" />
        <SplitByAxes/>

        <HideContaining Vector = " 0.1; -0.5;  0.1" />
        <HideContaining Vector = "-0.1; -0.5; -0.1" />
        <HideContaining Vector = "-0.1;  0.5;  0.1" />
        <HideContaining Vector = " 0.1;  0.5; -0.1" />

        <HideContaining Vector = " 0.1;  0.1; -0.5" />
        <HideContaining Vector = "-0.1; -0.1; -0.5" />
        <HideContaining Vector = " 0.1; -0.1;  0.5" />
        <HideContaining Vector = "-0.1;  0.1;  0.5" />

        <HideContaining Vector = "-0.5;  0.1;  0.1" />
        <HideContaining Vector = "-0.5; -0.1; -0.1" />
        <HideContaining Vector = " 0.5;  0.1; -0.1" />
        <HideContaining Vector = " 0.5; -0.1;  0.1" />

        <RemoveAllVisible/>

        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Cut Axis = "0" To = "2" />
        <Cut Axis = "1" To = "2" />
        <Cut Axis = "2" To = "2" />
        <Cut Axis = "3" To = "2" />
        <ShowAll />

        <SplitByAxes/>
    </Figure>
</xml>
