<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Pyraminx\Pyraminx</Menu>
        <Inventor>Uwe Mèffert</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=539</Link>
    </Interface>

    <Script>
        N := 3;
        D := 2 * sqrt(3) / 3 / N;
        D0 :=-sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
