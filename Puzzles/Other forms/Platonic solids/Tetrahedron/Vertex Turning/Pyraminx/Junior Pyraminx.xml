<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Junior Pyraminx</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Pyraminx\Junior Pyraminx</Menu>
        <Inventor>Alfred J. Williams</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-06-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2647</Link>
    </Interface>

    <Script>
        N := 3;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + 3 * D / 2" FixedLayers = "0" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
