<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx 13x13</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Pyraminx\Pyraminx 13x13</Menu>
        <Inventor>Coren Broughton</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2025-10-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9478</Link>
    </Interface>

    <Script>
        N := 13;
        WD := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;

        for i := 0 to N - 1 do
            D[i] := D0 + (i + 1) * WD;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>

        <RemoveGrayParts/>
    </Figure>
</xml>
