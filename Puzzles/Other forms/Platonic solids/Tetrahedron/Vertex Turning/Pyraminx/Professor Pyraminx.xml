<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Professor Pyraminx</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Pyraminx\Professor Pyraminx</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1605</Link>
    </Interface>

    <Script>
        N := 5;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D; D0 + 3*D; D0 + 4*D" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
