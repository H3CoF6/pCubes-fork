<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetragem</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Tetragem</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5437</Link>
    </Interface>

    <Script>
        N := 6;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
        DCut := -(D0 + 4 * D);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 3 * D" >
        <Axis NormVector =  "1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector =  "1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
