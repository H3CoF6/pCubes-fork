        <ExecMacro MacroName = "Split2" S = "'35-34-33+21-20-11-10-01-00*'" />
        <ExecMacro MacroName = "Split2" S = "'35-34-33+21-20-11-10+00*'" />
        <ExecMacro MacroName = "Split2" S = "'35-34-33+21-20+10-00*'" />
        <ExecMacro MacroName = "Split2" S = "'35-34+20-10-00*'" />

        // remove gray core
        <Macro Name = "HideV" >
            <Hide> <Plane NormVector = " Vx[i]; Vy[i]; Vz[i]" NormDistance = "D0 + D" /> </Hide>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideV" i = "0" Repeat = "4" />
        <Macro Name = "HideE" >
            <Hide> <Plane NormVector = " Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /> </Hide>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideE" i = "0" Repeat = "6" />
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>
