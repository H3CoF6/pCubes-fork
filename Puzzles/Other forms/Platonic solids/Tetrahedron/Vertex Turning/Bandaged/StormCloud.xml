<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>StormCloud</Name>
        <Menu>Other forms\Tetrahedron\Vertex Turning\Bandaged\StormCloud</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2014-07-08</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        N := 7;
        D := W * 4 / sqrt(3) / N;
        D0 := -W / sqrt(3);
        CutE := W * 0.4;

        procedure Prepare();
        begin
            Count := Length(S) div 3;
            for i := 0 to Count - 1 do begin
                ax[i] := StrToInt(copy(S, i * 3 + 1, 1));
                L[i] := StrToInt(copy(S, i * 3 + 2, 1));
                Sign := copy(S, i * 3 + 3, 1);
                if Sign = '-' then begin
                    FromL[i] := L[i] + 1;
                    ToL[i] := 20;
                end else begin
                    FromL[i] := 0;
                    ToL[i] := L[i];
                end;
            end;
        end;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D; D0 + 3*D; D0 + 4*D; D0 + 5*D; D0 + 6*D" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Macro Name = "Split1" >
            <Split Axis = "ax[i]" From = "L[i] + 1" />
            <Hide Axis = "ax[i]" From = "FromL[i]" To = "ToL[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <Macro Name = "Split2" >
            <Script> Prepare; </Script>
            <ExecMacro MacroName = "Split1" i = "0" Repeat = "Count" />
            <ShowAll/>
        </Macro>

        // "52-" means split axis = "5" From = "2+1" and hide lower or upper half depending on sign
        // these strings split very bandaged puzzle
        <ExecMacro MacroName = "Split2" S = "'35-34-33-31-25-24-23-21-15-14-13-12-11-30-20-10-05-04*'" />
