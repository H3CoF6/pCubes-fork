<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octahinx</Name>
        <Menu>Other forms\Octahedron\Octahinx</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-12-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1527</Link>
    </Interface>

    <Script>
        ss := sqrt((5 - sqrt(5)) / 10);
        cs := sqrt((5 + sqrt(5)) / 10);

        D := 0.3;
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "  0; ss; cs" />
        <Axis NormVector = "  0;-ss; cs" />
        <Axis NormVector = " ss; cs;  0" />
        <Axis NormVector = "-ss; cs;  0" />
        <Axis NormVector = " cs;  0; ss" />
        <Axis NormVector = " cs;  0;-ss" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0; 0;-W" />
        <RemoveContaining Vector = " 0; 0; W" />
    </Figure>
</xml>
