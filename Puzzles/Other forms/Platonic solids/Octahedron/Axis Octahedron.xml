<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Axis Octahedron</Name>
        <Menu>Other forms\Octahedron\Axis Octahedron</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-01-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5178</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 8;
        E := sqrt(2);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; E; 1" />
        <Axis NormVector = " 0; E;-1" />
        <Axis NormVector = " E; 0; 1" />
        <Axis NormVector = " E; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
