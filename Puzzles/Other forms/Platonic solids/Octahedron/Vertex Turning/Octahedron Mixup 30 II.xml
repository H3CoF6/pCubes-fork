<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octahedron Mixup 30 II</Name>
        <Menu>Other forms\Octahedron\Vertex Turning\Octahedron Mixup 30 II</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11807</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=32190</Link>
    </Interface>

    <Script>
        D := 0.15;
    </Script>

    <Axes TurningAngles = " Pi/2; Pi/6; Pi/2" PlaneDistances = "-D/2; D/2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        
        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn  Axis = "Ax2" Layer = "1" Angle = " Pi/6" />
            <SplitByAxes/>
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-Pi/3" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
            <RemoveGrayParts/>

            <Turn  Axis = "Ax3" Layer = "1" Angle = " Pi/6" />
            <SplitByAxes/>
            <Turn  Axis = "Ax3" Layer = "1" Angle = "-Pi/3" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
            <RemoveGrayParts/>

            <Turn  Axis = "Ax1" Layer = "1" Angle = " Pi/6" />
            <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <Undo Repeat = "3" />

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <Undo Repeat = "3" />

        <ExecMacro MacroName = "Split" Repeat = "3" Ax1 = "2" Ax2 = "0" Ax3 = "1" />
        <Undo Repeat = "3" />
    </Figure>
</xml>
