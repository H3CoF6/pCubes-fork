<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octahedron 3x3x5</Name>
        <Menu>Other forms\Octahedron\Vertex Turning\Octahedron 3x3x5</Menu>
        <Inventor>Adam G. Cowan</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-02-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2412</Link>
    </Interface>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3/10; -3/20; 3/20; 3/10" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />

        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "2" />
        <InvertVisibility/>
        <Hide Axis = "2" Layer = "0" />
        <Hide Axis = "2" Layer = "4" />
        <SplitByAxes/>
        <ShowAll/>

    </Figure>

</xml>
