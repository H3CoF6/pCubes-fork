<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexic</Name>
        <Menu>Other forms\Octahedron\Vertex Turning\Hexic</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-03</Added>
        <Link>https://www.youtube.com/watch?v=7kbUkyeP1hs</Link>
        <Link>https://www.instagram.com/p/B2HlBWUJlSz/</Link>
        <Link>https://www.etsy.com/de/listing/721000164/hexic?ref=shop_home_active_11</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFFFF';
        Colors[1] := '00FF00';
        Colors[2] := 'EE0000';
        Colors[3] := 'FFEE00';
        Colors[4] := '0011FF';
        Colors[5] := 'FFA500';

        W := 1.5 * 0.5;
        D := W / 2;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ex; Ey; Ez" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 8;18; 7; 0" InvisibleEdges = "3" />
                <Face Color = "Colors[1]" VertexIndexes = "13;18; 8; 2" InvisibleEdges = "3" />
                <Face Color = "Colors[2]" VertexIndexes = " 7;18;13; 5" InvisibleEdges = "3" />

                <Face Color = "Colors[2]" VertexIndexes = "13;19;15; 5" InvisibleEdges = "3" />
                <Face Color = "Colors[1]" VertexIndexes = "16;19;13; 2" InvisibleEdges = "3" />
                <Face Color = "Colors[3]" VertexIndexes = "15;19;16; 1" InvisibleEdges = "3" />

                <Face Color = "Colors[2]" VertexIndexes = "15;20;10; 5" InvisibleEdges = "3" />
                <Face Color = "Colors[3]" VertexIndexes = "14;20;15; 1" InvisibleEdges = "3" />
                <Face Color = "Colors[4]" VertexIndexes = "10;20;14; 3" InvisibleEdges = "3" />

                <Face Color = "Colors[2]" VertexIndexes = "10;21; 7; 5" InvisibleEdges = "3" />
                <Face Color = "Colors[0]" VertexIndexes = " 7;21; 6; 0" InvisibleEdges = "3" />
                <Face Color = "Colors[4]" VertexIndexes = " 6;21;10; 3" InvisibleEdges = "3" />

                <Face Color = "Colors[4]" VertexIndexes = "11;25; 6; 3" InvisibleEdges = "3" />
                <Face Color = "Colors[0]" VertexIndexes = " 6;25; 9; 0" InvisibleEdges = "3" />
                <Face Color = "Colors[5]" VertexIndexes = " 9;25;11; 4" InvisibleEdges = "3" />

                <Face Color = "Colors[4]" VertexIndexes = "14;24;11; 3" InvisibleEdges = "3" />
                <Face Color = "Colors[3]" VertexIndexes = "17;24;14; 1" InvisibleEdges = "3" />
                <Face Color = "Colors[5]" VertexIndexes = "11;24;17; 4" InvisibleEdges = "3" />

                <Face Color = "Colors[3]" VertexIndexes = "16;23;17; 1" InvisibleEdges = "3" />
                <Face Color = "Colors[1]" VertexIndexes = "12;23;16; 2" InvisibleEdges = "3" />
                <Face Color = "Colors[5]" VertexIndexes = "17;23;12; 4" InvisibleEdges = "3" />

                <Face Color = "Colors[5]" VertexIndexes = "12;22; 9; 4" InvisibleEdges = "3" />
                <Face Color = "Colors[1]" VertexIndexes = " 8;22;12; 2" InvisibleEdges = "3" />
                <Face Color = "Colors[0]" VertexIndexes = " 9;22; 8; 0" InvisibleEdges = "3" />

            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
