<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Squarhedron</Name>
        <Menu>Other forms\Octahedron\Squarhedron</Menu>
        <Inventor>José Manuel Garcéa Mouzo</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2021-03-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2689</Link>
    </Interface>

    <Script>
        W := 0.75;
        D := W * 0.2;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "-1;-1;1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 2" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Undo Repeat = "3" />
    </Figure>
</xml>
