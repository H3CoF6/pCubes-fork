<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octamate</Name>
        <Menu>Other forms\Octahedron\Octamate</Menu>
        <Inventor>Diogo Sousa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-02-22</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=34267</Link>
    </Interface>

    <Script>
        R := 0.7;
        C := (sqrt(5) + 1) / 2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "0" >
        <Axis NormVector = "-C; -1;  0" />
        <Axis NormVector = " C; -1;  0" />
        <Axis NormVector = "-1;  0;  C" />
        <Axis NormVector = " 1;  0;  C" />
        <Axis NormVector = " 0; -C; -1" />
        <Axis NormVector = " 0; -C;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
