<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dock Oct</Name>
        <Menu>Other forms\Octahedron\Face Turning\Dock Oct</Menu>
        <Inventor>Nifty Twisty</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6354</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 12;
    </Script>

    <Axes TurningAngles = "0; 2 * Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>

        <Cut Color = "404040" > <Plane NormVector = "0; 0; 1" NormDistance = "-0.28" /> </Cut>

        <HideContaining Vector = "0; 0; 0" />

        <Split> <Plane NormDistance = "-D" NormVector = " 1; 1; 1" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = "-1; 1; 1" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = "-1;-1; 1" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = " 1;-1; 1" /> </Split>

        <ShowAll/>

    </Figure>
</xml>
