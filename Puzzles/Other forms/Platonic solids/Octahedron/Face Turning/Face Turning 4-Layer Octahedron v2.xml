<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning 4-Layer Octahedron v2</Name>
        <Aliases>Master face turning octahedron v2</Aliases>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning 4-Layer Octahedron v2</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-08-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9944</Link>
    </Interface>

    <Script>
        W := 0.75;
        D := W * sqrt(3) / 9;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
