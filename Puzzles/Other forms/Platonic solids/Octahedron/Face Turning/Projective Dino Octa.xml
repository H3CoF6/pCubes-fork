<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Projective Dino Octa</Name>
        <Menu>Other forms\Octahedron\Face Turning\Projective Dino Octa</Menu>
        <Inventor>Casey Mihaloew</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7854</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00'; // Yellow
        Colors[1] := '009600'; // Green
        Colors[2] := 'C80000'; // Red
        Colors[3] := '0000C8'; // Blue
        Colors[4] := Colors[2];
        Colors[5] := Colors[3];
        Colors[6] := Colors[0];
        Colors[7] := Colors[1];

        W := 1.5 * 0.5;
        D := sqrt(3) / 8;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <Connect Layers = "0;2"/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
