<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Octahedron Plus - Mars</Name>
        <Menu>Other forms\Octahedron\Face Turning\Crazy\Mars</Menu>
        <Inventor>DF8</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5137</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';

        W := 1.5 * 0.5;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';

        D1 := sqrt(3) / 8;
        D2 := sqrt(3) / 4;
        RC := 0.23;
        DC := 1.001;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D2; -D1; D1; D2" TurnAxesWithLayer = "2" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "RC" Color = "Colors[i]" > <Center X = "Cx[i] * DC" Y =  "Cy[i] * DC" Z =  "Cz[i] * DC" /> </Circle>
        </Macro>
        <ExecMacro MacroName = "AddCircle" i = "1" />
        <ExecMacro MacroName = "AddCircle" i = "3" />
        <ExecMacro MacroName = "AddCircle" i = "4" />
        <ExecMacro MacroName = "AddCircle" i = "6" />

        <SplitByAxes/>

        <Connect Axis = "0" Layers = "0;1" />
        <Connect Axis = "1" Layers = "2;4" />
        <Connect Axis = "2" Layers = "0;1" />
        <Connect Axis = "3" Layers = "2;4" />
    </Figure>

    <Textures>
        <Texture Name = "Triangle" File = "Puzzles\Other forms\Platonic solids\Octahedron\Face Turning\Crazy\Triangle.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Triangle = 53,0,0, 59,0,0
    </SetTextures>

</xml>
