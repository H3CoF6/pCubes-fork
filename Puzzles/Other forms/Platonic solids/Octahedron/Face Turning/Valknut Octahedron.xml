    <Script>
        D1 := sqrt(3) / 4 / 9;
        D2 := D1 * 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1*5;-D1*3; D1*3; D1*5" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
