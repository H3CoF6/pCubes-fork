<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octahedron Face Turning Master</Name>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning Master</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1729</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36745</Link>
    </Interface>

    <Script>
        W := 0.75;
        D := W * sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
