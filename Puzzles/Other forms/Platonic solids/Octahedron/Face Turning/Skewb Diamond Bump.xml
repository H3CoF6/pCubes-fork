    <Script>
        Color := '707070';
        for i := 0 to 7 do
            Colors[i] := Color;

        W := 0.75;

        DX := 0;
        DY := W * 0.1;
        DZ := W * 0.05;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Transfer Vector = "-DX;-DY;-DZ" />
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <Transfer Vector = " DX; DY; DZ" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 8" />
</xml>
