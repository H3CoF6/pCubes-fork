<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octaminx</Name>
        <Menu>Other forms\Octahedron\Face Turning\Octaminx</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-03-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=397</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 12;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = " 1; -1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = " 1;  1;-1" />
        <Axis NormVector = "-1; -1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
