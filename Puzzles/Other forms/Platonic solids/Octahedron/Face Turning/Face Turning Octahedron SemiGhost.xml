<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning Octahedron SemiGhost</Name>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning Octahedron SemiGhost</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-01-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10785</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFFFF'; // White
        Colors[1] := 'C80000'; // Red
        Colors[2] := '0000C8'; // Blue
        Colors[3] := '640064'; // Violett
        Colors[4] := '5F5F5F'; // Gray
        Colors[5] := '009600'; // Green
        Colors[6] := 'FFFF00'; // Yellow
        Colors[7] := 'FF800A'; // Orange

        W := 0.75;
        D := W / sqrt(3) / 3;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "-1;-1; 1" Angle = "Pi/3" />
        <LoadFrom File = "Figures\Octahedron.xml" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Layer = "1"  Angle = "Pi/3" />
        <SplitByAxes/>
        <Undo/>
        <RemoveGrayParts/>
    </Figure>
</xml>
