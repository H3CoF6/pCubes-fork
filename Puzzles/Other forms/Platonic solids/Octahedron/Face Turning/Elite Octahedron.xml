<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Elite Octahedron</Name>
        <Menu>Other forms\Octahedron\Face Turning\Elite Octahedron</Menu>
