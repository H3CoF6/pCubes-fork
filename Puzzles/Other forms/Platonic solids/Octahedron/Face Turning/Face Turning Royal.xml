<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning Octahedron Royal</Name>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning Royal</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-07-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6205</Link>
    </Interface>

    <Script>
        D1 := sqrt(3) / 4 / 7;
        D2 := sqrt(3) / 4 / 7 * 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
