<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octo Strap</Name>
        <Menu>Other forms\Octahedron\Face Turning\Octo Strap</Menu>
        <Inventor>Manuel Garcéa Rubikonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9137</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 12;
    </Script>

    <Axes TurningAngles = "2 * Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 1; 1" Angle = "Pi / 3" />
        <LoadFrom File = "Figures\Octahedron.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "0" Layers = "1" Angle = "Pi/3" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo/>
    </Figure>
</xml>
