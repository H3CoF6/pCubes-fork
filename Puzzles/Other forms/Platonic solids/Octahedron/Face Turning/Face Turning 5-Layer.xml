<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning 5-Layer Octahedron</Name>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning 5-Layer Octahedron</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-10-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9865</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=371120</Link>
    </Interface>

    <Script>
        W := 0.75;
        D1 := W / sqrt(3) / 5;
        D2 := D1 * 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
