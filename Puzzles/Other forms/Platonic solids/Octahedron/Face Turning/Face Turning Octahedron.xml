<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning Octahedron</Name>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning Octahedron</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1663</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 12;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
