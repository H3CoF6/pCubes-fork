<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Jet Diamond</Name>
        <Menu>Other forms\Octahedron\Face Turning\Jet Diamond</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4652</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';

        W := 0.5 * 1.5;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';

        D := W / 8;

        dx := -D;
        dy :=  D;
        dz := -D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0] + dx; Vy[0] + dy; Vz[0] + dz" />
                <Add Vector = "Vx[1] + dx; Vy[1] + dy; Vz[1] + dz" />
                <Add Vector = "Vx[2] + dx; Vy[2] + dy; Vz[2] + dz" />
                <Add Vector = "Vx[3] + dx; Vy[3] + dy; Vz[3] + dz" />
                <Add Vector = "Vx[4] + dx; Vy[4] + dy; Vz[4] + dz" />
                <Add Vector = "Vx[5] + dx; Vy[5] + dy; Vz[5] + dz" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;2;5" />
                <Face Color = "Colors[1]" VertexIndexes = "5;2;1" />
                <Face Color = "Colors[2]" VertexIndexes = "5;1;3" />
                <Face Color = "Colors[3]" VertexIndexes = "5;3;0" />
                <Face Color = "Colors[4]" VertexIndexes = "4;2;0" />
                <Face Color = "Colors[5]" VertexIndexes = "4;1;2" />
                <Face Color = "Colors[6]" VertexIndexes = "4;3;1" />
                <Face Color = "Colors[7]" VertexIndexes = "4;0;3" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />

        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
