<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Octa</Name>
        <Menu>Other forms\Octahedron\Face Turning\Dino Octa</Menu>
        <Inventor>Katsuhiko Okamoto</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2673</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 8;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
