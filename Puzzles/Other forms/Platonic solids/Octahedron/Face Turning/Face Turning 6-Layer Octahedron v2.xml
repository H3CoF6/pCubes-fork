<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning 6-Layer Octahedron v2</Name>
        <Menu>Other forms\Octahedron\Face Turning\Face Turning 6-Layer Octahedron v2</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-08-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10245</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 4 / 8;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D*4; -D*2; 0; D*2; D*4" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
