<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octamate Master</Name>
        <Menu>Other forms\Octahedron\Octamate Master</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-02-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4938</Link>
    </Interface>

    <Script>
        R := 0.7;
        C := (sqrt(5) + 1) / 2;
        W := 1.5 * 0.5;
        D := W * 0.05;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D; D" >
        <Axis NormVector = "-C; -1;  0" />
        <Axis NormVector = " C; -1;  0" />
        <Axis NormVector = "-1;  0;  C" />
        <Axis NormVector = " 1;  0;  C" />
        <Axis NormVector = " 0; -C; -1" />
        <Axis NormVector = " 0; -C;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
