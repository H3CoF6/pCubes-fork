<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hybrid Octahedron</Name>
        <Menu>Other forms\Octahedron\Mixed\Hybrid Octahedron</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-01-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7226</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=34134</Link>
    </Interface>

    <Script>
        D := sqrt(3) / 8;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" FixedLayers = "1"  >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3/8; 3/8" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
