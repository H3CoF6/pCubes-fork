<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup Hexagram Octahedron</Name>
        <Menu>Other forms\Octahedron\Mixed\Mixup Hexagram Octahedron</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8998</Link>
    </Interface>

    <Script>
        W := 0.75;
        D := W / 6;
        CutE := W / sqrt(2) * 0.98;
        CutV := W * 0.96;
        CutV1 := W * 0.78;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "SplitAx" >
            <Split Axis = "0" From = "1" />
            <Split Axis = "0" From = "2" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "1" From = "2" />
            <Split Axis = "2" From = "1" />
            <Split Axis = "2" From = "2" />
        </Macro>

        <Macro Name = "Split" >
            <Turn Axis = "Ax1" Angle = "Pi/4" Layer = "1" />
            <ExecMacro MacroName = "SplitAx" />
            <Turn Axis = "Ax2" Angle = "Pi/4" Layer = "1" />
            <ExecMacro MacroName = "SplitAx" />
            <Undo/>
            <Turn Axis = "Ax3" Angle = "Pi/4" Layer = "1" />
            <ExecMacro MacroName = "SplitAx" />
            <Undo/>
            <Undo/>
            <RemoveGrayParts/>
        </Macro>
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "0" Ax3 = "1" />

        <!-- cut edges and vertices for better control -->
        <Macro Name = "CutE" >
            <Cut><Plane NormVector = "Ex[i]; Ey[i]; Ez[i]" NormDistance = "-CutE" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutE" i = "0" Repeat = "12" />-->

        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV" /></Cut>
            <HideContaining Vector = "Vx[i]*0.9; Vy[i]*0.9; Vz[i]*0.9" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "6" />

        <Macro Name = "CutV" >
            <Cut><Plane NormVector = "Vx[i]; Vy[i]; Vz[i]" NormDistance = "-CutV1" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" i = "0" Repeat = "6" />

        <ShowAll/>
    </Figure>
</xml>
