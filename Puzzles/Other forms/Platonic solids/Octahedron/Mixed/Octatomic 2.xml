<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octatomic 2</Name>
        <Menu>Other forms\Octahedron\Mixed\Octatomic 2</Menu>
        <Inventor>El Cubitero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2026-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12411</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';

        W := 0.75;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';

        JumAngle := Arccos(1/3);

        D1 := W * 0.3;
        D2 := (W - D1) / sqrt(2);
        P := 1.33; // pillow

        for i := 0 to 7 do begin
            CPx[i] := Cx[i] * P;
            CPy[i] := Cy[i] * P;
            CPz[i] := Cz[i] * P;
        end;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes NormVectors = " Ex; Ey; Ez" PlaneDistances = "D2" TurningAngles = "0; Pi" JumbleAngle = "JumAngle" />

    <Figure>
        <Macro Name = "Side" >
            <Face Color = "Colors[cl]" VertexIndexes = "v1;v2;c" InvisibleEdges = "6" />
            <Face Color = "Colors[cl]" VertexIndexes = "v2;v3;c" InvisibleEdges = "6" />
            <Face Color = "Colors[cl]" VertexIndexes = "v3;v1;c" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "CPx; CPy; CPz" />

            <Faces>
                <ExecMacro MacroName = "Side" cl = "0" c = " 6" v1 = "0" v2 = "2" v3 = "5" />
                <ExecMacro MacroName = "Side" cl = "1" c = " 7" v1 = "5" v2 = "2" v3 = "1" />
                <ExecMacro MacroName = "Side" cl = "2" c = " 8" v1 = "5" v2 = "1" v3 = "3" />
                <ExecMacro MacroName = "Side" cl = "3" c = " 9" v1 = "5" v2 = "3" v3 = "0" />
                <ExecMacro MacroName = "Side" cl = "4" c = "10" v1 = "4" v2 = "2" v3 = "0" />
                <ExecMacro MacroName = "Side" cl = "5" c = "11" v1 = "4" v2 = "1" v3 = "2" />
                <ExecMacro MacroName = "Side" cl = "6" c = "12" v1 = "4" v2 = "3" v3 = "1" />
                <ExecMacro MacroName = "Side" cl = "7" c = "13" v1 = "4" v2 = "0" v3 = "3" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
