<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SuperZ Octa</Name>
        <Menu>Other forms\Octahedron\Mixed\SuperZ Octa</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-04-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10909</Link>
    </Interface>

    <Script>
        W := 0.75;
        DCut := W * 0.9;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /> </Cut>
    </Figure>
</xml>
