<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Outlander Octahedron</Name>
        <Menu>Other forms\Octahedron\Mixed\Outlander Octahedron</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-06-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11192</Link>
    </Interface>

    <Script>
        Colors[0] := '00CC00'; // Green
        Colors[1] := 'FFFFFF'; // White
        Colors[2] := 'FFFF33'; // Yellow
        Colors[3] := 'FF7700'; // Orange
        Colors[4] := 'EE0000'; // Red
        Colors[5] := '0000EE'; // Blue
        Colors[6] := 'CC00DD'; // Rose
        Colors[7] := '0066FF'; // LightBlue

        W := 1.5 * 0.5;

        D1 := W * sqrt(2) / 3;
        D2 := W / sqrt(3);
        Sc := 1.1;
        //RC := (3 * D1 - W * Sc) * sqrt(2/3);
        RC := W * 0.35;
        DCut := W * 0.4;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />

        <SplitByAxes/>

        <RemoveContaining Vector = "Ex; Ey; Ez" />

        <Macro Name = "AddCircle" >
            <Cylinder Radius = "RC" Color = "Colors[i]" >
                <Base X = "Cx[i]" Y = "Cy[i]" Z = "Cz[i]" />
                <Top  X = "Cx[i] * Sc" Y = "Cy[i] * Sc" Z = "Cz[i] * Sc" Color = "Colors[i]" />
            </Cylinder>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" Repeat = "8" i = "0" />

        <InvertVisibility/>

        <Script>
            for i := 0 to 7 do
              Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Octahedron.xml" />

        <SplitByAxes/>

        <HideContaining Vector = "Ex; Ey; Ez" />

        <RemoveAllVisible/>

        <ShowAll/>
        <SplitByAxes/>

        <Hide><Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /></Hide>
    </Figure>
</xml>
