<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Jumble Octahedron</Name>
        <Menu>Other forms\Octahedron\Jumble Octahedron</Menu>
        <Inventor>Casey Mihaloew</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2020-04-14</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=35520</Link>
    </Interface>

    <Script>
        W := 0.75;

        D := W / sqrt(11);

        A1 := ArcCos(19 / 30); // 0.884
        A2 := ArcCos( 7 / 18); // 1.171
        A3 := ArcCos(-1 / 10); // 1.670
        A4 := ArcCos(-7 / 15); // 2.056
        A5 := ArcCos(-5 /  6); // 2.555
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A5;-A4;-A3;-A2;-A1; 0; A1; A2; A3; A4; A5" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = " 1; 1;-3" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = "-1;-1;-3" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = "-3; 1; 1" />
        <Axis NormVector = "-3;-1;-1" />
        <Axis NormVector = " 1;-3; 1" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = "-1;-3;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
