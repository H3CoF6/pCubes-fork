<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodec 123</Name>
        <Menu>Other forms\Dodecahedron\Edge Turning\Dodec 123</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8053</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * (sqrt(5) - 1) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi " PlaneDistances = "0" >
        <Axis NormVector = "Ex[3]; Ey[3]; Ez[3]" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D/2; D/2" >
        <Axis NormVector = "Ex[6]; Ey[6]; Ez[6]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
