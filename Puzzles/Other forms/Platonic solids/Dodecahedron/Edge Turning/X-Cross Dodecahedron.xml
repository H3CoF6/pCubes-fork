<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-Cross Dodecahedron</Name>
        <Menu>Other forms\Dodecahedron\Edge Turning\X-Cross Dodecahedron</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4419</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D2 := R / sqrt(3);
        D1 := D2 / 3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = "Ex[ 0]; Ey[ 0]; Ez[ 0]" />
        <Axis NormVector = "Ex[ 8]; Ey[ 8]; Ez[ 8]" />
        <Axis NormVector = "Ex[14]; Ey[14]; Ez[14]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
