<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodecahedron 4x4x4</Name>
        <Menu>Other forms\Dodecahedron\Edge Turning\Dodecahedron 4x4x4</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-03-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3769</Link>
     </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        D := R / sqrt(12);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "Ex[ 3]; Ey[ 3]; Ez[ 3]" />
        <Axis NormVector = "Ex[ 6]; Ey[ 6]; Ez[ 6]" />
        <Axis NormVector = "Ex[12]; Ey[12]; Ez[12]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>

</xml>
