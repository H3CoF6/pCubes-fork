                <Face Color = "Colors[ 3]" VertexIndexes = "12; 7;23" InvisibleEdges = "6" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 7; 2;23" InvisibleEdges = "6" />

                <Face Color = "Colors[ 4]" VertexIndexes = " 3; 4;24" InvisibleEdges = "6" />
