                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 1;21" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 1; 6;21" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 6;10;21" InvisibleEdges = "6" />
                <Face Color = "Colors[ 1]" VertexIndexes = "10; 5;21" InvisibleEdges = "6" />
