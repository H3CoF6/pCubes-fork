<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodecacopter II</Name>
        <Menu>Other forms\Dodecahedron\Edge Turning\Dodecacopter II</Menu>
        <Inventor>Sharon Avidor and Matthew Ray</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1742</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D := R * sqrt(3) * (Sqrt(5) + 3) / 12;
        k := 1.20;
        for i := 0 to 11 do begin
            Cx1[i] := Cx[i] * k;
            Cy1[i] := Cy[i] * k;
            Cz1[i] := Cz[i] * k;
        end;
    </Script>

    <Axes TurningAngles = "0; Pi" JumbleAngle = "arctan(2)" PlaneDistances = "D" NormVectors = "Ex; Ey; Ez" />

    <Figure>
        <Part>
            <Vertices Vectors = "vx; vy; vz" />
            <Vertices Vectors = "Cx1; Cy1; Cz1" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 4; 3;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 3; 2;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 2; 1;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 1; 0;20" InvisibleEdges = "6" />
