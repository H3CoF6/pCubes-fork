            <Hide Axis = "a2" Layer = "l2" />
            <Hide Axis = "a3" Layer = "l3" />
            <Hide Axis = "a4" Layer = "l4" />
            <Hide Axis = "a5" Layer = "l5" />
            <Cut> <Plane NormVector = "cx[ix]; cy[ix]; cz[ix]" NormDistance = "RCut" /> </Cut>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "Cut" ix = " 0" a1 = " 5" l1 = "0" a2 = " 9" l2 = "0" a3 = " 8" l3 = "0" a4 = " 7" l4 = "0" a5 = " 6" l5 = "0" />
