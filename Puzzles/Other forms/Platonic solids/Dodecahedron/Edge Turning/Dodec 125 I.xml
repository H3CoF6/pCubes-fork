        <Added>2020-08-16</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36039</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi " PlaneDistances = "0" >
        <Axis NormVector = "Ex[ 3]; Ey[ 3]; Ez[ 3]" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; -D/3; D/3; D" >
        <Axis NormVector = "Ex[6]; Ey[6]; Ez[6]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
