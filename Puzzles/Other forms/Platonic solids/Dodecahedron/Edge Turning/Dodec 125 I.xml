<xml Data_Version = "2" >

    <Interface>
        <Name>Dodec 125 I</Name>
        <Menu>Other forms\Dodecahedron\Edge Turning\Dodec 125 I</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
