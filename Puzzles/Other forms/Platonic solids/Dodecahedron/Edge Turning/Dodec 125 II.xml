<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodec 125 II</Name>
        <Menu>Other forms\Dodecahedron\Edge Turning\Dodec 125 II</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8308</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi/2 " PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "Ex[3]; Ey[3]; Ez[3]" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; -D/3; D/3; D" >
        <Axis NormVector = "Ex[6]; Ey[6]; Ez[6]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Split Axis = "0" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = "-Pi/2" />
        <SplitByAxes/>
        <Undo/>
    </Figure>
</xml>
