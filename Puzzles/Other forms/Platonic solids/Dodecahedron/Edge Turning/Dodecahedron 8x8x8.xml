<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodecahedron 8x8x8</Name>
        <Aliases>Octa Penta Dodec</Aliases>
        <Menu>Other forms\Dodecahedron\Edge Turning\Dodecahedron 8x8x8</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3604</Link>
     </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        D := R * (sqrt(5) - 1) / sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3;-D*2;-D; 0; D; D*2; D*3" >
        <Axis NormVector = "Ex[ 3]; Ey[ 3]; Ez[ 3]" />
        <Axis NormVector = "Ex[ 6]; Ey[ 6]; Ez[ 6]" />
        <Axis NormVector = "Ex[12]; Ey[12]; Ez[12]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
