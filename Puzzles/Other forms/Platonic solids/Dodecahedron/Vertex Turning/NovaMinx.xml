<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>NovaMinx</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\NovaMinx</Menu>
        <Inventor>Luke Benjii</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3373</Link>
        <Link>https://www.youtube.com/watch?v=H4aJF_thiHs</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        JumAngle := Arcsin(1/4) + Pi/6;

        D := R * ((4 * sqrt(5) + 5) / 33);
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" JumbleAngle = "jumAngle" PlaneDistances = "D" NormVectors = "Vx; Vy; Vz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
