<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Radio 3 Dodecahedron</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Radio 3 Dodecahedron</Menu>
        <Inventor>Anthone Poole</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7785</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0000CC'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := '800080'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0066CC'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF88CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := 0.61 * R;
        jumAngle := Arcsin(1/4) + Pi/6;

        k := 1.20;
        for i := 0 to 11 do begin
          Cx[i] := Cx[i] * k;
          Cy[i] := Cy[i] * k;
          Cz[i] := Cz[i] * k;
        end;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3"  JumbleAngle = "jumAngle" PlaneDistances = "D" NormVectors = " Vx; Vy; Vz" />

    <Figure>
        <Macro Name = "AddFace" >
            <Face Color = "Colors[cl]" VertexIndexes = "i5;i4;i0" InvisibleEdges = "6" />
            <Face Color = "Colors[cl]" VertexIndexes = "i4;i3;i0" InvisibleEdges = "6" />
            <Face Color = "Colors[cl]" VertexIndexes = "i3;i2;i0" InvisibleEdges = "6" />
            <Face Color = "Colors[cl]" VertexIndexes = "i2;i1;i0" InvisibleEdges = "6" />
            <Face Color = "Colors[cl]" VertexIndexes = "i1;i5;i0" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = " Vx; Vy; Vz" />
            <Vertices Vectors = " Cx; Cy; Cz" />

            <Faces>
                <ExecMacro MacroName = "AddFace" cl = " 0" i0 = "20" i1 = " 0" i2 = " 1" i3 = " 2" i4 = " 3" i5 = " 4"/>
                <ExecMacro MacroName = "AddFace" cl = " 1" i0 = "21" i1 = " 5" i2 = "10" i3 = " 6" i4 = " 1" i5 = " 0"/>
                <ExecMacro MacroName = "AddFace" cl = " 2" i0 = "22" i1 = " 6" i2 = "11" i3 = " 7" i4 = " 2" i5 = " 1"/>
                <ExecMacro MacroName = "AddFace" cl = " 3" i0 = "23" i1 = " 7" i2 = "12" i3 = " 8" i4 = " 3" i5 = " 2"/>
                <ExecMacro MacroName = "AddFace" cl = " 4" i0 = "24" i1 = " 8" i2 = "13" i3 = " 9" i4 = " 4" i5 = " 3"/>
                <ExecMacro MacroName = "AddFace" cl = " 5" i0 = "25" i1 = " 9" i2 = "14" i3 = " 5" i4 = " 0" i5 = " 4"/>
                <ExecMacro MacroName = "AddFace" cl = " 6" i0 = "26" i1 = "13" i2 = " 8" i3 = "12" i4 = "17" i5 = "18"/>
                <ExecMacro MacroName = "AddFace" cl = " 7" i0 = "27" i1 = "14" i2 = " 9" i3 = "13" i4 = "18" i5 = "19"/>
                <ExecMacro MacroName = "AddFace" cl = " 8" i0 = "28" i1 = "10" i2 = " 5" i3 = "14" i4 = "19" i5 = "15"/>
                <ExecMacro MacroName = "AddFace" cl = " 9" i0 = "29" i1 = "11" i2 = " 6" i3 = "10" i4 = "15" i5 = "16"/>
                <ExecMacro MacroName = "AddFace" cl = "10" i0 = "30" i1 = "12" i2 = " 7" i3 = "11" i4 = "16" i5 = "17"/>
                <ExecMacro MacroName = "AddFace" cl = "11" i0 = "31" i1 = "19" i2 = "18" i3 = "17" i4 = "16" i5 = "15"/>
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Macros>
        <Macro Name = "RandomTurns120" >
            <Turn Axis = "Random(20)" Layer = "1" Angle = "2*Pi/3"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(20)" Layer = "1" Angle = "2 * Pi * Random"/>
        </Macro>
        <Macro Name = "Scramble120" Public = "1" >
            <ExecMacro MacroName = "RandomTurns120" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble120" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
