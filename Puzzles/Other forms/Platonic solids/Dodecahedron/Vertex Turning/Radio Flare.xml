<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Radio Flare</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Radio Flare</Menu>
        <Inventor>Ian Henriksen</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-07-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11270</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        JumAngle := Arcsin(1/4) + Pi/6;

        D := R * 0.45;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" JumbleAngle = "jumAngle" PlaneDistances = "D" NormVectors = "Vx; Vy; Vz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
