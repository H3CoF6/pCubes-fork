<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodecahedral Dino</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Dino</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-23</Added>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * (Sqrt(5) + 1) / 6;
    </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D; D" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
