<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Phekda Dodecahedron</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Phekda Dodecahedron</Menu>
        <Inventor>Wei-Chen Guo</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-12-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12259</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (sqrt(5) - 2) / 3 * R;

        JumAngle := Arcsin( 1 / 4) + Pi / 6;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" JumbleAngle = "JumAngle" PlaneDistances = "D" NormVectors = " Vx; Vy; Vz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "InnerCut" >
            <Hide><Plane NormVector = "Cx[i];Cy[i];Cz[i]" NormDistance = "R * 0.5" /> </Hide>
            <Cut> <Plane NormVector = "Cx[i];Cy[i];Cz[i]" NormDistance = "R * 0.4" /> </Cut>
            <Hide><Plane NormVector = "Cx[i];Cy[i];Cz[i]" NormDistance = "R * 0.6" /> </Hide>
            <Cut> <Plane NormVector = "Cx[i];Cy[i];Cz[i]" NormDistance = "R * 0.5" /> </Cut>
            <ShowAll/>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "InnerCut" i = "0" Repeat = "12" />
    </Figure>
</xml>
