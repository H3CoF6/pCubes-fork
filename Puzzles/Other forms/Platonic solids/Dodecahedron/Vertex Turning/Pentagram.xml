<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentagram</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Pentagram</Menu>
        <Inventor>Eric Vergo</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-04-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1982</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * (Sqrt(5) + 1) / 6;

        jumAngle := Arcsin(1/4) + Pi/6;

    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" JumbleAngle = "jumAngle" PlaneDistances = "D" NormVectors = "Vx; Vy; Vz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
