<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Radio Shock</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Radio Shock</Menu>
        <Menu>Other forms\Multi-puzzles\Radio Shock</Menu>
        <Inventor>Ian Henriksen</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-12-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11340</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := R * 0.4;
        JumAngle := Arcsin(1/4) + Pi/6;

        D2 := RSin * 0.96;
        D3 := RSin * 0.2;
        D4 := R * 0.08;
    </Script>

    <Axes TurningAngles = " 0; 2*Pi/3" JumbleAngle = "JumAngle" PlaneDistances = " D1" NormVectors = " Vx; Vy; Vz" />

    <Figure>
        <Macro Name = "CutCenters" >
            <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " Cx[i]; Cy[i]; Cz[i]" NormDistance = " D3" /> </Split>
            <Script>inc(i);</Script>
        </Macro>

        <Macro Name = "CutEdges" >
            <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " Cx[i]; Cy[i]; Cz[i]" NormDistance = " D4" /> </Split>
            <Script>inc(i);</Script>
        </Macro>

        <Macro Name = "SplitFaces" >
            <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " Cx[i]; Cy[i]; Cz[i]" NormDistance = " D2" /> </Split>
            <Script>inc(i);</Script>
        </Macro>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>

        <HideContaining Vector = " Cx; Cy; Cz" />
        <InvertVisibility/>
        <ExecMacro MacroName = "CutCenters" i = "0" Repeat = "12" />
        <RemoveContaining Vector = " Cx; Cy; Cz" />
        <ShowAll/>

        <HideContaining Vector = " Ex; Ey; Ez" />
        <InvertVisibility/>
        <ExecMacro MacroName = "CutEdges" i = "0" Repeat = "12" />
        <RemoveContaining Vector = " Ex; Ey; Ez" />
        <ShowAll/>
        <RemoveGrayParts/>

        <ExecMacro MacroName = "SplitFaces" i = "0" Repeat = "12" />
        <RemoveGrayParts/>

        <Script> R := 0.48; </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>

    </Figure>
</xml>
