<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodoctahedron Master</Name>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Dodoctahedron Master</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6955</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R / 3;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>

   <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
   </Figure>
</xml>
