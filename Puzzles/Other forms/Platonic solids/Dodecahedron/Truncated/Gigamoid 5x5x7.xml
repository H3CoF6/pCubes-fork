<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gigamoid 5x5x7</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Gigamoid 5x5x7</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-06-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9738</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (5 * Rsin + 1 * R2sin) / 6;
        D2 := (4 * Rsin + 2 * R2sin) / 6;
        D3 := (3 * Rsin + 3 * R2sin) / 6;

        DCut := D1 + 0.002;
    </Script>

    <Axes TurningAngles = " sAngle; sAngle; sAngle; 0; sAngle; sAngle; sAngle" PlaneDistances = "-D1;-D2;-D3; D3; D2; D1" >
        <Axis NormVector = " Cx[0]; Cy[0]; Cz[0]" />
    </Axes>

    <Axes TurningAngles = " sAngle; sAngle; 0; sAngle; sAngle" PlaneDistances = "-D2;-D3; D3; D2" >
        <Axis NormVector = " Cx[ 1]; Cy[ 1]; Cz[ 1]" />
        <Axis NormVector = " Cx[ 2]; Cy[ 2]; Cz[ 2]" />
        <Axis NormVector = " Cx[ 3]; Cy[ 3]; Cz[ 3]" />
        <Axis NormVector = " Cx[ 4]; Cy[ 4]; Cz[ 4]" />
        <Axis NormVector = " Cx[ 5]; Cy[ 5]; Cz[ 5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "Colors[ 1]" > <Plane NormVector = "-Cx[ 1];-Cy[ 1];-Cz[ 1]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 2]" > <Plane NormVector = "-Cx[ 2];-Cy[ 2];-Cz[ 2]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 3]" > <Plane NormVector = "-Cx[ 3];-Cy[ 3];-Cz[ 3]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 4]" > <Plane NormVector = "-Cx[ 4];-Cy[ 4];-Cz[ 4]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 5]" > <Plane NormVector = "-Cx[ 5];-Cy[ 5];-Cz[ 5]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 6]" > <Plane NormVector = "-Cx[ 6];-Cy[ 6];-Cz[ 6]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 7]" > <Plane NormVector = "-Cx[ 7];-Cy[ 7];-Cz[ 7]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 8]" > <Plane NormVector = "-Cx[ 8];-Cy[ 8];-Cz[ 8]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 9]" > <Plane NormVector = "-Cx[ 9];-Cy[ 9];-Cz[ 9]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[10]" > <Plane NormVector = "-Cx[10];-Cy[10];-Cz[10]" NormDistance = "-DCut" /> </Cut>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
