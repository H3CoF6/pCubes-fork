<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megamoid</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Megamoid</Menu>
        <Inventor>Nathan Hard</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4995</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
        DCut := D + 0.002;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "clWhite " > <Plane NormVector = "0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "0; 0;-1" NormDistance = "-DCut" /> </Cut>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
