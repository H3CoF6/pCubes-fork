<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Halfminx II</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Halfminx II</Menu>
        <Inventor>Spencer G.</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-04</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" >
        <Axis NormVector = " Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = " Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = " Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = " Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = " Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = " Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "404040" > <Plane NormVector = "Cx[0]; Cy[0]; Cz[0]" NormDistance = "-D" /> </Cut>

        <SplitByAxes/>

        <Split> <Plane NormDistance = "-D" NormVector = " Cx[1]; Cy[1]; Cz[1]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = " Cx[2]; Cy[2]; Cz[2]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = " Cx[3]; Cy[3]; Cz[3]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = " Cx[4]; Cy[4]; Cz[4]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = " Cx[5]; Cy[5]; Cz[5]" /> </Split>

        <RemoveGrayParts/>
    </Figure>
</xml>
