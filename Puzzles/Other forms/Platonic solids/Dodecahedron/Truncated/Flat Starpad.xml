<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Flat Starpad</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Flat Starpad</Menu>
        <Inventor>Hyun-Sung Oh</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-04-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4669</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * sqrt(5) / 3;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "404040" > <Plane NormVector = "Cx[0]; Cy[0]; Cz[0]" NormDistance = "R2Sin" /> </Cut>

        <SplitByAxes/>

        <Split> <Plane NormDistance = "D" NormVector = "Vx[5]; Vy[5]; Vz[5]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[6]; Vy[6]; Vz[6]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[7]; Vy[7]; Vz[7]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[8]; Vy[8]; Vz[8]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[9]; Vy[9]; Vz[9]" /> </Split>

        <RemoveGrayParts/>
    </Figure>
</xml>
