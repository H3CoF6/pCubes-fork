<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dinobar</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Dinobar</Menu>
        <Inventor>Hyun-Sung Oh</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4574</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * sqrt(5) / 3;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D" >
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "404040" > <Plane NormVector = "Cx[0]; Cy[0]; Cz[0]" NormDistance = "R2sin" /> </Cut>
        <Cut Color = "404041" > <Plane NormVector = "Cx[3]; Cy[3]; Cz[3]" NormDistance = "R2sin" /> </Cut>

        <SplitByAxes/>

        <Split> <Plane NormDistance = "D" NormVector = "Vx[1]; Vy[1]; Vz[1]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[4]; Vy[4]; Vz[4]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[7]; Vy[7]; Vz[7]" /> </Split>
        <Split> <Plane NormDistance = "D" NormVector = "Vx[8]; Vy[8]; Vz[8]" /> </Split>

        <RemoveGrayParts/>
    </Figure>
</xml>
