<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gigaminx Open</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Gigaminx Open</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-08-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3637</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; 0" PlaneDistances = "-D1; -D2" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut> <Plane NormVector = "-Cx[0]; -Cy[0]; -Cz[0]" NormDistance = "-D2" /> </Cut>
        <Cut> <Plane NormVector = "-Cx[2]; -Cy[2]; -Cz[2]" NormDistance = "-D2" /> </Cut>
        <Cut> <Plane NormVector = "-Cx[3]; -Cy[3]; -Cz[3]" NormDistance = "-D2" /> </Cut>

        <Macro Name = "Split" >
            <Split> <Plane NormVector = " Cx[i];  Cy[i];  Cz[i]" NormDistance = "-D2" /> </Split>
            <Split> <Plane NormVector = " Cx[i];  Cy[i];  Cz[i]" NormDistance = "-D1" /> </Split>
            <Split> <Plane NormVector = " Cx[i];  Cy[i];  Cz[i]" NormDistance = " D1" /> </Split>
            <Split> <Plane NormVector = " Cx[i];  Cy[i];  Cz[i]" NormDistance = " D2" /> </Split>
        </Macro>

        <ExecMacro MacroName = "Split" i = "1" />
        <ExecMacro MacroName = "Split" i = "4" />
        <ExecMacro MacroName = "Split" i = "5" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
