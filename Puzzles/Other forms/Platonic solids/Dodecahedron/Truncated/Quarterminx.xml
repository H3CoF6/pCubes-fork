<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Quarterminx</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Quarterminx</Menu>
        <Inventor>Rex Rossano Perez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5269</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
        WSlot := 0.0005;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <SplitByAxes/>

        <Cut Color = "404040" > <Plane NormVector = "Vx[2]; Vy[2]; Vz[2]" NormDistance = "0" /> </Cut>
        <Cut Color = "404040" > <Plane NormVector = "Vx[3]; Vy[3]; Vz[3]" NormDistance = "0" /> </Cut>

        <HideContaining Vector = "0; 0; 0" />
        <Split> <Plane NormDistance = "-D" NormVector = "Cx[ 1]; Cy[ 1]; Cz[ 1]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = "Cx[ 5]; Cy[ 5]; Cz[ 5]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = "Cx[ 6]; Cy[ 6]; Cz[ 6]" /> </Split>
        <Split> <Plane NormDistance = "-D" NormVector = "Cx[10]; Cy[10]; Cz[10]" /> </Split>
        <Split> <Plane NormDistance = " D" NormVector = "Cx[ 2]; Cy[ 2]; Cz[ 2]" /> </Split>
        <Split> <Plane NormDistance = " D" NormVector = "Cx[ 4]; Cy[ 4]; Cz[ 4]" /> </Split>
        <ShowAll/>

        <Part>
            <Vertices>
                <Add Vector = " WSlot;  WSlot;      0" />
                <Add Vector = "Ex[ 5]; Ey[ 5]; Ez[ 5]" />
                <Add Vector = "Ex[ 6]; Ey[ 6]; Ez[ 6]" />
                <Add Vector = "Ex[16]; Ey[16]; Ez[16]" />
                <Add Vector = "Ex[22]; Ey[22]; Ez[22]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 1]"  VertexIndexes = "0;1;2" />
                <Face Color = "Colors[ 2]"  VertexIndexes = "0;2;3" />
                <Face Color = "Colors[10]"  VertexIndexes = "0;3;4" />
                <Face                       VertexIndexes = "4;3;2;1" />
                <Face                       VertexIndexes = "0;4;1" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WSlot;      0;      0" />
                <Add Vector = "Ex[22]; Ey[22]; Ez[22]" />
                <Add Vector = "Ex[13]; Ey[13]; Ez[13]" />
                <Add Vector = "Ex[ 9]; Ey[ 9]; Ez[ 9]" />
                <Add Vector = "Ex[ 5]; Ey[ 5]; Ez[ 5]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[6]"   VertexIndexes = "0;1;2" />
                <Face Color = "Colors[4]"   VertexIndexes = "0;2;3" />
                <Face Color = "Colors[5]"   VertexIndexes = "0;3;4" />
                <Face                       VertexIndexes = "4;3;2;1" />
                <Face                       VertexIndexes = "0;4;1" />
            </Faces>
        </Part>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
