<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mini 25-minx decagonal prism</Name>
        <Menu>Other forms\Dodecahedron\Truncated\Mini 25-minx decagonal prism</Menu>
        <Inventor>Ilya Toporgilka</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11178</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D := (Rsin + R2sin) / 2;
        DCut := D + 0.02;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = " Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = " Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = " Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = " Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = " Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "Colors[11]" VertexIndexes = " 4; 3; 2; 1; 0" />

                <Face Color = "Colors[ 8]" VertexIndexes = "20;10; 5; 0" InvisibleEdges = "1" />
                <Face Color = "Colors[ 5]" VertexIndexes = "10;20; 1; 6" InvisibleEdges = "1" />

                <Face Color = "Colors[ 6]" VertexIndexes = "21;11; 6; 1" InvisibleEdges = "1" />
                <Face Color = "Colors[ 1]" VertexIndexes = "11;21; 2; 7" InvisibleEdges = "1" />

                <Face Color = "Colors[ 9]" VertexIndexes = "22;12; 7; 2" InvisibleEdges = "1" />
                <Face Color = "Colors[ 3]" VertexIndexes = "12;22; 3; 8" InvisibleEdges = "1" />

                <Face Color = "Colors[ 4]" VertexIndexes = "23;13; 8; 3" InvisibleEdges = "1" />
                <Face Color = "Colors[10]" VertexIndexes = "13;23; 4; 9" InvisibleEdges = "1" />

                <Face Color = "Colors[ 2]" VertexIndexes = "24;14; 9; 4" InvisibleEdges = "1" />
                <Face Color = "Colors[ 0]" VertexIndexes = "14;24; 0; 5" InvisibleEdges = "1" />


                <Face Color = "Colors[ 4]" VertexIndexes = "47; 8;13;18" InvisibleEdges = "1" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 8;47;17;12" InvisibleEdges = "1" />

                <Face Color = "Colors[ 2]" VertexIndexes = "48; 9;14;19" InvisibleEdges = "1" />
                <Face Color = "Colors[10]" VertexIndexes = " 9;48;18;13" InvisibleEdges = "1" />

                <Face Color = "Colors[ 8]" VertexIndexes = "49; 5;10;15" InvisibleEdges = "1" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 5;49;19;14" InvisibleEdges = "1" />

                <Face Color = "Colors[ 6]" VertexIndexes = "45; 6;11;16" InvisibleEdges = "1" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 6;45;15;10" InvisibleEdges = "1" />

                <Face Color = "Colors[ 9]" VertexIndexes = "46; 7;12;17" InvisibleEdges = "1" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 7;46;16;11" InvisibleEdges = "1" />

                <Face Color = "Colors[ 7]" VertexIndexes = "15;16;17;18;19" />
            </Faces>
        </Part>

        <Cut Color = "Colors[ 7]" > <Plane NormVector = "0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "0; 0;-1" NormDistance = "-DCut" /> </Cut>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
