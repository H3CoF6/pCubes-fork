<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x5 Megaminx</Name>
        <Menu>Other forms\Dodecahedron\Truncated\3x3x5 Megaminx</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9736</Link>
    </Interface>

    <Script>
        R := 0.6;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D1 := Rsin * 0.75;
        D2 := RSin * 0.995;

        DCut1 := RSin;
        DCut2 := 2 * RSin - D1;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; 0; sAngle; sAngle" PlaneDistances = "-D1; -D2; D2; D1" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
    </Axes>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "R * 2" Color = "-1" />

        <Macro Name = "CutColor">
            <Cut Color = "Colors[id]" > <Plane NormVector = "-Cx[id]; -Cy[id]; -Cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" id = " 0" DCut = "DCut2" />
        <ExecMacro MacroName = "CutColor" id = " 1" DCut = "DCut1" Repeat = "10" />
        <ExecMacro MacroName = "CutColor" id = "11" DCut = "DCut2" />

        <SplitByAxes/>
    </Figure>
</xml>
