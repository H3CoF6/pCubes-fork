    <Interface>
        <Name>Starminx III</Name>
        <Menu>Other forms\Dodecahedron\Starminx\Starminx III</Menu>
        <Menu>Other forms\Dodecahedron\Vertex Turning\Starminx III</Menu>
        <Inventor>Andrew Cormier</Inventor>
