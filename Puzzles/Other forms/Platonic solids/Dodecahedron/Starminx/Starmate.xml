<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Starmate</Name>
        <Menu>Other forms\Dodecahedron\Starminx\Starmate</Menu>
        <Menu>Other forms\Dodecahedron\Face Turning\Starmate</Menu>
        <Inventor>Wu Yuan</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11398</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        
        D := R2sin;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
