<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hectominx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Kilominx\Hectominx</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-09-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6741</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;

        DCut := RSin;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; 0; sAngle; sAngle" PlaneDistances = "-D1; -D2; D2; D1" >
        <Axis NormVector = "cx[0]; cy[0]; cz[0]" />
        <Axis NormVector = "cx[1]; cy[1]; cz[1]" />
        <Axis NormVector = "cx[2]; cy[2]; cz[2]" />
        <Axis NormVector = "cx[3]; cy[3]; cz[3]" />
        <Axis NormVector = "cx[4]; cy[4]; cz[4]" />
        <Axis NormVector = "cx[5]; cy[5]; cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <Macro Name = "Split">
            <Split Axis = "id" From = "1" />
            <Split Axis = "id" From = "4" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" id = "0" />
        <RemoveContaining Vector = "0; 0; 0" />

        <SplitByAxes/>

        <Macro Name = "Hide">
            <HideContaining Vector = "0.9*Ex[id]; 0.9*Ey[id]; 0.9*Ez[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Hide" Repeat = "30" id = "0" />

        <Macro Name = "CutColor">
            <Cut Color = "Colors[id]" > <Plane NormVector = "-cx[id]; -cy[id]; -cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" Repeat = "12" id = "0" />

        <ShowAll/>

        <Macro Name = "CutGray">
            <Cut> <Plane NormVector = "-cx[id]; -cy[id]; -cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutGray" Repeat = "12" id = "0" />-->

    </Figure>
</xml>
