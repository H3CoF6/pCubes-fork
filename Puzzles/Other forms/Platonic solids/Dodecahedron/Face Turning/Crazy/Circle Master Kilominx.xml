<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Circle Master Kilominx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Crazy\Circle Master Kilominx</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-02</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;
        RC := R * 0.395;
        D3 := RSin;
        L := 1.001;

        // vertex indexes around centers (e.g. there are vertexes # 0 4 3 2 1 around center # 0)     and centers indexes
        v[ 0, 0] :=  0; v[ 0, 1] :=  4; v[ 0, 2] :=  3; v[ 0, 3] :=  2; v[ 0, 4] :=  1; c[ 0, 0] :=  5; c[ 0, 1] :=  4; c[ 0, 2] :=  3; c[ 0, 3] :=  2; c[ 0, 4] :=  1;
        v[ 1, 0] :=  1; v[ 1, 1] :=  6; v[ 1, 2] := 10; v[ 1, 3] :=  5; v[ 1, 4] :=  0; c[ 1, 0] :=  2; c[ 1, 1] :=  9; c[ 1, 2] :=  8; c[ 1, 3] :=  5; c[ 1, 4] :=  0;
        v[ 2, 0] :=  2; v[ 2, 1] :=  7; v[ 2, 2] := 11; v[ 2, 3] :=  6; v[ 2, 4] :=  1; c[ 2, 0] :=  3; c[ 2, 1] := 10; c[ 2, 2] :=  9; c[ 2, 3] :=  1; c[ 2, 4] :=  0;
        v[ 3, 0] :=  3; v[ 3, 1] :=  8; v[ 3, 2] := 12; v[ 3, 3] :=  7; v[ 3, 4] :=  2; c[ 3, 0] :=  4; c[ 3, 1] :=  6; c[ 3, 2] := 10; c[ 3, 3] :=  2; c[ 3, 4] :=  0;
        v[ 4, 0] :=  4; v[ 4, 1] :=  9; v[ 4, 2] := 13; v[ 4, 3] :=  8; v[ 4, 4] :=  3; c[ 4, 0] :=  5; c[ 4, 1] :=  7; c[ 4, 2] :=  6; c[ 4, 3] :=  3; c[ 4, 4] :=  0;
        v[ 5, 0] :=  0; v[ 5, 1] :=  5; v[ 5, 2] := 14; v[ 5, 3] :=  9; v[ 5, 4] :=  4; c[ 5, 0] :=  1; c[ 5, 1] :=  8; c[ 5, 2] :=  7; c[ 5, 3] :=  4; c[ 5, 4] :=  0;
        v[ 6, 0] := 17; v[ 6, 1] := 12; v[ 6, 2] :=  8; v[ 6, 3] := 13; v[ 6, 4] := 18; c[ 6, 0] := 10; c[ 6, 1] :=  3; c[ 6, 2] :=  4; c[ 6, 3] :=  7; c[ 6, 4] := 11;
        v[ 7, 0] := 18; v[ 7, 1] := 13; v[ 7, 2] :=  9; v[ 7, 3] := 14; v[ 7, 4] := 19; c[ 7, 0] :=  6; c[ 7, 1] :=  4; c[ 7, 2] :=  5; c[ 7, 3] :=  8; c[ 7, 4] := 11;
        v[ 8, 0] := 19; v[ 8, 1] := 14; v[ 8, 2] :=  5; v[ 8, 3] := 10; v[ 8, 4] := 15; c[ 8, 0] :=  7; c[ 8, 1] :=  5; c[ 8, 2] :=  1; c[ 8, 3] :=  9; c[ 8, 4] := 11;
        v[ 9, 0] := 15; v[ 9, 1] := 10; v[ 9, 2] :=  6; v[ 9, 3] := 11; v[ 9, 4] := 16; c[ 9, 0] :=  8; c[ 9, 1] :=  1; c[ 9, 2] :=  2; c[ 9, 3] := 10; c[ 9, 4] := 11;
        v[10, 0] := 16; v[10, 1] := 11; v[10, 2] :=  7; v[10, 3] := 12; v[10, 4] := 17; c[10, 0] :=  9; c[10, 1] :=  2; c[10, 2] :=  3; c[10, 3] :=  6; c[10, 4] := 11;
        v[11, 0] := 15; v[11, 1] := 16; v[11, 2] := 17; v[11, 3] := 18; v[11, 4] := 19; c[11, 0] :=  9; c[11, 1] := 10; c[11, 2] :=  6; c[11, 3] :=  7; c[11, 4] :=  8;

        M := sqrt(6 * (5 - sqrt(5))) / 4;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D1;-D2; -D3; D3; D2; D1" FixedLayers = "3" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "Dodecahedron">
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />

                <Faces>
                    <Face Color = "Colors[ 0]" VertexIndexes = "4;3;2;1;0" />
                    <Face Color = "Colors[ 1]" VertexIndexes = "0;1;6;10;5" />
                    <Face Color = "Colors[ 2]" VertexIndexes = "1;2;7;11;6" />
                    <Face Color = "Colors[ 3]" VertexIndexes = "2;3;8;12;7" />
                    <Face Color = "Colors[ 4]" VertexIndexes = "3;4;9;13;8" />
                    <Face Color = "Colors[ 5]" VertexIndexes = "4;0;5;14;9" />
                    <Face Color = "Colors[ 6]" VertexIndexes = "18;17;12;8;13" />
                    <Face Color = "Colors[ 7]" VertexIndexes = "19;18;13;9;14" />
                    <Face Color = "Colors[ 8]" VertexIndexes = "15;19;14;5;10" />
                    <Face Color = "Colors[ 9]" VertexIndexes = "16;15;10;6;11" />
                    <Face Color = "Colors[10]" VertexIndexes = "17;16;11;7;12" />
                    <Face Color = "Colors[11]" VertexIndexes = "15;16;17;18;19" />
                </Faces>
            </Part>
        </Macro>
        <Macro Name = "AddCircle" >
            <Circle Radius = "RC" Color = "Colors[i]" Center = "Cx[i] * L; Cy[i] * L; Cz[i] * L" />
            <Script> Inc(i); </Script>
        </Macro>
        <Macro Name = "Split25">
            <Split Axis = "id" From = "2" />
            <Split Axis = "id" From = "5" />
            <Script>Inc(id);</Script>
        </Macro>
        <Macro Name = "Split34">
            <Split Axis = "id" From = "3" />
            <Split Axis = "id" From = "4" />
            <Script>Inc(id);</Script>
        </Macro>
        <Macro Name = "HideC" >
            <HideContaining Vector = " Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <Macro Name = "Hide09E" >
            <HideContaining Vector = " 0.9 * Ex[i]; 0.9 * Ey[i]; 0.9 * Ez[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <Macro Name = "Hide1">
            <HideContaining Vector = "(Cx[i] + Vx[V[i, j]]) / 2 * L; (Cy[i] + Vy[V[i, j]]) / 2 * L; (Cz[i] + Vz[V[i, j]]) / 2 * L" />
            <Script>Inc(j);</Script>
        </Macro>
        <Macro Name = "Hide2">
            <ExecMacro MacroName = "Hide1" j = "0" Repeat = "5" />
            <Script>Inc(i);</Script>
        </Macro>
        <Macro Name = "Remove1">
            <RemoveContaining Vector = "(Cx[i] + Vx[V[i, j]]) / 2 * L; (Cy[i] + Vy[V[i, j]]) / 2 * L; (Cz[i] + Vz[V[i, j]]) / 2 * L" />
            <Script>Inc(j);</Script>
        </Macro>
        <Macro Name = "Remove2">
            <ExecMacro MacroName = "Remove1" j = "0" Repeat = "5" />
            <Script>Inc(i);</Script>
        </Macro>

        <ExecMacro MacroName = "AddCircle" Repeat = "12" i = "0" />
        <ExecMacro MacroName = "Split34" Repeat = "6" id = "0" />
        <ExecMacro MacroName = "Hide2" i = "0" Repeat = "12" />
        <RemoveAllVisible/>
        <ShowAll/>

        <ExecMacro MacroName = "Dodecahedron" />
        <ExecMacro MacroName = "Split25" Repeat = "6" id = "0" />
        <RemoveContaining Vector = "0;0;0" />
        <ExecMacro MacroName = "HideC" Repeat = "12" i = "0" />
        <SplitByAxes/>
        <ExecMacro MacroName = "Hide09E" Repeat = "30" i = "0" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>

        <ExecMacro MacroName = "Dodecahedron" />
        <ExecMacro MacroName = "Split25" Repeat = "6" id = "0" />
        <RemoveContaining Vector = "0;0;0" />
        <ExecMacro MacroName = "HideC" Repeat = "12" i = "0" />
        <SplitByAxes/>
        <ExecMacro MacroName = "Hide09E" Repeat = "30" i = "0" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddCircle" Repeat = "12" i = "0" />
        <ExecMacro MacroName = "Split34" Repeat = "6" id = "0" />
        <ExecMacro MacroName = "Remove2" i = "0" Repeat = "12" />
        <ShowAll/>
        <SplitByAxes/>

        <Connect Layers = "0;2" />
        <Connect Layers = "4;6" />
    </Figure>
</xml>
