<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Circle Gigaminx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Crazy\Double Circle Gigaminx</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-02</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;
        D3 := RSin;
        DCut := RSin;
        RC := R * 0.3967;
        R2 := R * 0.36;
        L := 1.001;
        D4 := RSin * L^2;
        L2 := L^3;

        // axes indexes around centers
        a[0,0] := 5; a[0,1] := 4; a[0,2] := 3; a[0,3] := 2; a[0,4] := 1;
        a[1,0] := 2; a[1,1] := 4; a[1,2] := 3; a[1,3] := 5; a[1,4] := 0;
        a[2,0] := 3; a[2,1] := 5; a[2,2] := 4; a[2,3] := 1; a[2,4] := 0;
        a[3,0] := 4; a[3,1] := 1; a[3,2] := 5; a[3,3] := 2; a[3,4] := 0;
        a[4,0] := 5; a[4,1] := 2; a[4,2] := 1; a[4,3] := 3; a[4,4] := 0;
        a[5,0] := 1; a[5,1] := 3; a[5,2] := 2; a[5,3] := 4; a[5,4] := 0;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D4; -D3; -D2; -D1; D1; D2; D3; D4" FixedLayers = "0;4;8" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <Macro Name = "Split">
            <Split Axis = "id" From = "6" />
            <Split Axis = "id" From = "3" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" id = "0" />

        <Macro Name = "Hide" >
            <HideContaining Vector = " Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "Hide" Repeat = "12" i = "0" />
        <Macro Name = "CutColor">
            <Cut Color = "Colors[id]" > <Plane NormVector = "-cx[id]; -cy[id]; -cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" Repeat = "12" id = "0" />
        <ShowAll/>
        <Macro Name = "CutGray">
            <Cut> <Plane NormVector = "-cx[id]; -cy[id]; -cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutGray" Repeat = "12" id = "0" />
        <RemoveContaining Vector = "0;0;0" />

        <Macro Name = "AddBigCircle" >
            <Circle Radius = "RC" Color = "Colors[i]" > <Center X = "Cx[i] * L" Y =  "Cy[i] * L" Z =  "Cz[i] * L" /> </Circle>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddBigCircle" Repeat = "12" i = "0" />

        <SplitByAxes/>

        <Connect Layers = "1;3" />
        <Connect Layers = "5;7" />

        <Macro Name = "CutCenters">
            <Hide Axis = "i"       From = "3" To   = "5" />
            <Hide Axis = "a[i, 0]" From = "6" />
            <Hide Axis = "a[i, 0]" To   = "2" />
            <Hide Axis = "a[i, 1]" From = "5" />
            <Hide Axis = "a[i, 1]" To   = "3" />
            <Hide Axis = "a[i, 2]" From = "5" />
            <Hide Axis = "a[i, 2]" To   = "3" />
            <Hide Axis = "a[i, 3]" From = "5" />
            <Hide Axis = "a[i, 3]" To   = "3" />
            <Hide Axis = "a[i, 4]" From = "5" />
            <Hide Axis = "a[i, 4]" To   = "3" />

            <RemoveAllVisible/>
            <ShowAll/>

            <Turn Axis = "i" From = "2" To = "3" Angle = "2 * Pi / 5" />
            <Turn Axis = "i" From = "5" To = "6" Angle = "2 * Pi / 5" />

            <Script>Inc(j);</Script>
        </Macro>

        <ExecMacro MacroName = "CutCenters" i = "0" j = "0" Repeat = "5" />
        <ExecMacro MacroName = "CutCenters" i = "1" j = "0" Repeat = "5" />
        <ExecMacro MacroName = "CutCenters" i = "2" j = "0" Repeat = "5" />
        <ExecMacro MacroName = "CutCenters" i = "3" j = "0" Repeat = "5" />
        <ExecMacro MacroName = "CutCenters" i = "4" j = "0" Repeat = "5" />
        <ExecMacro MacroName = "CutCenters" i = "5" j = "0" Repeat = "5" />
        <Undo Repeat = "60" />

        <Macro Name = "AddSmallCircle" >
            <Circle Radius = "R2" Color = "Colors[i]" > <Center X = "Cx[i] * L2" Y =  "Cy[i] * L2" Z =  "Cz[i] * L2" /> </Circle>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddSmallCircle" Repeat = "12" i = "0" />

        <SplitByAxes/>

    </Figure>
</xml>
