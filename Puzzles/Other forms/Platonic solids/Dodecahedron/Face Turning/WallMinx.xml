<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Wall-Minx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\WallMinx</Menu>
        <Inventor>Jason Burgess</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2990</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * 0.53;
    </Script>

    <Axes TurningAngles = "sAngle/2; 0; sAngle/2" PlaneDistances = "-D; D">
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "4" From  = "1" />

        <Turn  Axis = "0" Layer = "2" Angle = "Pi/5" />
        <Turn  Axis = "1" Layer = "0" Angle = "Pi/5" />
        <Turn  Axis = "4" Layer = "0" Angle = "Pi/5" />
        <SplitByAxes/>
        <Turn  Axis = "0" Layer = "2" Angle = "-Pi/5" />
        <Turn  Axis = "1" Layer = "0" Angle = "-Pi/5" />
        <Turn  Axis = "4" Layer = "0" Angle = "-Pi/5" />
    </Figure>
</xml>
