        <Macro Name = "Hide" >
            <Hide>  <Plane NormVector = " Cx[i]; Cy[i]; Cz[i]" NormDistance = "-D1" /> </Hide>
            <Hide>  <Plane NormVector = "-Cx[i];-Cy[i];-Cz[i]" NormDistance = "-D1" /> </Hide>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "Hide" i = "0" Repeat = "6" />
        <Macro Name = "Cut" >
            <Split> <Plane NormVector = " Cx[i]; Cy[i]; Cz[i]" NormDistance = "-D1" /> </Split>
            <Split> <Plane NormVector = "-Cx[i];-Cy[i];-Cz[i]" NormDistance = "-D1" /> </Split>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" Repeat = "6" />
        <RemoveGrayParts/>
        <ShowAll/>
