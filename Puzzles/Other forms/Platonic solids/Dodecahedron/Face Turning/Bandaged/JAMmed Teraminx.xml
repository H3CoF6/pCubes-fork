        <Inventor>Harley Olsthoorn</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-12-06</Added>
        <Link>https://jockeyandmusic.com/jammed-teraminx/</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6357</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // Red         
        Colors[ 1] := 'FFF08F'; // LightYellow 
        Colors[ 2] := '007700'; // Green       
        Colors[ 3] := 'FFFFFF'; // White       
        Colors[ 4] := '0000FF'; // Blue        
        Colors[ 5] := 'FF38E4'; // LightViolett
        Colors[ 6] := 'FFFF00'; // Yellow      
        Colors[ 7] := '00FF00'; // LightGreen  
        Colors[ 8] := 'AAAAAA'; // Gray        
        Colors[ 9] := '7777FF'; // LightBlue   
        Colors[10] := 'B200FF'; // Violett     
        Colors[11] := 'FF6A00'; // Orange      

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (5 * Rsin + 1 * R2sin) / 6;
        D2 := (4 * Rsin + 2 * R2sin) / 6;
        D3 := (3 * Rsin + 3 * R2sin) / 6;

        procedure Prepare();
        begin
            Count := Length(S) div 3;
            for i := 0 to Count - 1 do begin
                ax[i] := StrToInt(copy(S, i * 3 + 1, 1));
                L[i] := StrToInt(copy(S, i * 3 + 2, 1));
                Sign := copy(S, i * 3 + 3, 1);
                if Sign = '-' then begin
                    FromL[i] := L[i] + 1;
                    ToL[i] := 20;
                end else begin
                    FromL[i] := 0;
                    ToL[i] := L[i];
                end;
            end;
        end;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D1;-D2;-D3; D3; D2; D1" FixedLayers = "3" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "Split1" >
            <Split Axis = "ax[i]" From = "L[i] + 1" />
            <Hide Axis = "ax[i]" From = "FromL[i]" To = "ToL[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <Macro Name = "Split2" >
            <Script> Prepare; </Script>
            <ExecMacro MacroName = "Split1" i = "0" Repeat = "Count" />
            <ShowAll/>
