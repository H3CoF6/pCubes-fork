<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kilominx Chimera</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Bandaged\Kilominx Chimera</Menu>
        <Programmer>Skallos</Programmer>
        <Inventor>not invented</Inventor>
        <Added>2019-11-18</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D1 := (5 * Rsin + 1 * R2sin) / 6;
        D2 := (4 * Rsin + 2 * R2sin) / 6;
        D3 := (3 * Rsin + 3 * R2sin) / 6;

        DCut := RSin;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; sAngle; 0; sAngle; sAngle; sAngle" PlaneDistances = "-D1; -D2; -D3; D3; D2; D1" >
        <Axis NormVector = "cx[0]; cy[0]; cz[0]" />
        <Axis NormVector = "cx[1]; cy[1]; cz[1]" />
        <Axis NormVector = "cx[2]; cy[2]; cz[2]" />
        <Axis NormVector = "cx[3]; cy[3]; cz[3]" />
        <Axis NormVector = "cx[4]; cy[4]; cz[4]" />
        <Axis NormVector = "cx[5]; cy[5]; cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <Macro Name = "Split">
            <Split Axis = "id" From = "3" />
            <Split Axis = "id" From = "4" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" id = "0" />

        <HideContaining Vector = "Vx; Vy; Vz" />

        <Macro Name = "CutGray">
            <Cut> <Plane NormVector = "-Cx[id]; -Cy[id]; -Cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutGray" Repeat = "12" id = "0" />

        <ShowAll/>

        <Macro Name = "CutColor">
            <Cut Color = "Colors[id]" > <Plane NormVector = "-Cx[id]; -Cy[id]; -Cz[id]" NormDistance = "-DCut" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" Repeat = "12" id = "0" />

        <Macro Name = "HideVertex">
            <HideContaining Vector = "Vx[i]; Vy[i]; Vz[i]" />
            <Script>Inc(i);</Script>
        </Macro>

        <ExecMacro MacroName = "HideVertex" Repeat = "5" i = " 0" />
        <ExecMacro MacroName = "HideVertex" Repeat = "5" i = " 15" />
        <SplitByAxes/>

        // RemoveGrayParts
        <Macro Name = "HideFace">
            <Hide Axis = "i" To = "0" />
            <Hide Axis = "i" From = "6" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "HideFace" i = "0" Repeat = "6" />
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>
