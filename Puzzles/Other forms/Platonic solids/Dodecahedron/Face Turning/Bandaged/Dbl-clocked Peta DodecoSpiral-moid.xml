    <Interface>
        <Name>Dbl-clocked Peta DodecoSpiral-moid</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Bandaged\Dbl-clocked Peta DodecoSpiral-moid</Menu>
        <Inventor>virtual model by AndyKybik</Inventor>
        <Programmer>AndyKybik</Programmer>
        <Added>2024-11-01</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (7 * Rsin + 1 * R2sin) / 8;
        D2 := (6 * Rsin + 2 * R2sin) / 8;
        D3 := (5 * Rsin + 3 * R2sin) / 8;
        D4 := (4 * Rsin + 4 * R2sin) / 8;

        DCut := D1 + 0.002;

        procedure Prepare();
        begin
            Count := Length(S) div 3;
            for i := 0 to Count - 1 do begin
                ax[i] := StrToInt(copy(S, i * 3 + 1, 1));
                L[i] := StrToInt(copy(S, i * 3 + 2, 1));
                Sign := copy(S, i * 3 + 3, 1);
                if Sign = '-' then begin
                    FromL[i] := L[i] + 1;
                    ToL[i] := 20;
                end else if Sign = '+' then begin
                    FromL[i] := 0;
                    ToL[i] := L[i];
                end else begin
                    FromL[i] := 20;
                    ToL[i] := 20;
                end;
            end;
        end;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; sAngle; 0; sAngle; sAngle; sAngle" PlaneDistances = "-D2;-D3;-D4; D4; D3; D2">
        <Axis NormVector = " Cx[0]; Cy[0]; Cz[0]" />
    </Axes>

    <Axes TurningAngles = "sAngle; sAngle; sAngle; sAngle; 0; sAngle; sAngle; sAngle; sAngle" PlaneDistances = "-D1;-D2;-D3;-D4; D4; D3; D2; D1" >
        <Axis NormVector = " Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = " Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = " Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = " Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = " Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "clWhite " > <Plane NormVector = "0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "0; 0;-1" NormDistance = "-DCut" /> </Cut>

        <Macro Name = "Split1" >
            <Split Axis = "ax[i]" From = "L[i] + 1" />
            <Hide Axis = "ax[i]" From = "FromL[i]" To = "ToL[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <Macro Name = "Split2" >
            <Script> Prepare; </Script>
            <ExecMacro MacroName = "Split1" i = "0" Repeat = "Count" />
            <ShowAll/>
