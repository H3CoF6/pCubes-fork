<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gauzeless</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Bandaged\Gauzeless</Menu>
        <Inventor>Gabe Vogt</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-12-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8607</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';
        clYellow1       := 'FFFF01';
        clLightViolett1 := 'FF0081';

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = " Cx[0]; Cy[0]; Cz[0]" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D1" FixedLayers = "0" >
        <Axis NormVector = " Cx[2]; Cy[2]; Cz[2]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Cut Color = "clYellow1">    <Plane NormVector = " Cx[0]; Cy[0]; Cz[0]" NormDistance = " R2Sin" /> </Cut>
        <Cut>                        <Plane NormVector = "-Cx[0];-Cy[0];-Cz[0]" NormDistance = "-D2"    /> </Cut>
        <Cut InvisibleEdges = "-1" > <Plane NormVector = "-Cx[2];-Cy[2];-Cz[2]" NormDistance = "-D2"    /> </Cut>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Cut>                        <Plane NormVector = "-Cx[0];-Cy[0];-Cz[0]" NormDistance = "-D2"    /> </Cut>
        <Cut>                        <Plane NormVector = "-Cx[2];-Cy[2];-Cz[2]" NormDistance = "-D1"    /> </Cut>
        <Cut InvisibleEdges = "-1" > <Plane NormVector = " Cx[0]; Cy[0]; Cz[0]" NormDistance = " R2Sin" /> </Cut>
        <Cut InvisibleEdges = "-1" > <Plane NormVector = " Cx[2]; Cy[2]; Cz[2]" NormDistance = " D2"    /> </Cut>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Cut Color = "clLightViolett1"> <Plane NormVector = " Cx[2]; Cy[2]; Cz[2]" NormDistance = " D2"    /> </Cut>
        <Cut>                           <Plane NormVector = "-Cx[2];-Cy[2];-Cz[2]" NormDistance = "-D1"    /> </Cut>
        <Cut InvisibleEdges = "-1">     <Plane NormVector = "-Cx[0];-Cy[0];-Cz[0]" NormDistance = "-R2Sin" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = "2*Pi/5" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = "2*Pi/5" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Unbandage" Repeat = "17" />
        <Undo Repeat = "34" />

        <Turn NormVector = "1;0;0" Angle = " Pi/2" />
        <Turn NormVector = "0;1;0" Angle = " Pi/10" />
        <Turn NormVector = "0;0;1" Angle = "-ArcTan(2)/2" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>
</xml>
