        <Macro Name = "Scramble" Public = "1" >
            <Script>
                sAngle := Pi * 2 / 5;
                procedure Prepare();
                begin
                    Count := Length(S) div 5;
                    for i := 0 to Count - 1 do begin
                        ax[i]    := StrToInt(copy(S, i * 5 + 1, 1));
                        FromL[i] := StrToInt(copy(S, i * 5 + 2, 1));
                        ToL[i]   := StrToInt(copy(S, i * 5 + 3, 1));
                        Sign     :=          copy(S, i * 5 + 4, 2);
                        Case Sign of
                        '--': A[i] :=-sAngle * 2;
                        '- ': A[i] :=-sAngle;
                        '+ ': A[i] := sAngle;
                        '++': A[i] := sAngle * 2;
                        end;
                    end;
                end;
            </Script>

