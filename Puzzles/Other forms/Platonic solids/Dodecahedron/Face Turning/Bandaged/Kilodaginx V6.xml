<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kilodaginx V6</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Bandaged\Kilodaginx V6</Menu>
        <Inventor>Leonardo Oli Loy </Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9261</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // Red         
        Colors[ 1] := 'FFF08F'; // LightYellow 
        Colors[ 2] := '007700'; // Green       
        Colors[ 3] := 'FFFFFF'; // White       
        Colors[ 4] := '0000FF'; // Blue        
        Colors[ 5] := 'FF38E4'; // LightViolett
        Colors[ 6] := 'FFFF00'; // Yellow      
        Colors[ 7] := '00FF00'; // LightGreen  
        Colors[ 8] := 'AAAAAA'; // Gray        
        Colors[ 9] := '7777FF'; // LightBlue   
        Colors[10] := 'B200FF'; // Violett     
        Colors[11] := 'FF6A00'; // Orange      

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "Split">
            <Split Axis = "ax1" From = "1" />
            <Hide Axis = "ax1" To = "0" />
            <Split Axis = "ax2" From = "1" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Split" ax1 = " 2" ax2 = " 0" />
        <ExecMacro MacroName = "Split" ax1 = " 4" ax2 = " 3" />
        <ExecMacro MacroName = "Split" ax1 = "10" ax2 = " 6" />
        <ExecMacro MacroName = "Split" ax1 = " 7" ax2 = "11" />
        <ExecMacro MacroName = "Split" ax1 = " 9" ax2 = " 8" />
        <ExecMacro MacroName = "Split" ax1 = " 5" ax2 = " 1" />

        <Macro Name = "HideEdge">
            <HideContaining Vector = "Ex[i];Ey[i];Ez[i]" />
        </Macro>
        <ExecMacro MacroName = "HideEdge" i = " 1" />
        <ExecMacro MacroName = "HideEdge" i = " 5" />
        <ExecMacro MacroName = "HideEdge" i = " 8" />
        <ExecMacro MacroName = "HideEdge" i = "20" />
        <ExecMacro MacroName = "HideEdge" i = "22" />
        <ExecMacro MacroName = "HideEdge" i = "28" />

        <SplitByAxes/>
        <HideContaining Vector = "Vx; Vy; Vz" />
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />
        <RemoveContaining Vector = "Vx;Vy;Vz" />

        <Macro Name = "RemoveEdge">
            <RemoveContaining Vector = "Ex[i];Ey[i];Ez[i]" />
        </Macro>
        <ExecMacro MacroName = "RemoveEdge" i = " 1" />
        <ExecMacro MacroName = "RemoveEdge" i = " 5" />
        <ExecMacro MacroName = "RemoveEdge" i = " 8" />
        <ExecMacro MacroName = "RemoveEdge" i = "20" />
        <ExecMacro MacroName = "RemoveEdge" i = "22" />
        <ExecMacro MacroName = "RemoveEdge" i = "28" />

        <ShowAll/>
    </Figure>
</xml>
