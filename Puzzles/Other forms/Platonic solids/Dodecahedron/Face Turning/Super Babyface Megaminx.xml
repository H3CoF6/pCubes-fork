<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Babyface Megaminx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Super Babyface Megaminx</Menu>
        <Inventor>Kyler van der Gaag</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1594</Link>
