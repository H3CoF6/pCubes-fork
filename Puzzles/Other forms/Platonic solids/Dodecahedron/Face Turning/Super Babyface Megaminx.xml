            <Turn Axis = "0" Layer = "2" Angle = "a*sAngle" />
            <Turn Axis = "1" Layer = "2" Angle = "b*sAngle" />
            <Turn Axis = "2" Layer = "2" Angle = "c*sAngle" />
            <Turn Axis = "3" Layer = "2" Angle = "d*sAngle" />
            <Turn Axis = "4" Layer = "2" Angle = "e*sAngle" />
            <Turn Axis = "5" Layer = "2" Angle = "f*sAngle" />
