            <Turn Axis = "1" Layer = "0" Angle = "b*sAngle" />
            <Turn Axis = "2" Layer = "0" Angle = "c*sAngle" />
            <Turn Axis = "3" Layer = "0" Angle = "d*sAngle" />
            <Turn Axis = "4" Layer = "0" Angle = "e*sAngle" />
            <Turn Axis = "5" Layer = "0" Angle = "f*sAngle" />
            <SaveSolvedState/>
        </Macro>

        <SaveSolvedState/>
        <ExecMacro MacroName = "SolvedStates" a = "1" b = "2" c = "3" d = "1" e = "1" f = "3" />
        <ExecMacro MacroName = "SolvedStates" a = "1" b = "1" c = "1" d = "3" e = "2" f = "3" />
        <ExecMacro MacroName = "SolvedStates" a = "1" b = "3" c = "2" d = "3" e = "1" f = "1" />
        <ExecMacro MacroName = "SolvedStates" a = "1" b = "3" c = "1" d = "1" e = "3" f = "2" />
<!--        <ExecMacro MacroName = "SolvedStates" a="1" b="1" c="3" d="2" e="3" f="1" />-->
        <Undo Repeat = "48" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
