<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Brillimate</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Master Brillimate</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4970</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := Rsin * As;
        D2 := R * sqrt((5 - 2 * sqrt(5)) / 3) / 5;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D1; -D2; D2; D1" >
        <Axis NormVector = "cx[0]; cy[0]; cz[0]" />
        <Axis NormVector = "cx[1]; cy[1]; cz[1]" />
        <Axis NormVector = "cx[2]; cy[2]; cz[2]" />
        <Axis NormVector = "cx[3]; cy[3]; cz[3]" />
        <Axis NormVector = "cx[4]; cy[4]; cz[4]" />
        <Axis NormVector = "cx[5]; cy[5]; cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
