<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Penrose moid</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Penrose moid</Menu>
        <Inventor>Javier Alla La</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9089</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';
        Colors[6] := Colors[3];
        Colors[7] := Colors[4];
        Colors[8] := Colors[5];
        Colors[9] := Colors[1];
        Colors[10] := Colors[2];

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
        DCut := D + 0.002;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Cut Color = "clWhite " > <Plane NormVector = "0; 0; 1" NormDistance = "-D" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "0; 0;-1" NormDistance = "-D" /> </Cut>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" R = "R * 0.7" />
        <Split> <Plane NormVector = "0; 0; 1" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0; 0;-1" NormDistance = "-D" /> </Split>
        <RemoveContaining Vector = "0;0;0"/>
        <SplitByAxes/>
        <HideContaining Vector = "Cx[ 0];Cy[ 0];Cz[ 0]"/>
        <HideContaining Vector = "Cx[11];Cy[11];Cz[11]"/>
        <RemoveAllVisible/>

        <Script>
            Colors[ 0] := -1;
            Colors[11] := -1;
        </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Split> <Plane NormVector = "0; 0; 1" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0; 0;-1" NormDistance = "-D" /> </Split>
        <RemoveContaining Vector = "0;0;0"/>
        <SplitByAxes/>
        <RemoveContaining Vector = "Cx[ 0];Cy[ 0];Cz[ 0]"/>
        <RemoveContaining Vector = "Cx[11];Cy[11];Cz[11]"/>
        <Macro Name = "RemoveV" >
            <RemoveContaining Vector = "Vx[i];Vy[i];Vz[i]"/>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveV" i = "0" Repeat = "20" />
        <HideAll/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <Split> <Plane NormVector = "0; 0; 1" NormDistance = "-D" /> </Split>
        <Split> <Plane NormVector = "0; 0;-1" NormDistance = "-D" /> </Split>
        <RemoveContaining Vector = "0;0;0"/>
        <SplitByAxes/>
        <Macro Name = "HideV" >
            <HideContaining Vector = "Vx[i];Vy[i];Vz[i]"/>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideV" i = "0" Repeat = "20" />

        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
