<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Aleh's Minx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Aleh's Minx</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3223</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := 0.37;
    </Script>

    <Axes TurningAngles = "sAngle/2; 0; sAngle/2" PlaneDistances = "-D; D">
        <Axis NormVector = "cx[0]; cy[0]; cz[0]" />
    </Axes>
    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D">
        <Axis NormVector = "cx[1]; cy[1]; cz[1]" />
        <Axis NormVector = "cx[2]; cy[2]; cz[2]" />
        <Axis NormVector = "cx[3]; cy[3]; cz[3]" />
        <Axis NormVector = "cx[4]; cy[4]; cz[4]" />
        <Axis NormVector = "cx[5]; cy[5]; cz[5]" />
    </Axes>
    
    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "1" />

        <Hide  Axis = "0" Layer = "0" />
        <Hide  Axis = "0" Layer = "2" />
        <SplitByAxes/>
        <ShowAll/>

        <Hide  Axis = "0" Layer = "1" />

        <Split Axis = "1" From  = "2" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "2" Angle = "sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "sAngle" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "1" Layer = "2" Angle = "-2*sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "-2*sAngle" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "1" Layer = "2" Angle = "sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "sAngle" />

        <Turn  Axis = "0" Layer = "2" Angle = "5*sAngle/2" />
        <Turn  Axis = "0" Layer = "0" Angle = "5*sAngle/2" />

        <Split Axis = "1" From  = "2" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "2" Angle = "sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "sAngle" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "1" Layer = "2" Angle = "-2*sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "-2*sAngle" />
        <Split Axis = "0" From  = "2" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "1" Layer = "2" Angle = "sAngle" />
        <Turn  Axis = "1" Layer = "0" Angle = "sAngle" />

        <Turn  Axis = "0" Layer = "2" Angle = "-5*sAngle/2" />
        <Turn  Axis = "0" Layer = "0" Angle = "-5*sAngle/2" />
        <ShowAll/>

    </Figure>
</xml>
