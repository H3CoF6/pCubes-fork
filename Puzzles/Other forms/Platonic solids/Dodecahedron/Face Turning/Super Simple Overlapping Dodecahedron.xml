<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Simple Overlapping Dodecahedron</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Super Simple Overlapping Dodecahedron</Menu>
        <Inventor>Tanner Frisby</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1609</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        Colors[ 0] := 'FFFF00'; //clYellow
        Colors[ 2] := 'FF0080'; //clLightViolett
        Colors[ 3] := '0000FF'; //clBlue
        Colors[ 4] := 'FF0000'; //clRed
        Colors[ 5] := 'CCCCCC'; //clGray
        Colors[ 6] := '008000'; //clGreen
        Colors[ 7] := '800080'; //clViolett
        Colors[ 9] := 'FF6000'; //clOrange
        Colors[10] := '00DCB4'; //clCyan
        Colors[11] := 'FFFFFF'; //clWhite

        D := (Rsin + R2sin) / 2;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "cx[0]; cy[0]; cz[0]" />
        <Axis NormVector = "cx[1]; cy[1]; cz[1]" />
        <Axis NormVector = "cx[2]; cy[2]; cz[2]" />
        <Axis NormVector = "cx[3]; cy[3]; cz[3]" />
        <Axis NormVector = "cx[4]; cy[4]; cz[4]" />
        <Axis NormVector = "cx[5]; cy[5]; cz[5]" />
    </Axes>

    <Figure>

        <Part>
            <Vertices Vectors = "vx; vy; vz" />
            <Vertices Vectors = "cx; cy; cz" />

            <Faces>
                <Face Color = "Colors[ 7]" VertexIndexes = "20; 1; 0" InvisibleEdges = "5" />
                <Face Color = "Colors[ 4]" VertexIndexes = "20; 0; 4" InvisibleEdges = "5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "20; 4; 3" InvisibleEdges = "5" />
                <Face Color = "Colors[ 0]" VertexIndexes = "20; 3; 2" InvisibleEdges = "5" />
                <Face Color = "Colors[ 2]" VertexIndexes = "20; 2; 1" InvisibleEdges = "5" />

                <Face Color = "Colors[ 7]" VertexIndexes = "21; 0; 1" InvisibleEdges = "5" />
                <Face Color = "Colors[11]" VertexIndexes = "21; 1; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[ 9]" VertexIndexes = "21; 6;10" InvisibleEdges = "5" />
                <Face Color = "Colors[10]" VertexIndexes = "21;10; 5" InvisibleEdges = "5" />
                <Face Color = "Colors[ 0]" VertexIndexes = "21; 5; 0" InvisibleEdges = "5" />

                <Face Color = "Colors[ 2]" VertexIndexes = "22; 1; 2" InvisibleEdges = "5" />
                <Face Color = "Colors[ 4]" VertexIndexes = "22; 2; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[ 5]" VertexIndexes = "22; 7;11" InvisibleEdges = "5" />
                <Face Color = "Colors[ 6]" VertexIndexes = "22;11; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[11]" VertexIndexes = "22; 6; 1" InvisibleEdges = "5" />

                <Face Color = "Colors[ 0]" VertexIndexes = "23; 2; 3" InvisibleEdges = "5" />
                <Face Color = "Colors[ 7]" VertexIndexes = "23; 3; 8" InvisibleEdges = "5" />
                <Face Color = "Colors[ 2]" VertexIndexes = "23; 8;12" InvisibleEdges = "5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "23;12; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[ 4]" VertexIndexes = "23; 7; 2" InvisibleEdges = "5" />

                <Face Color = "Colors[ 3]" VertexIndexes = "24; 3; 4" InvisibleEdges = "5" />
                <Face Color = "Colors[ 2]" VertexIndexes = "24; 4; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[ 0]" VertexIndexes = "24; 9;13" InvisibleEdges = "5" />
                <Face Color = "Colors[ 4]" VertexIndexes = "24;13; 8" InvisibleEdges = "5" />
                <Face Color = "Colors[ 7]" VertexIndexes = "24; 8; 3" InvisibleEdges = "5" />

                <Face Color = "Colors[ 4]" VertexIndexes = "25; 4; 0" InvisibleEdges = "5" />
                <Face Color = "Colors[ 0]" VertexIndexes = "25; 0; 5" InvisibleEdges = "5" />
                <Face Color = "Colors[11]" VertexIndexes = "25; 5;14" InvisibleEdges = "5" />
                <Face Color = "Colors[ 7]" VertexIndexes = "25;14; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[ 2]" VertexIndexes = "25; 9; 4" InvisibleEdges = "5" />

                <Face Color = "Colors[ 5]" VertexIndexes = "26;18;17" InvisibleEdges = "5" />
                <Face Color = "Colors[ 6]" VertexIndexes = "26;17;12" InvisibleEdges = "5" />
                <Face Color = "Colors[ 2]" VertexIndexes = "26;12; 8" InvisibleEdges = "5" />
                <Face Color = "Colors[ 4]" VertexIndexes = "26; 8;13" InvisibleEdges = "5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "26;13;18" InvisibleEdges = "5" />

                <Face Color = "Colors[10]" VertexIndexes = "27;19;18" InvisibleEdges = "5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "27;18;13" InvisibleEdges = "5" />
                <Face Color = "Colors[ 0]" VertexIndexes = "27;13; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[ 7]" VertexIndexes = "27; 9;14" InvisibleEdges = "5" />
                <Face Color = "Colors[ 9]" VertexIndexes = "27;14;19" InvisibleEdges = "5" />

                <Face Color = "Colors[ 6]" VertexIndexes = "28;15;19" InvisibleEdges = "5" />
                <Face Color = "Colors[ 9]" VertexIndexes = "28;19;14" InvisibleEdges = "5" />
                <Face Color = "Colors[11]" VertexIndexes = "28;14; 5" InvisibleEdges = "5" />
                <Face Color = "Colors[10]" VertexIndexes = "28; 5;10" InvisibleEdges = "5" />
                <Face Color = "Colors[ 5]" VertexIndexes = "28;10;15" InvisibleEdges = "5" />

                <Face Color = "Colors[11]" VertexIndexes = "29;16;15" InvisibleEdges = "5" />
                <Face Color = "Colors[ 5]" VertexIndexes = "29;15;10" InvisibleEdges = "5" />
                <Face Color = "Colors[ 9]" VertexIndexes = "29;10; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[ 6]" VertexIndexes = "29; 6;11" InvisibleEdges = "5" />
                <Face Color = "Colors[10]" VertexIndexes = "29;11;16" InvisibleEdges = "5" />

                <Face Color = "Colors[ 9]" VertexIndexes = "30;17;16" InvisibleEdges = "5" />
                <Face Color = "Colors[10]" VertexIndexes = "30;16;11" InvisibleEdges = "5" />
                <Face Color = "Colors[ 5]" VertexIndexes = "30;11; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[ 3]" VertexIndexes = "30; 7;12" InvisibleEdges = "5" />
                <Face Color = "Colors[ 6]" VertexIndexes = "30;12;17" InvisibleEdges = "5" />

                <Face Color = "Colors[ 9]" VertexIndexes = "31;16;17" InvisibleEdges = "5" />
                <Face Color = "Colors[ 5]" VertexIndexes = "31;17;18" InvisibleEdges = "5" />
                <Face Color = "Colors[10]" VertexIndexes = "31;18;19" InvisibleEdges = "5" />
                <Face Color = "Colors[ 6]" VertexIndexes = "31;19;15" InvisibleEdges = "5" />
                <Face Color = "Colors[11]" VertexIndexes = "31;15;16" InvisibleEdges = "5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "HideCorners">
            <HideContaining Vector = "vx[id]; vy[id]; vz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCorners" Repeat = "20" id = "0" />

        <Macro Name = "HideCenters">
            <HideContaining Vector = "Cx[id]; Cy[id]; Cz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCenters" Repeat = "12" id = "0" />

        <RemoveAllVisible/>

        <!-- Gray dodecahedron -->
        <Part>
            <Vertices Vectors = "vx; vy; vz" />
            <Faces>
                <Face VertexIndexes = " 4; 3; 2; 1; 0" />
                <Face VertexIndexes = " 0; 1; 6;10; 5" />
                <Face VertexIndexes = " 1; 2; 7;11; 6" />
                <Face VertexIndexes = " 2; 3; 8;12; 7" />
                <Face VertexIndexes = " 3; 4; 9;13; 8" />
                <Face VertexIndexes = " 4; 0; 5;14; 9" />
                <Face VertexIndexes = "18;17;12; 8;13" />
                <Face VertexIndexes = "19;18;13; 9;14" />
                <Face VertexIndexes = "15;19;14; 5;10" />
                <Face VertexIndexes = "16;15;10; 6;11" />
                <Face VertexIndexes = "17;16;11; 7;12" />
                <Face VertexIndexes = "15;16;17;18;19" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Macro Name = "RemoveCorners">
            <RemoveContaining Vector = "vx[id]; vy[id]; vz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCorners" Repeat = "20" id = "0" />

        <Macro Name = "RemoveCenters">
            <RemoveContaining Vector = "Cx[id]; Cy[id]; Cz[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenters" Repeat = "12" id = "0" />

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
