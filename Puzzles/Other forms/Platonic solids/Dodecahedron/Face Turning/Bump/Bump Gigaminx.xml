<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bump Gigaminx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Bump\Bump Gigaminx</Menu>
        <Inventor>Eitan Cher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-03-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5275</Link>
    </Interface>

    <Script>
        clColor := 'EEEEEE';

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (4 * Rsin + 2 * R2sin) / 6;
        D2 := (3 * Rsin + 3 * R2sin) / 6;
    </Script>

    <Axes TurningAngles = "0; sAngle; sAngle" PlaneDistances = "D2; D1" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "R" />
        <SplitByAxes/>

        <Macro Name = "CutFaces" >
            <Cut Color = "clColor" > <Plane NormVector = "Cx[i];Cy[i];Cz[i]" NormDistance = "-Rsin+0.0094*i" /> </Cut>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "CutFaces" Repeat = "12" i = "0" />

        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 12" />
</xml>
