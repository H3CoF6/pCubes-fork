<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Crystal</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Pyraminx Crystal</Menu>
        <Inventor>Aleh Hladzilin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-06-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=652</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := Rsin * As;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
