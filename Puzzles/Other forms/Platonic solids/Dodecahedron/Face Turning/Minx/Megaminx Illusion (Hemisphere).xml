<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megaminx Illusion (Hemisphere)</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Minx\Megaminx Illusion (Hemisphere)</Menu>
        <Inventor>Antony Burt</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-09-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6708</Link>
    </Interface>

    <Script>
        clBlack := '444444';
        clWhite := 'FFFFFF';

        R := 0.7;
        E := 0.8 * R;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2 + R * 0.05;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D">
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>

        <HideContaining Vectors = "Ex; Ey; Ez" />

        <Macro Name = "CutFaces" >
            <Cut Color = "Color" > <Plane NormVector = "s*Cx[i];s*Cy[i];s*Cz[i]" NormDistance = "-E" /> </Cut>
            <Script> Inc(i); </Script>
        </Macro>

        <ExecMacro MacroName = "CutFaces" Repeat = "6" i = "0" s = "-1" Color = "clBlack" />
        <ExecMacro MacroName = "CutFaces" Repeat = "6" i = "0" s = " 1" Color = "clWhite" />
        <ShowAll/>
        <ExecMacro MacroName = "CutFaces" Repeat = "6" i = "0" s = " 1" Color = "clBlack" />
        <ExecMacro MacroName = "CutFaces" Repeat = "6" i = "0" s = "-1" Color = "clWhite" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
