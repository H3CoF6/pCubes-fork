<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gigaminx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Minx\Gigaminx</Menu>
        <Inventor>Tyler Fox</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1475</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;
    </Script>

    <Axes TurningAngles = "0; sAngle; sAngle" PlaneDistances = " D2; D1" NormVectors = " Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
