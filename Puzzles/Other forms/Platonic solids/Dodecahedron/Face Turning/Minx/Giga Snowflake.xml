<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Giga Snowflake</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Minx\Giga Snowflake</Menu>
        <Inventor>Nathan Wilson</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-25</Added>
        <Link>https://youtube.com/watch?v=z2MnfErYnww</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF';
        Colors[ 1] := 'FFEE00'; // clYellow
        Colors[ 2] := 'FFFFFF';
        Colors[ 3] := 'FFFFFF';
        Colors[ 4] := '0055DD'; // clBlue
        Colors[ 5] := '00AA00'; // clGreen
        Colors[ 6] := 'AA00DD'; // clViolett
        Colors[ 7] := 'FFFFFF';
        Colors[ 8] := 'FFFFFF';
        Colors[ 9] := 'FF8800'; // clOrange1
        Colors[10] := 'FF1100'; // clRed
        Colors[11] := 'FFFFFF';

        Colors[12] := 'FFFFFF'; //

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (Rsin + R2sin) / 2;
        D2 := D1 * 1.3;

        RC := R * 0.515;
        Tc :=  RSin * 0.875;

        for i := 0 to 39 do begin
            x[i] := RC * cos(2 * Pi / 40 * i);
            y[i] := RC * sin(2 * Pi / 40 * i);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; 0; sAngle; sAngle" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Split Axis = "1" From = "1" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "4" From = "4" />
        <Split Axis = "5" From = "4" />

        <RemoveContaining Vector = "0;0;0" />

        <Cut Color = "Colors[12]" Axis = "0" From = "1" To = "4" />
        <Cut Color = "Colors[12]" Axis = "2" From = "1" To = "4" />
        <Cut Color = "Colors[12]" Axis = "3" From = "1" To = "4" />

        <HideAll/>

        <Macro Name = "Cylinder" >
            <Part>
                <Vertices Vectors = "x; y; TC" />
                <Vertices Vectors = "x; y; D2" />

                <Faces>
                    <Face Color = "cl" VertexIndexes = "FromTo(0, 39)" />

                    <Face Color = "cl" VertexIndexes = "40;41; 1; 0" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "41;42; 2; 1" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "42;43; 3; 2" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "43;44; 4; 3" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "44;45; 5; 4" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "45;46; 6; 5" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "46;47; 7; 6" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "47;48; 8; 7" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "48;49; 9; 8" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "49;50;10; 9" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "50;51;11;10" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "51;52;12;11" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "52;53;13;12" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "53;54;14;13" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "54;55;15;14" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "55;56;16;15" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "56;57;17;16" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "57;58;18;17" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "58;59;19;18" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "59;60;20;19" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "60;61;21;20" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "61;62;22;21" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "62;63;23;22" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "63;64;24;23" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "64;65;25;24" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "65;66;26;25" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "66;67;27;26" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "67;68;28;27" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "68;69;29;28" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "69;70;30;29" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "70;71;31;30" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "71;72;32;31" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "72;73;33;32" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "73;74;34;33" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "74;75;35;34" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "75;76;36;35" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "76;77;37;36" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "77;78;38;37" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "78;79;39;38" InvisibleEdges = "10" />
                    <Face Color = "cl" VertexIndexes = "79;40; 0;39" InvisibleEdges = "10" />

                    <Face VertexIndexes = "FromTo(79, 40)" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "AddCircle" >
            <ExecMacro MacroName = "Cylinder" />
            <Cut> <Plane NormVector = " Ex[9]; Ey[9]; Ez[9]" /> </Cut>
            <Cut> <Plane NormVector = " Ex[5]; Ey[5]; Ez[5]" /> </Cut>
            <HideAll/>
            <Turn NormVector = "Vx[2]; Vy[2]; Vz[2]" Angle = "-2*Pi/3" />
        </Macro>

        <Macro Name = "AddCircles" >
            <ExecMacro MacroName = "AddCircle" cl = "Colors[ca]" />
            <ExecMacro MacroName = "AddCircle" cl = "Colors[cb]" />
            <ExecMacro MacroName = "AddCircle" cl = "Colors[cc]" />

            <ShowAll/>
            <SplitByAxes/>

            <Hide><Plane NormVector = "Cx[0]; Cy[0]; Cz[0]" NormDistance = "D2" /></Hide>
            <Hide><Plane NormVector = "Cx[2]; Cy[2]; Cz[2]" NormDistance = "D2" /></Hide>
            <Hide><Plane NormVector = "Cx[3]; Cy[3]; Cz[3]" NormDistance = "D2" /></Hide>
            <RemoveAllVisible/>

            <LoadFrom File = "Figures\Dodecahedron.xml" />
            <Cut Color = "Colors[cc]" > <Plane NormVector = "-Cx[2]; -Cy[2]; -Cz[2]" NormDistance = "-Tc" /> </Cut>
            <Cut Color = "Colors[cb]" > <Plane NormVector = "-Cx[3]; -Cy[3]; -Cz[3]" NormDistance = "-Tc" /> </Cut>
            <Cut Color = "Colors[ca]" > <Plane NormVector = "-Cx[0]; -Cy[0]; -Cz[0]" NormDistance = "-Tc" /> </Cut>
            <SplitByAxes/>

            <Cut><Plane NormVector = "Cx[0]; Cy[0]; Cz[0]" NormDistance = "D2" /></Cut>
            <Cut><Plane NormVector = "Cx[2]; Cy[2]; Cz[2]" NormDistance = "D2" /></Cut>
            <Cut><Plane NormVector = "Cx[3]; Cy[3]; Cz[3]" NormDistance = "D2" /></Cut>

            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "AddCircles" ca = "12" cb = "12" cc = "12" />
        <HideAll/>
        <Turn NormVector = "0; 1; 0" Angle = "Pi" />
        <Turn NormVector = "0; 0; 1" Angle = "-Pi/5" />
        <ExecMacro MacroName = "AddCircles" ca = "12" cb = "12" cc = "12" />

        <Turn NormVector = "0; 0; 1" Angle = "Pi/5" />
        <Turn NormVector = "0; 1; 0" Angle = "Pi" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
