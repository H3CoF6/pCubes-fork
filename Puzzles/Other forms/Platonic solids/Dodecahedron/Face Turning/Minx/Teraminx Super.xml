<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Teraminx Super</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Minx\Teraminx Super</Menu>
        <Inventor>Arnaud Lacoume</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-07-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4454</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D1 := (5 * Rsin + 1 * R2sin) / 6;
        D2 := (4 * Rsin + 2 * R2sin) / 6;
        D3 := (3 * Rsin + 3 * R2sin) / 6;

        delta := 0.02;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; sAngle; 0; sAngle; sAngle; sAngle" PlaneDistances = "-D1; -D2; -D3; D3; D2; D1" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Script> R := 1.083; DCut1 := RSin; DCut2 := RSin + delta; </Script>
        <LoadFrom File = "Puzzles\Other forms\Platonic solids\Dodecahedron\Face Turning\Minx\_Macro_For_Super.xml" />

        <Script> R := 0.926; DCut1 := RSin + delta; DCut2 := RSin + 2 * delta; </Script>
        <LoadFrom File = "Puzzles\Other forms\Platonic solids\Dodecahedron\Face Turning\Minx\_Macro_For_Super.xml" />

        <Script> R := 0.767; DCut1 := RSin + 2 * delta; DCut2 := RSin + 3 * delta; </Script>
        <LoadFrom File = "Puzzles\Other forms\Platonic solids\Dodecahedron\Face Turning\Minx\_Macro_For_Super.xml" />

        <ShowAll/>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
