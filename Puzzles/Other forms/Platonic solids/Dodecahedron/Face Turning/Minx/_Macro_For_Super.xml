        <Cut Color = "Colors[ 9]" > <Plane NormVector = " X0[4]; Y0[4]; Z0[4]" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "Colors[10]" > <Plane NormVector = " X0[5]; Y0[5]; Z0[5]" NormDistance = "-DCut2" /> </Cut>

        <Split> <Plane NormVector = " X0[0]; Y0[0]; Z0[0]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = " X0[1]; Y0[1]; Z0[1]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = " X0[2]; Y0[2]; Z0[2]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = " X0[3]; Y0[3]; Z0[3]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = " X0[4]; Y0[4]; Z0[4]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = " X0[5]; Y0[5]; Z0[5]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = "-X0[0];-Y0[0];-Z0[0]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = "-X0[1];-Y0[1];-Z0[1]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = "-X0[2];-Y0[2];-Z0[2]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = "-X0[3];-Y0[3];-Z0[3]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = "-X0[4];-Y0[4];-Z0[4]" NormDistance = "-DCut1" /> </Split>
        <Split> <Plane NormVector = "-X0[5];-Y0[5];-Z0[5]" NormDistance = "-DCut1" /> </Split>

        <RemoveContaining Vector = " X0[0] * dT; Y0[0] * dT; Z0[0] * dT" />
        <RemoveContaining Vector = " X0[1] * dT; Y0[1] * dT; Z0[1] * dT" />
        <RemoveContaining Vector = " X0[2] * dT; Y0[2] * dT; Z0[2] * dT" />
        <RemoveContaining Vector = " X0[3] * dT; Y0[3] * dT; Z0[3] * dT" />
        <RemoveContaining Vector = " X0[4] * dT; Y0[4] * dT; Z0[4] * dT" />
        <RemoveContaining Vector = " X0[5] * dT; Y0[5] * dT; Z0[5] * dT" />
        <RemoveContaining Vector = "-X0[0] * dT;-Y0[0] * dT;-Z0[0] * dT" />
        <RemoveContaining Vector = "-X0[1] * dT;-Y0[1] * dT;-Z0[1] * dT" />
        <RemoveContaining Vector = "-X0[2] * dT;-Y0[2] * dT;-Z0[2] * dT" />
