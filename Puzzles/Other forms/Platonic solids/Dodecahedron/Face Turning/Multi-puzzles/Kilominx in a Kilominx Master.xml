    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';
        R1 := 0.7;
        D1 := (3 * Rsin + 1 * R2sin) / 4;
        D2 := (2 * Rsin + 2 * R2sin) / 4;
        R2 := R * 11 * R2sin / 3 / (RSin + R2Sin);
        delta := 0.015;
        DCut := RSin;
        mAngle := ArcTan(0.5);
        As := sin(mAngle);
        Ac := cos(mAngle);
        sAngle := PI * 2 / 5;
        for i := 1 to 5 do begin
            xa[i] := sin(sAngle * (i - 1)) * Ac;
            ya[i] := cos(sAngle * (i - 1)) * Ac;
        end;
    </Script>

