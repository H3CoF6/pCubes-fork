<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Multidodecahedron Super</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Multi-puzzles\Multidodecahedron Super</Menu>
        <Menu>Other forms\Multi-puzzles\Multidodecahedron Super</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2019-11-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2384</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := 2 * R2sin / 3;
        DCut := R * (5 * sqrt(5) / 3 + 1) / 6;
        RP := -D * (5 - sqrt(5)) + R * 2 * sqrt((5 + sqrt(5)) / 30) + RSin;
        <!-- RP := R * sqrt((185 - 58 * sqrt(5)) / 27);-->
        delta := 1.06; // thickness of central parts

        R2 := R * D / ((Rsin + R2sin) / 2); // small dodecahedron
        RP2 := R2 * sqrt((5 + sqrt(5)) / 6);
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Script> R := Rp; DCut1 := RSin; DCut2 := DCut1 * delta; </Script>
        <LoadFrom File = "Puzzles\Other forms\Platonic solids\Dodecahedron\Face Turning\Minx\_Macro_For_Super.xml" />
        <ShowAll/>
        <SplitByAxes/>

        <Macro Name = "Split" >
            <Split> <Plane NormDistance = "DCut" NormVector = " Vx[i]; Vy[i]; Vz[i]" /> </Split>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "20" i = "0" />

        <Macro Name = "RemoveCenters" >
            <RemoveContaining Vector = "Cx[Id]; Cy[Id]; Cz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenters" Id = "0" Repeat = "12" />

         <!-- add small figure -->
        <Script> R := R2; </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <SplitByAxes/>

        <Script> R := RP2; DCut1 := R2 * sin(dAngle); DCut2 := DCut1 * delta; </Script>
        <LoadFrom File = "Puzzles\Other forms\Platonic solids\Dodecahedron\Face Turning\Minx\_Macro_For_Super.xml" />
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
