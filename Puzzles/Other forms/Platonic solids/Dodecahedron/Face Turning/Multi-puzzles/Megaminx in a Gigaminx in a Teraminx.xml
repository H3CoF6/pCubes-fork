        <RemoveContaining Vector = " xa[4] * (DCut1 + DCut2)/2;  ya[4] * (DCut1 + DCut2)/2;  As * (DCut1 + DCut2)/2" />
        <RemoveContaining Vector = " xa[5] * (DCut1 + DCut2)/2;  ya[5] * (DCut1 + DCut2)/2;  As * (DCut1 + DCut2)/2" />
        <RemoveContaining Vector = "-xa[1] * (DCut1 + DCut2)/2; -ya[1] * (DCut1 + DCut2)/2; -As * (DCut1 + DCut2)/2" />
        <RemoveContaining Vector = "-xa[2] * (DCut1 + DCut2)/2; -ya[2] * (DCut1 + DCut2)/2; -As * (DCut1 + DCut2)/2" />
        <RemoveContaining Vector = "-xa[3] * (DCut1 + DCut2)/2; -ya[3] * (DCut1 + DCut2)/2; -As * (DCut1 + DCut2)/2" />
        <RemoveContaining Vector = "-xa[4] * (DCut1 + DCut2)/2; -ya[4] * (DCut1 + DCut2)/2; -As * (DCut1 + DCut2)/2" />
        <RemoveContaining Vector = "-xa[5] * (DCut1 + DCut2)/2; -ya[5] * (DCut1 + DCut2)/2; -As * (DCut1 + DCut2)/2" />


        <Script>
            R := 0.59;
            DCut1 := RSin - delta;
            DCut2 := RSin;
        </Script>
        <LoadFrom File = "Puzzles\Other forms\Platonic solids\Dodecahedron\Face Turning\Minx\_Macro_For_Not_Super.xml" />

        <ShowAll/>

        <Script> R := R2; </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
          <Macro Name = "Split">
            <Split Axis = "id" From = "2" />
            <Split Axis = "id" From = "5" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" id = "0" />

        <RemoveContaining Vector = "0; 0;  D2" />
        <RemoveContaining Vector = "0; 0; -D2" />
        <RemoveContaining Vector = " xa[1] * D2;  ya[1] * D2;  As * D2" />
        <RemoveContaining Vector = " xa[2] * D2;  ya[2] * D2;  As * D2" />
        <RemoveContaining Vector = " xa[3] * D2;  ya[3] * D2;  As * D2" />
        <RemoveContaining Vector = " xa[4] * D2;  ya[4] * D2;  As * D2" />
        <RemoveContaining Vector = " xa[5] * D2;  ya[5] * D2;  As * D2" />
        <RemoveContaining Vector = "-xa[1] * D2; -ya[1] * D2; -As * D2" />
        <RemoveContaining Vector = "-xa[2] * D2; -ya[2] * D2; -As * D2" />
