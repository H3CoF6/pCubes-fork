<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentulminx in Pentultimate Elite</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Multi-puzzles\Pentulminx in Pentultimate Elite</Menu>
        <Menu>Other forms\Multi-puzzles\Pentulminx in Pentultimate Elite</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2019-11-21</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        R2 := R * 4 * R2sin / 3 / (RSin + R2Sin);
        D := 2 * R2sin / 3;

        DC0 := 2 * R2sin / 3 * 1.2;
        DCut := R * (5 * sqrt(5) / 3 + 1) / 6;
        DCutS := DCut - R * 0.022; // size of frame
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "HideCenter" >
            <HideContaining Vector = " Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "HideCenter" Repeat = "12" i = "0" />

        <InvertVisibility/>

        <Macro Name = "Split" >
            <Split> <Plane NormDistance = "DCutS" NormVector = " Vx[i]; Vy[i]; Vz[i]" /> </Split>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "20" i = "0" />

        <ShowAll/>

        <Macro Name = "Split" >
            <Split> <Plane NormDistance = "DCut" NormVector = " Vx[i]; Vy[i]; Vz[i]" /> </Split>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "20" i = "0" />
        <RemoveGrayParts/>

        <Macro Name = "RemoveCenters" >
            <RemoveContaining Vector = "Cx[Id]; Cy[Id]; Cz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenters" Id = "0" Repeat = "12" />

        <!-- add small figure -->

        <Script> R := R2; </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>

    </Figure>
</xml>
