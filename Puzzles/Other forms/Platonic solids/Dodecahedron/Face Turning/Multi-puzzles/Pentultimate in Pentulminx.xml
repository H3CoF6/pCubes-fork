<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>

        <Name>Pentultimate in Pentulminx</Name>
        <Menu>Other forms\Dodecahedron\Face Turning\Multi-puzzles\Pentultimate in Pentulminx</Menu>
        <Menu>Other forms\Multi-puzzles\Pentultimate in Pentulminx</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-02</Added>
        <Link></Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := (Rsin + R2sin) / 2;
        R2 := R * As * 3 * R2sin;
        R2 := R * 0.2;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "Split">
            <Split Axis = "ax" From = "1" />
            <Split Axis = "ax" From = "3" />
            <Script>Inc(ax);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "6" ax = "0" />

        <Macro Name = "RemoveCenters">
            <RemoveContaining Vector = "Cx[i]; Cy[i]; Cz[i]" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenters" Repeat = "12" i = "0" />

        <SplitByAxes/>
        <RemoveGrayParts/>

         <!-- add small figure -->
        <Script> R := R2; </Script>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ShowAll/>
        <SplitByAxes/>

    </Figure>
</xml>
