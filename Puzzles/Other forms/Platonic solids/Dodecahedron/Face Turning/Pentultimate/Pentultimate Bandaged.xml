<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentultimate Bandaged</Name>
        <Aliases>Pentultimate Fused</Aliases>
        <Menu>Other forms\Dodecahedron\Face Turning\Pentultimate\Pentultimate Bandaged</Menu>
        <Inventor>Jason Gavril</Inventor>
        <Programmer>Julian Wilkinson</Programmer>
        <Added>2020-07-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8136</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "Cx[11]; Cy[11]; Cz[11]" />
        <Axis NormVector = "Cx[ 8]; Cy[ 8]; Cz[ 8]" />
        <Axis NormVector = "Cx[ 9]; Cy[ 9]; Cz[ 9]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "0; 0; RSin" />
        <Split><Plane NormVector = "Cx[ 6]; Cy[ 6]; Cz[ 6]" /></Split>
        <Split><Plane NormVector = "Cx[ 7]; Cy[ 7]; Cz[ 7]" /></Split>
        <Split><Plane NormVector = "Cx[10]; Cy[10]; Cz[10]" /></Split>
        <ShowAll/>
    </Figure>
</xml>
