        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF66CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        R := 0.7;
        phi := (sqrt(5) - 1) / 2; // The golden ratio
        a := R / sqrt(3);
        b := a / phi;
        c := a * phi;

        pillow := 1.14; // 1 - flat dodecaherdon. sqrt(5) - Alexandr's star
        e := (2*a+b)/5 * pillow;
        f := (2*a+2*b+c)/5 * pillow;

        D := b / sqrt(2);
        JumAngle := Arccos(1/3);
    </Script>

