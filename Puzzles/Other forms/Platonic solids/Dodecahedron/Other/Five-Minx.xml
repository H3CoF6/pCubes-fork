        Colors[0] := 'FFDD00'; // Yellow
        Colors[1] := '8800CC'; // Purple
        Colors[2] := 'FFFFFF'; // White
        Colors[3] := 'CC0000'; // Red
        Colors[4] := '0011EE'; // Blue

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * 2/5 * sqrt((5 + 2 * sqrt(5)) / 3);

        k := 1.18;
        for i := 0 to 11 do begin
            Cx[i] := Cx[i] * k;
            Cy[i] := Cy[i] * k;
            Cz[i] := Cz[i] * k;
        end;
    </Script>

