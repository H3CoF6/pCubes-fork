<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rotaminx</Name>
        <Menu>Other forms\Dodecahedron\Other\Rotaminx</Menu>
        <Inventor>José Manuel Garcéa Mouzo</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-05-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3341</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := cos(sAngle) * Ac * Rcos + As * Rsin; // = R * sqrt((25 - 2 * sqrt(5)) / 3) / 5
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi" />
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
