    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0000CC'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := '800080'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0066CC'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF88CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        // code from Pentagonal Icositetrahedron
        K  := 0.7; // result is independent from K
        K1 := (6 * (9 + sqrt(33)))^(1/3);
        K2 := (6 * (9 - sqrt(33)))^(1/3);
        K3 := (2 * (1777 + 33*sqrt(33)))^(1/3);
        K4 := (2 * (1777 - 33*sqrt(33)))^(1/3);

        Cp0 := K * sqrt(6 * (-6 + K1 + K2)) / 12;
        Cp1 := K * sqrt(6 * ( 6 + K1 + K2)) / 12;
        Cp2 := K * sqrt(6 * (18 + K1 + K2)) / 12;
        Cp3 := K * sqrt(6 * (14 + K3 + K4)) / 12;

        C0 := K * 0.0761776313733;
        C1 := K * 0.3569761362781;
        C2 := K * 0.5307631976640 * 0.93;
        C3 := K * 0.5775995216706;
        C4 := K * 0.8587928937980 * 0.93;
        C5 := K * 0.9345756579487;

        n1 := (cp1 - cp0)^2;
        n2 := (cp1 - cp2)^2;
        n3 := (cp1 - cp2) * (cp0 - cp1);

        bgx := -n2*n3 + n1^2;
        bgy :=  n1*n2 - n3^2;
        bgz := -n1*n3 + n2^2;

        byx := -n2^2 + n1*n3;
        byy :=  n1^2 - n2*n3;
        byz := -n3^2 + n1*n2;

        A1 := ArcCos((bgx*byx + bgy*byy + bgz*byz) / (bgx^2 + bgy^2 + bgz^2));
        A2 := 2 * A1;
        A3 := 3 * A1;
        A4 := 4 * A1;

        D := K * 0.7955;
    </Script>

