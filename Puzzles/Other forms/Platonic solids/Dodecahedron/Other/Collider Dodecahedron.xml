    <Script>
        Colors[ 0] := '00BBFF'; // Blue1
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := 'FF6000'; // Orange
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '0000EE'; // Blue3
        Colors[ 5] := 'DD0055'; // Red2
        Colors[ 6] := '0088FF'; // Blue2
        Colors[ 7] := 'FF55BB'; // Pink
        Colors[ 8] := '8800DD'; // Violett
        Colors[ 9] := '00FF00'; // Green1
        Colors[10] := '007700'; // Green3
        Colors[11] := '00AA00'; // Green2

        R := 0.7;

        phi := (sqrt(5) - 1) / 2; // The golden ratio
        a := R / sqrt(3);
        b := a / phi;
        c := a * phi;

        pillow := 1.14; // 1 - flat dodecaherdon. sqrt(5) - Alexandr's star

        Cn1 := c;
        Cn2 := (2*a+b)/5 * pillow;
        Cn3 := a;
        Cn4 := (2*a+2*b+c)/5 * pillow;
        Cn5 := b;

        pA1 := phi;
        pA2 := 3;
        pB1 := phi * 2;
        pB2 := 1;
        pB3 := phi + 2;
        pC1 := pB1 + 1;
        pC2 := 2;

        D := (pA1 * Cn2 + pA2 * Cn4) / sqrt(pA1^2 + pA2^2);

        A1 := ArcCos(( 7 - 9 * sqrt(5)) / 36);
        A2 := ArcCos((-9 +     sqrt(5)) / 12);
    </Script>

