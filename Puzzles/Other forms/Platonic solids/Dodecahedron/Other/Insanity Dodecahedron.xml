        C4 := K * 0.8587928937980 * Pillow;
        C5 := K * 0.9345756579487;

        D := (3 * C5 - C1) / sqrt(11);

        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

