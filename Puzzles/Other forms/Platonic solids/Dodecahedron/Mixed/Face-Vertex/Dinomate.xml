<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dinomate</Name>
        <Menu>Other forms\Dodecahedron\Mixed\Face-Vertex\Dinomate</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2020-02-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5395</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := '0000CC'; // clBlue
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '00AA00'; // clGreen
        Colors[ 5] := '800080'; // clViolett
        Colors[ 6] := 'FFFFAA'; // clCream
        Colors[ 7] := '0066CC'; // clLightBlue
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := '00FF00'; // clLightGreen
        Colors[10] := 'FF88CC'; // clLightViolett
        Colors[11] := '666666'; // clGray

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        D := R * sqrt(5) / 3;
        DCut := R * 0.73;
    </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D; D" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
        <Axis NormVector = "Vx[6]; Vy[6]; Vz[6]" />
        <Axis NormVector = "Vx[7]; Vy[7]; Vz[7]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "4;3;2;1;0" />
                <Face Color = "Colors[ 1]" VertexIndexes = "0;1;6;10;5" />
                <Face Color = "Colors[ 2]" VertexIndexes = "1;2;7;11;6" />
                <Face Color = "Colors[ 3]" VertexIndexes = "2;3;8;12;7" />
                <Face Color = "Colors[ 4]" VertexIndexes = "3;4;9;13;8" />
                <Face Color = "Colors[ 5]" VertexIndexes = "4;0;5;14;9" />
                <Face Color = "Colors[ 6]" VertexIndexes = "18;17;12;8;13" />
                <Face Color = "Colors[ 7]" VertexIndexes = "19;18;13;9;14" />
                <Face Color = "Colors[ 8]" VertexIndexes = "15;19;14;5;10" />
                <Face Color = "Colors[ 9]" VertexIndexes = "16;15;10;6;11" />
                <Face Color = "Colors[10]" VertexIndexes = "17;16;11;7;12" />
                <Face Color = "Colors[11]" VertexIndexes = "15;16;17;18;19" />
            </Faces>
        </Part>

        <SplitByAxes/>

 <!-- cut vertices for better control -->
        <Macro Name = "Cut">
            <HideContaining Vector = "Ex[e]; Ey[e]; Ez[e]"  />
            <InvertVisibility/>
            <Cut> <Plane NormVector = "-Cx[c1]; -Cy[c1]; -Cz[c1]" NormDistance = "-DCut" /> </Cut>
            <Cut> <Plane NormVector = "-Cx[c2]; -Cy[c2]; -Cz[c2]" NormDistance = "-DCut" /> </Cut>
            <ShowAll/>
            <HideContaining Vector = "-Ex[e]; -Ey[e]; -Ez[e]"  />
            <InvertVisibility/>
            <Cut> <Plane NormVector = " Cx[c1];  Cy[c1];  Cz[c1]" NormDistance = "-DCut" /> </Cut>
            <Cut> <Plane NormVector = " Cx[c2];  Cy[c2];  Cz[c2]" NormDistance = "-DCut" /> </Cut>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "Cut" e = " 0" c1 = " 2" c2 = " 5" />
        <ExecMacro MacroName = "Cut" e = " 1" c1 = " 1" c2 = " 3" />
        <ExecMacro MacroName = "Cut" e = " 2" c1 = " 2" c2 = " 4" />
        <ExecMacro MacroName = "Cut" e = " 3" c1 = " 3" c2 = " 5" />
        <ExecMacro MacroName = "Cut" e = " 4" c1 = " 4" c2 = " 1" />

        <ExecMacro MacroName = "Cut" e = " 5" c1 = " 0" c2 = " 8" />
        <ExecMacro MacroName = "Cut" e = " 6" c1 = " 0" c2 = " 9" />
        <ExecMacro MacroName = "Cut" e = " 7" c1 = " 0" c2 = "10" />
        <ExecMacro MacroName = "Cut" e = " 8" c1 = " 0" c2 = " 6" />
        <ExecMacro MacroName = "Cut" e = " 9" c1 = " 0" c2 = " 7" />

        <ExecMacro MacroName = "Cut" e = "10" c1 = " 9" c2 = " 5" />
        <ExecMacro MacroName = "Cut" e = "11" c1 = "10" c2 = " 1" />
        <ExecMacro MacroName = "Cut" e = "12" c1 = " 6" c2 = " 2" />
        <ExecMacro MacroName = "Cut" e = "13" c1 = " 7" c2 = " 3" />
        <ExecMacro MacroName = "Cut" e = "14" c1 = " 8" c2 = " 4" />
        <ShowAll/>
        <RemoveGrayParts/>
    </Figure>
</xml>
