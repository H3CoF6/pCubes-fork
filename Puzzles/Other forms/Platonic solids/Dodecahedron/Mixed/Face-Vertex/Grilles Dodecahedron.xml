<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Grilles Dodecahedron</Name>
        <Menu>Other forms\Dodecahedron\Mixed\Face-Vertex\Grilles Dodecahedron</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8341</Link>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=107305&amp;extra=page%3D4</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := '0000CC'; // clBlue
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '00AA00'; // clGreen
        Colors[ 5] := '800080'; // clViolett
        Colors[ 6] := 'FFFFAA'; // clCream
        Colors[ 7] := '0066CC'; // clLightBlue
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := '00FF00'; // clLightGreen
        Colors[10] := 'FF88CC'; // clLightViolett
        Colors[11] := '666666'; // clGray

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        k := 1.15;
        for i := 0 to 11 do begin
            Ckx[i] := Cx[i] * k;
            Cky[i] := Cy[i] * k;
            Ckz[i] := Cz[i] * k;
        end;

        x := 0.64;
        Tx := Ckx[1] + x * (Ex[0] - Ckx[1]);
        Ty := Cky[1] + x * (Ey[0] - Cky[1]);
        Tz := Ckz[1] + x * (Ez[0] - Ckz[1]);

        D1 := (Tx * Vx[1] + Ty * Vy[1] + Tz * Vz[1]) / R;
        D2 := Tz;
    </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3"  PlaneDistances = "-D1; D1" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
        <Axis NormVector = "Vx[6]; Vy[6]; Vz[6]" />
        <Axis NormVector = "Vx[7]; Vy[7]; Vz[7]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>
    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D2; D2">
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace" >
            <Face Color = "Color" VertexIndexes = "i1; i2; i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i2; i3; i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i3; i4; i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i4; i5; i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i5; i1; i0" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ckx; Cky; Ckz" />

            <Faces>
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 0]" i0 = "'20'" i1 = "' 4'" i2 = "' 3'" i3 = "' 2'" i4 = "' 1'" i5 = "' 0'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 1]" i0 = "'21'" i1 = "' 0'" i2 = "' 1'" i3 = "' 6'" i4 = "'10'" i5 = "' 5'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 2]" i0 = "'22'" i1 = "' 1'" i2 = "' 2'" i3 = "' 7'" i4 = "'11'" i5 = "' 6'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 3]" i0 = "'23'" i1 = "' 2'" i2 = "'03'" i3 = "' 8'" i4 = "'12'" i5 = "' 7'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 4]" i0 = "'24'" i1 = "' 3'" i2 = "' 4'" i3 = "' 9'" i4 = "'13'" i5 = "' 8'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 5]" i0 = "'25'" i1 = "' 4'" i2 = "' 0'" i3 = "' 5'" i4 = "'14'" i5 = "' 9'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 6]" i0 = "'26'" i1 = "'18'" i2 = "'17'" i3 = "'12'" i4 = "' 8'" i5 = "'13'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 7]" i0 = "'27'" i1 = "'19'" i2 = "'18'" i3 = "'13'" i4 = "' 9'" i5 = "'14'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 8]" i0 = "'28'" i1 = "'15'" i2 = "'19'" i3 = "'14'" i4 = "' 5'" i5 = "'10'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[ 9]" i0 = "'29'" i1 = "'16'" i2 = "'15'" i3 = "'10'" i4 = "' 6'" i5 = "'11'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[10]" i0 = "'30'" i1 = "'17'" i2 = "'16'" i3 = "'11'" i4 = "' 7'" i5 = "'12'" />
                <ExecMacro MacroName = "AddFace" Color = "Colors[11]" i0 = "'31'" i1 = "'15'" i2 = "'16'" i3 = "'17'" i4 = "'18'" i5 = "'19'" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = " -20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = "  30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
