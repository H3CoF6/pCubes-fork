<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Minx</Name>
        <Menu>Other forms\Dodecahedron\Mixed\Face-Edge\Square-1 Minx</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2555</Link>
    </Interface>

    <Script>
        S15 := sin (2*Pi/10);
        C15 := cos (2*Pi/10);

        R := 0.7;
        D := R * sin((Arctan(2) - Arcsin(2/3)) / 2);
    </Script>

    <Axes TurningAngles = "Pi / 5" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 5" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 5" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 5" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi / 5" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "-4*Pi / 5" />
    </Figure>
</xml>
