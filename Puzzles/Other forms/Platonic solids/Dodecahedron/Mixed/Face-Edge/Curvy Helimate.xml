<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Helimate</Name>
        <Menu>Other forms\Dodecahedron\Mixed\Face-Edge\Curvy Helimate</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6993</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * (sqrt(3) * (Sqrt(5) + 3) / 12 + 0.03);

        DCut := R * 0.437;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "arctan(2)" PlaneDistances = "-D; D" >
        <Axis NormVector = "Ex[ 0]; Ey[ 0]; Ez[ 0]" />
        <Axis NormVector = "Ex[ 1]; Ey[ 1]; Ez[ 1]" />
        <Axis NormVector = "Ex[ 2]; Ey[ 2]; Ez[ 2]" />
        <Axis NormVector = "Ex[ 3]; Ey[ 3]; Ez[ 3]" />
        <Axis NormVector = "Ex[ 4]; Ey[ 4]; Ez[ 4]" />
        <Axis NormVector = "Ex[ 5]; Ey[ 5]; Ez[ 5]" />
        <Axis NormVector = "Ex[ 6]; Ey[ 6]; Ez[ 6]" />
        <Axis NormVector = "Ex[ 7]; Ey[ 7]; Ez[ 7]" />
        <Axis NormVector = "Ex[ 8]; Ey[ 8]; Ez[ 8]" />
        <Axis NormVector = "Ex[ 9]; Ey[ 9]; Ez[ 9]" />
        <Axis NormVector = "Ex[10]; Ey[10]; Ez[10]" />
        <Axis NormVector = "Ex[11]; Ey[11]; Ez[11]" />
        <Axis NormVector = "Ex[12]; Ey[12]; Ez[12]" />
        <Axis NormVector = "Ex[13]; Ey[13]; Ez[13]" />
        <Axis NormVector = "Ex[14]; Ey[14]; Ez[14]" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>

<!--        <Macro Name = "Hide">
            <HideContaining Vector = " Vx[v];  Vy[v];  Vz[v]" />
            <HideContaining Vector = "-Vx[v]; -Vy[v]; -Vz[v]" />
            <Cut><Plane NormVector = "Cx[f1]; Cy[f1]; Cz[f1]" NormDistance = "-DCut" /></Cut>
            <Cut><Plane NormVector = "Cx[f2]; Cy[f2]; Cz[f2]" NormDistance = "-DCut" /></Cut>
            <Cut><Plane NormVector = "Cx[f3]; Cy[f3]; Cz[f3]" NormDistance = "-DCut" /></Cut>
            <Script> Inc(v); </Script>
        </Macro>

        <ExecMacro MacroName = "Hide" v = "0" f1 = "8" f2 = "0" f3 = "0" Repeat = "10" />
            <InvertVisibility/>-->

        <!-- cut for better control -->
        <Macro Name = "Cut">

            <HideContaining Vector = " Vx[V1];  Vy[V1];  Vz[V1]" />
            <HideContaining Vector = " Vx[V2];  Vy[V2];  Vz[V2]" />
            <HideContaining Vector = "-Vx[V1]; -Vy[V1]; -Vz[V1]" />
            <HideContaining Vector = "-Vx[V2]; -Vy[V2]; -Vz[V2]" />
            <InvertVisibility/>
            <Hide Axis = "Ax" Layer = "1" />

            <Cut><Plane NormVector = "Vx[V1] - Vx[V2]; Vy[V1] - Vy[V2]; Vz[V1] - Vz[V2]" NormDistance = "-DCut" /></Cut>
            <Cut><Plane NormVector = "Vx[V2] - Vx[V1]; Vy[V2] - Vy[V1]; Vz[V2] - Vz[V1]" NormDistance = "-DCut" /></Cut>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Cut" Ax = " 0" V1 = " 0" V2 = "1" />
        <ExecMacro MacroName = "Cut" Ax = " 1" V1 = " 1" V2 = "2" />
        <ExecMacro MacroName = "Cut" Ax = " 2" V1 = " 2" V2 = "3" />
        <ExecMacro MacroName = "Cut" Ax = " 3" V1 = " 3" V2 = "4" />
        <ExecMacro MacroName = "Cut" Ax = " 4" V1 = " 4" V2 = "0" />
        <ExecMacro MacroName = "Cut" Ax = " 5" V1 = " 0" V2 = "5" />
        <ExecMacro MacroName = "Cut" Ax = " 6" V1 = " 1" V2 = "6" />
        <ExecMacro MacroName = "Cut" Ax = " 7" V1 = " 2" V2 = "7" />
        <ExecMacro MacroName = "Cut" Ax = " 8" V1 = " 3" V2 = "8" />
        <ExecMacro MacroName = "Cut" Ax = " 9" V1 = " 4" V2 = "9" />
        <ExecMacro MacroName = "Cut" Ax = "10" V1 = "10" V2 = "5" />
        <ExecMacro MacroName = "Cut" Ax = "11" V1 = "11" V2 = "6" />
        <ExecMacro MacroName = "Cut" Ax = "12" V1 = "12" V2 = "7" />
        <ExecMacro MacroName = "Cut" Ax = "13" V1 = "13" V2 = "8" />
        <ExecMacro MacroName = "Cut" Ax = "14" V1 = "14" V2 = "9" />

    </Figure>
</xml>
