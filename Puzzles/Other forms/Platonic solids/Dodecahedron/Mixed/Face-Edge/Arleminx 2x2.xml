<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Arleminx 2x2</Name>
        <Aliases>2x2 Megaminx</Aliases>
        <Class>TArleminx</Class>
        <Menu>Other forms\Dodecahedron\Mixed\Face-Edge\Arleminx 2x2</Menu>
        <Inventor>Félix Nadin, Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-12-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4812</Link>
    </Interface>

    <Script>
        clRed          := 'FF0000';
        clWhite        := 'FFFFFF';
        clGreen        := '007700';
        clBlue         := '0000FF';
        clLightViolett := 'FF38E4';
        clLightYellow  := 'FFF08F';
        clViolett      := 'B200FF';
        clYellow       := 'FFFF00';
        clLightGreen   := '00FF00';
        clGray         := 'AAAAAA';
        clLightBlue    := '7777FF';
        clOrange       := 'FF6A00';

        R := 0.7;
        phi := (Sqrt(5) - 1) / 2; // The golden ratio

        // vertex
        a := R / sqrt(3);
        b := a / phi;
        c := a * phi;

        JumAngle := ArcTan(2);

        // axes
        aa := (2 * (a + b) + c) / 5; // a * (5 + 3 * sqrt(5)) / 10
        ba := (b + 2 * a) / 5;       // a * (5 +     sqrt(5)) / 10 // = aa * phi

        // fake axes
        bas := ba*sin(JumAngle);     // 2 * bac
        bac := ba*cos(JumAngle);     // a * (1 + sqrt(5)) / 10 // = b / 5 // = aa * phi / sqrt(5)

        // Circles
        RC := 0.1;
        Delta := 0.002;
        L := 1 + delta;

        D0 := 0.4;
        D1 := sqrt(aa^2 + ba^2); // a * sqrt((5 + 2 * sqrt(5)) / 5)
    </Script>
   
    <Axes TurningAngles = "Pi / 2" JumbleAngle = "JumAngle" PlaneDistances = "0" TurnAxesWithPartNo = "264" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "0; Pi/5; 0; Pi/5; 0" PlaneDistances = "-D1; -D0; D0; D1" >
        <Axis NormVector = " aa;  ba;   0" />
        <Axis NormVector = " aa; -ba;   0" />
        <Axis NormVector = "  0;  aa;  ba" />
        <Axis NormVector = "  0;  aa; -ba" />
        <Axis NormVector = " ba;   0;  aa" />
        <Axis NormVector = "-ba;   0;  aa" />
    </Axes>

    <!-- fake axes -->
    <Axes TurningAngles = "0; Pi/5; 0; Pi/5; 0" PlaneDistances = "-D1; -D0; D0; D1" >
        <Axis NormVector = " ba;  aa;   0" />
        <Axis NormVector = " ba; -aa;   0" />
        <Axis NormVector = "  0;  ba;  aa" />
        <Axis NormVector = "  0;  ba; -aa" />
        <Axis NormVector = " aa;   0;  ba" />
        <Axis NormVector = "-aa;   0;  ba" />

        <Axis NormVector = " bac; bas;aa" />
        <Axis NormVector = " bac;-bas;aa" />
        <Axis NormVector = "-bac; bas;aa" />
        <Axis NormVector = "-bac;-bas;aa" />
        <Axis NormVector = " bas; bac;aa" />
        <Axis NormVector = "-bas; bac;aa" />
        <Axis NormVector = " bas;-bac;aa" />
        <Axis NormVector = "-bas;-bac;aa" />

        <Axis NormVector = " bac;aa; bas" />
        <Axis NormVector = " bac;aa;-bas" />
        <Axis NormVector = "-bac;aa; bas" />
        <Axis NormVector = "-bac;aa;-bas" />
        <Axis NormVector = " bas;aa; bac" />
        <Axis NormVector = "-bas;aa; bac" />
        <Axis NormVector = " bas;aa;-bac" />
        <Axis NormVector = "-bas;aa;-bac" />

        <Axis NormVector = "aa; bac; bas" />
        <Axis NormVector = "aa; bac;-bas" />
        <Axis NormVector = "aa;-bac; bas" />
        <Axis NormVector = "aa;-bac;-bas" />
        <Axis NormVector = "aa; bas; bac" />
        <Axis NormVector = "aa;-bas; bac" />
        <Axis NormVector = "aa; bas;-bac" />
        <Axis NormVector = "aa;-bas;-bac" />
    </Axes>
    <!-- fake axes -->

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; c; b" />
                <Add Vector = " 0;-c; b" />
                <Add Vector = " 0;-c;-b" />
                <Add Vector = " 0; c;-b" />

                <Add Vector = " c; b; 0" />
                <Add Vector = "-c; b; 0" />
                <Add Vector = "-c;-b; 0" />
                <Add Vector = " c;-b; 0" />

                <Add Vector = " b; 0; c" />
                <Add Vector = " b; 0;-c" />
                <Add Vector = "-b; 0;-c" />
                <Add Vector = "-b; 0; c" />

                <Add Vector = " a; a; a" />
                <Add Vector = " a; a;-a" />
                <Add Vector = " a;-a; a" />
                <Add Vector = " a;-a;-a" />
                <Add Vector = "-a; a; a" />
                <Add Vector = "-a; a;-a" />
                <Add Vector = "-a;-a; a" />
                <Add Vector = "-a;-a;-a" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite       " VertexIndexes = "1;18;6;7;14" />
                <Face Color = "clLightViolett" VertexIndexes = "0;12;4;5;16" />
                <Face Color = "clViolett     " VertexIndexes = "2;15;7;6;19" />
                <Face Color = "clGray        " VertexIndexes = "3;17;5;4;13" />
                <Face Color = "clGreen       " VertexIndexes = "7;15;9;8;14" />
                <Face Color = "clLightYellow " VertexIndexes = "4;12;8;9;13" />
                <Face Color = "clYellow      " VertexIndexes = "6;18;11;10;19" />
                <Face Color = "clLightGreen  " VertexIndexes = "5;17;10;11;16" />
                <Face Color = "clRed         " VertexIndexes = "0;1;14;8;12" />
                <Face Color = "clBlue        " VertexIndexes = "1;0;16;11;18" />
                <Face Color = "clLightBlue   " VertexIndexes = "2;3;13;9;15" />
                <Face Color = "clOrange      " VertexIndexes = "3;2;19;10;17" />
            </Faces>
        </Part>

        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "7" From = "2" />
        <Split Axis = "8" From = "2" />
        <Split Axis = "3" From = "3" />
        <Split Axis = "4" From = "3" />
        <Split Axis = "5" From = "3" />
        <Split Axis = "6" From = "3" />
        <Split Axis = "7" From = "3" />
        <Split Axis = "8" From = "3" />

        <RemoveContaining Vector = "0; 0; 0" />
        <HideContaining Vector = " aa; ba;  0" />
        <HideContaining Vector = " aa;-ba;  0" />
        <HideContaining Vector = "  0; aa; ba" />
        <HideContaining Vector = "  0; aa;-ba" />
        <HideContaining Vector = " ba;  0; aa" />
        <HideContaining Vector = "-ba;  0; aa" />
        <HideContaining Vector = "-aa;-ba;  0" />
        <HideContaining Vector = "-aa; ba;  0" />
        <HideContaining Vector = "  0;-aa;-ba" />
        <HideContaining Vector = "  0;-aa; ba" />
        <HideContaining Vector = "-ba;  0;-aa" />
        <HideContaining Vector = " ba;  0;-aa" />

        <Split> <Plane NormVector = "   1;   0;   0" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "   0;   1;   0" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "   0;   0;   1" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = " a+c; a-b;   a" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "   a; a+c; a-b" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = " a-b;   a; a+c" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = " a+c;-a+b;   a" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "   a;-a-c; a-b" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = " a-b;  -a; a+c" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "-a-c; a-b;   a" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "  -a; a+c; a-b" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "-a+b;   a; a+c" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "-a-c;-a+b;   a" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "  -a;-a-c; a-b" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "-a+b;  -a; a+c" NormDistance = "0" /> </Split>

        <ShowAll/>

        <Circle Radius = "RC" Color = "clLightYellow " Center =  " aa * L; ba * L;  0 * L" />
        <Circle Radius = "RC" Color = "clGreen       " Center =  " aa * L;-ba * L;  0 * L" />
        <Circle Radius = "RC" Color = "clLightViolett" Center =  "  0 * L; aa * L; ba * L" />
        <Circle Radius = "RC" Color = "clGray        " Center =  "  0 * L; aa * L;-ba * L" />
        <Circle Radius = "RC" Color = "clRed         " Center =  " ba * L;  0 * L; aa * L" />
        <Circle Radius = "RC" Color = "clBlue        " Center =  "-ba * L;  0 * L; aa * L" />
        <Circle Radius = "RC" Color = "clYellow      " Center =  "-aa * L;-ba * L;  0 * L" />
        <Circle Radius = "RC" Color = "clLightGreen  " Center =  "-aa * L; ba * L;  0 * L" />
        <Circle Radius = "RC" Color = "clViolett     " Center =  "  0 * L;-aa * L;-ba * L" />
        <Circle Radius = "RC" Color = "clWhite       " Center =  "  0 * L;-aa * L; ba * L" />
        <Circle Radius = "RC" Color = "clOrange      " Center =  "-ba * L;  0 * L;-aa * L" />
        <Circle Radius = "RC" Color = "clLightBlue   " Center =  " ba * L;  0 * L;-aa * L" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />

    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "RotateCorner">
            <Turn Axis = "0" Layer = "1" Angle = "-Pi/2" />
            <Turn Axis = "2" Layer = "0" Angle = "-Pi/2" />
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2" />
            <Turn Axis = "0" Layer = "1" Angle = "-Pi/2" />
            <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" />
            <Turn Axis = "0" Layer = "1" Angle = " Pi/2" />
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2" />
            <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" />
        </Macro>
        <Macro Name = "Scr1">
            <Turn Axis = "ax[k]" Layer = "al[k]" Angle = "an[k] * 2 * Pi / 5 * m" />
            <Script>Inc(k);</Script>
        </Macro>
        <Macro Name = "Scr2">
            <ExecMacro MacroName = "RotateCorner" />

            <Script>
                for k := 0 to 10 do begin
                  ax[k] := Random(6) + 3;     // 3..8
                  al[k] := Random(2) * 2 + 1; // 1, 3
                  an[k] := Random(4) + 1;     // 1..4
                end;
            </Script>

            <ExecMacro MacroName = "Scr1" Repeat = "11" k = "0" m = "1" />
            <ExecMacro MacroName = "Scr1" Repeat = "11" k = "0" m = "-1" />
        </Macro>
        <Macro Name = "Scr3">
            <ExecMacro MacroName = "RotateCorner" />

            <Script>
                ax[0] := Random(3);
                if      ax[0] = 0 then begin ax[1] := 5; ax[2] := 6; end
                else if ax[0] = 1 then begin ax[1] := 8; ax[2] := 7; end
                else if ax[0] = 2 then begin ax[1] := 4; ax[2] := 3; end;
                al[0] := Random(2) * 2 + 1;
            </Script>

            <Turn Axis = "ax[0]" Layer = "1" Angle = "-JumAngle" />
            <Turn Axis = "ax[1]" Layer = "1" Angle = "Pi" />
            <Turn Axis = "ax[1]" Layer = "3" Angle = "Pi" />
            <Turn Axis = "ax[0]" Layer = "1" Angle = "2 * JumAngle" />
            <Turn Axis = "ax[2]" Layer = "1" Angle = "Pi" />
            <Turn Axis = "ax[2]" Layer = "3" Angle = "Pi" />
            <Turn Axis = "ax[0]" Layer = "1" Angle = "-JumAngle" />

            <Turn Axis = "Random(3)" Layer = "Random(2)" Angle = "Pi" />
        </Macro>
        <Macro Name = "Scr4">
            <Turn Axis = "Random(3)" Layer = "Random(2)" Angle = "Pi / 2" />
        </Macro>
        <Macro Name = "Scr5">
            <Turn Axis = "Random(36) + 3" Layer = "Random(2)*2+1" Angle = "Pi / 5 * (Random(4) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script> JumAngle := ArcTan(2); </Script>
            <ExecMacro MacroName = "Scr2" Repeat = "21" />
            <ExecMacro MacroName = "Scr3" Repeat = "100" />
            <ExecMacro MacroName = "Scr4" Repeat = "100" />
            <ExecMacro MacroName = "Scr5" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
