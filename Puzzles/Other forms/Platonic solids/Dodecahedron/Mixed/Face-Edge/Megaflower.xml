    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := '0011EE'; // clBlue
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '00AA00'; // clGreen
        Colors[ 5] := '8800BB'; // clViolett
        Colors[ 6] := 'FFFFAA'; // clCream
        Colors[ 7] := '0066CC'; // clLightBlue
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := '00FF00'; // clLightGreen
        Colors[10] := 'FF88CC'; // clLightViolett
        Colors[11] := '666666'; // clGray

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        k := 1.20;
        for i := 0 to 11 do begin
          Cx[i] := Cx[i] * k;
          Cy[i] := Cy[i] * k;
          Cz[i] := Cz[i] * k;
        end;

        s5 := sqrt(5);
        D1 := R * sqrt(3) * (2 * s5 - (s5 - 1) * k) / (s5 - k) / 6;
        D2 := (Rsin + R2sin) / 2;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D2" NormVectors = "Cx; Cy; Cz" />

    <Axes TurningAngles = "0; Pi" JumbleAngle = "arctan(2)" PlaneDistances = "D1" NormVectors = "Ex; Ey; Ez" />

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 4; 3;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 3; 2;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 2; 1;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 1; 0;20" InvisibleEdges = "6" />
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 4;20" InvisibleEdges = "6" />

                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 1;21" InvisibleEdges = "6" />
