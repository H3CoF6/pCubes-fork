                <Face Color = "Colors[11]" VertexIndexes = "19;15;31" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "RemoveVertex">
            <RemoveContaining Vector = "Vx[v]; Vy[v]; Vz[v]" />
            <Script>Inc(v);</Script>
        </Macro>
        <ExecMacro MacroName = "RemoveVertex" Repeat = "20" v = "0" />

        <!-- cut for better control -->
        <Macro Name = "Split1">
            <HideContaining Vector = "(Vx[0] + Cx[0]) / 2; (Vy[0] + Cy[0]) / 2; (Vz[0] + Cz[0]) / 2" />
            <HideContaining Vector = "(Vx[1] + Cx[0]) / 2; (Vy[1] + Cy[0]) / 2; (Vz[1] + Cz[0]) / 2" />
            <InvertVisibility/>
            <Cut><Plane NormVector = " 1;0;0" NormDistance = "-R * 0.35" /></Cut>
            <Cut><Plane NormVector = "-1;0;0" NormDistance = "-R * 0.35" /></Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "2 * Pi / 5" />
        </Macro>
        <Macro Name = "Split2">
            <ExecMacro MacroName = "Split1" Repeat = "5" />
            <Turn NormVector = "1;0;0" Angle = "Pi" />
            <ExecMacro MacroName = "Split1" Repeat = "5" />
            <Turn NormVector = "1;0;0" Angle = "Pi" />
        </Macro>
        <Macro Name = "Split3">
            <ExecMacro MacroName = "Split2" />
            <Turn NormVector = "Vx[0];Vy[0];Vz[0]" Angle = "2*Pi/3" />
            <ExecMacro MacroName = "Split2" />
            <Turn NormVector = "Vx[0];Vy[0];Vz[0]" Angle = "-2*Pi/3" />
            <Turn NormVector = "Vx[1];Vy[1];Vz[1]" Angle = " 2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Split3" Repeat = "3" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
