<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megaflower</Name>
        <Menu>Other forms\Dodecahedron\Mixed\Face-Edge\Megaflower</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-25</Added>
        <Link>https://www.instagram.com/p/CEo5ytpphcX/</Link>
