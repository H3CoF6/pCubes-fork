                <Face Color = "Colors[ 5]" VertexIndexes = " 0; 5;25" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 5;14;25" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = "14; 9;25" InvisibleEdges = "6" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 9; 4;25" InvisibleEdges = "6" />

                <Face Color = "Colors[ 6]" VertexIndexes = "18;17;26" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "17;12;26" InvisibleEdges = "6" />
                <Face Color = "Colors[ 6]" VertexIndexes = "12; 8;26" InvisibleEdges = "6" />
