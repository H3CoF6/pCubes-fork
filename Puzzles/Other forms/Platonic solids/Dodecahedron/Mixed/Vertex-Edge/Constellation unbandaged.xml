<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Constellation unbandaged</Name>
        <Menu>Other forms\Dodecahedron\Mixed\Vertex-Edge\Constellation unbandaged</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-14</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=32306</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        // 6 Starminx II (Edge) cuts
        D1 := R / sqrt(3);

        // 8 Starminx III (Deep corner) cuts
        jumAngle := ArcCos((-1 + 3 * Sqrt(5))/8);
        D2 := R / 3;
    </Script>

    // 6 Starminx II (Edge) cuts // JumbleAngle = "arctan(2)"
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "Ex[ 0]; Ey[ 0]; Ez[ 0]" />
        <Axis NormVector = "Ex[ 8]; Ey[ 8]; Ez[ 8]" />
        <Axis NormVector = "Ex[14]; Ey[14]; Ez[14]" />
    </Axes>

    // 8 Starminx III (Deep corner) cuts
    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" JumbleAngle = "jumAngle" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
        <Axis NormVector = "Vx[6]; Vy[6]; Vz[6]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Split Axis = "Ax" From = "1"/>
            <Split Axis = "Ax" From = "2"/>
        </Macro>

        <Macro Name = "TurnPart">
            <Turn Axis = "Ay" Angle = "jumAngle*Sign" Layer = "0" />
            <Turn Axis = "Ay" Angle = "jumAngle*Sign" Layer = "2" />
            <ExecMacro MacroName = "SplitPart" Ax = "0" />
            <ExecMacro MacroName = "SplitPart" Ax = "1" />
            <ExecMacro MacroName = "SplitPart" Ax = "2" />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "TurnPart" Ay = "3" Sign = " 1" />
        <ExecMacro MacroName = "TurnPart" Ay = "4" Sign = "-1" />
        <ExecMacro MacroName = "TurnPart" Ay = "5" Sign = " 1" />
        <ExecMacro MacroName = "TurnPart" Ay = "6" Sign = "-1" />

        <RemoveGrayParts/>

    </Figure>
</xml>
