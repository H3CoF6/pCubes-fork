    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " Ex[ 0]+Ex[ 8]; Ey[ 0]+Ey[ 8]; Ez[ 0]+Ez[ 8]" />
        <Axis NormVector = " Ex[ 0]+Ex[16]; Ey[ 0]+Ey[16]; Ez[ 0]+Ez[16]" />
        <Axis NormVector = " Ex[ 8]+Ex[16]; Ey[ 8]+Ey[16]; Ez[ 8]+Ez[16]" />
        <Axis NormVector = "-Ex[ 0]+Ex[ 8];-Ey[ 0]+Ey[ 8];-Ez[ 0]+Ez[ 8]" />
        <Axis NormVector = "-Ex[ 0]+Ex[16];-Ey[ 0]+Ey[16];-Ez[ 0]+Ez[16]" />
        <Axis NormVector = "-Ex[ 8]+Ex[16];-Ey[ 8]+Ey[16];-Ez[ 8]+Ez[16]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
