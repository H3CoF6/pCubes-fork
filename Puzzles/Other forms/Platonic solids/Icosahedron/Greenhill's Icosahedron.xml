<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Greenhill's Icosahedron</Name>
        <Menu>Other forms\Icosahedron\Greenhill's Icosahedron</Menu>
        <Inventor>Anthony Greenhill</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2137</Link>
     </Interface>

    <Script>
        R := 0.7;
        D := R * 0.14;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
       <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi/10" />
        <LoadFrom File = "Figures\Icosahedron.xml" />

        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 6" />
        <SplitByAxes/>
        <Undo Repeat = "3" />
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
