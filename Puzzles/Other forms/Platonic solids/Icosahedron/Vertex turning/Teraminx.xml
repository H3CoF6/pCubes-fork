<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Icosahedron Teraminx</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Teraminx</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3627</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := (1 * R + 9 * RSin) / 10;
        D2 := (2 * R + 8 * RSin) / 10;
        D3 := (3 * R + 7 * RSin) / 10;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D1; D2; D3" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" />

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
