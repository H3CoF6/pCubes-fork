<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tutt's Icosaminx Master</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Tutt's Icosaminx Master</Menu>
        <Inventor>Matthew Ray</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2034</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := (1 * R + 3 * RSin) / 4;
        D2 := (2 * R + 2 * RSin) / 4;
        D3 := (3 * R + 1 * RSin) / 4;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D3; D2; D1" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" />

   <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
   </Figure>

   <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
