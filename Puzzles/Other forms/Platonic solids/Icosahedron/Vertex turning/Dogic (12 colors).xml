<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dogic (12 colors)</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Dogic (12 colors)</Menu>
        <Inventor>Zoltán and Robert Vecsei</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=643</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9133</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        Color[ 0] := 'FFFF00'; // Yellow
        Color[ 1] := '0000A0'; // Blue
        Color[ 2] := '2828FF'; // LightBlue
        Color[ 3] := '00FF00'; // LightGreen
        Color[ 4] := '008000'; // Green
        Color[ 5] := 'FF0000'; // Red
        Color[ 6] := 'FF0080'; // LightViolett
        Color[ 7] := '800080'; // Violett
        Color[ 8] := '800000'; // Brown
        Color[ 9] := '00DCB4'; // Cyan
        Color[10] := 'ffffff'; // White
        Color[11] := '303030'; // Black

        D1 := Rsin;
        D2 := (Rsin + R) / 2;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D1; D2" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" />

    <Figure>
        <Macro Name = "AddColor" >
            <Face Color = "Color[c]" VertexIndexes = " c;e1;c1;e5" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = " c;e2;c2;e1" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = " c;e3;c3;e2" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = " c;e4;c4;e3" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = " c;e5;c5;e4" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <ExecMacro MacroName = "AddColor" c = " 0" e1 = "32" c1 = "12" e2 = "33" c2 = "13" e3 = "34" c3 = "14" e4 = "35" c4 = "15" e5 = "36" c5 = "16" />
                <ExecMacro MacroName = "AddColor" c = " 1" e1 = "32" c1 = "13" e2 = "41" c2 = "12" e3 = "47" c3 = "17" e4 = "42" c4 = "30" e5 = "37" c5 = "18" />
                <ExecMacro MacroName = "AddColor" c = " 2" e1 = "33" c1 = "14" e2 = "37" c2 = "13" e3 = "48" c3 = "18" e4 = "43" c4 = "31" e5 = "38" c5 = "19" />
                <ExecMacro MacroName = "AddColor" c = " 3" e1 = "34" c1 = "15" e2 = "38" c2 = "14" e3 = "49" c3 = "19" e4 = "44" c4 = "27" e5 = "39" c5 = "20" />
                <ExecMacro MacroName = "AddColor" c = " 4" e1 = "35" c1 = "16" e2 = "39" c2 = "15" e3 = "50" c3 = "20" e4 = "45" c4 = "28" e5 = "40" c5 = "21" />
                <ExecMacro MacroName = "AddColor" c = " 5" e1 = "36" c1 = "12" e2 = "40" c2 = "16" e3 = "51" c3 = "21" e4 = "46" c4 = "29" e5 = "41" c5 = "17" />
                <ExecMacro MacroName = "AddColor" c = " 6" e1 = "42" c1 = "18" e2 = "56" c2 = "30" e3 = "57" c3 = "25" e4 = "52" c4 = "26" e5 = "48" c5 = "31" />
                <ExecMacro MacroName = "AddColor" c = " 7" e1 = "43" c1 = "19" e2 = "52" c2 = "31" e3 = "58" c3 = "26" e4 = "53" c4 = "22" e5 = "49" c5 = "27" />
                <ExecMacro MacroName = "AddColor" c = " 8" e1 = "44" c1 = "20" e2 = "53" c2 = "27" e3 = "59" c3 = "22" e4 = "54" c4 = "23" e5 = "50" c5 = "28" />
                <ExecMacro MacroName = "AddColor" c = " 9" e1 = "45" c1 = "21" e2 = "54" c2 = "28" e3 = "60" c3 = "23" e4 = "55" c4 = "24" e5 = "51" c5 = "29" />
