<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rudiks Cube</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Rudiks Cube</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-02-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5569</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clWhite        := 'FFFFFF';
        clLightBlue    := '00BBFF';
        clBlue         := '0011EE';
        clBrown2       := '663300';
        clLightViolett := 'FF00AA';
        clRed          := 'FF0000';
        clLightGreen   := '00FF00';
        clGreen        := '008000';
        clViolett      := '8800AA';
        clOrange       := 'FF6600';
        clBrown        := '885500';
        clPink         := 'FF77DD';
        clOrange3      := 'FF7700';

        Colors[ 0] := clBrown2;
        Colors[ 1] := clBrown2;
        Colors[ 2] := clBrown2;
        Colors[ 3] := clBrown2;
        Colors[ 4] := clBrown2;
        Colors[ 5] := clGreen;
        Colors[ 6] := clBlue;
        Colors[ 7] := clLightViolett;
        Colors[ 8] := clOrange;
        Colors[ 9] := clYellow;
        Colors[10] := clBrown;
        Colors[11] := clBrown;
        Colors[12] := clBrown;
        Colors[13] := clBrown;
        Colors[14] := clBrown;
        Colors[15] := clLightGreen;
        Colors[16] := clLightBlue;
        Colors[17] := clViolett;
        Colors[18] := clRed;
        Colors[19] := clWhite;

        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := RSin * 1.04; // to have the bandaging parts visible at all times

        Vz[0] := R * 0.82;
        Vz[11] := -Vz[0];

        for i := 0 to 19 do
            C2z[i] := 0.75 * Cz[i];
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "Body" >
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />
                <Vertices Vectors = "Ex; Ey; Ez" />

                <Faces>
                    <Face Color = "Colors[ 0]" VertexIndexes = " 0; 1; 5" InvisibleEdges = "5" />
                    <Face Color = "Colors[ 1]" VertexIndexes = " 0; 2; 1" InvisibleEdges = "5" />
                    <Face Color = "Colors[ 2]" VertexIndexes = " 0; 3; 2" InvisibleEdges = "5" />
                    <Face Color = "Colors[ 3]" VertexIndexes = " 0; 4; 3" InvisibleEdges = "5" />
                    <Face Color = "Colors[ 4]" VertexIndexes = " 0; 5; 4" InvisibleEdges = "5" />
                    <Face Color = "Colors[ 5]" VertexIndexes = " 1;10;21" InvisibleEdges = "3" />
                    <Face Color = "Colors[17]" VertexIndexes = "21;10; 5" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 6]" VertexIndexes = " 2; 6;17" InvisibleEdges = "3" />
                    <Face Color = "Colors[18]" VertexIndexes = "17; 6; 1" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 7]" VertexIndexes = " 3; 7;18" InvisibleEdges = "3" />
                    <Face Color = "Colors[19]" VertexIndexes = "18; 7; 2" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 8]" VertexIndexes = " 4; 8;19" InvisibleEdges = "3" />
                    <Face Color = "Colors[15]" VertexIndexes = "19; 8; 3" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 9]" VertexIndexes = " 5; 9;20" InvisibleEdges = "3" />
                    <Face Color = "Colors[16]" VertexIndexes = "20; 9; 4" InvisibleEdges = "3" />
                    <Face Color = "Colors[10]" VertexIndexes = "11; 7; 8" InvisibleEdges = "5" />
                    <Face Color = "Colors[11]" VertexIndexes = "11; 8; 9" InvisibleEdges = "5" />
                    <Face Color = "Colors[12]" VertexIndexes = "11; 9;10" InvisibleEdges = "5" />
                    <Face Color = "Colors[13]" VertexIndexes = "11;10; 6" InvisibleEdges = "5" />
                    <Face Color = "Colors[14]" VertexIndexes = "11; 6; 7" InvisibleEdges = "5" />
                    <Face Color = "Colors[15]" VertexIndexes = "33; 3; 8" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 7]" VertexIndexes = " 7; 3;33" InvisibleEdges = "3" />
                    <Face Color = "Colors[16]" VertexIndexes = "34; 4; 9" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 8]" VertexIndexes = " 8; 4;34" InvisibleEdges = "3" />
                    <Face Color = "Colors[17]" VertexIndexes = "35; 5;10" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 9]" VertexIndexes = " 9; 5;35" InvisibleEdges = "3" />
                    <Face Color = "Colors[18]" VertexIndexes = "36; 1; 6" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 5]" VertexIndexes = "10; 1;36" InvisibleEdges = "3" />
                    <Face Color = "Colors[19]" VertexIndexes = "32; 2; 7" InvisibleEdges = "3" />
                    <Face Color = "Colors[ 6]" VertexIndexes = " 6; 2;32" InvisibleEdges = "3" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Body" />
        <SplitByAxes/>

        <HideContaining Vector = "Vx;Vy;Vz" />
        <Macro Name = "Split" >
            <Turn Axis = "ax" Layers = "0;2" Angle = "sAngle" />
            <SplitByAxes/>
            <Undo/>
            <Script> Inc(ax); </Script>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "5" />
        <ShowAll/>

        <HideContaining Vector = "Cx;Cy;Cz" />
        <HideContaining Vector = "Cx;Cy;C2z" />
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>

        <Script>
            for i := 5 to 19 do
                Colors[i] := -1;
            for i := 0 to 4 do
                Colors[i] := clPink;
            for i := 10 to 14 do
                Colors[i] := clOrange3;
        </Script>

        <ExecMacro MacroName = "Body" />
        <SplitByAxes/>

        <RemoveContaining Vector = "0;0;0" />
        <HideContaining Vector = "Vx;Vy;Vz" />
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "5" />

        <RemoveContaining Vector = "Cx;Cy;Cz" />
        <RemoveContaining Vector = "Cx;Cy;C2z" />

        <ShowAll/>
        <RemoveContaining Vector = "Ex;Ey;Ez" />
        <HideAll/>

        <Script>
            for i := 0 to 19 do
                Colors[i] := -1;
        </Script>

        <ExecMacro MacroName = "Body" />
        <SplitByAxes/>
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "5" />

        <HideContaining Vector = "Ex;Ey;Ez" />
        <RemoveAllVisible />
        <ShowAll/>

        <HideContaining Vector = "Ex;Ey;Ez" />
        <InvertVisibility/>

        <Macro Name = "Cut" >
            <Cut> <Plane NormVector = "Ex[i];Ey[i];Ez[i]" NormDistance = "-R * 0.83" /> </Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" Repeat = "30" />

        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
