    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := (Rsin + R) / 2;
        D2 := Rsin;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D1; D2" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" />

   <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
   </Figure>

   <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
