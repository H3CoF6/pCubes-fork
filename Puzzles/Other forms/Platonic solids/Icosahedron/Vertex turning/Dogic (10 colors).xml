<xml Data_Version = "2" >

    <Interface>
        <Name>Dogic (10 colors)</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Dogic (10 colors)</Menu>
        <Inventor>Zoltán and Robert Vecsei</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=644</Link>
