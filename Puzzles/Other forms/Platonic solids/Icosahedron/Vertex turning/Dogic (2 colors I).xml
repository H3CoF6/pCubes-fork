            <Face Color = "Color[c]" VertexIndexes = "v;e1;c1;e5" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = "v;e2;c2;e1" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = "v;e3;c3;e2" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = "v;e4;c4;e3" InvisibleEdges = "6" />
            <Face Color = "Color[c]" VertexIndexes = "v;e5;c5;e4" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <ExecMacro MacroName = "AddColor" c = " 0" v = " 3" c1 = "15" c2 = "14" c3 = "19" c4 = "27" c5 = "20" e1 = "34" e2 = "38" e3 = "49" e4 = "44" e5 = "39" />
                <ExecMacro MacroName = "AddColor" c = " 1" v = " 2" c1 = "14" c2 = "13" c3 = "18" c4 = "31" c5 = "19" e1 = "33" e2 = "37" e3 = "48" e4 = "43" e5 = "38" />
