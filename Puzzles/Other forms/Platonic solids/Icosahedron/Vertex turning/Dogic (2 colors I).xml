    <Interface>
        <Name>Dogic (2 colors I)</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Dogic (2 colors I)</Menu>
        <Inventor>Uwe Mèffert</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-10-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2959</Link>
