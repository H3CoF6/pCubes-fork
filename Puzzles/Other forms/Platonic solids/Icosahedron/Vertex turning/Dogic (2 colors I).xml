    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';
        include 'Figures\Scripts\Icosahedron_Standard_10_Colors.inc';

        clWhite := 'ffffff';
        clBlack := '303030';

        Color[ 0] := clWhite;
        Color[ 1] := clWhite;
        Color[ 2] := clWhite;
        Color[ 3] := clWhite;
        Color[ 4] := clBlack;
        Color[ 5] := clBlack;
        Color[ 6] := clBlack;
        Color[ 7] := clWhite;
        Color[ 8] := clWhite;
        Color[ 9] := clBlack;
        Color[10] := clBlack;
        Color[11] := clBlack;

        D1 := (Rsin + R) / 2;
        D2 := Rsin;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D1; D2" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" TurnAxesWithPartNo = "59" /> <!-- Part 59 - is for Solving procedure -->

    <Figure>
