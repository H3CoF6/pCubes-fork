<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mega-Icosamoid</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Mega-Icosamoid</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-02-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9760</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clWhite        := 'FFFFFF';
        clLightBlue    := '00BBFF';
        clBlue         := '0011EE';
        clOrange2      := 'FF9900';
        clLightViolett := 'FF77DD';
        clRed          := 'FF0000';
        clLightGreen   := '00FF00';
        clGreen        := '008000';
        clViolett      := '8800AA';
        clOrange       := 'FF6600';
        clGray         := 'AAAAAA';

        Colors[ 0] := clYellow;
        Colors[ 1] := clYellow;
        Colors[ 2] := clYellow;
        Colors[ 3] := clYellow;
        Colors[ 4] := clYellow;
        Colors[ 5] := clGreen;
        Colors[ 6] := clBlue;
        Colors[ 7] := clLightViolett;
        Colors[ 8] := clOrange;
        Colors[ 9] := clOrange2;
        Colors[10] := clWhite;
        Colors[11] := clWhite;
        Colors[12] := clWhite;
        Colors[13] := clWhite;
        Colors[14] := clWhite;
        Colors[15] := clLightGreen;
        Colors[16] := clLightBlue;
        Colors[17] := clViolett;
        Colors[18] := clRed;
        Colors[19] := clGray;

        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := (1 * R + 9 * RSin) / 10;

        Vz[0] := R * 0.82;
        Vz[11] := -Vz[0];
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 1; 5" InvisibleEdges = "5" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 2; 1" InvisibleEdges = "5" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0; 3; 2" InvisibleEdges = "5" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 0; 4; 3" InvisibleEdges = "5" />
                <Face Color = "Colors[ 4]" VertexIndexes = " 0; 5; 4" InvisibleEdges = "5" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 1;10; 5" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 2; 6; 1" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 3; 7; 2" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 4; 8; 3" />
                <Face Color = "Colors[ 9]" VertexIndexes = " 5; 9; 4" />
                <Face Color = "Colors[10]" VertexIndexes = "11; 7; 8" InvisibleEdges = "5" />
                <Face Color = "Colors[11]" VertexIndexes = "11; 8; 9" InvisibleEdges = "5" />
                <Face Color = "Colors[12]" VertexIndexes = "11; 9;10" InvisibleEdges = "5" />
                <Face Color = "Colors[13]" VertexIndexes = "11;10; 6" InvisibleEdges = "5" />
                <Face Color = "Colors[14]" VertexIndexes = "11; 6; 7" InvisibleEdges = "5" />
                <Face Color = "Colors[15]" VertexIndexes = " 7; 3; 8" />
                <Face Color = "Colors[16]" VertexIndexes = " 8; 4; 9" />
                <Face Color = "Colors[17]" VertexIndexes = " 9; 5;10" />
                <Face Color = "Colors[18]" VertexIndexes = "10; 1; 6" />
                <Face Color = "Colors[19]" VertexIndexes = " 6; 2; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <HideContaining Vector = "Vx;Vy;Vz" />

        <Macro Name = "Split" >
            <Turn Axis = "ax" Layers = "0;2" Angle = "sAngle" />
            <SplitByAxes />
            <Undo/>
            <Script> Inc(ax); </Script>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "0" Repeat = "5" />

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
