<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dogic Master</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Dogic Master</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-10-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5809</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := (Rsin + R) / 2;
        D2 := (5 * Rsin + R) / 6;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D2; D1" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" />

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
    </Figure>

   <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
