<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dogic Carousel (20 colors)</Name>
        <Menu>Other forms\Icosahedron\Vertex turning\Dogic Carousel (20 colors)</Menu>
        <Inventor>Calvin Fan, Evgeniy Grigoriev</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-09-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9133</Link>
    </Interface>

    <Script>
        Color[ 0] := 'ADFF2F'; // GreenYellow
        Color[ 1] := 'F0F0F0'; // White
        Color[ 2] := '8b0a50'; // DeepPink
        Color[ 3] := 'A0A0A0'; // Silver
        Color[ 4] := '202020'; // Black
        Color[ 5] := '00FFFF'; // Cyan
        Color[ 6] := '00BFFF'; // DeepSky
        Color[ 7] := '008080'; // Teal
        Color[ 8] := '0000FF'; // Blue
        Color[ 9] := '000080'; // Navy
        Color[10] := 'FF7F50'; // Coral
        Color[11] := 'FF0000'; // Red
        Color[12] := 'DC143C'; // Crimson
        Color[13] := 'CD5C5C'; // Indian
        Color[14] := '800000'; // Brown
        Color[15] := 'FFFF00'; // Yellow
        Color[16] := 'FF6000'; // Orange
        Color[17] := 'F0E68C'; // Khaki
        Color[18] := 'DDBB20'; // Golden
        Color[19] := '808000'; // Olive

        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := Rsin;
        D2 := (Rsin + R) / 2;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D1; D2" FixedLayers = "0" NormVectors = "Vx; Vy; Vz" TurnAxesWithPartNo = "8" />

    <Figure>
        <Macro Name = "AddPair">
            <Face Color = "Color[c1]" VertexIndexes = " v1; v4; v3" InvisibleEdges = "2" />
            <Face Color = "Color[c2]" VertexIndexes = " v2; v3; v4" InvisibleEdges = "2" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <ExecMacro MacroName = "AddPair" c1 = " 0" c2 = " 1" v1 = " 3" v2 = " 2" v3 = " 0" v4 = "18" />
                <ExecMacro MacroName = "AddPair" c1 = " 1" c2 = " 2" v1 = " 2" v2 = " 1" v3 = " 0" v4 = "17" />
                <ExecMacro MacroName = "AddPair" c1 = " 2" c2 = " 3" v1 = " 1" v2 = " 5" v3 = " 0" v4 = "21" />
                <ExecMacro MacroName = "AddPair" c1 = " 3" c2 = " 4" v1 = " 5" v2 = " 4" v3 = " 0" v4 = "20" />
                <ExecMacro MacroName = "AddPair" c1 = " 4" c2 = " 0" v1 = " 4" v2 = " 3" v3 = " 0" v4 = "19" />
                <ExecMacro MacroName = "AddPair" c1 = " 5" c2 = " 6" v1 = " 1" v2 = " 5" v3 = "21" v4 = "10" />
                <ExecMacro MacroName = "AddPair" c1 = " 7" c2 = " 8" v1 = " 2" v2 = " 1" v3 = "17" v4 = " 6" />
                <ExecMacro MacroName = "AddPair" c1 = " 9" c2 = "10" v1 = " 3" v2 = " 2" v3 = "18" v4 = " 7" />
                <ExecMacro MacroName = "AddPair" c1 = "11" c2 = "12" v1 = " 4" v2 = " 3" v3 = "19" v4 = " 8" />
                <ExecMacro MacroName = "AddPair" c1 = "13" c2 = "14" v1 = " 5" v2 = " 4" v3 = "20" v4 = " 9" />
                <ExecMacro MacroName = "AddPair" c1 = "15" c2 = "16" v1 = " 7" v2 = " 8" v3 = "11" v4 = "33" />
                <ExecMacro MacroName = "AddPair" c1 = "16" c2 = "17" v1 = " 8" v2 = " 9" v3 = "11" v4 = "34" />
                <ExecMacro MacroName = "AddPair" c1 = "17" c2 = "18" v1 = " 9" v2 = "10" v3 = "11" v4 = "35" />
                <ExecMacro MacroName = "AddPair" c1 = "18" c2 = "19" v1 = "10" v2 = " 6" v3 = "11" v4 = "36" />
                <ExecMacro MacroName = "AddPair" c1 = "19" c2 = "15" v1 = " 6" v2 = " 7" v3 = "11" v4 = "32" />
                <ExecMacro MacroName = "AddPair" c1 = " 9" c2 = "12" v1 = " 7" v2 = " 8" v3 = "33" v4 = " 3" />
                <ExecMacro MacroName = "AddPair" c1 = "11" c2 = "14" v1 = " 8" v2 = " 9" v3 = "34" v4 = " 4" />
                <ExecMacro MacroName = "AddPair" c1 = "13" c2 = " 6" v1 = " 9" v2 = "10" v3 = "35" v4 = " 5" />
                <ExecMacro MacroName = "AddPair" c1 = " 5" c2 = " 8" v1 = "10" v2 = " 6" v3 = "36" v4 = " 1" />
