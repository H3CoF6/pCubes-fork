<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ivy Icosaeder</Name>
        <Menu>Other forms\Icosahedron\Ivy Icosaeder</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11474</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Icosahedron_20_Colors.inc';

        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D := R * sqrt(3 + 6 / sqrt(5)) / 9;
    </Script>

    <Axes TurningAngles = "2*Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = "Cx[ 1]; Cy[ 1]; Cz[ 1]" />
        <Axis NormVector = "Cx[ 8]; Cy[ 8]; Cz[ 8]" />
        <Axis NormVector = "Cx[14]; Cy[14]; Cz[14]" />
        <Axis NormVector = "Cx[17]; Cy[17]; Cz[17]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
