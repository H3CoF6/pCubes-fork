<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Icosahedron 10x10x10</Name>
        <Menu>Other forms\Icosahedron\Icosahedron 10x10x10</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=115</Link>
     </Interface>

    <Script>
        R := 0.7;
        D := R * 0.085;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D*4;-D*3;-D*2;-D; 0; D; D*2; D*3; D*4" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\IcosahedronSq.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "0" From = "9" />
        <Split Axis = "1" From = "9" />
        <Split Axis = "2" From = "9" />
        <RemoveContaining Vector = "0; 0; 0" />

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
