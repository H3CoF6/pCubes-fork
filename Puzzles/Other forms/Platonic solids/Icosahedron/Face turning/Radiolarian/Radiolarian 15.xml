<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Radiolarian 15 (Radio Chop)</Name>
        <Menu>Other forms\Icosahedron\Face turning\Radiolarian\Radiolarian 15 (Radio Chop)</Menu>
        <Inventor>Jason Smith</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-04-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4490</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D := 0.44;
        jumAngle := Arcsin(1/4) + Pi/6;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" JumbleAngle = "jumAngle" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
        <Axis NormVector = "Cx[6]; Cy[6]; Cz[6]" />
        <Axis NormVector = "Cx[7]; Cy[7]; Cz[7]" />
        <Axis NormVector = "Cx[8]; Cy[8]; Cz[8]" />
        <Axis NormVector = "Cx[9]; Cy[9]; Cz[9]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
