<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Eitan's Star (12 colors)</Name>
        <Menu>Other forms\Icosahedron\Face Turning\Radiolarian\Eitan's Star (12 colors)</Menu>
        <Inventor>Eitan Cher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-02</Added>
        <Link>https://www.hknowstore.com/item.aspx?locale=ko-KR&amp;itemid=51bd4e48-d3c6-4568-9938-61d9aef47803</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFF00'; // clYellow
        Colors[ 1] := '0000A0'; // clBlue        
        Colors[ 2] := '2828FF'; // clLightBlue   
        Colors[ 3] := '00FF00'; // clLightGreen  
        Colors[ 4] := '008000'; // clGreen       
        Colors[ 5] := 'FF0000'; // clRed         
        Colors[ 6] := 'FF0080'; // clLightViolett
        Colors[ 7] := '800080'; // clViolett     
        Colors[ 8] := '800000'; // clBrown       
        Colors[ 9] := '00DCB4'; // clCyan        
        Colors[10] := 'FFFFFF'; // clWhite
        Colors[11] := '303030'; // clBlack

        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D := R * sqrt((1 + 1 / sqrt(5)) / 6);
        jumAngle := Arcsin(1/4) + Pi/6;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" JumbleAngle = "jumAngle" PlaneDistances = "D" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <Macro Name = "AddV" >
            <Face Color = "Color" VertexIndexes = "IntToStr(v) + '';'' + IntToStr(e1) + '';'' + IntToStr(c0) + '';'' + IntToStr(e0)" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "IntToStr(v) + '';'' + IntToStr(e2) + '';'' + IntToStr(c1) + '';'' + IntToStr(e1)" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "IntToStr(v) + '';'' + IntToStr(e3) + '';'' + IntToStr(c2) + '';'' + IntToStr(e2)" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "IntToStr(v) + '';'' + IntToStr(e4) + '';'' + IntToStr(c3) + '';'' + IntToStr(e3)" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "IntToStr(v) + '';'' + IntToStr(e0) + '';'' + IntToStr(c4) + '';'' + IntToStr(e4)" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <ExecMacro MacroName = "AddV" Color = "Colors[ 0]" v = " 3" e0 = "34" c0 = "14"  e1 = "38" c1 = "19" e2 = "49" c2 = "27" e3 = "44" c3 = "20" e4 = "39" c4 = "15" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 1]" v = " 2" e0 = "33" c0 = "13"  e1 = "37" c1 = "18" e2 = "48" c2 = "31" e3 = "43" c3 = "19" e4 = "38" c4 = "14" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 2]" v = " 0" e0 = "36" c0 = "12"  e1 = "32" c1 = "13" e2 = "33" c2 = "14" e3 = "34" c3 = "15" e4 = "35" c4 = "16" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 3]" v = " 4" e0 = "35" c0 = "15"  e1 = "39" c1 = "20" e2 = "50" c2 = "28" e3 = "45" c3 = "21" e4 = "40" c4 = "16" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 4]" v = " 8" e0 = "50" c0 = "20"  e1 = "44" c1 = "27" e2 = "53" c2 = "22" e3 = "59" c3 = "23" e4 = "54" c4 = "28" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 5]" v = " 7" e0 = "49" c0 = "19"  e1 = "43" c1 = "31" e2 = "52" c2 = "26" e3 = "58" c3 = "22" e4 = "53" c4 = "27" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 6]" v = "10" e0 = "47" c0 = "17"  e1 = "46" c1 = "29" e2 = "55" c2 = "24" e3 = "61" c3 = "25" e4 = "56" c4 = "30" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 7]" v = " 5" e0 = "41" c0 = "12"  e1 = "36" c1 = "16" e2 = "40" c2 = "21" e3 = "51" c3 = "29" e4 = "46" c4 = "17" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 8]" v = " 1" e0 = "32" c0 = "12"  e1 = "41" c1 = "17" e2 = "47" c2 = "30" e3 = "42" c3 = "18" e4 = "37" c4 = "13" />
                <ExecMacro MacroName = "AddV" Color = "Colors[ 9]" v = " 6" e0 = "48" c0 = "18"  e1 = "42" c1 = "30" e2 = "56" c2 = "25" e3 = "57" c3 = "26" e4 = "52" c4 = "31" />
                <ExecMacro MacroName = "AddV" Color = "Colors[10]" v = "11" e0 = "59" c0 = "22"  e1 = "58" c1 = "26" e2 = "57" c2 = "25" e3 = "61" c3 = "24" e4 = "60" c4 = "23" />
                <ExecMacro MacroName = "AddV" Color = "Colors[11]" v = " 9" e0 = "51" c0 = "21"  e1 = "45" c1 = "28" e2 = "54" c2 = "23" e3 = "60" c3 = "24" e4 = "55" c4 = "29" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

    <Macros>
        <Macro Name = "RandomTurns120" >
            <Turn Axis = "Random(20)" Layer = "Random(2) + 1" Angle = "2*Pi/3"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(20)" Layer = "Random(2) + 1" Angle = "Pi/12 * Random(24)"/>
        </Macro>
        <Macro Name = "Scramble120" Public = "1" >
            <ExecMacro MacroName = "RandomTurns120" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble120" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
