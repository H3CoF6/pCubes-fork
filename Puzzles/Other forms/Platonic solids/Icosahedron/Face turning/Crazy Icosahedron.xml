<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Icosahedron</Name>
        <Menu>Other forms\Icosahedron\Face turning\Crazy Icosahedron</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6350</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D1 := R * 0.63;
        D2 := RIn;

        jumAngle := Arcsin(1/4) + Pi/6;

        RC := R * 0.25;
        L := 1.001;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3; 0" JumbleAngle = "jumAngle" PlaneDistances = "D1; D2" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>

        <RemoveContaining Vector = "0; 0; 0" />

        <Macro Name = "RemoveCenter" >
            <RemoveContaining Vector = "Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenter" Repeat = "20" i = "0" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "RC" Color = "Colors[i]" > <Center X = "Cx[i] * L" Y =  "Cy[i] * L" Z =  "Cz[i] * L" /> </Circle>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" Repeat = "20" i = "0" />
        <SplitByAxes/>

    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />

    <Macros>
        <Macro Name = "RandomTurns120" >
            <Turn Axis = "Random(20)" Layer = "1" Angle = "2*Pi/3"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(20)" Layer = "1" Angle = "Pi/12 * Random(24)"/>
        </Macro>
        <Macro Name = "Scramble120" Public = "1" >
            <ExecMacro MacroName = "RandomTurns120" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "Scramble120" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
