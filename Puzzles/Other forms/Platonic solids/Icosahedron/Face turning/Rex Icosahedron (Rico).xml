<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rex Icosahedron (Rico)</Name>
        <Menu>Other forms\Icosahedron\Face turning\Rex Icosahedron (Rico)</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6362</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D := R * sqrt((5 + 2 * sqrt(5)) / 15) / 3;
    </Script>

    <Axes TurningAngles = "Pi*2/3; 0; Pi*2/3" PlaneDistances = "-D; D">
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[7]; Cy[7]; Cz[7]" />
        <Axis NormVector = "Cx[8]; Cy[8]; Cz[8]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
