<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

<!-- Jumbling was turned off, that's need to do with moving axes  --> 

    <Interface>
        <Name>Radiomate (w/o jumbling)</Name>
        <Menu>Other forms\Icosahedron\Mixed\Radiomate (w/o jumbling)</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-08-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11043</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=368195</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D := R * sqrt((5 + 2 * sqrt(5)) * 3) / 9;

<!--        jumAngle := Arcsin(1/4) + Pi/6;-->
    </Script>

    <Axes TurningAngles = "0; 2*Pi / 3" PlaneDistances = "D" NormVectors = " Cx; Cy; Cz" />  <!-- JumbleAngle = "jumAngle" -->

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = " Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = " Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = " Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = " Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = " Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = " Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
