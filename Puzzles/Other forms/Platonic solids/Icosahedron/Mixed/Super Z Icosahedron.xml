<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Z Icosahedron</Name>
        <Menu>Other forms\Icosahedron\Mixed\Super Z Icosahedron</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2023-10-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10810</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Icosahedron_20_Colors.inc';

        R := 0.7;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = " 2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\IcosahedronSq.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
