<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover Cube Extreme</Name>
        <Menu>Other forms\Sphere\Clover Cube Extreme</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-06</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=401981</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF6600'; // clOrange
        Colors[2] := '0066FF'; // clBlue
        Colors[3] := '00DD00'; // clGreen
        Colors[4] := 'FFEE00'; // clYellow
        Colors[5] := 'AA00AA'; // clViolett

        K := 0.6;
        D1 := K * 0.88;
        D2 := K * 0.88;
        D3 := K * 0.93;

        include 'Figures\Scripts\Cube_Coordinates.inc';
        fE := K / sqrt(2);
        fV := K /  sqrt(3);
        DCutE := K * 0.65;
        DCutV := K * 0.54;
    </Script>


    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D3;-D2; D2;D3" FixedLayers = "2" >
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>



        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
