<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Four leaf clover ball</Name>
        <Menu>Other forms\Sphere\Four leaf clover ball</Menu>
        <Inventor>Zhanqiang Li</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6010</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow

        K := 0.6;

        D := K * 0.56;

        W := K * 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "HideCorner" >
            <HideContaining Vector = "Vx[v]; Vy[v]; Vz[v]" />
        </Macro>

        <Macro Name = "HideEdge" >
            <HideContaining Vector = "Ex[e]; Ey[e]; Ez[e]" />
        </Macro>

        <Macro Name = "AddSphere" >
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "Colors[color]" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "AddSphere" color = "2" /> // blue
        <ExecMacro MacroName = "HideCorner" v = "1" />
        <ExecMacro MacroName = "HideCorner" v = "3" />
        <ExecMacro MacroName = "HideCorner" v = "5" />
        <ExecMacro MacroName = "HideCorner" v = "7" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" color = "1" /> // orange
        <ExecMacro MacroName = "HideCorner" v = "0" />
        <ExecMacro MacroName = "HideCorner" v = "2" />
        <ExecMacro MacroName = "HideCorner" v = "4" />
        <ExecMacro MacroName = "HideCorner" v = "6" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" color = "0" /> // red
        <ExecMacro MacroName = "HideEdge" e = "0" />
        <ExecMacro MacroName = "HideEdge" e = "1" />
        <ExecMacro MacroName = "HideEdge" e = "2" />
        <ExecMacro MacroName = "HideEdge" e = "3" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" color = "4" /> // yellow
        <ExecMacro MacroName = "HideEdge" e = "4" />
        <ExecMacro MacroName = "HideEdge" e = "5" />
        <ExecMacro MacroName = "HideEdge" e = "10" />
        <ExecMacro MacroName = "HideEdge" e = "11" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" color = "3" /> // green
        <ExecMacro MacroName = "HideEdge" e = "6" />
        <ExecMacro MacroName = "HideEdge" e = "7" />
        <ExecMacro MacroName = "HideEdge" e = "8" />
        <ExecMacro MacroName = "HideEdge" e = "9" />
        <RemoveAllVisible/>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
