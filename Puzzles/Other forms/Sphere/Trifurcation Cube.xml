<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trifurcation Cube (Sphere)</Name>
        <Menu>Other forms\Sphere\Trifuraction Cube</Menu>
        <Inventor>VeryPuzzle</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-08-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5705</Link>
    </Interface>

    <Script>
        K  := 0.6;
        C0 := sqrt(2) - 1;

        D  := K * 0.9;

        A1 := ArcCos((-1 + 2 * sqrt(2)) / 4 );
        A2 := ArcCos((-2 -     sqrt(2)) / 4 ); // A2 := Pi - A1/2;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "  1; C0;  1" />
        <Axis NormVector = "  1; C0; -1" />
        <Axis NormVector = "  1;-C0;  1" />
        <Axis NormVector = "  1;-C0; -1" />
        <Axis NormVector = "  1;  1; C0" />
        <Axis NormVector = "  1;  1;-C0" />
        <Axis NormVector = "  1; -1; C0" />
        <Axis NormVector = "  1; -1;-C0" />
        <Axis NormVector = " C0;  1;  1" />
        <Axis NormVector = " C0;  1; -1" />
        <Axis NormVector = " C0; -1;  1" />
        <Axis NormVector = " C0; -1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
