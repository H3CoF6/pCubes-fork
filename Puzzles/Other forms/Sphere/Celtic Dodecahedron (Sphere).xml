<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Celtic Dodecahedron (Sphere)</Name>
        <Menu>Other forms\Sphere\Celtic Dodecahedron (Sphere)</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-10-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8016</Link>
    </Interface>

    <Script>
        Colors[ 0] := '00BBFF'; // clBlue1
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := 'FF6000'; // clOrange
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '0000EE'; // clBlue3
        Colors[ 5] := 'DD0055'; // clRed2
        Colors[ 6] := '0088FF'; // clBlue2
        Colors[ 7] := 'FF55BB'; // clPink
        Colors[ 8] := '8800DD'; // clViolett
        Colors[ 9] := '00FF00'; // clGreen1
        Colors[10] := '007700'; // clGreen3
        Colors[11] := '00AA00'; // clGreen2

        K := 0.7;

        s5 := sqrt(5);
        pA1 := 3 - s5;
        pA2 := s5 + 1;
        pB1 := s5 - 1;
        pB2 := 2;
        pB3 := 2 * s5 - 2;
        pC  := 5 - s5;

        A1 := ArcCos(( 5 + 2 * sqrt(5)) / 20);
        A2 := ArcCos((-5 + 2 * sqrt(5)) / 10);
        A3 := ArcCos(( 5 - 9 * sqrt(5)) / 40);
        A4 := ArcCos((-5 -     sqrt(5)) /  8);

        D := K * 0.938; // chosen to prevent overhang bandaging
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A4;-A3;-A2;-A1; 0; A1; A2; A3; A4" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " pA1;-pA1; pA2" />
        <Axis NormVector = " pA1; pA1; pA2" />
        <Axis NormVector = " pB2;-pB1; pB3" />
        <Axis NormVector = " pB2; pB1; pB3" />
        <Axis NormVector = " pC ;   0; pB2" />
        <Axis NormVector = "-pA1;-pA1; pA2" />
        <Axis NormVector = "-pA1; pA1; pA2" />
        <Axis NormVector = "-pB2;-pB1; pB3" />
        <Axis NormVector = "-pB2; pB1; pB3" />
        <Axis NormVector = "-pC ;   0; pB2" />
        <Axis NormVector = "   0;-pB2; pC " />
        <Axis NormVector = " pB1;-pB3; pB2" />
        <Axis NormVector = "-pB1;-pB3; pB2" />
        <Axis NormVector = " pA1;-pA2; pA1" />
        <Axis NormVector = "-pA1;-pA2; pA1" />
        <Axis NormVector = "   0; pB2; pC " />
        <Axis NormVector = " pB1; pB3; pB2" />
        <Axis NormVector = "-pB1; pB3; pB2" />
        <Axis NormVector = " pA1; pA2; pA1" />
        <Axis NormVector = "-pA1; pA2; pA1" />
        <Axis NormVector = " pB2; pC ;   0" />
        <Axis NormVector = " pB3; pB2; pB1" />
        <Axis NormVector = " pB3; pB2;-pB1" />
        <Axis NormVector = " pA2; pA1; pA1" />
        <Axis NormVector = " pA2; pA1;-pA1" />
        <Axis NormVector = " pB2;-pC ;   0" />
        <Axis NormVector = " pB3;-pB2; pB1" />
        <Axis NormVector = " pB3;-pB2;-pB1" />
        <Axis NormVector = " pA2;-pA1; pA1" />
        <Axis NormVector = " pA2;-pA1;-pA1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />

        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />
        <InvertVisibility/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := '-1';
        </Script>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
