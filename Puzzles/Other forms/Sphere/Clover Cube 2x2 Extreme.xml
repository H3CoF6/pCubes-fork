<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover Cube 2x2 Extreme</Name>
        <Menu>Other forms\Sphere\Clover Cube 2x2 Extreme</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-06</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=401981</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF6600'; // clOrange
        Colors[2] := '0066FF'; // clBlue
        Colors[3] := '00DD00'; // clGreen
        Colors[4] := 'FFEE00'; // clYellow
        Colors[5] := 'AA00AA'; // clViolett

        K := 0.6;
        D1 := K * 0.88;
        D2 := K * 0.88;
        D3 := K * 0.93;

        fE := K / sqrt(2);
        fV := K /  sqrt(3);
        DCutE1 := K * 0.695;
        DCutE2 := K * 0.605;
        DCutV := K * 0.58;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0"  TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D3;-D2; D2; D3" FixedLayers = "2" >
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <Macro Name = "Split" >
        <Split><Plane NormVector = "-1; 0;-1" NormDistance = " x" /></Split>
        <Split><Plane NormVector = " 0;-1;-1" NormDistance = " x" /></Split>
        <Split><Plane NormVector = " 1; 0;-1" NormDistance = " x" /></Split>
        <Split><Plane NormVector = " 0; 1;-1" NormDistance = " x" /></Split>
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = " x" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = " x" /></Split>
        </Macro>
        <ExecMacro MacroName = "Split" x = "-D2" />
        <ExecMacro MacroName = "Split" x = " D2" />

        <Macro Name = "CutEdge" >
            <HideContaining Vector = "fE; 0; fE" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = " 1; 0;-2" NormDistance = "-DCutE" /> </Cut>
            <Cut> <Plane NormVector = "-2; 0; 1" NormDistance = "-DCutE" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutEdge" DCutE = "DCutE1" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <SplitByAxes/>
        <ExecMacro MacroName = "CutEdge" DCutE = "DCutE2" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

        <Macro Name = "CutVertex" >
            <HideContaining Vector = "fV; fV; fV" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = "-3; 1; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1;-3; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1; 1;-3" NormDistance = "-DCutV" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
