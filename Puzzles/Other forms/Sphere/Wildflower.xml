<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Wildflower (Sphere)</Name>
        <Menu>Other forms\Sphere\Wildflower</Menu>
        <Inventor>Diogo Sousa</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-27</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36086</Link>
        <Link>http://dmccooey.com/polyhedra/TetrakisCuboctahedron.html</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0000CC'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := '800080'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0066CC'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF88CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        K := 0.6;
        D  := K * 0.929;

        s := 3.355301397608119909925; // s^3 - 3 * x^2 - 4 = 0    s := 1 + (3 - 2 sqrt(2))^(1/3) + (3 + 2 sqrt(2))^(1/3)

        A1 := 2.31535958038656406;  //  2* a^3 - 3* a^2 + 2 = 0    a=-0.677650698804059954  cos(A1) = a
        A2 := 2 * Pi - 2 * A1;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " s; 1; 1" />
        <Axis NormVector = " s;-1; 1" />
        <Axis NormVector = " s; 1;-1" />
        <Axis NormVector = " s;-1;-1" />

        <Axis NormVector = " 1; s; 1" />
        <Axis NormVector = "-1; s; 1" />
        <Axis NormVector = " 1; s;-1" />
        <Axis NormVector = "-1; s;-1" />

        <Axis NormVector = " 1; 1; s" />
        <Axis NormVector = "-1; 1; s" />
        <Axis NormVector = " 1;-1; s" />
        <Axis NormVector = "-1;-1; s" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
