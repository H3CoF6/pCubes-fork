<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Masterball Duomaster</Name>
        <Menu>Other forms\Sphere\Masterball\Masterball Duomaster</Menu>
        <Inventor>Dr. Geza Gyovai</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=566</Link>
    </Interface>

    <Script>
        clBlack := '222222';
        clWhite := 'FFFFFF';

        K := 0.6;
        D := K * 0.55;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "Add4Sectors" >
            <HideAll/>
            <Turn NormVector = "0;0;1" Angle = "Angle" />
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <Turn NormVector = "0;0;1" Angle = "-Angle" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "2" From = "1" />
            <Split Axis = "3" From = "1" />
            <Split Axis = "4" From = "1" />
            <RemoveContaining Vector = " Dx;  Dy; 0" />
            <RemoveContaining Vector = "-Dx; -Dy; 0" />
            <RemoveContaining Vector = " Dy; -Dx; 0" />
            <RemoveContaining Vector = "-Dy;  Dx; 0" />
        </Macro>

        <Script>Color := clWhite; Angle := -Pi/8; Dx := 0.1; Dy := 0.2; </Script>
        <ExecMacro MacroName = "Add4Sectors" />

        <Script>Color := clBlack; Angle := Pi/8; Dx := 0.2; Dy := 0.1; </Script>
        <ExecMacro MacroName = "Add4Sectors" />

        <ShowAll/>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
