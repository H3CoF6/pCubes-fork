    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        clBlack := '202020';

        procedure CalcRail(x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, y4, z4);
        begin
          kn := 0.001;
          kd1 := 0.81;
          kd2 := 0.49;
          kw1 := 0.21;
          kw2 := 0.25;

          nx := (y1-y3) * (z2-z3) - (y2-y3) * (z1-z3);
          ny := (z1-z3) * (x2-x3) - (z2-z3) * (x1-x3);
          nz := (x1-x3) * (y2-y3) - (x2-x3) * (y1-y3);

          // normalize vector
          dn := sqrt(nx^2 + ny^2 + nz^2);
          nx := nx / dn*kn;
          ny := ny / dn*kn;
          nz := nz / dn*kn;

          cx := (x2 + x1 + x3 + x4) / 4;
          cy := (y2 + y1 + y3 + y4) / 4;
          cz := (z2 + z1 + z3 + z4) / 4;

          d1x := (x2 - x1) * kd1;
          d1y := (y2 - y1) * kd1;
          d1z := (z2 - z1) * kd1;

          d2x := (x2 - x1) * kd2;
          d2y := (y2 - y1) * kd2;
          d2z := (z2 - z1) * kd2;

          w1x := (x2 + x1 - x3 - x4) * kw1;
          w1y := (y2 + y1 - y3 - y4) * kw1;
          w1z := (z2 + z1 - z3 - z4) * kw1;

          w2x := (x2 + x1 - x3 - x4) * kw2;
          w2y := (y2 + y1 - y3 - y4) * kw2;
          w2z := (z2 + z1 - z3 - z4) * kw2;

          x1 := cx - w1x - d1x + nx; y1 := cy - w1y - d1y + ny; z1 := cz - w1z - d1z + nz;
          x2 := cx - w1x + d1x + nx; y2 := cy - w1y + d1y + ny; z2 := cz - w1z + d1z + nz;
          x3 := cx + w2x + d2x + nx; y3 := cy + w2y + d2y + ny; z3 := cz + w2z + d2z + nz;
          x4 := cx + w2x - d2x + nx; y4 := cy + w2y - d2y + ny; z4 := cz + w2z - d2z + nz;
        end;

        function GetInt(): integer;
        begin
          p := Pos(',', indexes);
          if p = 0 then begin
            substr := indexes;
            indexes := '';
          end else begin
            substr := copy(indexes, 1, p-1);
            Delete(indexes, 1, p);
          end;
          Result := StrToInt(Trim(substr));
        end;

        procedure SetColors(Color, indexes);
        begin
            while Length(indexes) > 0 do begin
                idx := GetInt;
                Colors [idx] := Color;
                Colors1[idx] := Color;
                Colors2[idx] := Color;
            end;
        end;

        for idx := 0 to 97 do begin
            Colors [idx] := clBlack;
            Colors1[idx] := clBlack;
            Colors2[idx] := clBlack;
        end;

        SetColors(clYellow, '68,69,71,47,96,46,97');
        SetColors(clGreen,  '32,11,35,33,10,90,91');
        SetColors(clBlue,   '39,25,41,38,26,77,78');
        SetColors(clRed,    ' 2, 3, 5,61,62,83,84');

        Colors1[06] := clRed;     Colors2[06] := clGreen;
        Colors1[13] := clGreen;   Colors2[13] := clRed;
        Colors1[19] := clGreen;   Colors2[19] := clBlue;
        Colors1[27] := clBlue;    Colors2[27] := clGreen;
        Colors1[42] := clBlue;    Colors2[42] := clYellow;
        Colors1[49] := clYellow;  Colors2[49] := clBlue;
        Colors1[55] := clYellow;  Colors2[55] := clRed;
        Colors1[63] := clRed;     Colors2[63] := clYellow;
        Colors1[73] := clRed;     Colors2[73] := clBlue;
        Colors1[79] := clBlue;    Colors2[79] := clRed;
        Colors1[86] := clYellow;  Colors2[86] := clGreen;
        Colors1[92] := clGreen;   Colors2[92] := clYellow;

        procedure SetColors12(Color, indexes);
        begin
            while Length(indexes) > 0 do begin
                idx := GetInt;
                Colors1[idx] := Color;
                Colors2[idx] := Color;
            end;
        end;

        SetColors12(clRed,    ' 1, 4,16,58,60,82');
        SetColors12(clYellow, '45,48,66,67,70,95');
        SetColors12(clGreen,  ' 9,12,30,31,34,89');
        SetColors12(clBlue,   '22,24,37,40,52,76');

        R   := 0.6;
        Rin := R * 0.8;
        D   := R * 0.17;
        D2  := D * sqrt(2);

        x[0] := 0;
        y[0] := -sqrt(R^2 - D2^2);
        z[0] := D2;

        x[1] := 0;
        y[1] := -sqrt(Rin^2 - D2^2);
        z[1] := D2;

        z[2] := sqrt((R^2 - 4 * D^2) / 3);
        x[2] := z[2] - D2;
        y[2] :=-z[2] - D2;

        z[3] := sqrt((Rin^2 - 4 * D^2) / 3);
        x[3] := z[3] - D2;
        y[3] :=-z[3] - D2;

        y[4] := (-2 * D2 - sqrt(-2 * D2^2 + 3 * R^2)) / 3;
        x[4] := -y[4] - D2;
        z[4] := -y[4] - D2;

        y[5] := (-2 * D2 - sqrt(-2 * D2^2 + 3 * Rin^2)) / 3;
        x[5] := -y[5] - D2;
        z[5] := -y[5] - D2;

        y[6] := (-D2 - sqrt(-2 * D2^2 + 3 * R^2)) / 3;
        x[6] := -y[6] - D2;
        z[6] := -y[6];

        y[7] := (-D2 - sqrt(-2 * D2^2 + 3 * Rin^2)) / 3;
        x[7] := -y[7] - D2;
        z[7] := -y[7];

        x[8] :=  0;
        y[8] := -R;
        z[8] :=  0;

        x[9] :=  R / sqrt(3);
        y[9] := -R / sqrt(3);
        z[9] :=  R / sqrt(3);

        x[10] :=  0;
        y[10] := -R / sqrt(2);
        z[10] :=  R / sqrt(2);

        x[11] := 0;
        y[11] := (y[2] - y[3]) * 1.26 + y[3];
        z[11] := (z[2] - z[3]) * 1.26 + z[3];

        x[12] := (x[0] + z[2]) / 2 * 1.045;
        y[12] := (y[0] + y[2]) / 2 * 1.045;
        z[12] := (z[0] + x[2]) / 2 * 1.045;

        x[13] := ((x[0] + x[2]) / 2 - (x[1] + x[3]) / 2) * 1.15 + (x[1] + x[3]) / 2;
        y[13] := ((y[0] + y[2]) / 2 - (y[1] + y[3]) / 2) * 1.15 + (y[1] + y[3]) / 2;
        z[13] := ((z[0] + z[2]) / 2 - (z[1] + z[3]) / 2) * 1.15 + (z[1] + z[3]) / 2;
    </Script>

