        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'AA00AA'; // Violett

        K := 0.6;

        D := K * 0.606;
        fE := K / sqrt(2);
        DCutE1 := K * 0.505;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />

        <Split><Plane NormVector = " 0; 1; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0;-1; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = "-1; 0; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 0; 1; 1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 0;-1; 1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "-1; 0; 1" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = "-D" /></Split>
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = "-D" /></Split>
        <Macro Name = "CutEdge" >
            <HideContaining Vector = "fE; 0; fE" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = " 1; 0;-2" NormDistance = "-DCutE" /> </Cut>
            <Cut> <Plane NormVector = "-2; 0; 1" NormDistance = "-DCutE" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutEdge" DCutE = "DCutE1" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <SplitByAxes/>

        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
