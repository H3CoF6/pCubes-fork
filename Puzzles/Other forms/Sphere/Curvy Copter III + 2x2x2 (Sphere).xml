<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Copter III + 2x2x2 (Sphere)</Name>
        <Menu>Other forms\Sphere\Curvy Copter III + 2x2x2 (Sphere)</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
