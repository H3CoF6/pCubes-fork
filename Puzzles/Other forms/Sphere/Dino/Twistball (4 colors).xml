<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Twistball (4 colors)</Name>
        <Menu>Other forms\Sphere\Dino\Twistball (4 colors)</Menu>
        <Inventor>Josip Matijek</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3937</Link>
    </Interface>

    <Script>
        Color1 := 'FF0000'; // Red
        Color2 := 'FFFF00'; // Yellow
        Color3 := '00CC00'; // Green
        Color4 := '0055EE'; // Blue

        K := 0.6;
        D := K * 0.585;
        DCut := K * 0.5;
        sAngle := 2*Pi / 3;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "1; 1; 1" />
        <Axis NormVector = "1; 1;-1" />
        <Axis NormVector = "1;-1; 1" />
        <Axis NormVector = "1;-1;-1" />
    </Axes>

    <Figure>
        <Macro Name = "AddSphere">
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "AddSphere" Color = "Color1" />
        <Hide Axis = "0" Layer = "2" />
        <HideContaining Vector = "-DCut; DCut; DCut" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" Color = "Color2" />
        <Hide Axis = "3" Layer = "2" />
        <HideContaining Vector = "-DCut;-DCut;-DCut" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" Color = "Color3" />
        <Hide Axis = "1" Layer = "0" />
        <HideContaining Vector = " DCut;-DCut; DCut" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "AddSphere" Color = "Color4" />
        <Hide Axis = "2" Layer = "0" />
        <HideContaining Vector = " DCut; DCut;-DCut" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>

        <Turn Axis = "2" Layer = "2" Angle = " sAngle" />
        <Turn Axis = "1" Layer = "0" Angle = " sAngle" />
        <Turn Axis = "2" Layer = "2" Angle = " sAngle" />
        <Turn Axis = "1" Layer = "0" Angle = " sAngle" />
        <Turn Axis = "1" Layer = "2" Angle = "-sAngle" />
        <Turn Axis = "2" Layer = "0" Angle = "-sAngle" />
        <Turn Axis = "1" Layer = "2" Angle = "-sAngle" />
        <Turn Axis = "2" Layer = "0" Angle = "-sAngle" />

        <SaveSolvedState/>

        <Undo Repeat = "8" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
