<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Twistball (5 colors)</Name>
        <Menu>Other forms\Sphere\Dino\Twistball (5 colors)</Menu>
        <Inventor>Josip Matijek</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3937</Link>
    </Interface>

    <Script>
        Color1 := 'FF0000'; // Red
        Color2 := '222222'; // Black
        Color3 := 'FFFF00'; // Yellow
        Color4 := '0055EE'; // Blue
        clBody := 'FFFFFF'; // White

        K := 0.6;
        D := K * 0.585;
        DCut := K * 0.5;
        sAngle := 2*Pi / 3;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "1; 1; 1" />
        <Axis NormVector = "1; 1;-1" />
        <Axis NormVector = "1;-1; 1" />
        <Axis NormVector = "1;-1;-1" />
    </Axes>

    <Figure>
        <Macro Name = "AddSphere">
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSphere" Color = "Color1" />
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddSphere" Color = "Color2" />
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = " D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddSphere" Color = "Color3" />
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = " D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddSphere" Color = "Color4" />
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = " D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddSphere" Color = "clBody" />
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-D" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-D" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 1" NormDistance = "-D" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1;-1" NormDistance = "-D" /> </Cut>

        <ShowAll/>
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
