<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dioctipoid 2</Name>
        <Menu>Other forms\Sphere\Dino\Dioctipoid 2</Menu>
        <Inventor>Gary Spencer-Purvis</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-10-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2098</Link>
    </Interface>

    <Script>
        K := 0.6;
        W := K * 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := K * 0.333526099730881 // C15/K/sqrt(3)
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />

        <SplitByAxes/>

        <Macro Name = "RemoveEdges" >
            <RemoveContaining Vector = "Ex[Id]; Ey[Id]; Ez[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <Macro Name = "HideEdges" >
            <HideContaining Vector = "Ex[Id]; Ey[Id]; Ez[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>

        <Macro Name = "ReplaceEdge" >
            <ExecMacro MacroName = "RemoveEdges" Id = "Id1" />
            <ExecMacro MacroName = "RemoveEdges" Id = "Id2" />
            <HideAll/>

            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <SplitByAxes/>

            <ExecMacro MacroName = "HideEdges" Id = "Id1" />
            <ExecMacro MacroName = "HideEdges" Id = "Id2" />
            <RemoveAllVisible/>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 4" Id2 = "11" Color = "clBlue"   />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 5" Id2 = "10" Color = "clGreen"  />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 3" Id2 = " 8" Color = "clOrange" />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 2" Id2 = " 9" Color = "clRed"    />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 0" Id2 = " 1" Color = "clWhite"  />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 6" Id2 = " 7" Color = "clYellow" />

        <SaveSolvedState/>

        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 0" Id2 = " 7" Color = "clBlue"   />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 1" Id2 = " 6" Color = "clGreen"  />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 2" Id2 = " 3" Color = "clWhite"  />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 4" Id2 = " 5" Color = "clOrange" />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = " 8" Id2 = " 9" Color = "clYellow" />
        <ExecMacro MacroName = "ReplaceEdge" Id1 = "10" Id2 = "11" Color = "clRed"    />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
