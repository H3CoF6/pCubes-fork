        <Script>Color := 'FFFFCF'; </Script>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "Ex; Ey; Ez" />
        <ExecMacro MacroName = "HideEdges" Id = "0" Repeat = "12" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
