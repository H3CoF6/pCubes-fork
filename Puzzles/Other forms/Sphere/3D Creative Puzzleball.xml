<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3D Creative Puzzleball</Name>
        <Menu>Other forms\Sphere\3D Creative Puzzleball</Menu>
        <Menu>Other forms\Skewb variants\3D Creative Puzzleball</Menu>
        <Inventor>Uwe Mèffert</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=527</Link>
    </Interface>

    <Script>
        Color     := 'FFFFFF'; // White
        Colors[0] := 'EE0000'; // clRed
        Colors[1] := 'FFDD00'; // clYellow
        Colors[2] := '000099'; // clBlue
        Colors[3] := '009900'; // clGreen

        K := 0.6;

        D1 := K * 0.8;
        D2 := K * 0.9;
        RC := K * 0.61;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />

        <Macro Name = "MakeEdge">
            <Split> <Plane NormVector = " 1;0;0" NormDistance = "D1" /> </Split>
            <Split> <Plane NormVector = " 1;0;0" NormDistance = "D2" /> </Split>
            <RemoveContaining Vector = "(D1 + D2) / 2; 0; 0" />
            <Cylinder Radius = "RC" Color = "cl" Base = "D1; 0; 0" Top = "D2; 0; 0" >
                <Top Color = "cl" />
            </Cylinder>
            <Turn NormVector = " 0; 0; 1" Angle = "Pi / 2" />
        </Macro>

        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 4" />
        <ExecMacro MacroName = "MakeEdge" cl = "Colors[0]" />
        <ExecMacro MacroName = "MakeEdge" cl = "Colors[1]" />
        <ExecMacro MacroName = "MakeEdge" cl = "Colors[2]" />
        <ExecMacro MacroName = "MakeEdge" cl = "Colors[3]" />
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi / 4" />

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
