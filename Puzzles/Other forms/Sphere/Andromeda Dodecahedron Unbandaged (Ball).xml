            <ExecMacro MacroName = "TurnAndSplit" ax1 = "1+i" ax2 = "0+i" />
            <Script>i := i + 5 ; </Script>
        </Macro>
        <ExecMacro MacroName = "Unbandage" i = "0" Repeat = "12" />

