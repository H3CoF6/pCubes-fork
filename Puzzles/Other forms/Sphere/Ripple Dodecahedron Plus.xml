<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ripple Dodecahedron Plus (Sphere)</Name>
        <Menu>Other forms\Sphere\Ripple Dodecahedron Plus</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);
        sAngle := 2*Pi/3;

        K := 0.6;

        C21 := K * 0.3569761362781;
        C38 := K * 0.5775995216706;
        C63 := K * 0.9345756579487;

        D1 := (C21 + C63) / sqrt(3);
        D2 := (C38 * 2 * sqrt(3) + D1) / 3;
    </Script>

    <Axes TurningAngles = "sAngle; sAngle; 0; sAngle; sAngle" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = " cs; 2 * cs + ss; 0" />
        <Axis NormVector = "-cs; 2 * cs + ss; 0" />

        <Axis NormVector = "2 * cs + ss; 0;-cs" />
        <Axis NormVector = "2 * cs + ss; 0; cs" />

        <Axis NormVector = "0; cs; 2 * cs + ss" />
        <Axis NormVector = "0;-cs; 2 * cs + ss" />

        <Axis NormVector = "1; 1; 1" />
        <Axis NormVector = "1; 1;-1" />
        <Axis NormVector = "1;-1; 1" />
        <Axis NormVector = "1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
