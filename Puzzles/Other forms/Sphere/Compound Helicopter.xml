<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Compound Helicopter</Name>
        <Menu>Other forms\Sphere\Compound Helicopter</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-02-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7717</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0033EE'; // Blue
        Colors[3] := '00BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        K := 0.65;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D1 := K * 0.82;
        D2 := K * 0.86853;
        Dsplit := -K * 0.9;

        JumbleAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumbleAngle" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumbleAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "0;0;0" />
        <InvertVisibility/>

        <Macro Name = "extrasplit" >
            <Split> <Plane NormVector = "Cx[i];Cy[i];Cz[i]" NormDistance = "Dsplit" /> </Split>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "extrasplit" i = "0" Repeat = "6" />

        <RemoveContaining Vector = "0;0;0" />
        <ShowAll/>

        <Macro Name = "split">
            <Turn Axis = "ax1" Layer = "l1" Angle = "pi" />
            <Turn Axis = "ax2" Layer = "l2" Angle = "pi" />
            <SplitByAxes />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "split" ax1 = "0" ax2 = "0" l1 = "0" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "1" ax2 = "1" l1 = "0" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "2" ax2 = "2" l1 = "0" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "3" ax2 = "3" l1 = "0" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "0" ax2 = "1" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "0" ax2 = "3" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "0" ax2 = "1" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "0" ax2 = "3" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "1" ax2 = "0" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "3" ax2 = "0" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "1" ax2 = "0" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "3" ax2 = "0" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "1" ax2 = "2" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "3" ax2 = "2" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "1" ax2 = "2" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "3" ax2 = "2" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "2" ax2 = "1" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "2" ax2 = "3" l1 = "2" l2 = "2" />
        <ExecMacro MacroName = "split" ax1 = "2" ax2 = "1" l1 = "0" l2 = "0" />
        <ExecMacro MacroName = "split" ax1 = "2" ax2 = "3" l1 = "0" l2 = "0" />

        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = '-1' />
        <SplitByAxes/>

        <ExecMacro MacroName = "extrasplit" i = "0" Repeat = "6" />
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
