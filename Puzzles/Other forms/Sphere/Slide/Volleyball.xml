<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Volleyball</Name>
        <Menu>Other forms\Sphere\Slide\Volleyball</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=563</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Coordinates.inc';

        clYellow := 'FFFF00';
        clBlue   := '0000A0';
        clRed    := 'FF0000';
        clGreen  := '008000';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';

        Colors[0] := clRed;
        Colors[1] := clOrange;
        Colors[2] := clBlue;
        Colors[3] := clGreen;
        Colors[4] := clYellow;
        Colors[5] := clWhite;

        K := 0.6;

        D := K * 0.25;
    </Script>

    <Axes TurningAngles = "0; Pi/6; 0" PlaneDistances = "-D;D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "RemoveEdges" >
            <RemoveContaining Vector = "Ex[Id]*L; Ey[Id]*L; Ez[Id]*L" />
            <Script> Inc(Id); </Script>
        </Macro>
        <Macro Name = "RemoveCenters" >
            <RemoveContaining Vector = "Cx[Id]*L; Cy[Id]*L; Cz[Id]*L" />
            <Script> Inc(Id); </Script>
        </Macro>
        <Macro Name = "AddPiece" >
            <Part>
                <Vertices>
                    <Add Vector = "  0   ; -0.603;  0   " />
                    <Add Vector = "  0   ; -0.591;  0.12" />
                    <Add Vector = "  0   ; -0.591; -0.12" />
                    <Add Vector = "  0.12; -0.591;  0   " />
                    <Add Vector = " -0.12; -0.591;  0   " />
                    <Add Vector = "  0.12; -0.579;  0.12" />
                    <Add Vector = "  0.12; -0.579; -0.12" />
                    <Add Vector = " -0.12; -0.579;  0.12" />
                    <Add Vector = " -0.12; -0.579; -0.12" />
                    <Add Vector = " -0.15; -0.570; -0.12" />
                    <Add Vector = " -0.15; -0.582;  0   " />
                    <Add Vector = " -0.15; -0.570;  0.12" />
                    <Add Vector = "  0.15; -0.582;  0   " />
                    <Add Vector = "  0.15; -0.570; -0.12" />
                    <Add Vector = "  0.15; -0.570;  0.12" />
                    <Add Vector = "  0.15; -0.561; -0.15" />
                    <Add Vector = " -0.15; -0.561; -0.15" />
                    <Add Vector = "  0   ; -0.582; -0.15" />
                    <Add Vector = " -0.12; -0.570; -0.15" />
                    <Add Vector = "  0.12; -0.570; -0.15" />
                    <Add Vector = "  0.15; -0.561;  0.15" />
                    <Add Vector = " -0.15; -0.561;  0.15" />
                    <Add Vector = " -0.12; -0.570;  0.15" />
                    <Add Vector = "  0   ; -0.582;  0.15" />
                    <Add Vector = "  0.12; -0.570;  0.15" />
                    <Add Vector = "  0   ; -0.3 1;  0   " />
                </Vertices>
                <Faces>
                    <Face Color = "Color" VertexIndexes = "24; 5;14;20" InvisibleEdges = " 3" />
                    <Face Color = "Color" VertexIndexes = "15;13; 6;19" InvisibleEdges = " 6" />
                    <Face Color = "Color" VertexIndexes = "21;11; 7;22" InvisibleEdges = " 6" />
                    <Face Color = "Color" VertexIndexes = "18; 8; 9;16" InvisibleEdges = " 3" />
                    <Face Color = "Color" VertexIndexes = " 0; 1; 7; 4" InvisibleEdges = "15" />
                    <Face Color = "Color" VertexIndexes = " 0; 4; 8; 2" InvisibleEdges = "15" />
                    <Face Color = "Color" VertexIndexes = " 0; 2; 6; 3" InvisibleEdges = "15" />
                    <Face Color = "Color" VertexIndexes = " 0; 3; 5; 1" InvisibleEdges = "15" />
                    <Face Color = "Color" VertexIndexes = "23; 1; 5;24" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = "19; 6; 2;17" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = "22; 7; 1;23" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = "17; 2; 8;18" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = "14; 5; 3;12" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = "12; 3; 6;13" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = "10; 4; 7;11" InvisibleEdges = " 7" />
                    <Face Color = "Color" VertexIndexes = " 9; 8; 4;10" InvisibleEdges = " 7" />
                    <Face VertexIndexes = "16;  9; 10; 11; 21" />
                    <Face VertexIndexes = "20; 14; 12; 13; 15" />
                    <Face VertexIndexes = "19; 17; 18; 16; 15" />
                    <Face VertexIndexes = "20; 21; 22; 23; 24" />
                    <Face VertexIndexes = "21; 25; 16" />
                    <Face VertexIndexes = "15; 25; 20" />
                    <Face VertexIndexes = "20; 25; 21" />
                    <Face VertexIndexes = "16; 25; 15" />
                </Faces>
            </Part>
        </Macro>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <ExecMacro MacroName = "RemoveEdges  " Id = "0" Repeat = "12" L = "0.7 * k" />
        <ExecMacro MacroName = "RemoveCenters" Id = "0" Repeat = " 6" L = "0.9 * k" />

        <Macro Name = "Move1" >
            <Turn Axis = "1" Layer = "1" Angle = " Pi/6*k" />
            <Turn Axis = "0" Layer = "1" Angle = " Pi/2" />
            <ExecMacro MacroName = "AddPiece" />
            <Turn Axis = "0" Layer = "1" Angle = "-Pi/2" />
            <Turn Axis = "1" Layer = "1" Angle = "-Pi/6*k" />
        </Macro>

        <ExecMacro MacroName = "Move1" Color = "Colors[5]" k = " 1" />
        <ExecMacro MacroName = "Move1" Color = "Colors[0]" k = " 2" />
        <ExecMacro MacroName = "Move1" Color = "Colors[0]" k = " 4" />
        <ExecMacro MacroName = "Move1" Color = "Colors[4]" k = " 5" />
        <ExecMacro MacroName = "Move1" Color = "Colors[4]" k = " 7" />
        <ExecMacro MacroName = "Move1" Color = "Colors[1]" k = " 8" />
        <ExecMacro MacroName = "Move1" Color = "Colors[1]" k = "10" />
        <ExecMacro MacroName = "Move1" Color = "Colors[5]" k = "11" />

        <Macro Name = "Move2" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi/6*k" />
            <ExecMacro MacroName = "AddPiece" />
            <Turn Axis = "0" Layer = "1" Angle = "-Pi/6*k" />
        </Macro>

        <ExecMacro MacroName = "Move2" Color = "Colors[2]" k = " 1" />
        <ExecMacro MacroName = "Move2" Color = "Colors[5]" k = " 2" />
        <ExecMacro MacroName = "Move2" Color = "Colors[5]" k = " 3" />
        <ExecMacro MacroName = "Move2" Color = "Colors[5]" k = " 4" />
        <ExecMacro MacroName = "Move2" Color = "Colors[3]" k = " 5" />
        <ExecMacro MacroName = "Move2" Color = "Colors[3]" k = " 7" />
        <ExecMacro MacroName = "Move2" Color = "Colors[4]" k = " 8" />
        <ExecMacro MacroName = "Move2" Color = "Colors[4]" k = " 9" />
