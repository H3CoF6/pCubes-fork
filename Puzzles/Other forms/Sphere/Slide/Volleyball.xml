        <ExecMacro MacroName = "Move2" Color = "Colors[2]" k = "11" />

        <Macro Name = "Move3" >
            <Turn Axis = "2" Layer = "1" Angle = " Pi/6*k" />
            <ExecMacro MacroName = "AddPiece" />
            <Turn Axis = "2" Layer = "1" Angle = "-Pi/6*k" />
        </Macro>

        <ExecMacro MacroName = "Move3" Color = "Colors[2]" k = " 0" />
        <ExecMacro MacroName = "Move3" Color = "Colors[2]" k = " 1" />
        <ExecMacro MacroName = "Move3" Color = "Colors[0]" k = " 2" />
        <ExecMacro MacroName = "Move3" Color = "Colors[0]" k = " 3" />
        <ExecMacro MacroName = "Move3" Color = "Colors[0]" k = " 4" />
        <ExecMacro MacroName = "Move3" Color = "Colors[3]" k = " 5" />
        <ExecMacro MacroName = "Move3" Color = "Colors[3]" k = " 6" />
        <ExecMacro MacroName = "Move3" Color = "Colors[3]" k = " 7" />
        <ExecMacro MacroName = "Move3" Color = "Colors[1]" k = " 8" />
        <ExecMacro MacroName = "Move3" Color = "Colors[1]" k = " 9" />
        <ExecMacro MacroName = "Move3" Color = "Colors[1]" k = "10" />
        <ExecMacro MacroName = "Move3" Color = "Colors[2]" k = "11" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
