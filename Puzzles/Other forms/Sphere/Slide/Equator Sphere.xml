        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 1" c = "1111" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 2" c = "1111" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 4" c = "0000" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 5" c = "0000" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 7" c = "3333" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 8" c = "3333" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = "10" c = "2222" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = "11" c = "2222" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
