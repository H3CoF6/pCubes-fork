<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Equator Sphere</Name>
        <Menu>Other forms\Sphere\Slide\Equator Sphere</Menu>
        <Inventor>Ferenc Molnár</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-11-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=563</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FFFF00'; // Yellow
        Colors[2] := '0000A0'; // Blue
        Colors[3] := 'FFFFFF'; // White

        K := 0.6;

        D := K * 0.25;
    </Script>

    <Axes TurningAngles = "0; Pi/6; 0" PlaneDistances = "-D;D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddSegment" >
            <HideAll/>
            <Script>Color := Colors[cl];</Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <Cut> <Plane NormVector = "1;0;0" /> </Cut>
            <Cut> <Plane NormVector = "0;0;1" /> </Cut>
        </Macro>

        <ExecMacro MacroName = "AddSegment" cl = "1" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi/2" />
        <ExecMacro MacroName = "AddSegment" cl = "0" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi/2" />
        <ExecMacro MacroName = "AddSegment" cl = "3" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi/2" />
        <ExecMacro MacroName = "AddSegment" cl = "2" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi/2" />

        <ShowAll/>
        <SplitByAxes/>

        <Macro Name = "RemoveMiddleLayer" >
            <Hide Axis = "ax" Layer = "2" />
            <Cut  Axis = "ax" To = "1" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "RemoveMiddleLayer" ax = "0" />
        <ExecMacro MacroName = "RemoveMiddleLayer" ax = "1" />
        <ExecMacro MacroName = "RemoveMiddleLayer" ax = "2" />

        <Macro Name = "AddPiece" >
            <Script>
                c0 := c mod 10;
                c1 := c div 10 mod 10;
                c2 := c div 100 mod 10;
                c3 := c div 1000;
            </Script>

            <Part>
                <Vertices>
                    <Add Vector = " 0   ;-0.603; 0   " />
                    <Add Vector = " 0   ;-0.591; 0.12" />
                    <Add Vector = " 0   ;-0.591;-0.12" />
                    <Add Vector = " 0.12;-0.591; 0   " />
                    <Add Vector = "-0.12;-0.591; 0   " />
                    <Add Vector = " 0.12;-0.579; 0.12" />
                    <Add Vector = " 0.12;-0.579;-0.12" />
                    <Add Vector = "-0.12;-0.579; 0.12" />
                    <Add Vector = "-0.12;-0.579;-0.12" />
                    <Add Vector = "-0.15;-0.570;-0.12" />
                    <Add Vector = "-0.15;-0.582; 0   " />
                    <Add Vector = "-0.15;-0.570; 0.12" />
                    <Add Vector = " 0.15;-0.582; 0   " />
                    <Add Vector = " 0.15;-0.570;-0.12" />
                    <Add Vector = " 0.15;-0.570; 0.12" />
                    <Add Vector = " 0.15;-0.561;-0.15" />
                    <Add Vector = "-0.15;-0.561;-0.15" />
                    <Add Vector = " 0   ;-0.582;-0.15" />
                    <Add Vector = "-0.12;-0.570;-0.15" />
                    <Add Vector = " 0.12;-0.570;-0.15" />
                    <Add Vector = " 0.15;-0.561; 0.15" />
                    <Add Vector = "-0.15;-0.561; 0.15" />
                    <Add Vector = "-0.12;-0.570; 0.15" />
                    <Add Vector = " 0   ;-0.582; 0.15" />
                    <Add Vector = " 0.12;-0.570; 0.15" />
                    <Add Vector = " 0   ;-0.3  ; 0   " />
                </Vertices>

                <Faces>
                    <Face Color = "Colors[c2]" VertexIndexes = "24; 5;14;20" InvisibleEdges = " 3" />
                    <Face Color = "Colors[c0]" VertexIndexes = "15;13; 6;19" InvisibleEdges = " 6" />
                    <Face Color = "Colors[c3]" VertexIndexes = "21;11; 7;22" InvisibleEdges = " 6" />
                    <Face Color = "Colors[c1]" VertexIndexes = "18; 8; 9;16" InvisibleEdges = " 3" />
                    <Face Color = "Colors[c3]" VertexIndexes = " 0; 1; 7; 4" InvisibleEdges = "15" />
                    <Face Color = "Colors[c1]" VertexIndexes = " 0; 4; 8; 2" InvisibleEdges = "15" />
                    <Face Color = "Colors[c0]" VertexIndexes = " 0; 2; 6; 3" InvisibleEdges = "15" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 0; 3; 5; 1" InvisibleEdges = "15" />
                    <Face Color = "Colors[c2]" VertexIndexes = "23; 1; 5;24" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c0]" VertexIndexes = "19; 6; 2;17" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c3]" VertexIndexes = "22; 7; 1;23" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c1]" VertexIndexes = "17; 2; 8;18" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c2]" VertexIndexes = "14; 5; 3;12" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c0]" VertexIndexes = "12; 3; 6;13" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c3]" VertexIndexes = "10; 4; 7;11" InvisibleEdges = " 7" />
                    <Face Color = "Colors[c1]" VertexIndexes = " 9; 8; 4;10" InvisibleEdges = " 7" />
                    <Face VertexIndexes = "16; 9;10;11;21" />
                    <Face VertexIndexes = "20;14;12;13;15" />
                    <Face VertexIndexes = "19;17;18;16;15" />
                    <Face VertexIndexes = "20;21;22;23;24" />
                    <Face VertexIndexes = "21;25;16" />
                    <Face VertexIndexes = "15;25;20" />
                    <Face VertexIndexes = "20;25;21" />
                    <Face VertexIndexes = "16;25;15" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "MoveAndAdd" >
            <Turn NormVector = "0; 0; 1" Angle = "-Pi/6*x" />
            <Turn NormVector = "1; 0; 0" Angle = " Pi/6*y" />
            <ExecMacro MacroName = "AddPiece" />
            <Turn NormVector = "1; 0; 0" Angle = "-Pi/6*y" />
            <Turn NormVector = "0; 0; 1" Angle = " Pi/6*x" />
        </Macro>

        <ExecMacro MacroName = "MoveAndAdd" x = " 0" y = " 0" c = "0132" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 1" y = " 0" c = "1122" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 2" y = " 0" c = "1122" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 3" y = " 0" c = "1122" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 4" y = " 0" c = "1122" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 5" y = " 0" c = "1122" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 6" y = " 0" c = "1023" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 7" y = " 0" c = "0033" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 8" y = " 0" c = "0033" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 9" y = " 0" c = "0033" />
        <ExecMacro MacroName = "MoveAndAdd" x = "10" y = " 0" c = "0033" />
        <ExecMacro MacroName = "MoveAndAdd" x = "11" y = " 0" c = "0033" />

        <ExecMacro MacroName = "MoveAndAdd" x = " 0" y = " 1" c = "0101" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 0" y = " 2" c = "0101" />
        <ExecMacro MacroName = "MoveAndAdd" x = " 0" y = " 3" c = "0101" />
