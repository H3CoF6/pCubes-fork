<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover 2x2x2</Name>
        <Menu>Other forms\Sphere\Clover 2x2x2</Menu>
        <Inventor>Grant Anderson</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8018</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8331</Link>
        <Link>http://chewiescustomstickers.com/clover-2x2x2.html</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=4&amp;p=398701</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'AA00AA'; // Violett

        K := 0.6;
        D1 := K * 0.895;
        D2 := K * 0.895;

        include 'Figures\Scripts\Cube_Coordinates.inc';
        fE := K / sqrt(2);
        fV := K /  sqrt(3);
        DCutE := K * 0.65;
        DCutV := K * 0.54;
    </Script>

    <Axes TurningAngles = "pi/2" PlaneDistances = "0"  TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1;-1" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "CutEdge" >
            <HideContaining Vector = "fE; 0; fE" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = " 1; 0;-2" NormDistance = "-DCutE" /> </Cut>
            <Cut> <Plane NormVector = "-2; 0; 1" NormDistance = "-DCutE" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

        <Macro Name = "CutVertex" >
            <HideContaining Vector = "fV; fV; fV" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = "-3; 1; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1;-3; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1; 1;-3" NormDistance = "-DCutV" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
