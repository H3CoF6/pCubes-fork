<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trifurcation Plus</Name>
        <Menu>Other forms\Sphere\Trifurcation Plus</Menu>
        <Inventor>El_Cubitero</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7649</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Coordinates.inc';
        K  := 0.6;
        C0 := sqrt(2) - 1;

        D  := K * 0.9;

        A1 := ArcCos((-1 + 2 * sqrt(2)) / 4);
		A2 := ArcCos((-2 -     sqrt(2)) / 4 ); // A2 := Pi - A1/2;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2;0;A2;A1" PlaneDistances = "-D;D" FixedLayers = "1" >
        <Axis NormVector = "  1; C0;  1" />
        <Axis NormVector = "  1; C0; -1" />
        <Axis NormVector = "  1;-C0;  1" />
        <Axis NormVector = "  1;-C0; -1" />
        <Axis NormVector = "  1;  1; C0" />
        <Axis NormVector = "  1;  1;-C0" />
        <Axis NormVector = "  1; -1; C0" />
        <Axis NormVector = "  1; -1;-C0" />
        <Axis NormVector = " C0;  1;  1" />
        <Axis NormVector = " C0;  1; -1" />
        <Axis NormVector = " C0; -1;  1" />
        <Axis NormVector = " C0; -1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "Unbandage" >
            <HideContaining Vector = "-K*0.7 ;      0; K*0.7"/>
            <HideContaining Vector = " K*0.53;-K*0.53; K*0.6"/>
            <InvertVisibility/>
            <Split><Plane NormVector = "-1; 0;   sqrt(2) + 2" NormDistance = "D" /></Split>
            <Split><Plane NormVector = " 1;-1; 2*sqrt(2) + 2" NormDistance = "D" /></Split>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Turn NormVector = "0;1;0" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Turn NormVector = "0;1;0" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Turn NormVector = "0;1;0" Angle = "Pi / 2" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>

