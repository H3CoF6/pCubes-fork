    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := '0000CC'; // clBlue
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '00AA00'; // clGreen
        Colors[ 5] := '800080'; // clViolett
        Colors[ 6] := 'FFFFAA'; // clCream
        Colors[ 7] := '0066CC'; // clLightBlue
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := '00FF00'; // clLightGreen
        Colors[10] := 'FF88CC'; // clLightViolett
        Colors[11] := '666666'; // clGray

        // code from Pentagonal Icositetrahedron
        K := 0.6;

        K0  := 0.5; // result is independent from K
        K1 := (6 * (9 + sqrt(33)))^(1/3);
        K2 := (6 * (9 - sqrt(33)))^(1/3);
        K3 := (2 * (1777 + 33*sqrt(33)))^(1/3);
        K4 := (2 * (1777 - 33*sqrt(33)))^(1/3);

        C0 := K0 * sqrt(6 * (-6 + K1 + K2)) / 12;
        C1 := K0 * sqrt(6 * ( 6 + K1 + K2)) / 12;
        C2 := K0 * sqrt(6 * (18 + K1 + K2)) / 12;
        C3 := K0 * sqrt(6 * (14 + K3 + K4)) / 12;

        n1 := (c1 - c0)^2;
        n2 := (c1 - c2)^2;
        n3 := (c1 - c2) * (c0 - c1);

        bgx := -n2*n3 + n1^2;
        bgy :=  n1*n2 - n3^2;
        bgz := -n1*n3 + n2^2;

        byx := -n2^2 + n1*n3;
        byy :=  n1^2 - n2*n3;
        byz := -n3^2 + n1*n2;

        A1 := ArcCos((bgx*byx + bgy*byy + bgz*byz) / (bgx^2 + bgy^2 + bgz^2));
        A2 := 2 * A1;
        A3 := 3 * A1;
        A4 := 4 * A1;

        D := K * 0.858;
    </Script>

