        <Axis NormVector = " C0;-C1; C2" />
        <Axis NormVector = " C0;-C1;-C2" />
        <Axis NormVector = " C2; C0; C1" />
        <Axis NormVector = " C2; C0;-C1" />
        <Axis NormVector = " C2;-C0; C1" />
        <Axis NormVector = " C2;-C0;-C1" />
        <Axis NormVector = " C1; C2; C0" />
        <Axis NormVector = " C1; C2;-C0" />
        <Axis NormVector = " C1;-C2; C0" />
        <Axis NormVector = " C1;-C2;-C0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "Cut1">
            <Turn  Axis = "a" Angle = "J" Layer = "0" />
            <Turn  Axis = "a" Angle = "J" Layer = "2" />
            <Turn  Axis = "b" Angle = "K" Layer = "0" />
            <Turn  Axis = "b" Angle = "K" Layer = "2" />
            <Split Axis = "a" From = "1" />
            <Split Axis = "a" From = "2" />
            <Undo Repeat = "4"/>
        </Macro>
        <Macro Name = "Cut2">
            <Turn Axis = "a" Angle = " J" Layer = "0" />
            <Turn Axis = "a" Angle = " J" Layer = "2" />
            <Turn Axis = "b" Angle = " J" Layer = "0" />
            <Turn Axis = "b" Angle = " J" Layer = "2" />
            <Turn Axis = "a" Angle = "-J" Layer = "0" />
            <Turn Axis = "a" Angle = "-J" Layer = "2" />
            <Turn Axis = "b" Angle = "-J" Layer = "0" />
            <Turn Axis = "b" Angle = "-J" Layer = "2" />
            <SplitByAxes/>
            <Undo Repeat = "8"/>
        </Macro>

