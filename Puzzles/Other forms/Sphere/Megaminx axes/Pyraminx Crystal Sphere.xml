<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Crystal Sphere</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Pyraminx Crystal Sphere</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2548</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);

        K := 0.6;

        D := K * 0.5307631976640*cs; // C34 * cs
    </Script>

    <Axes TurningAngles = "2*Pi/5;0;2*Pi/5" PlaneDistances = "-D; D" >
        <Axis NormVector = "  0;-cs; ss" />
        <Axis NormVector = "  0;-cs;-ss" />
        <Axis NormVector = "-ss;  0;-cs" />
        <Axis NormVector = " ss;  0;-cs" />
        <Axis NormVector = " cs;-ss;  0" />
        <Axis NormVector = " cs; ss;  0" />
    </Axes>


    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
