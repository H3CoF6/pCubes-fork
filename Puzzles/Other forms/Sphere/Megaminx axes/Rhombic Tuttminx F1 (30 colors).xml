    <Script>
        Colors[ 0] := '662222'; // clBrown
        Colors[ 1] := '800020'; // clBurgundy
        Colors[ 2] := '666666'; // clDarkGray
        Colors[ 3] := 'ee3300'; // clOrange
        Colors[ 4] := 'ff6600'; // clLightOrange
        Colors[ 5] := 'ffcc00'; // clDarkerYellow
        Colors[ 6] := 'ffdd33'; // clGold
        Colors[ 7] := 'c0c0c0'; // clSilver
        Colors[ 8] := 'ff66cb'; // clPink
        Colors[ 9] := '005500'; // clForrestGreen
        Colors[10] := '00aa22'; // clGrassGreen
        Colors[11] := '4cee17'; // clKellyGreen
        Colors[12] := 'ff0088'; // clMagenta
        Colors[13] := '007777'; // clTeal
        Colors[14] := '7700aa'; // clViolet
        Colors[15] := '0088dd'; // clLightBlue
        Colors[16] := '0000ee'; // clVividBlue
        Colors[17] := '0077aa'; // clGentianBlue
        Colors[18] := 'dd2200'; // clOrangeBrown
        Colors[19] := 'ee8800'; // clLightBrown
        Colors[20] := 'ccaa33'; // clIvory
        Colors[21] := 'bab9a9'; // clMistGray
        Colors[22] := 'ffff00'; // clYellow
        Colors[23] := 'ffffff'; // clWhite
        Colors[24] := '000096'; // clDarkBlue
        Colors[25] := '0000bb'; // clBlue
        Colors[26] := '009600'; // clGreen
        Colors[27] := '00ddcc'; // clCyan
        Colors[28] := '000055'; // clBlack
        Colors[29] := 'ffaa00'; // clLighterOrange

        for j := 30 to 59 do
            Colors[j] := Colors[j-30];

        K := 0.6;

        Phi := (Sqrt(5) - 1) / 2; // The golden ratio
        JumAngle := ArcTan(2);

        D1 := K * 0.915;
        D2 := K * 0.90;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "-Phi  ;-1    ; Phi-1" />
        <Axis NormVector = "-Phi  ;-1    ;-Phi-1" />
        <Axis NormVector = " Phi  ;-1    ;-Phi-1" />
        <Axis NormVector = " Phi+1;-Phi  ;-1    " />
        <Axis NormVector = " Phi+1; Phi  ;-1    " />
        <Axis NormVector = "-Phi+1; Phi  ;-1    " />
        <Axis NormVector = " 1    ;-Phi-1;-Phi  " />
        <Axis NormVector = " 1    ;-Phi-1; Phi  " />
        <Axis NormVector = " Phi  ; 1    ; Phi-1" />
        <Axis NormVector = "-Phi  ; 1    ;-Phi-1" />
        <Axis NormVector = " Phi+1;-Phi  ; 1    " />
        <Axis NormVector = " Phi+1; Phi  ; 1    " />
    </Axes>

    <Axes TurningAngles = "2*Pi/5"  PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "   0;  -1; Phi" />
        <Axis NormVector = "   0;  -1;-Phi" />
        <Axis NormVector = "-Phi;   0;  -1" />
        <Axis NormVector = " Phi;   0;  -1" />
        <Axis NormVector = "   1;-Phi;   0" />
        <Axis NormVector = "   1; Phi;   0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere (60 colors).xml" />
        <SplitByAxes/>

        <Macro Name = "unbandage">
            <Turn Axis = "a1" Layer = "l1" Angle = "JumAngle" />
            <Turn Axis = "a2" Layer = "l2" Angle = "Pi" />
            <Turn Axis = "a1" Layer = "l1" Angle = "-JumAngle" />
            <SplitByAxes/>
            <Undo Repeat = "3" />

            <Turn Axis = "a2" Layer = "l1" Angle = "-JumAngle" />
            <Turn Axis = "a1" Layer = "l2" Angle = "Pi" />
            <Turn Axis = "a2" Layer = "l1" Angle = "JumAngle" />
            <SplitByAxes/>
            <Undo Repeat = "3" />
        </Macro>
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "13" a2 = "14" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 7" a2 = " 6" />
