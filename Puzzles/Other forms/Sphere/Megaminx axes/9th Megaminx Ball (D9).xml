<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>9th Megaminx Ball (D9)</Name>
        <Menu>Other forms\Sphere\Megaminx axes\9th Megaminx Ball (D9)</Menu>
        <Inventor>Leslie Le</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-03-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7921</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        phi := (Sqrt(5) - 1) / 2; // The golden ratio

        K := 0.6;
        D := K * 0.33;
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "-D; D" >
        <Axis NormVector = "   0;  -1; phi" />
        <Axis NormVector = "   0;  -1;-phi" />
        <Axis NormVector = "-phi;   0;  -1" />
        <Axis NormVector = " phi;   0;  -1" />
        <Axis NormVector = "   1;-phi;   0" />
        <Axis NormVector = "   1; phi;   0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
