<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Stripe Pentultimate Ball</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Stripe Pentultimate Ball</Menu>
        <Inventor>Pawel Bodytko</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-08-26</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=418926#p418926</Link>
    </Interface>

    <Script>
        Color1 := '222222';
        Color2 := '999999';
        Color3 := 'FF0000';

        K := 0.6;
        D := K * 0.1;
        phi := (Sqrt(5) - 1) / 2; // The golden ratio
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "   0;  -1; phi" />
        <Axis NormVector = "   0;  -1;-phi" />
        <Axis NormVector = "-phi;   0;  -1" />
        <Axis NormVector = " phi;   0;  -1" />
        <Axis NormVector = "   1;-phi;   0" />
        <Axis NormVector = "   1; phi;   0" />
    </Axes>

    <Figure>
        <Macro Name = "AddMonoSphere" >
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        </Macro>

        <ExecMacro MacroName = "AddMonoSphere" Color = "Color1" />
        <Cut> <Plane NormVector = "-phi; 0; -1" NormDistance = "D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddMonoSphere" Color = "Color2" />
        <Cut> <Plane NormVector = " phi; 0;  1" NormDistance = "D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddMonoSphere" Color = "Color3" />
        <Cut> <Plane NormVector = " phi; 0; 1" NormDistance = "-D" /> </Cut>
        <Cut> <Plane NormVector = "-phi; 0;-1" NormDistance = "-D" /> </Cut>

        <ShowAll/>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
