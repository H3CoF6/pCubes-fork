<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Lotus Pentultimate Ball</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Lotus Pentultimate Ball</Menu>
        <Inventor>Pawel Bodytko</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-08-26</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=418926#p418926</Link>
    </Interface>

    <Script>
        Color1 := '222222';
        Color2 := '999999';

        K := 0.6;
        phi := (Sqrt(5) - 1) / 2; // The golden ratio

        ax[ 0] :=    0; ay[ 0] :=   -1; az[ 0] :=  phi;
        ax[ 1] :=    0; ay[ 1] :=   -1; az[ 1] := -phi;
        ax[ 2] := -phi; ay[ 2] :=    0; az[ 2] :=   -1;
        ax[ 3] :=  phi; ay[ 3] :=    0; az[ 3] :=   -1;
        ax[ 4] :=    1; ay[ 4] := -phi; az[ 4] :=    0;
        ax[ 5] :=    1; ay[ 5] :=  phi; az[ 5] :=    0;
        ax[ 6] :=    0; ay[ 6] :=    1; az[ 6] := -phi;
        ax[ 7] :=    0; ay[ 7] :=    1; az[ 7] :=  phi;
        ax[ 8] :=  phi; ay[ 8] :=    0; az[ 8] :=    1;
        ax[ 9] := -phi; ay[ 9] :=    0; az[ 9] :=    1;
        ax[10] :=   -1; ay[10] :=  phi; az[10] :=    0;
        ax[11] :=   -1; ay[11] := -phi; az[11] :=    0;

        DCut := K * 0.5;
        for i := 0 to 11 do begin
            ax[i] := ax[i] * DCut;
            ay[i] := ay[i] * DCut;
            az[i] := az[i] * DCut;
        end;
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " ax[0]; ay[0]; az[0]" />
        <Axis NormVector = " ax[1]; ay[1]; az[1]" />
        <Axis NormVector = " ax[2]; ay[2]; az[2]" />
        <Axis NormVector = " ax[3]; ay[3]; az[3]" />
        <Axis NormVector = " ax[4]; ay[4]; az[4]" />
        <Axis NormVector = " ax[5]; ay[5]; az[5]" />
    </Axes>

    <Figure>
        <Macro Name = "AddMonoSphere" >
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
            <Split><Plane NormVector = " ax[ax1]; ay[ax1]; az[ax1]" /></Split>
            <Split><Plane NormVector = " ax[ax2]; ay[ax2]; az[ax2]" /></Split>
            <Split><Plane NormVector = " ax[ax3]; ay[ax3]; az[ax3]" /></Split>
        </Macro>

        <Macro Name = "AddSolvedState" >
            <RemoveAllVisible />
            <ExecMacro MacroName = "AddMonoSphere" Color = "Color1" />

            <RemoveContaining Vector = " ax[ax1]; ay[ax1]; az[ax1]" />
            <RemoveContaining Vector = " ax[ax2]; ay[ax2]; az[ax2]" />
            <RemoveContaining Vector = " ax[ax3]; ay[ax3]; az[ax3]" />
            <RemoveContaining Vector = " ax[ax1] + ax[ax2] + ax[ax3]; ay[ax1] + ay[ax2] + ay[ax3]; az[ax1] + az[ax2] + az[ax3]" />
            <HideAll/>

            <ExecMacro MacroName = "AddMonoSphere" Color = "Color2" />

            <RemoveContaining Vector = "-ax[ax1];-ay[ax1];-az[ax1]" />
            <RemoveContaining Vector = "-ax[ax2];-ay[ax2];-az[ax2]" />
            <RemoveContaining Vector = "-ax[ax3];-ay[ax3];-az[ax3]" />
            <RemoveContaining Vector = "-ax[ax1] - ax[ax2] - ax[ax3];-ay[ax1] - ay[ax2] - ay[ax3];-az[ax1] - az[ax2] - az[ax3]" />
            <ShowAll/>
            <SplitByAxes/>
            <SaveSolvedState/>
        </Macro>

        <ExecMacro MacroName = "AddSolvedState" ax1 = " 0" ax2 = " 2" ax3 = " 5" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 6" ax2 = " 8" ax3 = " 1" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 4" ax2 = " 6" ax3 = "11" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 3" ax2 = " 8" ax3 = "11" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 3" ax2 = " 8" ax3 = "10" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 4" ax2 = " 6" ax3 = " 9" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 4" ax2 = " 7" ax3 = "11" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 1" ax2 = " 8" ax3 = "10" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 1" ax2 = " 6" ax3 = " 9" />
        <ExecMacro MacroName = "AddSolvedState" ax1 = " 3" ax2 = " 7" ax3 = "11" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
