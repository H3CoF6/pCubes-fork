<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Tuttminx</Name>
        <Aliases>Circle Curvy Helicopter Dodecahedron</Aliases>
        <Menu>Other forms\Sphere\Megaminx axes\Rhombic Tuttminx</Menu>
        <Inventor>Leslie Le</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7517</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0000CC'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := 'AA00AA'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0066CC'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF88CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);

        K := 0.6;
        D1 := K * 0.92;
        D2 := K * 0.90;
    </Script>

    <Axes TurningAngles = "2*Pi/5"  PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "  0;-cs; ss" />
        <Axis NormVector = "  0;-cs;-ss" />
        <Axis NormVector = "-ss;  0;-cs" />
        <Axis NormVector = " ss;  0;-cs" />
        <Axis NormVector = " cs;-ss;  0" />
        <Axis NormVector = " cs; ss;  0" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "mAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />

        <Axis NormVector = "   -ss;   -cs; ss-cs" />
        <Axis NormVector = "   -ss;   -cs;-ss-cs" />
        <Axis NormVector = "    ss;   -cs;-ss-cs" />
        <Axis NormVector = " ss+cs;   -ss;   -cs" />
        <Axis NormVector = " ss+cs;    ss;   -cs" />
        <Axis NormVector = "-ss+cs;    ss;   -cs" />
        <Axis NormVector = "    cs;-ss-cs;   -ss" />
        <Axis NormVector = "    cs;-ss-cs;    ss" />
        <Axis NormVector = "    ss;    cs; ss-cs" />
        <Axis NormVector = "   -ss;    cs;-ss-cs" />
        <Axis NormVector = " ss+cs;   -ss;    cs" />
        <Axis NormVector = " ss+cs;    ss;    cs" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
