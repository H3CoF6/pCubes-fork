<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crescent Dodecahedron</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Crescent Dodecahedron</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-17</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36403</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0000DD'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := 'AA00BB'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0066CC'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF88CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        K := 0.6;

        phi := (Sqrt(5) - 1) / 2; // The golden ratio

        D1 := K * 0.96;
        D2 := K * 0.896805465;
    </Script>

    <Axes TurningAngles = "Pi"  PlaneDistances = "-D1; D1"  FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = "  -phi;    -1; phi-1" />
        <Axis NormVector = "  -phi;    -1;-phi-1" />
        <Axis NormVector = "   phi;    -1;-phi-1" />
        <Axis NormVector = " phi+1;  -phi;    -1" />
        <Axis NormVector = " phi+1;   phi;    -1" />
        <Axis NormVector = "-phi+1;   phi;    -1" />
        <Axis NormVector = "     1;-phi-1;  -phi" />
        <Axis NormVector = "     1;-phi-1;   phi" />
        <Axis NormVector = "   phi;     1; phi-1" />
        <Axis NormVector = "  -phi;     1;-phi-1" />
        <Axis NormVector = " phi+1;  -phi;     1" />
        <Axis NormVector = " phi+1;   phi;     1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 2 + phi; 0" />
        <Axis NormVector = "-1; 2 + phi; 0" />

        <Axis NormVector = "2 + phi; 0;-1" />
        <Axis NormVector = "2 + phi; 0; 1" />

        <Axis NormVector = "0; 1; 2 + phi" />
        <Axis NormVector = "0;-1; 2 + phi" />

        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
