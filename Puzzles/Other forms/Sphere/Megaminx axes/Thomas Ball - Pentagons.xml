<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Thomas Ball - Pentagons</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Thomas Ball - Pentagons</Menu>
        <Inventor>Milan Vodicka</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6556</Link>
    </Interface>

    <Script>
        for i := 0 to 11 do
            Colors[i] := '222222';

        K := 0.6;
        D := K * 0.53;
        R := K;

        phi := (Sqrt(5) - 1) / 2; // The golden ratio
        a := R / sqrt(phi + 3);
        b := a / phi;
        c := a * phi;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/5" PlaneDistances = "D" >
        <Axis NormVector = " 0;-a; c" />
        <Axis NormVector = " 0;-a;-c" />
        <Axis NormVector = " 0; a;-c" />
        <Axis NormVector = " 0; a; c" />
        <Axis NormVector = "-c; 0;-a" />
        <Axis NormVector = " c; 0;-a" />
        <Axis NormVector = " c; 0; a" />
        <Axis NormVector = "-c; 0; a" />
        <Axis NormVector = " a;-c; 0" />
        <Axis NormVector = " a; c; 0" />
        <Axis NormVector = "-a; c; 0" />
        <Axis NormVector = "-a;-c; 0" />
    </Axes>

    <Figure>
        <Macro Name = "HideVC" >
            <HideContaining Vector = " 0;-a; c" />
            <HideContaining Vector = " 0;-a;-c" />
            <HideContaining Vector = " 0; a;-c" />
            <HideContaining Vector = " 0; a; c" />
            <HideContaining Vector = "-c; 0;-a" />
            <HideContaining Vector = " c; 0;-a" />
            <HideContaining Vector = " c; 0; a" />
            <HideContaining Vector = "-c; 0; a" />
            <HideContaining Vector = " a;-c; 0" />
            <HideContaining Vector = " a; c; 0" />
            <HideContaining Vector = "-a; c; 0" />
            <HideContaining Vector = "-a;-c; 0" />

            <HideContaining Vector = " 0; c; b" />
            <HideContaining Vector = " 0;-c; b" />
            <HideContaining Vector = " 0;-c;-b" />
            <HideContaining Vector = " 0; c;-b" />
            <HideContaining Vector = " c; b; 0" />
            <HideContaining Vector = "-c; b; 0" />
            <HideContaining Vector = "-c;-b; 0" />
            <HideContaining Vector = " c;-b; 0" />
            <HideContaining Vector = " b; 0; c" />
            <HideContaining Vector = " b; 0;-c" />
            <HideContaining Vector = "-b; 0;-c" />
            <HideContaining Vector = "-b; 0; c" />
            <HideContaining Vector = " a; a; a" />
            <HideContaining Vector = " a; a;-a" />
            <HideContaining Vector = " a;-a; a" />
            <HideContaining Vector = " a;-a;-a" />
            <HideContaining Vector = "-a; a; a" />
            <HideContaining Vector = "-a; a;-a" />
            <HideContaining Vector = "-a;-a; a" />
            <HideContaining Vector = "-a;-a;-a" />
        </Macro>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <ExecMacro MacroName = "HideVC" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';
        </Script>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <ExecMacro MacroName = "HideVC" />
        <RemoveAllVisible/>
        <ShowAll/>

        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

