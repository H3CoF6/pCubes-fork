<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Tuttminx F1</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Rhombic Tuttminx F1</Menu>
        <Inventor>Leslie Le</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7646</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := '0000CC'; // Blue
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green
        Colors[ 5] := 'AA00AA'; // Violett
        Colors[ 6] := 'FFFFAA'; // Cream
        Colors[ 7] := '0066CC'; // LightBlue
        Colors[ 8] := 'FF6000'; // Orange
        Colors[ 9] := '00FF00'; // LightGreen
        Colors[10] := 'FF88CC'; // LightViolett
        Colors[11] := '666666'; // Gray

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);

        K := 0.6;
        D1 := K * 0.915;
        D2 := K * 0.90;
        JumAngle := arctan(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "arctan(2)" PlaneDistances = "-D2; D2"  FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "   -ss;   -cs; ss-cs" />
        <Axis NormVector = "   -ss;   -cs;-ss-cs" />
        <Axis NormVector = "    ss;   -cs;-ss-cs" />
        <Axis NormVector = " ss+cs;   -ss;   -cs" />
        <Axis NormVector = " ss+cs;    ss;   -cs" />
        <Axis NormVector = "-ss+cs;    ss;   -cs" />
        <Axis NormVector = "    cs;-ss-cs;   -ss" />
        <Axis NormVector = "    cs;-ss-cs;    ss" />
        <Axis NormVector = "    ss;    cs; ss-cs" />
        <Axis NormVector = "   -ss;    cs;-ss-cs" />
        <Axis NormVector = " ss+cs;   -ss;    cs" />
        <Axis NormVector = " ss+cs;    ss;    cs" />
    </Axes>

    <Axes TurningAngles = "2*Pi/5"  PlaneDistances = "-D1; D1" FixedLayers = "1">
        <Axis NormVector = "  0;-cs; ss" />
        <Axis NormVector = "  0;-cs;-ss" />
        <Axis NormVector = "-ss;  0;-cs" />
        <Axis NormVector = " ss;  0;-cs" />
        <Axis NormVector = " cs;-ss;  0" />
        <Axis NormVector = " cs; ss;  0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "unbandage">
            <Turn Axis = "a1" Layer = "l1" Angle = "JumAngle" />
            <Turn Axis = "a2" Layer = "l2" Angle = "Pi" />
            <Turn Axis = "a1" Layer = "l1" Angle = "-JumAngle" />
            <SplitByAxes/>
            <Undo Repeat = "3" />

            <Turn Axis = "a2" Layer = "l1" Angle = "-JumAngle" />
            <Turn Axis = "a1" Layer = "l2" Angle = "Pi" />
            <Turn Axis = "a2" Layer = "l1" Angle = "JumAngle" />
            <SplitByAxes/>
            <Undo Repeat = "3" />
        </Macro>
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "13" a2 = "14" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 7" a2 = " 6" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 8" a2 = " 7" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 1" a2 = "11" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 8" a2 = "12" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "13" a2 = "10" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 4" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 6" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 0" a2 = " 7" />

        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "13" a2 = "14" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 7" a2 = " 6" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 8" a2 = " 7" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 1" a2 = "11" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 8" a2 = "12" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "13" a2 = "10" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 4" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 6" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 0" a2 = " 7" />

        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "2" a1 = "14" a2 = " 3" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "0" a1 = "14" a2 = " 3" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "2" a1 = " 4" a2 = " 2" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "0" a1 = " 4" a2 = " 2" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "2" a1 = " 9" a2 = " 1" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "0" a1 = " 9" a2 = " 1" />
        <SaveSolvedState/>
    </Figure>

