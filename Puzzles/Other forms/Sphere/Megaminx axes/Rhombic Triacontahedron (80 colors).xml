        K := 0.6;

        Phi := (Sqrt(5) - 1) / 2; // The golden ratio
        a := K/2; //R / sqrt(3);
        b := a / phi;
        c := a * phi;

        Vx[ 0] := 0; Vy[ 0] := c; Vz[ 0] := b;
        Vx[ 1] := 0; Vy[ 1] :=-c; Vz[ 1] := b;
        Vx[ 2] := 0; Vy[ 2] :=-c; Vz[ 2] :=-b;
        Vx[ 3] := 0; Vy[ 3] := c; Vz[ 3] :=-b;

        Vx[ 4] := c; Vy[ 4] := b; Vz[ 4] := 0;
        Vx[ 5] :=-c; Vy[ 5] := b; Vz[ 5] := 0;
        Vx[ 6] :=-c; Vy[ 6] :=-b; Vz[ 6] := 0;
        Vx[ 7] := c; Vy[ 7] :=-b; Vz[ 7] := 0;

        Vx[ 8] := b; Vy[ 8] := 0; Vz[ 8] := c;
        Vx[ 9] := b; Vy[ 9] := 0; Vz[ 9] :=-c;
        Vx[10] :=-b; Vy[10] := 0; Vz[10] :=-c;
        Vx[11] :=-b; Vy[11] := 0; Vz[11] := c;

        Vx[12] := a; Vy[12] := a; Vz[12] := a;
        Vx[13] := a; Vy[13] := a; Vz[13] :=-a;
        Vx[14] := a; Vy[14] :=-a; Vz[14] := a;
        Vx[15] := a; Vy[15] :=-a; Vz[15] :=-a;
        Vx[16] :=-a; Vy[16] := a; Vz[16] := a;
        Vx[17] :=-a; Vy[17] := a; Vz[17] :=-a;
        Vx[18] :=-a; Vy[18] :=-a; Vz[18] := a;
        Vx[19] :=-a; Vy[19] :=-a; Vz[19] :=-a;

        D := K * 0.9025;

        JumAngle := arctan(2);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" JumbleAngle = "JumAngle" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "-Phi  ;-1    ; Phi-1" />
        <Axis NormVector = "-Phi  ;-1    ;-Phi-1" />
        <Axis NormVector = " Phi  ;-1    ;-Phi-1" />
        <Axis NormVector = " Phi+1;-Phi  ;-1    " />
        <Axis NormVector = " Phi+1; Phi  ;-1    " />
        <Axis NormVector = "-Phi+1; Phi  ;-1    " />
        <Axis NormVector = " 1    ;-Phi-1;-Phi  " />
        <Axis NormVector = " 1    ;-Phi-1; Phi  " />
        <Axis NormVector = " Phi  ; 1    ; Phi-1" />
        <Axis NormVector = "-Phi  ; 1    ;-Phi-1" />
        <Axis NormVector = " Phi+1;-Phi  ; 1    " />
        <Axis NormVector = " Phi+1; Phi  ; 1    " />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere (60 colors).xml" />

        <Macro Name = "split">
            <Split><Plane NormVector = "   0;  -1; Phi" NormDistance = "0" /></Split>
            <Split><Plane NormVector = "   0;  -1;-Phi" NormDistance = "0" /></Split>
            <Split><Plane NormVector = "-Phi;   0;  -1" NormDistance = "0" /></Split>
            <Split><Plane NormVector = " Phi;   0;  -1" NormDistance = "0" /></Split>
            <Split><Plane NormVector = "   1;-Phi;   0" NormDistance = "0" /></Split>
            <Split><Plane NormVector = "   1; Phi;   0" NormDistance = "0" /></Split>
        </Macro>
        <ExecMacro MacroName = "split" />

        <RemoveContaining Vector = "Vx;Vy;Vz" />
        <HideAll/>

        <Macro Name = "AddPart" >
            <Script>
                Inc(i);
                for j := 0 to 11 do
                    Colors[j] := Colors[i+60];
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
            <ExecMacro MacroName = "split" />
            <HideContaining Vector = "Vx[i];Vy[i];Vz[i]" />
            <RemoveAllVisible/>
        </Macro>
        <ExecMacro MacroName = "AddPart" i = "-1" Repeat =  "20" />
        <ShowAll/>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
