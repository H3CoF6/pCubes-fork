<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Big Stingray (12 colors)</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Big Stingray (12 colors)</Menu>
        <Inventor>Leslie Le</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-01</Added>
        <Link>https://www.verypuzzle.com/index.php?route=product/product&amp;product_id=145</Link>
    </Interface>

    <Script>
        Colors[ 0] := '9900CC'; // Violett
        Colors[ 1] := 'FF800A'; // Orange
        Colors[ 2] := 'FFBF05'; //
        Colors[ 3] := 'FFFF00'; // Yellow
        Colors[ 4] := 'CC0066'; //
        Colors[ 5] := 'EE0000'; // Red
        Colors[ 6] := 'AFFF00'; //
        Colors[ 7] := '00FF00'; // LightGreen
        Colors[ 8] := '00BA00'; //
        Colors[ 9] := '009600'; // Green
        Colors[10] := '007799'; // Blue
        Colors[11] := '0033EE'; // Blue

        K := 0.6;

        Phi := (Sqrt(5) - 1) / 2; // The golden ratio

        D := K * 0.9625;
        D2 := K * 0.9575;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D"  FixedLayers = "1" >
        <Axis NormVector = "     1;     0;     0" />
        <Axis NormVector = "     0;     1;     0" />
        <Axis NormVector = "     0;     0;     1" />
        <Axis NormVector = "  -Phi;    -1; Phi-1" />
        <Axis NormVector = "  -Phi;    -1;-Phi-1" />
        <Axis NormVector = "   Phi;    -1;-Phi-1" />
        <Axis NormVector = " Phi+1;  -Phi;    -1" />
        <Axis NormVector = " Phi+1;   Phi;    -1" />
        <Axis NormVector = "-Phi+1;   Phi;    -1" />
        <Axis NormVector = "     1;-Phi-1;  -Phi" />
        <Axis NormVector = "     1;-Phi-1;   Phi" />
        <Axis NormVector = "   Phi;     1; Phi-1" />
        <Axis NormVector = "  -Phi;     1;-Phi-1" />
        <Axis NormVector = " Phi+1;  -Phi;     1" />
        <Axis NormVector = " Phi+1;   Phi;     1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; Phi+2; 0" />
        <Axis NormVector = "-1; Phi+2; 0" />

        <Axis NormVector = " Phi+2; 0;-1" />
        <Axis NormVector = " Phi+2; 0; 1" />

        <Axis NormVector = " 0; 1; Phi+2" />
        <Axis NormVector = " 0;-1; Phi+2" />

        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
