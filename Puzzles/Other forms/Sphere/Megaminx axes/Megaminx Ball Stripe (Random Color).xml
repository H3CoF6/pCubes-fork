<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megaminx Ball Stripe (Random Color)</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Megaminx Ball Stripe (Random Color)</Menu>
        <Inventor>Traipum Prungtaengkit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-03-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6592</Link>
    </Interface>

    <Script>
        <!-- These four puzzles are part of the same series, but the only difference is color. -->
        // Megaminx Ball Clear Jade Blue Emedded Metallized Gold
        Colors0[0] := '3848FF'; // clBlue
        Colors1[0] := 'EFCC71'; // clGold
        
        // Megaminx Ball Metallized Gold Emedded Clear Jade Blue
        Colors0[1] := 'EFCC71'; // clGold
        Colors1[1] := '3848FF'; // clBlue
        
        // Megaminx Ball Clear Jade Red Emedded Metallized Gold
        Colors0[2] := 'FF0000'; // clRed
        Colors1[2] := 'EFCC71'; // clGold
        
        // Megaminx Ball Metallized Gold Emedded Clear Jade Red
        Colors0[3] := 'EFCC71'; // clGold
        Colors1[3] := 'FF0000'; // clRed
        
        C := Random(4);

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);
        as := (ss + cs) / 2;

        K := 0.6;
        D := K * 0.6;
        L := K * 1.5;
    </Script>

    <Axes TurningAngles = "2*Pi/5; 0; 2*Pi/5" PlaneDistances = "-D; D" >
        <Axis NormVector = "   0;-cs; ss" />
        <Axis NormVector = "   0;-cs;-ss" />
        <Axis NormVector = " -ss;  0;-cs" />
        <Axis NormVector = "  ss;  0;-cs" />
        <Axis NormVector = "  cs;-ss;  0" />
        <Axis NormVector = "  cs; ss;  0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSphere" >
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSphere" Color = "Colors0[C]" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        
        <Macro Name = "HideParts" >
            <HideContaining Vector = "    0;-K*cs; K*ss" />
            <HideContaining Vector = "    0; K*cs;-K*ss" />
            <HideContaining Vector = "    0;-K*cs;-K*ss" />
            <HideContaining Vector = "    0; K*cs; K*ss" />
            <HideContaining Vector = " K*ss;    0;-K*cs" />
            <HideContaining Vector = "-K*ss;    0; K*cs" />
            <HideContaining Vector = " K*cs;-K*ss;    0" />
            <HideContaining Vector = "-K*cs;-K*ss;    0" />
            <HideContaining Vector = " K*cs; K*ss;    0" />
            <HideContaining Vector = "-K*cs; K*ss;    0" />
            
            <HideContaining Vector = "      0; L*ss  ;      0" />
            <HideContaining Vector = "      0;-L*ss  ;      0" />
            <HideContaining Vector = " K*cs/2;-K*as  ;-K*ss/2" />
            <HideContaining Vector = "-K*cs/2; K*as  ; K*ss/2" />
            <HideContaining Vector = " K*as  ;-K*ss/2;-K*cs/2" />
            <HideContaining Vector = "-K*as  ; K*ss/2; K*cs/2" />
            <HideContaining Vector = " K*as  ; K*ss/2;-K*cs/2" />
            <HideContaining Vector = "-K*as  ;-K*ss/2; K*cs/2" />
            <HideContaining Vector = " K*cs/2; K*as  ;-K*ss/2" />
            <HideContaining Vector = "-K*cs/2;-K*as  ; K*ss/2" />
        </Macro>

        <ExecMacro MacroName = "HideParts" />
        <InvertVisibility/>
        <RemoveAllVisible/>
        
        <ExecMacro MacroName = "AddSphere" Color = "Colors1[C]" />
        <SplitByAxes/>
        
        <ExecMacro MacroName = "HideParts" />
        
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
