<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megaminx Ball Metallized Gold Embedded Clear Jade Blue</Name>
        <Menu>Other forms\Sphere\Megaminx axes\Megaminx Ball Metallized Gold Embedded Clear Jade Blue</Menu>
        <Inventor>Traipum Prungtaengkit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-03-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6592</Link>
        <Link>https://www.hknowstore.com/locale/en-US/categoryofcorp.aspx?corpname=nowstore&amp;search=jade+embedded</Link>
    </Interface>

    <Script>
        clBlue := '3848FF'; 
        clGold := 'EFCC71';

        mAngle := ArcTan(2);   // phi := (Sqrt(5) - 1) / 2; // The golden ratio
        ss := sin(mAngle / 2); // ss := phi / sqrt(2 - phi);
        cs := cos(mAngle / 2); // cs := 1 / sqrt(2 - phi);
        as := (ss + cs) / 2;

        K := 0.6;
        D := K * 0.6;
        L := K * 1.5;
    </Script>

    <Axes TurningAngles = "2*Pi/5; 0; 2*Pi/5" PlaneDistances = "-D; D" >
        <Axis NormVector = "   0; -cs;  ss" />
        <Axis NormVector = "   0; -cs; -ss" />
        <Axis NormVector = " -ss;   0; -cs" />
        <Axis NormVector = "  ss;   0; -cs" />
        <Axis NormVector = "  cs; -ss;   0" />
        <Axis NormVector = "  cs;  ss;   0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSphere" >
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSphere" Color = "clGold" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        
        <Macro Name = "HideParts" >
            <HideContaining Vector = "    0;-K*cs; K*ss" />
            <HideContaining Vector = "    0; K*cs;-K*ss" />
            <HideContaining Vector = "    0;-K*cs;-K*ss" />
            <HideContaining Vector = "    0; K*cs; K*ss" />
            <HideContaining Vector = " K*ss;    0;-K*cs" />
            <HideContaining Vector = "-K*ss;    0; K*cs" />
            <HideContaining Vector = " K*cs;-K*ss;    0" />
            <HideContaining Vector = "-K*cs;-K*ss;    0" />
            <HideContaining Vector = " K*cs; K*ss;    0" />
            <HideContaining Vector = "-K*cs; K*ss;    0" />
            
            <HideContaining Vector = "      0; L*ss  ;      0" />
            <HideContaining Vector = "      0;-L*ss  ;      0" />
            <HideContaining Vector = " K*cs/2;-K*as  ;-K*ss/2" />
            <HideContaining Vector = "-K*cs/2; K*as  ; K*ss/2" />
            <HideContaining Vector = " K*as  ;-K*ss/2;-K*cs/2" />
            <HideContaining Vector = "-K*as  ; K*ss/2; K*cs/2" />
            <HideContaining Vector = " K*as  ; K*ss/2;-K*cs/2" />
            <HideContaining Vector = "-K*as  ;-K*ss/2; K*cs/2" />
            <HideContaining Vector = " K*cs/2; K*as  ;-K*ss/2" />
            <HideContaining Vector = "-K*cs/2;-K*as  ; K*ss/2" />
        </Macro>

        <ExecMacro MacroName = "HideParts" />
        <InvertVisibility/>
        <RemoveAllVisible/>
        
        <ExecMacro MacroName = "AddSphere" Color = "clBlue" />
        <SplitByAxes/>
        
        <ExecMacro MacroName = "HideParts" />
        
        <RemoveAllVisible/>
        <ShowAll/>
        
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
