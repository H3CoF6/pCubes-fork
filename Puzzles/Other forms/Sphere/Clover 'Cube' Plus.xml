<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover 'Cube' Plus</Name>
        <Menu>Other forms\Sphere\Clover 'Cube' Plus</Menu>
        <Inventor>VeryPuzzle</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-08-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5982</Link>
    </Interface>

    <Script>
        K  := 0.6;
        C0 := 1 + sqrt(2);
        C1 := 1;

        D  := 0.55;

        A1 := ArcCos((-1 + 2 * sqrt(2)) / 4 );
        A2 := ArcCos((-2 -     sqrt(2)) / 4 );
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2;0;A2;A1" PlaneDistances = "-D;D" FixedLayers = "1" >
        <Axis NormVector = " C0; C1; C0" />
        <Axis NormVector = " C0; C1;-C0" />
        <Axis NormVector = " C0;-C1; C0" />
        <Axis NormVector = " C0;-C1;-C0" />
        <Axis NormVector = " C0; C0; C1" />
        <Axis NormVector = " C0; C0;-C1" />
        <Axis NormVector = " C0;-C0; C1" />
        <Axis NormVector = " C0;-C0;-C1" />
        <Axis NormVector = " C1; C0; C0" />
        <Axis NormVector = " C1; C0;-C0" />
        <Axis NormVector = " C1;-C0; C0" />
        <Axis NormVector = " C1;-C0;-C0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>
        <Macro Name = "Unbandage" >
            <Turn  Axis = "a"  Angle = " J1" Layer = "0" />
            <Turn  Axis = "a"  Angle = " J1" Layer = "2" />
            <Turn  Axis = "b"  Angle = " J2" Layer = "0" />
            <Turn  Axis = "b"  Angle = " J2" Layer = "2" />
            <Turn  Axis = "a"  Angle = "-J1" Layer = "0" />
            <Turn  Axis = "a"  Angle = "-J1" Layer = "2" />
            <Turn  Axis = "b"  Angle = "-J2" Layer = "0" />
            <Turn  Axis = "b"  Angle = "-J2" Layer = "2" />
            <SplitByAxes/>
            <Undo Repeat = "8"/>
        </Macro>
        <ExecMacro MacroName = "Unbandage" a = "8 " b = "11" J1 = " A2" J2 = " A2"/>
        <ExecMacro MacroName = "Unbandage" a = "9 " b = "10" J1 = "-A2" J2 = "-A2"/>
        <ExecMacro MacroName = "Unbandage" a = "4 " b = "5 " J1 = "-A2" J2 = " A2"/>
        <ExecMacro MacroName = "Unbandage" a = "6 " b = "7 " J1 = " A2" J2 = "-A2"/>
        <ExecMacro MacroName = "Unbandage" a = "1 " b = "3 " J1 = " A2" J2 = "-A2"/>
        <ExecMacro MacroName = "Unbandage" a = "0 " b = "2 " J1 = "-A2" J2 = " A2"/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
