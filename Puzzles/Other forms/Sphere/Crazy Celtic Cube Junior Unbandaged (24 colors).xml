        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSegment" >
            <Script>
                Colors[0] := Col[c];
                Colors[5] := Col[c+1];
                Colors[3] := Col[c+2];
                c := c + 3;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
            <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 0" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Cut>
            <HideAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        </Macro>
        <ExecMacro MacroName = "AddSegment" c = "0" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddSegment" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ShowAll/>

        <Macro Name = "Split" >
