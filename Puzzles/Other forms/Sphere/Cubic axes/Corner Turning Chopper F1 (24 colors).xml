<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corner Turning Chopper F1 (24 colors)</Name>
        <Menu>Other forms\Sphere\Cubic axes\Corner Turning Chopper F1 (24 colors)</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-14</Added>
        <Link></Link>
    </Interface>

    <Script>
        Col[ 0] := '995500'; // clBrown1
        Col[ 1] := '773300'; // clBrown2
        Col[ 2] := '551100'; // clBrown3
        Col[ 3] := 'FFAA00'; // clOrange1
        Col[ 4] := 'FF8800'; // clOrange2
        Col[ 5] := 'FF6600'; // clOrange3
        Col[ 6] := 'EE0000'; // clRed1
        Col[ 7] := 'DD0000'; // clRed2
        Col[ 8] := 'CC0000'; // clRed3
        Col[ 9] := 'FF55CC'; // clPink1
        Col[10] := 'FF44AA'; // clPink2
        Col[11] := 'FF3388'; // clPink3
        Col[12] := 'FFFF11'; // clYellow
        Col[13] := 'FFEE00'; // clYellow
        Col[14] := 'EEDD00'; // clYellow
        Col[15] := 'BB00EE'; // clViolett1
        Col[16] := 'AA00DD'; // clViolett2
        Col[17] := '9900CC'; // clViolett3
        Col[18] := '00EE00'; // clGreen1
        Col[19] := '00CC00'; // clGreen2
        Col[20] := '00AA00'; // clGreen3
        Col[21] := '0066FF'; // clBlue1
        Col[22] := '0044FF'; // clBlue2
        Col[23] := '0011FF'; // clBlue3

        Colors[1] := -1;
        Colors[2] := -1;
        Colors[4] := -1;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        K := 0.6;

        D1 := K * 0.906;
        D2 := K * 0.777;

        JumAngle := Arccos(1/3);

        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi"  JumbleAngle = "JumAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>
    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddSegment" >
            <Script>
                Colors[0] := Col[c];
                Colors[5] := Col[c+1];
                Colors[3] := Col[c+2];
                c := c + 3;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
            <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 0" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Cut>
            <HideAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        </Macro>
        <ExecMacro MacroName = "AddSegment" c = "0" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddSegment" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ShowAll/>
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "Split" >
            <Hide><Plane NormVector = " 0;-1; 1" NormDistance = "D2" /></Hide>
            <Hide><Plane NormVector = " 1; 0; 1" NormDistance = "D2" /></Hide>
            <Turn NormVector = " 1; 0; 1" Angle = "JumAngle" />
            <Split><Plane NormVector = " 0;-1; 1" NormDistance = "D2" /></Split>
            <Split><Plane NormVector = " 1;-1; 1" NormDistance = "D1" /></Split>
            <Turn NormVector = " 1; 0; 1" Angle = "-JumAngle" />
            <ShowAll/>
            <Turn NormVector = " 0; 0; 1" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Split2" >
            <ExecMacro MacroName = "Split" Repeat = "4" />
            <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
            <ExecMacro MacroName = "Split" Repeat = "4" />
            <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
            <Turn NormVector = " 1; 1; 1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Split2" Repeat = "3" />

        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
