<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crescent Cube</Name>
        <Menu>Other forms\Sphere\Cubic axes\Crescent Cube</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-17</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36403</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0055EE'; // Blue
        Colors[3] := '33BB00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        K := 0.6;

        D1 := K * 0.89;
        D2 := D1 * sqrt(2/3);

        include 'Figures\Scripts\Cube_Coordinates.inc';

        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
