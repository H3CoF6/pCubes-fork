<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Minimal 7x7x7</Name>
        <Menu>Other forms\Sphere\Cubic axes\Minimal 7x7x7</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5014</Link>
    </Interface>

    <Script>
        K := 0.6;

        D1 := K * 0.1;
        D2 := D1 * 3;
        D3 := D1 * 5;

        Color := '333333';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3;-D2;-D1; D1; D2; D3" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "SplitOut">
            <Split Axis = "0" From = "1" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "2" From = "1" />
            <Split Axis = "0" From = "6" />
            <Split Axis = "1" From = "6" />
            <Split Axis = "2" From = "6" />
        </Macro>

        <Macro Name = "HideCenters">
            <HideContaining Vector = "-K; 0; 0" />
            <HideContaining Vector = " K; 0; 0" />
            <HideContaining Vector = " 0;-K; 0" />
            <HideContaining Vector = " 0; K; 0" />
            <HideContaining Vector = " 0; 0;-K" />
            <HideContaining Vector = " 0; 0; K" />
        </Macro>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        <ExecMacro MacroName = "SplitOut" />
        <RemoveGrayParts/>
        <ExecMacro MacroName = "HideCenters" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <ExecMacro MacroName = "SplitOut" />
        <ExecMacro MacroName = "HideCenters" />
        <RemoveAllVisible/>

        <ShowAll/>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
