<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corner Turning Crazy Chopper</Name>
        <Menu>Other forms\Sphere\Cubic axes\Corner Turning Crazy Chopper</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := '0000EE'; // Blue;
        Colors[1] := 'FF7700'; // Orange;
        Colors[2] := '00CC00'; // Green;
        Colors[3] := '550000'; // Brown;
        Colors[4] := 'CC0000'; // Red;
        Colors[5] := 'FFEE00'; // Yellow;
        Colors[6] := 'AA00DD'; // Purple;
        Colors[7] := 'FF77DD'; // Pink;

        K := 0.6;
        D1 := K * 0.896;
        D2 := K * 0.787;
        D3 := K * 0.787;

        JumAngle := Arccos(1/3);

        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi"  JumbleAngle = "JumAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>
    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; D3" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddSector" >
            <HideAll/>
            <Script>Color := Colors[c]</Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <Cut> <Plane NormVector = "Cx[k1]; Cy[k1]; Cz[k1]" /> </Cut>
            <Cut> <Plane NormVector = "Cx[k2]; Cy[k2]; Cz[k2]" /> </Cut>
            <Cut> <Plane NormVector = "Cx[k3]; Cy[k3]; Cz[k3]" /> </Cut>
        </Macro>
        <ExecMacro MacroName = "AddSector" c = "5" k1 = "0" k2 = "2" k3 = "4" />
        <ExecMacro MacroName = "AddSector" c = "7" k1 = "0" k2 = "2" k3 = "5" />
        <ExecMacro MacroName = "AddSector" c = "0" k1 = "0" k2 = "3" k3 = "4" />
        <ExecMacro MacroName = "AddSector" c = "3" k1 = "0" k2 = "3" k3 = "5" />
        <ExecMacro MacroName = "AddSector" c = "6" k1 = "1" k2 = "2" k3 = "4" />
        <ExecMacro MacroName = "AddSector" c = "4" k1 = "1" k2 = "2" k3 = "5" />
        <ExecMacro MacroName = "AddSector" c = "2" k1 = "1" k2 = "3" k3 = "4" />
        <ExecMacro MacroName = "AddSector" c = "1" k1 = "1" k2 = "3" k3 = "5" />

        <ShowAll/>

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
