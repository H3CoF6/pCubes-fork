<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>The Other 4x4x4 (aka Puzzle 19)</Name>
        <Menu>Other forms\Sphere\Cubic axes\The Other 4x4x4 (aka Puzzle 19)</Menu>
        <Inventor>Carl N. Hoff</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6808</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00';
        Colors[1] := 'AA00AA';
        Colors[2] := '0066FF';
        Colors[3] := '00DD00';
        Colors[4] := 'FF8800';
        Colors[5] := 'FF0000';

        W := 0.54;
        K := W * 1.1; // size of sphere

        D1 := W * 0.25;
        D2 := 2 * D1;

        HP := W * 0.06; // small parts
        WP := W * 0.1;

        W2 := D2 - HP; // Size of inner cube

        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Super" >
            <HideAll/>
            <LoadFrom File = "Figures\Cuboid.xml" WX = "DCut2" WY = "WE" WZ = "WE" />
            <LoadFrom File = "Figures\Cuboid.xml" WX = "WE" WY = "DCut2" WZ = "WE" />
            <LoadFrom File = "Figures\Cuboid.xml" WX = "WE" WY = "WE" WZ = "DCut2" />
            <Split> <Plane NormVector = " 1; 0; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = "-1; 0; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0; 1; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0;-1; 0" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0; 0; 1" NormDistance = "DCut1" /> </Split>
            <Split> <Plane NormVector = " 0; 0;-1" NormDistance = "DCut1" /> </Split>
            <RemoveContaining Vector = " 0; 0; 0" />
            <ShowAll/>
        </Macro>

        <Macro Name = "RemoveCenters">
            <RemoveContaining Vector = "Cx[i]; Cy[i]; Cz[i]" />
            <Script>Inc(i);</Script>
        </Macro>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />

        <ExecMacro MacroName = "RemoveCenters" i = "0" Repeat = "6" />
        <RemoveGrayParts/>

        <LoadFrom File = "Figures\Cuboid.xml" WX = "W2" WY = "W2" WZ = "W2" />
        <SplitByAxes/>

        <ExecMacro MacroName = "Super" WE = "D2" DCut1 = "sqrt(K^2 - 2 * D2^2) * 0.99" DCut2 = "W" />
        <SplitByAxes/>
        <ExecMacro MacroName = "RemoveCenters" i = "0" Repeat = "6" />

        <ExecMacro MacroName = "Super" WE = "WP" DCut1 = "W - HP" DCut2 = "W" />
        <ExecMacro MacroName = "Super" WE = "WP" DCut1 = "D2 - HP" DCut2 = "D2" />

        <Connect Layers = "1;3" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
