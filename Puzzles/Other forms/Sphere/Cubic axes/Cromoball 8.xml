<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cromoball 8</Name>
        <Menu>Other forms\Sphere\Cubic axes\Cromoball 8</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-02-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=561</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';

        K := 0.6;

        D := K * 0.25;
        D1 := K * 0.685;
    </Script>

    <Axes TurningAngles = "Pi/2; 0; Pi/6; 0; Pi/2" PlaneDistances = "-D1;-D; D; D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "RemoveEdges" >
            <RemoveContaining Vector = "Ex[Id]*L; Ey[Id]*L; Ez[Id]*L" />
            <Script> Inc(Id); </Script>
        </Macro>
        <Macro Name = "RemoveCenters" >
            <RemoveContaining Vector = "Cx[Id]*L; Cy[Id]*L; Cz[Id]*L" />
            <Script> Inc(Id); </Script>
        </Macro>
        <Macro Name = "AddPiece" >
            <Part>
                <Vertices>
                    <Add Vector = " 0     ;-0.603 ; 0     " />
                    <Add Vector = " 0     ;-0.591 ; 0.12  " />
                    <Add Vector = " 0     ;-0.591 ;-0.12  " />
                    <Add Vector = " 0.12  ;-0.591 ; 0     " />
                    <Add Vector = "-0.12  ;-0.591 ; 0     " />
                    <Add Vector = " 0.12  ;-0.579 ; 0.12  " />
                    <Add Vector = " 0.12  ;-0.579 ;-0.12  " />
                    <Add Vector = "-0.12  ;-0.579 ; 0.12  " />
                    <Add Vector = "-0.12  ;-0.579 ;-0.12  " />
                    <Add Vector = "-0.144 ;-0.569 ;-0.12  " />
                    <Add Vector = "-0.134 ;-0.585 ; 0     " />
                    <Add Vector = "-0.144 ;-0.569 ; 0.12  " />
                    <Add Vector = " 0.134 ;-0.585 ; 0     " />
                    <Add Vector = " 0.144 ;-0.569 ;-0.12  " />
                    <Add Vector = " 0.144 ;-0.569 ; 0.12  " />
                    <Add Vector = " 0.1498;-0.561 ;-0.1498" />
                    <Add Vector = "-0.1498;-0.561 ;-0.1498" />
                    <Add Vector = " 0     ;-0.585 ;-0.134 " />
                    <Add Vector = "-0.12  ;-0.569 ;-0.144 " />
                    <Add Vector = " 0.12  ;-0.569 ;-0.144 " />
                    <Add Vector = " 0.1498;-0.561 ; 0.1498" />
                    <Add Vector = "-0.1498;-0.561 ; 0.1498" />
                    <Add Vector = "-0.12  ;-0.569 ; 0.144 " />
                    <Add Vector = " 0     ;-0.585 ; 0.134 " />
                    <Add Vector = " 0.12  ;-0.569 ; 0.144 " />
                    <Add Vector = " 0     ;-0.500 ; 0     " />
                </Vertices>

                <Faces>
                    <Face Color = "Colors[c1]" VertexIndexes = " 5;20;24" InvisibleEdges = " 5" />
                    <Face Color = "Colors[c1]" VertexIndexes = "20; 5;14" InvisibleEdges = " 3" />
                    <Face Color = "Colors[c0]" VertexIndexes = " 6;15;13" InvisibleEdges = " 5" />
                    <Face Color = "Colors[c0]" VertexIndexes = "15; 6;19" InvisibleEdges = " 3" />
                    <Face Color = "Colors[c3]" VertexIndexes = " 7;21;11" InvisibleEdges = " 5" />
                    <Face Color = "Colors[c3]" VertexIndexes = "21; 7;22" InvisibleEdges = " 3" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 8;16;18" InvisibleEdges = " 5" />
                    <Face Color = "Colors[c2]" VertexIndexes = "16; 8; 9" InvisibleEdges = " 3" />

                    <Face Color = "Colors[c3]" VertexIndexes = " 0; 1; 7; 4" InvisibleEdges = "15" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 0; 4; 8; 2" InvisibleEdges = "15" />
                    <Face Color = "Colors[c0]" VertexIndexes = " 0; 2; 6; 3" InvisibleEdges = "15" />
                    <Face Color = "Colors[c1]" VertexIndexes = " 0; 3; 5; 1" InvisibleEdges = "15" />

                    <Face Color = "Colors[c1]" VertexIndexes = "23; 5;24" InvisibleEdges = "3" />
                    <Face Color = "Colors[c1]" VertexIndexes = " 5;23; 1" InvisibleEdges = "7" />
                    <Face Color = "Colors[c2]" VertexIndexes = "17; 8;18" InvisibleEdges = "3" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 8;17; 2" InvisibleEdges = "7" />
                    <Face Color = "Colors[c0]" VertexIndexes = "12; 6;13" InvisibleEdges = "3" />
                    <Face Color = "Colors[c0]" VertexIndexes = " 6;12; 3" InvisibleEdges = "7" />
                    <Face Color = "Colors[c3]" VertexIndexes = "10; 7;11" InvisibleEdges = "3" />
                    <Face Color = "Colors[c3]" VertexIndexes = " 7;10; 4" InvisibleEdges = "7" />

                    <Face Color = "Colors[c0]" VertexIndexes = " 6;17;19" InvisibleEdges = "5" />
                    <Face Color = "Colors[c0]" VertexIndexes = "17; 6; 2" InvisibleEdges = "7" />
                    <Face Color = "Colors[c3]" VertexIndexes = " 7;23;22" InvisibleEdges = "5" />
                    <Face Color = "Colors[c3]" VertexIndexes = "23; 7; 1" InvisibleEdges = "7" />
                    <Face Color = "Colors[c1]" VertexIndexes = " 5;12;14" InvisibleEdges = "5" />
                    <Face Color = "Colors[c1]" VertexIndexes = "12; 5; 3" InvisibleEdges = "7" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 8;10; 9" InvisibleEdges = "5" />
                    <Face Color = "Colors[c2]" VertexIndexes = "10; 8; 4" InvisibleEdges = "7" />

                    <Face VertexIndexes = "16; 9;10;11;21" />
                    <Face VertexIndexes = "20;14;12;13;15" />
                    <Face VertexIndexes = "19;17;18;16;15" />
                    <Face VertexIndexes = "20;21;22;23;24" />
                    <Face VertexIndexes = "21;25;16" />
                    <Face VertexIndexes = "15;25;20" />
                    <Face VertexIndexes = "20;25;21" />
                    <Face VertexIndexes = "16;25;15" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "AddSegment" >
            <Script>Color := Colors[c];</Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Cut>
            <HideAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        </Macro>
        <ExecMacro MacroName = "AddSegment" c = "0" />
        <ExecMacro MacroName = "AddSegment" c = "1" />
        <ExecMacro MacroName = "AddSegment" c = "5" />
        <ExecMacro MacroName = "AddSegment" c = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddSegment" c = "7" />
        <ExecMacro MacroName = "AddSegment" c = "6" />
        <ExecMacro MacroName = "AddSegment" c = "2" />
        <ExecMacro MacroName = "AddSegment" c = "3" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ShowAll/>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <RemoveGrayParts/>

        <ExecMacro MacroName = "RemoveEdges" Id = "0" Repeat = "12" L = "D1" />
        <ExecMacro MacroName = "RemoveCenters" Id = "0" Repeat = "6" L = "0.9 * k" />

        <Macro Name = "MovePiece" >
            <Turn NormVector = "0;0;1" Angle = "-Pi/6*x" />
            <Turn NormVector = "1;0;0" Angle = " Pi/6*y" />
            <ExecMacro MacroName = "AddPiece" />
            <Turn NormVector = "1;0;0" Angle = "-Pi/6*y" />
            <Turn NormVector = "0;0;1" Angle = " Pi/6*x" />
        </Macro>
        <Macro Name = "FillSide" >
            <ExecMacro MacroName = "MovePiece" x = " 0" y = " 0" c0 = "cc0" c1 = "cc1" c2 = "cc2" c3 = "cc3" />
            <ExecMacro MacroName = "MovePiece" x = " 1" y = " 0" c0 = "cc0" c1 = "cc1" c2 = "cc0" c3 = "cc1" />
            <ExecMacro MacroName = "MovePiece" x = "-1" y = " 0" c0 = "cc2" c1 = "cc3" c2 = "cc2" c3 = "cc3" />
            <ExecMacro MacroName = "MovePiece" x = " 0" y = " 1" c0 = "cc1" c1 = "cc1" c2 = "cc3" c3 = "cc3" />
            <ExecMacro MacroName = "MovePiece" x = " 0" y = "-1" c0 = "cc0" c1 = "cc0" c2 = "cc2" c3 = "cc2" />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        </Macro>

        <ExecMacro MacroName = "FillSide" cc0 = "6" cc1 = "5" cc2 = "7" cc3 = "4" />
        <ExecMacro MacroName = "FillSide" cc0 = "4" cc1 = "0" cc2 = "7" cc3 = "3" />
        <ExecMacro MacroName = "FillSide" cc0 = "3" cc1 = "2" cc2 = "7" cc3 = "6" />
        <Turn NormVector = "-1; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "FillSide" cc0 = "5" cc1 = "6" cc2 = "1" cc3 = "2" />
        <ExecMacro MacroName = "FillSide" cc0 = "2" cc1 = "3" cc2 = "1" cc3 = "0" />
        <ExecMacro MacroName = "FillSide" cc0 = "0" cc1 = "4" cc2 = "1" cc3 = "5" />
        <Turn NormVector = "-1; 1; 0" Angle = "Pi" />

        <SplitByAxes/>
        <SaveSolvedState/>

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
