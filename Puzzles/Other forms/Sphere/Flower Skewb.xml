<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Flower Skewb</Name>
        <Menu>Other forms\Sphere\Flower Skewb</Menu>
        <Inventor>chewbacca</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-03</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=4&amp;t=35764</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF6600'; // clOrange
        Colors[2] := '0066FF'; // clBlue
        Colors[3] := '00DD00'; // clGreen
        Colors[4] := 'FFEE00'; // clYellow
        Colors[5] := 'AA00AA'; // clViolett

        include 'Figures\Scripts\Cube_Coordinates.inc';

        K := 0.6;
        DC := K * 0.82027;
        DE := K * 0.88;
        fE := K / sqrt(2);
        fV := K /  sqrt(3);
        DCutE := K * 0.67;
        DCutV := K * 0.67;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-DC;0;DC" TurnAxesWithLayer = "1" >

    <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-DE; DE" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />

        <Split><Plane NormVector = "-1;-1;-1" NormDistance = " DC" /></Split>
        <Split><Plane NormVector = "-1;-1; 1" NormDistance = " DC" /></Split>
        <Split><Plane NormVector = "-1; 1;-1" NormDistance = " DC" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = " DC" /></Split>
        <Split><Plane NormVector = "-1;-1;-1" NormDistance = "-DC" /></Split>
        <Split><Plane NormVector = "-1;-1; 1" NormDistance = "-DC" /></Split>
        <Split><Plane NormVector = "-1; 1;-1" NormDistance = "-DC" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = "-DC" /></Split>

        <Split Axis = "4" From = "1" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "6" From = "1" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "8" From = "1" />
        <Split Axis = "9" From = "1" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "7" From = "2" />
        <Split Axis = "8" From = "2" />
        <Split Axis = "9" From = "2" />

        <Macro Name = "CutEdge" >
            <HideContaining Vector = "fE; 0; fE" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = " 1; 0;-2" NormDistance = "-DCutE" /> </Cut>
            <Cut> <Plane NormVector = "-2; 0; 1" NormDistance = "-DCutE" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        <ExecMacro MacroName = "CutEdge" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

        <Macro Name = "CutVertex" >
            <HideContaining Vector = "fV; fV; fV" />
            <InvertVisibility/>
            <Cut> <Plane NormVector = "-3; 1; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1;-3; 1" NormDistance = "-DCutV" /> </Cut>
            <Cut> <Plane NormVector = " 1; 1;-3" NormDistance = "-DCutV" /> </Cut>
            <ShowAll/>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutVertex" Repeat = "4" />
        <Turn NormVector = "1;1;0" Angle = "Pi" />

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
