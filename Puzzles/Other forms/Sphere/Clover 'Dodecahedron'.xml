    <Script>
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        C0 := (3 + sqrt(5)) / 2;
        C1 := (1 + sqrt(5));
        C2 := (2 + sqrt(5));
        C3 := (3 + sqrt(5));
        C4 := (5 + 3 * sqrt(5)) / 2;
        C5 := 1;

        K := 0.6;
        D := 0.58;

        A1 := ArcCos((  3 + 3 * sqrt(5))/20 );
        A2 := ArcCos((-15 -     sqrt(5))/20 );
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2;0;A2;A1" PlaneDistances = "-D;D" FixedLayers = "1" >
        <Axis NormVector = "  0; C5; C4" />
