<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triakis Octahedron Alternate Coloring (DaYan Gem 6)</Name>
        <Menu>Other forms\Catalan Truncated Solids\8-Truncated Triakis Octahedron\Triakis Octahedron AC (DaYan Gem 6 AC)</Menu>
        <Menu>Other forms\DaYan\DaYan Gem 6 AC</Menu>
        <Inventor>Bo Hu</Inventor>
        <Programmer>Evgeniy Grigoriev, Skallos</Programmer>
        <Added>2018-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4961</Link>
    </Interface>

    <Script>
        clWhite     := 'F0F0F0';
        clBlue      := '0000FF';
        clRed       := 'FF0000';
        clYellow    := 'FFFF00';
        clOrange    := 'FF6000';
        clGreen     := '008000';

        clSilver    := 'A0A0A0';
        clCyan      := '00FFFF';
        clNavy      := '000080';
        clCoral     := 'FF7F50';
        clBrown     := '800000';
        clGolden    := 'DDBB20';
        clLime      := '00FF00';
        clDarkGreen := '006400';
        clPink      := 'FF69B4';
        clPurple    := '800080';
        clChocolate := 'C26519';
        clIndigo    := '4B0082';

        K  := 0.13;
        C0 := K * sqrt(2 + sqrt(2));
        C1 := K * sqrt(2 * (2 + sqrt(2)));
        C2 := K * (2 - sqrt(2) + 2 * sqrt(2 * (2 - sqrt(2))));
        C3 := K * (sqrt(2) + sqrt(2 * (2 + sqrt(2))));

        D1 := K * (6 - sqrt(2) + 2 * sqrt(52 + 14 * sqrt(2))) / 17;
        D2 := D1 * (sqrt(2) + 1);
    </Script>

    <Axes TurningAngles = "Pi/4; Pi/2; 0; Pi/2; Pi/4" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "   1;   0;   0" />
        <Axis NormVector = "   0;   1;   0" />
        <Axis NormVector = "   0;   0;   1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;   0;  C3" />
                <Add Vector = " C1;   0; -C3" />
                <Add Vector = "-C1;   0;  C3" />
                <Add Vector = "-C1;   0; -C3" />
                <Add Vector = " C3;  C1;   0" />
                <Add Vector = " C3; -C1;   0" />
                <Add Vector = "-C3;  C1;   0" />
                <Add Vector = "-C3; -C1;   0" />
                <Add Vector = "  0;  C3;  C1" />
                <Add Vector = "  0;  C3; -C1" />
                <Add Vector = "  0; -C3;  C1" />
                <Add Vector = "  0; -C3; -C1" />
                <Add Vector = "  0;  C1;  C3" />
                <Add Vector = "  0;  C1; -C3" />
                <Add Vector = "  0; -C1;  C3" />
                <Add Vector = "  0; -C1; -C3" />
                <Add Vector = " C3;   0;  C1" />
                <Add Vector = " C3;   0; -C1" />
                <Add Vector = "-C3;   0;  C1" />
                <Add Vector = "-C3;   0; -C1" />
                <Add Vector = " C1;  C3;   0" />
                <Add Vector = " C1; -C3;   0" />
                <Add Vector = "-C1;  C3;   0" />
                <Add Vector = "-C1; -C3;   0" />
                <Add Vector = " C0;  C0;  C3" />
                <Add Vector = " C0;  C0; -C3" />
                <Add Vector = " C0; -C0;  C3" />
                <Add Vector = " C0; -C0; -C3" />
                <Add Vector = "-C0;  C0;  C3" />
                <Add Vector = "-C0;  C0; -C3" />
                <Add Vector = "-C0; -C0;  C3" />
                <Add Vector = "-C0; -C0; -C3" />
                <Add Vector = " C3;  C0;  C0" />
                <Add Vector = " C3;  C0; -C0" />
                <Add Vector = " C3; -C0;  C0" />
                <Add Vector = " C3; -C0; -C0" />
                <Add Vector = "-C3;  C0;  C0" />
                <Add Vector = "-C3;  C0; -C0" />
                <Add Vector = "-C3; -C0;  C0" />
                <Add Vector = "-C3; -C0; -C0" />
                <Add Vector = " C0;  C3;  C0" />
                <Add Vector = " C0;  C3; -C0" />
                <Add Vector = " C0; -C3;  C0" />
                <Add Vector = " C0; -C3; -C0" />
                <Add Vector = "-C0;  C3;  C0" />
                <Add Vector = "-C0;  C3; -C0" />
                <Add Vector = "-C0; -C3;  C0" />
                <Add Vector = "-C0; -C3; -C0" />
                <Add Vector = " C2;  C2;  C2" />
                <Add Vector = " C2;  C2; -C2" />
                <Add Vector = " C2; -C2;  C2" />
                <Add Vector = " C2; -C2; -C2" />
                <Add Vector = "-C2;  C2;  C2" />
                <Add Vector = "-C2;  C2; -C2" />
                <Add Vector = "-C2; -C2;  C2" />
                <Add Vector = "-C2; -C2; -C2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite    " VertexIndexes = "  0; 24; 12; 28;  2; 30; 14; 26 " />
                <Face Color = "clYellow   " VertexIndexes = "  1; 27; 15; 31;  3; 29; 13; 25 " />
                <Face Color = "clRed      " VertexIndexes = "  4; 32; 16; 34;  5; 35; 17; 33 " />
                <Face Color = "clOrange   " VertexIndexes = "  6; 37; 19; 39;  7; 38; 18; 36 " />
                <Face Color = "clGreen    " VertexIndexes = "  8; 40; 20; 41;  9; 45; 22; 44 " />
                <Face Color = "clBlue     " VertexIndexes = " 10; 46; 23; 47; 11; 43; 21; 42 " />

                <Face Color = "clPink     " VertexIndexes = " 48; 24;  0; 16; 32 " />
                <Face Color = "clPurple   " VertexIndexes = " 48; 32;  4; 20; 40 " />
                <Face Color = "clIndigo   " VertexIndexes = " 48; 40;  8; 12; 24 " />

                <Face Color = "clBrown    " VertexIndexes = " 49; 25; 13;  9; 41 " />
                <Face Color = "clSilver   " VertexIndexes = " 49; 41; 20;  4; 33 " />
                <Face Color = "clCoral    " VertexIndexes = " 49; 33; 17;  1; 25 " />

                <Face Color = "clBrown    " VertexIndexes = " 50; 26; 14; 10; 42 " />
                <Face Color = "clChocolate" VertexIndexes = " 50; 42; 21;  5; 34 " />
                <Face Color = "clDarkGreen" VertexIndexes = " 50; 34; 16;  0; 26 " />

                <Face Color = "clNavy     " VertexIndexes = " 51; 27;  1; 17; 35 " />
                <Face Color = "clCyan     " VertexIndexes = " 51; 35;  5; 21; 43 " />
                <Face Color = "clIndigo   " VertexIndexes = " 51; 43; 11; 15; 27 " />

                <Face Color = "clGolden   " VertexIndexes = " 52; 28; 12;  8; 44 " />
                <Face Color = "clChocolate" VertexIndexes = " 52; 44; 22;  6; 36 " />
                <Face Color = "clCoral    " VertexIndexes = " 52; 36; 18;  2; 28 " />

                <Face Color = "clPink     " VertexIndexes = " 53; 29;  3; 19; 37 " />
                <Face Color = "clCyan     " VertexIndexes = " 53; 37;  6; 22; 45 " />
                <Face Color = "clLime     " VertexIndexes = " 53; 45;  9; 13; 29 " />

                <Face Color = "clNavy     " VertexIndexes = " 54; 30;  2; 18; 38 " />
                <Face Color = "clPurple   " VertexIndexes = " 54; 38;  7; 23; 46 " />
                <Face Color = "clLime     " VertexIndexes = " 54; 46; 10; 14; 30 " />

                <Face Color = "clGolden   " VertexIndexes = " 55; 31; 15; 11; 47 " />
                <Face Color = "clSilver   " VertexIndexes = " 55; 47; 23;  7; 39 " />
                <Face Color = "clDarkGreen" VertexIndexes = " 55; 39; 19;  3; 31 " />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "0" Layer = "0" Angle = " Pi/4" />
        <Turn Axis = "0" Layer = "4" Angle = " Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "4" Angle = "-Pi/4" />
        <Turn Axis = "0" Layer = "0" Angle = "-Pi/4" />

        <Turn Axis = "1" Layer = "0" Angle = " Pi/4" />
        <Turn Axis = "1" Layer = "4" Angle = " Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "4" Angle = "-Pi/4" />
        <Turn Axis = "1" Layer = "0" Angle = "-Pi/4" />

        <Turn Axis = "2" Layer = "0" Angle = " Pi/4" />
        <Turn Axis = "2" Layer = "4" Angle = " Pi/4" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "4" Angle = "-Pi/4" />
        <Turn Axis = "2" Layer = "0" Angle = "-Pi/4" />
    </Figure>

    <Procedures CheckSolved = "EachPlaneHasOneColor" />

</xml>
