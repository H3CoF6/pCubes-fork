<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>30-Axis Wisdom Wheel AC</Name>
        <Menu>Other forms\Catalan Truncated Solids\8-Truncated Triakis Octahedron\30-Axis Wisdom Wheel AC</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7654</Link>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clBlue        := '0000FF';
        clRed         := 'FF0000';
        clYellow      := 'FFFF00';
        clOrange      := 'FF6000';
        clGreen       := '008000';

        clSilver      := 'A0A0A0';
        clGray        := '707070';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clTeal        := '008080';
        clNavy        := '000080';

        clCoral       := 'FF7F50';
        clIndian      := 'CD5C5C';
        clBrown       := '800000';

        clKhaki       := 'F0E68C';
        clGolden      := 'DDBB20';
        clOlive       := '808000';

        clGreenYellow := 'ADFF2F';
        clLime        := '00FF00';
        clDarkGreen   := '006400';

        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clPurple      := '800080';

        clChocolate   := 'C26519';
        clPeru        := 'CD853F';
        clSandyBrown  := 'F4A460';

        clIndigo      := '4B0082';
        clDarkSlate   := '483D8B';
        clSlate       := '6A5ACD';

        K  := 0.13;

        R := K * 3.0346;

        s2 := sqrt(2);
        C0 := K * sqrt(2 + s2);
        C1 := K * sqrt(2 * (2 + s2));
        C2 := K * (2 - s2 + 2 * sqrt(2 * (2 - s2)));
        C3 := K * (s2 + sqrt(2 * (2 + s2)));

        A1 := ArcCos((-1 + 2 * s2) / 4 );
        A2 := ArcCos(-(2 + s2) / 4); // A1 + 2 * A2 = 2 * Pi

        B0 := 1 + s2;
        B1 := 1;

        D1 := K * 3.35;
        DR := D1 * 1.115;
        D2 := K * 4.2;
    </Script>

    <Axes TurningAngles = "Pi/4; 0; Pi/4" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

     <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2;0;A2;A1" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " B0; B1; B0" />
        <Axis NormVector = " B0; B1;-B0" />
        <Axis NormVector = " B0;-B1; B0" />
        <Axis NormVector = " B0;-B1;-B0" />
        <Axis NormVector = " B0; B0; B1" />
        <Axis NormVector = " B0; B0;-B1" />
        <Axis NormVector = " B0;-B0; B1" />
        <Axis NormVector = " B0;-B0;-B1" />
        <Axis NormVector = " B1; B0; B0" />
        <Axis NormVector = " B1; B0;-B0" />
        <Axis NormVector = " B1;-B0; B0" />
        <Axis NormVector = " B1;-B0;-B0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;  0; C3" />
                <Add Vector = " C1;  0;-C3" />
                <Add Vector = "-C1;  0; C3" />
                <Add Vector = "-C1;  0;-C3" />
                <Add Vector = " C3; C1;  0" />
                <Add Vector = " C3;-C1;  0" />
                <Add Vector = "-C3; C1;  0" />
                <Add Vector = "-C3;-C1;  0" />
                <Add Vector = "  0; C3; C1" />
                <Add Vector = "  0; C3;-C1" />
                <Add Vector = "  0;-C3; C1" />
                <Add Vector = "  0;-C3;-C1" />
                <Add Vector = "  0; C1; C3" />
                <Add Vector = "  0; C1;-C3" />
                <Add Vector = "  0;-C1; C3" />
                <Add Vector = "  0;-C1;-C3" />
                <Add Vector = " C3;  0; C1" />
                <Add Vector = " C3;  0;-C1" />
                <Add Vector = "-C3;  0; C1" />
                <Add Vector = "-C3;  0;-C1" />
                <Add Vector = " C1; C3;  0" />
                <Add Vector = " C1;-C3;  0" />
                <Add Vector = "-C1; C3;  0" />
                <Add Vector = "-C1;-C3;  0" />
                <Add Vector = " C0; C0; C3" />
                <Add Vector = " C0; C0;-C3" />
                <Add Vector = " C0;-C0; C3" />
                <Add Vector = " C0;-C0;-C3" />
                <Add Vector = "-C0; C0; C3" />
                <Add Vector = "-C0; C0;-C3" />
                <Add Vector = "-C0;-C0; C3" />
                <Add Vector = "-C0;-C0;-C3" />
                <Add Vector = " C3; C0; C0" />
                <Add Vector = " C3; C0;-C0" />
                <Add Vector = " C3;-C0; C0" />
                <Add Vector = " C3;-C0;-C0" />
                <Add Vector = "-C3; C0; C0" />
                <Add Vector = "-C3; C0;-C0" />
                <Add Vector = "-C3;-C0; C0" />
                <Add Vector = "-C3;-C0;-C0" />
                <Add Vector = " C0; C3; C0" />
                <Add Vector = " C0; C3;-C0" />
                <Add Vector = " C0;-C3; C0" />
                <Add Vector = " C0;-C3;-C0" />
                <Add Vector = "-C0; C3; C0" />
                <Add Vector = "-C0; C3;-C0" />
                <Add Vector = "-C0;-C3; C0" />
                <Add Vector = "-C0;-C3;-C0" />
                <Add Vector = " C2; C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2;-C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2; C2;-C2" />
                <Add Vector = "-C2;-C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite      " VertexIndexes = " 0;24;12;28; 2;30;14;26" />
                <Face Color = "clYellow     " VertexIndexes = " 1;27;15;31; 3;29;13;25" />
                <Face Color = "clRed        " VertexIndexes = " 4;32;16;34; 5;35;17;33" />
                <Face Color = "clOrange     " VertexIndexes = " 6;37;19;39; 7;38;18;36" />
                <Face Color = "clGreen      " VertexIndexes = " 8;40;20;41; 9;45;22;44" />
                <Face Color = "clBlue       " VertexIndexes = "10;46;23;47;11;43;21;42" />

                <Face Color = "clBrown      " VertexIndexes = "48;24; 0;16;32" />
                <Face Color = "clCoral      " VertexIndexes = "48;32; 4;20;40" />
                <Face Color = "clIndian     " VertexIndexes = "48;40; 8;12;24" />

                <Face Color = "clSilver     " VertexIndexes = "49;25;13; 9;41" />
                <Face Color = "clGray       " VertexIndexes = "49;41;20; 4;33" />
                <Face Color = "clBlack      " VertexIndexes = "49;33;17; 1;25" />

                <Face Color = "clCyan       " VertexIndexes = "50;26;14;10;42" />
                <Face Color = "clTeal       " VertexIndexes = "50;42;21; 5;34" />
                <Face Color = "clNavy       " VertexIndexes = "50;34;16; 0;26" />

                <Face Color = "clLime       " VertexIndexes = "51;27; 1;17;35" />
                <Face Color = "clGreenYellow" VertexIndexes = "51;35; 5;21;43" />
                <Face Color = "clDarkGreen  " VertexIndexes = "51;43;11;15;27" />

                <Face Color = "clIndigo     " VertexIndexes = "52;28;12; 8;44" />
                <Face Color = "clDarkSlate  " VertexIndexes = "52;44;22; 6;36" />
                <Face Color = "clSlate      " VertexIndexes = "52;36;18; 2;28" />

                <Face Color = "clSandyBrown " VertexIndexes = "53;29; 3;19;37" />
                <Face Color = "clPeru       " VertexIndexes = "53;37; 6;22;45" />
                <Face Color = "clChocolate  " VertexIndexes = "53;45; 9;13;29" />

                <Face Color = "clOlive      " VertexIndexes = "54;30; 2;18;38" />
                <Face Color = "clKhaki      " VertexIndexes = "54;38; 7;23;46" />
                <Face Color = "clGolden     " VertexIndexes = "54;46;10;14;30" />

                <Face Color = "clFuchsia    " VertexIndexes = "55;31;15;11;47" />
                <Face Color = "clPurple     " VertexIndexes = "55;47;23; 7;39" />
                <Face Color = "clPink       " VertexIndexes = "55;39;19; 3;31" />
            </Faces>
        </Part>

        <Cut><Plane NormVector = " 1; 0; 0" NormDistance = "-D1" /></Cut>
        <Cut><Plane NormVector = " 0; 1; 0" NormDistance = "-D1" /></Cut>
        <Cut><Plane NormVector = " 0; 0; 1" NormDistance = "-D1" /></Cut>
        <Cut><Plane NormVector = "-1; 0; 0" NormDistance = "-D1" /></Cut>
        <Cut><Plane NormVector = " 0;-1; 0" NormDistance = "-D1" /></Cut>
        <Cut><Plane NormVector = " 0; 0;-1" NormDistance = "-D1" /></Cut>

        <Cylinder Radius = "R" Color = "clRed" >
            <Base X = "D1" Y = "0" Z = "0" />
            <Top  X = "DR" Y = "0" Z = "0" Color = "clRed" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "-D1" Y = "0" Z = "0" />
            <Top  X = "-DR" Y = "0" Z = "0" Color = "clOrange" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clGreen" >
            <Base X = "0" Y = "D1" Z = "0" />
            <Top  X = "0" Y = "DR" Z = "0" Color = "clGreen" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clBlue" >
            <Base X = "0" Y = "-D1" Z = "0" />
            <Top  X = "0" Y = "-DR" Z = "0" Color = "clBlue" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clWhite" >
            <Base X = "0" Y = "0" Z = "D1" />
            <Top  X = "0" Y = "0" Z = "DR" Color = "clWhite" />
        </Cylinder>

        <Cylinder Radius = "R" Color = "clYellow" >
            <Base X = "0" Y = "0" Z = "-D1" />
            <Top  X = "0" Y = "0" Z = "-DR" Color = "clYellow" />
        </Cylinder>

        <SplitByAxes/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(3)" Layer = "0" Angle = "Pi/4 * Random(8)"/>
            <Turn Axis = "Random(3)" Layer = "2" Angle = "Pi/4 * Random(8)"/>
        </Macro>
        <Macro Name = "Sc2" >
            <Script>Ax := Random(12) + 3;</Script>
            <Turn Axis = "Ax" Layer = "0" Angle = "A2"/>
            <Turn Axis = "Ax" Layer = "2" Angle = "A2"/>
            <ExecMacro MacroName = "Sc1" Repeat = "10" />
            <Turn Axis = "Ax" Layer = "2" Angle = "-2*A2"/>
            <Turn Axis = "Ax" Layer = "0" Angle = "-2*A2"/>
            <ExecMacro MacroName = "Sc1" Repeat = "10" />
            <Turn Axis = "Ax" Layer = "0" Angle = "A2"/>
            <Turn Axis = "Ax" Layer = "2" Angle = "A2"/>
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(15)" Layer = "Random(2) * 2" Angle = "2 * Pi * Random"/>
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>A2 := ArcCos(-(2 + sqrt(2)) / 4); </Script>
            <ExecMacro MacroName = "Sc2" Repeat = "40" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "100" />
        </Macro>
    </Macros>
</xml>
