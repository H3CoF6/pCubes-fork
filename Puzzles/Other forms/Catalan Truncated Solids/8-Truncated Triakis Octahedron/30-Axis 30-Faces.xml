<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>30-Axis 30-Faces</Name>
        <Menu>Other forms\Catalan Truncated Solids\8-Truncated Triakis Octahedron\30-Axis 30-Faces</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7653</Link>
    </Interface>

    <Script>
        clWhite  := 'FFFFFF';
        clBlue   := '0033FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF7700';
        clGreen  := '00BB00';

        K  := 0.13;

        s2 := sqrt(2);
        C0 := K * sqrt(2 + s2);
        C1 := K * sqrt(2 * (2 + s2));
        C2 := K * (2 - s2 + 2 * sqrt(2 * (2 - s2)));
        C3 := K * (s2 + sqrt(2 * (2 + s2)));

        A1 := ArcCos((-1 + 2 * s2) / 4);
        A2 := ArcCos(-(2 + s2) / 4); // A1 + 2 * A2 = 2 * Pi

        B0 := 1 + s2;
        B1 := 1;

        D1 := K * 3.5;
        D2 := K * 4.13;
     </Script>

    <Axes TurningAngles = "Pi/4; 0; Pi/4" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

     <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " B0; B1; B0" />
        <Axis NormVector = " B0; B1;-B0" />
        <Axis NormVector = " B0;-B1; B0" />
        <Axis NormVector = " B0;-B1;-B0" />
        <Axis NormVector = " B0; B0; B1" />
        <Axis NormVector = " B0; B0;-B1" />
        <Axis NormVector = " B0;-B0; B1" />
        <Axis NormVector = " B0;-B0;-B1" />
        <Axis NormVector = " B1; B0; B0" />
        <Axis NormVector = " B1; B0;-B0" />
        <Axis NormVector = " B1;-B0; B0" />
        <Axis NormVector = " B1;-B0;-B0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;  0; C3" />
                <Add Vector = " C1;  0;-C3" />
                <Add Vector = "-C1;  0; C3" />
                <Add Vector = "-C1;  0;-C3" />
                <Add Vector = " C3; C1;  0" />
                <Add Vector = " C3;-C1;  0" />
                <Add Vector = "-C3; C1;  0" />
                <Add Vector = "-C3;-C1;  0" />
                <Add Vector = "  0; C3; C1" />
                <Add Vector = "  0; C3;-C1" />
                <Add Vector = "  0;-C3; C1" />
                <Add Vector = "  0;-C3;-C1" />
                <Add Vector = "  0; C1; C3" />
                <Add Vector = "  0; C1;-C3" />
                <Add Vector = "  0;-C1; C3" />
                <Add Vector = "  0;-C1;-C3" />
                <Add Vector = " C3;  0; C1" />
                <Add Vector = " C3;  0;-C1" />
                <Add Vector = "-C3;  0; C1" />
                <Add Vector = "-C3;  0;-C1" />
                <Add Vector = " C1; C3;  0" />
                <Add Vector = " C1;-C3;  0" />
                <Add Vector = "-C1; C3;  0" />
                <Add Vector = "-C1;-C3;  0" />
                <Add Vector = " C0; C0; C3" />
                <Add Vector = " C0; C0;-C3" />
                <Add Vector = " C0;-C0; C3" />
                <Add Vector = " C0;-C0;-C3" />
                <Add Vector = "-C0; C0; C3" />
                <Add Vector = "-C0; C0;-C3" />
                <Add Vector = "-C0;-C0; C3" />
                <Add Vector = "-C0;-C0;-C3" />
                <Add Vector = " C3; C0; C0" />
                <Add Vector = " C3; C0;-C0" />
                <Add Vector = " C3;-C0; C0" />
                <Add Vector = " C3;-C0;-C0" />
                <Add Vector = "-C3; C0; C0" />
                <Add Vector = "-C3; C0;-C0" />
                <Add Vector = "-C3;-C0; C0" />
                <Add Vector = "-C3;-C0;-C0" />
                <Add Vector = " C0; C3; C0" />
                <Add Vector = " C0; C3;-C0" />
                <Add Vector = " C0;-C3; C0" />
                <Add Vector = " C0;-C3;-C0" />
                <Add Vector = "-C0; C3; C0" />
                <Add Vector = "-C0; C3;-C0" />
                <Add Vector = "-C0;-C3; C0" />
                <Add Vector = "-C0;-C3;-C0" />
                <Add Vector = " C2; C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2;-C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2; C2;-C2" />
                <Add Vector = "-C2;-C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = " 0;24;12;28; 2;30;14;26" />
                <Face Color = "clYellow" VertexIndexes = " 1;27;15;31; 3;29;13;25" />
                <Face Color = "clOrange" VertexIndexes = " 4;32;16;34; 5;35;17;33" />
                <Face Color = "clRed   " VertexIndexes = " 6;37;19;39; 7;38;18;36" />
                <Face Color = "clGreen " VertexIndexes = " 8;40;20;41; 9;45;22;44" />
                <Face Color = "clBlue  " VertexIndexes = "10;46;23;47;11;43;21;42" />

                <Face Color = "clGreen " VertexIndexes = "48;24; 0;16;32" />
                <Face Color = "clWhite " VertexIndexes = "48;32; 4;20;40" />
                <Face Color = "clOrange" VertexIndexes = "48;40; 8;12;24" />

                <Face Color = "clOrange" VertexIndexes = "49;25;13; 9;41" />
                <Face Color = "clYellow" VertexIndexes = "49;41;20; 4;33" />
                <Face Color = "clGreen " VertexIndexes = "49;33;17; 1;25" />

                <Face Color = "clOrange" VertexIndexes = "50;26;14;10;42" />
                <Face Color = "clWhite " VertexIndexes = "50;42;21; 5;34" />
                <Face Color = "clBlue  " VertexIndexes = "50;34;16; 0;26" />

                <Face Color = "clBlue  " VertexIndexes = "51;27; 1;17;35" />
                <Face Color = "clYellow" VertexIndexes = "51;35; 5;21;43" />
                <Face Color = "clOrange" VertexIndexes = "51;43;11;15;27" />

                <Face Color = "clRed   " VertexIndexes = "52;28;12; 8;44" />
                <Face Color = "clWhite " VertexIndexes = "52;44;22; 6;36" />
                <Face Color = "clGreen " VertexIndexes = "52;36;18; 2;28" />

                <Face Color = "clGreen " VertexIndexes = "53;29; 3;19;37" />
                <Face Color = "clYellow" VertexIndexes = "53;37; 6;22;45" />
                <Face Color = "clRed   " VertexIndexes = "53;45; 9;13;29" />

                <Face Color = "clBlue  " VertexIndexes = "54;30; 2;18;38" />
                <Face Color = "clWhite " VertexIndexes = "54;38; 7;23;46" />
                <Face Color = "clRed   " VertexIndexes = "54;46;10;14;30" />

                <Face Color = "clRed   " VertexIndexes = "55;31;15;11;47" />
                <Face Color = "clYellow" VertexIndexes = "55;47;23; 7;39" />
                <Face Color = "clBlue  " VertexIndexes = "55;39;19; 3;31" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
