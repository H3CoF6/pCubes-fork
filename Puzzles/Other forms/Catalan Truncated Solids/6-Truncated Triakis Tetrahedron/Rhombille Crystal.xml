        clPink        := 'FF69B4';
        clDarkGreen   := '006400';
        clPurple      := '800080';
        clBody        := '333333';

        K  := 0.16;
        s3 := sqrt(3);
        C0 := K * (2 * s3 - 3) / 3;
        C1 := K;
        C2 := K * (2 * s3 + 1) * 3 / 5;
        C3 := K * (4 * s3 + 3) / 3;
        C4 := K * (2 * s3 + 1);

        K1 := (C1 + C3) / 2;
        K2 := (C4 - C0) / 2;

        D1 := C4 / s3;
        D2 := K2 / s3;
        D3 := K * (72 + 11 * s3) / 27;
    </Script>

