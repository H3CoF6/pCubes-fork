<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexadecagon 16 colours</Name>
        <Menu>Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\Hexadecagon 16 colours</Menu>
        <Inventor>Miguel Alonso</Inventor>
        <Programmer>Evgeniy Grigoriev, Skallos, Boris</Programmer>
        <Added>2019-01-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10782</Link>
    </Interface>

    <Script>
        clRed         := 'FF0000';
        clBlue        := '0000FF';
        clYellow      := 'FFFF00';
        clGreen       := '008000';
        clDeepSky     := '00BFFF';
        clOrange      := 'FF6000';
        clTeal        := '008080';
        clCoral       := 'FF7F50';
        clNavy        := '000080';
        clLime        := '00FF00';
        clGreenYellow := 'ADFF2F';
        clCyan        := '00FFFF';
        clFuchsia     := 'FF00FF';
        clPink        := 'FF69B4';
        clDarkGreen   := '006400';
        clPurple      := '800080';

        K  := 0.02;

        s3 := sqrt(3);
        C0 := K;
        C1 := K * ( 3 +  2 * s3);
        C2 := K * ( 9 + 24 * s3 / 5);
        C3 := K * (11 +  6 * s3);
        C4 := K * (15 +  8 * s3);

        D1 := K * 18;
        D2 := K * 21.47;

        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "0; Pi/3" PlaneDistances = " D1" >
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = " 1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D2" >
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = " 1;-3; 1" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 1; 1;-3" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = "-3; 1; 1" />
        <Axis NormVector = "-1;-1;-3" />
        <Axis NormVector = "-1;-3;-1" />
        <Axis NormVector = "-3;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C4" />
                <Add Vector = " C1;-C1;-C4" />
                <Add Vector = "-C1;-C1; C4" />
                <Add Vector = "-C1; C1;-C4" />
                <Add Vector = " C4; C1; C1" />
                <Add Vector = " C4;-C1;-C1" />
                <Add Vector = "-C4;-C1; C1" />
                <Add Vector = "-C4; C1;-C1" />
                <Add Vector = " C1; C4; C1" />
                <Add Vector = " C1;-C4;-C1" />
                <Add Vector = "-C1;-C4; C1" />
                <Add Vector = "-C1; C4;-C1" />
                <Add Vector = " C3;-C0; C3" />
                <Add Vector = " C3; C0;-C3" />
                <Add Vector = "-C3; C0; C3" />
                <Add Vector = "-C3;-C0;-C3" />
                <Add Vector = " C3;-C3; C0" />
                <Add Vector = " C3; C3;-C0" />
                <Add Vector = "-C3; C3; C0" />
                <Add Vector = "-C3;-C3;-C0" />
                <Add Vector = " C0;-C3; C3" />
                <Add Vector = " C0; C3;-C3" />
                <Add Vector = "-C0; C3; C3" />
                <Add Vector = "-C0;-C3;-C3" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed        " VertexIndexes = " 0;12; 4;17; 8;22" />
                <Face Color = "clBlue       " VertexIndexes = " 2;14; 6;19;10;20" />
                <Face Color = "clYellow     " VertexIndexes = " 1;13; 5;16; 9;23" />
                <Face Color = "clGreen      " VertexIndexes = " 3;15; 7;18;11;21" />
                <Face Color = "clDeepSky    " VertexIndexes = "24;12; 0; 2;20" />
                <Face Color = "clOrange     " VertexIndexes = "24;20;10; 9;16" />
                <Face Color = "clTeal       " VertexIndexes = "24;16; 5; 4;12" />
                <Face Color = "clCoral      " VertexIndexes = "25;13; 1; 3;21" />
                <Face Color = "clNavy       " VertexIndexes = "25;21;11; 8;17" />
                <Face Color = "clLime       " VertexIndexes = "25;17; 4; 5;13" />
                <Face Color = "clGreenYellow" VertexIndexes = "26;14; 2; 0;22" />
                <Face Color = "clCyan       " VertexIndexes = "26;22; 8;11;18" />
                <Face Color = "clFuchsia    " VertexIndexes = "26;18; 7; 6;14" />
                <Face Color = "clPink       " VertexIndexes = "27;15; 3; 1;23" />
                <Face Color = "clDarkGreen  " VertexIndexes = "27;23; 9;10;19" />
                <Face Color = "clPurple     " VertexIndexes = "27;19; 6; 7;15" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Cut1" >
            <Hide Axis = "ax1" To = "0" />
            <Hide Axis = "ax2" To = "0" />
            <Hide Axis = "ax3" To = "0" />
            <Turn Axis = "ax2" Layer = "1" Angle = "A1" />
            <Cut Axis = "ax3" From = "1" />
            <Undo/>
            <Turn Axis = "ax1" Layer = "1" Angle = "Pi/3" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Cut1" ax1 = " 0" ax2 = " 7" ax3 = " 8" Repeat = "6" />
        <ExecMacro MacroName = "Cut1" ax1 = " 1" ax2 = " 4" ax3 = " 5" Repeat = "6" />
        <ExecMacro MacroName = "Cut1" ax1 = " 2" ax2 = " 5" ax3 = " 6" Repeat = "6" />
        <ExecMacro MacroName = "Cut1" ax1 = " 3" ax2 = " 6" ax3 = " 4" Repeat = "6" />

        <Macro Name = "Cut2" >
            <HideContaining Vector = " (C0+C2)/2;-(C3+C2)/2; (C3+C2)/2" />  // (v20+v24)/2
            <InvertVisibility/>
            <Turn NormVector = " 1;-1; 3" Angle = " A1" />
            <Cut><Plane NormVector = "-1;-1;-1" NormDistance = "-D1" /></Cut>
            <Turn NormVector = " 1;-1; 3" Angle = "-A1" />
            <ShowAll/>
            <Turn NormVector = " 1;-1; 1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Cut2"  Repeat = "3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <ExecMacro MacroName = "Cut2"  Repeat = "3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut2"  Repeat = "3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <ExecMacro MacroName = "Cut2"  Repeat = "3" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />

        <Macro Name = "Cut3" >
            <HideContaining Vector = " C0;-C3; C3" />  // v20
            <InvertVisibility/>

            <Turn NormVector = " 1;-1; 3" Angle = " A1"/>
            <Turn NormVector = " 3;-1; 1" Angle = "-A1"/>
            <Turn NormVector = " 1;-1; 3" Angle = "-A1"/>
            <Turn NormVector = " 3;-1; 1" Angle = " A1"/>
            <Cut><Plane NormVector = " 1;-1;-1" NormDistance = " D1" /></Cut>
            <Turn NormVector = " 3;-1; 1" Angle = "-A1"/>
            <Turn NormVector = " 1;-1; 3" Angle = " A1"/>
            <Turn NormVector = " 3;-1; 1" Angle = " A1"/>
            <Turn NormVector = " 1;-1; 3" Angle = "-A1"/>

            <Turn NormVector = " 1;-3; 1" Angle = "-A1"/> 5
            <Turn NormVector = " 3;-1; 1" Angle = " A1"/> 6
            <Turn NormVector = " 1;-3; 1" Angle = " A1"/> 
            <Turn NormVector = " 3;-1; 1" Angle = "-A1"/>
            <Cut><Plane NormVector = " 1; 1; 1" NormDistance = " D1" /></Cut>
            <Turn NormVector = " 3;-1; 1" Angle = " A1"/>
            <Turn NormVector = " 1;-3; 1" Angle = "-A1"/>
            <Turn NormVector = " 3;-1; 1" Angle = "-A1"/>
            <Turn NormVector = " 1;-3; 1" Angle = " A1"/>

            <ShowAll/>

            <Turn NormVector = "-1;-1; 1" Angle = "Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Cut3"  Repeat = "6" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <ExecMacro MacroName = "Cut3"  Repeat = "6" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut3"  Repeat = "6" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <ExecMacro MacroName = "Cut3"  Repeat = "6" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
    </Figure>
</xml>
