<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Skyglobe</Name>
        <Menu>Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\Skyglobe</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-10-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1790</Link>
        <Link>http://dmccooey.com/polyhedra/6TruncatedTriakisTetrahedron3.html</Link>
    </Interface>

    <Script>
        clOrange      := 'FF6000';
        clCyan        := '00FFFF';
        clDeepSky     := '00BFFF';
        clTeal        := '008080';
        clNavy        := '000080';
        clCoral       := 'FF7F50';
        clGreenYellow := 'ADFF2F';
        clLime        := '00FF00';
        clDarkGreen   := '006400';
        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clPurple      := '800080';

        clBlack0      := '202020';
        clBlack1      := '202021';
        clBlack2      := '202022';
        clBlack3      := '202023';

        K  := 0.4;

        C0 := K / 9;
        C1 := K / 3;
        C2 := K;
        C3 := K * 11 / 9;
        C4 := K * 5 / 3;

        // circle's centers
        CC1 := K * 5 / 11;
        CC2 := K * 15 / 11;

        D := K / sqrt(3);

        RC := K * 0.246;
    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C4" />
                <Add Vector = " C1;-C1;-C4" />
                <Add Vector = "-C1;-C1; C4" />
                <Add Vector = "-C1; C1;-C4" />
                <Add Vector = " C4; C1; C1" />
                <Add Vector = " C4;-C1;-C1" />
                <Add Vector = "-C4;-C1; C1" />
                <Add Vector = "-C4; C1;-C1" />
                <Add Vector = " C1; C4; C1" />
                <Add Vector = " C1;-C4;-C1" />
                <Add Vector = "-C1;-C4; C1" />
                <Add Vector = "-C1; C4;-C1" />
                <Add Vector = " C3;-C0; C3" />
                <Add Vector = " C3; C0;-C3" />
                <Add Vector = "-C3; C0; C3" />
                <Add Vector = "-C3;-C0;-C3" />
                <Add Vector = " C3;-C3; C0" />
                <Add Vector = " C3; C3;-C0" />
                <Add Vector = "-C3; C3; C0" />
                <Add Vector = "-C3;-C3;-C0" />
                <Add Vector = " C0;-C3; C3" />
                <Add Vector = " C0; C3;-C3" />
                <Add Vector = "-C0; C3; C3" />
                <Add Vector = "-C0;-C3;-C3" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlack0     " VertexIndexes = " 0;12; 4;17; 8;22" />
                <Face Color = "clBlack1     " VertexIndexes = " 2;14; 6;19;10;20" />
                <Face Color = "clBlack2     " VertexIndexes = " 1;13; 5;16; 9;23" />
                <Face Color = "clBlack3     " VertexIndexes = " 3;15; 7;18;11;21" />

                <Face Color = "clDeepSky    " VertexIndexes = "24;12; 0; 2;20" />
                <Face Color = "clOrange     " VertexIndexes = "24;20;10; 9;16" />
                <Face Color = "clTeal       " VertexIndexes = "24;16; 5; 4;12" />
                <Face Color = "clCoral      " VertexIndexes = "25;13; 1; 3;21" />
                <Face Color = "clNavy       " VertexIndexes = "25;21;11; 8;17" />
                <Face Color = "clLime       " VertexIndexes = "25;17; 4; 5;13" />
                <Face Color = "clGreenYellow" VertexIndexes = "26;14; 2; 0;22" />
                <Face Color = "clCyan       " VertexIndexes = "26;22; 8;11;18" />
                <Face Color = "clFuchsia    " VertexIndexes = "26;18; 7; 6;14" />
                <Face Color = "clPink       " VertexIndexes = "27;15; 3; 1;23" />
                <Face Color = "clDarkGreen  " VertexIndexes = "27;23; 9;10;19" />
                <Face Color = "clPurple     " VertexIndexes = "27;19; 6; 7;15" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn  Axis = "Ax1" Layer = "1" Angle = " Pi/3" />
            <SplitByAxes/>
            <Turn  Axis = "Ax2" Layer = "1" Angle = " Pi/3" />
            <SplitByAxes/>
            <Turn  Axis = "Ax3" Layer = "1" Angle = " Pi/3" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Ax1 = "0" Ax2 = "1" Ax3 = "2" Repeat = "9 "/>
        <ExecMacro MacroName = "SplitPart" Ax1 = "1" Ax2 = "2" Ax3 = "3" Repeat = "9 "/>

        <HideContaining Vector = " C1; C1; C4" />
        <HideContaining Vector = " C1;-C1;-C4" />
        <HideContaining Vector = "-C1;-C1; C4" />
        <HideContaining Vector = "-C1; C1;-C4" />
        <HideContaining Vector = " C4; C1; C1" />
        <HideContaining Vector = " C4;-C1;-C1" />
        <HideContaining Vector = "-C4;-C1; C1" />
        <HideContaining Vector = "-C4; C1;-C1" />
        <HideContaining Vector = " C1; C4; C1" />
        <HideContaining Vector = " C1;-C4;-C1" />
        <HideContaining Vector = "-C1;-C4; C1" />
        <HideContaining Vector = "-C1; C4;-C1" />
        <HideContaining Vector = " C3;-C0; C3" />
        <HideContaining Vector = " C3; C0;-C3" />
        <HideContaining Vector = "-C3; C0; C3" />
        <HideContaining Vector = "-C3;-C0;-C3" />
        <HideContaining Vector = " C3;-C3; C0" />
        <HideContaining Vector = " C3; C3;-C0" />
        <HideContaining Vector = "-C3; C3; C0" />
        <HideContaining Vector = "-C3;-C3;-C0" />
        <HideContaining Vector = " C0;-C3; C3" />
        <HideContaining Vector = " C0; C3;-C3" />
        <HideContaining Vector = "-C0; C3; C3" />
        <HideContaining Vector = "-C0;-C3;-C3" />
        <HideContaining Vector = "-C2; C2; C2" />
        <HideContaining Vector = " C2;-C2; C2" />
        <HideContaining Vector = " C2; C2;-C2" />
        <HideContaining Vector = "-C2;-C2;-C2" />

        <RemoveAllVisible/>
        <ShowAll/>

        <Undo Repeat = "54" />

        <Circle Radius = "RC" Color = "clDeepSky    " Center = " CC1;-CC1; CC2" />
        <Circle Radius = "RC" Color = "clOrange     " Center = " CC1;-CC2; CC1" />
        <Circle Radius = "RC" Color = "clTeal       " Center = " CC2;-CC1; CC1" />
        <Circle Radius = "RC" Color = "clCoral      " Center = " CC1; CC1;-CC2" />
        <Circle Radius = "RC" Color = "clNavy       " Center = " CC1; CC2;-CC1" />
        <Circle Radius = "RC" Color = "clLime       " Center = " CC2; CC1;-CC1" />
        <Circle Radius = "RC" Color = "clGreenYellow" Center = "-CC1; CC1; CC2" />
        <Circle Radius = "RC" Color = "clCyan       " Center = "-CC1; CC2; CC1" />
        <Circle Radius = "RC" Color = "clFuchsia    " Center = "-CC2; CC1; CC1" />
        <Circle Radius = "RC" Color = "clPink       " Center = "-CC1;-CC1;-CC2" />
        <Circle Radius = "RC" Color = "clDarkGreen  " Center = "-CC1;-CC2;-CC1" />
        <Circle Radius = "RC" Color = "clPurple     " Center = "-CC2;-CC1;-CC1" />
    </Figure>

    <Textures>
        <Texture Name = "Stars" File = "Puzzles\Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\Skyglobe.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Stars = 1,0,0, 11,0,0, 28,0,0, 52,0,0
    </SetTextures>
</xml>
