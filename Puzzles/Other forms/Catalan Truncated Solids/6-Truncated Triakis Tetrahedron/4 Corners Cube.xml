<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4 Corners Cube (6-Truncated Triakis Tetrahedron)</Name>
        <Menu>Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\4 Corners Cube</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-03</Added>
        <Link></Link>
    </Interface>

    <Script>
        clCyan        := '00FFFF';
        clDeepSky     := '00BFFF';
        clBlue        := '0000FF';
        clNavy        := '000080';
        clCoral       := 'FF7F50';
        clRed         := 'FF0000';
        clYellow      := 'FFFF00';
        clOrange      := 'FF6000';
        clGreenYellow := 'ADFF2F';
        clLime        := '00FF00';
        clTeal        := '008080';
        clGreen       := '008000';
        clDarkGreen   := '006400';
        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clPurple      := '800080';

        K  := 0.0248;

        s3 := sqrt(3);
        C0 := K;
        C1 := K * ( 3 +  2 * s3);
        C2 := K * ( 9 + 24 * s3 / 5);
        C3 := K * (11 +  6 * s3);
        C4 := K * (15 +  8 * s3);

        D := K * 20.4;

        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = " 1;-3; 1" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 1; 1;-3" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = "-3; 1; 1" />
        <Axis NormVector = "-1;-1;-3" />
        <Axis NormVector = "-1;-3;-1" />
        <Axis NormVector = "-3;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C4" />
                <Add Vector = " C1;-C1;-C4" />
                <Add Vector = "-C1;-C1; C4" />
                <Add Vector = "-C1; C1;-C4" />
                <Add Vector = " C4; C1; C1" />
                <Add Vector = " C4;-C1;-C1" />
                <Add Vector = "-C4;-C1; C1" />
                <Add Vector = "-C4; C1;-C1" />
                <Add Vector = " C1; C4; C1" />
                <Add Vector = " C1;-C4;-C1" />
                <Add Vector = "-C1;-C4; C1" />
                <Add Vector = "-C1; C4;-C1" />
                <Add Vector = " C3;-C0; C3" />
                <Add Vector = " C3; C0;-C3" />
                <Add Vector = "-C3; C0; C3" />
                <Add Vector = "-C3;-C0;-C3" />
                <Add Vector = " C3;-C3; C0" />
                <Add Vector = " C3; C3;-C0" />
                <Add Vector = "-C3; C3; C0" />
                <Add Vector = "-C3;-C3;-C0" />
                <Add Vector = " C0;-C3; C3" />
                <Add Vector = " C0; C3;-C3" />
                <Add Vector = "-C0; C3; C3" />
                <Add Vector = "-C0;-C3;-C3" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed        " VertexIndexes = " 0;12; 4;17; 8;22" />
                <Face Color = "clBlue       " VertexIndexes = " 2;14; 6;19;10;20" />
                <Face Color = "clYellow     " VertexIndexes = " 1;13; 5;16; 9;23" />
                <Face Color = "clGreen      " VertexIndexes = " 3;15; 7;18;11;21" />
                <Face Color = "clDeepSky    " VertexIndexes = "24;12; 0; 2;20" />
                <Face Color = "clOrange     " VertexIndexes = "24;20;10; 9;16" />
                <Face Color = "clTeal       " VertexIndexes = "24;16; 5; 4;12" />
                <Face Color = "clCoral      " VertexIndexes = "25;13; 1; 3;21" />
                <Face Color = "clNavy       " VertexIndexes = "25;21;11; 8;17" />
                <Face Color = "clLime       " VertexIndexes = "25;17; 4; 5;13" />
                <Face Color = "clGreenYellow" VertexIndexes = "26;14; 2; 0;22" />
                <Face Color = "clCyan       " VertexIndexes = "26;22; 8;11;18" />
                <Face Color = "clFuchsia    " VertexIndexes = "26;18; 7; 6;14" />
                <Face Color = "clPink       " VertexIndexes = "27;15; 3; 1;23" />
                <Face Color = "clDarkGreen  " VertexIndexes = "27;23; 9;10;19" />
                <Face Color = "clPurple     " VertexIndexes = "27;19; 6; 7;15" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
