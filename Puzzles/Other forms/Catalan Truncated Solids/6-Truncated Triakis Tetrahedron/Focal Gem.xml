<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Focal Gem</Name>
        <Menu>Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\Focal Gem</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-09-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9723</Link>
    </Interface>

    <Script>
        clRed         := 'FF0000';
        clBlue        := '0000FF';
        clYellow      := 'FFFF00';
        clGreen       := '008000';
        clDeepSky     := '00BFFF';
        clOrange      := 'FF6000';
        clTeal        := '008080';
        clCoral       := 'FF7F50';
        clNavy        := '000080';
        clLime        := '00FF00';
        clGreenYellow := 'ADFF2F';
        clCyan        := '00FFFF';
        clFuchsia     := 'FF00FF';
        clPink        := 'FF69B4';
        clDarkGreen   := '006400';
        clPurple      := '800080';

        K  := 0.16;
        s3 := sqrt(3);
        C0 := K * (2 * s3 - 3) / 3;
        C1 := K;                      
        C2 := K * (2 * s3 + 1) * 3 / 5;
        C3 := K * (4 * s3 + 3) / 3;
        C4 := K * (2 * s3 + 1);

        D1 := K * (s3 + 6) / 11;
        D2 := 3 * D1;
    </Script>

    <Axes TurningAngles = " Pi/3; 0; 2*Pi/3" PlaneDistances = "-D2; D1" >
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C4" />
                <Add Vector = " C1;-C1;-C4" />
                <Add Vector = "-C1;-C1; C4" />
                <Add Vector = "-C1; C1;-C4" />
                <Add Vector = " C4; C1; C1" />
                <Add Vector = " C4;-C1;-C1" />
                <Add Vector = "-C4;-C1; C1" />
                <Add Vector = "-C4; C1;-C1" />
                <Add Vector = " C1; C4; C1" />
                <Add Vector = " C1;-C4;-C1" />

                <Add Vector = "-C1;-C4; C1" />
                <Add Vector = "-C1; C4;-C1" />
                <Add Vector = " C3;-C0; C3" />
                <Add Vector = " C3; C0;-C3" />
                <Add Vector = "-C3; C0; C3" />
                <Add Vector = "-C3;-C0;-C3" />
                <Add Vector = " C3;-C3; C0" />
                <Add Vector = " C3; C3;-C0" />
                <Add Vector = "-C3; C3; C0" />
                <Add Vector = "-C3;-C3;-C0" />

                <Add Vector = " C0;-C3; C3" />
                <Add Vector = " C0; C3;-C3" />
                <Add Vector = "-C0; C3; C3" />
                <Add Vector = "-C0;-C3;-C3" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed        " VertexIndexes = " 0;12; 4;17; 8;22" />
                <Face Color = "clBlue       " VertexIndexes = " 2;14; 6;19;10;20" />
                <Face Color = "clYellow     " VertexIndexes = " 1;13; 5;16; 9;23" />
                <Face Color = "clGreen      " VertexIndexes = " 3;15; 7;18;11;21" />

                <Face Color = "clDeepSky    " VertexIndexes = "24;12; 0; 2;20" />
                <Face Color = "clOrange     " VertexIndexes = "24;20;10; 9;16" />
                <Face Color = "clTeal       " VertexIndexes = "24;16; 5; 4;12" />
                <Face Color = "clCoral      " VertexIndexes = "25;13; 1; 3;21" />
                <Face Color = "clNavy       " VertexIndexes = "25;21;11; 8;17" />
                <Face Color = "clLime       " VertexIndexes = "25;17; 4; 5;13" />
                <Face Color = "clGreenYellow" VertexIndexes = "26;14; 2; 0;22" />
                <Face Color = "clCyan       " VertexIndexes = "26;22; 8;11;18" />
                <Face Color = "clFuchsia    " VertexIndexes = "26;18; 7; 6;14" />
                <Face Color = "clPink       " VertexIndexes = "27;15; 3; 1;23" />
                <Face Color = "clDarkGreen  " VertexIndexes = "27;23; 9;10;19" />
                <Face Color = "clPurple     " VertexIndexes = "27;19; 6; 7;15" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "ax" Layer = "0" Angle = " Pi/3" />
            <SplitByAxes/>
            <Undo/>
        </Macro>
        <ExecMacro MacroName = "Split" ax = "0" />
        <ExecMacro MacroName = "Split" ax = "1" />
        <ExecMacro MacroName = "Split" ax = "2" />
        <ExecMacro MacroName = "Split" ax = "3" />
    </Figure>
</xml>
