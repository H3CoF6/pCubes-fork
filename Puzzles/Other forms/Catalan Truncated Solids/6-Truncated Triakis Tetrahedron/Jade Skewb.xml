<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Jade Skewb</Name>
        <Menu>Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\Jade Skewb</Menu>
        <Menu>Other forms\Skewb variants\Jade Skewb</Menu>
        <Inventor>Linxiao Xu</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7972</Link>
    </Interface>

    <Script>
        clRed         := 'FF0000';
        clBlue        := '0033FF';
        clYellow      := 'FFEE00';
        clGreen       := '009900';
        clGray        := 'CCCCCC';
        clGreenYellow := 'ADFF2F';
        clPurple      := '9966FF';
        clOrange      := 'FF6600';
        clWhite       := 'FFFFFF';
        clBlue2       := '0133FF';
        clGreen2      := '019900';
        clYellow2     := 'FFEE01';
        clRose        := 'FFBBFF';
        clLightBlue   := '00CCFF';
        clRed2        := 'FF0001';
        clDarkPurple  := '9900DD';

        K  := 0.15;
        C0 := K * (2 * sqrt(3) - 3) / 3;
        C1 := K;
        C2 := K * (2 * sqrt(3) + 1) * 3 / 5;
        C3 := K * (4 * sqrt(3) + 3) / 3;
        C4 := K * (2 * sqrt(3) + 1);

        D := C0 / sqrt(3);
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C4" />
                <Add Vector = " C1;-C1;-C4" />
                <Add Vector = "-C1;-C1; C4" />
                <Add Vector = "-C1; C1;-C4" />
                <Add Vector = " C4; C1; C1" />
                <Add Vector = " C4;-C1;-C1" />
                <Add Vector = "-C4;-C1; C1" />
                <Add Vector = "-C4; C1;-C1" />
                <Add Vector = " C1; C4; C1" />
                <Add Vector = " C1;-C4;-C1" />
                <Add Vector = "-C1;-C4; C1" />
                <Add Vector = "-C1; C4;-C1" />
                <Add Vector = " C3;-C0; C3" />
                <Add Vector = " C3; C0;-C3" />
                <Add Vector = "-C3; C0; C3" />
                <Add Vector = "-C3;-C0;-C3" />
                <Add Vector = " C3;-C3; C0" />
                <Add Vector = " C3; C3;-C0" />
                <Add Vector = "-C3; C3; C0" />
                <Add Vector = "-C3;-C3;-C0" />
                <Add Vector = " C0;-C3; C3" />
                <Add Vector = " C0; C3;-C3" />
                <Add Vector = "-C0; C3; C3" />
                <Add Vector = "-C0;-C3;-C3" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2; C2; C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed        " VertexIndexes = " 0;12; 4;17; 8;22" />
                <Face Color = "clBlue       " VertexIndexes = " 2;14; 6;19;10;20" />
                <Face Color = "clYellow     " VertexIndexes = " 1;13; 5;16; 9;23" />
                <Face Color = "clGreen      " VertexIndexes = " 3;15; 7;18;11;21" />

                <Face Color = "clGray       " VertexIndexes = "24;12; 0; 2;20" />
                <Face Color = "clGreenYellow" VertexIndexes = "24;20;10; 9;16" />
                <Face Color = "clPurple     " VertexIndexes = "24;16; 5; 4;12" />
                <Face Color = "clOrange     " VertexIndexes = "25;13; 1; 3;21" />
                <Face Color = "clWhite      " VertexIndexes = "25;21;11; 8;17" />
                <Face Color = "clBlue2      " VertexIndexes = "25;17; 4; 5;13" />
                <Face Color = "clGreen2     " VertexIndexes = "26;14; 2; 0;22" />
                <Face Color = "clYellow2    " VertexIndexes = "26;22; 8;11;18" />
                <Face Color = "clRose       " VertexIndexes = "26;18; 7; 6;14" />
                <Face Color = "clLightBlue  " VertexIndexes = "27;15; 3; 1;23" />
                <Face Color = "clRed2       " VertexIndexes = "27;23; 9;10;19" />
                <Face Color = "clDarkPurple " VertexIndexes = "27;19; 6; 7;15" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
