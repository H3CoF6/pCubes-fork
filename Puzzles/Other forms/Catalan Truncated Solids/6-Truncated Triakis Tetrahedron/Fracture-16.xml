<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fracture-16</Name>
        <Menu>Other forms\Catalan Truncated Solids\6-Truncated Triakis Tetrahedron\Fracture-16</Menu>
        <Inventor>Alasdair Paton</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-11-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9938</Link>
    </Interface>

    <Script>
        Colors[ 0] := '00BFFF'; // DeepSky
        Colors[ 1] := 'FF6000'; // Orange
        Colors[ 2] := '008080'; // Teal
        Colors[ 3] := '00FF00'; // Lime
        Colors[ 4] := 'FF7F50'; // Coral
        Colors[ 5] := '000080'; // Navy
        Colors[ 6] := '00FFFF'; // Cyan
        Colors[ 7] := 'FF00FF'; // Fuchsia
        Colors[ 8] := 'ADFF2F'; // GreenYellow
        Colors[ 9] := '006400'; // DarkGreen
        Colors[10] := '800080'; // Purple
        Colors[11] := 'FF69B4'; // Pink
        Colors[12] := 'FF0000'; // Red
        Colors[13] := 'FFFF00'; // Yellow
        Colors[14] := '008000'; // Green
        Colors[15] := '0000FF'; // Blue

        C0 := 0.43;
        C1 := C0 * 5 / 3;

        DCut := C0 * (4 + 3 * sqrt(3)) * 5 / 33;
        D   := C0 * sqrt(3) * 5 / 9;
    </Script>

    <Axes TurningAngles = "Pi/3; 0; 2*Pi/3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "4;0;2" />
                <Face Color = "Colors[ 1]" VertexIndexes = "4;2;1" />
                <Face Color = "Colors[ 2]" VertexIndexes = "4;1;0" />
                <Face Color = "Colors[ 3]" VertexIndexes = "5;0;1" />
                <Face Color = "Colors[ 4]" VertexIndexes = "5;1;3" />
                <Face Color = "Colors[ 5]" VertexIndexes = "5;3;0" />
                <Face Color = "Colors[ 6]" VertexIndexes = "6;0;3" />
                <Face Color = "Colors[ 7]" VertexIndexes = "6;3;2" />
                <Face Color = "Colors[ 8]" VertexIndexes = "6;2;0" />
                <Face Color = "Colors[ 9]" VertexIndexes = "7;1;2" />
                <Face Color = "Colors[10]" VertexIndexes = "7;2;3" />
                <Face Color = "Colors[11]" VertexIndexes = "7;3;1" />
            </Faces>
        </Part>
        <Cut Color = "Colors[12]" > <Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[13]" > <Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[14]" > <Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[15]" > <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /> </Cut>

        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = " Pi/3" />
        <Turn Axis = "1" Layer = "0" Angle = " Pi/3" />
        <Turn Axis = "2" Layer = "0" Angle = " Pi/3" />
        <Turn Axis = "3" Layer = "0" Angle = " Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "0" Angle = "-Pi/3" />
        <Turn Axis = "1" Layer = "0" Angle = "-Pi/3" />
        <Turn Axis = "2" Layer = "0" Angle = "-Pi/3" />
        <Turn Axis = "3" Layer = "0" Angle = "-Pi/3" />
    </Figure>
</xml>
