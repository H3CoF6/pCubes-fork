        K  := 0.12;
        C0 := k * (3 + sqrt(6)) / 3;
        C1 := k * (1 + sqrt(6));
        C2 := k * (3 + 4 * sqrt(6)) / 3;
        C3 := k * 3 * (1 + sqrt(6)) / 2;
        C4 := k;

        A1 := ArcCos(-1/9);
        A2 := ArcCos(-2/3);

        D := K * (6 + 5 * sqrt(6)) * sqrt(5) / 10;
        D2 := K * (6 + 5 * sqrt(6)) * sqrt(5) / 10 - 0.01;
    </Script>

