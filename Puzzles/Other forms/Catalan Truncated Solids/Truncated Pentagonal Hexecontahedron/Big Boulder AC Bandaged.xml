        procedure NormalI(i1, i2, i3);
        begin
          px[nindex] := (y[i1]-y[i3]) * (z[i2]-z[i3]) - (y[i2]-y[i3]) * (z[i1]-z[i3]);
          py[nindex] := (z[i1]-z[i3]) * (x[i2]-x[i3]) - (z[i2]-z[i3]) * (x[i1]-x[i3]);
          pz[nindex] := (x[i1]-x[i3]) * (y[i2]-y[i3]) - (x[i2]-x[i3]) * (y[i1]-y[i3]);
          ex[nindex] := (x[i1] + 2 * x[i2]) / 3;
          ey[nindex] := (y[i1] + 2 * y[i2]) / 3;
          ez[nindex] := (z[i1] + 2 * z[i2]) / 3;
          nindex := nindex + 1;
        end;

