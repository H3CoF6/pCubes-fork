        function AngleI(i1, i2, i3);
        begin
          vx := py[i1] * pz[i2] - py[i2] * pz[i1];
          vy := pz[i1] * px[i2] - pz[i2] * px[i1];
          vz := px[i1] * py[i2] - px[i2] * py[i1];
          wx := py[i1] * pz[i3] - py[i3] * pz[i1];
          wy := pz[i1] * px[i3] - pz[i3] * px[i1];
          wz := px[i1] * py[i3] - px[i3] * py[i1];
          Result := ArcCos((vx*wx + vy*wy + vz*wz) / (vx^2 + vy^2 + vz^2));
        end;

// <!-- All angles there: http://twistypuzzles.com/forum/viewtopic.php?f=1&p=358806  -->
