          py[nindex] := (z[i1]-z[i3]) * (x[i2]-x[i3]) - (z[i2]-z[i3]) * (x[i1]-x[i3]);
          pz[nindex] := (x[i1]-x[i3]) * (y[i2]-y[i3]) - (x[i2]-x[i3]) * (y[i1]-y[i3]);
          nindex := nindex + 1;
        end;

