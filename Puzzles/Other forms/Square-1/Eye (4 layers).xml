<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Super Eye (4 layers)</Name>
        <Menu>Other forms\Square-1\Eye (4 layers)</Menu>
        <Inventor>Mr. Fok</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3152</Link>
    </Interface>

    <Script>
        clWhite      := 'FFFFFF';
        clYellow     := 'FFFF00';
        clRed        := 'C80000';
        clRed1       := '780000';
        clOrange     := 'FF800A';
        clOrange1    := '7F400A';
        clGreen      := '00BE00';
        clDarkGreen  := '005E00';
        clLightBlue  := '2464FF';
        clBlue       := '0404AF';
        clViolett    := '6500CD';

        ColorBottom := clYellow;
        ColorUp     := clWhite;

        W := 0.5;
        R := W;
        R1 := R * cos(Pi/12) / cos(Pi / 4);
        RC := W / 2;
        D := W / 2;
        H := W;
        Delta := 0.002;

        i := 0;
        A := 0;

        Procedure AddVertex(L, Angle);
        begin
          A := A + Angle;
          x[i] := L * sin(A);
          y[i] := L * cos(A);
          Inc(i);
        end;

        AddVertex( R, 0);
        AddVertex(R1, Pi / 3);
        AddVertex( R, Pi / 3);
        AddVertex( R, Pi / 6);
        AddVertex( R, Pi / 6);
        AddVertex(R1, Pi / 3);
        AddVertex( R, Pi / 3);
        AddVertex( R, Pi / 6);

    </Script>

    <Axes TurningAngles = "0; Pi/6; Pi/6; Pi/6; Pi/6; 0" PlaneDistances = "-H; -D; 0; D; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
                <Add Vector = "x[6]; y[6]; -H" />
                <Add Vector = "x[7]; y[7]; -H" />
                <Add Vector = "x[0]; y[0]; -D" />
                <Add Vector = "x[1]; y[1]; -D" />
                <Add Vector = "x[2]; y[2]; -D" />
                <Add Vector = "x[3]; y[3]; -D" />
                <Add Vector = "x[4]; y[4]; -D" />
                <Add Vector = "x[5]; y[5]; -D" />
                <Add Vector = "x[6]; y[6]; -D" />
                <Add Vector = "x[7]; y[7]; -D" />
                <Add Vector = "x[0]; y[0];  0" />
                <Add Vector = "x[1]; y[1];  0" />
                <Add Vector = "x[2]; y[2];  0" />
                <Add Vector = "x[3]; y[3];  0" />
                <Add Vector = "x[4]; y[4];  0" />
                <Add Vector = "x[5]; y[5];  0" />
                <Add Vector = "x[6]; y[6];  0" />
                <Add Vector = "x[7]; y[7];  0" />
                <Add Vector = "x[0]; y[0];  D" />
                <Add Vector = "x[1]; y[1];  D" />
                <Add Vector = "x[2]; y[2];  D" />
                <Add Vector = "x[3]; y[3];  D" />
                <Add Vector = "x[4]; y[4];  D" />
                <Add Vector = "x[5]; y[5];  D" />
                <Add Vector = "x[6]; y[6];  D" />
                <Add Vector = "x[7]; y[7];  D" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
                <Add Vector = "x[6]; y[6];  H" />
                <Add Vector = "x[7]; y[7];  H" />
            </Vertices>

            <Faces>
                <Face Color = "ColorBottom" VertexIndexes = "0;1;2;3;4;5;6;7" />
                <Face Color = "ColorUp    " VertexIndexes = "39;38;37;36;35;34;33;32" />
                <Face Color = "clRed      " VertexIndexes = " 5; 4;12;13" />
                <Face Color = "clRed      " VertexIndexes = " 4; 3;11;12" />
                <Face Color = "clRed      " VertexIndexes = " 3; 2;10;11" />
                <Face Color = "clRed      " VertexIndexes = " 2; 1; 9;10" />
                <Face Color = "clOrange   " VertexIndexes = "13;12;20;21" />
                <Face Color = "clOrange   " VertexIndexes = "12;11;19;20" />
                <Face Color = "clOrange   " VertexIndexes = "11;10;18;19" />
                <Face Color = "clOrange   " VertexIndexes = "10; 9;17;18" />
                <Face Color = "clGreen"     VertexIndexes = "21;20;28;29" />
                <Face Color = "clGreen"     VertexIndexes = "20;19;27;28" />
                <Face Color = "clGreen"     VertexIndexes = "19;18;26;27" />
                <Face Color = "clGreen"     VertexIndexes = "18;17;25;26" />
                <Face Color = "clLightBlue" VertexIndexes = "29;28;36;37" />
                <Face Color = "clLightBlue" VertexIndexes = "28;27;35;36" />
                <Face Color = "clLightBlue" VertexIndexes = "27;26;34;35" />
                <Face Color = "clLightBlue" VertexIndexes = "26;25;33;34" />
                <Face Color = "clRed1     " VertexIndexes = " 1; 0; 8; 9" />
                <Face Color = "clRed1     " VertexIndexes = " 0; 7;15; 8" />
                <Face Color = "clRed1     " VertexIndexes = " 7; 6;14;15" />
                <Face Color = "clRed1     " VertexIndexes = " 6; 5;13;14" />
                <Face Color = "clOrange1  " VertexIndexes = " 9; 8;16;17" />
                <Face Color = "clOrange1  " VertexIndexes = " 8;15;23;16" />
                <Face Color = "clOrange1  " VertexIndexes = "15;14;22;23" />
                <Face Color = "clOrange1  " VertexIndexes = "14;13;21;22" />
                <Face Color = "clDarkGreen" VertexIndexes = "17;16;24;25" />
                <Face Color = "clDarkGreen" VertexIndexes = "16;23;31;24" />
                <Face Color = "clDarkGreen" VertexIndexes = "23;22;30;31" />
                <Face Color = "clDarkGreen" VertexIndexes = "22;21;29;30" />
                <Face Color = "clBlue"      VertexIndexes = "25;24;32;33" />
                <Face Color = "clBlue"      VertexIndexes = "24;31;39;32" />
                <Face Color = "clBlue"      VertexIndexes = "31;30;38;39" />
                <Face Color = "clBlue"      VertexIndexes = "30;29;37;38" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />

        <Split><Plane NormVector = "x[0]; y[0]; 0"/></Split>
        <Split><Plane NormVector = "x[1]; y[1]; 0"/></Split>
        <Split><Plane NormVector = "x[2]; y[2]; 0"/></Split>
        <Split><Plane NormVector = "y[2];-x[2]; 0"/></Split>
        <Split><Plane NormVector = "y[0];-x[0]; 0"/></Split>

        <Circle Color = "ColorUp    " Radius = "RC" Center = "0; 0;  H + Delta" />
        <Circle Color = "ColorBottom" Radius = "RC" Center = "0; 0; -H - Delta" />
        <Split Axis = "1" From = "1" />

        <SaveSolvedState/> <!-- 1 solved state -->
		<Turn Axis = "0" From = "1" To = "4" Angle = "Pi/6"/>
        <SaveSolvedState/> <!-- 2 solved state -->
		<Turn Axis = "0" From = "1" To = "4" Angle = "Pi/6"/>
        <SaveSolvedState/> <!-- 3 solved state -->
		<Turn Axis = "0" From = "1" To = "4" Angle = "Pi/6"/>
        <SaveSolvedState/> <!-- 4 solved state -->
		<Turn Axis = "0" From = "1" To = "4" Angle = "Pi/6"/>
        <SaveSolvedState/> <!-- 5 solved state -->
		<Turn Axis = "0" From = "1" To = "4" Angle = "Pi/6"/>
        <SaveSolvedState/> <!-- 6 solved state -->
        <Undo/>

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

</xml>
