<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Marcos HT Square-1</Name>
        <Menu>Other forms\Square-1\Marcos HT Square-1</Menu>
        <Inventor>Li Chung Man</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2320</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W * tan(Pi/12); // = W * (2 - sqrt(3));
        C1 := W * 2 - D;
        C0 := C1 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi/12" />
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = "4;0;2" />
                <Face Color = "Colors[2]" VertexIndexes = "4;2;1" />
                <Face Color = "Colors[1]" VertexIndexes = "4;1;0" />

                <Face Color = "Colors[1]" VertexIndexes = "5;0;1" />
                <Face Color = "Colors[4]" VertexIndexes = "5;1;3" />
                <Face Color = "Colors[3]" VertexIndexes = "5;3;0" />

                <Face Color = "Colors[3]" VertexIndexes = "6;0;3" />
                <Face Color = "Colors[0]" VertexIndexes = "6;3;2" />
                <Face Color = "Colors[5]" VertexIndexes = "6;2;0" />

                <Face Color = "Colors[2]" VertexIndexes = "7;1;2" />
                <Face Color = "Colors[0]" VertexIndexes = "7;2;3" />
                <Face Color = "Colors[4]" VertexIndexes = "7;3;1" />
            </Faces>
        </Part>

        <Macro Name = "CutC" >
            <Cut Color = "Colors[i]" ><Plane NormVector = "-Cx[i];-Cy[i];-Cz[i]" NormDistance = "-W" /></Cut>
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "CutC" i = "0" Repeat = "6" />

        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = "-Pi/2" />
        <Split Axis = "0" From  = "1" />
        <Split Axis = "0" From  = "2" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Undo  Repeat = "4" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
