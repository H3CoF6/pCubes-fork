<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Nautilus 7b (Helix 7)</Name>
        <Class>TSquare1</Class> <!-- Scramble -->
        <Menu>Other forms\Square-1\Nautilus\Nautilus 7b (Helix 7)</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-09-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7968</Link>
    </Interface>

    <Script>
        NautilusExpansion := 1.5;
        W := 0.4;
        H := W * 0.5;
        D := H / 3;
        mAngle := 12 * Pi/180;
        sCount := 7;  // segments count
        AxisDirection := 54 * Pi/180;

        angles[0] := 36 * Pi/180; Colors[0] := 'AF00AF'; // Fuchsia
        angles[1] := 48 * Pi/180; Colors[1] := 'DC0000'; // Red
        angles[2] := 60 * Pi/180; Colors[2] := 'FF9600'; // Orange
        angles[3] := 72 * Pi/180; Colors[3] := 'E6C800'; // Yellow
        angles[4] := 60 * Pi/180; Colors[4] := '009600'; // Green
        angles[5] := 48 * Pi/180; Colors[5] := '0070DF'; // SkyBlue
        angles[6] := 36 * Pi/180; Colors[6] := '6400A8'; // Violett
    </Script>

    <Axes TurningAngles = "mAngle" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "AxisDirection" />

        <Macro Name = "AddSegment" >
            <HideAll/>
            <Script>Color := Colors[index];</Script>

            <Turn NormVector = "0; 0; 1" Angle = "-SumAngle" />
            <LoadFrom File = "Puzzles\Other forms\Square-1\Nautilus\_Macro_For_Nautilus.xml" H1 = "-H" H2 = "H" />
            <Turn NormVector = "0; 0; 1" Angle = "SumAngle" />

            <Cut Color = "Color"><Plane NormVector = " 0;-1; 0" /></Cut>
            <Turn NormVector = "0; 0; 1" Angle = "angles[index]" />
            <Cut Color = "Color"><Plane NormVector = " 0; 1; 0" /></Cut>
            <Script>SumAngle := SumAngle + angles[index]</Script>
            <Split Color1 = "Color" Color2 = "Color" Axis = "0" From = "1" />
            <Split Color1 = "Color" Color2 = "Color" Axis = "0" From = "2" />
            <Script>Inc(index); </Script>
        </Macro>
        <ExecMacro MacroName = "AddSegment" index = "0" SumAngle = "0" Repeat = "sCount" />

        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
