<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Prism Super AC (2 layers)</Name>
        <Menu>Other forms\Square-1\Star Prism Super AC (2 layers)</Menu>
        <Inventor>Aleksandra Franc</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3841</Link>
    </Interface>

    <Script>
        Colors[0] := '0011EE'; // Blue
        Colors[1] := 'EE0000'; // Red
        Colors[2] := '00BB00'; // Green

        Colors[3] := 'FFFF00'; // Yellow

        R := 0.7;
        rs := R * (sqrt(3) - 1) / 2;
        rc := rs * sqrt(3);

        N := 6;
        Angle := 2 * Pi / N;

        R2 := R * 0.35;
        H  := R * 0.3;
        H1 := H * 1.005;
    </Script>

    <Axes TurningAngles = "0; Angle; Angle; 0" PlaneDistances = "-H; 0; H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSector" >
            <Part>
                <Vertices>
                    <Add Vector = " 0;  0; H" />
                    <Add Vector = "rc;-rs; H" />
                    <Add Vector = " R;  0; H" />
                    <Add Vector = "rc; rs; H" />
                    <Add Vector = " 0;  0;-H" />
                    <Add Vector = "rc;-rs;-H" />
                    <Add Vector = " R;  0;-H" />
                    <Add Vector = "rc; rs;-H" />
                </Vertices>

                <Faces>
                    <Face Color = "Color" VertexIndexes = "0;1;2;3" />
                    <Face Color = "Color" VertexIndexes = "1;0;4;5" />
                    <Face Color = "Color" VertexIndexes = "2;1;5;6" />
                    <Face Color = "Color" VertexIndexes = "3;2;6;7" />
                    <Face Color = "Color" VertexIndexes = "0;3;7;4" />
                    <Face Color = "Color" VertexIndexes = "7;6;5;4" />
                </Faces>
            </Part>
            <Split Color1 = "Color" Color2 = "Color" Axis = "0" From = "2" />
            <Turn NormVector = "0; 0; 1" Angle = "Angle" />
        </Macro>
        <ExecMacro MacroName = "AddSector" Color = "Colors[0]" Repeat = "2" />
        <ExecMacro MacroName = "AddSector" Color = "Colors[1]" Repeat = "2" />
        <ExecMacro MacroName = "AddSector" Color = "Colors[2]" Repeat = "2" />

        <Circle Color = "Colors[3]" Radius = "R2" Center = "0; 0; -H1" />
        <Circle Color = "Colors[3]" Radius = "R2" Center = "0; 0;  H1" />
        <SplitByAxes/>

        <SaveSolvedState/>
        <Turn Axis = "0" Layers = "1;2" Angle = "Angle" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
