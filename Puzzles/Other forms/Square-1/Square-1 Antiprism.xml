<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square-1 Antiprism</Name>
        <Menu>Other forms\Antiprism\Square-1 Antiprism</Menu>
        <Menu>Other forms\Square-1\Square-1 Antiprism</Menu>
        <Inventor>César Gustavo Hernández Martínez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-01-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10566</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';
        clLime   := '00FF00';
        clBlue   := '0000FF';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clRed    := 'FF0000';
        clPurple := '800080';

        W := 0.45;
        H := W * 0.8;
        W2 := W * sqrt(2);

        D :=  H * (sqrt(3) - sqrt(2));
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi/12" />
        <Part>
            <Vertices>
                <Add Vector = "  W;  W; H" />
                <Add Vector = "  W; -W; H" />
                <Add Vector = " -W;  W; H" />
                <Add Vector = " -W; -W; H" />
                <Add Vector = " W2;  0;-H" />
                <Add Vector = "-W2;  0;-H" />
                <Add Vector = "  0; W2;-H" />
                <Add Vector = "  0;-W2;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "0;2;3;1" />
                <Face Color = "clYellow" VertexIndexes = "4;7;5;6" />
                <Face Color = "clRed   " VertexIndexes = "1;3;7" />
                <Face Color = "clBlue  " VertexIndexes = "1;7;4" />
                <Face Color = "clPurple" VertexIndexes = "0;1;4" />
                <Face Color = "clLime  " VertexIndexes = "0;4;6" />
                <Face Color = "clPink  " VertexIndexes = "2;0;6" />
                <Face Color = "clCyan  " VertexIndexes = "2;6;5" />
                <Face Color = "clOrange" VertexIndexes = "3;2;5" />
                <Face Color = "clGreen " VertexIndexes = "3;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/6" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Undo  Repeat = "4" />
    </Figure>
</xml>
