<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3 Square In 1</Name>
        <Menu>Other forms\Square-1\3 Square In 1</Menu>
        <Inventor>Olivier Polspoel</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2564</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        K := 0.12;
        WI := K * 3;
        WO := K * 2;
        HO := K * 5;
    </Script>

    <Axes TurningAngles = "Pi / 12" PlaneDistances = "-WI; 0; WI" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-WI; -WI; -WI" />
                <Add Vector = "-WI; -WI;  WI" />
                <Add Vector = "-WI;  WI; -WI" />
                <Add Vector = "-WI;  WI;  WI" />
                <Add Vector = " WI; -WI; -WI" />
                <Add Vector = " WI; -WI;  WI" />
                <Add Vector = " WI;  WI; -WI" />
                <Add Vector = " WI;  WI;  WI" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-HO; -WO; -WO" />
                <Add Vector = "-HO; -WO;  WO" />
                <Add Vector = "-HO;  WO; -WO" />
                <Add Vector = "-HO;  WO;  WO" />
                <Add Vector = "-WI; -WO; -WO" />
                <Add Vector = "-WI; -WO;  WO" />
                <Add Vector = "-WI;  WO; -WO" />
                <Add Vector = "-WI;  WO;  WO" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face                    VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "WI; -WO; -WO" />
                <Add Vector = "WI; -WO;  WO" />
                <Add Vector = "WI;  WO; -WO" />
                <Add Vector = "WI;  WO;  WO" />
                <Add Vector = "HO; -WO; -WO" />
                <Add Vector = "HO; -WO;  WO" />
                <Add Vector = "HO;  WO; -WO" />
                <Add Vector = "HO;  WO;  WO" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face                    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WO; -HO; -WO" />
                <Add Vector = "-WO; -HO;  WO" />
                <Add Vector = "-WO; -WI; -WO" />
                <Add Vector = "-WO; -WI;  WO" />
                <Add Vector = " WO; -HO; -WO" />
                <Add Vector = " WO; -HO;  WO" />
                <Add Vector = " WO; -WI; -WO" />
                <Add Vector = " WO; -WI;  WO" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face                    VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WO; WI; -WO" />
                <Add Vector = "-WO; WI;  WO" />
                <Add Vector = "-WO; HO; -WO" />
                <Add Vector = "-WO; HO;  WO" />
                <Add Vector = " WO; WI; -WO" />
                <Add Vector = " WO; WI;  WO" />
                <Add Vector = " WO; HO; -WO" />
                <Add Vector = " WO; HO;  WO" />
            </Vertices>

            <Faces>
                <Face                    VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WO; -WO; WI" />
                <Add Vector = "-WO; -WO; HO" />
                <Add Vector = "-WO;  WO; WI" />
                <Add Vector = "-WO;  WO; HO" />
                <Add Vector = " WO; -WO; WI" />
                <Add Vector = " WO; -WO; HO" />
                <Add Vector = " WO;  WO; WI" />
                <Add Vector = " WO;  WO; HO" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face                    VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WO; -WO; -HO" />
                <Add Vector = "-WO; -WO; -WI" />
                <Add Vector = "-WO;  WO; -HO" />
                <Add Vector = "-WO;  WO; -WI" />
                <Add Vector = " WO; -WO; -HO" />
                <Add Vector = " WO; -WO; -WI" />
                <Add Vector = " WO;  WO; -HO" />
                <Add Vector = " WO;  WO; -WI" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face                    VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Turn Axis = "0" Angle = "Pi / 12" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi / 12" Layer = "3" />
        <Turn Axis = "1" Angle = "Pi / 12" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi / 12" Layer = "3" />
        <Turn Axis = "2" Angle = "Pi / 12" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 12" Layer = "3" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-Pi / 6" Layer = "0" />
        <Turn Axis = "0" Angle = "-Pi / 6" Layer = "3" />
        <Turn Axis = "1" Angle = "-Pi / 6" Layer = "0" />
        <Turn Axis = "1" Angle = "-Pi / 6" Layer = "3" />
        <Turn Axis = "2" Angle = "-Pi / 6" Layer = "0" />
        <Turn Axis = "2" Angle = "-Pi / 6" Layer = "3" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "Pi / 12" Layer = "0" />
        <Turn Axis = "0" Angle = "Pi / 12" Layer = "3" />
        <Turn Axis = "1" Angle = "Pi / 12" Layer = "0" />
        <Turn Axis = "1" Angle = "Pi / 12" Layer = "3" />
        <Turn Axis = "2" Angle = "Pi / 12" Layer = "0" />
        <Turn Axis = "2" Angle = "Pi / 12" Layer = "3" />
    </Figure>
</xml>
