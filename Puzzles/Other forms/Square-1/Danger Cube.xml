<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Danger Cube</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Danger Cube</Menu>
        <Menu>Other forms\Square-1\Danger Cube</Menu>
        <Inventor>Matt Shepit</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-12-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2571</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFEE00';
        Colors[1] := 'CC0000';
        Colors[2] := 'EEEEEE';
        Colors[3] := '009900';

        K := 0.5;
        S15 := sin (-5*Pi/12);
        C15 := cos (-5*Pi/12);

        D := K * 0.3747898;
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; C15; S15" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <SplitByAxes/>
        <Undo Repeat = "3" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
