<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Herschel Enneahedron Cube</Name>
        <Menu>Other forms\Herschel Polyhedron\Herschel Enneahedron Cube</Menu>
        <Inventor>ironesp</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-13</Added>
        <Link>http://twistypuzzles.com/museum/museum_showitem.php?pkey=8651</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36565</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clBlue   := '0000EE';
        clLBlue  := '0077FF';
        clOrange := 'FF6000';
        clRed    := 'FF0000';
        clGreen  := '00DD00';
        clGray   := 'AAAAAA';
        clWhite  := 'FFFFFF';
        clPurple := 'AA00BB';

        R := 1.4;
        H := R / sqrt(3);
        RC := R / 4;

        for i := 0 to 2 do begin
            x[i] := R * sin(2*Pi/3 * i);
            y[i] := R * cos(2*Pi/3 * i);
        end;

         for i := 0 to 2 do begin
            ax[i] := sin(2*Pi/3 * i);
            ay[i] :=-cos(2*Pi/3 * i);
        end;
        az := sqrt(3) / 2;

        D  := R / (4*sqrt(7));

        A1 := ArcCos(1/8);
        A2 := ArcCos(-3/4);
    </Script>

     <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = " ax[0]; ay[0]; az" />
        <Axis NormVector = " ax[1]; ay[1]; az" />
        <Axis NormVector = " ax[2]; ay[2]; az" />
        <Axis NormVector = " ax[0]; ay[0];-az" />
        <Axis NormVector = " ax[1]; ay[1];-az" />
        <Axis NormVector = " ax[2]; ay[2];-az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; 0" />
                <Add Vector = "x[1]; y[1]; 0" />
                <Add Vector = "x[2]; y[2]; 0" />
                <Add Vector = "   0;    0; H" />
                <Add Vector = "   0;    0;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clLBlue " VertexIndexes = "0;3;1" />
                <Face Color = "clOrange" VertexIndexes = "1;3;2" />
                <Face Color = "clWhite " VertexIndexes = "2;3;0" />
                <Face Color = "clBlue  " VertexIndexes = "0;1;4" />
                <Face Color = "clPurple" VertexIndexes = "1;2;4" />
                <Face Color = "clGray  " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <Cut Color = "clRed   " ><Plane NormVector = "-x[0];-y[0]; 0" NormDistance = "-RC" /></Cut>
        <Cut Color = "clYellow" ><Plane NormVector = "-x[1];-y[1]; 0" NormDistance = "-RC" /></Cut>
        <Cut Color = "clGreen " ><Plane NormVector = "-x[2];-y[2]; 0" NormDistance = "-RC" /></Cut>

        <SplitByAxes/>
    </Figure>
</xml>
