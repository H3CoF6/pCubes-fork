    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = " 0; 1; 0" Angle = "-ArcTan(sqrt(2))" />

        <LoadFrom File = "Puzzles\Other forms\Egg\_Macro_For_Egg.xml" Color = "Colors[Random(7)]" Nx = "24" />

        <SplitByAxes/>
        
        <SaveSolvedState/>
    </Figure>
    
    <Procedures CheckSolved = "CheckSavedStates" />
