<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>The Incredible Dino Door unbandaged</Name>
        <Menu>Other forms\Antiprism\The Incredible Dino Door unbandaged</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos, Evgeniy Grigoriev</Programmer>
        <Added>2017-09-09</Added>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';
        clLime   := '00FF00';
        clBlue   := '0000FF';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clRed    := 'FF0000';
        clPurple := '800080';

        K  := 1.0;
        C0 := K * sqrt(2 * sqrt(2)) / 4;
        C1 := K * sqrt(2) / 2;
        C2 := K * 0.5;

        D := C0 * C2 / sqrt(4 * C0^2 + C2^2); // K * 0.21488

        A1 := arccos((-1 + sqrt(2)) / 2);
        A2 := arccos((1 - 2 * sqrt(2)) / 2);
        A3 := arccos(-2 + sqrt(2));
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "D" >
        <Axis NormVector = "  C2;  C2;  C0" />
        <Axis NormVector = "  C2; -C2;  C0" />
        <Axis NormVector = " -C2;  C2;  C0" />
        <Axis NormVector = " -C2; -C2;  C0" />
        <Axis NormVector = "  C1;   0; -C0" />
        <Axis NormVector = " -C1;   0; -C0" />
        <Axis NormVector = "   0;  C1; -C0" />
        <Axis NormVector = "   0; -C1; -C0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2;  C2;  C0" />
                <Add Vector = " C2; -C2;  C0" />
                <Add Vector = "-C2;  C2;  C0" />
                <Add Vector = "-C2; -C2;  C0" />
                <Add Vector = " C1;   0; -C0" />
                <Add Vector = "-C1;   0; -C0" />
                <Add Vector = "  0;  C1; -C0" />
                <Add Vector = "  0; -C1; -C0" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen " VertexIndexes = " 0; 2; 3; 1" />
                <Face Color = "clWhite " VertexIndexes = " 4; 7; 5; 6" />
                <Face Color = "clCyan  " VertexIndexes = " 1; 3; 7" />
                <Face Color = "clLime  " VertexIndexes = " 1; 7; 4" />
                <Face Color = "clYellow" VertexIndexes = " 0; 1; 4" />
                <Face Color = "clOrange" VertexIndexes = " 0; 4; 6" />
                <Face Color = "clRed   " VertexIndexes = " 2; 0; 6" />
                <Face Color = "clPurple" VertexIndexes = " 2; 6; 5" />
                <Face Color = "clPink  " VertexIndexes = " 3; 2; 5" />
                <Face Color = "clBlue  " VertexIndexes = " 3; 5; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split">
            <Turn  Axis = "a" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "b" Layer = "1" Angle = " A1" />
            <Turn  Axis = "a" Layer = "1" Angle = " A1" />
            <Turn  Axis = "b" Layer = "1" Angle = "-A1" />
            <Split Axis = "a" From  = "1"/>
            <Turn  Axis = "b" Layer = "1" Angle = " A1" />
            <Turn  Axis = "a" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "b" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "a" Layer = "1" Angle = " A1" />
        </Macro>

        <ExecMacro MacroName = "Split" a = "1" b = "3"/>
        <ExecMacro MacroName = "Split" a = "0" b = "1"/>
        <ExecMacro MacroName = "Split" a = "3" b = "2"/>
        <ExecMacro MacroName = "Split" a = "2" b = "0"/>
        <ExecMacro MacroName = "Split" a = "4" b = "6"/>
        <ExecMacro MacroName = "Split" a = "5" b = "7"/>
        <ExecMacro MacroName = "Split" a = "6" b = "5"/>
        <ExecMacro MacroName = "Split" a = "7" b = "4"/>
    </Figure>
</xml>
