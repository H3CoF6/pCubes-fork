<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentagonal Antiprism Pentultimate</Name>
        <Menu>Other forms\Antiprism\Pentagonal Antiprism Pentultimate</Menu>
        <Programmer>Skallos</Programmer>
        <Added>2022-01-28</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';
        clLime   := '00FF00';
        clBlue   := '0000FF';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clRed    := 'FF0000';
        clPurple := '800080';
        clOlive  := '808000';
        clNavy   := '000080';

        R := 0.85;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " Cx[5]; Cy[5]; Cz[5]" />
                <Add Vector = " Cx[4]; Cy[4]; Cz[4]" />
                <Add Vector = " Cx[3]; Cy[3]; Cz[3]" />
                <Add Vector = " Cx[2]; Cy[2]; Cz[2]" />
                <Add Vector = " Cx[1]; Cy[1]; Cz[1]" />
                <Add Vector = "-Cx[3];-Cy[3];-Cz[3]" />
                <Add Vector = "-Cx[2];-Cy[2];-Cz[2]" />
                <Add Vector = "-Cx[1];-Cy[1];-Cz[1]" />
                <Add Vector = "-Cx[5];-Cy[5];-Cz[5]" />
                <Add Vector = "-Cx[4];-Cy[4];-Cz[4]" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clWhite " VertexIndexes = "9;8;7;6;5" />
                <Face Color = "clCyan  " VertexIndexes = "1;0;6" />
                <Face Color = "clLime  " VertexIndexes = "2;1;7" />
                <Face Color = "clGreen " VertexIndexes = "3;2;8" />
                <Face Color = "clOrange" VertexIndexes = "4;3;9" />
                <Face Color = "clRed   " VertexIndexes = "0;4;5" />
                <Face Color = "clPurple" VertexIndexes = "0;5;6" />
                <Face Color = "clPink  " VertexIndexes = "1;6;7" />
                <Face Color = "clBlue  " VertexIndexes = "2;7;8" />
                <Face Color = "clOlive " VertexIndexes = "3;8;9" />
                <Face Color = "clNavy  " VertexIndexes = "4;9;5" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
