<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Square Antiprism</Name>
        <Menu>Other forms\Antiprism\Square Antiprism</Menu>
        <Inventor>Jiroscop</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-17</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=360723#p360723</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';
        clLime   := '00FF00';
        clBlue   := '0000FF';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clRed    := 'FF0000';
        clPurple := '800080';

        K  := 1;
        H := K * sqrt(2 * sqrt(2)) / 4;
        C1 := K * sqrt(2) / 2;
        C2 := K * 0.5;

        for i := 0 to 3 do begin
            ax[i] := sin(Pi/4 * i);
            ay[i] := cos(Pi/4 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
        <Axis NormVector = "ax[3]; ay[3]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2;  C2;  H" />
                <Add Vector = " C2; -C2;  H" />
                <Add Vector = "-C2;  C2;  H" />
                <Add Vector = "-C2; -C2;  H" />
                <Add Vector = " C1;   0; -H" />
                <Add Vector = "-C1;   0; -H" />
                <Add Vector = "  0;  C1; -H" />
                <Add Vector = "  0; -C1; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen " VertexIndexes = " 0; 2; 3; 1" />
                <Face Color = "clWhite " VertexIndexes = " 4; 7; 5; 6" />
                <Face Color = "clCyan  " VertexIndexes = " 1; 3; 7" />
                <Face Color = "clLime  " VertexIndexes = " 1; 7; 4" />
                <Face Color = "clYellow" VertexIndexes = " 0; 1; 4" />
                <Face Color = "clOrange" VertexIndexes = " 0; 4; 6" />
                <Face Color = "clRed   " VertexIndexes = " 2; 0; 6" />
                <Face Color = "clPurple" VertexIndexes = " 2; 6; 5" />
                <Face Color = "clPink  " VertexIndexes = " 3; 2; 5" />
                <Face Color = "clBlue  " VertexIndexes = " 3; 5; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
