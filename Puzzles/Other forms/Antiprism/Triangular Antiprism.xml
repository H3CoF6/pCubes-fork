<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triangular Antiprism</Name>
        <Menu>Other forms\Antiprism\Triangular Antiprism</Menu>
        <Menu>Other forms\Octahedron\Mixed\Triangular Antiprism</Menu>
        <Inventor>Jiroscop</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-17</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=360723#p360723</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        K  := 1.2;
        C0 := K * sqrt(3) / 6;
        C1 := K * sqrt(3) / 3;
        C2 := K * 0.5;
        C3 := K * 0.4;

        for i := 0 to 2 do begin
            ax[i] := sin(Pi / 3 * (i + 0.5));
            ay[i] := cos(Pi / 3 * (i + 0.5));
        end;
    </Script>

    <Axes TurningAngles = "2*Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2; -C0;  C3" />
                <Add Vector = "-C2; -C0;  C3" />
                <Add Vector = "  0;  C1;  C3" />
                <Add Vector = " C2;  C0; -C3" />
                <Add Vector = "-C2;  C0; -C3" />
                <Add Vector = "  0; -C1; -C3" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"  VertexIndexes = " 2; 1; 0" />
                <Face Color = "clYellow" VertexIndexes = " 5; 4; 3" />

                <Face Color = "clRed"    VertexIndexes = " 0; 1; 5" />
                <Face Color = "clBlue"   VertexIndexes = " 1; 2; 4" />
                <Face Color = "clGreen"  VertexIndexes = " 2; 0; 3" />

                <Face Color = "clOrange" VertexIndexes = " 3; 4; 2" />
                <Face Color = "clCyan"   VertexIndexes = " 4; 5; 1" />
                <Face Color = "clPink"   VertexIndexes = " 5; 3; 0" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
