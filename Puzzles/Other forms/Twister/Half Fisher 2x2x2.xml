<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half Fisher 2x2x2</Name>
        <Menu>Other forms\2x2x2 variants\Half Fisher 2x2x2</Menu>
        <Menu>Other forms\Twister\Half Fisher 2x2x2</Menu>
        <Inventor>Aleksandr Ermolenko</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6194</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        W2 := W * sqrt(2);
        N := 5;
        WX := W;
        WY := W;
        WZ := W * 0.001;

        // fill array
        x[0, 0] :=  W;
        x[0, N] :=  W2;
        x[N, 0] := -W;
        x[N, N] :=  0;
        y[0, 0] := -W;
        y[0, N] :=  0;
        y[N, 0] := -W;
        y[N, N] := -W2;
        for Row := 0 to N do begin
            z[Row] := -W + 2 * W / N * Row;
            x[0, Row] := x[0, 0] + (x[0, N] - x[0, 0]) / N * Row;
            y[0, Row] := y[0, 0] + (y[0, N] - y[0, 0]) / N * Row;
            x[N, Row] := x[N, 0] + (x[N, N] - x[N, 0]) / N * Row;
            y[N, Row] := y[N, 0] + (y[N, N] - y[N, 0]) / N * Row;

            for i := 1 to N - 1 do begin
              x[i, Row] := x[0, Row] + (x[N, Row] - x[0, Row]) / N * i;
              y[i, Row] := y[0, Row] + (y[N, Row] - y[0, Row]) / N * i;
            end;
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace" >
            <Part>
                <Vertices>
                    <Add Vector = " x[i, Row]; y[i, Row]; z[Row]" />
                    <Add Vector = " x[i + 1, Row + 1]; y[i + 1, Row + 1]; z[Row + 1]" />
                    <Add Vector = " x[i, Row + 1]; y[i, Row + 1]; z[Row + 1]" />
                    <Add Vector = " 0;0;0" />
                </Vertices>
                <Faces>
                    <Face Color = "colors[c1]" VertexIndexes = "0;2;1" InvisibleEdges = "Inv1" />
                    <Face Color = "0" VertexIndexes = "0;1;3" InvisibleEdges = "7" />
                    <Face Color = "0" VertexIndexes = "1;2;3" InvisibleEdges = "7" />
                    <Face Color = "0" VertexIndexes = "2;0;3" InvisibleEdges = "7" />
                </Faces>
            </Part>

            <Part>
                <Vertices>
                    <Add Vector = " x[i + 1, Row]; y[i + 1, Row]; z[Row]" />
                    <Add Vector = " x[i + 1, Row + 1]; y[i + 1, Row + 1]; z[Row + 1]" />
                    <Add Vector = " x[i, Row]; y[i, Row]; z[Row]" />
                    <Add Vector = " 0;0;0" />
                </Vertices>
                <Faces>
                    <Face Color = "colors[c1]" VertexIndexes = "0;2;1" InvisibleEdges = "Inv2" />
                    <Face Color = "0" VertexIndexes = "1;2;3" InvisibleEdges = "7" />
                    <Face Color = "0" VertexIndexes = "2;0;3" InvisibleEdges = "7" />
                    <Face Color = "0" VertexIndexes = "0;1;3" InvisibleEdges = "7" />
                </Faces>
            </Part>
            <Script>Inc(i);</Script>

        </Macro>

        <Macro Name = "AddFaceH" >
            <ExecMacro MacroName = "AddFace" i = "0  " Repeat = "1    " Inv1 = "6" Inv2 = "7" />
            <ExecMacro MacroName = "AddFace" i = "1  " Repeat = "N - 2" Inv1 = "7" Inv2 = "7" />
            <ExecMacro MacroName = "AddFace" i = "N-1" Repeat = "1    " Inv1 = "7" Inv2 = "3" />
            <Script>Inc(Row);</Script>
        </Macro>

        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "2" c2 = "1" Row = "0" />
        <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "0" c2 = "2" Row = "0" />
        <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "3" c2 = "0" Row = "0" />
        <Turn NormVector = "0;0;1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "1" c2 = "3" Row = "0" />
        <Turn NormVector = "0;0;1" Angle = "Pi / 2" />

        <Script>
            for i := 0 to 5 do
                Colors[i] := 0;
            Colors[5] := clWhite;
            DWZ := W + WZ; 
        </Script>
        <Turn NormVector = "0;0;1" Angle = "Pi / 4" />
        <LoadFrom File = "Figures\Cuboid.xml" />
        <Turn NormVector = "0;0;1" Angle = "-Pi / 4" />
        <Script>
            Colors[5] := 0;
            Colors[4] := clYellow;
            DWZ := -DWZ; 
        </Script>
        <LoadFrom File = "Figures\Cuboid.xml" />

        <Split Axis = "0" From = "1" Color1 = "0" Color2 = "0" />
        <Split Axis = "1" From = "1" Color1 = "0" Color2 = "0" />
        <Split Axis = "2" From = "1" Color1 = "0" Color2 = "0" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
