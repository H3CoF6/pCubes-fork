<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>FourCylinder 4x4x4</Name>
        <Menu>Other forms\Steinmetz\FourCylinder\FourCylinder 4x4x4</Menu>
        <Inventor>Alexandr Abalikhin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-11-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5477</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W := 0.6;
        N := 16;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "W*1.3" />

        <Macro Name = "Cut" >
            <Cut Color = "cl" InvisibleEdges = "-1" ><Plane NormVector = "-1; 1; 0" NormDistance = "-W" /></Cut>
            <Turn NormVector = " 1; 1; 1" Angle = " Pi / N / 3" />
        </Macro>

        <Macro Name = "Cut6" >
            <Turn NormVector = " 1; 1; 1" Angle = " Pi / N / 6" />
            <ExecMacro MacroName = "Cut" Repeat = "N" />
            <Turn NormVector = " 1; 1; 1" Angle = "-Pi / N / 6" />
        </Macro>

        <Macro Name = "CutCylinder" >
            <ExecMacro MacroName = "Cut6" cl="Colors[c1]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c2]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c3]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c4]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c5]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c6]"/>
            <Turn NormVector = " 0; 0; 1" Angle = " Pi / 2" />
        </Macro>

        <ExecMacro MacroName = "CutCylinder" c1 = "20" c2 = " 2" c3 = "12" c4 = "17" c5 = " 5" c6 = "11" />
        <ExecMacro MacroName = "CutCylinder" c1 = "15" c2 = " 1" c3 = "19" c4 = " 8" c5 = " 6" c6 = "22" />
        <ExecMacro MacroName = "CutCylinder" c1 = "18" c2 = " 0" c3 = "10" c4 = "23" c5 = " 7" c6 = "13" />
        <ExecMacro MacroName = "CutCylinder" c1 = " 9" c2 = " 3" c3 = "21" c4 = "14" c5 = " 4" c6 = "16" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
