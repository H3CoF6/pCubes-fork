<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>FourCylinder 2x2x2</Name>
        <Menu>Other forms\Steinmetz\FourCylinder\FourCylinder 2x2x2</Menu>
        <Menu>Other forms\2x2x2 variants\FourCylinder</Menu>
        <Inventor>Alexandr Abalikhin</Inventor>
        <Programmer>Skallos, Boris</Programmer>
        <Added>2024-09-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5475</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.6;
        N := 16;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = " 0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "W*1.3" />

        <Macro Name = "Cut" >
            <Cut Color = "cl" InvisibleEdges = "-1" ><Plane NormVector = "-1; 1; 0" NormDistance = "-W" /></Cut>
            <Turn NormVector = " 1; 1; 1" Angle = " Pi / N / 3" />
        </Macro>

        <Macro Name = "Cut6" >
            <Turn NormVector = " 1; 1; 1" Angle = " Pi / N / 6" />
            <ExecMacro MacroName = "Cut" Repeat = "N" />
            <Turn NormVector = " 1; 1; 1" Angle = "-Pi / N / 6" />
        </Macro>

        <Macro Name = "CutCylinder" >
            <ExecMacro MacroName = "Cut6" cl="Colors[c1]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c2]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c3]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c4]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c5]"/>
            <ExecMacro MacroName = "Cut6" cl="Colors[c6]"/>
            <Turn NormVector = " 0; 0; 1" Angle = " Pi / 2" />
        </Macro>

        <ExecMacro MacroName = "CutCylinder" c1 = "2" c2 = "5" c3 = "0" c4 = "3" c5 = "4" c6 = "1" />
        <ExecMacro MacroName = "CutCylinder" c1 = "0" c2 = "5" c3 = "3" c4 = "1" c5 = "4" c6 = "2" />
        <ExecMacro MacroName = "CutCylinder" c1 = "3" c2 = "5" c3 = "1" c4 = "2" c5 = "4" c6 = "0" />
        <ExecMacro MacroName = "CutCylinder" c1 = "1" c2 = "5" c3 = "2" c4 = "0" c5 = "4" c6 = "3" />

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
