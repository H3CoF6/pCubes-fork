<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SixCylinder Megaminx V1</Name>
        <Menu>Other forms\Steinmetz\SixCylinder\SixCylinder Megaminx V1</Menu>
        <Inventor>Alexandr Abalikhin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-11-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5559</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'F0F0F0'; // White      
        Colors[ 1] := '008000'; // Green      
        Colors[ 2] := 'FF69B4'; // Pink       
        Colors[ 3] := '0000FF'; // Blue       
        Colors[ 4] := 'FF0000'; // Red        
                                          
        Colors[ 5] := 'C0C0C0'; // Gainsboro  
        Colors[ 6] := 'DA70D6'; // Orchid     
        Colors[ 7] := 'FFFF00'; // Yellow     
        Colors[ 8] := 'CD5C5C'; // Indian     
        Colors[ 9] := '006400'; // DarkGreen  
                                          
        Colors[10] := 'A0A0A0'; // Silver     
        Colors[11] := 'F0E68C'; // Khaki      
        Colors[12] := '00FFFF'; // Cyan       
        Colors[13] := '3cb371'; // SeaGreen   
        Colors[14] := '800080'; // Purple     
                                          
        Colors[15] := '707070'; // Gray       
        Colors[16] := '008080'; // Teal       
        Colors[17] := 'FF7F50'; // Coral      
        Colors[18] := 'D07090'; // Pale       
        Colors[19] := 'FF6000'; // Orange     
                                          
        Colors[20] := '202020'; // Black      
        Colors[21] := 'DC143C'; // Crimson    
        Colors[22] := 'ADFF2F'; // GreenYellow
        Colors[23] := 'DDBB20'; // Golden     
        Colors[24] := '00BFFF'; // DeepSky    
                                          
        Colors[25] := '808000'; // Olive      
        Colors[26] := '800000'; // Brown      
        Colors[27] := 'FF00FF'; // Fuchsia    
        Colors[28] := '000080'; // Navy       
        Colors[29] := '00FF00'; // Lime       

        R := 0.6;

        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := R * 0.63;

        N := 6;
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "R * 1.3" />

        <Macro Name = "Cut" >
            <Cut Color = "cl" InvisibleEdges = "-1" ><Plane NormVector = "0; 1; -2" NormDistance = "-R" /></Cut>
            <Turn NormVector = "0; 2; 1" Angle = " Pi / N / 5" />   <!-- <0; 1; -2> = (C0 x C1) x (C1) -->
        </Macro>
        <Macro Name = "Cut10" >
            <ExecMacro MacroName = "Cut" Repeat = "N" />
        </Macro>

        <Macro Name = "CutCylinder" >
            <Turn NormVector = "0; 2; 1" Angle = " Pi / 10 * (1 / N - 1)" /> <!-- "<0; 2; 1> = <Cx[1];Cy[1];Cz[1]> -->
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 0]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 1]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 2]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 3]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 4]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 0]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 1]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 2]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 3]" />
            <ExecMacro MacroName = "Cut10" cl = "Colors[c + 4]" />
            <Turn NormVector = "0; 2; 1" Angle = "-Pi / 10 * (1 / N - 1)" />
            <Turn NormVector = " 0; 0; 1" Angle = " 2 * Pi / 5" />
        </Macro>

        <ExecMacro MacroName = "CutCylinder" c = " 0" />
        <ExecMacro MacroName = "CutCylinder" c = " 5" />
        <ExecMacro MacroName = "CutCylinder" c = "10" />
        <ExecMacro MacroName = "CutCylinder" c = "15" />
        <ExecMacro MacroName = "CutCylinder" c = "20" />
        <Turn NormVector = "Ex[20];Ey[20];Ez[20]" Angle = " Pi" />
        <ExecMacro MacroName = "CutCylinder" c = "25" />
        <Turn NormVector = " 0; 0; 1" Angle = "-2 * Pi / 5" />
        <Turn NormVector = "Ex[20];Ey[20];Ez[20]" Angle = " Pi" />

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
