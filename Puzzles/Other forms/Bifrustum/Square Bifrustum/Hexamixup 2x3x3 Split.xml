<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexamixup 2x3x3 Split</Name>
        <Menu>Other forms\Bifrustum\Square Bifrustum\Hexamixup 2x3x3 Split</Menu>
        <Inventor>Marcell Mágori</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-07-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11810</Link>
    </Interface>

    <Script>
        clBlack  := '202020';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clCoral  := 'FF7F50';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGolden := 'DDBB20';
        clLime   := '00FF00';
        clGreen  := '008000';

        W  := 0.5;
        A1 := W / 2;
        A2 := W;
        A3 := W * sqrt(3) / 2;

        D := W * 0.3;
    </Script>

    <Axes TurningAngles = " Pi; Pi/6; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
    <Axes TurningAngles = " Pi/2" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " A1; A1; A3" />
                <Add Vector = " A1;-A1; A3" />
                <Add Vector = "-A1;-A1; A3" />
                <Add Vector = "-A1; A1; A3" />

                <Add Vector = " A2; A2;  0" />
                <Add Vector = " A2;-A2;  0" />
                <Add Vector = "-A2;-A2;  0" />
                <Add Vector = "-A2; A2;  0" />

                <Add Vector = " A1; A1;-A3" />
                <Add Vector = " A1;-A1;-A3" />
                <Add Vector = "-A1;-A1;-A3" />
                <Add Vector = "-A1; A1;-A3" />
            </Vertices>

            <Faces>
                <Face Color = "clBlack " VertexIndexes = " 0; 3; 2; 1" />

                <Face Color = "clRed   " VertexIndexes = " 0; 1; 5; 4" />
                <Face Color = "clGreen " VertexIndexes = " 1; 2; 6; 5" />
                <Face Color = "clGolden" VertexIndexes = " 2; 3; 7; 6" />
                <Face Color = "clCyan  " VertexIndexes = " 3; 0; 4; 7" />

                <Face Color = "clOrange" VertexIndexes = " 4; 5; 9; 8" />
                <Face Color = "clBlue  " VertexIndexes = " 5; 6;10; 9" />
                <Face Color = "clCoral " VertexIndexes = " 6; 7;11;10" />
                <Face Color = "clLime  " VertexIndexes = " 7; 4; 8;11" />

                <Face Color = "clYellow" VertexIndexes = " 8; 9;10;11" />
            </Faces>
        </Part>

        <Macro Name = "Split" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi/3 * x" />
            <Turn Axis = "1" Layer = "1" Angle = " Pi/3 * y" />

            <Split Axis = "0" From = "1" />
            <Split Axis = "0" From = "2" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "1" From = "2" />
            <Split Axis = "2" From = "1" />

            <Turn Axis = "0" Layer = "1" Angle = " Pi/2" />
            <Split Axis = "2" From = "1" />
            <Undo/>
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2" />
            <Split Axis = "2" From = "1" />
            <Undo/>

            <Turn Axis = "0" Layer = "1" Angle = " Pi/3" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "1" From = "2" />
            <Undo/>
            <Turn Axis = "0" Layer = "1" Angle = "-Pi/3" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "1" From = "2" />
            <Undo/>
            <Turn Axis = "1" Layer = "1" Angle = " Pi/3" />
            <Split Axis = "0" From = "1" />
            <Split Axis = "0" From = "2" />
            <Undo/>
            <Turn Axis = "1" Layer = "1" Angle = "-Pi/3" />
            <Split Axis = "0" From = "1" />
            <Split Axis = "0" From = "2" />
            <Undo/>
            <RemoveGrayParts/>

            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Split" x = "0" y = "0" />
        <ExecMacro MacroName = "Split" x = "1" y = "0" />
        <ExecMacro MacroName = "Split" x = "2" y = "0" />
        <ExecMacro MacroName = "Split" x = "0" y = "1" />
        <ExecMacro MacroName = "Split" x = "0" y = "2" />
    </Figure>
</xml>
	