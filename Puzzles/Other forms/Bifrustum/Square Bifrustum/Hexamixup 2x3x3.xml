<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexamixup 2x3x3</Name>
        <Menu>Other forms\Bifrustum\Square Bifrustum\Hexamixup 2x3x3</Menu>
        <Inventor>Marcell Mágori</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-04-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8417</Link>
    </Interface>

    <Script>
        clBlack  := '202020';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clCoral  := 'FF7F50';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGolden := 'DDBB20';
        clLime   := '00FF00';
        clGreen  := '008000';

        K := 1;
        s3 := sqrt(3);

        nA1 := K * 0.25;
        nA2 := K * 0.5;
        nA3 := K * s3 / 4;

        D := K / 4 * (s3 * (2 - s3));
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi; Pi/3; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " nA1; nA1; nA3" />
                <Add Vector = " nA1;-nA1; nA3" />
                <Add Vector = "-nA1;-nA1; nA3" />
                <Add Vector = "-nA1; nA1; nA3" />

                <Add Vector = " nA2; nA2;   0" />
                <Add Vector = " nA2;-nA2;   0" />
                <Add Vector = "-nA2;-nA2;   0" />
                <Add Vector = "-nA2; nA2;   0" />

                <Add Vector = " nA1; nA1;-nA3" />
                <Add Vector = " nA1;-nA1;-nA3" />
                <Add Vector = "-nA1;-nA1;-nA3" />
                <Add Vector = "-nA1; nA1;-nA3" />
            </Vertices>

            <Faces>
                <Face Color = "clBlack " VertexIndexes = " 0; 3; 2; 1" />

                <Face Color = "clRed   " VertexIndexes = " 0; 1; 5; 4" />
                <Face Color = "clGreen " VertexIndexes = " 1; 2; 6; 5" />
                <Face Color = "clGolden" VertexIndexes = " 2; 3; 7; 6" />
                <Face Color = "clCyan  " VertexIndexes = " 3; 0; 4; 7" />

                <Face Color = "clOrange" VertexIndexes = " 4; 5; 9; 8" />
                <Face Color = "clBlue  " VertexIndexes = " 5; 6;10; 9" />
                <Face Color = "clCoral " VertexIndexes = " 6; 7;11;10" />
                <Face Color = "clLime  " VertexIndexes = " 7; 4; 8;11" />

                <Face Color = "clYellow" VertexIndexes = " 8; 9;10;11" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "1" Angle = "Pi/3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "1" Angle = "-2*Pi/3" Layer = "1" />
            <SplitByAxes/>
            <Undo Repeat = "2" />

            <Turn Axis = "2" Angle = "Pi/3" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "2" Angle = "-2*Pi/3" Layer = "1" />
            <SplitByAxes/>
            <Undo Repeat = "2" />

            <RemoveGrayParts/>
        </Macro>
        <ExecMacro MacroName = "Split"/>

        <Turn Axis = "1" Angle = "Pi/3" Layer = "1" />
        <ExecMacro MacroName = "Split"/>
        <Turn Axis = "1" Angle = "Pi/3" Layer = "1" />
        <ExecMacro MacroName = "Split"/>
        <Undo Repeat = "2" />

        <Turn Axis = "2" Angle = "Pi/3" Layer = "1" />
        <ExecMacro MacroName = "Split"/>
        <Turn Axis = "2" Angle = "Pi/3" Layer = "1" />
        <ExecMacro MacroName = "Split"/>
        <Undo Repeat = "2" />
    </Figure>
</xml>
