<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>PanKu SKewb</Name>
        <Menu>Other forms\Skewb variants\Panku Skewb</Menu>
        <Menu>Other forms\Bifrustum\Square Bifrustum\PanKu Skewb</Menu>
        <Inventor>Wu Zhe</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-10-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12060</Link>
    </Interface>

    <Script>
        clBlack  := '202020';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clCoral  := 'FF7F50';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGolden := 'DDBB20';
        clLime   := '00FF00';
        clGreen  := '008000';

        W  := 0.55;
        W1 := W * 0.3;
        H  := W * 1.1;

        D1 := W1 / 5;
        D2 := D1 * 3;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W1; W1; H" />
                <Add Vector = " W1;-W1; H" />
                <Add Vector = "-W1;-W1; H" />
                <Add Vector = "-W1; W1; H" />

                <Add Vector = "  W;  W; 0" />
                <Add Vector = "  W; -W; 0" />
                <Add Vector = " -W; -W; 0" />
                <Add Vector = " -W;  W; 0" />

                <Add Vector = " W1; W1;-H" />
                <Add Vector = " W1;-W1;-H" />
                <Add Vector = "-W1;-W1;-H" />
                <Add Vector = "-W1; W1;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlack " VertexIndexes = " 0; 3; 2; 1" />

                <Face Color = "clRed   " VertexIndexes = " 0; 1; 5; 4" />
                <Face Color = "clGreen " VertexIndexes = " 1; 2; 6; 5" />
                <Face Color = "clGolden" VertexIndexes = " 2; 3; 7; 6" />
                <Face Color = "clCyan  " VertexIndexes = " 3; 0; 4; 7" />

                <Face Color = "clOrange" VertexIndexes = " 4; 5; 9; 8" />
                <Face Color = "clBlue  " VertexIndexes = " 5; 6;10; 9" />
                <Face Color = "clCoral " VertexIndexes = " 6; 7;11;10" />
                <Face Color = "clLime  " VertexIndexes = " 7; 4; 8;11" />

                <Face Color = "clYellow" VertexIndexes = " 8; 9;10;11" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
