<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octacle (Pillowed)</Name>
        <Menu>Other forms\Pillowed\Octahedron\Octacle (Pillowed)</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-03-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6037</Link>
    </Interface>

    <Script>
        Colors[3] := '00FF00'; // clGreen1
        Colors[1] := '0088FF'; // clBlue2
        Colors[7] := '0000EE'; // clBlue3
        Colors[4] := '8800DD'; // clViolett
        Colors[6] := '007700'; // clGreen3
        Colors[5] := 'FF0000'; // clRed
        Colors[0] := 'FF6000'; // clOrange
        Colors[2] := 'FFFF00'; // clYellow

        W := 0.6;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';

        K := W * 0.8; // pillow tetrahedron
        f1 := W * 0.5;

        A1 := arccos(-1/9);
        A2 := arccos(-2/3);

        D := W * 0.88;
        DCut := W * 0.9;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "-D; D" FixedLayers = "1">
        <Axis NormVector = " 0; 1; 2" />
        <Axis NormVector = " 1; 0; 2" />
        <Axis NormVector = " 0;-1; 2" />
        <Axis NormVector = "-1; 0; 2" />

        <Axis NormVector = " 0; 2; 1" />
        <Axis NormVector = " 1; 2; 0" />
        <Axis NormVector = " 0; 2;-1" />
        <Axis NormVector = "-1; 2; 0" />

        <Axis NormVector = " 2; 0; 1" />
        <Axis NormVector = " 2; 1; 0" />
        <Axis NormVector = " 2; 0;-1" />
        <Axis NormVector = " 2;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />

        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "0" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "0" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "0" /></Split>

        <RemoveContaining Vector = "-f1;-f1;-f1" />
        <RemoveContaining Vector = " f1;-f1; f1" />
        <RemoveContaining Vector = " f1; f1;-f1" />
        <RemoveContaining Vector = "-f1; f1; f1" />

        <Turn NormVector = "0;0;1" Angle = "Pi/2" />

        <HideAll/>

        <Script>
            Colors[0] := Colors[4];
            Colors[1] := Colors[5];
            Colors[2] := Colors[6];
            Colors[3] := Colors[7];
        </Script>

        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />

        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "0" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "0" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "0" /></Split>

        <RemoveContaining Vector = "-f1;-f1;-f1" />
        <RemoveContaining Vector = " f1;-f1; f1" />
        <RemoveContaining Vector = " f1; f1;-f1" />
        <RemoveContaining Vector = "-f1; f1; f1" />

        <ShowAll/>
        <SplitByAxes/>
        <Hide><Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /></Hide>
        <InvertVisibility/>
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
