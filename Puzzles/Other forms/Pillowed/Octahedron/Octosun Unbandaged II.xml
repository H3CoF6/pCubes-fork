    <Script>
        Colors[0] := 'FF6000'; // Orange
        Colors[1] := '0088FF'; // Blue2
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := '00FF00'; // Green1
        Colors[4] := '8800DD'; // Violett
        Colors[5] := 'FF0000'; // Red
        Colors[6] := '007700'; // Green3
        Colors[7] := '0000EE'; // Blue3

        K := 0.4;

        A1 := ArcCos(-1/9);
        A2 := ArcCos(-2/3);

        D := K * 1.385;

        f1 := K * 0.1;
        Pillow := 1.49;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 2" />
        <Axis NormVector = " 1; 0; 2" />
        <Axis NormVector = " 0;-1; 2" />
        <Axis NormVector = "-1; 0; 2" />

        <Axis NormVector = " 0; 2; 1" />
        <Axis NormVector = " 1; 2; 0" />
        <Axis NormVector = " 0; 2;-1" />
        <Axis NormVector = "-1; 2; 0" />

        <Axis NormVector = " 2; 0; 1" />
        <Axis NormVector = " 2; 1; 0" />
        <Axis NormVector = " 2; 0;-1" />
        <Axis NormVector = " 2;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "..\Tetrahedron\_Macro_Pillowed_Tetrahedron_v2.xml" />
        <ExecMacro MacroName = "CalcCoordinates" />

        <Macro Name = "AddHalf">
            <ExecMacro MacroName = "AddPillowedTetrahedron" />

            <Split><Plane NormVector = " 1; 0; 0" NormDistance = "0" /></Split>
            <Split><Plane NormVector = " 0; 1; 0" NormDistance = "0" /></Split>
            <Split><Plane NormVector = " 0; 0; 1" NormDistance = "0" /></Split>

            <RemoveContaining Vector = "-f1;-f1;-f1" />
            <RemoveContaining Vector = " f1;-f1; f1" />
            <RemoveContaining Vector = " f1; f1;-f1" />
            <RemoveContaining Vector = "-f1; f1; f1" />
        </Macro>
        <ExecMacro MacroName = "AddHalf" />

        <Turn NormVector = "0;0;1" Angle = "Pi/2" />

        <HideAll/>

        <Script>
            Colors[0] := Colors[4];
            Colors[1] := Colors[5];
            Colors[2] := Colors[6];
            Colors[3] := Colors[7];
        </Script>

        <ExecMacro MacroName = "AddHalf" />

        <ShowAll/>
        <SplitByAxes/>


        <Macro Name = "unbandage1">
            <Turn Axis = "ax1" Layer = "l1" Angle = "-f1 * A2" />
            <Turn Axis = "ax2" Layer = "l2" Angle = " f2 * (A1 + A2)" />
            <Turn Axis = "ax1" Layer = "l1" Angle = " f1 * A2" />
            <Turn Axis = "ax2" Layer = "l2" Angle = " f2 * A2" />
            <Turn Axis = "ax3" Layer = "l3" Angle = " f3 * (A1 + 2 * A2)" />
            <Turn Axis = "ax2" Layer = "l2" Angle = " f2 * A2" />
            <Turn Axis = "ax3" Layer = "l3" Angle = "-f3 * A2" />
            <Turn Axis = "ax2" Layer = "l2" Angle = "-f2 * A2" />
            <Turn Axis = "ax3" Layer = "l3" Angle = " f3 * A2" />
            <SplitByAxes />
            <Undo Repeat = "9" />
        </Macro>

        <ExecMacro MacroName = "unbandage1" ax1 = " 8" ax2 = " 1" ax3 = "0" l1 = "2" l2 = "2" l3 = "2" f1 = " 1" f2 = " 1" f3 = " 1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 8" ax2 = " 1" ax3 = "0" l1 = "0" l2 = "0" l3 = "0" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 8" ax2 = " 1" ax3 = "2" l1 = "2" l2 = "2" l3 = "2" f1 = "-1" f2 = "-1" f3 = "-1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 8" ax2 = " 1" ax3 = "2" l1 = "0" l2 = "0" l3 = "0" />
        <ExecMacro MacroName = "unbandage1" ax1 = "10" ax2 = " 3" ax3 = "0" l1 = "2" l2 = "0" l3 = "0" f1 = " 1" f2 = "-1" f3 = "-1" />
        <ExecMacro MacroName = "unbandage1" ax1 = "10" ax2 = " 3" ax3 = "0" l1 = "0" l2 = "2" l3 = "2" f1 = " 1" f2 = "-1" f3 = "-1" />
        <ExecMacro MacroName = "unbandage1" ax1 = "10" ax2 = " 3" ax3 = "2" l1 = "2" l2 = "0" l3 = "0" f1 = "-1" f2 = " 1" f3 = " 1" />
        <ExecMacro MacroName = "unbandage1" ax1 = "10" ax2 = " 3" ax3 = "2" l1 = "0" l2 = "2" l3 = "2" f1 = "-1" f2 = " 1" f3 = " 1" />

        <ExecMacro MacroName = "unbandage1" ax1 = " 0" ax2 = " 4" ax3 = "7" l1 = "0" l2 = "0" l3 = "0" f1 = "-1" f2 = "-1" f3 = "-1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 0" ax2 = " 4" ax3 = "7" l1 = "2" l2 = "2" l3 = "2" f1 = "-1" f2 = "-1" f3 = "-1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 0" ax2 = " 4" ax3 = "5" l1 = "0" l2 = "0" l3 = "0" f1 = " 1" f2 = " 1" f3 = " 1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 0" ax2 = " 4" ax3 = "5" l1 = "2" l2 = "2" l3 = "2" f1 = " 1" f2 = " 1" f3 = " 1" />

        <ExecMacro MacroName = "unbandage1" ax1 = " 2" ax2 = " 6" ax3 = "7" l1 = "0" l2 = "2" l3 = "2" f1 = "-1" f2 = " 1" f3 = " 1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 2" ax2 = " 6" ax3 = "7" l1 = "2" l2 = "0" l3 = "0" f1 = "-1" f2 = " 1" f3 = " 1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 2" ax2 = " 6" ax3 = "5" l1 = "0" l2 = "2" l3 = "2" f1 = " 1" f2 = "-1" f3 = "-1" />
        <ExecMacro MacroName = "unbandage1" ax1 = " 2" ax2 = " 6" ax3 = "5" l1 = "2" l2 = "0" l3 = "0" f1 = " 1" f2 = "-1" f3 = "-1" />

