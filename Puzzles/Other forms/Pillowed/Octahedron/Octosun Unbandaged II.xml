<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octosun Unbandaged II</Name>
        <Menu>Other forms\Pillowed\Octahedron\Octosun Unbandaged II</Menu>
