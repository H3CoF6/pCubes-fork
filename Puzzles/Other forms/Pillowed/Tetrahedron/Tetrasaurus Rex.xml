    <Script>
        K := 0.5;
        
        D1 := K * 0.3725157448543; // D1 := (2 * C13 + C21) / sqrt(27);
        D2 := -D1/4;

        Colors[0] := 'EEEEEE';
        Colors[1] := 'FF7700';
        Colors[2] := '0033EE';
        Colors[3] := '007700';
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D1; D2" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
