<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetra-1</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Tetra-1</Menu>
        <Inventor>Clayton Ertley</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3177</Link>
    </Interface>

    <Script>
        K := 0.5;
        D1 := -0.2 * K;
        D2 :=  0.9 * K;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D1; D2" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

</xml>
