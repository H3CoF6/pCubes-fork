<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Split Jing's Pyraminx (Pillowed)</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Split Jing's Pyraminx</Menu>
        <Inventor>James William Turner</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3402</Link>
    </Interface>

    <Script>
        K := 0.5;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <Turn  Axis = "0" Angle = "Pi / 3" Layer = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />
        <Undo Repeat ="1"/>

        <Turn  Axis = "1" Angle = "Pi / 3" Layer = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "0" From = "1" />
        <Undo Repeat ="1"/>

        <Turn  Axis = "2" Angle = "Pi / 3" Layer = "1" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Undo Repeat ="1"/>

        <Turn  Axis = "3" Angle = "Pi / 3" Layer = "1" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Undo Repeat ="1"/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
