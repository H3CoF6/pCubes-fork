<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Outlander 3D</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Outlander 3D</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-05-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11136</Link>
    </Interface>

    <Script>
        Colors[0] := '00CC00';
        Colors[1] := '0099EE';
        Colors[2] := 'CC0055';
        Colors[3] := 'FFFFFF';

        K  := 0.5;

        D1 := K * 0.6;
        D2 := K * 0.93;

        DCut1 := K * 1.2;
        DCut2 := K * 1.3;
        DCut3 := K * 0.4;
    </Script>
 
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D2" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <Hide><Plane NormVector = "-1;-1;-1" NormDistance = "-D1" /></Hide>
        <Hide><Plane NormVector = " 1; 1;-1" NormDistance = "-D1" /></Hide>
        <Hide><Plane NormVector = " 1;-1; 1" NormDistance = "-D1" /></Hide>
        <Hide><Plane NormVector = "-1; 1; 1" NormDistance = "-D1" /></Hide>
        <InvertVisibility/>

        <Cut><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut1" /></Cut>
        <Cut><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut1" /></Cut>
        <Cut><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut1" /></Cut>
        <Cut><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut1" /></Cut>
        <ShowAll/>

        <RemoveContaining Vector = "-K;-K;-K" />
        <RemoveContaining Vector = " K; K;-K" />
        <RemoveContaining Vector = " K;-K; K" />
        <RemoveContaining Vector = "-K; K; K" />

        <Hide><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut3" /></Hide>
        <Hide><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut3" /></Hide>
        <Hide><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut3" /></Hide>
        <Hide><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut3" /></Hide>
        <Cut Color = "Colors[3]" ><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[0]" ><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[1]" ><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[2]" ><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut2" /></Cut>
        <ShowAll/>
        <Cut><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut2" /></Cut>
        <Cut><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut2" /></Cut>
        <Cut><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut2" /></Cut>
        <Cut><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut2" /></Cut>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
