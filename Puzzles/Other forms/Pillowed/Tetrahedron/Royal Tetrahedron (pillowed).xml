<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Royal Tetrahedron (pillowed)</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Royal Tetrahedron</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2006</Link>
    </Interface>

    <Script>
        K := 0.5;

        N := 4;
        D0 := -0.48 * K;
        D := 4 / sqrt(3) / (3 * N + 1) * K;
        D1 := D0 + D;
        D2 := D0 + 2 * D;
        D3 := D0 + 3 * D;
        D4 := D0 + 4 * D;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D1; D2; D3; D4" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

</xml>
