<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Pyraminx</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Super Pyraminx</Menu>
        <Inventor>Yong Xue Dong</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4427</Link>
    </Interface>

    <Script>
        K := 0.5;

        D1 := 0.43 * K;
        D2 := 1.22 * K;

        C1 := K * 0.3;
        C2 := K * 1.4;
    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D1; D2" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = " Pi/3" />
        <SplitByAxes/>
        <Undo/>

        <Turn Axis = "1" Layer = "1" Angle = " Pi/3" />
        <SplitByAxes/>
        <Undo/>

        <Turn Axis = "2" Layer = "1" Angle = " Pi/3" />
        <SplitByAxes/>
        <Undo/>

        <Turn Axis = "3" Layer = "1" Angle = " Pi/3" />
        <SplitByAxes/>
        <Undo/>

        <RemoveContaining Vector = " C1;-C1; C2" />
        <RemoveContaining Vector = "-C1; C1; C2" />
        <RemoveContaining Vector = "-C1;-C1;-C2" />
        <RemoveContaining Vector = " C1; C1;-C2" />
        <RemoveContaining Vector = " C1;-C2; C1" />
        <RemoveContaining Vector = "-C1;-C2;-C1" />
        <RemoveContaining Vector = "-C1; C2; C1" />
        <RemoveContaining Vector = " C1; C2;-C1" />
        <RemoveContaining Vector = " C2;-C1; C1" />
        <RemoveContaining Vector = " C2; C1;-C1" />
        <RemoveContaining Vector = "-C2;-C1;-C1" />
        <RemoveContaining Vector = "-C2; C1; C1" />
        <RemoveContaining Vector = " 0; 0; 0" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

</xml>
