<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x2 Transform pyraminx standard</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\2x2x2 Transform pyraminx standard</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7190</Link>
    </Interface>

    <Script>
        Colors[0] := 'EE0000';
        Colors[1] := 'FFFF00';
        Colors[2] := '00BB00';
        Colors[3] := '0055EE';

        K := 0.5;

        D := K * 1.25;
        DCut := K * 1.44;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <HideContaining Vector = "0;0;0" />
        <Cut> <Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /> </Cut>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
