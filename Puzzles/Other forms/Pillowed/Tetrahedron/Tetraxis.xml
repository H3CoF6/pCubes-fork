<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetraxis</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Tetraxis</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>uot</Programmer>
        <Added>2018-03-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6625</Link>
    </Interface>

    <Script>
        // Based on code for Helicopter cube

        K := 0.5;
        D := 0.202822;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

</xml>
