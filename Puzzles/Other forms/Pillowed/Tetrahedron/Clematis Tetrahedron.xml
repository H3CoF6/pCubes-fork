<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clematis Tetrahedron</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Clematis Tetrahedron</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-09-16</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=37120</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFEE00'; // Yellow
        Colors[1] := 'EE0000'; // Red
        Colors[2] := '33DD33'; // Green
        Colors[3] := '0055EE'; // Blue

        K := 0.5;
        DC := K * 0.842;
        DE := K * 1.10;
    </Script>

    <Axes TurningAngles = "0; Pi/3" PlaneDistances = "DC" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-DE; DE" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        
        <Turn Axis = "0" Layer = "1" Angle = "Pi/3" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/3" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/3" />
        <Turn Axis = "3" Layer = "1" Angle = "Pi/3" />
        <SplitByAxes/>
        <Undo Repeat = "4" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
