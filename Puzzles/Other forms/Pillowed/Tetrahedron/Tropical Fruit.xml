<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tropical Fruit</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Tropical Fruit</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-08-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9008</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0022'; // clRed
        Colors[2] := '0099FF'; // clBlue2
        Colors[1] := 'FFFF00'; // clYellow
        Colors[3] := '00CC00'; // clGreen1

        K := 0.6;

        for i := 0 to 2 do begin
            ax[i] := cos(2 * Pi / 3 * (i + 0.5));
            ay[i] := sin(2 * Pi / 3 * (i + 0.5));
        end;
        az := sqrt(3) / 2;

        D := K * sqrt((11 + 4 * sqrt(6)) / 21);
        A1 := ArcCos(1 / 8);
        A2 := ArcCos(-3 / 4);

        Pillow := 1.45;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D" FixedLayers = "1" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
    </Axes>

    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = "ax[1]; ay[1]; az" />
        <Axis NormVector = "ax[2]; ay[2]; az" />
        <Axis NormVector = "ax[0]; ay[0]; az" />
        <Axis NormVector = "ax[1]; ay[1];-az" />
        <Axis NormVector = "ax[2]; ay[2];-az" />
        <Axis NormVector = "ax[0]; ay[0];-az" />
    </Axes>

    <Figure>
        <Turn NormVector = " 0; 0; 1" Angle = "Pi * 3 / 4" />
        <Turn NormVector = " 1; 1; 0" Angle = "ArcCos(-1/3) / 2" />

        <LoadFrom File = "_Macro_Pillowed_Tetrahedron_v2.xml" />
        <ExecMacro MacroName = "CalcCoordinates" />
        <ExecMacro MacroName = "AddPillowedTetrahedron" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
