<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Megamorphix 2x4x4</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Megamorphix 2x4x4</Menu>
        <Inventor>Carlos Ramírez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9532</Link>
    </Interface>

    <Script>
        Colors[0] := 'AFAF00';
        Colors[1] := '0000FF';
        Colors[2] := 'FF0000';
        Colors[3] := 'AAAAAA';

        K := 0.5;

        D := K * 0.48;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
