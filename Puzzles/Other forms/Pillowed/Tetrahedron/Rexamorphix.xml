<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rexamorphix</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Rexamorphix</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-03-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2225</Link>
    </Interface>

    <Script>
        K := 0.5;

        D1 := 1/sqrt(8) * K * 1.05376;
        D1 := K * 0.3725157448543; // D1 := (2 * C13 + C21) / sqrt(27);
        D2 := -K/sqrt(3);

        Colors[0] := 'EEEEEE';
        Colors[1] := 'BB0000';
        Colors[2] := 'FFEE00';
        Colors[3] := '007700';
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D1;D2" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 1;-1"/>
        <Axis NormVector = "-1;-1;-1"/>
        <Axis NormVector = "-1; 1; 1"/>
        <Axis NormVector = " 1;-1; 1"/>
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
