<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Flower Tetrahedron</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Flower Tetrahedron</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7190</Link>
    </Interface>

    <Script>
        K := 0.5;

        DC :=  0.95 * K;
        DE :=  1.15 * K;
    </Script>

    <Axes TurningAngles = "0;2 * Pi / 3" PlaneDistances = "DC" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi;0;Pi" PlaneDistances = "-DE; DE" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
