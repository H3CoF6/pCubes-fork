<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Reuleaux Mastermorphix Corner Pocket Cube</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Reuleaux Mastermorphix Corner Pocket Cube</Menu>
        <Inventor>Wu Zhe</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11413</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'AFAF00'; // Yellow
        Colors[2] := '009000'; // Green
        Colors[3] := '0000FF'; // Blue

        K := 0.45;
        D := K * 0.45;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "2" />
        <Cut Axis = "2" From = "1" />
        <HideAll/>

        <Script>
            for i := 0 to 3 do
                Colors[i] := Colors[1];
        </Script>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <RemoveContaining Vector = "0;0;0" />
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
