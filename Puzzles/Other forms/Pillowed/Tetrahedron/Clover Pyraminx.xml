<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover Pyraminx</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Clover Pyraminx</Menu>
        <Aliases>Reuleaux Leaf Tetrahedron</Aliases>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-05-17</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=399524</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7135</Link>
    </Interface>

    <Script>
        K := 0.5;
        D := K * 0.55;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <RemoveContaining Vector = " K;-K; K"/>
        <RemoveContaining Vector = "-K; K; K"/>
        <RemoveContaining Vector = " K; K;-K"/>
        <RemoveContaining Vector = "-K;-K;-K"/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
