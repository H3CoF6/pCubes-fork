<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Collider Tetrahedron</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Collider Tetrahedron</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-09-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7209</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00';
        Colors[1] := '00CC00';
        Colors[2] := '00AABB';
        Colors[3] := 'CC0088';

        K := 0.5;

        D := K * 0.927;
        f1 := K * 0.35;
        f2 := f1 * 3;

        A1 := arccos(7/18);
        A2 := arccos(-5/6);
    </Script>

    <Axes TurningAngles = "2*Pi; 0" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "-D" >
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = " 1;-3; 1" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 1; 1;-3" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = "-3; 1; 1" />
        <Axis NormVector = "-1;-1;-3" />
        <Axis NormVector = "-1;-3;-1" />
        <Axis NormVector = "-3;-1;-1" />
    </Axes>

    <Figure>
        <Macro Name = "Hide" >
            <HideContaining Vector = "  0;  0;  0" />
            <HideContaining Vector = "-f1; f1;-f2" />
            <HideContaining Vector = "-f1; f2;-f1" />
            <HideContaining Vector = "-f2; f1;-f1" />
            <HideContaining Vector = "-f1;-f1; f2" />
            <HideContaining Vector = "-f1;-f2; f1" />
            <HideContaining Vector = "-f2;-f1; f1" />
            <HideContaining Vector = " f1;-f1;-f2" />
            <HideContaining Vector = " f1;-f2;-f1" />
            <HideContaining Vector = " f2;-f1;-f1" />
            <HideContaining Vector = " f1; f1; f2" />
            <HideContaining Vector = " f1; f2; f1" />
            <HideContaining Vector = " f2; f1; f1" />
        </Macro>

        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <ExecMacro MacroName = "Hide" />
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 3 do
                Colors[i] := '-1';
        </Script>

        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <ExecMacro MacroName = "Hide" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
