<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Circle Pyramorphix 2</Name>
        <Menu>Other forms\Pillowed\Tetrahedron\Circle Pyramorphix 2</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7825</Link>
    </Interface>

    <Script>
        K := 0.5;
        D2 := K * 0.8314;
        DCut := D2 * sqrt(3);

        Colors[0] := 'FFFF00'; // Yellow
        Colors[1] := 'EE0000'; // Red
        Colors[2] := '00EE00'; // Green
        Colors[3] := '0011EE'; // Blue
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D2;-D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Pillowed Tetrahedron.xml" />
        <SplitByAxes/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
