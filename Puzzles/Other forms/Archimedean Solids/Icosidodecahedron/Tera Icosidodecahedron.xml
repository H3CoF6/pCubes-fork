<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tera Icosidodecahedron</Name>
        <Menu>Other forms\Archimedean Solids\Icosidodecahedron\Tera Icosidodecahedron</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-04-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2469</Link>
    </Interface>

    <Script>
        vColors[ 0] := '734092';
        vColors[ 1] := 'E23475';
        vColors[ 2] := '008200';
        vColors[ 3] := '4070F1';
        vColors[ 4] := '00F200';
        vColors[ 5] := 'FFF3FF';
        vColors[ 6] := 'FFF300';
        vColors[ 7] := '004070';
        vColors[ 8] := '800070';
        vColors[ 9] := 'BF8050';
        vColors[10] := '309070';
        vColors[11] := 'FE0000';
        vColors[12] := 'FE0080';
        vColors[13] := '80CF80';
        vColors[14] := 'FF700A';
        vColors[15] := '4D1340';
        vColors[16] := '9E0000';
        vColors[17] := '7F7040';
        vColors[18] := 'C1C4C7';
        vColors[19] := 'FACD05';

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        Cut := R * (sqrt(5) / 3 + 1) / 2;

        D1 := (5 * Rsin + 1 * R2sin) / 6;
        D2 := (4 * Rsin + 2 * R2sin) / 6;
        D3 := (3 * Rsin + 3 * R2sin) / 6;

        KC := 0.89; // pillow
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D3;-D2;-D1; D1; D2; D3" FixedLayers = "3" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "AddPillowTetrahedron" >
            <Cut Color = "-2" > <Plane NormVector = "-Vx[2];-Vy[2];-Vz[2]" NormDistance = "-Cut" /> </Cut>
            <Part>
                <Vertices Vectors = "Ex[1];Ey[1];Ez[1]" />
                <Vertices Vectors = "Ex[2];Ey[2];Ez[2]" />
                <Vertices Vectors = "Ex[7];Ey[7];Ez[7]" />
                <Vertices Vectors = "Vx[2]*KC;Vy[2]*KC;Vz[2]*KC" />

                <Faces>
                    <Face Color = "vColors[c]" VertexIndexes = "0;1;3" InvisibleEdges = "6" />
                    <Face Color = "vColors[c]" VertexIndexes = "1;2;3" InvisibleEdges = "6" />
                    <Face Color = "vColors[c]" VertexIndexes = "2;0;3" InvisibleEdges = "6" />
                    <Face Color = "-2"         VertexIndexes = "1;0;2" />
                </Faces>
            </Part>
            <Turn NormVector = "Ex[7];Ey[7];Ez[7]" Angle = "Pi" />
            <Script> Inc(c); </Script>
        </Macro>

        <Macro Name = "AddTetrahedron2" >
            <ExecMacro MacroName = "AddPillowTetrahedron" Repeat = "2" />
            <Turn NormVector = "0;0;1" Angle = "2*Pi / 5" />
        </Macro>
        <ExecMacro MacroName = "AddTetrahedron2" Repeat = "5" c = "0" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "AddTetrahedron2" Repeat = "5" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <SplitByAxes/>

        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
