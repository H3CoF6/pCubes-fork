                <Add Vector = " A1; B1; C1" />
                <Add Vector = " A1; C1; B1" />
                <Add Vector = " A1; C1;-B1" />
                <Add Vector = " A1; B1;-C1" />
                <Add Vector = " A1;-B1;-C1" />

                <Add Vector = "-A1; C1;-B1" />
