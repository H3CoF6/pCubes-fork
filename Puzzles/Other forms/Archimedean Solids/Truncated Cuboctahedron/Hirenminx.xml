        Colors[22] := '7E3F00';
        Colors[23] := '7E007E';
        Colors[24] := 'FF3F3F';
        Colors[25] := '77773C';

        W := 0.55;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        A1 := W;
        B1 := W * (2 * sqrt(2) - 1) / 7;
        C1 := W * (3 + sqrt(2)) / 7;

        D1 := (2 * A1 + C1) / 3;
        D2 := (3 * A1 + B1 + 2 * C1) / 3 / sqrt(2);
        D3 := (A1 + B1 / 3 + C1) / sqrt(3);
    </Script>

    <Axes TurningAngles = "0; Pi/2"     PlaneDistances = "D1" NormVectors = "Cx; Cy; Cz" />
    <Axes TurningAngles = "0; Pi"       PlaneDistances = "D2" NormVectors = "Ex; Ey; Ez" />
    <Axes TurningAngles = "0; 2*Pi / 3" PlaneDistances = "D3" NormVectors = "Vx; Vy; Vz" />

    <Figure>
