    <Script>
        W := 0.5;
        DCut := W * (sqrt(3) + sqrt(6)) / 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "1; 1; 1" />
        <Axis NormVector = "1; 1;-1" />
        <Axis NormVector = "1;-1; 1" />
        <Axis NormVector = "1;-1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Cut Color = "AFAFFF"> <Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "AFAFFE"> <Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "AFAFFD"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "AFAEFF"> <Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "AFADFF"> <Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "AEAFFF"> <Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "ADAFFF"> <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "ACAFFF"> <Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /></Cut>

        <SplitByAxes/>
    </Figure>
</xml>
