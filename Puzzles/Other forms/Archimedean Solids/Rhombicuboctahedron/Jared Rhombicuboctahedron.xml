<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Jared's Rhombicuboctahedron</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\Jared's Rhombicuboctahedron</Menu>
        <Inventor>Jared</Inventor>
        <Programmer>quickfur</Programmer>
        <Added>2024-01-18</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=426844</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF80FF';
        Colors[ 1] := '0080FF';
        Colors[ 2] := 'FF0080';
        Colors[ 3] := '80FFFF';
        Colors[ 4] := '008080';
        Colors[ 5] := 'FF8000';
        Colors[ 6] := '8000FF';
        Colors[ 7] := 'FF0000';
        Colors[ 8] := 'FFFFFF';
        Colors[ 9] := '00FF00';
        Colors[10] := '008000';
        Colors[11] := '0000FF';
        Colors[12] := '00FFFF';
        Colors[13] := 'FF8080';
        Colors[14] := 'FFFF80';
        Colors[15] := '8080FF';
        Colors[16] := 'FFFF00';
        Colors[17] := '80FF80';

        W := 0.6;
        A := W * (sqrt(2) - 1);
        B := (2 * A + W) / 3;
        D := A / 2;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/2; Pi/4; Pi/4; Pi/2; Pi/2" PlaneDistances = "-W/sqrt(2);-A; 0; A; W/sqrt(2)" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddColor" >
            <Face Color = "Colors[c]" VertexIndexes = "v0;v1;v5" InvisibleEdges = "5" />
            <Face Color = "Colors[c]" VertexIndexes = "v1;v2;v4;v5" />
            <Face Color = "Colors[c]" VertexIndexes = "v3;v4;v2" InvisibleEdges = "5" />
        </Macro>

        <Part>
            <Vertices>
                <Add Vector = " A; A; W" />
                <Add Vector = " A; A;-W" />
                <Add Vector = " A;-A; W" />
                <Add Vector = " A;-A;-W" />
                <Add Vector = "-A; A; W" />
                <Add Vector = "-A; A;-W" />
                <Add Vector = "-A;-A; W" />
                <Add Vector = "-A;-A;-W" />
                <Add Vector = " W; A; A" />
                <Add Vector = " W; A;-A" />
                <Add Vector = " W;-A; A" />
                <Add Vector = " W;-A;-A" />
                <Add Vector = "-W; A; A" />
                <Add Vector = "-W; A;-A" />
                <Add Vector = "-W;-A; A" />
                <Add Vector = "-W;-A;-A" />
                <Add Vector = " A; W; A" />
                <Add Vector = " A; W;-A" />
                <Add Vector = " A;-W; A" />
                <Add Vector = " A;-W;-A" />
                <Add Vector = "-A; W; A" />
                <Add Vector = "-A; W;-A" />
                <Add Vector = "-A;-W; A" />
                <Add Vector = "-A;-W;-A" />

                <Add Vector = " B; B; B" />
                <Add Vector = " B; B;-B" />
                <Add Vector = " B;-B; B" />
                <Add Vector = " B;-B;-B" />
                <Add Vector = "-B; B; B" />
                <Add Vector = "-B; B;-B" />
                <Add Vector = "-B;-B; B" />
                <Add Vector = "-B;-B;-B" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 4; 6; 2" />
                <Face Color = "Colors[1]" VertexIndexes = " 1; 3; 7; 5" />
                <Face Color = "Colors[2]" VertexIndexes = " 8;10;11; 9" />
                <Face Color = "Colors[3]" VertexIndexes = "12;13;15;14" />
                <Face Color = "Colors[4]" VertexIndexes = "16;17;21;20" />
                <Face Color = "Colors[5]" VertexIndexes = "18;22;23;19" />

                <ExecMacro MacroName = "AddColor" c = " 6" v0 = "24" v1 = " 0" v2 = " 2" v3 = "26" v4 = "10" v5 = " 8" />
                <ExecMacro MacroName = "AddColor" c = " 7" v0 = "28" v1 = " 4" v2 = " 0" v3 = "24" v4 = "16" v5 = "20" />
                <ExecMacro MacroName = "AddColor" c = " 8" v0 = "31" v1 = " 7" v2 = " 3" v3 = "27" v4 = "19" v5 = "23" />
                <ExecMacro MacroName = "AddColor" c = " 9" v0 = "29" v1 = " 5" v2 = " 7" v3 = "31" v4 = "15" v5 = "13" />
                <ExecMacro MacroName = "AddColor" c = "10" v0 = "27" v1 = " 3" v2 = " 1" v3 = "25" v4 = " 9" v5 = "11" />
                <ExecMacro MacroName = "AddColor" c = "11" v0 = "27" v1 = "11" v2 = "10" v3 = "26" v4 = "18" v5 = "19" />
                <ExecMacro MacroName = "AddColor" c = "12" v0 = "30" v1 = " 6" v2 = " 4" v3 = "28" v4 = "12" v5 = "14" />
                <ExecMacro MacroName = "AddColor" c = "13" v0 = "29" v1 = "13" v2 = "12" v3 = "28" v4 = "20" v5 = "21" />
                <ExecMacro MacroName = "AddColor" c = "14" v0 = "25" v1 = " 1" v2 = " 5" v3 = "29" v4 = "21" v5 = "17" />
                <ExecMacro MacroName = "AddColor" c = "15" v0 = "24" v1 = " 8" v2 = " 9" v3 = "25" v4 = "17" v5 = "16" />
                <ExecMacro MacroName = "AddColor" c = "16" v0 = "30" v1 = "14" v2 = "15" v3 = "31" v4 = "23" v5 = "22" />
                <ExecMacro MacroName = "AddColor" c = "17" v0 = "26" v1 = " 2" v2 = " 6" v3 = "30" v4 = "22" v5 = "18" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "Ax1" Angle = "Pi/4" Layers = "2-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Turn Axis = "Ax2" Angle = "Pi/4" Layers = "2-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo/>
            <Turn Axis = "Ax3" Angle = "Pi/4" Layers = "2-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo/>
            <Undo/>
        </Macro>
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "0" Ax3 = "1" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
