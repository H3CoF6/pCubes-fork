<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>FTOhNo</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\FTOhNo</Menu>
        <Inventor>Candy Cuber</Inventor>
        <Programmer>Misdrop</Programmer>
        <Added>2025-03-09</Added>
        <Link>https://www.reddit.com/r/Cubers/comments/1iuev4s/after_much_work_and_even_more_procrastination_its/</Link>
    </Interface>

    <Script>
        W := 0.6;
        A := W * (sqrt(2) - 1);
        D1 := (A + 2 * W) / 3; // may be varied
        D2 := (D1 + A) / sqrt(2);
        D3 := (2 * A + D1) / sqrt(3);

        jumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "jumAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D3; D3" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Archimedean Solids\Rhombicuboctahedron\Figures\Rhombicuboctahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
