<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Jared's Rhombicuboctahedron (26-color version)</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\Jared's Rhombicuboctahedron (26-color version)</Menu>
        <Inventor>Jared</Inventor>
        <Programmer>quickfur</Programmer>
        <Added>2024-01-18</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=426844</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF80FF';
        Colors[ 1] := '0080FF';
        Colors[ 2] := 'FF0080';
        Colors[ 3] := '80FFFF';
        Colors[ 4] := '008080';
        Colors[ 5] := 'FF8000';
        Colors[ 6] := '8000FF';
        Colors[ 7] := 'FF0000';
        Colors[ 8] := 'FFFFFF';
        Colors[ 9] := '00FF00';
        Colors[10] := '008000';
        Colors[11] := '0000FF';
        Colors[12] := '00FFFF';
        Colors[13] := 'FF8080';
        Colors[14] := 'FFFF80';
        Colors[15] := '8080FF';
        Colors[16] := 'FFFF00';
        Colors[17] := '80FF80';

        Colors[18] := '404040';
        Colors[19] := '4040C0';
        Colors[20] := '40C040';
        Colors[21] := '40C0C0';
        Colors[22] := 'C04040';
        Colors[23] := 'C040C0';
        Colors[24] := 'C0C040';
        Colors[25] := 'C0C0C0';

        W := 0.6;
        A := W * (sqrt(2) - 1);
        B := (2*A + W) / 3;
        D := A / 2;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/2; Pi/4; Pi/4; Pi/2; Pi/2" PlaneDistances = "-W/sqrt(2); -A; 0; A; W/sqrt(2)" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " A; A; W" />
                <Add Vector = " A; A;-W" />
                <Add Vector = " A;-A; W" />
                <Add Vector = " A;-A;-W" />
                <Add Vector = "-A; A; W" />
                <Add Vector = "-A; A;-W" />
                <Add Vector = "-A;-A; W" />
                <Add Vector = "-A;-A;-W" />
                <Add Vector = " W; A; A" />
                <Add Vector = " W; A;-A" />
                <Add Vector = " W;-A; A" />
                <Add Vector = " W;-A;-A" />
                <Add Vector = "-W; A; A" />
                <Add Vector = "-W; A;-A" />
                <Add Vector = "-W;-A; A" />
                <Add Vector = "-W;-A;-A" />
                <Add Vector = " A; W; A" />
                <Add Vector = " A; W;-A" />
                <Add Vector = " A;-W; A" />
                <Add Vector = " A;-W;-A" />
                <Add Vector = "-A; W; A" />
                <Add Vector = "-A; W;-A" />
                <Add Vector = "-A;-W; A" />
                <Add Vector = "-A;-W;-A" />

                <Add Vector = " B; B; B" />
                <Add Vector = " B; B;-B" />
                <Add Vector = " B;-B; B" />
                <Add Vector = " B;-B;-B" />
                <Add Vector = "-B; B; B" />
                <Add Vector = "-B; B;-B" />
                <Add Vector = "-B;-B; B" />
                <Add Vector = "-B;-B;-B" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 4; 6; 2" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 1; 3; 7; 5" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 8;10;11; 9" />
                <Face Color = "Colors[ 3]" VertexIndexes = "12;13;15;14" />
                <Face Color = "Colors[ 4]" VertexIndexes = "16;17;21;20" />
                <Face Color = "Colors[ 5]" VertexIndexes = "18;22;23;19" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 0; 2;10; 8" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 0;16;20; 4" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 7; 3;19;23" />
                <Face Color = "Colors[ 9]" VertexIndexes = " 7;15;13; 5" />
                <Face Color = "Colors[10]" VertexIndexes = "11; 3; 1; 9" />
                <Face Color = "Colors[11]" VertexIndexes = "11;10;18;19" />
                <Face Color = "Colors[12]" VertexIndexes = "12;14; 6; 4" />
                <Face Color = "Colors[13]" VertexIndexes = "12;20;21;13" />
                <Face Color = "Colors[14]" VertexIndexes = "17; 1; 5;21" />
                <Face Color = "Colors[15]" VertexIndexes = "17;16; 8; 9" />
                <Face Color = "Colors[16]" VertexIndexes = "22;14;15;23" />
                <Face Color = "Colors[17]" VertexIndexes = "22;18; 2; 6" />

                <Face Color = "Colors[18]" VertexIndexes = " 0; 8;16" />
                <Face Color = "Colors[19]" VertexIndexes = " 1;17; 9" />
                <Face Color = "Colors[20]" VertexIndexes = " 2;18;10" />
                <Face Color = "Colors[21]" VertexIndexes = " 3;11;19" />
                <Face Color = "Colors[22]" VertexIndexes = " 4;20;12" />
                <Face Color = "Colors[23]" VertexIndexes = " 5;13;21" />
                <Face Color = "Colors[24]" VertexIndexes = " 6;14;22" />
                <Face Color = "Colors[25]" VertexIndexes = " 7;23;15" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "Ax1" Angle = "Pi/4" Layers = "2-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Turn Axis = "Ax2" Angle = "Pi/4" Layers = "2-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo/>
            <Turn Axis = "Ax3" Angle = "Pi/4" Layers = "2-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo/>
            <Undo/>
        </Macro>
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "0" Ax3 = "1" />
    </Figure>
</xml>
