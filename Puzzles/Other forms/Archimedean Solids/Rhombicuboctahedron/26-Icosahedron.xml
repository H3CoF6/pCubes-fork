<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>26-Icosahedron (Rhombicuboctahedral SuperChop Cube)</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\26-Icosahedron</Menu>
        <Programmer>Skallos</Programmer>
        <Added>2016-11-22</Added>
    </Interface>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "2* Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Script>
        D1 := 0.6;
        D2 := D1 * (2 * sqrt(2) - 1) * sqrt(3) / 3;
    </Script>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-D1;-D1;-D1" />
                <Add Vector = "-D1;-D1; D1" />
                <Add Vector = "-D1; D1;-D1" />
                <Add Vector = "-D1; D1; D1" />
                <Add Vector = " D1;-D1;-D1" />
                <Add Vector = " D1;-D1; D1" />
                <Add Vector = " D1; D1;-D1" />
                <Add Vector = " D1; D1; D1" />
            </Vertices>

            <Faces>
                <Face Color = "0000FF" VertexIndexes = "1;0;4;5" />
                <Face Color = "00FF00" VertexIndexes = "2;3;7;6" />
                <Face Color = "FF0000" VertexIndexes = "0;1;3;2" />
                <Face Color = "FF8000" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Cut Color = "404040" > <Plane NormVector = " 1; 1; 0" NormDistance = "-D1" /> </Cut>
        <Cut Color = "AAAAAA" > <Plane NormVector = "-1; 1; 0" NormDistance = "-D1" /> </Cut>
        <Cut Color = "FF00FF" > <Plane NormVector = " 1;-1; 0" NormDistance = "-D1" /> </Cut>
        <Cut Color = "00FFFF" > <Plane NormVector = "-1;-1; 0" NormDistance = "-D1" /> </Cut>
        <Cut Color = "FF0080" > <Plane NormVector = " 0; 1; 1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "FF8080" > <Plane NormVector = " 0; 1;-1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "FFFF80" > <Plane NormVector = " 0;-1; 1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "00FF80" > <Plane NormVector = " 0;-1;-1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "80FF00" > <Plane NormVector = " 1; 0; 1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "80FF80" > <Plane NormVector = "-1; 0; 1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "8000FF" > <Plane NormVector = " 1; 0;-1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "0080FF" > <Plane NormVector = "-1; 0;-1" NormDistance = "-D1" /> </Cut>
        <Cut Color = "8080FF" > <Plane NormVector = " 1; 1; 1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "FF80FF" > <Plane NormVector = "-1;-1;-1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "80FFFF" > <Plane NormVector = " 1;-1; 1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "8020FF" > <Plane NormVector = "-1; 1;-1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "20FF80" > <Plane NormVector = " 1; 1;-1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "AA2060" > <Plane NormVector = "-1;-1; 1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "104070" > <Plane NormVector = " 1;-1;-1" NormDistance = "-D2" /> </Cut>
        <Cut Color = "F00FF0" > <Plane NormVector = "-1; 1; 1" NormDistance = "-D2" /> </Cut>

        <SplitByAxes/>
    </Figure>
</xml>
