<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Bram AC</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\Dino Bram\Dino Bram AC</Menu>
        <Inventor>Oskar Van Deventer</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2816</Link>
    </Interface>

    <Script>
        W := 0.6;
        A := W * (sqrt(2) - 1);
        D := W * sqrt((7 + 4 * sqrt(2)) / 17);

        A1 := ArcCos((sqrt(2) + 2) / 8);
        A2 := ArcCos((sqrt(2) - 2) / 4);
        A3 := A1 + A2;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " A; A; W" />
        <Axis NormVector = " A; A;-W" />
        <Axis NormVector = " A;-A; W" />
        <Axis NormVector = " A;-A;-W" />
        <Axis NormVector = " W; A; A" />
        <Axis NormVector = " W; A;-A" />
        <Axis NormVector = " W;-A; A" />
        <Axis NormVector = " W;-A;-A" />
        <Axis NormVector = " A; W; A" />
        <Axis NormVector = " A; W;-A" />
        <Axis NormVector = " A;-W; A" />
        <Axis NormVector = " A;-W;-A" />
    </Axes>

    <Figure>
        <LoadFrom File = "..\Figures\Rhombicuboctahedron Alternate Coloring.xml" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
