<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Bram 2</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\Dino Bram\Dino Bram 2</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-04-25</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.6;
        A := W * (sqrt(2) - 1);
        D := W * sqrt((7 + 4 * sqrt(2)) / 17);

        D := D * (-3 * sqrt(2) + 6) / 2;

        A1 := ArcCos((sqrt(2) + 2) / 8);
        A2 := ArcCos((sqrt(2) - 2) / 4);
        A3 := A1 + A2;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " A; A; W" />
        <Axis NormVector = " A; A;-W" />
        <Axis NormVector = " A;-A; W" />
        <Axis NormVector = " A;-A;-W" />
        <Axis NormVector = " W; A; A" />
        <Axis NormVector = " W; A;-A" />
        <Axis NormVector = " W;-A; A" />
        <Axis NormVector = " W;-A;-A" />
        <Axis NormVector = " A; W; A" />
        <Axis NormVector = " A; W;-A" />
        <Axis NormVector = " A;-W; A" />
        <Axis NormVector = " A;-W;-A" />
    </Axes>

    <Figure>
        <LoadFrom File = "..\Figures\Rhombicuboctahedron.xml" />

        <SplitByAxes/>
    </Figure>

    <Macros>
        <Macro Name = "RandomTurnsA2" >
            <Turn Axis = "Random(12)" Layer = "Random(2) * 2" Angle = "A2" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(12)" Layer = "Random(2) * 2" Angle = "2*Pi*Random"/>
        </Macro>
        <Macro Name = "ScrambleA2" Public = "1" >
            <Script> A2 := ArcCos((sqrt(2) - 2) / 4); </Script>

            <ExecMacro MacroName = "RandomTurnsA2" Repeat = "100" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "ScrambleA2" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "10000" />
        </Macro>
    </Macros>
</xml>
