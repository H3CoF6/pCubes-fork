<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Bram unbandaged</Name>
        <Menu>Other forms\Archimedean Solids\Rhombicuboctahedron\Dino Bram\Dino Bram unbandaged</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-21</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.6;
        A := W * (sqrt(2) - 1);
        D := W * sqrt((7 + 4 * sqrt(2)) / 17);

        A1 := ArcCos((sqrt(2) + 2) / 8);
        A2 := ArcCos((sqrt(2) - 2) / 4);
        A3 := A1 + A2;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " A; A; W" />
        <Axis NormVector = " A; A;-W" />
        <Axis NormVector = " A;-A; W" />
        <Axis NormVector = " A;-A;-W" />
        <Axis NormVector = " W; A; A" />
        <Axis NormVector = " W; A;-A" />
        <Axis NormVector = " W;-A; A" />
        <Axis NormVector = " W;-A;-A" />
        <Axis NormVector = " A; W; A" />
        <Axis NormVector = " A; W;-A" />
        <Axis NormVector = " A;-W; A" />
        <Axis NormVector = " A;-W;-A" />
    </Axes>

    <Figure>
        <LoadFrom File = "..\Figures\Rhombicuboctahedron.xml" />

        <SplitByAxes/>

        <Macro Name = "Split1" >
            <Turn  Axis = "Ax1" Layer = "0" Angle = "A * A1" />
            <Turn  Axis = "Ax1" Layer = "2" Angle = "A * A1" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "B * A1" />
            <Turn  Axis = "Ax2" Layer = "2" Angle = "B * A1" />
            <Split Axis = "Ax1" From  = "1" />
            <Split Axis = "Ax1" From  = "2" />
<!--            <Undo Repeat = "4" />-->
            <Turn  Axis = "Ax2" Layer = "2" Angle = "-B * A1" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "-B * A1" />
            <Turn  Axis = "Ax1" Layer = "2" Angle = "-A * A1" />
            <Turn  Axis = "Ax1" Layer = "0" Angle = "-A * A1" />
        </Macro>

        <ExecMacro MacroName = "Split1" Ax1 = " 0" Ax2 = " 4" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = " 4" Ax2 = " 8" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = " 8" Ax2 = " 0" A = "-1" B = " 1" />

        <ExecMacro MacroName = "Split1" Ax1 = " 1" Ax2 = " 5" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = " 5" Ax2 = " 9" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = " 9" Ax2 = " 1" A = " 1" B = "-1" />

        <ExecMacro MacroName = "Split1" Ax1 = " 2" Ax2 = " 6" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = " 6" Ax2 = "10" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = "10" Ax2 = " 2" A = " 1" B = "-1" />

        <ExecMacro MacroName = "Split1" Ax1 = " 3" Ax2 = " 7" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = " 7" Ax2 = "11" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = "11" Ax2 = " 3" A = "-1" B = " 1" />
    </Figure>
</xml>
