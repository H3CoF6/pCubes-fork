        <Programmer>quickfur</Programmer>
        <Added>2022-08-20</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=418909#p418909</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF80FF';
        Colors[ 1] := '0080FF';
        Colors[ 2] := 'FF0080';
        Colors[ 3] := '80FFFF';
        Colors[ 4] := '008080';
        Colors[ 5] := 'FF8000';
        Colors[ 6] := '8000FF';
        Colors[ 7] := 'FF0000';
        Colors[ 8] := 'FFFFFF';
        Colors[ 9] := '00FF00';
        Colors[10] := '008000';
        Colors[11] := '0000FF';
        Colors[12] := '00FFFF';
        Colors[13] := 'FF8080';
        Colors[14] := 'FFFF80';
        Colors[15] := '8080FF';
        Colors[16] := 'FFFF00';
        Colors[17] := '80FF80';

        W := 0.6;
        A := W * (sqrt(2) - 1);
        B := (2*A + W) / 3;
        D := A / 3;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/4; Pi/4; Pi/2" PlaneDistances = "-A;-D; D; A" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " A; A; W" />
                <Add Vector = " A; A;-W" />
                <Add Vector = " A;-A; W" />
                <Add Vector = " A;-A;-W" />
                <Add Vector = "-A; A; W" />
                <Add Vector = "-A; A;-W" />
                <Add Vector = "-A;-A; W" />
                <Add Vector = "-A;-A;-W" />
                <Add Vector = " W; A; A" />
                <Add Vector = " W; A;-A" />
                <Add Vector = " W;-A; A" />
                <Add Vector = " W;-A;-A" />
                <Add Vector = "-W; A; A" />
                <Add Vector = "-W; A;-A" />
                <Add Vector = "-W;-A; A" />
                <Add Vector = "-W;-A;-A" />
                <Add Vector = " A; W; A" />
                <Add Vector = " A; W;-A" />
                <Add Vector = " A;-W; A" />
                <Add Vector = " A;-W;-A" />
                <Add Vector = "-A; W; A" />
                <Add Vector = "-A; W;-A" />
                <Add Vector = "-A;-W; A" />
                <Add Vector = "-A;-W;-A" />

                <Add Vector = " B; B; B" />
                <Add Vector = " B; B;-B" />
                <Add Vector = " B;-B; B" />
                <Add Vector = " B;-B;-B" />
                <Add Vector = "-B; B; B" />
                <Add Vector = "-B; B;-B" />
                <Add Vector = "-B;-B; B" />
                <Add Vector = "-B;-B;-B" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 4; 6; 2" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 1; 3; 7; 5" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 8;10;11; 9" />
                <Face Color = "Colors[ 3]" VertexIndexes = "12;13;15;14" />
                <Face Color = "Colors[ 4]" VertexIndexes = "16;17;21;20" />
                <Face Color = "Colors[ 5]" VertexIndexes = "18;22;23;19" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 0; 2;10; 8" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 0;16;20; 4" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 7; 3;19;23" />
                <Face Color = "Colors[ 9]" VertexIndexes = " 7;15;13; 5" />
                <Face Color = "Colors[10]" VertexIndexes = "11; 3; 1; 9" />
                <Face Color = "Colors[11]" VertexIndexes = "11;10;18;19" />
                <Face Color = "Colors[12]" VertexIndexes = "12;14; 6; 4" />
                <Face Color = "Colors[13]" VertexIndexes = "12;20;21;13" />
                <Face Color = "Colors[14]" VertexIndexes = "17; 1; 5;21" />
                <Face Color = "Colors[15]" VertexIndexes = "17;16; 8; 9" />
                <Face Color = "Colors[16]" VertexIndexes = "22;14;15;23" />
                <Face Color = "Colors[17]" VertexIndexes = "22;18; 2; 6" />

                <Face Color = "Colors[ 6]" VertexIndexes = " 0; 8;24" />
                <Face Color = "Colors[15]" VertexIndexes = " 8;16;24" />
                <Face Color = "Colors[ 7]" VertexIndexes = "16; 0;24" />

                <Face Color = "Colors[14]" VertexIndexes = " 1;17; 25" />
                <Face Color = "Colors[15]" VertexIndexes = "17; 9; 25" />
                <Face Color = "Colors[10]" VertexIndexes = " 9; 1; 25" />

                <Face Color = "Colors[17]" VertexIndexes = " 2;18;26" />
                <Face Color = "Colors[11]" VertexIndexes = "18;10;26" />
                <Face Color = "Colors[ 6]" VertexIndexes = "10; 2;26" />

                <Face Color = "Colors[10]" VertexIndexes = " 3;11;27" />
                <Face Color = "Colors[11]" VertexIndexes = "11;19;27" />
                <Face Color = "Colors[ 8]" VertexIndexes = "19; 3;27" />

                <Face Color = "Colors[ 7]" VertexIndexes = " 4;20;28" />
                <Face Color = "Colors[13]" VertexIndexes = "20;12;28" />
                <Face Color = "Colors[12]" VertexIndexes = "12; 4;28" />

                <Face Color = "Colors[ 9]" VertexIndexes = " 5;13;29" />
