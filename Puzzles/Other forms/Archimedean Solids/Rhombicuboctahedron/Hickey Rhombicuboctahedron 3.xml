                <Face Color = "Colors[ 8]" VertexIndexes = " 7;23;31" />
                <Face Color = "Colors[16]" VertexIndexes = "23;15;31" />
                <Face Color = "Colors[ 9]" VertexIndexes = "15; 7;31" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "Split" >
            <Turn Axis = "Ax1" Angle = "Pi/4" Layers = "1-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Turn Axis = "Ax2" Angle = "Pi/4" Layers = "1-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo/>
            <Turn Axis = "Ax3" Angle = "Pi/4" Layers = "1-3" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo/>
            <Undo/>
        </Macro>
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "0" Ax3 = "1" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
