    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Snub_Cube.xml" />
        <SplitByAxes/>
    </Figure>
