        R := 0.7;

        s5 := sqrt(5);

        C4 := (1 + s5) * 3 / 4;
        C5 := 1 / 2;
        K := R / sqrt(C4^2 + C5^2);

        C0 := K * (1 + s5) / 4;
        C1 := K * (1 + s5) / 2;
        C2 := K * (5 + s5) / 4;
        C3 := K * (2 + s5) / 2;
        C4 := K * (1 + s5) * 3 / 4;
        C5 := K / 2;
        C6 := K;

        // pillow
        C := 1.06;
        C7 := K * (3 + s5) / 4 * C;
        C8 := C0 * C;
        C9 := C3 * C;

        D1 := K * sqrt((7 + 3 * s5) * 5 / 24) * C;
        D2 := K * sqrt((65 + 29 * s5) / 40) * C;

        jumAngle := Arcsin(1/4) + Pi/6;
    </Script>

