<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hanoiminx</Name>
        <Aliases>Concept 5</Aliases>
        <Menu>Other forms\Archimedean Solids\Truncated Tetrahedron\Hanoiminx</Menu>
        <Inventor>Mai Phu Son</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5279</Link>
    </Interface>

    <Script>
        W := 0.6;
        D1 := W * sqrt(3) / 9 * 2;
        D2 := D1 * 2;
        DCut := D1 * 5 / 2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <Cut Color = "clRed   " > <Plane NormDistance = "-DCut" NormVector = "-1;-1; 1" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormDistance = "-DCut" NormVector = "-1; 1;-1" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormDistance = "-DCut" NormVector = " 1;-1;-1" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormDistance = "-DCut" NormVector = " 1; 1; 1" /> </Cut>

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
