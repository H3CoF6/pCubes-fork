<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombi Gem</Name>
        <Menu>Other forms\Archimedean Solids\Truncated Octahedron\Rhombi Gem</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8908</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36914</Link>
    </Interface>

    <Script>
        Colors[ 0] := '0000FF'; // Blue  
        Colors[ 1] := 'FFFF00'; // Yellow
        Colors[ 2] := 'FF6000'; // Orange
        Colors[ 3] := 'FF0000'; // Red   
        Colors[ 4] := 'F0F0F0'; // White 
        Colors[ 5] := '008000'; // Green 
        Colors[ 6] := 'FF69B4'; // Pink  
        Colors[ 7] := '800000'; // Brown 
        Colors[ 8] := '00FF00'; // Lime  
        Colors[ 9] := '800080'; // Purple
        Colors[10] := '808000'; // Olive 
        Colors[11] := '00FFFF'; // Cyan  
        Colors[12] := '000080'; // Navy  
        Colors[13] := 'FF7F50'; // Coral 

        W := 0.56;
        jAngle := Arccos(1/3);
        s22 := 1/sqrt(2);

        A := W * 0.5;
        D := W * 0.6;
        DCut := W * 3 / 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "jAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi/4" />

        <LoadFrom File = "Figures\Cube.xml" />

        <Macro Name = "CutV" >
            <Cut Color = "Colors[v + 6]"> <Plane NormVector = "-Vx[v];-Vy[v];-Vz[v]" NormDistance = "-DCut" /></Cut>
            <Script>Inc(v);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" v = "0" Repeat = "8" />

        <SplitByAxes/>

        <Macro Name = "Split" >
            <HideContaining Vector = "0;-W; A"/>
            <InvertVisibility/>

            <Turn NormVector = "-s22; -s22; 1" Angle = "-jAngle" />
            <Split><Plane NormVector = "-s22; -s22;-1" NormDistance = "D" /></Split>
            <Turn NormVector = "-s22; -s22; 1" Angle = " jAngle" />

            <Turn NormVector = " s22; -s22; 1" Angle = " jAngle" />
            <Split><Plane NormVector = " s22; -s22;-1" NormDistance = "D" /></Split>
            <Turn NormVector = " s22; -s22; 1" Angle = "-jAngle" />
            <ShowAll/>

            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <ExecMacro MacroName = "Split" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <ExecMacro MacroName = "Split" Repeat = "4" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <ShowAll/>
    </Figure>
</xml>
