<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Truncated Octahedron Master Pentultimate</Name>
        <Menu>Other forms\Archimedean Solids\Truncated Octahedron\Truncated Octahedron Master Pentultimate</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-05-30</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clNavy   := '000080';
        clCoral  := 'FF7F50';
        clRed    := 'FF0000';
        clBrown  := '800000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clOlive  := '808000';
        clLime   := '00FF00';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clPurple := '800080';

        W := 0.6;
        H := W / 2;
        D := W * sqrt((25 - 11 * sqrt(5)) / 10) / 2;

        include 'Figures\Scripts\Dodecahedron_Sq_Coordinates.inc';
    </Script>

    <Axes TurningAngles = " 2*Pi / 5" PlaneDistances = "-D; D" NormVectors = "Cx;Cy;Cz" />

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " H; 0; W" />
                <Add Vector = " 0;-H; W" />
                <Add Vector = "-H; 0; W" />
                <Add Vector = " 0; H; W" />

                <Add Vector = " W; 0; H" />
                <Add Vector = " 0;-W; H" />
                <Add Vector = "-W; 0; H" />
                <Add Vector = " 0; W; H" />

                <Add Vector = " H; W; 0" />
                <Add Vector = " W; H; 0" />
                <Add Vector = " W;-H; 0" />
                <Add Vector = " H;-W; 0" />
                <Add Vector = "-H;-W; 0" />
                <Add Vector = "-W;-H; 0" />
                <Add Vector = "-W; H; 0" />
                <Add Vector = "-H; W; 0" />

                <Add Vector = " W; 0;-H" />
                <Add Vector = " 0;-W;-H" />
                <Add Vector = "-W; 0;-H" />
                <Add Vector = " 0; W;-H" />

                <Add Vector = " H; 0;-W" />
                <Add Vector = " 0;-H;-W" />
                <Add Vector = "-H; 0;-W" />
                <Add Vector = " 0; H;-W" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen " VertexIndexes = " 3; 2; 1; 0" />
                <Face Color = "clYellow" VertexIndexes = " 4;10;16; 9" />
                <Face Color = "clOrange" VertexIndexes = " 5;12;17;11" />
                <Face Color = "clBlue  " VertexIndexes = " 6;14;18;13" />
                <Face Color = "clRed   " VertexIndexes = " 7; 8;19;15" />
                <Face Color = "clWhite " VertexIndexes = "20;21;22;23" />

                <Face Color = "clCyan  " VertexIndexes = " 0; 1; 5;11;10; 4" />
                <Face Color = "clBrown " VertexIndexes = " 1; 2; 6;13;12; 5" />
                <Face Color = "clPurple" VertexIndexes = " 2; 3; 7;15;14; 6" />
                <Face Color = "clCoral " VertexIndexes = " 3; 0; 4; 9; 8; 7" />

                <Face Color = "clNavy  " VertexIndexes = " 8; 9;16;20;23;19" />
                <Face Color = "clOlive " VertexIndexes = "10;11;17;21;20;16" />
                <Face Color = "clPink  " VertexIndexes = "12;13;18;22;21;17" />
                <Face Color = "clLime  " VertexIndexes = "14;15;19;23;22;18" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
