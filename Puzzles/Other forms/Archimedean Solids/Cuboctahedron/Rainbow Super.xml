<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rainbow Super</Name>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Rainbow Super</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-22</Added>
    </Interface>

    <Script>
        D1 := sqrt(3) / 9;
        D2 := D1 * 2;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboctahedron.xml" />

        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
