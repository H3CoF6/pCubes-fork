<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover Cuboctahedron</Name>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Clover Cuboctahedron</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7532</Link>
    </Interface>

    <Script>
        W := 0.5;
        A := W * 1.2;
        D := A / sqrt(2);
        DCut := W * 0.9;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W;  0" />
                <Add Vector = "-W;  0;  W" />
                <Add Vector = "-W;  W;  0" />
                <Add Vector = "-W;  0; -W" />
                <Add Vector = " 0; -W; -W" />
                <Add Vector = " 0; -W;  W" />
                <Add Vector = " 0;  W;  W" />
                <Add Vector = " 0;  W; -W" />
                <Add Vector = " W; -W;  0" />
                <Add Vector = " W;  0;  W" />
                <Add Vector = " W;  W;  0" />
                <Add Vector = " W;  0; -W" />
                <Add Vector = " 0;  0;  A" />
                <Add Vector = " 0;  0; -A" />
                <Add Vector = " A;  0;  0" />
                <Add Vector = "-A;  0;  0" />
                <Add Vector = " 0;  A;  0" />
                <Add Vector = " 0; -A;  0" />
            </Vertices>

            <Faces>
                <Face Color = "FF800A" VertexIndexes = "0;4;17"   InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "4;8;17"   InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "8;5;17"   InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "5;0;17"   InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "2;6;16"   InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "6;10;16"  InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "10;7;16"  InvisibleEdges = "6" />
                <Face Color = "FF800A" VertexIndexes = "7;2;16"   InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "0;1;15"   InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "1;2;15"   InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "2;3;15"   InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "3;0;15"   InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "11;10;14" InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "10;9;14"  InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "9;8;14"   InvisibleEdges = "6" />
                <Face Color = "FFFF00" VertexIndexes = "8;11;14"  InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "3;7;13"   InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "7;11;13"  InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "11;4;13"  InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "4;3;13"   InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "1;5;12"   InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "5;9;12"   InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "9;6;12"   InvisibleEdges = "6" />
                <Face Color = "C80000" VertexIndexes = "6;1;12"   InvisibleEdges = "6" />
                <Face Color = "FFFFFF" VertexIndexes = "0;3;4"   />
                <Face Color = "0000C8" VertexIndexes = "2;7;3"   />
                <Face Color = "964B00" VertexIndexes = "0;5;1"   />
                <Face Color = "009600" VertexIndexes = "1;6;2"   />
                <Face Color = "009600" VertexIndexes = "4;11;8"  />
                <Face Color = "964B00" VertexIndexes = "7;10;11" />
                <Face Color = "0000C8" VertexIndexes = "5;8;9"   />
                <Face Color = "FFFFFF" VertexIndexes = "6;9;10"  />
            </Faces>
        </Part>
        <S2plit Axis = "1" From = "1" />
        <SplitByAxes/>

        <Macro Name = "Cut" >
            <HideContaining Vector = " W/2; -W  ; -W/2" />
            <HideContaining Vector = " W/2;  W/2;  W  " />
            <HideContaining Vector = "-W/2; -W  ; -W/2" />
            <HideContaining Vector = "-W/2;  W/2;  W  " />
            <HideContaining Vector = " W/2; -W/2; -W  " />
            <HideContaining Vector = " W/2;  W  ;  W/2" />
            <HideContaining Vector = "-W/2; -W/2; -W  " />
            <HideContaining Vector = "-W/2;  W  ;  W/2" />
            <InvertVisibility/>
            <Cut><Plane NormVector = "-2; 1;-1" NormDistance = "-DCut" /></Cut>
            <Cut><Plane NormVector = " 2; 1;-1" NormDistance = "-DCut" /></Cut>
            <Cut><Plane NormVector = "-2;-1; 1" NormDistance = "-DCut" /></Cut>
            <Cut><Plane NormVector = " 2;-1; 1" NormDistance = "-DCut" /></Cut>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Cut" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Cut" />
        <Turn Axis = "7" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Cut" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Cut" />
        <Turn Axis = "7" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Cut" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "Cut" />
        <Undo Repeat = "5" />

        <Undo/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
