<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Clover Unbandaged</Name>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Master Clover Unbandaged</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-08</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6600'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        CColor[0] := '1FAF00';
        CColor[1] := '7F00FF';
        CColor[2] := 'FFAF00';
        CColor[3] := '0099FF';
        CColor[4] := '00FF7F';
        CColor[5] := 'AFFF00';
        CColor[6] := 'FF007F';
        CColor[7] := 'AF1F00';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        <!-- variables chosen in a way to prevent overhang bandaging -->
        A := W * 1.285;
        B := W * 0.02;
        RCut := W * 2 * sqrt(3) / 3 * 1.035;

        D := W * 0.93;

        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <SplitByAxes/>

        <RemoveContaining Vector = "0; 0; 0" />
        <HideAll/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>

        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <SplitByAxes/>

        <HideContaining Vector = "0; 0; 0" />
        <RemoveAllVisible/>

        <ShowAll/>

        <Cut Color = "CColor[0]"> <Plane NormVector = " 1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[1]"> <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[2]"> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[3]"> <Plane NormVector = " 1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[4]"> <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[5]"> <Plane NormVector = "-1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[6]"> <Plane NormVector = "-1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "CColor[7]"> <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>

        <Macro Name = "Split" >
            <Turn  Axis = "Ax1" Layer = "0" Angle = "A * JumAngle" />
            <Turn  Axis = "Ax1" Layer = "2" Angle = "A * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "0" Angle = "B * JumAngle" />
            <Turn  Axis = "Ax2" Layer = "2" Angle = "B * JumAngle" />
            <Split Axis = "Ax1" From  = "1" />
            <Split Axis = "Ax1" From  = "2" />
            <Undo Repeat = "4" />
        </Macro>

        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "5" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "4" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "5" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "4" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "0" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "0" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "2" Ax2 = "3" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "1" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "3" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "1" A = " 1" B = "-1" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
