<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rexoctahedron^3</Name>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Rexoctahedron^3</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7739</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Colors[ 6] := '006622';
        Colors[ 7] := '8800FF';
        Colors[ 8] := '999999';
        Colors[ 9] := 'FFBB00';
        Colors[10] := 'AA4400';
        Colors[11] := 'FF88FF';
        Colors[12] := 'EE00EE';
        Colors[13] := '00CCCC';

        W := 0.5;
        A := W * 1.1;
        D1 := W / sqrt(3);
        D2 := W / 2;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W; 0; W" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = "-W; 0;-W" />
                <Add Vector = " 0;-W;-W" />
                <Add Vector = " 0;-W; W" />
                <Add Vector = " 0; W; W" />
                <Add Vector = " 0; W;-W" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " W; 0; W" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " W; 0;-W" />
                <Add Vector = " 0; 0; A" />
                <Add Vector = " 0; 0;-A" />
                <Add Vector = " A; 0; 0" />
                <Add Vector = "-A; 0; 0" />
                <Add Vector = " 0; A; 0" />
                <Add Vector = " 0;-A; 0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 1;15" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = " 1; 2;15" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = " 2; 3;15" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = " 3; 0;15" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "11;10;14" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "10; 9;14" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = " 9; 8;14" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = " 8;11;14" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = " 0; 4;17" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = " 4; 8;17" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = " 8; 5;17" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = " 5; 0;17" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = " 2; 6;16" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = " 6;10;16" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "10; 7;16" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = " 7; 2;16" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = " 3; 7;13" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = " 7;11;13" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "11; 4;13" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = " 4; 3;13" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = " 1; 5;12" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = " 5; 9;12" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = " 9; 6;12" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = " 6; 1;12" InvisibleEdges = "6" />

                <Face Color = "Colors[ 6]" VertexIndexes = "0; 3; 4" />
                <Face Color = "Colors[ 7]" VertexIndexes = "2; 7; 3" />
                <Face Color = "Colors[ 8]" VertexIndexes = "0; 5; 1" />
                <Face Color = "Colors[ 9]" VertexIndexes = "1; 6; 2" />
                <Face Color = "Colors[10]" VertexIndexes = "4;11; 8" />
                <Face Color = "Colors[11]" VertexIndexes = "7;10;11" />
                <Face Color = "Colors[12]" VertexIndexes = "5; 8; 9" />
                <Face Color = "Colors[13]" VertexIndexes = "6; 9;10" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>

