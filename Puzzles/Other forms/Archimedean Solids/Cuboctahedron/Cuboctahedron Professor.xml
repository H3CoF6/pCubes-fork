<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboctahedron Professor</Name>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Cuboctahedron Professor</Menu>
        <Inventor>Jürgen Brandt</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-09-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=669</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W / 5;
        D2 := W * 3 / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboctahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
