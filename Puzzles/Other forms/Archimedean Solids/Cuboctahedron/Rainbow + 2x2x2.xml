<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rainbow + 2x2x2</Name>
        <Aliases>Rainbow Plus</Aliases>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Rainbow + 2x2x2</Menu>
        <Inventor>Eric Vergo</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-02-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8975</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboctahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
