<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Odd Helicopter Cuboctahedron</Name>
        <Menu>Other forms\Archimedean Solids\Cuboctahedron\Odd Helicopter Cuboctahedron</Menu>
        <Inventor>Brung Hee Yung</Inventor>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3833</Link>
        <Added>2017-01-28</Added>
    </Interface>

    <Script>
        W := 0.5;
        D := sqrt(2) / 4;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <RemoveContaining Vector = "  W;  W;  W" />
        <RemoveContaining Vector = "  W;  W; -W" />
        <RemoveContaining Vector = "  W; -W;  W" />
        <RemoveContaining Vector = "  W; -W; -W" />
        <RemoveContaining Vector = " -W;  W;  W" />
        <RemoveContaining Vector = " -W;  W; -W" />
        <RemoveContaining Vector = " -W; -W;  W" />
        <RemoveContaining Vector = " -W; -W; -W" />
    </Figure>
</xml>
