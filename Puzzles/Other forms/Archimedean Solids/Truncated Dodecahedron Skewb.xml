<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Truncated Dodecahedron Skewb</Name>
        <Menu>Other forms\Archimedean Solids\Truncated Dodecahedron\Truncated Dodecahedron Skewb</Menu>
        <Menu>Other forms\Skewb variants\Truncated Dodecahedron Skewb</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3306</Link>
    </Interface>

    <Script>
        ColorCut   := '009F'; // DarkCyan

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        DCut := R * (5 + 4 * sqrt(5)) / 15;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " Vx[2];Vy[2];Vz[2]" />
        <Axis NormVector = " Vx[4];Vy[4];Vz[4]" />
        <Axis NormVector = " Vx[6];Vy[6];Vz[6]" />
        <Axis NormVector = " Vx[5];Vy[5];Vz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "CutV" >
            <Cut Color = "ColorCut + IntToStr(78 + IntToStr(v))" ><Plane NormVector = " Vx[v];Vy[v];Vz[v]" NormDistance = "-DCut" /></Cut>
            <Script>Inc(v);</Script>
        </Macro>
        <ExecMacro MacroName = "CutV" v = "0" Repeat = "20" />
        <SplitByAxes/>
    </Figure>
</xml>
