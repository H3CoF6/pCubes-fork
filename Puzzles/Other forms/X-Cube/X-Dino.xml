<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-Dino</Name>
        <Menu>Other forms\X-Cube\X-Dino</Menu>
        <Inventor>Vadim Grishin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3844</Link>
    </Interface>

    <Script>
        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Colors[ 6] := '00FFFF'; // clCyan
        Colors[ 7] := '008080'; // clTeal
        Colors[ 8] := 'FF00FF'; // clFuchsia
        Colors[ 9] := '00FF00'; // clLime
        Colors[10] := 'FF69B4'; // clPink
        Colors[11] := '004000'; // clDarkGreen
        Colors[12] := '808000'; // clOlive
        Colors[13] := '800000'; // clBrown

        D := W / sqrt(3);
        DCut := W * 0.8;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-W" />
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W; 0; 0" />
                <Add Vector = "-W; 0;-W" />
                <Add Vector = " 0;-W;-W" />
                <Add Vector = " 0;-W; 0" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "0; 4; 5; 1" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "0; 3; 6; 4" InvisibleEdges = "6" />
                <Face VertexIndexes = "4; 6; 7; 5" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "2; 1; 5; 7" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W; 0; W" />
                <Add Vector = "-W; 0; 0" />
                <Add Vector = "-W;-W; 0" />
                <Add Vector = " 0;-W; 0" />
                <Add Vector = " 0;-W; W" />
                <Add Vector = " 0; 0; W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "0; 3; 4; 5" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "0; 5; 6; 1" InvisibleEdges = "6" />
                <Face VertexIndexes = "5; 4; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "1; 6; 7; 2" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 4" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W; 0;-W" />
                <Add Vector = "-W; 0; 0" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = " 0; W; 0" />
                <Add Vector = " 0; W;-W" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0; 3; 4; 5" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "0; 5; 6; 1" InvisibleEdges = "6" />
                <Face VertexIndexes = "5; 4; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "1; 6; 7; 2" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 4" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = "-W; W; W" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = "-W; 0; 0" />
                <Add Vector = "-W; 0; W" />
                <Add Vector = " 0; W; W" />
                <Add Vector = " 0; W; 0" />
                <Add Vector = " 0; 0; W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0; 4; 5; 1" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "0; 3; 6; 4" InvisibleEdges = "6" />
                <Face VertexIndexes = "4; 6; 7; 5" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "2; 1; 5; 7" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = " W;-W;-W" />
                <Add Vector = " W; 0;-W" />
                <Add Vector = " W; 0; 0" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " 0;-W; 0" />
                <Add Vector = " 0;-W;-W" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "0; 3; 4; 5" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "0; 5; 6; 1" InvisibleEdges = "6" />
                <Face VertexIndexes = "5; 4; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "1; 6; 7; 2" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 4" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = " W;-W; W" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " W; 0; 0" />
                <Add Vector = " W; 0; W" />
                <Add Vector = " 0;-W; W" />
                <Add Vector = " 0;-W; 0" />
                <Add Vector = " 0; 0; W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "0; 4; 5; 1" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "0; 3; 6; 4" InvisibleEdges = "6" />
                <Face VertexIndexes = "4; 6; 7; 5" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "2; 1; 5; 7" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = " W; W;-W" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " W; 0; 0" />
                <Add Vector = " W; 0;-W" />
                <Add Vector = " 0; W;-W" />
                <Add Vector = " 0; W; 0" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0; 4; 5; 1" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "0; 3; 6; 4" InvisibleEdges = "6" />
                <Face VertexIndexes = "4; 6; 7; 5" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "2; 1; 5; 7" InvisibleEdges = "15" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = " W; W; W" />
                <Add Vector = " W; 0; W" />
                <Add Vector = " W; 0; 0" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " 0; W; 0" />
                <Add Vector = " 0; W; W" />
                <Add Vector = " 0; 0; W" />
                <Add Vector = " 0; 0; 0" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0; 1; 2; 3" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "0; 3; 4; 5" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "0; 5; 6; 1" InvisibleEdges = "6" />
                <Face VertexIndexes = "5; 4; 7; 6" InvisibleEdges = "15" />
                <Face VertexIndexes = "1; 6; 7; 2" InvisibleEdges = "15" />
                <Face VertexIndexes = "3; 2; 7; 4" InvisibleEdges = "15" />
            </Faces>
        </Part>

        <Macro Name = "Cut" >
            <HideContaining Vector = "Vx[i]; Vy[i]; Vz[i]" />
            <Cut Color = "Colors[i + 6]" > <Plane NormVector = "-Vx[i];-Vy[i];-Vz[i]" NormDistance = "-DCut" /> </Cut>
            <ShowAll/>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" Repeat = "8" />

        <SplitByAxes />

    </Figure>
</xml>
