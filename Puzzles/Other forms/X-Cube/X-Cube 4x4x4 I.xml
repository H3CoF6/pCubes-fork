<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-Cube 4x4x4 I</Name>
        <Menu>Other forms\X-Cube\X-Cube 4x4x4 I</Menu>
        <Inventor>Adam Zamora</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3212</Link>
    </Interface>

    <Script>
        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Colors[ 6] := '00FFFF'; // clCyan
        Colors[ 7] := 'FF69B4'; // clPink

        D := W / 2;
        DCut := W * sqrt(3) / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = " 0;25; 8" InvisibleEdges = "4" />
                <Face Color = "Colors[4]" VertexIndexes = "25; 1; 8" InvisibleEdges = "2" />
                <Face Color = "Colors[1]" VertexIndexes = " 1;16; 8" InvisibleEdges = "4" />
                <Face Color = "Colors[5]" VertexIndexes = "16; 3; 8" InvisibleEdges = "2" />
                <Face Color = "Colors[7]" VertexIndexes = " 3;24; 8" InvisibleEdges = "4" />
                <Face Color = "Colors[1]" VertexIndexes = "24; 2; 8" InvisibleEdges = "2" />
                <Face Color = "Colors[4]" VertexIndexes = " 2;23; 8" InvisibleEdges = "4" />
                <Face Color = "Colors[7]" VertexIndexes = "23; 0; 8" InvisibleEdges = "2" />

                <Face Color = "Colors[3]" VertexIndexes = " 5;18; 9" InvisibleEdges = "4" />
                <Face Color = "Colors[0]" VertexIndexes = "18; 4; 9" InvisibleEdges = "2" />
                <Face Color = "Colors[6]" VertexIndexes = " 4;22; 9" InvisibleEdges = "4" />
                <Face Color = "Colors[3]" VertexIndexes = "22; 6; 9" InvisibleEdges = "2" />
                <Face Color = "Colors[2]" VertexIndexes = " 6;19; 9" InvisibleEdges = "4" />
                <Face Color = "Colors[6]" VertexIndexes = "19; 7; 9" InvisibleEdges = "2" />
                <Face Color = "Colors[0]" VertexIndexes = " 7;17; 9" InvisibleEdges = "4" />
                <Face Color = "Colors[2]" VertexIndexes = "17; 5; 9" InvisibleEdges = "2" />

                <Face Color = "Colors[4]" VertexIndexes = " 1;25;10" InvisibleEdges = "4" />
                <Face Color = "Colors[5]" VertexIndexes = "25; 0;10" InvisibleEdges = "2" />
                <Face Color = "Colors[3]" VertexIndexes = " 0;21;10" InvisibleEdges = "4" />
                <Face Color = "Colors[4]" VertexIndexes = "21; 4;10" InvisibleEdges = "2" />
                <Face Color = "Colors[0]" VertexIndexes = " 4;18;10" InvisibleEdges = "4" />
                <Face Color = "Colors[3]" VertexIndexes = "18; 5;10" InvisibleEdges = "2" />
                <Face Color = "Colors[5]" VertexIndexes = " 5;14;10" InvisibleEdges = "4" />
                <Face Color = "Colors[0]" VertexIndexes = "14; 1;10" InvisibleEdges = "2" />

                <Face Color = "Colors[1]" VertexIndexes = " 2;24;11" InvisibleEdges = "4" />
                <Face Color = "Colors[7]" VertexIndexes = "24; 3;11" InvisibleEdges = "2" />
                <Face Color = "Colors[2]" VertexIndexes = " 3;15;11" InvisibleEdges = "4" />
                <Face Color = "Colors[1]" VertexIndexes = "15; 7;11" InvisibleEdges = "2" />
                <Face Color = "Colors[6]" VertexIndexes = " 7;19;11" InvisibleEdges = "4" />
                <Face Color = "Colors[2]" VertexIndexes = "19; 6;11" InvisibleEdges = "2" />
                <Face Color = "Colors[7]" VertexIndexes = " 6;20;11" InvisibleEdges = "4" />
                <Face Color = "Colors[6]" VertexIndexes = "20; 2;11" InvisibleEdges = "2" />

                <Face Color = "Colors[7]" VertexIndexes = " 0;23;12" InvisibleEdges = "4" />
                <Face Color = "Colors[4]" VertexIndexes = "23; 2;12" InvisibleEdges = "2" />
                <Face Color = "Colors[6]" VertexIndexes = " 2;20;12" InvisibleEdges = "4" />
                <Face Color = "Colors[7]" VertexIndexes = "20; 6;12" InvisibleEdges = "2" />
                <Face Color = "Colors[3]" VertexIndexes = " 6;22;12" InvisibleEdges = "4" />
                <Face Color = "Colors[6]" VertexIndexes = "22; 4;12" InvisibleEdges = "2" />
                <Face Color = "Colors[4]" VertexIndexes = " 4;21;12" InvisibleEdges = "4" />
                <Face Color = "Colors[3]" VertexIndexes = "21; 0;12" InvisibleEdges = "2" />

                <Face Color = "Colors[5]" VertexIndexes = " 3;16;13" InvisibleEdges = "4" />
                <Face Color = "Colors[1]" VertexIndexes = "16; 1;13" InvisibleEdges = "2" />
                <Face Color = "Colors[0]" VertexIndexes = " 1;14;13" InvisibleEdges = "4" />
                <Face Color = "Colors[5]" VertexIndexes = "14; 5;13" InvisibleEdges = "2" />
                <Face Color = "Colors[2]" VertexIndexes = " 5;17;13" InvisibleEdges = "4" />
                <Face Color = "Colors[0]" VertexIndexes = "17; 7;13" InvisibleEdges = "2" />
                <Face Color = "Colors[1]" VertexIndexes = " 7;15;13" InvisibleEdges = "4" />
                <Face Color = "Colors[2]" VertexIndexes = "15; 3;13" InvisibleEdges = "2" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />

        <Macro Name = "Cut" >
            <HideContaining Vector = "Vx[i]; Vy[i]; Vz[i]" />
            <Cut Color = "Colors[c]" > <Plane NormVector = "-Vx[i];-Vy[i];-Vz[i]" NormDistance = "-DCut" /> </Cut>
            <ShowAll/>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" c = "4" />
        <ExecMacro MacroName = "Cut" i = "1" c = "5" />
        <ExecMacro MacroName = "Cut" i = "2" c = "7" />
        <ExecMacro MacroName = "Cut" i = "3" c = "1" />
        <ExecMacro MacroName = "Cut" i = "4" c = "3" />
        <ExecMacro MacroName = "Cut" i = "5" c = "0" />
        <ExecMacro MacroName = "Cut" i = "6" c = "6" />
        <ExecMacro MacroName = "Cut" i = "7" c = "2" />

        <SplitByAxes />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
