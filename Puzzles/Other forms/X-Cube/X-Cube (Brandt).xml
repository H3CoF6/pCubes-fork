<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-Cube (Brandt)</Name>
        <Menu>Other forms\X-Cube\X-Cube (Brandt)</Menu>
        <Menu>Other forms\3x3x3 variants\Star\X-Cube (Brandt)</Menu>
        <Inventor>Jürgen Brandt</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3181</Link>
    </Interface>

    <Script>
        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Colors[ 6] := '00FFFF'; // clCyan
        Colors[ 7] := 'FF69B4'; // clPink

        D := W / 3;
        DCut := W * 4 / 9 * sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddColor" >
                <Face Color = "Colors[c]" VertexIndexes = "v1;e1;c1" InvisibleEdges = "6" />
                <Face Color = "Colors[c]" VertexIndexes = "e1;v1;c2" InvisibleEdges = "6" />
                <Face Color = "Colors[c]" VertexIndexes = "v2;e2;c2" InvisibleEdges = "6" />
                <Face Color = "Colors[c]" VertexIndexes = "e2;v2;c3" InvisibleEdges = "6" />
                <Face Color = "Colors[c]" VertexIndexes = "v3;e3;c3" InvisibleEdges = "6" />
                <Face Color = "Colors[c]" VertexIndexes = "e3;v3;c1" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <ExecMacro MacroName = "AddColor" c = "0" v1 = " 1" v2 = " 4" v3 = " 7" c1 = "13" c2 = "10" c3 = " 9" e1 = "14" e2 = "18" e3 = "17" />
                <ExecMacro MacroName = "AddColor" c = "1" v1 = " 1" v2 = " 7" v3 = " 2" c1 = " 8" c2 = "13" c3 = "11" e1 = "16" e2 = "15" e3 = "24" />
                <ExecMacro MacroName = "AddColor" c = "2" v1 = " 3" v2 = " 5" v3 = " 6" c1 = "11" c2 = "13" c3 = " 9" e1 = "15" e2 = "17" e3 = "19" />
                <ExecMacro MacroName = "AddColor" c = "3" v1 = " 0" v2 = " 6" v3 = " 5" c1 = "10" c2 = "12" c3 = " 9" e1 = "21" e2 = "22" e3 = "18" />
                <ExecMacro MacroName = "AddColor" c = "4" v1 = " 1" v2 = " 2" v3 = " 4" c1 = "10" c2 = " 8" c3 = "12" e1 = "25" e2 = "23" e3 = "21" />
                <ExecMacro MacroName = "AddColor" c = "5" v1 = " 0" v2 = " 5" v3 = " 3" c1 = " 8" c2 = "10" c3 = "13" e1 = "25" e2 = "14" e3 = "16" />
                <ExecMacro MacroName = "AddColor" c = "6" v1 = " 2" v2 = " 7" v3 = " 4" c1 = "12" c2 = "11" c3 = " 9" e1 = "20" e2 = "19" e3 = "22" />
                <ExecMacro MacroName = "AddColor" c = "7" v1 = " 0" v2 = " 3" v3 = " 6" c1 = "12" c2 = " 8" c3 = "11" e1 = "23" e2 = "24" e3 = "20" />
            </Faces>
        </Part>

        <SplitByAxes />

        <Macro Name = "HideCenters">
            <HideContaining Vector = "Cx[i];Cy[i];Cz[i]" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCenters" Repeat = "6" i = "0" />

        <Split> <Plane NormVector = "1;0;0"/> </Split>
        <Split> <Plane NormVector = "0;1;0"/> </Split>
        <Split> <Plane NormVector = "0;0;1"/> </Split>

        <Macro Name = "Cut" >
            <HideContaining Vector = "Vx[i]/3; Vy[i]/3; Vz[i]/3" />
            <Cut Color = "Colors[c]" > <Plane NormVector = "-Vx[i];-Vy[i];-Vz[i]" NormDistance = "-DCut" /> </Cut>
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" c = "4" />
        <ExecMacro MacroName = "Cut" i = "1" c = "5" />
        <ExecMacro MacroName = "Cut" i = "2" c = "7" />
        <ExecMacro MacroName = "Cut" i = "3" c = "1" />
        <ExecMacro MacroName = "Cut" i = "4" c = "3" />
        <ExecMacro MacroName = "Cut" i = "5" c = "0" />
        <ExecMacro MacroName = "Cut" i = "6" c = "6" />
        <ExecMacro MacroName = "Cut" i = "7" c = "2" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
