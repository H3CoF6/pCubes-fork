<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Helicopter Pyramid</Name>
        <Menu>Other forms\Pyramid\Triangular Pyramid\Helicopter Pyramid</Menu>
        <Inventor>Hunter Palshook</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-05-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4773</Link>
    </Interface>

    <Script>
        ClBlue  := '0000C8';
        ClGrey  := '939393';
        ClGreen := '009600';
        ClRed   := 'C80000';

        R := 0.7;
        W := R * sqrt(2) / 4;
        J := Arccos(1 / 3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "J" PlaneDistances = "W" FixedLayers = "0" >
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = " 0; -1;  1" />
        <Axis NormVector = " 1; -1;  0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " R/2; -R/2; -R  " />
                <Add Vector = " R/2;  R  ;  R/2" />
                <Add Vector = "-R  ; -R/2;  R/2" />
                <Add Vector = " R/2; -R/2;  R/2" />
            </Vertices>

            <Faces>
                <Face Color = "ClBlue " VertexIndexes = "0; 1; 3" />
                <Face Color = "ClGrey " VertexIndexes = "0; 2; 1" />
                <Face Color = "ClGreen" VertexIndexes = "0; 3; 2" />
                <Face Color = "ClRed  " VertexIndexes = "1; 2; 3" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "Pi" />
        <SplitByAxes/>
        <Turn  Axis = "0" Layer = "1" Angle = "Pi" />

        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = "Pi" />
        <SplitByAxes/>
        <Turn  Axis = "1" Layer = "1" Angle = "Pi" />

        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = "Pi" />
        <SplitByAxes/>
        <Turn  Axis = "2" Layer = "1" Angle = "Pi" />
    </Figure>
</xml>
