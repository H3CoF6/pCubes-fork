<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Domino Pyramid</Name>
        <Menu>Other forms\Pyramid\Squared Pyramid\Domino Pyramid</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\Domino Pyramid</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3214</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBlue   := '0000A0';
        clRed    := 'FF0000';
        clWhite  := 'FFFFFF';

        L  := 0.6;
        H  :=  L * sqrt(2);
        dH := -L * 0.40;
        D  :=  L * 0.31;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi"  PlaneDistances = "-D; D">
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0;  0; H+dH" />
                <Add Vector = " L;  L;   dH" />
                <Add Vector = " L; -L;   dH" />
                <Add Vector = "-L; -L;   dH" />
                <Add Vector = "-L;  L;   dH" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "1;2;3;4" />
                <Face Color = "clRed   " VertexIndexes = "0;2;1" />
                <Face Color = "clYellow" VertexIndexes = "0;3;2" />
                <Face Color = "clGreen " VertexIndexes = "0;4;3" />
                <Face Color = "clBlue  " VertexIndexes = "0;1;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
