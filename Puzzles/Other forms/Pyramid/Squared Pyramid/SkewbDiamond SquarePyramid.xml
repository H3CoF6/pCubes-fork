<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SkewbDiamond SquarePyramid</Name>
        <Menu>Other forms\Pyramid\Squared Pyramid\SkewbDiamond SquarePyramid</Menu>
        <Menu>Other forms\Skewb variants\SkewbDiamond SquarePyramid</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\SkewbDiamond SquarePyramid</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3879</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBlue   := '0000A0';
        clRed    := 'FF0000';
        clWhite  := 'FFFFFF';

        W := 0.6;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0    ;  0    ;  W  " />
                <Add Vector = " W*3/2;  0    ; -W/2" />
                <Add Vector = " 0    ; -W*3/2; -W/2" />
                <Add Vector = "-W*3/2;  0    ; -W/2" />
                <Add Vector = " 0    ;  W*3/2; -W/2" />

                <Add Vector = " W;  0; 0" />
                <Add Vector = " 0; -W; 0" />
                <Add Vector = "-W;  0; 0" />
                <Add Vector = " 0;  W; 0" />

                <Add Vector = " W  ; -W/2; -W/2" />
                <Add Vector = " W/2; -W  ; -W/2" />
                <Add Vector = "-W/2; -W  ; -W/2" />
                <Add Vector = "-W  ; -W/2; -W/2" />
                <Add Vector = "-W  ;  W/2; -W/2" />
                <Add Vector = "-W/2;  W  ; -W/2" />
                <Add Vector = " W/2;  W  ; -W/2" />
                <Add Vector = " W  ;  W/2; -W/2" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow" VertexIndexes = "0;6;5" />
                <Face Color = "clYellow" VertexIndexes = "5;9;1" />
                <Face Color = "clYellow" VertexIndexes = "6;2;10" />
                <Face Color = "clYellow" VertexIndexes = "5;6;10;9" />

                <Face Color = "clGreen " VertexIndexes = "0;7;6" />
                <Face Color = "clGreen " VertexIndexes = "6;11;2" />
                <Face Color = "clGreen " VertexIndexes = "7;3;12" />
                <Face Color = "clGreen " VertexIndexes = "6;7;12;11" />

                <Face Color = "clBlue  " VertexIndexes = "0;8;7" />
                <Face Color = "clBlue  " VertexIndexes = "7;13;3" />
                <Face Color = "clBlue  " VertexIndexes = "8;4;14" />
                <Face Color = "clBlue  " VertexIndexes = "7;8;14;13" />

                <Face Color = "clRed   " VertexIndexes = "0;5;8" />
                <Face Color = "clRed   " VertexIndexes = "8;15;4" />
                <Face Color = "clRed   " VertexIndexes = "5;1;16" />
                <Face Color = "clRed   " VertexIndexes = "8;5;16;15" />

                <Face Color = "clWhite " VertexIndexes = "1;2;3;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
