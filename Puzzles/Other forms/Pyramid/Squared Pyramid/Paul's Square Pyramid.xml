<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Paul's Square Pyramid</Name>
        <Menu>Other forms\Pyramid\Squared Pyramid\Paul's Square Pyramid</Menu>
        <Menu>Other forms\3x3x3 variants\Johnson\Paul's Square Pyramid</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\Paul's Square Pyramid</Menu>
        <Inventor>Paul Wozniak</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2005</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBlue   := '0000A0';
        clRed    := 'FF0000';
        clWhite  := 'FFFFFF';

        H  := 1 / sqrt(2);
        dH := -0.20;
        D := 0.08;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D;D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/2"  PlaneDistances = "-D;D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0; H+dH" />
                <Add Vector = " 0.5;  0.5;   dH" />
                <Add Vector = " 0.5; -0.5;   dH" />
                <Add Vector = "-0.5; -0.5;   dH" />
                <Add Vector = "-0.5;  0.5;   dH" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "1;2;3;4" />
                <Face Color = "clRed   " VertexIndexes = "0;2;1" />
                <Face Color = "clYellow" VertexIndexes = "0;3;2" />
                <Face Color = "clGreen " VertexIndexes = "0;4;3" />
                <Face Color = "clBlue  " VertexIndexes = "0;1;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
