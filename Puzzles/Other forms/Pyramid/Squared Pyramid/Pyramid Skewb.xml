<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyramid Skewb</Name>
        <Menu>Other forms\Pyramid\Squared Pyramid\Pyramid Skewb</Menu>
        <Menu>Other forms\Skewb variants\Pyramid Skewb</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\Pyramid Skewb</Menu>
        <Inventor>Benjy Oliver</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-03-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3375</Link>
    </Interface>

    <Script>
        W := 0.6;

        clGreen  := '008000';
        clOrange := 'FF800A';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clBlue   := '0000A0';
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W;  W; -W / 2" />
                <Add Vector = "-W;  W; -W / 2" />
                <Add Vector = "-W; -W; -W / 2" />
                <Add Vector = " W; -W; -W / 2" />
                <Add Vector = " 0;  0;  W    " />
            </Vertices>

            <Faces>
                <Face Color = "clGreen"  VertexIndexes = "0; 4; 3" />
                <Face Color = "clOrange" VertexIndexes = "1; 4; 0" />
                <Face Color = "clRed"    VertexIndexes = "2; 4; 1" />
                <Face Color = "clYellow" VertexIndexes = "3; 4; 2" />
                <Face Color = "clBlue"   VertexIndexes = "0; 3; 2; 1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>