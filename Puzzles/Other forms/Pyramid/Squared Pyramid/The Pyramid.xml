<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>The Pyramid</Name>
        <Menu>Other forms\Pyramid\Squared Pyramid\The Pyramid</Menu>
        <Menu>Other forms\3x3x3 variants\Johnson\The Pyramid</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\The Pyramid</Menu>
        <Inventor>Chiou Sheng Wen</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1954</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBlue   := '0000A0';
        clRed    := 'FF0000';
        clWhite  := 'FFFFFF';

        W  := 0.75;
        D  := W * 0.09;
        H1 :=-W / 3;
        H2 := W * 2 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "Pi / 4" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi / 4" />
        <Turn NormVector = " 0; 0; 1" Angle = "Pi / 4" />

        <Part>
            <Vertices>
                <Add Vector = "-W; 0; H1" />
                <Add Vector = " W; 0; H1" />
                <Add Vector = " 0;-W; H1" />
                <Add Vector = " 0; W; H1" />
                <Add Vector = " 0; 0; H2" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow" VertexIndexes = "0;2;4" />
                <Face Color = "clGreen " VertexIndexes = "4;2;1" />
                <Face Color = "clBlue  " VertexIndexes = "4;1;3" />
                <Face Color = "clRed   " VertexIndexes = "4;3;0" />
                <Face Color = "clWhite " VertexIndexes = "3;1;2;0" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
