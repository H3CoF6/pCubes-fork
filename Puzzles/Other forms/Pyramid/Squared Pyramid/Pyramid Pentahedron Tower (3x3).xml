<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyramid Pentahedron Tower (3x3)</Name>
        <Menu>Other forms\Pyramid\Squared Pyramid\Pyramid Pentahedron Tower (3x3)</Menu>
        <Menu>Other forms\Skewb variants\Pyramid Pentahedron Tower (3x3)</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\Pyramid Pentahedron Tower (3x3)</Menu>
        <Inventor>Lee Zhen Xing</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2024-12-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10441</Link>
    </Interface>

    <Script>
        clGreen  := '008000';
        clOrange := 'FF800A';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clBlue   := '0000A0';

        W := 0.5;
        s2 := sqrt(2);
        H1 :=-W * s2 / 3;
        H2 := W * s2 / 3 * 4;
    </Script>

    <Axes TurningAngles = "2*Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "  0; s2; 1" />
        <Axis NormVector = "-s2;  0; 1" />
        <Axis NormVector = "  0;-s2; 1" />
        <Axis NormVector = " s2;  0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W; W; H1" />
                <Add Vector = "-W; W; H1" />
                <Add Vector = "-W;-W; H1" />
                <Add Vector = " W;-W; H1" />
                <Add Vector = " 0; 0; H2" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen"  VertexIndexes = "0; 4; 3" />
                <Face Color = "clOrange" VertexIndexes = "1; 4; 0" />
                <Face Color = "clRed"    VertexIndexes = "2; 4; 1" />
                <Face Color = "clYellow" VertexIndexes = "3; 4; 2" />
                <Face Color = "clBlue"   VertexIndexes = "0; 3; 2; 1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
