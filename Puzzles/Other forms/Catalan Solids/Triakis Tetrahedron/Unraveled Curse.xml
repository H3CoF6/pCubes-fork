<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unraveled Curse</Name>
        <Menu>Other forms\Catalan Solids\Triakis Tetrahedron\Unraveled Curse</Menu>
        <Inventor>Ian Henriksen</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-10-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12075</Link>
    </Interface>

    <Script>
        clPurple    := '800080';
        clPink      := 'FF69B4';
        clBrown     := '800000';

        clOrange    := 'FF6000';
        clRed       := 'FF0000';
        clYellow    := 'FFFF00';

        clGreen     := '008000';
        clLime      := '00FF00';
        clDarkGreen := '005400';

        clBlue      := '0000FF';
        clNavy      := '000080';
        clCyan      := '00FFFF';
        
        clBlack     := '333333';
        
        K  := 0.6;
        C0 := K * 0.6;
        C1 := K;
        
        D := K * 0.75;
        E := K * 3 / sqrt(11);

        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = " 1;-3; 1" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 1; 1;-3" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = "-3; 1; 1" />
        <Axis NormVector = "-1;-1;-3" />
        <Axis NormVector = "-1;-3;-1" />
        <Axis NormVector = "-3;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clPurple   " VertexIndexes = "4;0;2" />
                <Face Color = "clPink     " VertexIndexes = "4;2;1" />
                <Face Color = "clBrown    " VertexIndexes = "4;1;0" />

                <Face Color = "clOrange   " VertexIndexes = "5;0;1" />
                <Face Color = "clRed      " VertexIndexes = "5;1;3" />
                <Face Color = "clYellow   " VertexIndexes = "5;3;0" />

                <Face Color = "clGreen    " VertexIndexes = "6;0;3" />
                <Face Color = "clLime     " VertexIndexes = "6;3;2" />
                <Face Color = "clDarkGreen" VertexIndexes = "6;2;0" />

                <Face Color = "clBlue     " VertexIndexes = "7;1;2" />
                <Face Color = "clNavy     " VertexIndexes = "7;2;3" />
                <Face Color = "clCyan     " VertexIndexes = "7;3;1" />
            </Faces>
        </Part>
        
        <Macro Name = "Cut" >
            <Cut Color = "clBlack" InvisibleEdges = "-1" > <Plane NormVector = " 5; 5;-7" NormDistance = "-E" /> </Cut>
            <Turn NormVector = "-1;-1; 1" Angle = "Pi / 3" />
        </Macro>
        <ExecMacro MacroName = "Cut" Repeat = "6" /> <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "6" /> <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "6" /> <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "6" /> <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
        
        <SplitByAxes/>
        
        <Macro Name = "Split" >
            <Hide  Axis = "ax1" To = "0" />
            <Hide  Axis = "ax2" To = "0" />
            <Turn  Axis = "ax1" Layer = "1" Angle = "A1" />
            <Split Axis = "ax2" From = "1"/>
            <Undo/>
            <ShowAll/>
            <Hide  Axis = "ax1" To = "0" />
            <Turn  Axis = "ax1" Layer = "1" Angle = "A2" />
            <Hide  Axis = "ax2" To = "0" />
            <Turn  Axis = "ax1" Layer = "1" Angle = "A1" />
            <Split Axis = "ax2" From = "1"/>
            <Undo Repeat = "2" />
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "Split" ax1 = " 0" ax2 = " 1" />
        <ExecMacro MacroName = "Split" ax1 = " 1" ax2 = " 2" />
        <ExecMacro MacroName = "Split" ax1 = " 2" ax2 = " 0" />

        <ExecMacro MacroName = "Split" ax1 = " 3" ax2 = " 4" />
        <ExecMacro MacroName = "Split" ax1 = " 4" ax2 = " 5" />
        <ExecMacro MacroName = "Split" ax1 = " 5" ax2 = " 3" />

        <ExecMacro MacroName = "Split" ax1 = " 6" ax2 = " 7" />
        <ExecMacro MacroName = "Split" ax1 = " 7" ax2 = " 8" />
        <ExecMacro MacroName = "Split" ax1 = " 8" ax2 = " 6" />

        <ExecMacro MacroName = "Split" ax1 = " 9" ax2 = "10" />
        <ExecMacro MacroName = "Split" ax1 = "10" ax2 = "11" />
        <ExecMacro MacroName = "Split" ax1 = "11" ax2 = " 9" />
    </Figure>
</xml>
