<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sunshine (12 colors)</Name>
        <Menu>Other forms\Catalan Solids\Triakis Tetrahedron\Sunshine (12 colors)</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8130</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=400503</Link>
    </Interface>

    <Script>
        clPurple    := '800080';
        clPink      := 'FF69B4';
        clBrown     := '800000';

        clOrange    := 'FF6000';
        clRed       := 'FF0000';
        clYellow    := 'FFFF00';

        clGreen     := '008000';
        clLime      := '00FF00';
        clDarkGreen := '005400';

        clBlue      := '0000FF';
        clNavy      := '000080';
        clCyan      := '00FFFF';

        K  := 0.5;
        C0 := K * 0.6;
        C1 := K;
        D := C0 / sqrt(3);
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D;-D*5/3" FixedLayers = "1">
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clPurple   " VertexIndexes = "4;0;2" />
                <Face Color = "clPink     " VertexIndexes = "4;2;1" />
                <Face Color = "clBrown    " VertexIndexes = "4;1;0" />

                <Face Color = "clOrange   " VertexIndexes = "5;0;1" />
                <Face Color = "clRed      " VertexIndexes = "5;1;3" />
                <Face Color = "clYellow   " VertexIndexes = "5;3;0" />

                <Face Color = "clGreen    " VertexIndexes = "6;0;3" />
                <Face Color = "clLime     " VertexIndexes = "6;3;2" />
                <Face Color = "clDarkGreen" VertexIndexes = "6;2;0" />

                <Face Color = "clBlue     " VertexIndexes = "7;1;2" />
                <Face Color = "clNavy     " VertexIndexes = "7;2;3" />
                <Face Color = "clCyan     " VertexIndexes = "7;3;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
