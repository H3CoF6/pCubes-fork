<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dinomorphix (AC)</Name>
        <Menu>Other forms\Tetrahedron\Mixed\Dinomorphix (AC)</Menu>
        <Menu>Other forms\Catalan Solids\Triakis Tetrahedron\Dinomorphix (AC)</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2026-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1784</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Tetrahedron_Standard_Colors.inc';

        K  := 0.5;
        C0 := K / 3 * 1.8; // pillow
        C1 := K;
        D := C1 / sqrt(3);
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <Macro Name = "MakePart" >
            <Part>
                <Vertices>
                    <Add Vector = " C1; C1; C1" />
                    <Add Vector = " C1;-C1;-C1" />
                    <Add Vector = "-C1;-C1; C1" />
                    <Add Vector = "-C1; C1;-C1" />
                    <Add Vector = " C0;-C0; C0" />
                    <Add Vector = " C0; C0;-C0" />
                    <Add Vector = "-C0; C0; C0" />
                    <Add Vector = "-C0;-C0;-C0" />
                </Vertices>

                <Faces>
                    <Face Color = "Color" VertexIndexes = "4;0;2" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "4;2;1" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "4;1;0" InvisibleEdges = "5" />

                    <Face Color = "Color" VertexIndexes = "5;0;1" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "5;1;3" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "5;3;0" InvisibleEdges = "5" />

                    <Face Color = "Color" VertexIndexes = "6;0;3" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "6;3;2" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "6;2;0" InvisibleEdges = "5" />

                    <Face Color = "Color" VertexIndexes = "7;1;2" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "7;2;3" InvisibleEdges = "5" />
                    <Face Color = "Color" VertexIndexes = "7;3;1" InvisibleEdges = "5" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "MakeColor" >
            <ExecMacro MacroName = "MakePart" Color = "Colors[ax]" />
            <SplitByAxes/>
            <Hide Axis = "ax" Layer = "2" />
            <RemoveAllVisible/>
        </Macro>

        <ExecMacro MacroName = "MakeColor" ax = "0" />
        <ExecMacro MacroName = "MakeColor" ax = "1" />
        <ExecMacro MacroName = "MakeColor" ax = "2" />
        <ExecMacro MacroName = "MakeColor" ax = "3" />

        <ExecMacro MacroName = "MakePart" Color = "'FFFFFF'" />
        <Cut Axis = "0" To = "2" />
        <Cut Axis = "1" To = "2" />
        <Cut Axis = "2" To = "2" />
        <Cut Axis = "3" To = "2" />
        <SplitByAxes/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
