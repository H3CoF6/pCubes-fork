<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fractured Tetrahedron</Name>
        <Menu>Other forms\Catalan Solids\Triakis Tetrahedron\Fractured Tetrahedron</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-04-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3857</Link>
    </Interface>

    <Script>
        clCyan      := '00FFFF';
        clBlue      := '0000FF';
        clNavy      := '000080';

        clPink      := 'FF69B4';
        clRed       := 'FF0000';
        clBrown     := '800000';

        clYellow    := 'FFFF00';
        clOrange    := 'FF6000';
        clPurple    := '800080';

        clLime      := '00FF00';
        clDarkGreen := '005400';
        clGreen     := '008000';

        K  := 0.5;
        C0 := K * 0.6;
        C1 := K;

        D := K * sqrt(3) / 5;
    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " C1; C1; C1" />
        <Axis NormVector = " C1;-C1;-C1" />
        <Axis NormVector = "-C1;-C1; C1" />
        <Axis NormVector = "-C1; C1;-C1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clPurple   " VertexIndexes = "4;0;2" />
                <Face Color = "clPink     " VertexIndexes = "4;2;1" />
                <Face Color = "clBrown    " VertexIndexes = "4;1;0" />

                <Face Color = "clOrange   " VertexIndexes = "5;0;1" />
                <Face Color = "clRed      " VertexIndexes = "5;1;3" />
                <Face Color = "clYellow   " VertexIndexes = "5;3;0" />

                <Face Color = "clGreen    " VertexIndexes = "6;0;3" />
                <Face Color = "clLime     " VertexIndexes = "6;3;2" />
                <Face Color = "clDarkGreen" VertexIndexes = "6;2;0" />

                <Face Color = "clBlue     " VertexIndexes = "7;1;2" />
                <Face Color = "clNavy     " VertexIndexes = "7;2;3" />
                <Face Color = "clCyan     " VertexIndexes = "7;3;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1"/>
        <Turn  Axis = "0" Layer = "1" Angle = "-Pi/3" />

        <Turn  Axis = "1" Layer = "1" Angle = "-Pi/3" />
        <Split Axis = "2" From  = "1"/>
        <Turn  Axis = "1" Layer = "1" Angle = " Pi/3" />

        <Hide  Axis = "0" Layer = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "0" From  = "1"/>
        <Turn  Axis = "1" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "0" From  = "1"/>
        <Turn  Axis = "1" Layer = "1" Angle = " Pi/3" />
        <Turn  Axis = "2" Layer = "1" Angle = "-Pi/3" />
        <Split Axis = "0" From  = "1"/>
        <Turn  Axis = "2" Layer = "1" Angle = " Pi/3" />
        <ShowAll/>

        <Hide  Axis = "1" Layer = "1" />
        <Turn  Axis = "3" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1"/>
        <Turn  Axis = "3" Layer = "1" Angle = "-Pi/3" />
        <ShowAll/>

        <Hide  Axis = "3" Layer = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "3" From  = "1"/>
        <Turn  Axis = "0" Layer = "1" Angle = "-Pi/3" />
        <ShowAll/>

        <Hide  Axis = "2" Layer = "1" />
        <Turn  Axis = "3" Layer = "1" Angle = "-Pi/3" />
        <Split Axis = "2" From  = "1"/>
        <Turn  Axis = "3" Layer = "1" Angle = " Pi/3" />
        <ShowAll/>

        <Hide  Axis = "3" Layer = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "-Pi/3" />
        <Split Axis = "3" From  = "1"/>
        <Turn  Axis = "0" Layer = "1" Angle = " Pi/3" />
        <ShowAll/>

        <Hide  Axis = "1" Layer = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "1" From  = "1"/>
        <Turn  Axis = "2" Layer = "1" Angle = "-Pi/3" />
        <ShowAll/>

        <Hide  Axis = "0" Layer = "1" />
        <Hide  Axis = "1" Layer = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "0" From  = "1"/>
        <Turn  Axis = "2" Layer = "1" Angle = "-Pi/3" />
        <ShowAll/>

        <Hide  Axis = "2" Layer = "1" />
        <Hide  Axis = "1" Layer = "1" />
        <Turn  Axis = "3" Layer = "1" Angle = " Pi/3" />
        <Split Axis = "2" From  = "1"/>
        <Turn  Axis = "3" Layer = "1" Angle = "-Pi/3" />
        <ShowAll/>
    </Figure>
</xml>
