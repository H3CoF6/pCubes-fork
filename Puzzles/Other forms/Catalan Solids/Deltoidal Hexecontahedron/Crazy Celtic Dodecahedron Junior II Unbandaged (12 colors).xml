    <Script>
        Colors[ 0] := 'FFFF00'; // Yellow
        Colors[ 1] := '0088FF'; // Blue2
        Colors[ 2] := '8800DD'; // Violett
        Colors[ 3] := 'FF0000'; // Red
        Colors[ 4] := '00AA00'; // Green2
        Colors[ 5] := '00BBFF'; // Blue1
        Colors[ 6] := '00FF00'; // Green1
        Colors[ 7] := '0000EE'; // Blue3
        Colors[ 8] := 'DD0055'; // Red2
        Colors[ 9] := '007700'; // Green3
        Colors[10] := 'FF55BB'; // Pink
        Colors[11] := 'FF6000'; // Orange

        K  := 0.65;
        s5 := sqrt(5);

        C0 := K * (s5 - 1) / 4;
        C1 := K * (3 * s5 + 1) / 22;
        C2 := K / 2;
        C3 := K * (s5 + 1) / 6;
        C4 := K * (s5 + 4) / 11;
        C5 := K * (s5 + 1) / 4;
        C6 := K * (s5 + 3) / 6;
        C7 := K * (5 * s5 + 9) / 22;
        C8 := K;

        pA1 := 3 - s5;
        pA2 := s5 + 1;
        pB1 := s5 - 1;
        pB2 := 2;
        pB3 := 2 * s5 - 2;
        pC  := 5 - s5;

        A2 := ArcCos((5 + 2 * s5) / 20);
        A3 := ArcCos(1/s5 - 1/2);
        A4 := ArcCos((5 - 9 * s5) / 40);
        A5 := ArcCos(-(5 + s5) / 8);

        D := K * 0.9275;
        D2 := K * 0.93671;

        DH := K * 0.94;
    </Script>

