        clFuchsia     := 'FF00FF';
        clPale        := 'D07090';
        clOrchid      := 'DA70D6';
        clPurple      := '800080';

        K  := 0.65;
        C0 := K * (sqrt(5) - 1) / 4;
        C1 := K * (3 * sqrt(5) + 1) / 22;
        C2 := K * 1 / 2;
        C3 := K * (sqrt(5) + 1) / 6;
        C4 := K * (sqrt(5) + 4) / 11;
        C5 := K * (sqrt(5) + 1) / 4;
        C6 := K * (sqrt(5) + 3) / 6;
        C7 := K * (5 * sqrt(5) + 9) / 22;
        C8 := K;

        pA1 := 3 - sqrt(5);
        pA2 := sqrt(5) + 1;
        pB1 := sqrt(5) - 1;
        pB2 := 2;
        pB3 := 2 * sqrt(5) - 2;
        pC  := 5 - sqrt(5);

        // Calcs angle from 2 to 3 while rotating over 1
        function Angle(x1, y1, z1, x2, y2, z2, x3, y3, z3);
        begin
          vx := y1 * z2 - y2 * z1;
          vy := z1 * x2 - z2 * x1;
          vz := x1 * y2 - x2 * y1;
          wx := y1 * z3 - y3 * z1;
          wy := z1 * x3 - z3 * x1;
          wz := x1 * y3 - x3 * y1;
          Result := ArcCos((vx*wx + vy*wy + vz*wz) / (vx^2 + vy^2 + vz^2));
        end;

        A1 := Angle(pB1,-pB3, pB2, -pA1,-pA2, pA1, -pB1,-pB3, pB2); // 0.67587634; 
        A2 := Angle(pB1,-pB3, pB2,  pB2,-pB1, pB3,  pB3,-pB2, pB1); // 1.07741483; 
        A3 := Angle(pB1,-pB3, pB2,  pB3,-pB2, pB1,  pA1,-pA2, pA1); // 1.62360728; 
        A4 := Angle(pB1,-pB3, pB2,  pA1,-pA2, pA1,    0,-pB2, pC ); // 1.95855593; 
        A5 := Angle(pB1,-pB3, pB2,  pB2,-pB1, pB3,  pA1,-pA2, pA1); // 2.70102211; 

        D := K * 0.87500146;
    </Script>

