<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Triacontahedron FT2</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Triacontahedron\Face Turning\FT2</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-16</Added>
        <Link>http://dmccooey.com/polyhedra/RhombicTriacontahedron.html</Link>
    </Interface>

    <Script>
        clWhite     := 'F0F0F0';
        clBlack     := '202020';
        clCyan      := '00FFFF';
        clTeal      := '008080';
        clBlue      := '0000FF';
        clRed       := 'FF0000';
        clBrown     := '800000';
        clCoral     := 'FF7F50';
        clYellow    := 'FFFF00';
        clOlive     := '808000';
        clOrange    := 'FF6000';
        clLime      := '00FF00';
        clGreen     := '008000';
        clDarkGreen := '006400';
        clFuchsia   := 'FF00FF';
        clPurple    := '800080';
        clPink      := 'FF69B4';
        clPale      := 'DB7093';

        K  := 0.4;
        C0 := K * sqrt(5) / 4;
        C1 := K * (5 + sqrt(5)) / 8;
        C2 := C0 + C1;

        pN1 := C1;
        pN2 := C2;
        pN3 := C1 + C2;

        D := C2 - C0 * C1 / C2;

        A1 := ArcSin(2 / 3);
        A2 := ArcTan(2);
        A3 := Pi/2;
        A4 := Pi - A2;
        A5 := Pi - A1;
    </Script>

    <Axes TurningAngles = "2*Pi; 0; 2*Pi" AvailableAngles = "-A5;-A4;-A3;-A2;-A1;0;A1;A2;A3;A4;A5;pi" PlaneDistances = "-D;D" >
        <Axis NormVector = "   1;   0;   0" />
        <Axis NormVector = "   0;   1;   0" />
        <Axis NormVector = "   0;   0;   1" />
        <Axis NormVector = "-pN1; pN2; pN3" />
        <Axis NormVector = "-pN3; pN1; pN2" />
        <Axis NormVector = "-pN2; pN3; pN1" />
        <Axis NormVector = " pN1;-pN2; pN3" />
        <Axis NormVector = " pN3;-pN1; pN2" />
        <Axis NormVector = " pN2;-pN3; pN1" />
        <Axis NormVector = " pN1; pN2;-pN3" />
        <Axis NormVector = " pN3; pN1;-pN2" />
        <Axis NormVector = " pN2; pN3;-pN1" />
        <Axis NormVector = "-pN1;-pN2;-pN3" />
        <Axis NormVector = "-pN3;-pN1;-pN2" />
        <Axis NormVector = "-pN2;-pN3;-pN1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;   0;  C2" />
                <Add Vector = " C1;   0; -C2" />
                <Add Vector = "-C1;   0;  C2" />
                <Add Vector = "-C1;   0; -C2" />
                <Add Vector = " C2;  C1;   0" />
                <Add Vector = " C2; -C1;   0" />
                <Add Vector = "-C2;  C1;   0" />
                <Add Vector = "-C2; -C1;   0" />
                <Add Vector = "  0;  C2;  C1" />
                <Add Vector = "  0;  C2; -C1" />
                <Add Vector = "  0; -C2;  C1" />
                <Add Vector = "  0; -C2; -C1" />
                <Add Vector = "  0;  C0;  C2" />
                <Add Vector = "  0;  C0; -C2" />
                <Add Vector = "  0; -C0;  C2" />
                <Add Vector = "  0; -C0; -C2" />
                <Add Vector = " C2;   0;  C0" />
                <Add Vector = " C2;   0; -C0" />
                <Add Vector = "-C2;   0;  C0" />
                <Add Vector = "-C2;   0; -C0" />
                <Add Vector = " C0;  C2;   0" />
                <Add Vector = " C0; -C2;   0" />
                <Add Vector = "-C0;  C2;   0" />
                <Add Vector = "-C0; -C2;   0" />
                <Add Vector = " C1;  C1;  C1" />
                <Add Vector = " C1;  C1; -C1" />
                <Add Vector = " C1; -C1;  C1" />
                <Add Vector = " C1; -C1; -C1" />
                <Add Vector = "-C1;  C1;  C1" />
                <Add Vector = "-C1;  C1; -C1" />
                <Add Vector = "-C1; -C1;  C1" />
                <Add Vector = "-C1; -C1; -C1" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"     VertexIndexes = "  0; 12;  2; 14" />
                <Face Color = "clBlack"     VertexIndexes = "  3; 13;  1; 15" />
                <Face Color = "clFuchsia"   VertexIndexes = "  4; 16;  5; 17" />
                <Face Color = "clPurple"    VertexIndexes = "  7; 18;  6; 19" />
                <Face Color = "clPink"      VertexIndexes = "  9; 22;  8; 20" />
                <Face Color = "clPale"      VertexIndexes = " 10; 23; 11; 21" />

                <Face Color = "clYellow"    VertexIndexes = "  0; 14; 10; 26" />
                <Face Color = "clOlive"     VertexIndexes = "  0; 26;  5; 16" />
                <Face Color = "clOrange"    VertexIndexes = " 10; 21;  5; 26" />
                <Face Color = "clYellow"    VertexIndexes = "  3; 29;  9; 13" />
                <Face Color = "clOlive"     VertexIndexes = "  3; 19;  6; 29" />
                <Face Color = "clOrange"    VertexIndexes = "  9; 29;  6; 22" />

                <Face Color = "clCyan"      VertexIndexes = "  2; 28;  6; 18" />
                <Face Color = "clTeal"      VertexIndexes = "  8; 22;  6; 28" />
                <Face Color = "clBlue"      VertexIndexes = "  8; 28;  2; 12" />
                <Face Color = "clCyan"      VertexIndexes = "  1; 17;  5; 27" />
                <Face Color = "clTeal"      VertexIndexes = " 11; 27;  5; 21" />
                <Face Color = "clBlue"      VertexIndexes = " 11; 15;  1; 27" />

                <Face Color = "clLime"      VertexIndexes = "  2; 18;  7; 30" />
                <Face Color = "clGreen"     VertexIndexes = "  2; 30; 10; 14" />
                <Face Color = "clDarkGreen" VertexIndexes = " 10; 30;  7; 23" />
                <Face Color = "clLime"      VertexIndexes = "  1; 25;  4; 17" />
                <Face Color = "clGreen"     VertexIndexes = "  1; 13;  9; 25" />
                <Face Color = "clDarkGreen" VertexIndexes = "  9; 20;  4; 25" />

                <Face Color = "clRed"       VertexIndexes = "  4; 20;  8; 24" />
                <Face Color = "clBrown"     VertexIndexes = "  4; 24;  0; 16" />
                <Face Color = "clCoral"     VertexIndexes = "  8; 12;  0; 24" />
                <Face Color = "clRed"       VertexIndexes = "  7; 31; 11; 23" />
                <Face Color = "clBrown"     VertexIndexes = "  7; 19;  3; 31" />
                <Face Color = "clCoral"     VertexIndexes = " 11; 31;  3; 15" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
