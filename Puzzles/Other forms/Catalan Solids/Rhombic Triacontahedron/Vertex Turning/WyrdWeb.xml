<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>WyrdWeb</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Triacontahedron\Vertex Turning\WyrdWeb</Menu>
        <Inventor>El_Cubitero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-02-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12422</Link>
    </Interface>

    <Script>
        K  := 0.4;
        C0 := K * sqrt(5) / 4;
        C1 := K * (5 + sqrt(5)) / 8;
        C2 := C0 + C1;

        D  := K * 5 * sqrt(3) / 12;

        jumAngle := ArcCos((3 * sqrt(5) - 1) / 8);
    </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" JumbleAngle = "jumAngle" PlaneDistances = "-D; D" >
        <Axis NormVector = "  0; C0; C2" />
        <Axis NormVector = "  0;-C0; C2" />
        <Axis NormVector = "-C1; C1; C1" />
        <Axis NormVector = " C1;-C1; C1" />
        <Axis NormVector = " C1; C1; C1" />
        <Axis NormVector = "-C1;-C1; C1" />
        <Axis NormVector = " C2;  0; C0" />
        <Axis NormVector = "-C2;  0; C0" />
        <Axis NormVector = " C0; C2;  0" />
        <Axis NormVector = "-C0; C2;  0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Triacontahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
