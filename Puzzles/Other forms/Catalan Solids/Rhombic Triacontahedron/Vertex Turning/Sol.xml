<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sol</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Triacontahedron\Vertex Turning\Sol</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-10-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5766</Link>
    </Interface>

    <Script>
        Scale := 0.4;
        C0 := sqrt(5) / 4 * Scale;
        C1 := (5 + sqrt(5)) / 8 * Scale;
        C2 := C0 + C1;

        D1 := (c0 + c1) * c2 / sqrt(c1^2 + c2^2);
        D2 := c1 * c2 / sqrt(c1^2 + c2^2);
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D1; -D2; D2; D1" FixedLayers = "2" >
        <Axis NormVector = " C1;   0;  C2 " />
        <Axis NormVector = " C1;   0; -C2 " />
        <Axis NormVector = " C2;  C1;   0 " />
        <Axis NormVector = " C2; -C1;   0 " />
        <Axis NormVector = "  0;  C2;  C1 " />
        <Axis NormVector = "  0;  C2; -C1 " />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Triacontahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
