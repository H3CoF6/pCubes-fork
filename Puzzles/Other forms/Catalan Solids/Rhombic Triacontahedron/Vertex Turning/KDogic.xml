<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>KDogic</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Triacontahedron\Vertex Turning\KDogic</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-10-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12158</Link>
    </Interface>

    <Script>
        K := 0.4;
        C0 := K * sqrt(5) / 4;
        C1 := K * (5 + sqrt(5)) / 8;
        C2 := C0 + C1;

        D1 := C2^2 / sqrt(C1^2 + C2^2);
//        D2 := C1 * C2 / sqrt(C1^2 + C2^2);
        D2 := K * 0.92;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D1;-D2; D2; D1" FixedLayers = "2" >
        <Axis NormVector = " C1;  0; C2" />
        <Axis NormVector = " C1;  0;-C2" />
        <Axis NormVector = " C2; C1;  0" />
        <Axis NormVector = " C2;-C1;  0" />
        <Axis NormVector = "  0; C2; C1" />
        <Axis NormVector = "  0; C2;-C1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Triacontahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
