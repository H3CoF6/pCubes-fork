    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := 'FFFF00'; // clYellow
        Colors[ 2] := '0000CC'; // clBlue
        Colors[ 3] := 'FF0000'; // clRed
        Colors[ 4] := '00AA00'; // clGreen
        Colors[ 5] := 'AA00AA'; // clViolett
        Colors[ 6] := 'FFFFAA'; // clCream
        Colors[ 7] := '0066CC'; // clLightBlue
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := '00FF00'; // clLightGreen
        Colors[10] := 'FF88CC'; // clLightViolett
        Colors[11] := '666666'; // clGray

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        k := 1.20;
        for i := 0 to 11 do begin
            CCx[i] := Cx[i] * k;
            CCy[i] := Cy[i] * k;
            CCz[i] := Cz[i] * k;
        end;

        D1 := R * 0.84;
        D2 := R * 0.8525;

        JumAngle := Arctan(2);
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "Ex[ 0]; Ey[ 0]; Ez[ 0]" />
        <Axis NormVector = "Ex[ 1]; Ey[ 1]; Ez[ 1]" />
        <Axis NormVector = "Ex[ 2]; Ey[ 2]; Ez[ 2]" />
        <Axis NormVector = "Ex[ 3]; Ey[ 3]; Ez[ 3]" />
        <Axis NormVector = "Ex[ 4]; Ey[ 4]; Ez[ 4]" />
        <Axis NormVector = "Ex[ 5]; Ey[ 5]; Ez[ 5]" />
        <Axis NormVector = "Ex[ 6]; Ey[ 6]; Ez[ 6]" />
        <Axis NormVector = "Ex[ 7]; Ey[ 7]; Ez[ 7]" />
        <Axis NormVector = "Ex[ 8]; Ey[ 8]; Ez[ 8]" />
        <Axis NormVector = "Ex[ 9]; Ey[ 9]; Ez[ 9]" />
        <Axis NormVector = "Ex[10]; Ey[10]; Ez[10]" />
        <Axis NormVector = "Ex[11]; Ey[11]; Ez[11]" />
        <Axis NormVector = "Ex[12]; Ey[12]; Ez[12]" />
        <Axis NormVector = "Ex[13]; Ey[13]; Ez[13]" />
        <Axis NormVector = "Ex[14]; Ey[14]; Ez[14]" />
    </Axes>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D2; D2">
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

