                <Add Vector = "  C0;  -C3;    0" />
                <Add Vector = " -C0;   C3;    0" />
                <Add Vector = " -C0;  -C3;    0" />
                <Add Vector = "  C1;    0;   C2" />
                <Add Vector = "  C1;    0;  -C2" />
                <Add Vector = " -C1;    0;   C2" />
                <Add Vector = " -C1;    0;  -C2" />
                <Add Vector = "  C2;   C1;    0" />
                <Add Vector = "  C2;  -C1;    0" />
                <Add Vector = " -C2;   C1;    0" />
                <Add Vector = " -C2;  -C1;    0" />
                <Add Vector = "   0;   C2;   C1" />
                <Add Vector = "   0;   C2;  -C1" />
                <Add Vector = "   0;  -C2;   C1" />
                <Add Vector = "   0;  -C2;  -C1" />
                <Add Vector = "  C4;   C4;   C4" />
                <Add Vector = "  C4;   C4;  -C4" />
                <Add Vector = "  C4;  -C4;   C4" />
                <Add Vector = "  C4;  -C4;  -C4" />
                <Add Vector = " -C4;   C4;   C4" />
                <Add Vector = " -C4;   C4;  -C4" />
                <Add Vector = " -C4;  -C4;   C4" />
                <Add Vector = " -C4;  -C4;  -C4" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite      " VertexIndexes = "12;  0;  2" />
                <Face Color = "clGainsboro  " VertexIndexes = "12;  2; 26" />
