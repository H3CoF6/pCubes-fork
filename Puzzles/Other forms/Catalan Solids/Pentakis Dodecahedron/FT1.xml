    <Script>
        clWhite       := 'F0F0F0';
        clGainsboro   := 'C0C0C0';
        clSilver      := 'A0A0A0';
        clGray        := '707070';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clDeepSky     := '00BFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clCoral       := 'FF7F50';
        clRed         := 'FF0000';
        clCrimson     := 'DC143C';
        clIndian      := 'CD5C5C';
        clBrown       := '800000';

        clYellow      := 'FFFF00';
        clOrange      := 'FF6000';
        clKhaki       := 'F0E68C';
        clGolden      := 'DDBB20';
        clOlive       := '808000';

        clGreenYellow := 'ADFF2F';
        clLime        := '00FF00';
        clSeaGreen    := '3cb371';
        clGreen       := '008000';
        clDarkGreen   := '006400';

        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clPale        := 'D07090';
        clOrchid      := 'DA70D6';
        clPurple      := '800080';

        K  := 0.75;

        C0 := K * (sqrt(5) - 1) / 4;          // 0.92705098312;
        C1 := K * 3 * (9 + sqrt(5)) / 76;     // 1.33058699733;
        C2 := K * 3 * (7 + 5 * sqrt(5)) / 76; // 2.15293498667;
        C3 := K * (1 + sqrt(5)) / 4;          // 2.42705098312;
        C4 := K * 0.5;                        // 1.5;

        pA1 := (sqrt(5) - 1) / 2; // 0.47964361;
        pA2 := 3;                 // 2.32823897;
        pB1 := sqrt(5) - 1;       // 0.95928721;
        pB2 := 1;                 // 0.77607966;
        pB3 := (sqrt(5) + 3) / 2; // 2.03180292;
        pC1 := sqrt(5);           // 1.73536687;
        pC2 := 2;                 // 1.55215931;

        D  := K * 0.745;

        A1 := ArcCos(( 7 - 9 * sqrt(5)) / 36); // Angle(pB2,-pB3, pB1,  pA1,-pC2, pC1,    0,-pA2, pA1); // 1,94397004483341
        A2 := ArcCos((-9 +     sqrt(5)) / 12); // Angle(pB2,-pB3, pB1,    0,-pA2, pA1,  pC2,-pC1, pA1); // 2,16960763117309
//        A3 := Angle(pB2,-pB3, pB1, -pA1,-pC2, pC1, -pB2,-pB3, pB1); // 0,66610896387669
//        A4 := Angle(pB2,-pB3, pB1,  pC2,-pC1,-pA1,  pB3,-pB1, pB2); // 1,04378502088515
//        A5 := Angle(pB2,-pB3, pB1,  pB3,-pB1, pB2,  pB1,-pB2, pB3); // 1,12582261028794
//        A6 := Angle(pB2,-pB3, pB1,  pB1,-pB2, pB3,    0,-pA2,-pA1); // 2,98775506571856

    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1;0;A1;A2" PlaneDistances = "-D;D" FixedLayers = "1">
        <Axis NormVector = " pA1;   0; pA2" />
        <Axis NormVector = "-pA1;   0; pA2" />
        <Axis NormVector = " pB1; pB2; pB3" />
        <Axis NormVector = "-pB1; pB2; pB3" />
        <Axis NormVector = " pB1;-pB2; pB3" />
        <Axis NormVector = "-pB1;-pB2; pB3" />
        <Axis NormVector = " pC1; pA1; pC2" />
        <Axis NormVector = "-pC1; pA1; pC2" />
        <Axis NormVector = " pC1;-pA1; pC2" />
        <Axis NormVector = "-pC1;-pA1; pC2" />
        <Axis NormVector = " pA1; pC2; pC1" />
        <Axis NormVector = "-pA1; pC2; pC1" />
        <Axis NormVector = " pA1;-pC2; pC1" />
        <Axis NormVector = "-pA1;-pC2; pC1" />
        <Axis NormVector = " pB2; pB3; pB1" />
        <Axis NormVector = "-pB2; pB3; pB1" />
        <Axis NormVector = " pB2;-pB3; pB1" />
        <Axis NormVector = "-pB2;-pB3; pB1" />
        <Axis NormVector = "   0;-pA2; pA1" />
        <Axis NormVector = "   0;-pA2;-pA1" />
        <Axis NormVector = " pC2; pC1; pA1" />
        <Axis NormVector = " pC2; pC1;-pA1" />
        <Axis NormVector = " pC2;-pC1; pA1" />
        <Axis NormVector = " pC2;-pC1;-pA1" />
        <Axis NormVector = " pB3; pB1; pB2" />
        <Axis NormVector = " pB3; pB1;-pB2" />
        <Axis NormVector = " pB3;-pB1; pB2" />
        <Axis NormVector = " pB3;-pB1;-pB2" />
        <Axis NormVector = " pA2; pA1;   0" />
        <Axis NormVector = " pA2;-pA1;   0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;   C0;   C3" />
                <Add Vector = "   0;   C0;  -C3" />
                <Add Vector = "   0;  -C0;   C3" />
                <Add Vector = "   0;  -C0;  -C3" />
