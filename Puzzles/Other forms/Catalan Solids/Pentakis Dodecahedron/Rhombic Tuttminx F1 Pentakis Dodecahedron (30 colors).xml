        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 1" a2 = " 7" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 2" a2 = " 8" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "14" a2 = " 9" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "13" a2 = " 8" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "10" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = "11" a2 = " 6" />

        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "0" a1 = "12" a2 = "10" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "2" a1 = "12" a2 = "10" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "0" a1 = "13" a2 = "11" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "2" a1 = "13" a2 = "11" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "0" a1 = " 9" a2 = "11" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "2" a1 = " 9" a2 = "11" />
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
