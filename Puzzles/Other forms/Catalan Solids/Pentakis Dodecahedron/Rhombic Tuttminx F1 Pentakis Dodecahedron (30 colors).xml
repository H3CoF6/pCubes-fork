<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Tuttminx F1 Pentakis Dodecahedron (30 colors)</Name>
        <Menu>Other forms\Catalan Solids\Pentakis Dodecahedron\Rhombic Tuttminx F1 (30 colors)</Menu>
        <Inventor>Leslie Le</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7646</Link>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clGainsboro   := 'C0C0C0';
        clSilver      := 'A0A0A0';
        clGray        := '707070';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clDeepSky     := '00BFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clCoral       := 'FF7F50';
        clRed         := 'FF0000';
        clCrimson     := 'DC143C';
        clIndian      := 'CD5C5C';
        clBrown       := '800000';

        clYellow      := 'FFFF00';
        clOrange      := 'FF6000';
        clKhaki       := 'F0E68C';
        clGolden      := 'DDBB20';
        clOlive       := '808000';

        clGreenYellow := 'ADFF2F';
        clLime        := '00FF00';
        clSeaGreen    := '3cb371';
        clGreen       := '008000';
        clDarkGreen   := '006400';

        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clPale        := 'D07090';
        clOrchid      := 'DA70D6';
        clPurple      := '800080';

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        k := 1.20;
        for i := 0 to 11 do begin
            CCx[i] := Cx[i] * k;
            CCy[i] := Cy[i] * k;
            CCz[i] := Cz[i] * k;
        end;

        D1 := R * 0.84;
        D2 := R * 0.8525;

        JumAngle := Arctan(2);
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "Ex[ 0]; Ey[ 0]; Ez[ 0]" />
        <Axis NormVector = "Ex[ 1]; Ey[ 1]; Ez[ 1]" />
        <Axis NormVector = "Ex[ 2]; Ey[ 2]; Ez[ 2]" />
        <Axis NormVector = "Ex[ 3]; Ey[ 3]; Ez[ 3]" />
        <Axis NormVector = "Ex[ 4]; Ey[ 4]; Ez[ 4]" />
        <Axis NormVector = "Ex[ 5]; Ey[ 5]; Ez[ 5]" />
        <Axis NormVector = "Ex[ 6]; Ey[ 6]; Ez[ 6]" />
        <Axis NormVector = "Ex[ 7]; Ey[ 7]; Ez[ 7]" />
        <Axis NormVector = "Ex[ 8]; Ey[ 8]; Ez[ 8]" />
        <Axis NormVector = "Ex[ 9]; Ey[ 9]; Ez[ 9]" />
        <Axis NormVector = "Ex[10]; Ey[10]; Ez[10]" />
        <Axis NormVector = "Ex[11]; Ey[11]; Ez[11]" />
        <Axis NormVector = "Ex[12]; Ey[12]; Ez[12]" />
        <Axis NormVector = "Ex[13]; Ey[13]; Ez[13]" />
        <Axis NormVector = "Ex[14]; Ey[14]; Ez[14]" />
    </Axes>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D2; D2">
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx ; Vy ; Vz " />
            <Vertices Vectors = "CCx; CCy; CCz" />

            <Faces>
                <Face Color = "clWhite      " VertexIndexes = " 4; 3;20" />
                <Face Color = "clGainsboro  " VertexIndexes = " 3; 2;20" />
                <Face Color = "clSilver     " VertexIndexes = " 2; 1;20" />
                <Face Color = "clGray       " VertexIndexes = " 1; 0;20" />
                <Face Color = "clBlack      " VertexIndexes = " 0; 4;20" />

                <Face Color = "clCyan       " VertexIndexes = " 0; 1;21" />
                <Face Color = "clDeepSky    " VertexIndexes = " 1; 6;21" />
                <Face Color = "clTeal       " VertexIndexes = " 6;10;21" />
                <Face Color = "clBlue       " VertexIndexes = "10; 5;21" />
                <Face Color = "clNavy       " VertexIndexes = " 5; 0;21" />

                <Face Color = "clCoral      " VertexIndexes = " 1; 2;22" />
                <Face Color = "clRed        " VertexIndexes = " 2; 7;22" />
                <Face Color = "clCrimson    " VertexIndexes = " 7;11;22" />
                <Face Color = "clIndian     " VertexIndexes = "11; 6;22" />
                <Face Color = "clBrown      " VertexIndexes = " 6; 1;22" />

                <Face Color = "clYellow     " VertexIndexes = " 2; 3;23" />
                <Face Color = "clOrange     " VertexIndexes = " 3; 8;23" />
                <Face Color = "clKhaki      " VertexIndexes = " 8;12;23" />
                <Face Color = "clGolden     " VertexIndexes = "12; 7;23" />
                <Face Color = "clOlive      " VertexIndexes = " 7; 2;23" />

                <Face Color = "clGreenYellow" VertexIndexes = " 3; 4;24" />
                <Face Color = "clLime       " VertexIndexes = " 4; 9;24" />
                <Face Color = "clSeaGreen   " VertexIndexes = " 9;13;24" />
                <Face Color = "clGreen      " VertexIndexes = "13; 8;24" />
                <Face Color = "clDarkGreen  " VertexIndexes = " 8; 3;24" />

                <Face Color = "clPink       " VertexIndexes = " 4; 0;25" />
                <Face Color = "clFuchsia    " VertexIndexes = " 0; 5;25" />
                <Face Color = "clPale       " VertexIndexes = " 5;14;25" />
                <Face Color = "clOrchid     " VertexIndexes = "14; 9;25" />
                <Face Color = "clPurple     " VertexIndexes = " 9; 4;25" />

                <Face Color = "clCyan       " VertexIndexes = "18;17;26" />
                <Face Color = "clNavy       " VertexIndexes = "17;12;26" />
                <Face Color = "clBlue       " VertexIndexes = "12; 8;26" />
                <Face Color = "clTeal       " VertexIndexes = " 8;13;26" />
                <Face Color = "clDeepSky    " VertexIndexes = "13;18;26" />

                <Face Color = "clCoral      " VertexIndexes = "19;18;27" />
                <Face Color = "clBrown      " VertexIndexes = "18;13;27" />
                <Face Color = "clIndian     " VertexIndexes = "13; 9;27" />
                <Face Color = "clCrimson    " VertexIndexes = " 9;14;27" />
                <Face Color = "clRed        " VertexIndexes = "14;19;27" />

                <Face Color = "clYellow     " VertexIndexes = "15;19;28" />
                <Face Color = "clOlive      " VertexIndexes = "19;14;28" />
                <Face Color = "clGolden     " VertexIndexes = "14; 5;28" />
                <Face Color = "clKhaki      " VertexIndexes = " 5;10;28" />
                <Face Color = "clOrange     " VertexIndexes = "10;15;28" />

                <Face Color = "clGreenYellow" VertexIndexes = "16;15;29" />
                <Face Color = "clDarkGreen  " VertexIndexes = "15;10;29" />
                <Face Color = "clGreen      " VertexIndexes = "10; 6;29" />
                <Face Color = "clSeaGreen   " VertexIndexes = " 6;11;29" />
                <Face Color = "clLime       " VertexIndexes = "11;16;29" />

                <Face Color = "clPink       " VertexIndexes = "17;16;30" />
                <Face Color = "clPurple     " VertexIndexes = "16;11;30" />
                <Face Color = "clOrchid     " VertexIndexes = "11; 7;30" />
                <Face Color = "clPale       " VertexIndexes = " 7;12;30" />
                <Face Color = "clFuchsia    " VertexIndexes = "12;17;30" />

                <Face Color = "clWhite      " VertexIndexes = "15;16;31" />
                <Face Color = "clBlack      " VertexIndexes = "16;17;31" />
                <Face Color = "clGray       " VertexIndexes = "17;18;31" />
                <Face Color = "clSilver     " VertexIndexes = "18;19;31" />
                <Face Color = "clGainsboro  " VertexIndexes = "19;15;31" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "unbandage">
            <Turn Axis = "a1" Layer = "l1" Angle = "JumAngle" />
            <Turn Axis = "a2" Layer = "l2" Angle = "Pi" />
            <Turn Axis = "a1" Layer = "l1" Angle = "-JumAngle" />
            <SplitByAxes/>
            <Undo Repeat = "3" />

            <Turn Axis = "a2" Layer = "l1" Angle = "-JumAngle" />
            <Turn Axis = "a1" Layer = "l2" Angle = "Pi" />
            <Turn Axis = "a2" Layer = "l1" Angle = "JumAngle" />
            <SplitByAxes/>
            <Undo Repeat = "3" />
        </Macro>
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 0" a2 =  "4" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 0" a2 =  "1" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 2" a2 = " 1" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 3" a2 = " 2" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 4" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 5" a2 = " 6" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 0" a2 = " 6" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 1" a2 = " 7" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = " 2" a2 = " 8" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "14" a2 = " 9" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "14" a2 = "10" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "13" a2 = " 8" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "10" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "0" l2 = "0" a1 = "11" a2 = " 6" />

        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 0" a2 = " 4" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 0" a2 = " 1" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 2" a2 = " 1" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 3" a2 = " 2" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 4" a2 = " 5" />
        <ExecMacro MacroName = "unbandage" l1 = "2" l2 = "2" a1 = " 5" a2 = " 6" />
