<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fracture Pentakis</Name>
        <Menu>Other forms\Catalan Solids\Pentakis Dodecahedron\Fracture Pentakis</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-11-18</Added>
        <Link>http://dmccooey.com/polyhedra/PentakisDodecahedron.html</Link>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clGainsboro   := 'C0C0C0';
        clSilver      := 'A0A0A0';
        clGray        := '707070';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clDeepSky     := '00BFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clCoral       := 'FF7F50';
        clRed         := 'FF0000';
        clCrimson     := 'DC143C';
        clIndian      := 'CD5C5C';
        clBrown       := '800000';

        clYellow      := 'FFFF00';
        clOrange      := 'FF6000';
        clKhaki       := 'F0E68C';
        clGolden      := 'DDBB20';
        clOlive       := '808000';

        clGreenYellow := 'ADFF2F';
        clLime        := '00FF00';
        clSeaGreen    := '3cb371';
        clGreen       := '008000';
        clDarkGreen   := '006400';

        clPink        := 'FF69B4';
        clFuchsia     := 'FF00FF';
        clPale        := 'D07090';
        clOrchid      := 'DA70D6';
        clPurple      := '800080';

        K  := 0.75;

        C0 := K * (sqrt(5) - 1) / 4;
        C1 := K * 3 * (9 + sqrt(5)) / 76;
        C2 := K * 3 * (7 + 5 * sqrt(5)) / 76;
        C3 := K * (1 + sqrt(5)) / 4;
        C4 := K * 1 / 2;

        D := K * sqrt(3) / 38 * (8 + 3 * sqrt(5)); // sqrt((C1+2*C2)^2+C2^2)/3
        E := K * sqrt(5 * (5 + 2 * sqrt(5))) / 10; // sqrt((C0+2*C3+2*C4)^2+(C3+2*C4)^2)/5
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "-E; E" FixedLayers = "1">
        <Axis NormVector = "  C1;    0;   C2" />
        <Axis NormVector = "  C1;    0;  -C2" />
        <Axis NormVector = "  C2;   C1;    0" />
        <Axis NormVector = "  C2;  -C1;    0" />
        <Axis NormVector = "   0;   C2;   C1" />
        <Axis NormVector = "   0;   C2;  -C1" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "-D; D" FixedLayers = "1">
        <Axis NormVector = "  0;  C0;  C3" />
        <Axis NormVector = "  0;  C0; -C3" />
        <Axis NormVector = " C3;   0;  C0" />
        <Axis NormVector = " C3;   0; -C0" />
        <Axis NormVector = " C0;  C3;   0" />
        <Axis NormVector = " C0; -C3;   0" />
        <Axis NormVector = " C4;  C4;  C4" />
        <Axis NormVector = " C4;  C4; -C4" />
        <Axis NormVector = " C4; -C4;  C4" />
        <Axis NormVector = " C4; -C4; -C4" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0; C0; C3" />
                <Add Vector = "  0; C0;-C3" />
                <Add Vector = "  0;-C0; C3" />
                <Add Vector = "  0;-C0;-C3" />
                <Add Vector = " C3;  0; C0" />
                <Add Vector = " C3;  0;-C0" />
                <Add Vector = "-C3;  0; C0" />
                <Add Vector = "-C3;  0;-C0" />
                <Add Vector = " C0; C3;  0" />
                <Add Vector = " C0;-C3;  0" />
                <Add Vector = "-C0; C3;  0" />
                <Add Vector = "-C0;-C3;  0" />
                <Add Vector = " C1;  0; C2" />
                <Add Vector = " C1;  0;-C2" />
                <Add Vector = "-C1;  0; C2" />
                <Add Vector = "-C1;  0;-C2" />
                <Add Vector = " C2; C1;  0" />
                <Add Vector = " C2;-C1;  0" />
                <Add Vector = "-C2; C1;  0" />
                <Add Vector = "-C2;-C1;  0" />
                <Add Vector = "  0; C2; C1" />
                <Add Vector = "  0; C2;-C1" />
                <Add Vector = "  0;-C2; C1" />
                <Add Vector = "  0;-C2;-C1" />
                <Add Vector = " C4; C4; C4" />
                <Add Vector = " C4; C4;-C4" />
                <Add Vector = " C4;-C4; C4" />
                <Add Vector = " C4;-C4;-C4" />
                <Add Vector = "-C4; C4; C4" />
                <Add Vector = "-C4; C4;-C4" />
                <Add Vector = "-C4;-C4; C4" />
                <Add Vector = "-C4;-C4;-C4" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite      " VertexIndexes = "12;  0;  2" />
                <Face Color = "clGainsboro  " VertexIndexes = "12;  2; 26" />
                <Face Color = "clSilver     " VertexIndexes = "12; 26;  4" />
                <Face Color = "clGray       " VertexIndexes = "12;  4; 24" />
                <Face Color = "clBlack      " VertexIndexes = "12; 24;  0" />
                <Face Color = "clWhite      " VertexIndexes = "15;  1;  3" />
                <Face Color = "clBlack      " VertexIndexes = "15;  3; 31" />
                <Face Color = "clGray       " VertexIndexes = "15; 31;  7" />
                <Face Color = "clSilver     " VertexIndexes = "15;  7; 29" />
                <Face Color = "clGainsboro  " VertexIndexes = "15; 29;  1" />

                <Face Color = "clYellow     " VertexIndexes = "13;  3;  1" />
                <Face Color = "clOrange     " VertexIndexes = "13;  1; 25" />
                <Face Color = "clKhaki      " VertexIndexes = "13; 25;  5" />
                <Face Color = "clGolden     " VertexIndexes = "13;  5; 27" />
                <Face Color = "clOlive      " VertexIndexes = "13; 27;  3" />
                <Face Color = "clYellow     " VertexIndexes = "14;  2;  0" />
                <Face Color = "clOlive      " VertexIndexes = "14;  0; 28" />
                <Face Color = "clGolden     " VertexIndexes = "14; 28;  6" />
                <Face Color = "clKhaki      " VertexIndexes = "14;  6; 30" />
                <Face Color = "clOrange     " VertexIndexes = "14; 30;  2" />

                <Face Color = "clCyan       " VertexIndexes = "16;  4;  5" />
                <Face Color = "clDeepSky    " VertexIndexes = "16;  5; 25" />
                <Face Color = "clTeal       " VertexIndexes = "16; 25;  8" />
                <Face Color = "clBlue       " VertexIndexes = "16;  8; 24" />
                <Face Color = "clNavy       " VertexIndexes = "16; 24;  4" />
                <Face Color = "clCyan       " VertexIndexes = "19;  6;  7" />
                <Face Color = "clNavy       " VertexIndexes = "19;  7; 31" />
                <Face Color = "clBlue       " VertexIndexes = "19; 31; 11" />
                <Face Color = "clTeal       " VertexIndexes = "19; 11; 30" />
                <Face Color = "clDeepSky    " VertexIndexes = "19; 30;  6" />

                <Face Color = "clGreenYellow" VertexIndexes = "17;  5;  4" />
                <Face Color = "clLime       " VertexIndexes = "17;  4; 26" />
                <Face Color = "clSeaGreen   " VertexIndexes = "17; 26;  9" />
                <Face Color = "clGreen      " VertexIndexes = "17;  9; 27" />
                <Face Color = "clDarkGreen  " VertexIndexes = "17; 27;  5" />
                <Face Color = "clGreenYellow" VertexIndexes = "18;  7;  6" />
                <Face Color = "clDarkGreen  " VertexIndexes = "18;  6; 28" />
                <Face Color = "clGreen      " VertexIndexes = "18; 28; 10" />
                <Face Color = "clSeaGreen   " VertexIndexes = "18; 10; 29" />
                <Face Color = "clLime       " VertexIndexes = "18; 29;  7" />

                <Face Color = "clCoral      " VertexIndexes = "20;  8; 10" />
                <Face Color = "clRed        " VertexIndexes = "20; 10; 28" />
                <Face Color = "clCrimson    " VertexIndexes = "20; 28;  0" />
                <Face Color = "clIndian     " VertexIndexes = "20;  0; 24" />
                <Face Color = "clBrown      " VertexIndexes = "20; 24;  8" />
                <Face Color = "clCoral      " VertexIndexes = "23;  9; 11" />
                <Face Color = "clBrown      " VertexIndexes = "23; 11; 31" />
                <Face Color = "clIndian     " VertexIndexes = "23; 31;  3" />
                <Face Color = "clCrimson    " VertexIndexes = "23;  3; 27" />
                <Face Color = "clRed        " VertexIndexes = "23; 27;  9" />

                <Face Color = "clPink       " VertexIndexes = "21; 10;  8" />
                <Face Color = "clFuchsia    " VertexIndexes = "21;  8; 25" />
                <Face Color = "clPale       " VertexIndexes = "21; 25;  1" />
                <Face Color = "clOrchid     " VertexIndexes = "21;  1; 29" />
                <Face Color = "clPurple     " VertexIndexes = "21; 29; 10" />
                <Face Color = "clPink       " VertexIndexes = "22; 11;  9" />
                <Face Color = "clPurple     " VertexIndexes = "22;  9; 26" />
                <Face Color = "clOrchid     " VertexIndexes = "22; 26;  2" />
                <Face Color = "clPale       " VertexIndexes = "22;  2; 30" />
                <Face Color = "clFuchsia    " VertexIndexes = "22; 30; 11" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Turn">
            <Turn Axis = "a" Layer = "0" Angle = " Pi/3" />
            <Turn Axis = "a" Layer = "2" Angle = " Pi/3" />
            <Turn Axis = "b" Layer = "0" Angle = " Pi/3" />
            <Turn Axis = "b" Layer = "2" Angle = " Pi/3" />
            <Turn Axis = "c" Layer = "0" Angle = " Pi/3" />
            <Turn Axis = "c" Layer = "2" Angle = " Pi/3" />
        </Macro>

        <Macro Name = "Split">
            <Split Axis = "i" From = "1" />
            <Split Axis = "i" From = "2" />
            <Script>Inc(i);</Script>
        </Macro>

        <ExecMacro MacroName = "Turn" a = "6" b = "8" c = "10"/>
        <ExecMacro MacroName = "Split" i = "0" Repeat = "6" />
        <Undo Repeat = "6"/>
        <ExecMacro MacroName = "Turn" a = "13" b = "14" c = "15"/>
        <ExecMacro MacroName = "Split" i = "0" Repeat = "6" />
        <Undo Repeat = "6"/>
        <ExecMacro MacroName = "Turn" a = "7" b = "9" c = "11"/>
        <ExecMacro MacroName = "Split" i = "0" Repeat = "6" />
        <Undo Repeat = "6"/>
        <ExecMacro MacroName = "Turn" a = "7" b = "9" c = "12"/>
        <ExecMacro MacroName = "Split" i = "0" Repeat = "6" />
        <Undo Repeat = "6"/>
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
