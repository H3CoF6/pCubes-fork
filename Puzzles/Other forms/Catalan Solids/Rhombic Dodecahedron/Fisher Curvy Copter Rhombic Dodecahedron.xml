<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fisher Curvy Copter Rhombic Dodecahedron</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Fisher Curvy Copter Rhombic Dodecahedron</Menu>
        <Inventor>Adrián Cures</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9079</Link>
    </Interface>

    <Script>
        R := 0.7;
        D := R * 0.57;
        RCut := R * 0.43;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = " 1; 0; 0" Angle = "Pi / 4" />
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>

        <RemoveContaining Vector = "0;0;0" />
        <Hide><Plane NormVector = " 1; 0; 0" NormDistance = "-RCut" /></Hide>
        <Hide><Plane NormVector = "-1; 0; 0" NormDistance = "-RCut" /></Hide>
        <InvertVisibility/>
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <HideContaining Vector = "0;0;0" />
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>