<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Radiombic</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Radiombic</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-04-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7384</Link>
    </Interface>

    <Script>
        R := 0.7;

        phi := (Sqrt(5) - 1) / 2; // The golden ratio
        a := R / sqrt(3);
        b := a / phi;
        c := a * phi;
        D := R * sqrt(15) / 6;

        dc := 0.2 * R;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  c;  b" />
        <Axis NormVector = " 0; -c;  b" />
        <Axis NormVector = " c;  b;  0" />
        <Axis NormVector = " c; -b;  0" />
        <Axis NormVector = " b;  0;  c" />
        <Axis NormVector = " b;  0; -c" />
        <Axis NormVector = " a;  a;  a" />
        <Axis NormVector = " a;  a; -a" />
        <Axis NormVector = " a; -a;  a" />
        <Axis NormVector = " a; -a; -a" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <RemoveContaining Vector = "   DC; -R+DC;    DC" />
        <RemoveContaining Vector = "  -DC; -R+DC;    DC" />
        <RemoveContaining Vector = "  -DC; -R+DC;   -DC" />
        <RemoveContaining Vector = "   DC; -R+DC;   -DC" />

        <RemoveContaining Vector = "   DC;  R-DC;    DC" />
        <RemoveContaining Vector = "  -DC;  R-DC;    DC" />
        <RemoveContaining Vector = "  -DC;  R-DC;   -DC" />
        <RemoveContaining Vector = "   DC;  R-DC;   -DC" />

        <RemoveContaining Vector = "-R+DC;    DC;    DC" />
        <RemoveContaining Vector = "-R+DC;   -DC;    DC" />
        <RemoveContaining Vector = "-R+DC;   -DC;   -DC" />
        <RemoveContaining Vector = "-R+DC;    DC;   -DC" />

        <RemoveContaining Vector = " R-DC;    DC;    DC" />
        <RemoveContaining Vector = " R-DC;   -DC;    DC" />
        <RemoveContaining Vector = " R-DC;   -DC;   -DC" />
        <RemoveContaining Vector = " R-DC;    DC;   -DC" />

        <RemoveContaining Vector = "   DC;    DC; -R+DC" />
        <RemoveContaining Vector = "  -DC;    DC; -R+DC" />
        <RemoveContaining Vector = "  -DC;   -DC; -R+DC" />
        <RemoveContaining Vector = "   DC;   -DC; -R+DC" />

        <RemoveContaining Vector = "   DC;    DC;  R-DC" />
        <RemoveContaining Vector = "  -DC;    DC;  R-DC" />
        <RemoveContaining Vector = "  -DC;   -DC;  R-DC" />
        <RemoveContaining Vector = "   DC;   -DC;  R-DC" />
    </Figure>
</xml>
