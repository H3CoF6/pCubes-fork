<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Dodecahedron + 2x2</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Rhombic Dodecahedron + 2x2</Menu>
        <Inventor>MF8</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2020-02-03</Added>
        <Link>http://bbs.mf8-china.com/forum.php?mod=viewthread&amp;tid=115740</Link>
    </Interface>

    <Script>
        R := 0.7;
        D1 := R * sqrt(2) / 6;
        D2 := R * sqrt(2) / 3;

        A := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "A" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
    </Axes>
    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "0" Angle = "A" />
        <Turn  Axis = "5" Layer = "0" Angle = "Pi-A" />
        <Turn  Axis = "2" Layer = "0" Angle = "Pi-A" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "2" From = "2" />
        <Undo  Repeat = "3" />
        <Turn  Axis = "0" Layer = "0" Angle = "-A" />
        <Turn  Axis = "3" Layer = "0" Angle = "Pi+A" />
        <Turn  Axis = "4" Layer = "0" Angle = "Pi+A" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "2" />
        <Undo  Repeat = "3" />

        <Turn  Axis = "0" Layer = "2" Angle = "A" />
        <Turn  Axis = "5" Layer = "2" Angle = "Pi-A" />
        <Turn  Axis = "2" Layer = "2" Angle = "Pi-A" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "2" From = "1" />
        <Undo  Repeat = "3" />
        <Turn  Axis = "0" Layer = "2" Angle = "-A" />
        <Turn  Axis = "3" Layer = "2" Angle = "Pi+A" />
        <Turn  Axis = "4" Layer = "2" Angle = "Pi+A" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />
        <Undo  Repeat = "3" />

        <Turn  Axis = "1" Layer = "2" Angle = "A" />
        <Turn  Axis = "3" Layer = "2" Angle = "Pi-A" />
        <Turn  Axis = "5" Layer = "0" Angle = "Pi+A" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "5" From = "2" />
        <Undo  Repeat = "3" />
        <Turn  Axis = "1" Layer = "2" Angle = "-A" />
        <Turn  Axis = "2" Layer = "2" Angle = "Pi+A" />
        <Turn  Axis = "4" Layer = "0" Angle = "Pi-A" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "4" From = "2" />
        <Undo  Repeat = "3" />

        <Turn  Axis = "1" Layer = "0" Angle = "A" />
        <Turn  Axis = "3" Layer = "0" Angle = "Pi-A" />
        <Turn  Axis = "5" Layer = "2" Angle = "Pi+A" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "5" From = "1" />
        <Undo  Repeat = "3" />
        <Turn  Axis = "1" Layer = "0" Angle = "-A" />
        <Turn  Axis = "2" Layer = "0" Angle = "Pi+A" />
        <Turn  Axis = "4" Layer = "2" Angle = "Pi-A" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "4" From = "1" />
        <Undo  Repeat = "3" />

        <Turn  Axis = "2" Layer = "2" Angle = "A" />
        <Turn  Axis = "1" Layer = "2" Angle = "Pi-A" />
        <Split Axis = "4" From = "1" />
        <Undo  Repeat = "2"/>
        <Turn  Axis = "2" Layer = "2" Angle = "-A" />
        <Turn  Axis = "0" Layer = "2" Angle = "Pi+A" />
        <Split Axis = "5" From = "2" />
        <Undo  Repeat = "2"/>

        <Turn  Axis = "2" Layer = "0" Angle = "A" />
        <Turn  Axis = "1" Layer = "0" Angle = "Pi-A" />
        <Split Axis = "4" From = "2" />
        <Undo  Repeat = "2"/>
        <Turn  Axis = "2" Layer = "0" Angle = "-A" />
        <Turn  Axis = "0" Layer = "0" Angle = "Pi+A" />
        <Split Axis = "5" From = "1" />
        <Undo  Repeat = "2"/>

        <Turn  Axis = "3" Layer = "0" Angle = "A" />
        <Turn  Axis = "0" Layer = "0" Angle = "Pi-A" />
        <Split Axis = "4" From = "1" />
        <Undo  Repeat = "2"/>
        <Turn  Axis = "3" Layer = "0" Angle = "-A" />
        <Turn  Axis = "1" Layer = "0" Angle = "Pi+A" />
        <Split Axis = "5" From  = "2" />
        <Undo  Repeat = "2"/>

        <Turn  Axis = "3" Layer = "2" Angle = "A" />
        <Turn  Axis = "0" Layer = "2" Angle = "Pi-A" />
        <Split Axis = "4" From = "2" />
        <Undo  Repeat = "2"/>
        <Turn  Axis = "3" Layer = "2" Angle = "-A" />
        <Turn  Axis = "1" Layer = "2" Angle = "Pi+A" />
        <Split Axis = "5" From = "1" />
        <Undo  Repeat = "2"/>
    </Figure>
</xml>
