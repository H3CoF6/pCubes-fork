<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rua Crazy</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Crazy\Rua Crazy\Rua Crazy</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6991</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Rhombic_Dodecahedron_Coordinates.inc';

        D1 := R * sqrt(2) / 2;
        D2 := R * sqrt(2) / 4;

        RC := R * 0.3;
        A := Arccos(1/3);

        Delta := 1.001;
    </Script>

    <Axes TurningAngles = "0;Pi;Pi" JumbleAngle = "A" PlaneDistances = "D1; D2" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "RC" Color = "Colors[ax]" Center = "Cx[ax] * Delta; Cy[ax] * Delta; Cz[ax] * Delta" />
            <Script>Inc(ax);</Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" ax = " 0" Repeat = "12" />
        <SplitByAxes/>

        <Macro Name = "SplitCircle" >
            <HideContaining Vector = " R/2*Delta;-R/2*Delta; 0" />
            <HideContaining Vector = " R/2*Delta-RC/2;-R/2*Delta-RC/2; -RC/2" />
            <HideContaining Vector = " R/2*Delta-RC/2;-R/2*Delta-RC/2;  RC/2" />
            <HideContaining Vector = " R/2*Delta+RC/2;-R/2*Delta+RC/2; -RC/2" />
            <HideContaining Vector = " R/2*Delta+RC/2;-R/2*Delta+RC/2;  RC/2" />
            <Turn NormVector = " 0; 0; 1" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "SplitBelt" >
            <ExecMacro MacroName = "SplitCircle" Repeat = "4" />
            <Turn NormVector = " 1; 1; 1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "SplitBelt" Repeat = "3" />

        <Connect Axis = " 0" Layers = "0;2" />
        <Connect Axis = " 1" Layers = "0;2" />
        <Connect Axis = " 2" Layers = "0;2" />
        <Connect Axis = " 3" Layers = "0;2" />
        <Connect Axis = " 4" Layers = "0;2" />
        <Connect Axis = " 5" Layers = "0;2" />
        <Connect Axis = " 6" Layers = "0;2" />
        <Connect Axis = " 7" Layers = "0;2" />
        <Connect Axis = " 8" Layers = "0;2" />
        <Connect Axis = " 9" Layers = "0;2" />
        <Connect Axis = "10" Layers = "0;2" />
        <Connect Axis = "11" Layers = "0;2" />
    </Figure>
</xml>
