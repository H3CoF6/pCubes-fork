<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy FTRD - All Circles</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Crazy\Crazy FTRD\All Circles</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-06-04</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=31856</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Rhombic_Dodecahedron_Coordinates.inc';

        D1 := R * sqrt(2) / 2;
        D2 := R * sqrt(2) / 3.3;

        RC := R * 0.34;
        A := Arccos(1/3);

        Delta := 1.001;
    </Script>

    <Axes TurningAngles = "0;Pi;0" JumbleAngle = "A" PlaneDistances = "D1; D2" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "RC" Color = "Colors[ax]" Center = "Cx[ax] * Delta; Cy[ax] * Delta; Cz[ax] * Delta" />
            <Script>Inc(ax);</Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" ax = " 0" Repeat = "12" />

        <SplitByAxes/>
    </Figure>

    <Textures>
        <Texture Name = "Circle" File = "..\Textures\Circle.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        Circle = 75,0,0, 84,0,1, 93,0,1, 102,0,0, 111,0,1, 120,0,1, 129,0,0, 138,0,0, 147,0,0, 165,0,1, 174,0,0, 156,0,1
    </SetTextures>
</xml>
