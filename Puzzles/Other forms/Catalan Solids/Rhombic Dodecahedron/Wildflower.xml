<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Wildflower</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Wildflower</Menu>
        <Inventor>Diogo Sousa</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-27</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36086</Link>
        <Link>http://dmccooey.com/polyhedra/TetrakisCuboctahedron.html</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF';  // White
        Colors[ 1] := '0033FF';  // Blue
        Colors[ 2] := 'FFFF00';  // Yellow
        Colors[ 3] := 'EE0000';  // Red
        Colors[ 4] := '00AA00';  // Green
        Colors[ 5] := 'FF7700';  // Orange
        Colors[ 6] := '00FF99';  // LightGreen
        Colors[ 7] := 'FF88CC';  // LightViolett
        Colors[ 8] := '7700EE';  // Violett
        Colors[ 9] := 'DD0077';  // DarkPink
        Colors[10] := 'AAAAAA';  // Gray
        Colors[11] := 'FFFFAA';  // Cream

        s := 3.355301397608119909925; // s^3 - 3 * x^2 - 4 = 0    s := 1 + (3 - 2 sqrt(2))^(1/3) + (3 + 2 sqrt(2))^(1/3)

        A1 := 2.31535958038656406;  //  2* a^3 - 3* a^2 + 2 = 0    a=-0.677650698804059954  cos(A1) = a
        A2 := 2 * Pi - 2 * A1;

        W1 := 0.7;
        W2 := W1 / 2;
        A  := W2 * 1.165; // pillow

        D  := W1 * 0.75;
        DCut := W1 * 0.8;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " s; 1; 1" />
        <Axis NormVector = " s;-1; 1" />
        <Axis NormVector = " s; 1;-1" />
        <Axis NormVector = " s;-1;-1" />

        <Axis NormVector = " 1; s; 1" />
        <Axis NormVector = "-1; s; 1" />
        <Axis NormVector = " 1; s;-1" />
        <Axis NormVector = "-1; s;-1" />

        <Axis NormVector = " 1; 1; s" />
        <Axis NormVector = "-1; 1; s" />
        <Axis NormVector = " 1;-1; s" />
        <Axis NormVector = "-1;-1; s" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <Macro Name = "Add4Face" >
            <Face Color = "Color" VertexIndexes = "i1;i2;i5" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i2;i3;i5" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i3;i4;i5" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i4;i1;i5" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices>
                <Add Vector = "  0;  0; W1" />
                <Add Vector = " W2; W2; W2" />
                <Add Vector = " W2;-W2; W2" />
                <Add Vector = "-W2;-W2; W2" />
                <Add Vector = "-W2; W2; W2" />
                <Add Vector = " W1;  0;  0" />
                <Add Vector = "  0;-W1;  0" />
                <Add Vector = "-W1;  0;  0" />
                <Add Vector = "  0; W1;  0" />
                <Add Vector = " W2; W2;-W2" />
                <Add Vector = " W2;-W2;-W2" />
                <Add Vector = "-W2;-W2;-W2" />
                <Add Vector = "-W2; W2;-W2" />
                <Add Vector = "  0;  0;-W1" />

                <Add Vector = " A; 0; A" />
                <Add Vector = " 0;-A; A" />
                <Add Vector = "-A; 0; A" />
                <Add Vector = " 0; A; A" />

                <Add Vector = " A; A; 0" />
                <Add Vector = " A;-A; 0" />
                <Add Vector = "-A;-A; 0" />
                <Add Vector = "-A; A; 0" />

                <Add Vector = " A; 0;-A" />
                <Add Vector = " 0;-A;-A" />
                <Add Vector = "-A; 0;-A" />
                <Add Vector = " 0; A;-A" />
            </Vertices>

            <Faces>
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 0]" i1 = " 0" i2 = " 2" i3 = " 5" i4 = " 1" i5 = "14" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 1]" i1 = " 0" i2 = " 3" i3 = " 6" i4 = " 2" i5 = "15" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 2]" i1 = " 0" i2 = " 4" i3 = " 7" i4 = " 3" i5 = "16" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 3]" i1 = " 0" i2 = " 1" i3 = " 8" i4 = " 4" i5 = "17" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 4]" i1 = " 1" i2 = " 5" i3 = " 9" i4 = " 8" i5 = "18" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 5]" i1 = " 2" i2 = " 6" i3 = "10" i4 = " 5" i5 = "19" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 6]" i1 = " 3" i2 = " 7" i3 = "11" i4 = " 6" i5 = "20" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 7]" i1 = " 4" i2 = " 8" i3 = "12" i4 = " 7" i5 = "21" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 8]" i1 = "13" i2 = " 9" i3 = " 5" i4 = "10" i5 = "22" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 9]" i1 = "13" i2 = "10" i3 = " 6" i4 = "11" i5 = "23" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[10]" i1 = "13" i2 = "11" i3 = " 7" i4 = "12" i5 = "24" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[11]" i1 = "13" i2 = "12" i3 = " 8" i4 = " 9" i5 = "25" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Hide><Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /></Hide>
        <InvertVisibility/>
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
