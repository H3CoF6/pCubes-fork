<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>RD-1</Name>
        <Class>TSquare1</Class>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\RD-1</Menu>
        <Inventor>Kyler van der Gaag</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2273</Link>
        <Added>2017-09-25</Added>
    </Interface>

    <Script>
        S15 := sin (Pi / 12); // 15 degrees
        C15 := cos (Pi / 12);
    </Script>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "-1/7; 1/7" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C15; S15; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "-Pi/6" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi/6" />
        <SplitByAxes/>
        <Undo Repeat = "3" />
    </Figure>
</xml>
