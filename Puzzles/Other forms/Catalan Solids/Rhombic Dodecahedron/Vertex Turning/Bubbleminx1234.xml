    <Script>
        Colors[ 0] := 'C80000';
        Colors[ 1] := '0000D8';
        Colors[ 2] := '00A600';
        Colors[ 3] := 'FFFFFF';
        Colors[ 4] := 'FF0080';
        Colors[ 5] := 'BF8040';
        Colors[ 6] := '800040';
        Colors[ 7] := '808000';
        Colors[ 8] := '005600';
        Colors[ 9] := 'FFFF00';
        Colors[10] := 'FF800A';
        Colors[11] := '000078';

        R := 0.6;
        Rs := R * 0.5;
        D := R * 11 / 20;
        D2 := R * 21 / 20 * sqrt(3)/3;

        o1x :=  R / 20;
        o1y :=  R / 20;
        o1z :=  R / 20;
        o2x := -R / 10;
        o2y :=  R / 10;
        o2z := -R / 10;
        o3x :=  R * 3 / 20;
        o3y :=  R * 3 / 20;
        o3z := -R * 3 / 20;

        Vx[ 0] :=   0 + o1x - o2x - o3x; Vy[ 0] :=   0 + o1y - o2y - o3y; Vz[ 0] :=   R + o1z - o2z - o3z;
        Vx[ 1] :=  Rs + o1x - o2x + o3x; Vy[ 1] :=  Rs + o1y - o2y + o3y; Vz[ 1] :=  Rs + o1z - o2z + o3z;
        Vx[ 2] :=  Rs + o1x - o2x - o3x; Vy[ 2] := -Rs + o1y - o2y - o3y; Vz[ 2] :=  Rs + o1z - o2z - o3z;
        Vx[ 3] := -Rs - o1x - o2x - o3x; Vy[ 3] := -Rs - o1y - o2y - o3y; Vz[ 3] :=  Rs - o1z - o2z - o3z;
        Vx[ 4] := -Rs + o1x + o2x - o3x; Vy[ 4] :=  Rs + o1y + o2y - o3y; Vz[ 4] :=  Rs + o1z + o2z - o3z;
        Vx[ 5] :=   R + o1x - o2x + o3x; Vy[ 5] :=   0 + o1y - o2y + o3y; Vz[ 5] :=   0 + o1z - o2z + o3z;
        Vx[ 6] :=   0 - o1x - o2x - o3x; Vy[ 6] :=  -R - o1y - o2y - o3y; Vz[ 6] :=   0 - o1z - o2z - o3z;
        Vx[ 7] :=  -R - o1x + o2x - o3x; Vy[ 7] :=   0 - o1y + o2y - o3y; Vz[ 7] :=   0 - o1z + o2z - o3z;
        Vx[ 8] :=   0 + o1x + o2x + o3x; Vy[ 8] :=   R + o1y + o2y + o3y; Vz[ 8] :=   0 + o1z + o2z + o3z;
        Vx[ 9] :=  Rs + o1x + o2x + o3x; Vy[ 9] :=  Rs + o1y + o2y + o3y; Vz[ 9] := -Rs + o1z + o2z + o3z;
        Vx[10] :=  Rs - o1x - o2x + o3x; Vy[10] := -Rs - o1y - o2y + o3y; Vz[10] := -Rs - o1z - o2z + o3z;
        Vx[11] := -Rs - o1x + o2x - o3x; Vy[11] := -Rs - o1y + o2y - o3y; Vz[11] := -Rs - o1z + o2z - o3z;
        Vx[12] := -Rs - o1x + o2x + o3x; Vy[12] :=  Rs - o1y + o2y + o3y; Vz[12] := -Rs - o1z + o2z + o3z;
        Vx[13] :=   0 - o1x + o2x + o3x; Vy[13] :=   0 - o1y + o2y + o3y; Vz[13] :=  -R - o1z + o2z + o3z;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 1;  0;  0" BaseVector = " o1x - o2x + o3x;  o1y - o2y + o3y;  o1z - o2z + o3z" />
        <Axis NormVector = " 0;  1;  0" BaseVector = " o1x + o2x + o3x;  o1y + o2y + o3y;  o1z + o2z + o3z" />
        <Axis NormVector = " 0;  0;  1" BaseVector = " o1x - o2x - o3x;  o1y - o2y - o3y;  o1z - o2z - o3z" />
        <Axis NormVector = "-1;  0;  0" BaseVector = "-o1x + o2x - o3x; -o1y + o2y - o3y; -o1z + o2z - o3z" />
        <Axis NormVector = " 0; -1;  0" BaseVector = "-o1x - o2x - o3x; -o1y - o2y - o3y; -o1z - o2z - o3z" />
        <Axis NormVector = " 0;  0; -1" BaseVector = "-o1x + o2x + o3x; -o1y + o2y + o3y; -o1z + o2z + o3z" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = " 1;  1;  1" BaseVector = " o1x - o2x + o3x;  o1y - o2y + o3y;  o1z - o2z + o3z" />
        <Axis NormVector = "-1;  1;  1" BaseVector = " o1x + o2x - o3x;  o1y + o2y - o3y;  o1z + o2z - o3z" />
        <Axis NormVector = "-1; -1;  1" BaseVector = "-o1x - o2x - o3x; -o1y - o2y - o3y; -o1z - o2z - o3z" />
        <Axis NormVector = " 1; -1;  1" BaseVector = " o1x - o2x - o3x;  o1y - o2y - o3y;  o1z - o2z - o3z" />
        <Axis NormVector = "-1; -1; -1" BaseVector = "-o1x + o2x - o3x; -o1y + o2y - o3y; -o1z + o2z - o3z" />
        <Axis NormVector = " 1; -1; -1" BaseVector = "-o1x - o2x + o3x; -o1y - o2y + o3y; -o1z - o2z + o3z" />
        <Axis NormVector = " 1;  1; -1" BaseVector = " o1x + o2x + o3x;  o1y + o2y + o3y;  o1z + o2z + o3z" />
        <Axis NormVector = "-1;  1; -1" BaseVector = "-o1x + o2x + o3x; -o1y + o2y + o3y; -o1z + o2z + o3z" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 2; 5; 1" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 3; 6; 2" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0; 4; 7; 3" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 0; 1; 8; 4" />

                <Face Color = "Colors[ 4]" VertexIndexes = " 1; 5; 9; 8" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 2; 6;10; 5" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 3; 7;11; 6" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 4; 8;12; 7" />

                <Face Color = "Colors[ 8]" VertexIndexes = "13; 9; 5;10" />
                <Face Color = "Colors[ 9]" VertexIndexes = "13;10; 6;11" />
                <Face Color = "Colors[10]" VertexIndexes = "13;11; 7;12" />
                <Face Color = "Colors[11]" VertexIndexes = "13;12; 8; 9" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "turn">
            <Turn Axis = "i" Layer = "1" Angle = "a" />
            <Script> Inc(i); </Script>
        </Macro>

        <Macro Name = "turnSq">
            <ExecMacro MacroName = "turn" Repeat = "6" i = " 0" a = "Pi/2" />
        </Macro>

        <Macro Name = "turnTr">
            <ExecMacro MacroName = "turn" Repeat = "8" i = " 6" a = "Pi*2/3" />
        </Macro>

        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnTr" />
        <ExecMacro MacroName = "turnSq" />

        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <ExecMacro MacroName = "turnTr" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <SplitByAxes/>
        <ExecMacro MacroName = "turnSq" />
        <ExecMacro MacroName = "turnTr" />

        <Macro Name = "split1">
            <Turn Axis = "6" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "9" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "10" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "13" Layer = "1" Angle = "Pi*2/3" />

            <Turn Axis = "0" Layer = "1" Angle = "Pi" />
            <Turn Axis = "1" Layer = "1" Angle = "-Pi/2" />
            <Turn Axis = "3" Layer = "1" Angle = "Pi" />
            <Turn Axis = "4" Layer = "1" Angle = "Pi/2" />
            <Turn Axis = "7" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "8" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "11" Layer = "1" Angle = "-Pi*2/3" />
            <Turn Axis = "12" Layer = "1" Angle = "-Pi*2/3" />
            <SplitByAxes/>
            <Undo Repeat = "8" />
        </Macro>

        <ExecMacro MacroName = "split1" Repeat = "2" />
        <Undo Repeat = "8" />

        <Macro Name = "split2">
            <Turn Axis = "2" Layer = "1" Angle = "Pi/2" />
            <Turn Axis = "5" Layer = "1" Angle = "Pi/2" />

            <Turn Axis = "9" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "13" Layer = "1" Angle = "-Pi*2/3" />
            <Turn Axis = "4" Layer = "1" Angle = "Pi/2" />
            <Turn Axis = "1" Layer = "1" Angle = "-Pi/2" />
            <Turn Axis = "8" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "12" Layer = "1" Angle = "-Pi*2/3" />
            <SplitByAxes/>
            <Undo Repeat = "6" />
        </Macro>

        <ExecMacro MacroName = "split2" Repeat = "3" />
        <Undo Repeat = "6" />

        <Macro Name = "split3">
            <Turn Axis = "4" Layer = "1" Angle = "Pi/2" />
            <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />

            <Turn Axis = "8" Layer = "1" Angle = "-Pi*2/3" />
            <Turn Axis = "12" Layer = "1" Angle = "Pi*2/3" />
            <Turn Axis = "3" Layer = "1" Angle = "Pi/2" />
