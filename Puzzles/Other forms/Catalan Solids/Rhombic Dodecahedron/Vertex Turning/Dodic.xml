<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dodic</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Dodic</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10489</Link>
        <Added>2022-10-15</Added>
    </Interface>

    <Script>
        include 'Figures\Scripts\Rhombic Dodecahedron_6_Colors.inc';

        R := 0.7;
        D1 := R * 0.18;
        D2 := R * 0.54;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
