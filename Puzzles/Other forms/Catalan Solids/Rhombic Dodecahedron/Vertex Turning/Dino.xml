<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Rhombic Dodecahedron</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Dino</Menu>
        <Inventor>Adam Zamora</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1720</Link>
    </Interface>

    <Script>
        R := 0.7;
        D := R * 0.5;
        S := 2*D*sqrt(3)/3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-S; S" FixedLayers = "1" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>