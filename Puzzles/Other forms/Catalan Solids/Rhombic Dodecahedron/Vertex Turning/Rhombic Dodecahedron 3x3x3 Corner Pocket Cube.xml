<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Dodecahedron 3x3x3 Corner Pocket Cube</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Pocket</Menu>
        <Inventor>Wu Zhe</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-11-24</Added>
        <Link>https://www.twistypuzzles.com/forum/viewtopic.php?p=425651</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Rhombic Dodecahedron_6_Colors.inc';
        MirrorColor := 'FF7CC0'; // Pink

        R := 0.7;
        D := R * 0.25;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <HideContaining Vector = " D;-D; D" />
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 11 do
                Colors[ i] := MirrorColor;
        </Script>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        <Split Axis = "0" From  = "1" />
        <Split Axis = "1" From  = "2" />
        <Split Axis = "2" From  = "1" />
        <RemoveContaining Vector = "0;0;0" />
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
