<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Dodecahedron 5x5x5</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Rhombic Dodecahedron 5x5x5</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1432</Link>
        <Added>2019-07-08</Added>
    </Interface>

    <Script>
        R := 0.7;
        D1 := R / 8;
        D2 := R * 3 / 8;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
