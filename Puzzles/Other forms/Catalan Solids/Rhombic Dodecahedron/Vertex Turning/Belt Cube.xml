<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Belt Cube</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Belt Cube</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2635</Link>
        <Added>2019-07-08</Added>
    </Interface>

    <Script>
        R := 0.7;
        D := R * 0.6;
        D1 := R * 0.001;
        DCut := R * 0.5;
    </Script>

    <Axes TurningAngles = "Pi/4; Pi/2; 0; Pi/2; Pi/4" PlaneDistances = "-D;-D1; D1; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Preset" >
            <Split Axis = "0" From = "1" />
            <Split Axis = "0" From = "4" />
            <Split Axis = "1" From = "1" />
            <Split Axis = "1" From = "4" />
            <Split Axis = "2" From = "1" />
            <Split Axis = "2" From = "4" />
            <Turn Axis = "0" Layer = "0" Angle = " Pi / 4" />
            <Turn Axis = "0" Layer = "4" Angle = " Pi / 4" />
            <Turn Axis = "1" Layer = "0" Angle = " Pi / 4" />
            <Turn Axis = "1" Layer = "4" Angle = " Pi / 4" />
            <Turn Axis = "2" Layer = "0" Angle = " Pi / 4" />
            <Turn Axis = "2" Layer = "4" Angle = " Pi / 4" />
            <SplitByAxes/>
        </Macro>

        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <ExecMacro MacroName = "Preset" />

        <Hide Axis = "0" Layers = "0;1;3;4" />
        <RemoveAllVisible/>
        <ShowAll/>
        <Hide Axis = "1" Layers = "0;1;3;4" />
        <RemoveAllVisible/>
        <ShowAll/>
        <Hide Axis = "2" Layers = "0;1;3;4" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Undo Repeat = "6" />
        <HideAll/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <ExecMacro MacroName = "Preset" />
        <Hide Axis = "0" Layers = "2" />
        <Hide Axis = "1" Layers = "2" />
        <Hide Axis = "2" Layers = "2" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Hide Axis = "1" Layers = "0;4" />
        <Hide Axis = "2" Layers = "0;4" />
        <InvertVisibility/>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <ShowAll/>
        
        <Hide Axis = "0" Layers = "0;4" />
        <Hide Axis = "2" Layers = "0;4" />
        <InvertVisibility/>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /> </Cut>
        <ShowAll/>
        
        <Hide Axis = "0" Layers = "0;4" />
        <Hide Axis = "1" Layers = "0;4" />
        <InvertVisibility/>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /> </Cut>
        <ShowAll/>
        <Undo Repeat = "6" />
    </Figure>
</xml>
