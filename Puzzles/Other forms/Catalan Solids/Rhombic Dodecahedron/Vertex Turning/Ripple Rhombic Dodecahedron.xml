<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ripple Rhombic Dodecahedron</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Ripple Rhombic Dodecahedron</Menu>
        <Inventor>Raphaël Mouflin</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-12</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;p=397708</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF6600'; // Orange
        Colors[ 1] := 'FF2299'; // Fuchsia
        Colors[ 2] := 'FFAADD'; // Rose
        Colors[ 3] := 'FFEE00'; // Yellow
        Colors[ 4] := '00EE00'; // LightGreen
        Colors[ 5] := 'EE0000'; // Red
        Colors[ 6] := 'AA00FF'; // Violett
        Colors[ 7] := '00AAFF'; // LighterBlue
        Colors[ 8] := '00AA00'; // Green
        Colors[ 9] := '0000FF'; // Blue
        Colors[10] := '0055FF'; // LightBlue
        Colors[11] := '00CCCC'; // Cyan

        W1 := 0.7;
        W2 := W1 / 2;

        A  := W2 * 1.2; // pillow

        D1 := W2;
        D2 := W2 * (5 * A - 4 * W2)/(3 * A - 2 * W2);

        D3 := W1 / sqrt(3);
        D4 := D2 * 2 / sqrt(3);

        W := A;
        include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1;-D2; D2; D1" FixedLayers = "2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi / 3" PlaneDistances = "-D4;-D3; D3; D4" FixedLayers = "2" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Add4Face" >
            <Face Color = "Color" VertexIndexes = "i1;i2;i5" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i2;i3;i5" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i3;i4;i5" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i4;i1;i5" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices>
                <Add Vector = "  0;  0; W1" />
                <Add Vector = " W2; W2; W2" />
                <Add Vector = " W2;-W2; W2" />
                <Add Vector = "-W2;-W2; W2" />
                <Add Vector = "-W2; W2; W2" />
                <Add Vector = " W1;  0;  0" />
                <Add Vector = "  0;-W1;  0" />
                <Add Vector = "-W1;  0;  0" />
                <Add Vector = "  0; W1;  0" />
                <Add Vector = " W2; W2;-W2" />
                <Add Vector = " W2;-W2;-W2" />
                <Add Vector = "-W2;-W2;-W2" />
                <Add Vector = "-W2; W2;-W2" />
                <Add Vector = "  0;  0;-W1" />

                <Add Vector = " A; 0; A" />
                <Add Vector = " 0;-A; A" />
                <Add Vector = "-A; 0; A" />
                <Add Vector = " 0; A; A" />

                <Add Vector = " A; A; 0" />
                <Add Vector = " A;-A; 0" />
                <Add Vector = "-A;-A; 0" />
                <Add Vector = "-A; A; 0" />

                <Add Vector = " A; 0;-A" />
                <Add Vector = " 0;-A;-A" />
                <Add Vector = "-A; 0;-A" />
                <Add Vector = " 0; A;-A" />
            </Vertices>

            <Faces>
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 0]" i1 = " 0" i2 = " 2" i3 = " 5" i4 = " 1" i5 = "14" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 1]" i1 = " 0" i2 = " 3" i3 = " 6" i4 = " 2" i5 = "15" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 2]" i1 = " 0" i2 = " 4" i3 = " 7" i4 = " 3" i5 = "16" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 3]" i1 = " 0" i2 = " 1" i3 = " 8" i4 = " 4" i5 = "17" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 4]" i1 = " 1" i2 = " 5" i3 = " 9" i4 = " 8" i5 = "18" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 5]" i1 = " 2" i2 = " 6" i3 = "10" i4 = " 5" i5 = "19" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 6]" i1 = " 3" i2 = " 7" i3 = "11" i4 = " 6" i5 = "20" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 7]" i1 = " 4" i2 = " 8" i3 = "12" i4 = " 7" i5 = "21" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 8]" i1 = "13" i2 = " 9" i3 = " 5" i4 = "10" i5 = "22" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[ 9]" i1 = "13" i2 = "10" i3 = " 6" i4 = "11" i5 = "23" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[10]" i1 = "13" i2 = "11" i3 = " 7" i4 = "12" i5 = "24" />
                <ExecMacro MacroName = "Add4Face" Color = "Colors[11]" i1 = "13" i2 = "12" i3 = " 8" i4 = " 9" i5 = "25" />
            </Faces>
        </Part>

        <Macro Name = "Split23">
            <Split Axis = "i" From = "2"/>
            <Split Axis = "i" From = "3"/>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Split23" i = "0" Repeat = "7" />

        <Macro Name = "HideC">
            <HideContaining Vector = "Ex[id]; Ey[id]; Ez[id]" />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "HideC" Repeat = "12" id = "0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ExecMacro MacroName = "HideC" Repeat = "12" id = "0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
