<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bubbleminx II</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Bubbleminx II</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>uot</Programmer>
        <Added>2020-07-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6143</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'C80000';
        Colors[ 1] := '0000D8';
        Colors[ 2] := '00A600';
        Colors[ 3] := 'FFFFFF';
        Colors[ 4] := 'FF0080';
        Colors[ 5] := 'BF8040';
        Colors[ 6] := '800040';
        Colors[ 7] := '808000';
        Colors[ 8] := '005600';
        Colors[ 9] := 'FFFF00';
        Colors[10] := 'FF800A';
        Colors[11] := '000078';

        R :=  0.7;
        Rs := R * 0.5;
        D :=  R * 7 / 12;
        D2 := R * 13 / 12 / sqrt(3);

        D3 := R * 10 / 12;
        D4 := R * 16 / 12 / sqrt(3);
        D5 := R * 18 / 12 / sqrt(3);

        ox := R / 12;
        oy := R / 12;
        oz := R / 12;

        Vx[ 0] :=   0 + ox; Vy[ 0] :=   0 + oy; Vz[ 0] :=   R + oz;
        Vx[ 1] :=  Rs + ox; Vy[ 1] :=  Rs + oy; Vz[ 1] :=  Rs + oz;
        Vx[ 2] :=  Rs + ox; Vy[ 2] := -Rs + oy; Vz[ 2] :=  Rs + oz;
        Vx[ 3] := -Rs - ox; Vy[ 3] := -Rs - oy; Vz[ 3] :=  Rs - oz;
        Vx[ 4] := -Rs + ox; Vy[ 4] :=  Rs + oy; Vz[ 4] :=  Rs + oz;
        Vx[ 5] :=   R + ox; Vy[ 5] :=   0 + oy; Vz[ 5] :=   0 + oz;
        Vx[ 6] :=   0 - ox; Vy[ 6] :=  -R - oy; Vz[ 6] :=   0 - oz;
        Vx[ 7] :=  -R - ox; Vy[ 7] :=   0 - oy; Vz[ 7] :=   0 - oz;
        Vx[ 8] :=   0 + ox; Vy[ 8] :=   R + oy; Vz[ 8] :=   0 + oz;
        Vx[ 9] :=  Rs + ox; Vy[ 9] :=  Rs + oy; Vz[ 9] := -Rs + oz;
        Vx[10] :=  Rs - ox; Vy[10] := -Rs - oy; Vz[10] := -Rs - oz;
        Vx[11] := -Rs - ox; Vy[11] := -Rs - oy; Vz[11] := -Rs - oz;
        Vx[12] := -Rs - ox; Vy[12] :=  Rs - oy; Vz[12] := -Rs - oz;
        Vx[13] :=   0 - ox; Vy[13] :=   0 - oy; Vz[13] :=  -R - oz;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 1; 0; 0" BaseVector = " ox; oy; oz" />
        <Axis NormVector = " 0; 1; 0" BaseVector = " ox; oy; oz" />
        <Axis NormVector = " 0; 0; 1" BaseVector = " ox; oy; oz" />
        <Axis NormVector = "-1; 0; 0" BaseVector = "-ox;-oy;-oz" />
        <Axis NormVector = " 0;-1; 0" BaseVector = "-ox;-oy;-oz" />
        <Axis NormVector = " 0; 0;-1" BaseVector = "-ox;-oy;-oz" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = " 1; 1; 1" BaseVector = " ox; oy; oz" />
        <Axis NormVector = "-1; 1; 1" BaseVector = " ox; oy; oz" />
        <Axis NormVector = "-1;-1; 1" BaseVector = "-ox;-oy;-oz" />
        <Axis NormVector = " 1;-1; 1" BaseVector = " ox; oy; oz" />
        <Axis NormVector = "-1;-1;-1" BaseVector = "-ox;-oy;-oz" />
        <Axis NormVector = " 1;-1;-1" BaseVector = "-ox;-oy;-oz" />
        <Axis NormVector = " 1; 1;-1" BaseVector = " ox; oy; oz" />
        <Axis NormVector = "-1; 1;-1" BaseVector = "-ox;-oy;-oz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 2; 5; 1" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 3; 6; 2" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0; 4; 7; 3" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 0; 1; 8; 4" />

                <Face Color = "Colors[ 4]" VertexIndexes = " 1; 5; 9; 8" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 2; 6;10; 5" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 3; 7;11; 6" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 4; 8;12; 7" />

                <Face Color = "Colors[ 8]" VertexIndexes = "13; 9; 5;10" />
                <Face Color = "Colors[ 9]" VertexIndexes = "13;10; 6;11" />
                <Face Color = "Colors[10]" VertexIndexes = "13;11; 7;12" />
                <Face Color = "Colors[11]" VertexIndexes = "13;12; 8; 9" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "SplitCorners1">
            <Turn Axis = "ax" Layer = "1" Angle = "Pi/2" />
            <SplitByAxes/>
            <Undo/>
            <Script> Inc(ax); </Script>
        </Macro>
        <ExecMacro MacroName = "SplitCorners1" ax = "0" Repeat = "6" />

        <Macro Name = "SplitCorners2">
            <Turn Axis = "ax" Layer = "1" Angle = "2*Pi/3" />
            <SplitByAxes/>
            <Undo/>
            <Script> Inc(ax); </Script>
        </Macro>
        <ExecMacro MacroName = "SplitCorners2" ax = "6" Repeat = "8" />

        <HideContaining Vector = "0;0;0" />
        <Macro Name = "HideCorners">
            <HideContaining Vector = " Vx[v]; Vy[v]; Vz[v]" />
            <Script>Inc(v);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCorners" v = "0" Repeat = "14" />

        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "D3" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "D3" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "D3" /></Split>
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "D3" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "D3" /></Split>
        <Split><Plane NormVector = " 0; 0;-1" NormDistance = "D3" /></Split>

        <Split><Plane NormVector = " 1; 1; 1" NormDistance = "D5" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = "D4" /></Split>
        <Split><Plane NormVector = "-1;-1; 1" NormDistance = "D4" /></Split>
        <Split><Plane NormVector = " 1;-1; 1" NormDistance = "D4" /></Split>
        <Split><Plane NormVector = "-1;-1;-1" NormDistance = "D5" /></Split>
        <Split><Plane NormVector = " 1;-1;-1" NormDistance = "D4" /></Split>
        <Split><Plane NormVector = " 1; 1;-1" NormDistance = "D4" /></Split>
        <Split><Plane NormVector = "-1; 1;-1" NormDistance = "D4" /></Split>

        <ShowAll/>
    </Figure>
</xml>
