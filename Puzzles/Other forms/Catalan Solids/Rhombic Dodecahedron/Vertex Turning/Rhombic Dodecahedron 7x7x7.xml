<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Dodecahedron 7x7x7</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Rhombic Dodecahedron 7x7x7</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2656</Link>
        <Added>2019-07-08</Added>
    </Interface>

    <Script>
        R := 0.7;
        D1 := R / 12;
        D2 := R * 3 / 12;
        D3 := R * 5 / 12;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; -D2; -D1; D1; D2; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
