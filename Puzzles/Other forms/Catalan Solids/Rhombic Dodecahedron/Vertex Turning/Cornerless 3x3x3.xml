<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Dodecahedron Cornerless 3x3x3</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Cornerless 3x3x3</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-06-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3874</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Rhombic Dodecahedron_6_Colors.inc';

        R := 0.7;
        D := R * 0.25;
    </Script>
  
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
  
    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "1" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
  
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
