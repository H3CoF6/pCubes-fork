<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Evil Eye II (Open-eye) Dodecahedron</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Vertex Turning\Evil Eye II (Open-eye) Dodecahedron</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4610</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // clWhite
        Colors[ 1] := '800080'; // clViolett
        Colors[ 2] := 'FF0000'; // clRed
        Colors[ 3] := 'FFFF00'; // clYellow
        Colors[ 4] := '0000CC'; // clBlue
        Colors[ 5] := '00AA00'; // clGreen
        Colors[ 6] := '0066CC'; // clLightBlue
        Colors[ 7] := '00FF00'; // clLightGreen
        Colors[ 8] := 'FF6000'; // clOrange
        Colors[ 9] := 'FFFFAA'; // clCream
        Colors[10] := '666666'; // clGray
        Colors[11] := 'FF88CC'; // clLightViolett

        R := 0.7;
        D := R / 2;

        D1 := R * 0.125;
        D2 := R / 2;
        RCut := R - D1;
        RCo := D2 * 0.7;
        Rci := (D2 + RCo) / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Script>
        Vx[ 0] :=  0; Vy[ 0] :=  0; Vz[ 0] :=  R;
        Vx[ 1] :=  D; Vy[ 1] :=  D; Vz[ 1] :=  D;
        Vx[ 2] :=  D; Vy[ 2] := -D; Vz[ 2] :=  D;
        Vx[ 3] := -D; Vy[ 3] := -D; Vz[ 3] :=  D;
        Vx[ 4] := -D; Vy[ 4] :=  D; Vz[ 4] :=  D;
        Vx[ 5] :=  R; Vy[ 5] :=  0; Vz[ 5] :=  0;
        Vx[ 6] :=  0; Vy[ 6] := -R; Vz[ 6] :=  0;
        Vx[ 7] := -R; Vy[ 7] :=  0; Vz[ 7] :=  0;
        Vx[ 8] :=  0; Vy[ 8] :=  R; Vz[ 8] :=  0;
        Vx[ 9] :=  D; Vy[ 9] :=  D; Vz[ 9] := -D;
        Vx[10] :=  D; Vy[10] := -D; Vz[10] := -D;
        Vx[11] := -D; Vy[11] := -D; Vz[11] := -D;
        Vx[12] := -D; Vy[12] :=  D; Vz[12] := -D;
        Vx[13] :=  0; Vy[13] :=  0; Vz[13] := -R;

        Cx[ 0] :=  D; Cy[ 0] :=  0; Cz[ 0] :=  D;
        Cx[ 1] :=  0; Cy[ 1] := -D; Cz[ 1] :=  D;
        Cx[ 2] := -D; Cy[ 2] :=  0; Cz[ 2] :=  D;
        Cx[ 3] :=  0; Cy[ 3] :=  D; Cz[ 3] :=  D;
        Cx[ 4] :=  D; Cy[ 4] :=  D; Cz[ 4] :=  0;
        Cx[ 5] :=  D; Cy[ 5] := -D; Cz[ 5] :=  0;
        Cx[ 6] := -D; Cy[ 6] := -D; Cz[ 6] :=  0;
        Cx[ 7] := -D; Cy[ 7] :=  D; Cz[ 7] :=  0;
        Cx[ 8] :=  D; Cy[ 8] :=  0; Cz[ 8] := -D;
        Cx[ 9] :=  0; Cy[ 9] := -D; Cz[ 9] := -D;
        Cx[10] := -D; Cy[10] :=  0; Cz[10] := -D;
        Cx[11] :=  0; Cy[11] :=  D; Cz[11] := -D;
    </Script>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 2; 5; 1" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 3; 6; 2" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0; 4; 7; 3" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 0; 1; 8; 4" />

                <Face Color = "Colors[ 4]" VertexIndexes = " 1; 5; 9; 8" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 2; 6;10; 5" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 3; 7;11; 6" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 4; 8;12; 7" />

                <Face Color = "Colors[ 8]" VertexIndexes = "13; 9; 5;10" />
                <Face Color = "Colors[ 9]" VertexIndexes = "13;10; 6;11" />
                <Face Color = "Colors[10]" VertexIndexes = "13;11; 7;12" />
                <Face Color = "Colors[11]" VertexIndexes = "13;12; 8; 9" />
            </Faces>
        </Part>

        <Cut> <Plane NormVector = " vx[0]; vy[0]; vz[0]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-vx[0];-vy[0];-vz[0]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " vx[5]; vy[5]; vz[5]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-vx[5];-vy[5];-vz[5]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " vx[6]; vy[6]; vz[6]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-vx[6];-vy[6];-vz[6]" NormDistance = "-RCut" /> </Cut>

        <SplitByAxes/>

        <Macro Name = "CutColors" >
            <HideContaining Vector = " Cx[id]*0.9; Cy[id]*0.9; Cz[id]*0.9" />
            <InvertVisibility/>
            <Cut Color = "Colors[id]" ><Plane NormVector = "-Cx[id]; -Cy[id]; -Cz[id]" NormDistance = "-RCi"  /></Cut>
            <ShowAll/>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColors" Repeat = "12" id = "0" />

<!--
        RCo := D1;
        Rci := D2 * sqrt(2) - RCo;
        <Macro Name = "CutCenters" >
            <HideContaining Vector = "D; 0; D"  />
            <InvertVisibility/>
            <Split><Plane NormVector = "1; 0; -1" NormDistance = "-RCo" /></Split>
            <Split><Plane NormVector = "1; 0; -1" NormDistance = " RCo" /></Split>
            <RemoveContaining Vector = "D; 0; D"  />
            <ShowAll/>
            <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "CutCenters" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "Pi*2/3" />
        <ExecMacro MacroName = "CutCenters" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "Pi*2/3" />
        <ExecMacro MacroName = "CutCenters" Repeat = "4" />
        <Turn NormVector = "1;1;1" Angle = "Pi*2/3" />
-->

        <Macro Name = "HideCenters" >
            <HideContaining Vector = "-Cx[id]; -Cy[id]; -Cz[id]"  />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCenters" Repeat = "12" id = "0" />

        <InvertVisibility/>

        <Split><Plane NormVector = "-vx[0];-vy[0];-vz[0]" NormDistance = "-RCo" /></Split>
        <Split><Plane NormVector = " vx[0]; vy[0]; vz[0]" NormDistance = "-RCo" /></Split>
        <Split><Plane NormVector = "-vx[5];-vy[5];-vz[5]" NormDistance = "-RCo" /></Split>
        <Split><Plane NormVector = " vx[5]; vy[5]; vz[5]" NormDistance = "-RCo" /></Split>
        <Split><Plane NormVector = "-vx[6];-vy[6];-vz[6]" NormDistance = "-RCo" /></Split>
        <Split><Plane NormVector = " vx[6]; vy[6]; vz[6]" NormDistance = "-RCo" /></Split>

        <Macro Name = "RemoveParts" >
            <RemoveContaining Vector = "-Cx[id]; -Cy[id]; -Cz[id]"  />
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "RemoveParts" Repeat = "12" id = "0" />

        <ShowAll/>
    </Figure>
</xml>
