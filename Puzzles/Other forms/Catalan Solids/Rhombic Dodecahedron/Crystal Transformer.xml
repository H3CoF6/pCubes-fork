<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crystal Transformer</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Crystal Transformer</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5142</Link>
    </Interface>

    <Script>
        R := 0.7;
        D := R * sqrt(2) / 4;

        A1 := Arccos(1/3);
        A2 := 2 * Arccos(1/3);
        A3 := Pi - A1;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles="-A3; -A2; -A1; 0; A1; A2; A3; Pi" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "1;  1;  0" />
        <Axis NormVector = "1; -1;  0" />
        <Axis NormVector = "1;  0;  1" />
        <Axis NormVector = "1;  0; -1" />
        <Axis NormVector = "0;  1;  1" />
        <Axis NormVector = "0;  1; -1" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "0">
        <Axis NormVector = " D;  D;  D" />
        <Axis NormVector = " D; -D; -D" />
        <Axis NormVector = "-D; -D;  D" />
        <Axis NormVector = "-D;  D; -D" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
