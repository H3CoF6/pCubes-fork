<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning Rhombic Dodecahedron (4 layers)</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Face Turning\4 layers</Menu>
        <Inventor></Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-05-16</Added>
    </Interface>

    <Script>
        R := 0.7;
        D := R * sqrt(2) / 4;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1;  1;  0" />
        <Axis NormVector = "1; -1;  0" />
        <Axis NormVector = "1;  0;  1" />
        <Axis NormVector = "1;  0; -1" />
        <Axis NormVector = "0;  1;  1" />
        <Axis NormVector = "0;  1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
