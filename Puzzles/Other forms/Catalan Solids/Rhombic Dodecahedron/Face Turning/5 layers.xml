<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Turning Rhombic Dodecahedron (5 layers)</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Face Turning\5 layers</Menu>
        <Inventor></Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-05-16</Added>
    </Interface>

    <Script>
        R := 0.7;
        D1 := R * sqrt(2) / 6;
        D2 := R * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "1;  1;  0" />
        <Axis NormVector = "1; -1;  0" />
        <Axis NormVector = "1;  0;  1" />
        <Axis NormVector = "1;  0; -1" />
        <Axis NormVector = "0;  1;  1" />
        <Axis NormVector = "0;  1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        // remove central part
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "4" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "4" From = "4" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "5" From = "4" />
        <RemoveGrayParts/>

        <SplitByAxes/>
    </Figure>
</xml>
