<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rua Master</Name>
        <Menu>Other forms\Catalan Solids\Rhombic Dodecahedron\Face Turning\Rua Master</Menu>
        <Inventor>Mohammad Badir</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-07-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6538</Link>
    </Interface>

    <Script>
        R := 0.7;
        D1 := R * sqrt(2) / 4;
        D2 := R * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "1;  1;  0" />
        <Axis NormVector = "1; -1;  0" />
        <Axis NormVector = "1;  0;  1" />
        <Axis NormVector = "1;  0; -1" />
        <Axis NormVector = "0;  1;  1" />
        <Axis NormVector = "0;  1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
