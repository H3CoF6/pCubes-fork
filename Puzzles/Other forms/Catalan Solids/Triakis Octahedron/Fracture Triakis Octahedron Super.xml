<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fracture Triakis Octahedron Super</Name>
        <Menu>Other forms\Catalan Solids\Triakis Octahedron\Fracture Triakis Octahedron Super</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-11-18</Added>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Coordinates.inc';

        clWhite  := 'F0F0F0';
        clSilver := 'A0A0A0';
        clBlack  := '202020';

        clTeal   := '008080';
        clBlue   := '0000FF';
        clNavy   := '000080';

        clCoral  := 'FF7F50';
        clRed    := 'FF0000';
        clBrown  := '800000';

        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGolden := 'DDBB20';

        clLime   := '00FF00';
        clGreen  := '008000';
        clOlive  := '808000';

        clPink   := 'FF69B4';
        clOrchid := 'DA70D6';
        clPurple := '800080';

        clKhaki  := 'F0E68C';
        clViolet := '8a2be2';
        clSlate  := '79cdcd';

        clIndian := 'CD5C5C';
        clCyan   := '00FFFF';
        clPale   := 'D07090';

        C := 0.3;
        C0 := C + C * sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 4; 0; Pi / 4" PlaneDistances = "-C; C" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;   0;  C0" />
                <Add Vector = "  0;   0; -C0" />
                <Add Vector = " C0;   0;   0" />
                <Add Vector = "-C0;   0;   0" />
                <Add Vector = "  0;  C0;   0" />
                <Add Vector = "  0; -C0;   0" />
                <Add Vector = "  C;   C;   C" />
                <Add Vector = "  C;   C;  -C" />
                <Add Vector = "  C;  -C;   C" />
                <Add Vector = "  C;  -C;  -C" />
                <Add Vector = " -C;   C;   C" />
                <Add Vector = " -C;   C;  -C" />
                <Add Vector = " -C;  -C;   C" />
                <Add Vector = " -C;  -C;  -C" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = " 6; 0; 2" />
                <Face Color = "clSilver" VertexIndexes = " 6; 2; 4" />
                <Face Color = "clBlack " VertexIndexes = " 6; 4; 0" />
                <Face Color = "clRed   " VertexIndexes = " 7; 1; 4" />
                <Face Color = "clBrown " VertexIndexes = " 7; 4; 2" />
                <Face Color = "clCoral " VertexIndexes = " 7; 2; 1" />
                <Face Color = "clNavy  " VertexIndexes = " 8; 0; 5" />
                <Face Color = "clBlue  " VertexIndexes = " 8; 5; 2" />
                <Face Color = "clTeal  " VertexIndexes = " 8; 2; 0" />
                <Face Color = "clYellow" VertexIndexes = " 9; 1; 2" />
                <Face Color = "clOrange" VertexIndexes = " 9; 2; 5" />
                <Face Color = "clGolden" VertexIndexes = " 9; 5; 1" />
                <Face Color = "clPink  " VertexIndexes = "10; 0; 4" />
                <Face Color = "clOrchid" VertexIndexes = "10; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "10; 3; 0" />
                <Face Color = "clGreen " VertexIndexes = "11; 1; 3" />
                <Face Color = "clLime  " VertexIndexes = "11; 3; 4" />
                <Face Color = "clOlive " VertexIndexes = "11; 4; 1" />
                <Face Color = "clKhaki " VertexIndexes = "12; 0; 3" />
                <Face Color = "clPale  " VertexIndexes = "12; 3; 5" />
                <Face Color = "clIndian" VertexIndexes = "12; 5; 0" />
                <Face Color = "clCyan  " VertexIndexes = "13; 1; 5" />
                <Face Color = "clViolet" VertexIndexes = "13; 5; 3" />
                <Face Color = "clSlate " VertexIndexes = "13; 3; 1" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Macro Name = "HideCorners" >
            <HideContaining Vector = "Vx[Id]; Vy[Id]; Vz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "HideCorners" Id = "0" Repeat = "8" />

        <Macro Name = "Split" >
            <Turn Axis = "Ax" Angle =  "Pi / 4" Layer = "0" />
            <Turn Axis = "Ax" Angle =  "Pi / 4" Layer = "2" />
            <SplitByAxes/>
            <Undo/>
            <Undo/>
        </Macro>
        <ExecMacro MacroName = "Split" Ax = "0" />
        <ExecMacro MacroName = "Split" Ax = "1" />
        <ExecMacro MacroName = "Split" Ax = "2" />

        <RemoveGrayParts/>

        <Macro Name = "Split2" >
            <Turn Axis = "Ax1" Angle =  "Pi / 4" Layer = "1" />

            <Turn Axis = "Ax2" Angle =  "Pi / 4" Layer = "1" />
            <SplitByAxes/>
            <Undo/>

            <Turn Axis = "Ax3" Angle =  "Pi / 4" Layer = "1" />
            <SplitByAxes/>
            <Undo/>

            <Undo/>

        </Macro>
        <ExecMacro MacroName = "Split2" Ax1 = "0" Ax2 = "1" Ax3 = "2" />
        <ExecMacro MacroName = "Split2" Ax1 = "1" Ax2 = "2" Ax3 = "0" />
        <ExecMacro MacroName = "Split2" Ax1 = "2" Ax2 = "0" Ax3 = "1" />

        <ShowAll/>
        <RemoveGrayParts/>

    </Figure>
</xml>
