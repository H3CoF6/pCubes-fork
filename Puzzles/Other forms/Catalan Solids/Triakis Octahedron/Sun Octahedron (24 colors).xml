<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sun Octahedron (24 colors)</Name>
        <Menu>Other forms\Catalan Solids\Triakis Octahedron\Sun Octahedron (24 colors)</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-03</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[ 0] := 'F0F0F0'; // White
        Colors[ 1] := 'C0C0C0'; // Silver
        Colors[ 2] := '202020'; // Black
        Colors[ 3] := '008080'; // Teal
        Colors[ 4] := '0000FF'; // Blue
        Colors[ 5] := '000080'; // Navy
        Colors[ 6] := 'FF7F50'; // Coral
        Colors[ 7] := 'FF0000'; // Red
        Colors[ 8] := '800000'; // Brown
        Colors[ 9] := 'FFFF00'; // Yellow
        Colors[10] := 'FF6000'; // Orange
        Colors[11] := 'DDBB20'; // Golden
        Colors[12] := '00FF00'; // Lime
        Colors[13] := '008000'; // Green
        Colors[14] := '808000'; // Olive
        Colors[15] := 'FF69B4'; // Pink
        Colors[16] := 'DA70D6'; // Orchid
        Colors[17] := '800080'; // Purple
        Colors[18] := '00FFFF'; // Cyan
        Colors[19] := '8a2be2'; // Violet
        Colors[20] := '79cdcd'; // Slate
        Colors[21] := 'CD5C5C'; // Indian
        Colors[22] := 'F0E68C'; // Khaki
        Colors[23] := 'D07090'; // Pale

        W := 1.5 * 0.5;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';

        P := 1.225;

        D1 := W / 3 * P;
        D2 := W / sqrt(3);

        for i := 0 to 7 do begin
            CPx[i] := Cx[i] * P;
            CPy[i] := Cy[i] * P;
            CPz[i] := Cz[i] * P;
        end;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "CPx; CPy; CPz" />

            <Faces>
                <Face Color = "Colors[5]"  VertexIndexes = "0;2;6" />
                <Face Color = "Colors[4]"  VertexIndexes = "2;5;6" />
                <Face Color = "Colors[3]"  VertexIndexes = "5;0;6" />

                <Face Color = "Colors[10]" VertexIndexes = "5;2;7" />
                <Face Color = "Colors[11]" VertexIndexes = "2;1;7" />
                <Face Color = "Colors[9]"  VertexIndexes = "1;5;7" />

                <Face Color = "Colors[6]"  VertexIndexes = "5;1;8" />
                <Face Color = "Colors[7]"  VertexIndexes = "1;3;8" />
                <Face Color = "Colors[8]"  VertexIndexes = "3;5;8" />

                <Face Color = "Colors[1]"  VertexIndexes = "5;3;9" />
                <Face Color = "Colors[2]"  VertexIndexes = "3;0;9" />
                <Face Color = "Colors[0]"  VertexIndexes = "0;5;9" />

                <Face Color = "Colors[23]" VertexIndexes = "4;2;10" />
                <Face Color = "Colors[21]" VertexIndexes = "2;0;10" />
                <Face Color = "Colors[22]" VertexIndexes = "0;4;10" />

                <Face Color = "Colors[20]" VertexIndexes = "4;1;11" />
                <Face Color = "Colors[18]" VertexIndexes = "1;2;11" />
                <Face Color = "Colors[19]" VertexIndexes = "2;4;11" />

                <Face Color = "Colors[12]" VertexIndexes = "4;3;12" />
                <Face Color = "Colors[14]" VertexIndexes = "3;1;12" />
                <Face Color = "Colors[13]" VertexIndexes = "1;4;12" />

                <Face Color = "Colors[17]" VertexIndexes = "4;0;13" />
                <Face Color = "Colors[16]" VertexIndexes = "3;4;13" />
                <Face Color = "Colors[15]" VertexIndexes = "0;3;13" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
