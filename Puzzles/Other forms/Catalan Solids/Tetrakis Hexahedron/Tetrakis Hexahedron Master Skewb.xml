<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrakis Hexahedron Master Skewb</Name>
        <Menu>Other forms\Catalan Solids\Tetrakis Hexahedron\Tetrakis Hexahedron Master Skewb</Menu>
        <Inventor>Joachim Solborg</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-08-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7648</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'F0F0F0'; // clWhite
        Colors[ 1] := 'C0C0C0'; // clSilver     
        Colors[ 2] := '808080'; // clGray       
        Colors[ 3] := '202020'; // clBlack      
        Colors[ 4] := '00FFFF'; // clCyan       
        Colors[ 5] := '008080'; // clTeal       
        Colors[ 6] := '0000FF'; // clBlue       
        Colors[ 7] := '000080'; // clNavy       
        Colors[ 8] := 'FF0000'; // clRed        
        Colors[ 9] := '800000'; // clBrown      
        Colors[10] := 'FF7F50'; // clCoral      
        Colors[11] := 'CD5C5C'; // clIndian     
        Colors[12] := 'FFFF00'; // clYellow     
        Colors[13] := '808000'; // clOlive      
        Colors[14] := 'FF6000'; // clOrange     
        Colors[15] := 'DDBB20'; // clGolden     
        Colors[16] := '00FF00'; // clLime       
        Colors[17] := '008000'; // clGreen      
        Colors[18] := '006400'; // clDarkGreen  
        Colors[19] := 'ADFF2F'; // clGreenYellow
        Colors[20] := 'FF00FF'; // clFuchsia    
        Colors[21] := '800080'; // clPurple     
        Colors[22] := 'FF69B4'; // clPink       
        Colors[23] := 'DB7093'; // clPale       

        K  := 0.425;
        C0 := K;
        C1 := K * 3 / 2;
        D := K * 0.25;
    </Script>

    <Axes TurningAngles = "2 * Pi/3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;   0;  C1" />
                <Add Vector = "  0;   0; -C1" />
                <Add Vector = " C1;   0;   0" />
                <Add Vector = "-C1;   0;   0" />
                <Add Vector = "  0;  C1;   0" />
                <Add Vector = "  0; -C1;   0" />
                <Add Vector = " C0;  C0;  C0" />
                <Add Vector = " C0;  C0; -C0" />
                <Add Vector = " C0; -C0;  C0" />
                <Add Vector = " C0; -C0; -C0" />
                <Add Vector = "-C0;  C0;  C0" />
                <Add Vector = "-C0;  C0; -C0" />
                <Add Vector = "-C0; -C0;  C0" />
                <Add Vector = "-C0; -C0; -C0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "0; 6;10" />
                <Face Color = "Colors[ 1]" VertexIndexes = "0;10;12" />
                <Face Color = "Colors[ 2]" VertexIndexes = "0;12; 8" />
                <Face Color = "Colors[ 3]" VertexIndexes = "0; 8; 6" />
                <Face Color = "Colors[ 4]" VertexIndexes = "1; 7; 9" />
                <Face Color = "Colors[ 5]" VertexIndexes = "1; 9;13" />
                <Face Color = "Colors[ 6]" VertexIndexes = "1;13;11" />
                <Face Color = "Colors[ 7]" VertexIndexes = "1;11; 7" />
                <Face Color = "Colors[ 8]" VertexIndexes = "2; 6; 8" />
                <Face Color = "Colors[ 9]" VertexIndexes = "2; 8; 9" />
                <Face Color = "Colors[10]" VertexIndexes = "2; 9; 7" />
                <Face Color = "Colors[11]" VertexIndexes = "2; 7; 6" />
                <Face Color = "Colors[12]" VertexIndexes = "3;10;11" />
                <Face Color = "Colors[13]" VertexIndexes = "3;11;13" />
                <Face Color = "Colors[14]" VertexIndexes = "3;13;12" />
                <Face Color = "Colors[15]" VertexIndexes = "3;12;10" />
                <Face Color = "Colors[16]" VertexIndexes = "4; 6; 7" />
                <Face Color = "Colors[17]" VertexIndexes = "4; 7;11" />
                <Face Color = "Colors[18]" VertexIndexes = "4;11;10" />
                <Face Color = "Colors[19]" VertexIndexes = "4;10; 6" />
                <Face Color = "Colors[20]" VertexIndexes = "5; 8;12" />
                <Face Color = "Colors[21]" VertexIndexes = "5;12;13" />
                <Face Color = "Colors[22]" VertexIndexes = "5;13; 9" />
                <Face Color = "Colors[23]" VertexIndexes = "5; 9; 8" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
