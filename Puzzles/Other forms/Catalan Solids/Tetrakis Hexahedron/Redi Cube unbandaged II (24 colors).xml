<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Redi Cube unbandaged II (24 colors)</Name>
        <Menu>Other forms\Catalan Solids\Tetrakis Hexahedron\Redi Cube unbandaged II (24 colors)</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-06</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clSilver      := 'C0C0C0';
        clGray        := '808080';
        clBlack       := '202020';

        clRed         := 'FF0000';
        clBrown       := '800000';
        clCoral       := 'FF7F50';
        clIndian      := 'CD5C5C';

        clLime        := '00FF00';
        clGreen       := '008000';
        clDarkGreen   := '006400';
        clGreenYellow := 'ADFF2F';

        clCyan        := '00FFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clYellow      := 'FFFF00';
        clOlive       := '808000';
        clOrange      := 'FF6000';
        clGolden      := 'DDBB20';

        clFuchsia     := 'FF00FF';
        clPurple      := '800080';
        clPink        := 'FF69B4';
        clPale        := 'DB7093';

        W  := 0.4;
        A := W * 1.5;
        D := A / sqrt(3);
    </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/6" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; A" />
                <Add Vector = " 0; 0;-A" />
                <Add Vector = " A; 0; 0" />
                <Add Vector = "-A; 0; 0" />
                <Add Vector = " 0; A; 0" />
                <Add Vector = " 0;-A; 0" />
                <Add Vector = " W; W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W;-W;-W" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite      " VertexIndexes = "0; 6;10" />
                <Face Color = "clSilver     " VertexIndexes = "0;10;12" />
                <Face Color = "clGray       " VertexIndexes = "0;12; 8" />
                <Face Color = "clBlack      " VertexIndexes = "0; 8; 6" />

                <Face Color = "clRed        " VertexIndexes = "1; 7; 9" />
                <Face Color = "clBrown      " VertexIndexes = "1; 9;13" />
                <Face Color = "clCoral      " VertexIndexes = "1;13;11" />
                <Face Color = "clIndian     " VertexIndexes = "1;11; 7" />

                <Face Color = "clLime       " VertexIndexes = "2; 6; 8" />
                <Face Color = "clGreen      " VertexIndexes = "2; 8; 9" />
                <Face Color = "clDarkGreen  " VertexIndexes = "2; 9; 7" />
                <Face Color = "clGreenYellow" VertexIndexes = "2; 7; 6" />

                <Face Color = "clCyan       " VertexIndexes = "3;10;11" />
                <Face Color = "clTeal       " VertexIndexes = "3;11;13" />
                <Face Color = "clBlue       " VertexIndexes = "3;13;12" />
                <Face Color = "clNavy       " VertexIndexes = "3;12;10" />

                <Face Color = "clYellow     " VertexIndexes = "4; 6; 7" />
                <Face Color = "clOlive      " VertexIndexes = "4; 7;11" />
                <Face Color = "clOrange     " VertexIndexes = "4;11;10" />
                <Face Color = "clGolden     " VertexIndexes = "4;10; 6" />

                <Face Color = "clFuchsia    " VertexIndexes = "5; 8;12" />
                <Face Color = "clPurple     " VertexIndexes = "5;12;13" />
                <Face Color = "clPink       " VertexIndexes = "5;13; 9" />
                <Face Color = "clPale       " VertexIndexes = "5; 9; 8" />
            </Faces>
        </Part>

        <SplitByAxes />

        <Turn Axis = "0" Layer = "2" Angle = "Pi/3" />
        <Turn Axis = "1" Layer = "2" Angle = "Pi/3" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi/3" />
        <Turn Axis = "3" Layer = "2" Angle = "Pi/3" />
        <SplitByAxes />
        <Undo Repeat = "4" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
