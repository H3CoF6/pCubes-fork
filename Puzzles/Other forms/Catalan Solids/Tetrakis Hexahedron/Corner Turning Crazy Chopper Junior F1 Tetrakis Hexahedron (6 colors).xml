<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corner Turning Crazy Chopper Junior F1 Tetrakis Hexahedron (6 colors)</Name>
        <Menu>Other forms\Catalan Solids\Tetrakis Hexahedron\Corner Turning Crazy Chopper Junior F1 (6 colors)</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clBlue   := '0033FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGreen  := '00AA00';

        K  := 0.4;
        C0 := K;
        C1 := K * 3 / 2;
        C2 := K * 2 / 3;

        K  := 0.4;
        C0 := K;
        C1 := K * 3 / 2;
        C2 := K * 2 / 3;

        D1  := C1 / sqrt(2) * 1.05;
        D2 := K * 1.391;
        D3 := K * 1.203;

        jumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "jumAngle" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; D3" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C1" />
                <Add Vector = "  0;  0;-C1" />
                <Add Vector = " C1;  0;  0" />
                <Add Vector = "-C1;  0;  0" />
                <Add Vector = "  0; C1;  0" />
                <Add Vector = "  0;-C1;  0" />
                <Add Vector = " C0; C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0;-C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0; C0;-C0" />
                <Add Vector = "-C0;-C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "0; 6;10" InvisibleEdges = "5" />
                <Face Color = "clWhite " VertexIndexes = "0;10;12" InvisibleEdges = "5" />
                <Face Color = "clWhite " VertexIndexes = "0;12; 8" InvisibleEdges = "5" />
                <Face Color = "clWhite " VertexIndexes = "0; 8; 6" InvisibleEdges = "5" />
                <Face Color = "clYellow" VertexIndexes = "1; 7; 9" InvisibleEdges = "5" />
                <Face Color = "clYellow" VertexIndexes = "1; 9;13" InvisibleEdges = "5" />
                <Face Color = "clYellow" VertexIndexes = "1;13;11" InvisibleEdges = "5" />
                <Face Color = "clYellow" VertexIndexes = "1;11; 7" InvisibleEdges = "5" />
                <Face Color = "clGreen " VertexIndexes = "2; 6; 8" InvisibleEdges = "5" />
                <Face Color = "clGreen " VertexIndexes = "2; 8; 9" InvisibleEdges = "5" />
                <Face Color = "clGreen " VertexIndexes = "2; 9; 7" InvisibleEdges = "5" />
                <Face Color = "clGreen " VertexIndexes = "2; 7; 6" InvisibleEdges = "5" />
                <Face Color = "clBlue  " VertexIndexes = "3;10;11" InvisibleEdges = "5" />
                <Face Color = "clBlue  " VertexIndexes = "3;11;13" InvisibleEdges = "5" />
                <Face Color = "clBlue  " VertexIndexes = "3;13;12" InvisibleEdges = "5" />
                <Face Color = "clBlue  " VertexIndexes = "3;12;10" InvisibleEdges = "5" />
                <Face Color = "clRed   " VertexIndexes = "4; 6; 7" InvisibleEdges = "5" />
                <Face Color = "clRed   " VertexIndexes = "4; 7;11" InvisibleEdges = "5" />
                <Face Color = "clRed   " VertexIndexes = "4;11;10" InvisibleEdges = "5" />
                <Face Color = "clRed   " VertexIndexes = "4;10; 6" InvisibleEdges = "5" />
                <Face Color = "clOrange" VertexIndexes = "5; 8;12" InvisibleEdges = "5" />
                <Face Color = "clOrange" VertexIndexes = "5;12;13" InvisibleEdges = "5" />
                <Face Color = "clOrange" VertexIndexes = "5;13; 9" InvisibleEdges = "5" />
                <Face Color = "clOrange" VertexIndexes = "5; 9; 8" InvisibleEdges = "5" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "Split" >
            <Hide><Plane NormVector = " 0;-1; 1" NormDistance = "D1" /></Hide>
            <Hide><Plane NormVector = " 1; 0; 1" NormDistance = "D1" /></Hide>
            <Turn NormVector = " 1; 0; 1" Angle = "JumAngle" />
            <Split><Plane NormVector = " 0;-1; 1" NormDistance = "D1" /></Split>
            <Split><Plane NormVector = " 1;-1; 1" NormDistance = "D2" /></Split>
            <Split><Plane NormVector = " 1; 0; 0" NormDistance = "D3" /></Split>
            <Turn NormVector = " 1; 0; 1" Angle = "-JumAngle" />
            <ShowAll/>
            <Turn NormVector = " 0; 0; 1" Angle = "Pi/2" />
        </Macro>
        <Macro Name = "Split2" >
            <ExecMacro MacroName = "Split" Repeat = "4" />
            <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
            <ExecMacro MacroName = "Split" Repeat = "4" />
            <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
            <Turn NormVector = " 1; 1; 1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Split2" Repeat = "3" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
