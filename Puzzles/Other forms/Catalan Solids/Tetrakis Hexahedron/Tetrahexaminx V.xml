<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrahexaminx V</Name>
        <Menu>Other forms\Catalan Solids\Tetrakis Hexahedron\Tetrahexaminx V</Menu>
        <Inventor>Kevin Uhrik</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-12-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7182</Link>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clSilver      := 'C0C0C0';
        clGray        := '808080';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clRed         := 'FF0000';
        clBrown       := '800000';
        clCoral       := 'FF7F50';
        clIndian      := 'CD5C5C';

        clYellow      := 'FFFF00';
        clOlive       := '808000';
        clOrange      := 'FF6000';
        clGolden      := 'DDBB20';

        clLime        := '00FF00';
        clGreen       := '008000';
        clDarkGreen   := '006400';
        clGreenYellow := 'ADFF2F';

        clFuchsia     := 'FF00FF';
        clPurple      := '800080';
        clPink        := 'FF69B4';
        clPale        := 'DB7093';

        K  := 0.4;
        C0 := K;
        C1 := K * 3 / 2;
        C2 := K * 2 / 3;

        D  := C1 / sqrt(2);
        D2 := K * 1.254;
        DCut := K * 0.64;

        A1 := Arccos(1/3);
        A2 := Arccos(1/3)+Pi;
        A3 := (Pi-Arccos(1/3))/2;
        A4 := (3*Pi-Arccos(1/3))/2;
    </Script>
 
    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1;  1; 1" /> 0
        <Axis NormVector = " 1; -1; 1" /> 1
        <Axis NormVector = "-1; -1; 1" /> 2
        <Axis NormVector = "-1;  1; 1" /> 3
    </Axes>
    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A4; -A3; -A2; -A1; Pi; 0; A1; A2; A3; A4" PlaneDistances = "-D; D" FixedLayers = "1">
        <Axis NormVector = " 0;  1; 1" /> 4
        <Axis NormVector = " 1;  0; 1" /> 5
        <Axis NormVector = " 0; -1; 1" /> 6
        <Axis NormVector = "-1;  0; 1" /> 7
        <Axis NormVector = "-1;  1; 0" /> 8
        <Axis NormVector = " 1;  1; 0" /> 9
    </Axes>
    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "  1;  0;  0" />
        <Axis NormVector = "  0;  1;  0" />
        <Axis NormVector = "  0;  0;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;   0;  C1" />
                <Add Vector = "  0;   0; -C1" />
                <Add Vector = " C1;   0;   0" />
                <Add Vector = "-C1;   0;   0" />
                <Add Vector = "  0;  C1;   0" />
                <Add Vector = "  0; -C1;   0" />
                <Add Vector = " C0;  C0;  C0" />
                <Add Vector = " C0;  C0; -C0" />
                <Add Vector = " C0; -C0;  C0" />
                <Add Vector = " C0; -C0; -C0" />
                <Add Vector = "-C0;  C0;  C0" />
                <Add Vector = "-C0;  C0; -C0" />
                <Add Vector = "-C0; -C0;  C0" />
                <Add Vector = "-C0; -C0; -C0" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite "      VertexIndexes = "0; 6;10" />
                <Face Color = "clSilver"      VertexIndexes = "0;10;12" />
                <Face Color = "clGray  "      VertexIndexes = "0;12; 8" />
                <Face Color = "clBlack "      VertexIndexes = "0; 8; 6" />
                <Face Color = "clRed   "      VertexIndexes = "1; 7; 9" />
                <Face Color = "clBrown "      VertexIndexes = "1; 9;13" />
                <Face Color = "clCoral"       VertexIndexes = "1;13;11" />
                <Face Color = "clIndian"      VertexIndexes = "1;11; 7" />
                <Face Color = "clLime"        VertexIndexes = "2; 6; 8" />
                <Face Color = "clGreen"       VertexIndexes = "2; 8; 9" />
                <Face Color = "clDarkGreen"   VertexIndexes = "2; 9; 7" />
                <Face Color = "clGreenYellow" VertexIndexes = "2; 7; 6" />
                <Face Color = "clCyan"        VertexIndexes = "3;10;11" />
                <Face Color = "clTeal"        VertexIndexes = "3;11;13" />
                <Face Color = "clBlue"        VertexIndexes = "3;13;12" />
                <Face Color = "clNavy"        VertexIndexes = "3;12;10" />
                <Face Color = "clYellow"      VertexIndexes = "4; 6; 7" />
                <Face Color = "clOlive "      VertexIndexes = "4; 7;11" />
                <Face Color = "clOrange"      VertexIndexes = "4;11;10" />
                <Face Color = "clGolden"      VertexIndexes = "4;10; 6" />
                <Face Color = "clFuchsia"     VertexIndexes = "5; 8;12" />
                <Face Color = "clPurple"      VertexIndexes = "5;12;13" />
                <Face Color = "clPink"        VertexIndexes = "5;13; 9" />
                <Face Color = "clPale"        VertexIndexes = "5; 9; 8" />
            </Faces>
        </Part>

        <Split Axis = "10" From = "1" />
        <Split Axis = "10" From = "2" />
        <Hide Axis = "10" Layer = "1" />
        <Cut><Plane NormVector = "0;1;1" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "0;1;-1" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "0;-1;-1" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "0;-1;1" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <Split Axis = "11" From = "1" />
        <Split Axis = "11" From = "2" />
        <Hide Axis = "11" Layer = "1" />
        <Cut><Plane NormVector = " 1;0; 1" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = " 1;0;-1" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "-1;0;-1" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "-1;0; 1" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <Split Axis = "12" From = "1" />
        <Split Axis = "12" From = "2" />
        <Hide Axis = "12" Layer = "1" />
        <Cut><Plane NormVector = " 1; 1;0" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = " 1;-1;0" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "-1;-1;0" NormDistance = "-DCut" /></Cut>
        <Cut><Plane NormVector = "-1; 1;0" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <SplitByAxes/>

        <Turn  Axis = "4" Layer = "0" Angle = "A3" />
        <Turn  Axis = "4" Layer = "2" Angle = "A3" />
        <Split Axis = "2" From = "1"/>
        <Turn  Axis = "6" Layer = "0" Angle = "A3" />
        <Turn  Axis = "6" Layer = "2" Angle = "A3" />
        <Split Axis = "0" From = "1"/>
        <Undo Repeat="4" />

        <Turn  Axis = "5" Layer = "0" Angle = "A3" />
        <Turn  Axis = "5" Layer = "2" Angle = "A3" />
        <Split Axis = "3" From = "1"/>
        <Turn  Axis = "7" Layer = "0" Angle = "A3" />
        <Turn  Axis = "7" Layer = "2" Angle = "A3" />
        <Split Axis = "1" From = "1"/>
        <Undo Repeat="4" />

        <Turn  Axis = "8" Layer = "0" Angle = "A3" />
        <Turn  Axis = "8" Layer = "2" Angle = "A3" />
        <Split Axis = "0" From = "1"/>
        <Turn  Axis = "9" Layer = "0" Angle = "A3" />
        <Turn  Axis = "9" Layer = "2" Angle = "A3" />
        <Split Axis = "1" From = "1"/>
        <Undo Repeat="4" />
-->
    </Figure>
</xml>
