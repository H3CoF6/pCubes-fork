<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrakis Hexahedron 3x3x3</Name>
        <Menu>Other forms\Catalan Solids\Tetrakis Hexahedron\3x3x3</Menu>
        <Menu>Other forms\3x3x3 variants\Catalan\Tetrakis Hexahedron</Menu>
        <Inventor>Rafael Gulluni</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1731</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clIndian := 'CD5C5C';

        clOrange := 'FF6000';
        clCoral  := 'FF7F50';

        clBlue   := '0000FF';
        clNavy   := '000080';

        clGreen  := '008000';
        clLime   := '00FF00';

        clYellow := 'FFFF00';
        clGolden := 'DDBB20';

        clWhite  := 'F0F0F0';
        clGray   := '808080';

        K  := 0.45;
        C0 := K;
        C1 := K * 3 / 2;

        D  := K / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C1" />
                <Add Vector = "  0;  0;-C1" />
                <Add Vector = " C1;  0;  0" />
                <Add Vector = "-C1;  0;  0" />
                <Add Vector = "  0; C1;  0" />
                <Add Vector = "  0;-C1;  0" />
                <Add Vector = " C0; C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0;-C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0; C0;-C0" />
                <Add Vector = "-C0;-C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen " VertexIndexes = "0; 6;10" />
                <Face Color = "clRed   " VertexIndexes = "0;10;12" />
                <Face Color = "clWhite " VertexIndexes = "0;12; 8" />
                <Face Color = "clYellow" VertexIndexes = "0; 8; 6" />
                <Face Color = "clIndian" VertexIndexes = "1; 7; 9" />
                <Face Color = "clLime  " VertexIndexes = "1; 9;13" />
                <Face Color = "clGolden" VertexIndexes = "1;13;11" />
                <Face Color = "clGray  " VertexIndexes = "1;11; 7" />
                <Face Color = "clYellow" VertexIndexes = "2; 6; 8" />
                <Face Color = "clOrange" VertexIndexes = "2; 8; 9" />
                <Face Color = "clIndian" VertexIndexes = "2; 9; 7" />
                <Face Color = "clNavy  " VertexIndexes = "2; 7; 6" />
                <Face Color = "clCoral " VertexIndexes = "3;10;11" />
                <Face Color = "clGolden" VertexIndexes = "3;11;13" />
                <Face Color = "clBlue  " VertexIndexes = "3;13;12" />
                <Face Color = "clRed   " VertexIndexes = "3;12;10" />
                <Face Color = "clNavy  " VertexIndexes = "4; 6; 7" />
                <Face Color = "clGray  " VertexIndexes = "4; 7;11" />
                <Face Color = "clCoral " VertexIndexes = "4;11;10" />
                <Face Color = "clGreen " VertexIndexes = "4;10; 6" />
                <Face Color = "clWhite " VertexIndexes = "5; 8;12" />
                <Face Color = "clBlue  " VertexIndexes = "5;12;13" />
                <Face Color = "clLime  " VertexIndexes = "5;13; 9" />
                <Face Color = "clOrange" VertexIndexes = "5; 9; 8" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
