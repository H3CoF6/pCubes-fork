    <Script>
        Colors[ 0] := 'F0F0F0'; // White      
        Colors[ 1] := 'C0C0C0'; // Silver     
        Colors[ 2] := '808080'; // Gray       
        Colors[ 3] := '202020'; // Black      
        Colors[ 4] := '00FFFF'; // Cyan       
        Colors[ 5] := '008080'; // Teal       
        Colors[ 6] := '0000FF'; // Blue       
        Colors[ 7] := '000080'; // Navy       
        Colors[ 8] := 'FF0000'; // Red        
        Colors[ 9] := '800000'; // Brown      
        Colors[10] := 'FF7F50'; // Coral      
        Colors[11] := 'CD5C5C'; // Indian     
        Colors[12] := 'FFFF00'; // Yellow     
        Colors[13] := '808000'; // Olive      
        Colors[14] := 'FF6000'; // Orange     
        Colors[15] := 'DDBB20'; // Golden     
        Colors[16] := '00FF00'; // Lime       
        Colors[17] := '008000'; // Green      
        Colors[18] := '006400'; // DarkGreen  
        Colors[19] := 'ADFF2F'; // GreenYellow
        Colors[20] := 'FF00FF'; // Fuchsia    
        Colors[21] := '800080'; // Purple     
        Colors[22] := 'FF69B4'; // Pink       
        Colors[23] := 'DB7093'; // Pale       

        clBody := '-1';

        K  := 0.5;

        K1 := (6 * (9 + sqrt(33)))^(1/3);
        K2 := (6 * (9 - sqrt(33)))^(1/3);
        K3 := (2 * (1777 + 33*sqrt(33)))^(1/3);
        K4 := (2 * (1777 - 33*sqrt(33)))^(1/3);

        C0 := K * sqrt(6 * (-6 + K1 + K2)) / 12;
        C1 := K * sqrt(6 * ( 6 + K1 + K2)) / 12;
        C2 := K * sqrt(6 * (18 + K1 + K2)) / 12;
        C3 := K * sqrt(6 * (14 + K3 + K4)) / 12;

        n1 := (c1 - c0)^2;
        n2 := (c1 - c2)^2;
        n3 := (c1 - c2) * (c0 - c1);

        bgx := -n2*n3 + n1^2;
        bgy :=  n1*n2 - n3^2;
        bgz := -n1*n3 + n2^2;

        byx := -n2^2 + n1*n3;
        byy :=  n1^2 - n2*n3;
        byz := -n3^2 + n1*n2;

        A1 := ArcCos((bgx*byx + bgy*byy + bgz*byz) / (bgx^2 + bgy^2 + bgz^2));
        A2 := 2 * Pi - 4 * A1;
        A3 := 2 * A1;
        A4 := 3 * A1;

        D  := 1.055 * K;

        DCut := D * sqrt(n1^2 + n2^2 + n3^2) / n1;
    </Script>

