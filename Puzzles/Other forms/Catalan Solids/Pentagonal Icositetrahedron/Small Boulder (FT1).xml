<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Small Boulder (Pentagonal Icositetrahedron FT1)</Name>
        <Menu>Other forms\Catalan Solids\Pentagonal Icositetrahedron\Small Boulder (FT1)</Menu>
        <Inventor>Ryan Binter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2553</Link>
    </Interface>

    <Script>
        clWhite        := 'F0F0F0';
        clSilver       := 'C0C0C0';
        clGray         := '808080';
        clBlack        := '202020';

        clCyan         := '00FFFF';
        clTeal         := '008080';
        clBlue         := '0000FF';
        clNavy         := '000080';

        clRed          := 'FF0000';
        clBrown        := '800000';
        clCoral        := 'FF7F50';
        clIndian       := 'CD5C5C';

        clYellow       := 'FFFF00';
        clOlive        := '808000';
        clOrange       := 'FF6000';
        clGolden       := 'DDBB20';

        clLime         := '00FF00';
        clGreen        := '008000';
        clDarkGreen    := '006400';
        clGreenYellow  := 'ADFF2F';

        clFuchsia      := 'FF00FF';
        clPurple       := '800080';
        clPink         := 'FF69B4';
        clPale         := 'DB7093';

        K  := 0.5;

        K1 := (6 * (9 + sqrt(33)))^(1/3);
        K2 := (6 * (9 - sqrt(33)))^(1/3);
        K3 := (2 * (1777 + 33*sqrt(33)))^(1/3);
        K4 := (2 * (1777 - 33*sqrt(33)))^(1/3);

        C0 := K * sqrt(6 * (-6 + K1 + K2)) / 12;
        C1 := K * sqrt(6 * ( 6 + K1 + K2)) / 12;
        C2 := K * sqrt(6 * (18 + K1 + K2)) / 12;
        C3 := K * sqrt(6 * (14 + K3 + K4)) / 12;

        n1 := (c1 - c0)^2;
        n2 := (c1 - c2)^2;
        n3 := (c1 - c2) * (c0 - c1);

        bgx := -n2*n3 + n1^2;
        bgy :=  n1*n2 - n3^2;
        bgz := -n1*n3 + n2^2;

        byx := -n2^2 + n1*n3;
        byy :=  n1^2 - n2*n3;
        byz := -n3^2 + n1*n2;

        A1 := ArcCos((bgx*byx + bgy*byy + bgz*byz) / (bgx^2 + bgy^2 + bgz^2));
        A2 := 2 * Pi - 4 * A1;
        A3 := 2 * A1;
        A4 := 3 * A1;

        D  := K;
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A4; -A3; -A2; -A1; 0; A1; A2; A3; A4" PlaneDistances = "D">
        <Axis NormVector = " n2; n3;  n1" />
        <Axis NormVector = " n3;-n2;  n1" />
        <Axis NormVector = "-n2;-n3;  n1" />
        <Axis NormVector = "-n3; n2;  n1" />

        <Axis NormVector = "-n2; n3; -n1" />
        <Axis NormVector = "-n3;-n2; -n1" />
        <Axis NormVector = " n2;-n3; -n1" />
        <Axis NormVector = " n3; n2; -n1" />

        <Axis NormVector = "-n2;  n1; n3" />
        <Axis NormVector = " n2;  n1;-n3" />
        <Axis NormVector = "-n3;  n1;-n2" />
        <Axis NormVector = " n3;  n1; n2" />

        <Axis NormVector = "-n3; -n1; n2" />
        <Axis NormVector = " n3; -n1;-n2" />
        <Axis NormVector = "-n2; -n1;-n3" />
        <Axis NormVector = " n2; -n1; n3" />

        <Axis NormVector = " -n1; n3; n2" />
        <Axis NormVector = " -n1;-n3;-n2" />
        <Axis NormVector = " -n1;-n2; n3" />
        <Axis NormVector = " -n1; n2;-n3" />

        <Axis NormVector = "  n1;-n3; n2" />
        <Axis NormVector = "  n1; n3;-n2" />
        <Axis NormVector = "  n1;-n2;-n3" />
        <Axis NormVector = "  n1; n2; n3" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;    0;  -C3" />
                <Add Vector = "  0;    0;   C3" />
                <Add Vector = "-C3;    0;    0" />
                <Add Vector = " C3;    0;    0" />
                <Add Vector = "  0;  -C3;    0" />
                <Add Vector = "  0;   C3;    0" />
                <Add Vector = "-C1;   C0;  -C2" />
                <Add Vector = "-C1;  -C0;   C2" />
                <Add Vector = " C1;  -C0;  -C2" />
                <Add Vector = " C1;   C0;   C2" />
                <Add Vector = "-C2;   C1;  -C0" />
                <Add Vector = "-C2;  -C1;   C0" />
                <Add Vector = " C2;  -C1;  -C0" />
                <Add Vector = " C2;   C1;   C0" />
                <Add Vector = "-C0;   C2;  -C1" />
                <Add Vector = "-C0;  -C2;   C1" />
                <Add Vector = " C0;  -C2;  -C1" />
                <Add Vector = " C0;   C2;   C1" />
                <Add Vector = "-C0;  -C1;  -C2" />
                <Add Vector = "-C0;   C1;   C2" />
                <Add Vector = " C0;   C1;  -C2" />
                <Add Vector = " C0;  -C1;   C2" />
                <Add Vector = "-C2;  -C0;  -C1" />
                <Add Vector = "-C2;   C0;   C1" />
                <Add Vector = " C2;   C0;  -C1" />
                <Add Vector = " C2;  -C0;   C1" />
                <Add Vector = "-C1;  -C2;  -C0" />
                <Add Vector = "-C1;   C2;   C0" />
                <Add Vector = " C1;   C2;  -C0" />
                <Add Vector = " C1;  -C2;   C0" />
                <Add Vector = "-C1;  -C1;  -C1" />
                <Add Vector = "-C1;  -C1;   C1" />
                <Add Vector = "-C1;   C1;  -C1" />
                <Add Vector = "-C1;   C1;   C1" />
                <Add Vector = " C1;  -C1;  -C1" />
                <Add Vector = " C1;  -C1;   C1" />
                <Add Vector = " C1;   C1;  -C1" />
                <Add Vector = " C1;   C1;   C1" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"       VertexIndexes = "0; 18; 30; 22;  6" />
                <Face Color = "clSilver"      VertexIndexes = "0;  8; 34; 16; 18" />
                <Face Color = "clGray"        VertexIndexes = "0; 20; 36; 24;  8" />
                <Face Color = "clBlack"       VertexIndexes = "0;  6; 32; 14; 20" />
                <Face Color = "clCyan"        VertexIndexes = "1; 19; 33; 23;  7" />
                <Face Color = "clTeal"        VertexIndexes = "1;  9; 37; 17; 19" />
                <Face Color = "clBlue"        VertexIndexes = "1; 21; 35; 25;  9" />
                <Face Color = "clNavy"        VertexIndexes = "1;  7; 31; 15; 21" />
                <Face Color = "clRed"         VertexIndexes = "2; 23; 33; 27; 10" />
                <Face Color = "clBrown"       VertexIndexes = "2; 11; 31;  7; 23" />
                <Face Color = "clCoral"       VertexIndexes = "2; 22; 30; 26; 11" />
                <Face Color = "clIndian"      VertexIndexes = "2; 10; 32;  6; 22" />
                <Face Color = "clYellow"      VertexIndexes = "3; 25; 35; 29; 12" />
                <Face Color = "clOlive"       VertexIndexes = "3; 13; 37;  9; 25" />
                <Face Color = "clOrange"      VertexIndexes = "3; 24; 36; 28; 13" />
                <Face Color = "clGolden"      VertexIndexes = "3; 12; 34;  8; 24" />
                <Face Color = "clLime"        VertexIndexes = "4; 29; 35; 21; 15" />
                <Face Color = "clGreen"       VertexIndexes = "4; 16; 34; 12; 29" />
                <Face Color = "clDarkGreen"   VertexIndexes = "4; 26; 30; 18; 16" />
                <Face Color = "clGreenYellow" VertexIndexes = "4; 15; 31; 11; 26" />
                <Face Color = "clFuchsia"     VertexIndexes = "5; 28; 36; 20; 14" />
                <Face Color = "clPurple"      VertexIndexes = "5; 17; 37; 13; 28" />
                <Face Color = "clPink"        VertexIndexes = "5; 27; 33; 19; 17" />
                <Face Color = "clPale"        VertexIndexes = "5; 14; 32; 10; 27" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
