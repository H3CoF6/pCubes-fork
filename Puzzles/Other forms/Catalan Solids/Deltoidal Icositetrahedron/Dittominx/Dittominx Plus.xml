    <Script>
        Colors[ 0] := '0099FF'; // LightBlue
        Colors[ 1] := '008800'; // Green
        Colors[ 2] := 'FFFFFF'; // White
        Colors[ 3] := 'FF6600'; // Orange
        Colors[ 4] := 'BB00BB'; // Purple
        Colors[ 5] := '0011FF'; // Blue
        Colors[ 6] := 'BB0022'; // Brown
        Colors[ 7] := 'BBBBBB'; // Silver
        Colors[ 8] := 'FF2299'; // Pink
        Colors[ 9] := 'DDBB20'; // Golden
        Colors[10] := 'FF0000'; // Red
        Colors[11] := 'FFFF00'; // Yellow

        W  := 0.45;
        include 'Figures\Scripts\Deltoidal Icositetrahedron_Coordinates.inc';

        pillow := sqrt(2) - 1/3;
        for i := 0 to 23 do begin
            Cx[i] := Cx[i] * pillow;
            Cy[i] := Cy[i] * pillow;
            Cz[i] := Cz[i] * pillow;
        end;

        D1 := (Cx[0] + Cy[0] + Cz[0]) / sqrt(3);
        D2 := Cz[0];
    </Script>

    <Axes TurningAngles = "2*Pi/3; 0; 2*Pi/3" PlaneDistances = "-D1; D1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
    </Axes>

    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D2; D2" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2; 0; Pi/2" PlaneDistances = "-D2; D2" >
