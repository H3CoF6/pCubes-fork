<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Behemoth</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Behemoth</Menu>
        <Inventor>Ben Streeter</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-08-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7656</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?t=34910</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        K  := 0.38;

        C0 := K;
        C1 := K * 5/3;
        C2 := K * 5/4;

        A1 := ArcCos(19/30);
        A2 := ArcCos( 7/18);
        A3 := ArcCos(-1/10);
        A4 := ArcCos(-7/15);
        A5 := ArcCos(-5/6 );
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A5;-A4;-A3;-A2;-A1; 0; A1; A2; A3; A4; A5" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1; 1; 3" />
        <Axis NormVector = "-1; 1; 3" />
        <Axis NormVector = " 1;-1; 3" />
        <Axis NormVector = "-1;-1; 3" />
        <Axis NormVector = " 1; 3; 1" />
        <Axis NormVector = "-1; 3; 1" />
        <Axis NormVector = " 1; 3;-1" />
        <Axis NormVector = "-1; 3;-1" />
        <Axis NormVector = " 3; 1; 1" />
        <Axis NormVector = " 3;-1; 1" />
        <Axis NormVector = " 3; 1;-1" />
        <Axis NormVector = " 3;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C1" />
                <Add Vector = "  0;  0;-C1" />
                <Add Vector = " C1;  0;  0" />
                <Add Vector = "-C1;  0;  0" />
                <Add Vector = "  0; C1;  0" />
                <Add Vector = "  0;-C1;  0" />
                <Add Vector = " C2;  0; C2" />
                <Add Vector = " C2;  0;-C2" />
                <Add Vector = "-C2;  0; C2" />
                <Add Vector = "-C2;  0;-C2" />
                <Add Vector = " C2; C2;  0" />
                <Add Vector = " C2;-C2;  0" />
                <Add Vector = "-C2; C2;  0" />
                <Add Vector = "-C2;-C2;  0" />
                <Add Vector = "  0; C2; C2" />
                <Add Vector = "  0; C2;-C2" />
                <Add Vector = "  0;-C2; C2" />
                <Add Vector = "  0;-C2;-C2" />
                <Add Vector = " C0; C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0;-C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0; C0;-C0" />
                <Add Vector = "-C0;-C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0;  6; 18; 14" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 0; 14; 22;  8" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0;  8; 24; 16" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 0; 16; 20;  6" />
                <Face Color = "Colors[ 4]" VertexIndexes = " 1;  9; 23; 15" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 1; 15; 19;  7" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 1;  7; 21; 17" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 1; 17; 25;  9" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 2;  7; 19; 10" />
                <Face Color = "Colors[ 9]" VertexIndexes = " 2; 10; 18;  6" />
                <Face Color = "Colors[10]" VertexIndexes = " 2;  6; 20; 11" />
                <Face Color = "Colors[11]" VertexIndexes = " 2; 11; 21;  7" />
                <Face Color = "Colors[12]" VertexIndexes = " 3;  8; 22; 12" />
                <Face Color = "Colors[13]" VertexIndexes = " 3; 12; 23;  9" />
                <Face Color = "Colors[14]" VertexIndexes = " 3;  9; 25; 13" />
                <Face Color = "Colors[15]" VertexIndexes = " 3; 13; 24;  8" />
                <Face Color = "Colors[16]" VertexIndexes = " 4; 10; 19; 15" />
                <Face Color = "Colors[17]" VertexIndexes = " 4; 15; 23; 12" />
                <Face Color = "Colors[18]" VertexIndexes = " 4; 12; 22; 14" />
                <Face Color = "Colors[19]" VertexIndexes = " 4; 14; 18; 10" />
                <Face Color = "Colors[20]" VertexIndexes = " 5; 11; 20; 16" />
                <Face Color = "Colors[21]" VertexIndexes = " 5; 16; 24; 13" />
                <Face Color = "Colors[22]" VertexIndexes = " 5; 13; 25; 17" />
                <Face Color = "Colors[23]" VertexIndexes = " 5; 17; 21; 11" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
