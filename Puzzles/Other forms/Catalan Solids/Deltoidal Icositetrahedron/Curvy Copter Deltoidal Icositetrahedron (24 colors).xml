    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W  := 0.45;
        include 'Figures\Scripts\Deltoidal Icositetrahedron_Coordinates.inc';

        for i := 0 to 11 do begin // axes
            Ax[i] := Vx[i + 6];
            Ay[i] := Vy[i + 6];
            Az[i] := Vz[i + 6];
        end;

        pillow := 1.1;
        for i := 0 to 23 do begin // pillow
            Cx[i] := Cx[i] * pillow;
            Cy[i] := Cy[i] * pillow;
            Cz[i] := Cz[i] * pillow;
        end;

        D := W;

        JumAngle := Arccos(1/3);
    </Script>

