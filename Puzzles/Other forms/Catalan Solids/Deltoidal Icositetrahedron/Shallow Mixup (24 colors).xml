<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Shallow Mixup (24 colors)</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Shallow Mixup (24 colors)</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7947</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W  := 0.45;
        D := W * (12 + 2 * sqrt(2)) / 17 * 3 / 4;
        RC := 0.105;
    </Script>

    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitEdge1" >
            <Hide><Plane NormVector = " 1;0;0" NormDistance = "-D" /> </Hide>
            <Hide><Plane NormVector = "-1;0;0" NormDistance = "-D" /> </Hide>
            <Split><Plane NormVector = "0;0;1" NormDistance = "D" /> </Split>
            <Split><Plane NormVector = "0;-1;0" NormDistance = "D" /> </Split>
            <Hide><Plane NormVector = "0;0;1" NormDistance = "D" /> </Hide>
            <Hide><Plane NormVector = "0;-1;0" NormDistance = "D" /> </Hide>
            <Turn NormVector = "1;0;0" Angle = "-Pi/4" />
            <Turn NormVector = "0;1;0" Angle = " Pi/4" />
            <Split><Plane NormVector = "0;0;1" NormDistance = "D" /> </Split>
            <Hide><Plane NormVector = " 0;0;-1" NormDistance = "-D" /> </Hide>
            <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
            <Cut><Plane NormVector = "1;0;0" NormDistance = "D" /> </Cut>
            <Cut><Plane NormVector = "0;-1;0" NormDistance = "D" /> </Cut>
            <Turn NormVector = "0;0;1" Angle = " Pi/4" />
            <Turn NormVector = "0;1;0" Angle = "-Pi/4" />
            <ShowAll/>
            <RemoveGrayParts/>
        </Macro>
        <Macro Name = "SplitEdge2" >
            <ExecMacro MacroName = "SplitEdge1" Repeat = "8" />
            <Turn NormVector = "0;0;1" Angle = " Pi" />
        </Macro>
        <Macro Name = "SplitEdge3" >
            <ExecMacro MacroName = "SplitEdge2" Repeat = "4" />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "SplitEdge3" Repeat = "3" />

        <Macro Name = "RemoveCenter" >
            <RemoveContaining Vector = " Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenter" i = "0" Repeat = "24" />

        <Macro Name = "AddCircle" >
            <Circle Radius = "RC" Color = "Colors[i]" Center = " Cx[i]; Cy[i]; Cz[i]" />
            <Script> Inc(i); </Script>
        </Macro>
        <ExecMacro MacroName = "AddCircle" i = "0" Repeat = "24" />
    </Figure>
</xml>
