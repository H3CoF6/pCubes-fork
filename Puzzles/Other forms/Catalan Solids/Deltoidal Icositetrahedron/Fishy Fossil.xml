<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fishy Fossil</Name>
        <Alias>Pseudo FTDI+</Alias>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Fishy Fossil</Menu>
        <Inventor>Ian Henriksen</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-09-10</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11957</Link>
    </Interface>


    <Script>
        clWhite       := 'F0F0F0';
        clSilver      := 'C0C0C0';
        clGray        := '808080';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clRed         := 'FF0000';
        clBrown       := '800000';
        clCoral       := 'FF7F50';
        clIndian      := 'CD5C5C';

        clYellow      := 'FFFF00';
        clOlive       := '808000';
        clOrange      := 'FF6000';
        clGolden      := 'DDBB20';

        clLime        := '00FF00';
        clGreen       := '008000';
        clDarkGreen   := '006400';
        clGreenYellow := 'ADFF2F';

        clFuchsia     := 'FF00FF';
        clPurple      := '800080';
        clPink        := 'FF69B4';
        clPale        := 'DB7093';

        K  := 0.45;

// Gyrate Deltoidal Icositetrahedron

        s2 := sqrt(2);
        s3 := s2 + 1;
        s4 := s2 - 2;

        C0 := K * s2 / 2           ; // 0.7071
        C1 := K * (4 + s2) / 7     ; // 0.7735
        C2 := K * (2 + 4 * s2) / 7 ; // 1.0938
        C3 := K * s2               ; // 1.4142
        C4 := K;

        // Jumble Angles
        A1 := Arccos(-(2 - s2) / 4);
        A2 := A1*2;
        A3 := Arccos((2 + s2) / 8);

        D := K * (3 / 2 + s2) / sqrt(5 + 2 * s2);
        
        S := (C3 + C4) / 2;
        T :=  C4 / 2;
        U := (C1 + C4) / 2;
        V :=  C1 / 2;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3 " PlaneDistances = "D"  FixedLayers = "0" >
        <Axis NormVector = "  0; s2; s3" />
        <Axis NormVector = "-s2;  0; s3" />
        <Axis NormVector = "  0;-s2; s3" />
        <Axis NormVector = " s2;  0; s3" />
        <Axis NormVector = "  1; -1;-s3" />
        <Axis NormVector = " -1; -1;-s3" />
        <Axis NormVector = " -1;  1;-s3" />
        <Axis NormVector = "  1;  1;-s3" />
    </Axes>
    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3 " PlaneDistances = "-D;D"  FixedLayers = "1" >
        <Axis NormVector = " s3; -1;  1" />
        <Axis NormVector = " s3; -1; -1" />
        <Axis NormVector = " s3;  1; -1" />
        <Axis NormVector = " s3;  1;  1" />
        <Axis NormVector = " -1;-s3;  1" />
        <Axis NormVector = " -1;-s3; -1" />
        <Axis NormVector = "  1;-s3; -1" />
        <Axis NormVector = "  1;-s3;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  0; C3" />
                <Add Vector = "  0;  0;-C3" />
                <Add Vector = " C3;  0;  0" />
                <Add Vector = "-C3;  0;  0" />
                <Add Vector = "  0; C3;  0" />
                <Add Vector = "  0;-C3;  0" />
                <Add Vector = "  0; C2; C1" />
                <Add Vector = "  0;-C2; C1" />
                <Add Vector = " C2;  0; C1" />
                <Add Vector = "-C2;  0; C1" />
                <Add Vector = " C4;  0;-C4" />
                <Add Vector = "-C4;  0;-C4" />
                <Add Vector = " C4; C4;  0" />
                <Add Vector = " C4;-C4;  0" />
                <Add Vector = "-C4; C4;  0" />
                <Add Vector = "-C4;-C4;  0" />
                <Add Vector = "  0; C4;-C4" />
                <Add Vector = "  0;-C4;-C4" />
                <Add Vector = " C0; C0; C4" />
                <Add Vector = " C0;-C0; C4" />
                <Add Vector = "-C0; C0; C4" />
                <Add Vector = "-C0;-C0; C4" />
                <Add Vector = " C1; C1;-C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = "-C1;-C1;-C1" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"       VertexIndexes = " 0;18; 6;20" />
                <Face Color = "clSilver"      VertexIndexes = " 0;20; 9;21" />
                <Face Color = "clGray"        VertexIndexes = " 0;21; 7;19" />
                <Face Color = "clBlack"       VertexIndexes = " 0;19; 8;18" />
                <Face Color = "clCyan"        VertexIndexes = " 1;10;23;17" />
                <Face Color = "clTeal"        VertexIndexes = " 1;17;25;11" />
                <Face Color = "clBlue"        VertexIndexes = " 1;11;24;16" />
                <Face Color = "clNavy"        VertexIndexes = " 1;16;22;10" />
                <Face Color = "clRed"         VertexIndexes = " 2; 8;19;13" />
                <Face Color = "clBrown"       VertexIndexes = " 2;13;23;10" />
                <Face Color = "clCoral"       VertexIndexes = " 2;10;22;12" />
                <Face Color = "clIndian"      VertexIndexes = " 2;12;18; 8" />
                <Face Color = "clYellow"      VertexIndexes = " 3; 9;20;14" />
                <Face Color = "clOlive"       VertexIndexes = " 3;14;24;11" />
                <Face Color = "clOrange"      VertexIndexes = " 3;11;25;15" />
                <Face Color = "clGolden"      VertexIndexes = " 3;15;21; 9" />
                <Face Color = "clLime"        VertexIndexes = " 4; 6;18;12" />
                <Face Color = "clGreen"       VertexIndexes = " 4;12;22;16" />
                <Face Color = "clDarkGreen"   VertexIndexes = " 4;16;24;14" />
                <Face Color = "clGreenYellow" VertexIndexes = " 4;14;20; 6" />
                <Face Color = "clFuchsia"     VertexIndexes = " 5; 7;21;15" />
                <Face Color = "clPurple"      VertexIndexes = " 5;15;25;17" />
                <Face Color = "clPink"        VertexIndexes = " 5;17;23;13" />
                <Face Color = "clPale"        VertexIndexes = " 5;13;19; 7" />
            </Faces>
        </Part>
        
        <Macro Name = "Split1">
            <HideContaining Vector = " 0; S;-T" />
            <HideContaining Vector = " 0;-S;-T" />
            <HideContaining Vector = " 0; T;-S" />
            <HideContaining Vector = " 0;-T;-S" />
            <InvertVisibility/>
            <Turn NormVector = " 0; 1; 1" Angle = " Pi/2" />
            <Split> <Plane NormVector = " s3; -1; -1" NormDistance = " D" /> </Split>
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " 0;-1; 1" Angle = " Pi/4" />
            <Split> <Plane NormVector = " s3; -1; -1" NormDistance = " D" /> </Split>
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " 0;-1; 1" Angle = " Pi/4" />
            <Split> <Plane NormVector = " s3; -1; -1" NormDistance = " D" /> </Split>
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " 0;-1; 1" Angle = " Pi/4" />
            <Split> <Plane NormVector = " s3; -1; -1" NormDistance = " D" /> </Split>
            <Turn NormVector = " 0;-1; 1" Angle = "-Pi" />
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " 0;-1; 1" Angle = " Pi/4" />
            <Turn NormVector = " 0; 1; 1" Angle = "-Pi/2" />
            <ShowAll/>
        </Macro>
        
        <Macro Name = "Split2" >
            <HideContaining Vector = "-U;-U;-V" />
            <HideContaining Vector = "-U;-V;-U" />
            <HideContaining Vector = "-V;-U;-U" />
            <InvertVisibility/>
            <Turn NormVector = " 0; 0; 1" Angle = " Pi/4" />
            <Turn NormVector = " 0;-1;-1" Angle = " Pi/2" />
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " s4;-s3;-s3" Angle = "2*Pi/3" />
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " s4;-s3;-s3" Angle = "2*Pi/3" />
            <Split> <Plane NormVector = " s3;  1;  1" NormDistance = "-D" /> </Split>
            <Turn NormVector = " s4;-s3;-s3" Angle = "2*Pi/3" />
            <Turn NormVector = "  0; -1; -1" Angle = "-Pi/2" />
            <Turn NormVector = "  0;  0;  1" Angle = "-Pi/4" />
            <ShowAll/>
        </Macro>
        
        <SplitByAxes/>
        
        <ExecMacro MacroName = "Split1" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split1" />
        <Turn NormVector = " 1; 0; 0" Angle = " Pi" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/4" />
        <ExecMacro MacroName = "Split1" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split1" />
        <Turn NormVector = " 0; 0; 1" Angle = "-3*Pi/4" />
        <Turn NormVector = " 1; 0; 0" Angle = " Pi" />
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/2" />
        <Turn NormVector = " 0; 1; 0" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split1" />
        <Turn NormVector = " 0; 1; 0" Angle = " Pi" />
        <ExecMacro MacroName = "Split1" />
        <Turn NormVector = " 0; 1; 0" Angle = " Pi/2" />
        
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 1; 0" Angle = " Pi" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/4" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/2" />
        <ExecMacro MacroName = "Split2" />
        <Turn NormVector = " 0; 1; 0" Angle = " Pi" />
        <Turn NormVector = " 0; 0; 1" Angle = " Pi/4" />
    </Figure>
</xml>
