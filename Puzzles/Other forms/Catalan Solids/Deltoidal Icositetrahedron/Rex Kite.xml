<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rex Kite</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Rex Kite</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=880</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W  := 0.45;
        C0 := W * (4 + sqrt(2)) / 7;
        D  := C0 / sqrt(3);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
