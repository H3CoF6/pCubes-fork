<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Copter Deltoidal Icositetrahedron (6 colors)</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Crazy Copter (6 colors)</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-05</Added>
        <Link></Link>
    </Interface>

    <Script>
        Col[0] := '9900EE'; // Purple
        Col[1] := 'FFFF00'; // Yellow
        Col[2] := 'FF8800'; // Orange
        Col[3] := 'FF0000'; // Red
        Col[4] := '00DD00'; // Green
        Col[5] := '0055FF'; // Blue

        for i := 0 to 23 do
            Colors[ i] := Col[i div 4];

        W := 0.45;

        D := W;

        JumAngle := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "JumAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "Ax1" Layers = "0;2" Angle = " A * JumAngle" />
            <Turn Axis = "Ax2" Layers = "0;2" Angle = " B * JumAngle" />
            <Turn Axis = "Ax1" Layers = "0;2" Angle = "-A * JumAngle" />
            <Turn Axis = "Ax2" Layers = "0;2" Angle = "-B * JumAngle" />
            <Split Axis = "6" From  = "1" />
            <Split Axis = "6" From  = "2" />
            <Split Axis = "7" From  = "1" />
            <Split Axis = "7" From  = "2" />
            <Split Axis = "8" From  = "1" />
            <Split Axis = "8" From  = "2" />
            <Undo Repeat = "4" />
        </Macro>

        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "2" A = " 2" B = "-2" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "0" A = " 2" B = "-2" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "2" A = "-2" B = "-2" />
        <ExecMacro MacroName = "Split" Ax1 = "4" Ax2 = "0" A = "-2" B = " 2" />
        <ExecMacro MacroName = "Split" Ax1 = "3" Ax2 = "4" A = "-2" B = " 2" />
        <ExecMacro MacroName = "Split" Ax1 = "1" Ax2 = "5" A = " 2" B = "-2" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
