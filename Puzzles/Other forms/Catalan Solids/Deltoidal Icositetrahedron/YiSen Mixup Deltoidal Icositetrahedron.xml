<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>YiSen Mixup Deltoidal Icositetrahedron</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\YiSen Mixup Deltoidal Icositetrahedron</Menu>
        <Inventor></Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-08-06</Added>
        <Link></Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W := 0.45;

        C0 := W * (4 + sqrt(2)) / 7;
        C1 := W * sqrt(2);
        D := C0/2;
    </Script>
    <Axes TurningAngles = "Pi/2; Pi/4; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />

        <SplitByAxes/>
        <RemoveGrayParts/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo />
        <Turn Axis = "1" Layer = "1" Angle = "Pi/4" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "2" />
    </Figure>
</xml>
