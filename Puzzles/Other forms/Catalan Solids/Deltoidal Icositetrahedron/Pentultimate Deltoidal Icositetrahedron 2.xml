<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentultimate Deltoidal Icositetrahedron 2</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Pentultimate 2</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-04-20</Added>
        <Link></Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W := 0.45;
        sAngle := 2 * Pi / 5;
        phi := (sqrt(5) - 1) / 2; // The golden ratio
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "   0; phi;   1" />
        <Axis NormVector = "   0;-phi;   1" />
        <Axis NormVector = " phi;   1;   0" />
        <Axis NormVector = "-phi;   1;   0" />
        <Axis NormVector = "   1;   0; phi" />
        <Axis NormVector = "   1;   0;-phi" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
