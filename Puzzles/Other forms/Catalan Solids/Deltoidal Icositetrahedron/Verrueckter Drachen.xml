<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Verrueckter Drachen</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Verrueckter Drachen</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5109</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W  := 0.45;

        C0 := W * (4 + sqrt(2)) / 7;
        D  := C0 / sqrt(3);
        D2 := C0 * 1.54;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D2;-D; D" TurnAxesWithLayer = "2" >
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />

        <SplitByAxes/>

        <Split><Plane NormVector = "-1;-1;-1" NormDistance = "D2" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = "D2" /></Split>
        <Split><Plane NormVector = " 1;-1; 1" NormDistance = "D2" /></Split>

        <Connect Axis = "3" Layers = "0;2" />
    </Figure>
</xml>
