<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trigonal Trapezohedron 4x4x4</Name>
        <Menu>Other forms\Trapezohedron\Vertex Turning\Trigonal Trapezohedron 4x4x4</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3765</Link>
    </Interface>

    <Script>
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        R  := 0.4;
        C0 := R / 2;
        C1 := R;
        C2 := R * sqrt(3) / 2;
        H  := R / sqrt(2);

        D := 0.125;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " C2;-C0;H" />
        <Axis NormVector = "  0; C1;H" />
        <Axis NormVector = "-C2;-C0;H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2; -C0;  H" />
                <Add Vector = "-C2; -C0;  H" />
                <Add Vector = "  0;  C1;  H" />
                <Add Vector = " C2;  C0; -H" />
                <Add Vector = "-C2;  C0; -H" />
                <Add Vector = "  0; -C1; -H" />

                <Add Vector = "  0;   0;  H*3" />
                <Add Vector = "  0;   0; -H*3" />
            </Vertices>

            <Faces>
                <Face Color = "clRed"    VertexIndexes = " 0; 6; 1; 5" />
                <Face Color = "clBlue"   VertexIndexes = " 1; 6; 2; 4" />
                <Face Color = "clGreen"  VertexIndexes = " 2; 6; 0; 3" />

                <Face Color = "clOrange" VertexIndexes = " 3; 7; 4; 2" />
                <Face Color = "clCyan"   VertexIndexes = " 4; 7; 5; 1" />
                <Face Color = "clPink"   VertexIndexes = " 5; 7; 3; 0" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
