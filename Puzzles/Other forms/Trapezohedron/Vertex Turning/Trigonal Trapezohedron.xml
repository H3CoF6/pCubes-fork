<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trigonal Trapezohedron</Name>
        <Menu>Other forms\3x3x3 variants\Trigonal Trapezohedron</Menu>
        <Menu>Other forms\Trapezohedron\Vertex Turning\Trigonal Trapezohedron</Menu>
        <Aliases>Octagonal Edges Extended E8A00145C00</Aliases>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3808</Link>
    </Interface>
	
    <Script>
        Colors[0] := 'C80000'; // Red
        Colors[1] := 'FF800A'; // Orange
        Colors[2] := '0000C8'; // Blue
        Colors[3] := '009600'; // Green
        Colors[4] := 'FFFF00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.3;
        D := W / 3;
        DCut := W * 2/3 * sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W * 3" Color = "-1" />
        <Cut Color = "Colors[0]" ><Plane NormVector = " 1;-1; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[1]" ><Plane NormVector = "-1; 1; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[2]" ><Plane NormVector = " 1; 1; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[3]" ><Plane NormVector = "-1;-1; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[4]" ><Plane NormVector = " 0;-1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[5]" ><Plane NormVector = " 0; 1;-1" NormDistance = "-DCut" /></Cut>
        <SplitByAxes/>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D * 3" /> </Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D * 7" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D * 5" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D * 5" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D * 7" /> </Split>
    </Figure>
</xml>
