<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombohedral Skewb II</Name>
        <Menu>Other forms\Trapezohedron\Vertex Turning\Rhombohedral Skewb II</Menu>
        <Menu>Other forms\Skewb variants\Trapezohedron\Rhombohedral Skewb II</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2643</Link>
    </Interface>

    <Script>
        R := 0.4;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        DCut := RSin;
        RCut := R * 1.65;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>
        <Cut Color = "Colors[ 4]" > <Plane NormVector = "-cx[ 0]; -cy[ 0]; -cz[ 0]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 8]" > <Plane NormVector = "-cx[ 2]; -cy[ 2]; -cz[ 2]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 0]" > <Plane NormVector = "-cx[ 3]; -cy[ 3]; -cz[ 3]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 6]" > <Plane NormVector = "-cx[ 7]; -cy[ 7]; -cz[ 7]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "-cx[ 8]; -cy[ 8]; -cz[ 8]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 9]" > <Plane NormVector = "-cx[11]; -cy[11]; -cz[11]" NormDistance = "-DCut" /> </Cut>

        <!-- cut corners for better control -->
        <Cut> <Plane NormVector = " Cx[ 1]; Cy[ 1]; Cz[ 1]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " Cx[ 6]; Cy[ 6]; Cz[ 6]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " Cx[ 4]; Cy[ 4]; Cz[ 4]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " Cx[ 5]; Cy[ 5]; Cz[ 5]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " Cx[ 9]; Cy[ 9]; Cz[ 9]" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " Cx[10]; Cy[10]; Cz[10]" NormDistance = "-RCut" /> </Cut>
    </Figure>
</xml>
