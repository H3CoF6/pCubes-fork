<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>2x2x2 Transform Pyraminx LiuSeLingJing</Name>
        <Menu>Other forms\Trapezohedron\Vertex Turning\2x2x2 Transform Pyraminx LiuSeLingJing</Menu>
        <Inventor>FangShi</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-08-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6472</Link>
    </Interface>

    <Script>
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        R  := 0.4;
        C0 := R / 2;
        C1 := R;
        C2 := R * sqrt(3) / 2;
        H  := R / sqrt(2);
        H2 := H * 2;

        D := R * 1.0;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; 0; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " C2;-C0; H" />
        <Axis NormVector = "-C2;-C0; H" />
        <Axis NormVector = "  0; C1; H" />
        <Axis NormVector = " C2; C0;-H" />
        <Axis NormVector = "-C2; C0;-H" />
        <Axis NormVector = "  0;-C1;-H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2;-C0; H" />
                <Add Vector = "-C2;-C0; H" />
                <Add Vector = "  0; C1; H" />
                <Add Vector = " C2; C0;-H" />
                <Add Vector = "-C2; C0;-H" />
                <Add Vector = "  0;-C1;-H" />

                <Add Vector = "  0;  0; H2" />
                <Add Vector = "  0;  0;-H2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed"    VertexIndexes = " 1; 5; 0" />
                <Face Color = "clRed"    VertexIndexes = " 1; 0; 6" />
                <Face Color = "clBlue"   VertexIndexes = " 2; 4; 1" />
                <Face Color = "clBlue"   VertexIndexes = " 2; 1; 6" />
                <Face Color = "clGreen"  VertexIndexes = " 0; 3; 2" />
                <Face Color = "clGreen"  VertexIndexes = " 0; 2; 6" />

                <Face Color = "clOrange" VertexIndexes = " 4; 2; 3" />
                <Face Color = "clOrange" VertexIndexes = " 4; 3; 7" />
                <Face Color = "clCyan"   VertexIndexes = " 5; 1; 4" />
                <Face Color = "clCyan"   VertexIndexes = " 5; 4; 7" />
                <Face Color = "clPink"   VertexIndexes = " 3; 0; 5" />
                <Face Color = "clPink"   VertexIndexes = " 3; 5; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
