<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentagonal Trapezohedron FT1</Name>
        <Menu>Other forms\Trapezohedron\Face Turning\Pentagonal FT1</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-05-13</Added>
        <Link>http://dmccooey.com/polyhedra/PentagonalTrapezohedron.html</Link>
    </Interface>

    <Script>
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clKhaki  := 'F0E68C';
        clGolden := 'DDBB20';
        clLime   := '00FF00';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        Phi := (sqrt(5) - 1) / 2;

        k  := 0.3;
        C0 := k * Phi;
        C1 := k * (Phi + 1);
        C2 := k * (Phi + 2);
        C3 := k;

        D  := 0;
    </Script>

    <Axes TurningAngles = "2*Pi / 5" PlaneDistances = "-D; D" >
        <Axis NormVector = "   0;  -1;  Phi" />
        <Axis NormVector = "   0;  -1; -Phi" />
        <Axis NormVector = " Phi;   0;   -1" />
        <Axis NormVector = "   1; Phi;    0" />
        <Axis NormVector = " Phi;   0;    1" />
        <Axis NormVector = "   1;-Phi;    0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  C0;  C1" />
                <Add Vector = "  0;  C0; -C1" />
                <Add Vector = "  0; -C0;  C1" />
                <Add Vector = "  0; -C0; -C1" />
                <Add Vector = " C3;  C3;  C3" />
                <Add Vector = " C3;  C3; -C3" />
                <Add Vector = "-C3; -C3;  C3" />
                <Add Vector = "-C3; -C3; -C3" />
                <Add Vector = " C2; -C1;   0" />
                <Add Vector = "-C2;  C1;   0" />
                <Add Vector = " C0;  C1;   0" />
                <Add Vector = "-C0; -C1;   0" />
            </Vertices>

            <Faces>
                <Face Color = "clRed"    VertexIndexes = " 8;  2;  6; 11 " />
                <Face Color = "clGreen"  VertexIndexes = " 8; 11;  7;  3 " />
                <Face Color = "clBlue"   VertexIndexes = " 8;  3;  1;  5 " />
                <Face Color = "clOrange" VertexIndexes = " 8;  5; 10;  4 " />
                <Face Color = "clYellow" VertexIndexes = " 8;  4;  0;  2 " />

                <Face Color = "clLime"   VertexIndexes = " 9;  0;  4; 10 " />
                <Face Color = "clPink"   VertexIndexes = " 9; 10;  5;  1 " />
                <Face Color = "clKhaki"  VertexIndexes = " 9;  1;  3;  7 " />
                <Face Color = "clGolden" VertexIndexes = " 9;  7; 11;  6 " />
                <Face Color = "clCyan"   VertexIndexes = " 9;  6;  2;  0 " />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "4" From = "1" />

        <Turn NormVector = " Phi; 1; 0" Angle = "-Pi / 2" />
    </Figure>
</xml>
