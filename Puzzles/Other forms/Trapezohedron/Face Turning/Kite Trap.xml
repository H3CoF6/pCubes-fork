<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kite Trap</Name>
        <Menu>Other forms\Trapezohedron\Face Turning\Kite Trap</Menu>
        <Inventor>Hyeon Kyu Yee</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-01-21</Added>
        <Link>http://chewiescustomstickers.com/kite-trap.html</Link>
    </Interface>

    <Script>
        Colors[0] := '0099EE'; // LightBlue
        Colors[1] := '00BB00'; // Green    
        Colors[2] := '9922DD'; // Violett  
        Colors[3] := 'FF6000'; // Orange   
        Colors[4] := 'FF77DD'; // Rose     
        Colors[5] := 'FF0000'; // Red      
        Colors[6] := 'FFFF00'; // Yellow   
        Colors[7] := '0055EE'; // Blue     

        R := 0.55;
        H := R * (sqrt(2) + 1) / 2 * 2^0.25;
        z := R * (sqrt(2) - 1) / 2 * 2^0.25;
        az := R / 8^0.25;
        D := R * 0.45;
        DCut := H/2;
        for i := 0 to 7 do begin
            x[i] := R * cos(Pi / 4 * (i + 0.5));
            y[i] := R * sin(Pi / 4 * (i + 0.5));
        end;

        A1 := ArcCos((sqrt(2) - 1) /2);
        A2 := 2 * A1;
        A3 := ArcCos(sqrt(2) - 2);
    </Script>

    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " x[0]; y[0]; az" />
        <Axis NormVector = " x[1]; y[1];-az" />
        <Axis NormVector = " x[2]; y[2]; az" />
        <Axis NormVector = " x[3]; y[3];-az" />
        <Axis NormVector = " x[4]; y[4]; az" />
        <Axis NormVector = " x[5]; y[5];-az" />
        <Axis NormVector = " x[6]; y[6]; az" />
        <Axis NormVector = " x[7]; y[7];-az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0; H" />

                <Add Vector = "x[0]; y[0];-z" />
                <Add Vector = "x[1]; y[1]; z" />
                <Add Vector = "x[2]; y[2];-z" />
                <Add Vector = "x[3]; y[3]; z" />
                <Add Vector = "x[4]; y[4];-z" />
                <Add Vector = "x[5]; y[5]; z" />
                <Add Vector = "x[6]; y[6];-z" />
                <Add Vector = "x[7]; y[7]; z" />

                <Add Vector = "   0;    0;-H" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;6;7;8" />
                <Face Color = "Colors[1]" VertexIndexes = "0;4;5;6" />
                <Face Color = "Colors[2]" VertexIndexes = "0;2;3;4" />
                <Face Color = "Colors[3]" VertexIndexes = "0;8;1;2" />

                <Face Color = "Colors[4]" VertexIndexes = "9;1;8;7" />
                <Face Color = "Colors[5]" VertexIndexes = "9;7;6;5" />
                <Face Color = "Colors[6]" VertexIndexes = "9;5;4;3" />
                <Face Color = "Colors[7]" VertexIndexes = "9;3;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "SplitL">
            <Turn  Axis = "Ax1" Layer = "1" Angle = "-a3" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = " a1" />
            <Split Axis = "Ax3" From  = "1" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-a1" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = " a3" />
        </Macro>

        <ExecMacro MacroName = "SplitL" Ax1 = "0" Ax2 = "2" Ax3 = "3" />
        <ExecMacro MacroName = "SplitL" Ax1 = "2" Ax2 = "4" Ax3 = "5" />
        <ExecMacro MacroName = "SplitL" Ax1 = "4" Ax2 = "6" Ax3 = "7" />
        <ExecMacro MacroName = "SplitL" Ax1 = "6" Ax2 = "0" Ax3 = "1" />
        <ExecMacro MacroName = "SplitL" Ax1 = "3" Ax2 = "1" Ax3 = "0" />
        <ExecMacro MacroName = "SplitL" Ax1 = "5" Ax2 = "3" Ax3 = "2" />
        <ExecMacro MacroName = "SplitL" Ax1 = "7" Ax2 = "5" Ax3 = "4" />
        <ExecMacro MacroName = "SplitL" Ax1 = "1" Ax2 = "7" Ax3 = "6" />

        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /></Hide>
        <Hide><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /></Hide>
        <InvertVisibility/>
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>
