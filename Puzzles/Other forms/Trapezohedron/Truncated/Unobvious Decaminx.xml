<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Unobvious Decaminx</Name>
        <Menu>Other forms\Trapezohedron\Truncated\Unobvious Decaminx</Menu>
        <Inventor>Taras Bereznyak</Inventor>
        <Programmer>Taras Bereznyak</Programmer>
        <Added>2025-01-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12074</Link>
    </Interface>

    <Script>
        Colors[0] := 'A0A0A0';
        Colors[1] := 'FFFF00';
        Colors[2] := 'FF00FF';
        Colors[3] := '00FFFF';
        Colors[4] := 'FF0000';
        Colors[5] := 'FFFFFF';
        Colors[6] := '00FF00';
        Colors[7] := 'FF8000';
        Colors[8] := '008000';
        Colors[9] := '8000FF';

        W := 0.6;
        D := W * 0.6;
        DCut := W * 0.8;

        include 'Figures\Scripts\Math_Solver.inc';
        function Equation_To_Solve(z);
        begin
            Result := 4 * z^4 + 2 * z^3 + 3 * z^2 - 1;
        end;
        Z := Math_Solver_Solve_Equation( 0.4, 0.5); // Z := 0.4584614464029642820; // 4 * z^4 + 2 * z^3 + 3 * z^2 - 1 = 0
        X := sqrt((Z + 1) / 2);                     // X := 0.8539500706724498779; // 16 * x^8 - 28 * x^6 + 21 * x^4 - 8 * x^2 + 1 = 0
        Y := sqrt(1 - X^2 - Z^2);                   // Y := 0.2461348796099808526;

        // for exact computation Ferrari's method may be used:
        // s := 16/3 * ((12 * sqrt(1551) + 405)^(1/3) - (12 * sqrt(1551) - 405)^(1/3)) - 28; // s := 1.33654216515231;
        // z := (sqrt(-s + 176 / sqrt(s) - 84) + sqrt(s) - 2) / 16; // 0.45846...

        include 'Figures\Scripts\Vectors.inc';

        A1 := VectorRotatingAngle( Y,-X, Z,  X, Y, Z,  X,-Y,-Z); // A1 := 1.12249951653949; // A1 = 2*Pi - A2 - A4 = 2*Pi - 2 * A3
        A2 := VectorRotatingAngle( Y,-X, Z, -X,-Y, Z,  X, Y, Z); // A2 := 2.28185636068422;
        A3 := VectorRotatingAngle( Y,-X, Z,  0, 0, 1, -Y,-X,-Z); // A3 := 2.58034289532004; // A2 + A4 = 2 * A3
        A4 := VectorRotatingAngle( Y,-X, Z, -X,-Y, Z,  X,-Y,-Z); // A4 := 2.87882942995588;
    </Script>

    <Axes TurningAngles = "0;2*Pi" AvailableAngles = "-A4;-A3;-A2;-A1; 0; A1; A2; A3; A4" PlaneDistances = "D" >
        <Axis NormVector = " Y;-X; Z" />
        <Axis NormVector = "-X;-Y; Z" />
        <Axis NormVector = "-Y; X; Z" />
        <Axis NormVector = " X; Y; Z" />
        <Axis NormVector = "-Y;-X;-Z" />
        <Axis NormVector = "-X; Y;-Z" />
        <Axis NormVector = " Y; X;-Z" />
        <Axis NormVector = " X;-Y;-Z" />
    </Axes>

    <Axes TurningAngles = "0;Pi/2" PlaneDistances = "D" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 0; 0;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Cut Color = "Colors[0]" > <Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[1]" > <Plane NormVector = " Y; X; Z" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[2]" > <Plane NormVector = "-X; Y; Z" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[3]" > <Plane NormVector = "-Y;-X; Z" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[4]" > <Plane NormVector = " X;-Y; Z" NormDistance = "-DCut" /> </Cut>

        <Cut Color = "Colors[5]" > <Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[6]" > <Plane NormVector = " Y;-X;-Z" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[7]" > <Plane NormVector = "-X;-Y;-Z" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[8]" > <Plane NormVector = "-Y; X;-Z" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[9]" > <Plane NormVector = " X; Y;-Z" NormDistance = "-DCut" /> </Cut>
    </Figure>

    <Macros>
        <Macro Name = "Sc1" >
            <Script>
                ax1 := ax; // 0
                ax2 := (ax + 3) mod 4; // 3
                ax3 := (ax + 2) mod 4 + 4; // 6
                ax4 := (ax + 3) mod 4 + 4; // 7
            </Script>
            <Turn Axis = "ax3" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax4" Layers = "1" Angle = " A4" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A2+A4" />
            <Turn Axis = "ax4" Layers = "1" Angle = "-A4" />
            <Turn Axis = "ax3" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A4" />
            <Turn Axis = "ax3" Layers = "1" Angle = " A2+A4" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A4" />
            <Turn Axis = "ax3" Layers = "1" Angle = " A1" />
        </Macro>
        <Macro Name = "Sc2" >
            <Script>
                ax1 := ax + 4;
                ax2 := (ax + 1) mod 4 + 4;
            </Script>
            <Turn Axis = "ax1" Layers = "1" Angle = "-A3" />
            <Turn Axis = "  9" Layers = "1" Angle = " Pi" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A3" />
            <Turn Axis = "  9" Layers = "1" Angle = " Pi/2" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A3" />
            <Turn Axis = "  9" Layers = "1" Angle = " Pi" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A3" />
            <Turn Axis = "  9" Layers = "1" Angle = "-Pi/2" />
            <Turn Axis = "ax1" Layers = "1" Angle = "-A3" />
            <Turn Axis = "  9" Layers = "1" Angle = " Pi" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A3" />
        </Macro>
        <Macro Name = "Sc12" >
            <ExecMacro MacroName = "Sc1" ax = "Random(4)" />
            <Turn Axis = "  8" Layers = "1" Angle = " 2*Pi * Random" />
            <Turn Axis = "  9" Layers = "1" Angle = " 2*Pi * Random" />
            <ExecMacro MacroName = "Sc2" ax = "Random(4)" />
            <Turn Axis = "  8" Layers = "1" Angle = " 2*Pi * Random" />
            <Turn Axis = "  9" Layers = "1" Angle = " 2*Pi * Random" />
        </Macro>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(6)" Layer = "1" Angle = "Random * 2 * Pi" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Script>
                A1 := 1.12249951653949;
                A2 := 2.28185636068422;
                A3 := 2.58034289532004;
                A4 := 2.87882942995588;
            </Script>
            <ExecMacro MacroName = "Sc12" Repeat = "100" />
            <ExecMacro MacroName = "RandomTurns" Repeat = "1000" />
        </Macro>
    </Macros>
</xml>
