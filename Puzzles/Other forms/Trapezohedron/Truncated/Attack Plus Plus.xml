<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Attack Plus Plus</Name>
        <Menu>Other forms\Trapezohedron\Truncated\Attack Plus Plus</Menu>
        <Inventor>Xing Xu</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-02-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12503</Link>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?p=432003</Link>
    </Interface>

    <Script>
        clYellow    := 'FFFF00';
        clBlue      := '0000A0';
        clOrange    := 'FF6000';
        clRed       := 'FF0000';
        clGreen     := '008000';
        clWhite     := 'FFFFFF';
        clViolett   := '800080';
        clLightBlue := '2868FF';
        clLightGray := 'AAAAAA';
        clDarkGray  := '777777';

        R := 0.55;
        H := R * (sqrt(2) + 1) / 2 * 2^0.25;
        z := R * (sqrt(2) - 1) / 2 * 2^0.25;
        az := R / 8^0.25;

        for i := 0 to 7 do begin
            x[i] := R * cos(Pi / 4 * (i + 0.5));
            y[i] := R * sin(Pi / 4 * (i + 0.5));
        end;

        A1 := ArcCos((sqrt(2) - 1) /2);
        A2 := 2 * A1;
        A3 := ArcCos(sqrt(2) - 2);

        D := R * sqrt(224 + 91 * sqrt(2)) / 42;

        DCut := R * (5 * 2^0.25 - 2^0.75) / 6;
    </Script>

    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" >
        <Axis NormVector = " x[0]; y[0]; az" />
        <Axis NormVector = " x[1]; y[1];-az" />
        <Axis NormVector = " x[2]; y[2]; az" />
        <Axis NormVector = " x[3]; y[3];-az" />
        <Axis NormVector = " x[4]; y[4]; az" />
        <Axis NormVector = " x[5]; y[5];-az" />
        <Axis NormVector = " x[6]; y[6]; az" />
        <Axis NormVector = " x[7]; y[7];-az" />
    </Axes>

    <Axes TurningAngles = " Pi/2; 0; Pi/2" PlaneDistances = "-az; az" >
        <Axis NormVector = "0;0;H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0; H" />

                <Add Vector = "x[0]; y[0];-z" />
                <Add Vector = "x[1]; y[1]; z" />
                <Add Vector = "x[2]; y[2];-z" />
                <Add Vector = "x[3]; y[3]; z" />
                <Add Vector = "x[4]; y[4];-z" />
                <Add Vector = "x[5]; y[5]; z" />
                <Add Vector = "x[6]; y[6];-z" />
                <Add Vector = "x[7]; y[7]; z" />

                <Add Vector = "   0;    0;-H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue     " VertexIndexes = "0;6;7;8" />
                <Face Color = "clGreen    " VertexIndexes = "0;4;5;6" />
                <Face Color = "clRed      " VertexIndexes = "0;2;3;4" />
                <Face Color = "clOrange   " VertexIndexes = "0;8;1;2" />

                <Face Color = "clYellow   " VertexIndexes = "9;1;8;7" />
                <Face Color = "clWhite    " VertexIndexes = "9;7;6;5" />
                <Face Color = "clViolett  " VertexIndexes = "9;5;4;3" />
                <Face Color = "clLightBlue" VertexIndexes = "9;3;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cut Color = "clLightGray"> <Plane NormVector = "0;0;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clDarkGray "> <Plane NormVector = "0;0; 1" NormDistance = "-DCut" /> </Cut>

        <Macro Name = "Split">
            <Turn  Axis = "Ax1" Layer = "1" Angle = " A1" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = " A1" />
            <Turn  Axis = "Ax3" Layer = "1" Angle = " A1" />
            <Turn  Axis = "Ax4" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "Ax3" Layer = "1" Angle = "-A1" />
            <Turn  Axis = "Ax4" Layer = "1" Angle = " A1" />
            <Split Axis = "  8" From  = "1" />
            <Split Axis = "  8" From  = "2" />
            <Split Axis = "Ax1" From  = "1" />
            <Split Axis = "Ax3" From  = "1" />
        </Macro>

        <ExecMacro MacroName = "Split" Ax1 = "0" Ax2 = "2" Ax3 = "4" Ax4 = "6" Repeat = "6" />
        <ExecMacro MacroName = "Split" Ax1 = "6" Ax2 = "0" Ax3 = "2" Ax4 = "4" Repeat = "6" />
        <ExecMacro MacroName = "Split" Ax1 = "7" Ax2 = "5" Ax3 = "3" Ax4 = "1" Repeat = "6" />
        <ExecMacro MacroName = "Split" Ax1 = "5" Ax2 = "3" Ax3 = "1" Ax4 = "7" Repeat = "6" />

        <Undo Repeat = "192" />

        <Macro Name = "SplitL">
            <Turn  Axis = "Ax1" Layer = "1" Angle = " A3" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = " A1" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = "-A3" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-A1" />
            <Split Axis = "  8" From  = "1" />
            <Split Axis = "  8" From  = "2" />
            <Undo Repeat = "4" />
        </Macro>

        <ExecMacro MacroName = "SplitL" Ax1 = "6" Ax2 = "4" />
        <ExecMacro MacroName = "SplitL" Ax1 = "4" Ax2 = "2" />
        <ExecMacro MacroName = "SplitL" Ax1 = "2" Ax2 = "0" />
        <ExecMacro MacroName = "SplitL" Ax1 = "0" Ax2 = "6" />
        <ExecMacro MacroName = "SplitL" Ax1 = "1" Ax2 = "3" />
        <ExecMacro MacroName = "SplitL" Ax1 = "3" Ax2 = "5" />
        <ExecMacro MacroName = "SplitL" Ax1 = "5" Ax2 = "7" />
        <ExecMacro MacroName = "SplitL" Ax1 = "7" Ax2 = "1" />

        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "RandomCommutator" >
            <Script>
                Choice := Random(8);
            </Script>

            <Turn Axis = "Pair[ Choice, 0]" Layer = "1" Angle = " A1" />
            <Turn Axis = "Pair[ Choice, 1]" Layer = "1" Angle = "-A1" />
            <Turn Axis = "Pair[ Choice, 0]" Layer = "1" Angle = "-A1" />
            <Turn Axis = "Pair[ Choice, 1]" Layer = "1" Angle = " A1" />
            <Turn Axis = "8" Layer = "Pair[ Choice, 2]" Angle = " Pi / 2 * Random(4)" />
        </Macro>

        <Macro Name = "RandomJumble" >
            <Turn Axis = "Random(8)" Layer = "1" Angle = "(Random(2) * 2 - 1) * A1 * (Random(3) + 1)" />
        </Macro>

        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "many random turns" >
            <Script>
                Pair[0,0] := 0; Pair[0,1] := 2; Pair[0,2] := 2;
                Pair[1,0] := 2; Pair[1,1] := 4; Pair[1,2] := 2;
                Pair[2,0] := 4; Pair[2,1] := 6; Pair[2,2] := 2;
                Pair[3,0] := 6; Pair[3,1] := 0; Pair[3,2] := 2;
                Pair[4,0] := 7; Pair[4,1] := 5; Pair[4,2] := 0;
                Pair[5,0] := 5; Pair[5,1] := 3; Pair[5,2] := 0;
                Pair[6,0] := 3; Pair[6,1] := 1; Pair[6,2] := 0;
                Pair[7,0] := 1; Pair[7,1] := 7; Pair[7,2] := 0;

                A1 := ArcCos((sqrt(2) - 1) /2);
            </Script>
            <ExecMacro MacroName = "RandomCommutator" Repeat = "200" /> <!-- Full Non-Jumbling Scramble -->
            <ExecMacro MacroName = "RandomJumble" Repeat = "200" /> <!-- Jumbling -->
        </Macro>
    </Macros>
</xml>
