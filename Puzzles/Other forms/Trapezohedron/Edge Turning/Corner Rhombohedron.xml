<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corner Rhombohedron</Name>
        <Menu>Other forms\Trapezohedron\Edge Turning\Corner Rhombohedron</Menu>
        <Inventor>A J Lu</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4647</Link>
    </Interface>

    <Script>
        clWhite  := 'FFFFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clYellow := 'FFFF00';

        R  := 0.4;
        C0 := R / 2;
        C1 := R;
        C2 := R * sqrt(3) / 2;
        H  := R / sqrt(2);

        dz := -R * 0.3; // may be changed

        D := dz / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "  0;  C1; H" />
        <Axis NormVector = " C2; -C0; H" />
        <Axis NormVector = "-C2; -C0; H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2; -C0;  H + dz" />
                <Add Vector = "-C2; -C0;  H + dz" />
                <Add Vector = "  0;  C1;  H + dz" />
                <Add Vector = " C2;  C0; -H + dz" />
                <Add Vector = "-C2;  C0; -H + dz" />
                <Add Vector = "  0; -C1; -H + dz" />

                <Add Vector = "  0;   0;  H*3 + dz" />
                <Add Vector = "  0;   0; -H*3 + dz" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = " 0; 6; 1; 5" />
                <Face Color = "clYellow" VertexIndexes = " 1; 6; 2; 4" />
                <Face Color = "clRed   " VertexIndexes = " 2; 6; 0; 3" />

                <Face Color = "clGreen " VertexIndexes = " 3; 7; 4; 2" />
                <Face Color = "clOrange" VertexIndexes = " 4; 7; 5; 1" />
                <Face Color = "clWhite " VertexIndexes = " 5; 7; 3; 0" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />
        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>

    </Figure>

</xml>
