<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Twisted-8</Name>
        <Menu>Other forms\Trapezohedron\Mixed\Twisted-8</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1810</Link>
    </Interface>

    <Script>
        clYellow    := 'FFFF00';
        clBlue      := '0000A0';
        clOrange    := 'FF6000';
        clRed       := 'FF0000';
        clGreen     := '008000';
        clWhite     := 'FFFFFF';
        clViolett   := '800080';
        clLightBlue := '2868FF';

        R := 0.55;
        H := R * (sqrt(2) + 1) / 2 * 2^0.25; // H may be chosen arbitrary, but this formula makes rectangular section

        z := H * (3 - 2 * sqrt(2));

        for i := 0 to 7 do begin
            x[i] := R * cos(Pi / 4 * (i + 0.5));
            y[i] := R * sin(Pi / 4 * (i + 0.5));
        end;

        for i := 0 to 3 do begin
            ax[i] := R * cos(Pi / 4 * i);
            ay[i] := R * sin(Pi / 4 * i);
        end;

        D1 := z;
        D2 := R * sqrt(2 - sqrt(2)) / 2;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D2; D2" FixedLayers = "1"> 
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
        <Axis NormVector = "ax[3]; ay[3]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0;  H" />

                <Add Vector = "x[0]; y[0]; -z" />
                <Add Vector = "x[1]; y[1];  z" />
                <Add Vector = "x[2]; y[2]; -z" />
                <Add Vector = "x[3]; y[3];  z" />
                <Add Vector = "x[4]; y[4]; -z" />
                <Add Vector = "x[5]; y[5];  z" />
                <Add Vector = "x[6]; y[6]; -z" />
                <Add Vector = "x[7]; y[7];  z" />

                <Add Vector = "   0;    0; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue     " VertexIndexes = "0;6;7;8" />
                <Face Color = "clGreen    " VertexIndexes = "0;4;5;6" />
                <Face Color = "clRed      " VertexIndexes = "0;2;3;4" />
                <Face Color = "clOrange   " VertexIndexes = "0;8;1;2" />

                <Face Color = "clYellow   " VertexIndexes = "9;1;8;7" />
                <Face Color = "clWhite    " VertexIndexes = "9;7;6;5" />
                <Face Color = "clViolett  " VertexIndexes = "9;5;4;3" />
                <Face Color = "clLightBlue" VertexIndexes = "9;3;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
