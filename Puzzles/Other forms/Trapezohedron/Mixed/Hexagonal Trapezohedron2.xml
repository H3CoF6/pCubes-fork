<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Hexagonal Trapezohedron 2</Name>
        <Menu>Other forms\Trapezohedron\Mixed\Hexagonal 2</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-05-14</Added>
        <Link>http://dmccooey.com/polyhedra/HexagonalTrapezohedron.html</Link>
    </Interface>

    <Script>
        clRed          := 'FF0000';
        clOrange       := 'FF6000';
        clYellow       := 'FFFF00';
        clGreen        := '008000';
        clBlue         := '0000A0';
        clWhite        := 'FFFFFF';

        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        R := 0.4;
        H := R * (sqrt(3) + 2) / 2;
        z := H * (7 - 4 * sqrt(3));

        for i := 0 to 5 do begin
            x[2 * i] := R * cos(2 * Pi / 6 * i);
            y[2 * i] := R * sin(2 * Pi / 6 * i);
            x[2 * i + 1] := R * cos(2 * Pi / 6 * (i + 0.5));
            y[2 * i + 1] := R * sin(2 * Pi / 6 * (i + 0.5));
        end;

        az := R / (H + z);
        for i := 0 to 5 do begin
            ax[i] := cos(2 * Pi / 6 * i);
            ay[i] := sin(2 * Pi / 6 * i);
        end;

        A1 := ArcCos(-1/4);
        A2 := ArcCos(-7/8);

        D := R / sqrt(60);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A1;A2" PlaneDistances = "-D; D" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " ax[0]; ay[0]; -az" />
        <Axis NormVector = " ax[1]; ay[1]; -az" />
        <Axis NormVector = " ax[2]; ay[2]; -az" />
        <Axis NormVector = " ax[3]; ay[3]; -az" />
        <Axis NormVector = " ax[4]; ay[4]; -az" />
        <Axis NormVector = " ax[5]; ay[5]; -az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0;  H" />
                <Add Vector = "   0;    0; -H" />

                <Add Vector = "x[ 0]; y[ 0];  z" />
                <Add Vector = "x[ 1]; y[ 1]; -z" />
                <Add Vector = "x[ 2]; y[ 2];  z" />
                <Add Vector = "x[ 3]; y[ 3]; -z" />
                <Add Vector = "x[ 4]; y[ 4];  z" />
                <Add Vector = "x[ 5]; y[ 5]; -z" />
                <Add Vector = "x[ 6]; y[ 6];  z" />
                <Add Vector = "x[ 7]; y[ 7]; -z" />
                <Add Vector = "x[ 8]; y[ 8];  z" />
                <Add Vector = "x[ 9]; y[ 9]; -z" />
                <Add Vector = "x[10]; y[10];  z" />
                <Add Vector = "x[11]; y[11]; -z" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow      " VertexIndexes = "0; 2; 3; 4" />
                <Face Color = "clGreen       " VertexIndexes = "0; 4; 5; 6" />
                <Face Color = "clBlue        " VertexIndexes = "0; 6; 7; 8" />
                <Face Color = "clViolett     " VertexIndexes = "0; 8; 9;10" />
                <Face Color = "clRed         " VertexIndexes = "0;10;11;12" />
                <Face Color = "clOrange      " VertexIndexes = "0;12;13; 2" />

                <Face Color = "clLightViolett" VertexIndexes = "1; 5; 4; 3" />
                <Face Color = "clCyan        " VertexIndexes = "1; 7; 6; 5" />
                <Face Color = "clBrown       " VertexIndexes = "1; 9; 8; 7" />
                <Face Color = "clWhite       " VertexIndexes = "1;11;10; 9" />
                <Face Color = "clLightGreen  " VertexIndexes = "1;13;12;11" />
                <Face Color = "clLightBlue   " VertexIndexes = "1; 3; 2;13" />
            </Faces>

        </Part>

        <SplitByAxes/>

        <RemoveGrayParts/>
    </Figure>
</xml>
