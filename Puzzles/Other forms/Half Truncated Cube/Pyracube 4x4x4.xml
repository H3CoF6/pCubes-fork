<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyracube 4x4x4</Name>
        <Menu>Other forms\Half Truncated Cube\Pyracube 4x4x4</Menu>
        <Inventor>Jean-Claude Constantin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-01-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4843</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clYellow := 'FFFF00';
        clBlue   := '0000AF';
        clGreen  := '009000';

        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W / 2;
        DCut := W * 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clGreen"  VertexIndexes = "0;1;3" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "3;2;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "5;4;6" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "6;7;5" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "5;1;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "0;4;5" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "6;2;3" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "3;7;6" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "0;2;6" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "6;4;0" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "3;1;5" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "5;7;3" InvisibleEdges = "4" />
            </Faces>
        </Part>

        <Cut Color = "clRed"    > <Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlue"   > <Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clGreen"  > <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /> </Cut>

        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
        <Turn Axis = "2" Layers = "0-3" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
