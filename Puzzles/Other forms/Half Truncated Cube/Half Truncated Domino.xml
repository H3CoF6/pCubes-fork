<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half Truncated Domino</Name>
        <Menu>Other forms\Half Truncated Cube\Half Truncated Domino</Menu>
        <Inventor>Hidetoshi Takeji</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2509</Link>
    </Interface>

    <Script>
        clBlue               := '0000C8';
        clGreen              := '009600';
        clRed                := 'C80000';
        clOrange             := 'FF800A';
        clYellow             := 'FFFF00';
        clWhite              := 'FFFFFF';
        clPayneGrey          := '536878';
        clPersianBlue        := '1c39bb';
        clWine               := '722f37';
        clBritishRacingGreen := '004225';

        W := 0.5;
        H := W * 2 / 3;
        DCut := W * 4 * sqrt(3) / 9;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = "-W" Y = "-W" Z = "-H" />
                <Vector X = "-W" Y = "-W" Z =  "H" />
                <Vector X = "-W" Y = " W" Z = "-H" />
                <Vector X = "-W" Y = " W" Z =  "H" />
                <Vector X = " W" Y = "-W" Z = "-H" />
                <Vector X = " W" Y = "-W" Z =  "H" />
                <Vector X = " W" Y = " W" Z = "-H" />
                <Vector X = " W" Y = " W" Z =  "H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Cut Color = "clPayneGrey         "> <Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clPersianBlue       "> <Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clWine              "> <Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBritishRacingGreen"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /> </Cut>

    </Figure>
</xml>
