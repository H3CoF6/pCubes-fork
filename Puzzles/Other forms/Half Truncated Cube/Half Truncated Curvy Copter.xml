<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half Truncated Curvy Copter</Name>
        <Menu>Other forms\Half Truncated Cube\Half Truncated Curvy Copter</Menu>
        <Inventor>Gabe Vogt</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-12-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7169</Link>
    </Interface>

    <Script>
        clBlue    := '0000C8';
        clGreen   := '009600';
        clRed     := 'C80000';
        clOrange  := 'FF800A';
        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        clRed1    := 'C66363';
        clYellow1 := 'FFFF7F';
        clGreen1  := '499349';
        clBlue1   := '6363C6';

        W := 0.5;
        D := W / sqrt(2) * 1.07;
        DCut := (3 * W - D * sqrt(2)) / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <SplitByAxes/>

        <HideContaining Vector = "0; 0; 0" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <Cut Color = "clGreen1 " > <Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlue1  " > <Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clYellow1" > <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clRed1   " > <Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /> </Cut>
    </Figure>
</xml>
