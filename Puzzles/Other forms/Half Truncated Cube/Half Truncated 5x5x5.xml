<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half Truncated 5x5x5</Name>
        <Menu>Other forms\Half Truncated Cube\Half Truncated 5x5x5</Menu>
        <Inventor>Gabe Vogt</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-12-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8527</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clGold   := 'EFCC71';

        W := 0.5;
        D1 := W / 5;
        D2 := D1 * 3;

        E := D1;
        F := D2 * 1.1; // pillow
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2;-D1; D1; D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W; W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = "-W;-W;-W" />

                <Add Vector = "-F;-F; F" />
                <Add Vector = "-F; F;-F" />
                <Add Vector = " F;-F;-F" />
                <Add Vector = " F; F; F" />

                <Add Vector = "-W;-W;-E" />
                <Add Vector = "-W; E; W" />
                <Add Vector = " E;-W; W" />

                <Add Vector = "-W; W; E" />
                <Add Vector = "-W;-E;-W" />
                <Add Vector = " E; W;-W" />

                <Add Vector = " W;-W; E" />
                <Add Vector = " W; E;-W" />
                <Add Vector = "-E;-W;-W" />

                <Add Vector = " W; W;-E" />
                <Add Vector = " W;-E; W" />
                <Add Vector = "-E; W; W" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange" VertexIndexes = "0;17;18;1;14;15" />
                <Face Color = "clGreen " VertexIndexes = "0;13;11;2;19;17" />
                <Face Color = "clYellow" VertexIndexes = "0;15;16;3;12;13" />
                <Face Color = "clWhite " VertexIndexes = "1;18;19;2; 9;10" />
                <Face Color = "clBlue  " VertexIndexes = "1;10; 8;3;16;14" />
                <Face Color = "clRed   " VertexIndexes = "2;11;12;3; 8; 9" />

                <Face Color = "clGold  " VertexIndexes = "4; 9; 8" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "4;10; 9" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "4; 8;10" InvisibleEdges = "5" />

                <Face Color = "clGold  " VertexIndexes = "5;12;11" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "5;13;12" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "5;11;13" InvisibleEdges = "5" />

                <Face Color = "clGold  " VertexIndexes = "6;15;14" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "6;16;15" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "6;14;16" InvisibleEdges = "5" />

                <Face Color = "clGold  " VertexIndexes = "7;18;17" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "7;19;18" InvisibleEdges = "5" />
                <Face Color = "clGold  " VertexIndexes = "7;17;19" InvisibleEdges = "5" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
        <Turn Axis = "0" From = "0" To = "4" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
