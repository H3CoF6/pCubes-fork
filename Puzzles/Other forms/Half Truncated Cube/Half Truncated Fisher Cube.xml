<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half Truncated Fisher Cube</Name>
        <Menu>Other forms\Half Truncated Cube\Half Truncated Fisher Cube</Menu>
        <Menu>Other forms\3x3x3 variants\Half Truncated Fisher Cube</Menu>
        <Inventor>Matthew Ray</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2019-08-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3780</Link>
    </Interface>

    <Script>
        clPayneGrey          := '536878';
        clPersianBlue        := '1c39bb';
        clWine               := '722f37';
        clBritishRacingGreen := '004225';

        W := 0.5;
        D := W / 3;
        DCut := W * 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 1; 0" />
        <Axis NormVector = "1;-1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>

        <Cut Color = "clPayneGrey         "> <Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clPersianBlue       "> <Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBritishRacingGreen"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clWine              "> <Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /> </Cut>
    </Figure>
</xml>
