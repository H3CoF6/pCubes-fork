    <!-- Chamfered dodecahedron http://dmccooey.com/polyhedra/ChamferedDodecahedron1.html -->

    <Script>
        K := 0.1;

        s5 := sqrt(5);
        s1 := sqrt(2 * (1 + 1 / s5));
        s2 := 2 * sqrt(1 + 2 / s5);
        s3 := (1 + s5) / 2;

        C0 := K * s3;
        C1 := K * s1;
        C2 := K * (1 + sqrt(2 * (1 - 1 / s5)));
        C3 := K * (s1 + s3);
        C4 := K * (s2 +  1);
        C5 := K * ( 1 + s1 + s3);
        C6 := K * (     s2 + s3);
        C7 := K * ( 1 + s2 + s3);
        C8 := K;

        B1 := K * (1 + s3);
        B2 := K * s3 * 2;
        B3 := K * (1 + s1);

        D := K * (1/s5 + 1);
    </Script>

