<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Masterdoderhombus Truncated</Name>
        <Menu>Other forms\Chamfered\Masterdoderhombus Truncated</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2025-02-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12444</Link>
    </Interface>

    <Script>
        R := 0.7;
        D := R / 2;
        Dcut := R * 0.75;

        clSilver := 'AAAAAA';
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>

        <Cut Color = "clSilver"> <Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clSilver"> <Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clSilver"> <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clSilver"> <Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clSilver"> <Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clSilver"> <Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /> </Cut>
    </Figure>
</xml>
