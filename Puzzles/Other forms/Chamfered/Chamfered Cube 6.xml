<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Chamfered Cube 6</Name>
        <Menu>Other forms\Chamfered\Chamfered Cube 6</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-02-03</Added>
        <Link>http://dmccooey.com/polyhedra/ChamferedCube3.html</Link>
    </Interface>

    <Script>
        clBrown       := '800000';
        clYellow      := 'FFFF00';
        clBlue        := '0000FF';
        clGreen       := '008000';
        clPurple      := '800080';
        clRed         := 'FF0000';
        clGolden      := 'DDBB20';
        clPink        := 'FF69B4';
        clOrange      := 'FF6000';
        clDarkGreen   := '006400';
        clCyan        := '00FFFF';
        clLime        := '00FF00';
        clNavy        := '000080';
        clGreenYellow := 'ADFF2F';
        clCoral       := 'FF7F50';
        clOlive       := '808000';
        clFuchsia     := 'FF00FF';
        clTeal        := '008080';

        K  := 0.2;

// ChamferedCube Cube (canonical)

        C0 := K * (sqrt(3) - 1);
        C1 := K * sqrt(3);
        C2 := K * (sqrt(3) + 1);

        D1 := K * 1.28;
        D2 := K * sqrt(3/2);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1;D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = " 1; 1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C0; C0; C2" />
                <Add Vector = " C0; C0;-C2" />
                <Add Vector = " C0;-C0; C2" />
                <Add Vector = " C0;-C0;-C2" />
                <Add Vector = "-C0; C0; C2" />
                <Add Vector = "-C0; C0;-C2" />
                <Add Vector = "-C0;-C0; C2" />
                <Add Vector = "-C0;-C0;-C2" />
                <Add Vector = " C2; C0; C0" />
                <Add Vector = " C2; C0;-C0" />
                <Add Vector = " C2;-C0; C0" />
                <Add Vector = " C2;-C0;-C0" />
                <Add Vector = "-C2; C0; C0" />
                <Add Vector = "-C2; C0;-C0" />
                <Add Vector = "-C2;-C0; C0" />
                <Add Vector = "-C2;-C0;-C0" />
                <Add Vector = " C0; C2; C0" />
                <Add Vector = " C0; C2;-C0" />
                <Add Vector = " C0;-C2; C0" />
                <Add Vector = " C0;-C2;-C0" />
                <Add Vector = "-C0; C2; C0" />
                <Add Vector = "-C0; C2;-C0" />
                <Add Vector = "-C0;-C2; C0" />
                <Add Vector = "-C0;-C2;-C0" />
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1; C1;-C1" />
                <Add Vector = " C1;-C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1; C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1;-C1;-C1" />
            </Vertices>

            <Faces>
                <Face Color = "clBrown      " VertexIndexes = " 0; 4; 6; 2" />
                <Face Color = "clYellow     " VertexIndexes = " 1; 3; 7; 5" />
                <Face Color = "clBlue       " VertexIndexes = " 8;10;11; 9" />
                <Face Color = "clGreen      " VertexIndexes = "12;13;15;14" />
                <Face Color = "clPurple     " VertexIndexes = "16;17;21;20" />
                <Face Color = "clRed        " VertexIndexes = "18;22;23;19" />
                <Face Color = "clGolden     " VertexIndexes = "24; 0; 2;26;10; 8" />
                <Face Color = "clPink       " VertexIndexes = "24; 8; 9;25;17;16" />
                <Face Color = "clOrange     " VertexIndexes = "24;16;20;28; 4; 0" />
                <Face Color = "clDarkGreen  " VertexIndexes = "27; 3; 1;25; 9;11" />
                <Face Color = "clCyan       " VertexIndexes = "27;11;10;26;18;19" />
                <Face Color = "clLime       " VertexIndexes = "27;19;23;31; 7; 3" />
                <Face Color = "clNavy       " VertexIndexes = "29; 5; 7;31;15;13" />
                <Face Color = "clGreenYellow" VertexIndexes = "29;13;12;28;20;21" />
                <Face Color = "clCoral      " VertexIndexes = "29;21;17;25; 1; 5" />
                <Face Color = "clOlive      " VertexIndexes = "30; 6; 4;28;12;14" />
                <Face Color = "clFuchsia    " VertexIndexes = "30;14;15;31;23;22" />
                <Face Color = "clTeal       " VertexIndexes = "30;22;18;26; 2; 6" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
