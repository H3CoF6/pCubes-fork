<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Extended Skewb Ultimate</Name>
        <Menu>Other forms\Skewb variants\Extended Skewb Ultimate</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3824</Link>
    </Interface>

    <Script>
        R := 0.4;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        DCut := RSin;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[7]; Vy[7]; Vz[7]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>
        <Cut Color = "Colors[ 9]" > <Plane NormVector = "-cx[ 0];-cy[ 0];-cz[ 0]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 6]" > <Plane NormVector = "-cx[ 2];-cy[ 2];-cz[ 2]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "-cx[ 3];-cy[ 3];-cz[ 3]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 0]" > <Plane NormVector = "-cx[ 4];-cy[ 4];-cz[ 4]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 4]" > <Plane NormVector = "-cx[ 8];-cy[ 8];-cz[ 8]" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "Colors[ 3]" > <Plane NormVector = "-cx[11];-cy[11];-cz[11]" NormDistance = "-DCut" /> </Cut>
    </Figure>
</xml>
