<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Prism Skewb</Name>
        <Menu>Other forms\Skewb variants\Double Prism Skewb</Menu>
        <Inventor>Manish Rathod</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2026-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12743</Link>
	</Interface>

    <Script>
        clRed     := 'C80000';
        clRed1    := 'C80001';
        clOrange  := 'FF6000';
        clOrange1 := 'FF6001';
        clBlue    := '0000C8';
        clBlue1   := '0000C9';
        clGreen   := '009600';
        clGreen1  := '009601';
        clYellow  := 'FFFF00';

        X1 := 0.45;
        Z1 := -X1 * 0.45;
        Z2 := Z1 + X1 * sqrt(3);

        // calc alpha so that the plane passes through the vertex
        K := sqrt(2 * (1 + (Z1 / X1)^2));
        alpha := arccos(1 / K) - arccos((1 - Z1 / X1) / K));
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1; 1; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "1;0;0" Angle = "alpha" />

        <Macro Name = "CreateShard" >
            <Part>
                <Vertices>
                    <Vector X = " X1" Y = "-X1" Z = "Z1" />
                    <Vector X = " 0 " Y = "-X1" Z = "Z2" />
                    <Vector X = "-X1" Y = "-X1" Z = "Z1" />
                    <Vector X = " 0"  Y = " 0"  Z = "Z2" />
                </Vertices>

                <Faces>
                    <Face Color = "clFront " VertexIndexes = "0;1;2" />
                    <Face Color = "clLeft  " VertexIndexes = "2;1;3" />
                    <Face Color = "clRight " VertexIndexes = "1;0;3" />
                    <Face Color = "-2"       VertexIndexes = "3;0;2" />
                </Faces>
            </Part>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <ExecMacro MacroName = "CreateShard" clFront = "clRed1"    clLeft = "clGreen"  clRight = "clBlue"   />
        <ExecMacro MacroName = "CreateShard" clFront = "clGreen1"  clLeft = "clOrange" clRight = "clRed"    />
        <ExecMacro MacroName = "CreateShard" clFront = "clOrange1" clLeft = "clBlue"   clRight = "clGreen"  />
        <ExecMacro MacroName = "CreateShard" clFront = "clBlue1"   clLeft = "clRed"    clRight = "clOrange"  />

        <Part>
            <Vertices>
                <Vector X = "-X1" Y = "-X1" Z = "Z1" />
                <Vector X = "-X1" Y = " X1" Z = "Z1" />
                <Vector X = " X1" Y = " X1" Z = "Z1" />
                <Vector X = " X1" Y = "-X1" Z = "Z1" />
                <Vector X = " 0"  Y = " 0"  Z = "Z2" />
            </Vertices>

            <Faces>
                <Face Color = "-2"       VertexIndexes = "0;3;4" />
                <Face Color = "-2"       VertexIndexes = "1;0;4" />
                <Face Color = "-2"       VertexIndexes = "2;1;4" />
                <Face Color = "-2"       VertexIndexes = "3;2;4" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2;3" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
