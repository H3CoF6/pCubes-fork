        clGreenYellow := 'ADFF2F';
        clCoral       := 'FF7F50';
        clOlive       := '808000';
        clFuchsia     := 'FF00FF';
        clTeal        := '008080';

        K  := 0.3;

// Rectified Rhombicuboctahedron (equal edges)

        s2 := sqrt(2);
        s3 := sqrt(3);
        C0 := K * s3 / 3;
        C1 := K * s2 / 2;
        C2 := K * (3 * s2 + 2 * s3) / 6;
        C3 := K * (3 * s2 + 4 * s3) / 6;

        D1 := K * 2.4;
        D2 := K * s2 * (1 + 2 * s3) / 3;
    </Script>

