<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Paraskewb</Name>
        <Menu>Other forms\Skewb variants\Paraskewb</Menu>
        <Inventor>Jean-Claude Constantin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=460</Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clYellow  := 'FFFF00';
        clBlue    := '0000FF';
        clGreen   := '00DD00';

        clYellow1 := 'FFFF80';
        clBlue1   := '8080FF';
        clGreen1  := '80FF80';
        clRed1    := 'FF8080';

        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W / 3;
        RCut := W * 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clBlue"   VertexIndexes = "0;1;3" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "3;2;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "5;4;6" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "6;7;5" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "5;1;0" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "0;4;5" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "6;2;3" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "3;7;6" InvisibleEdges = "4" />
                <Face Color = "clGreen"  VertexIndexes = "0;2;6" InvisibleEdges = "4" />
                <Face Color = "clRed"    VertexIndexes = "6;4;0" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "3;1;5" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "5;7;3" InvisibleEdges = "4" />
            </Faces>
        </Part>

        <Cut Color = "clYellow1" > <Plane NormVector = "-1;-1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "clBlue1  " > <Plane NormVector = " 1; 1;-1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "clGreen1 " > <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>
        <Cut Color = "clRed1   " > <Plane NormVector = "-1; 1; 1" NormDistance = "-RCut" /> </Cut>
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
