<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Almost Antiprism Skewb</Name>
        <Menu>Other forms\Skewb variants\Almost Antiprism Skewb</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3037</Link>
    </Interface>

    <Script>
        R := 0.4;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        DCut1 := RSin;
        DCut2 := R * 0.872;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[7]; Vy[7]; Vz[7]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>
        <Cut Color = "Colors[ 3]" > <Plane NormVector = "-cx[ 3];-cy[ 3];-cz[ 3]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 2]" > <Plane NormVector = "-cx[ 4];-cy[ 4];-cz[ 4]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 6]" > <Plane NormVector = "-cx[ 5];-cy[ 5];-cz[ 5]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "-cx[ 8];-cy[ 8];-cz[ 8]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 8]" > <Plane NormVector = "-cx[ 9];-cy[ 9];-cz[ 9]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 0]" > <Plane NormVector = "-cx[10];-cy[10];-cz[10]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 9]" > <Plane NormVector = "-vx[ 1];-vy[ 1];-vz[ 1]" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "Colors[ 4]" > <Plane NormVector = " vx[ 1]; vy[ 1]; vz[ 1]" NormDistance = "-DCut2" /> </Cut>
    </Figure>

</xml>
