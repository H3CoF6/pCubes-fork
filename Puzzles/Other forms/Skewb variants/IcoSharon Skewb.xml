<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>IcoSharon Skewb</Name>
        <Menu>Other forms\Skewb variants\IcoSharon Skewb</Menu>
        <Inventor>Sharon Avidor</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1739</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clLightBlue    := '2828FF';
        clBlue         := '0000A0';
        clBrown        := '800000';
        clLightViolett := 'FF0080';
        clRed          := 'FF0000';
        clLightGreen   := '00FF00';
        clGreen        := '008000';
        clViolett      := '800080';
        clCyan         := '00DCB4';

        a := 0.3;
        b := a * 2;
        D := (-a+b)/sqrt(3);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; a; b" />
                <Add Vector = " 0; a;-b" />
                <Add Vector = " 0;-a;-b" />
                <Add Vector = " 0;-a; b" />
                <Add Vector = " b; 0; a" />
                <Add Vector = "-b; 0; a" />
                <Add Vector = "-b; 0;-a" />
                <Add Vector = " b; 0;-a" />
                <Add Vector = " a; b; 0" />
                <Add Vector = " a;-b; 0" />
                <Add Vector = "-a;-b; 0" />
                <Add Vector = "-a; b; 0" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue"         VertexIndexes = " 0; 4; 8" />
                <Face Color = "clLightBlue"    VertexIndexes = " 0; 3; 4" />
                <Face Color = "clLightGreen"   VertexIndexes = " 0; 5; 3" />
                <Face Color = "clGreen"        VertexIndexes = " 0;11; 5" />
                <Face Color = "clYellow"       VertexIndexes = " 0; 8;11" />

                <Face Color = "clViolett"      VertexIndexes = " 4; 3; 9" />
                <Face Color = "clRed"          VertexIndexes = " 9; 3;10" />
                <Face Color = "clBrown"        VertexIndexes = "10; 3; 5" />
                <Face Color = "clLightViolett" VertexIndexes = "10; 5; 6" />
                <Face Color = "clCyan"         VertexIndexes = " 6; 5;11" />

                <Face Color = "clBlue"         VertexIndexes = " 2;10; 6" />
                <Face Color = "clLightBlue"    VertexIndexes = " 2; 6; 1" />
                <Face Color = "clLightGreen"   VertexIndexes = " 2; 1; 7" />
                <Face Color = "clGreen"        VertexIndexes = " 2; 7; 9" />
                <Face Color = "clYellow"       VertexIndexes = " 2; 9;10" />

                <Face Color = "clViolett"      VertexIndexes = " 6;11; 1" />
                <Face Color = "clRed"          VertexIndexes = "11; 8; 1" />
                <Face Color = "clBrown"        VertexIndexes = " 8; 7; 1" />
                <Face Color = "clLightViolett" VertexIndexes = " 8; 4; 7" />
                <Face Color = "clCyan"         VertexIndexes = " 7; 4; 9" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
