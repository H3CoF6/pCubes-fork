<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gem Skewb</Name>
        <Menu>Other forms\Skewb variants\Gem Skewb</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3825</Link>
    </Interface>

    <Script>
        R := 0.4;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        DCut1 := RSin;
        DCut2 := 2*R-RCos;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>
        <Cut Color = "Colors[ 3]" > <Plane NormVector = "-cx[ 0];-cy[ 0];-cz[ 0]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 0]" > <Plane NormVector = "-cx[ 1];-cy[ 1];-cz[ 1]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 4]" > <Plane NormVector = "-cx[ 2];-cy[ 2];-cz[ 2]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 6]" > <Plane NormVector = "-cx[ 4];-cy[ 4];-cz[ 4]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[11]" > <Plane NormVector = "-cx[ 8];-cy[ 8];-cz[ 8]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 9]" > <Plane NormVector = "-cx[10];-cy[10];-cz[10]" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "Colors[ 7]" > <Plane NormVector = " vx[ 1]; vy[ 1]; vz[ 1]" NormDistance = "-DCut2" /> </Cut>
    </Figure>

</xml>
