    <Script>
        clCase       := '444444';
        clFace       := 'DDDDDD';
        clHourHand   := '222222';
        clMinuteHand := '222222';

        R := 0.5;

        // axes

        for j := 0 to 5 do begin
            ax[j] := cos(Pi / 6 * (j + 0.5));
            ay[j] := sin(Pi / 6 * (j + 0.5));
        end;

        // case

        Outer := R;
        Inner := R * 0.9;
        Height := R * 0.1;

        N := 60;

        for j := 0 to N-1 do begin
            Angle := 2*Pi / N * (j + 0.5);
            cs := cos(Angle);
            ss := sin(Angle);

            Ox[j] := Outer * cs;
            Oy[j] := Outer * ss;

            Ix[j] := Inner * cs;
            Iy[j] := Inner * ss;
        end;

        // for solving procedure
        for j := 0 to N/12 do begin
            Ix[5*j] := Ix[5*j] * (1 + j * 0.001);
            Iy[5*j] := Iy[5*j] * (1 + j * 0.001);
        end;

        // Hands

        H := R * 0.01;
        HourWidth := R * 0.03;
        HourHand := R * 0.6;
        H0 := Height;
        H1 := H0 + H;

        HHx[0] :=  HourWidth;
        HHy[0] := -HourWidth;
        HHx[1] := -HourWidth;
        HHy[1] := -HourWidth;
        HHx[2] :=  HourWidth / 2;
        HHy[2] :=  HourHand;
        HHx[3] := -HourWidth / 2;
        HHy[3] :=  HourHand;

        MinuteWidth := R * 0.02;
        MinuteHand := R * 0.8;
        H2 := H1 + H;

        MMx[0] :=  MinuteWidth;
        MMy[0] := -MinuteWidth;
        MMx[1] := -MinuteWidth;
        MMy[1] := -MinuteWidth;
        MMx[2] :=  MinuteWidth / 2;
        MMy[2] :=  MinuteHand;
        MMx[3] := -MinuteWidth / 2;
        MMy[3] :=  MinuteHand;

        Ht := 0;
        Mt := 0;
        RequestNumbers('Input time', 'Hour:', 'Minute:', Ht, Mt);
                
        HourAngle := 2*Pi * (Ht + Mt/60) / 12;
        MinuteAngle := HourAngle * 12;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

