    <Script>
        clWhite := 'FFFFFF';
        clGray  := '777777';
        clBlack := '333333';

        R := 0.7;
        H := R * sin(Pi / 10);
        for i := 0 to 9 do begin
            x[i] := R * cos(Pi / 5 * i);
            y[i] := R * sin(Pi / 5 * i);
        end;

        H1 := H / 3;
        H2 := H / 2;

        function Mid(a1, a2, k);
        begin
            Result := a1 + (a2 - a1) * k;
        end;

        X1 := Mid( x[5], x[6], 2/3);
        Y1 := Mid( y[5], y[6], 2/3);
        X2 := Mid( x[5], x[6], 1/3);
        Y2 := Mid( y[5], y[6], 1/3);
    </Script>

    <Axes TurningAngles = "0; Pi / 5; 0" PlaneDistances = "-H;H" >
        <Axis NormVector = "1;0;0" MinAngles = "0; -2 * Pi / 5; 0" MaxAngles = "0; 2 * Pi / 5; 0"/>
        <Axis NormVector = "0;0;1" MinAngles = "0; -2 * Pi / 5; 0" MaxAngles = "0; 2 * Pi / 5; 0"/>
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " x; y; H" />
            <Vertices Vectors = " x; y;-H" />
            <Vertices>
                <Add Vector = " H; y[0]; x[0]" />
                <Add Vector = " H; y[1]; x[1]" />
                <Add Vector = " H; y[4]; x[4]" />
                <Add Vector = " H; y[5]; x[5]" />
                <Add Vector = " H; y[6]; x[6]" />
                <Add Vector = " H; y[9]; x[9]" />
                <Add Vector = "-H; y[0]; x[0]" />
                <Add Vector = "-H; y[1]; x[1]" />
                <Add Vector = "-H; y[4]; x[4]" />
                <Add Vector = "-H; y[5]; x[5]" />
                <Add Vector = "-H; y[6]; x[6]" />
                <Add Vector = "-H; y[9]; x[9]" />

                <Add Vector = " H1; y[7]; H1" />
                <Add Vector = " H1; y[7];-H1" />
                <Add Vector = "-H1; y[7]; H1" />
                <Add Vector = "-H1; y[7];-H1" />

                <Add Vector = "x[7]; y[7]; H1" />
                <Add Vector = "x[7]; y[7];-H1" />
                <Add Vector = "x[8]; y[8]; H1" />
                <Add Vector = "x[8]; y[8];-H1" />

                <Add Vector = " H1; y[7];x[7]" />
                <Add Vector = "-H1; y[7];x[7]" />
                <Add Vector = " H1; y[8];x[8]" />
                <Add Vector = "-H1; y[8];x[8]" />

                <Add Vector = "x[6]; y[6]; H2" />
                <Add Vector = "x[6]; y[6];-H2" />
                <Add Vector = "x[9]; y[9]; H2" />
                <Add Vector = "x[9]; y[9];-H2" />

                <Add Vector = " H2; y[6];x[6]" />
                <Add Vector = "-H2; y[6];x[6]" />
                <Add Vector = " H2; y[9];x[9]" />
                <Add Vector = "-H2; y[9];x[9]" />

                <Add Vector = " X1; Y1; H2" />
                <Add Vector = " X1; Y1;-H2" />
                <Add Vector = "-X1; Y1; H2" />
                <Add Vector = "-X1; Y1;-H2" />

                <Add Vector = " H2; Y1; X1" />
                <Add Vector = "-H2; Y1; X1" />
                <Add Vector = " H2; Y1;-X1" />
                <Add Vector = "-H2; Y1;-X1" />

                <Add Vector = " X2; Y2;  0" />
                <Add Vector = "-X2; Y2;  0" />
                <Add Vector = "  0; Y2; X2" />
                <Add Vector = "  0; Y2;-X2" />

                <Add Vector = "0;y[7];0" />
            </Vertices>

            <Faces>
                <Face Color = "clGray" VertexIndexes = " 1; 0;10;11" />
                <Face Color = "clGray" VertexIndexes = " 2; 1;11;12" />
                <Face Color = "clGray" VertexIndexes = " 3; 2;12;13" />
                <Face Color = "clGray" VertexIndexes = " 4; 3;13;14" />
                <Face Color = "clGray" VertexIndexes = " 5; 4;14;15" />
