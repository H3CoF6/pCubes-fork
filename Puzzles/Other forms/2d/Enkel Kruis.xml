                <Face Color = "clBlack" VertexIndexes = "11;10;23;22" />
                <Face Color = "clBlack" VertexIndexes = "12;11;22" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split">
            <Turn Axis = "A" Layer = "1" Angle = " C * 2 * Pi / 5" />
            <SplitByAxes/>
            <Turn Axis = "B" Layer = "1" Angle = " C * 1 * Pi / 5" />
            <SplitByAxes/>
            <Turn Axis = "B" Layer = "1" Angle = "-C * 2 * Pi / 5" />
            <SplitByAxes/>
            <Turn Axis = "A" Layer = "1" Angle = "-C * 1 * Pi / 5" />
            <SplitByAxes/>
            <Turn Axis = "B" Layer = "1" Angle = " C * 1 * Pi / 5" />
            <SplitByAxes/>
            <Turn Axis = "A" Layer = "1" Angle = " C * 1 * Pi / 5" />
            <SplitByAxes/>
            <RemoveGrayParts/>
            <Undo Repeat = "6" />
        </Macro>

        <ExecMacro MacroName = "Split" A = "0" B = "1" C = " 1"/>
        <ExecMacro MacroName = "Split" A = "0" B = "1" C = "-1"/>
        <ExecMacro MacroName = "Split" A = "1" B = "0" C = " 1"/>
        <ExecMacro MacroName = "Split" A = "1" B = "0" C = "-1"/>

        <Turn Axis = "0" Layer = "1" Angle = " Pi / 5" />
        <Turn Axis = "1" Layer = "1" Angle = "-Pi / 5" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = " Pi / 5" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <Undo Repeat = "3" />

        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 5" />
        <Turn Axis = "1" Layer = "1" Angle = " Pi / 5" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 5" />
        <SplitByAxes/>
