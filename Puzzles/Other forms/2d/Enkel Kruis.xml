                <Face Color = "clBlack" VertexIndexes = " 7;36;34;43" InvisibleEdges = "6" />
                <Face Color = "clBlack" VertexIndexes = "17;41;35;37" InvisibleEdges = "6" />

                <Face Color = "clBlack" VertexIndexes = "44;36; 7; 6" InvisibleEdges = "1" />
