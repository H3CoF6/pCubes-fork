<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Enkel Kruis</Name>
        <Menu>Other forms\2d\Enkel Kruis</Menu>
        <Inventor>Karolis Kairys</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-04-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11778</Link>
