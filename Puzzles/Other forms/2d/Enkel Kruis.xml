                <Face Color = "clWhite" VertexIndexes = "48;40;41;49" InvisibleEdges = "5" />

                <Face Color = "clBlack" VertexIndexes = "50;42; 8;25" InvisibleEdges = "1" />
                <Face Color = "clBlack" VertexIndexes = "43;51;31; 7" InvisibleEdges = "1" />
                <Face Color = "clWhite" VertexIndexes = "51;43;42;50" InvisibleEdges = "5" />

                <Face Color = "clBlack" VertexIndexes = " 6; 5;15;16;45;53;60;52;44" InvisibleEdges = "240" />
                <Face Color = "clBlack" VertexIndexes = "19;10; 0; 9;46;54;61;55;47" InvisibleEdges = "240" />
                <Face Color = "clBlack" VertexIndexes = "30;29;23;24;48;56;62;57;49" InvisibleEdges = "240" />
