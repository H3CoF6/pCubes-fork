<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

     <Interface>
        <Name>Crazyloid V3</Name>
        <Menu>Other forms\2d\Circuloid\Crazyloid V3</Menu>
        <Inventor>El Cubitero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-12-03</Added>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clOrange  := 'FF6000';
        clYellow  := 'FFFF00';
        clLime    := '00FF00';
        clDeepSky := '00BFFF';
        clBlack   := '333333';

        K := 0.6;
        D1 := K * 0.75;
        D2 := K * 0.80;
        DCut := D1 - K * 0.1;
    </Script>

    <Axes TurningAngles = "0; Pi; Pi" PlaneDistances = " D1; D2" >
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2; Pi/2" PlaneDistances = " D1; D2" >
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1" > <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlack"     > <Plane NormVector = " 1;-1; 0" NormDistance = " DCut" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1" > <Plane NormVector = " 0;-1; 0" NormDistance = " DCut" /> </Cut>
        <Cut InvisibleEdges = "-1" > <Plane NormVector = " 1;-1; 0" NormDistance = " DCut" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1" > <Plane NormVector = "-1; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlack"     > <Plane NormVector = " 0;-1; 0" NormDistance = " DCut" /> </Cut>
        <HideAll/>

        <Macro Name = "AddSlice" >
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <Cut Axis = "0" From = "1" />
            <Cut Axis = "1" From = "1" />
        </Macro>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clLime" />
        <Cut  Axis = "0" From = "1" />
        <Cut  Axis = "1" To   = "1" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi" />
        <Cut  Axis = "1" To   = "1" />
        <HideAll/>

        <ExecMacro MacroName = "AddSlice" Color = "clDeepSky" />
        <Undo/>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clOrange" />
        <Cut  Axis = "0" To   = "1" />
        <Cut  Axis = "1" From = "1" />
        <Turn Axis = "1" Layer = "1" Angle = " Pi" />
        <Cut  Axis = "0" To   = "1" />
        <HideAll/>

        <ExecMacro MacroName = "AddSlice" Color = "clRed" />
        <Undo/>
        <HideAll/>

        <ExecMacro MacroName = "AddSlice" Color = "clYellow" />
        <ShowAll/>

        <SplitByAxes/>

        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layers = "1;2" Angle = " Pi" />
            <Turn Axis = "1" Layers = "1;2" Angle = " Pi/2" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Undo Repeat = "8" />

        <SaveSolvedState/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/8" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
     </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
