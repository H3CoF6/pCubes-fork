<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Androzzle (5-fold)</Name>
        <Menu>Other forms\2d\Androzzle (5-fold)</Menu>
        <Inventor>Karolis Kairys, ecuber</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-05-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11147</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clBlue   := '00BFFF';
        clYellow := 'FFBB00';
        clNavy   := '000077';
        clGreen  := '00AA00';
        clBlack  := '333333';

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        <!-- Cut Depths -->
        D1 := (Rsin + R2sin) / 2 + R * 0.05;
        D2 := Rsin;

        <!-- Frame Width -->
        D3 := D1 - R * 0.05;

        <!-- Circle Dimensions -->
        RC := R * 0.38;
        Sc := 1.1;

        N := 25;
        for i := 0 to N - 1 do begin
            A := 2 * Pi / N * i;
            x[i] := RC * cos(A);
            y[i] := RC * sin(A);
        end;

        function FromTo(iFrom, iTo);
        begin
            Result := IntToStr(iFrom);
            for i := iFrom + 1 to iTo do
                Result := Result + ';' + IntToStr(i);
            for i := iFrom - 1 downto iTo do
                Result := Result + ';' + IntToStr(i);
        end;
    </Script>

    <Axes TurningAngles = " 0; sAngle" PlaneDistances = "D2">
        <Axis NormVector = "Cx[0];Cy[0];Cz[0]" />
    </Axes>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D1">
        <Axis NormVector = "Cx[4];Cy[4];Cz[4]" MinAngles = "0;-sAngle" MaxAngles = "0;sAngle" />
        <Axis NormVector = "Cx[3];Cy[3];Cz[3]" MinAngles = "0;-sAngle" MaxAngles = "0;sAngle" />
    </Axes>

    <Figure>
        <!-- Handmade cylinders, N (number of sides) must be divisible by 5 so that the same parts can be interchanged (for 'solved' detector) -->
        <Macro Name = "AddCircle" >
            <Macro Name = "AddFace" >
                <Script>
                    i1 := i mod N;
                    i2 := (i + 1) mod N;
                    Inc(i);
                </Script>
                <Face Color = "Color" VertexIndexes = "i1 + N; i2 + N; i2; i1" InvisibleEdges = "10" />
            </Macro>

            <Part>
                <Vertices Vectors = "x; y; RSin * Sc" />
                <Vertices Vectors = "x; y; RSin" />

                <Faces>
                    <Face Color = "Color" VertexIndexes = "FromTo(0, N - 1)" />
                    <ExecMacro MacroName = "AddFace" i = "0" Repeat = "N" />
                    <Face Color = "Color" VertexIndexes = "FromTo(2 * N - 1, N)" />
                </Faces>
            </Part>
        </Macro>
        <Macro Name = "AddCircles" >
            <ExecMacro MacroName = "AddCircle" />

            <Turn NormVector = "Vx[ 4];Vy[ 4];Vz[ 4]" Angle = " 2*Pi/3" />
            <ExecMacro MacroName = "AddCircle" />

            <Turn NormVector = "Vx[ 4];Vy[ 4];Vz[ 4]" Angle = " 2*Pi/3" />
            <ExecMacro MacroName = "AddCircle" />

            <Turn NormVector = "Vx[ 9];Vy[ 9];Vz[ 9]" Angle = " 2*Pi/3" />
            <ExecMacro MacroName = "AddCircle" />

            <Turn NormVector = "Vx[ 9];Vy[ 9];Vz[ 9]" Angle = " 2*Pi/3" />
            <ExecMacro MacroName = "AddCircle" />

            <Turn NormVector = "Vx[ 4];Vy[ 4];Vz[ 4]" Angle = "-2*Pi/3" />
            <ExecMacro MacroName = "AddCircle" />

            <Turn NormVector = "Vx[ 8];Vy[ 8];Vz[ 8]" Angle = "-2*Pi/3" />
            <Turn NormVector = "Vx[12];Vy[12];Vz[12]" Angle = " 2*Pi/3" />
        </Macro>

        <Macro Name = "AddColor" >
            <HideAll/>
            <Script>
                for i := 0 to 11 do 
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Figures\Dodecahedron.xml" />
            <ExecMacro MacroName = "AddCircles" />
        </Macro>

        <Macro Name = "Cut" >
            <Cut> <Plane NormVector = " Cx[c]; Cy[c]; Cz[c]" NormDistance = " DCut" /> </Cut>
        </Macro>

        <!-- Colored parts -->

        <ExecMacro MacroName = "AddColor" Color = "clGreen" />
        <ExecMacro MacroName = "Cut" c = "11" DCut = "-D1" />
        <ExecMacro MacroName = "Cut" c = " 3" DCut = " D1" />
        <ExecMacro MacroName = "Cut" c = " 4" DCut = " D1" />
        <Split> <Plane NormVector = " Cx[6]; Cy[6]; Cz[6]" NormDistance = " D1" /> </Split>

        <ExecMacro MacroName = "AddColor" Color = "clNavy" />
        <ExecMacro MacroName = "Cut" c = " 0" DCut = " D1" />
        <ExecMacro MacroName = "Cut" c = " 8" DCut = "-D1" />
        <ExecMacro MacroName = "Cut" c = " 4" DCut = " D1" />
        <Split> <Plane NormVector = " Cx[5]; Cy[5]; Cz[5]" NormDistance = " D1" /> </Split>

        <ExecMacro MacroName = "AddColor" Color = "clBlue" />
        <ExecMacro MacroName = "Cut" c = " 0" DCut = " D1" />
        <ExecMacro MacroName = "Cut" c = " 3" DCut = " D1" />
        <ExecMacro MacroName = "Cut" c = " 9" DCut = "-D1" />
        <Split> <Plane NormVector = " Cx[2]; Cy[2]; Cz[2]" NormDistance = " D1" /> </Split>

        <ExecMacro MacroName = "AddColor" Color = "clYellow" />
        <ExecMacro MacroName = "Cut" c = " 0" DCut = " D1" />
        <ExecMacro MacroName = "Cut" c = " 3" DCut = " D1" />
        <ExecMacro MacroName = "Cut" c = " 4" DCut = " D1" />

        <ExecMacro MacroName = "AddColor" Color = "clRed" />
        <ExecMacro MacroName = "Cut" c = " 0" DCut = " D2" />
        <ExecMacro MacroName = "Cut" c = " 8" DCut = "-D1" />
        <ExecMacro MacroName = "Cut" c = " 9" DCut = "-D1" />

        <!-- Black body -->

        <ExecMacro MacroName = "AddColor" Color = "clBlack" />
        <Split> <Plane NormVector = " Cx[0]; Cy[0]; Cz[0]" NormDistance = " D1" /> </Split>
        <Split> <Plane NormVector = " Cx[3]; Cy[3]; Cz[3]" NormDistance = " D1" /> </Split>
        <Split> <Plane NormVector = " Cx[4]; Cy[4]; Cz[4]" NormDistance = " D1" /> </Split>
        <HideContaining Vector = " Cx[3]*Sc; Cy[3]*Sc; Cz[3]*Sc" />
        <HideContaining Vector = " Cx[4]*Sc; Cy[4]*Sc; Cz[4]*Sc" />
        <RemoveAllVisible/>

        <LoadFrom File = "Figures\Dodecahedron.xml" R = "R * Sc" Color = "clBlack" />
        <Split Color1 = "clBlack" Color2 = "clBlack" > <Plane NormVector = " Cx[0]; Cy[0]; Cz[0]" NormDistance = " D1" /> </Split>
        <Split Color1 = "clBlack" Color2 = "clBlack" > <Plane NormVector = " Cx[3]; Cy[3]; Cz[3]" NormDistance = " D1" /> </Split>
        <Split Color1 = "clBlack" Color2 = "clBlack" > <Plane NormVector = " Cx[4]; Cy[4]; Cz[4]" NormDistance = " D1" /> </Split>
        <Cut Color = "clBlack" > <Plane NormVector = " Cx[11]; Cy[11]; Cz[11]" NormDistance = "-D2" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " Cx[ 8]; Cy[ 8]; Cz[ 8]" NormDistance = "-D2" /> </Cut>
        <Cut Color = "clBlack" > <Plane NormVector = " Cx[ 9]; Cy[ 9]; Cz[ 9]" NormDistance = "-D2" /> </Cut>
        <HideContaining Vector = " Cx[0]/Sc; Cy[0]/Sc; Cz[0]/Sc" />
        <HideContaining Vector = " Cx[3]/Sc; Cy[3]/Sc; Cz[3]/Sc" />
        <HideContaining Vector = " Cx[4]/Sc; Cy[4]/Sc; Cz[4]/Sc" />
        <RemoveAllVisible/>

        <!-- Frame -->
        <Macro Name = "CutI" >
            <Cut InvisibleEdges = "-1" Color = "clBlack" > <Plane NormVector = " Cx[c]; Cy[c]; Cz[c]" NormDistance = " DCut" /> </Cut>
        </Macro>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ExecMacro MacroName = "CutI" c = "11" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 8" DCut = "-D3" />
        <ExecMacro MacroName = "CutI" c = " 9" DCut = "-D3" />
        <Cut Color = "clBlack" > <Plane NormVector = " Cx[0]; Cy[0]; Cz[0]" NormDistance = " D3" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ExecMacro MacroName = "CutI" c = "11" DCut = "-D3" />
        <ExecMacro MacroName = "CutI" c = " 8" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 9" DCut = "-D3" />
        <Cut Color = "clBlack" > <Plane NormVector = " Cx[3]; Cy[3]; Cz[3]" NormDistance = " D3" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ExecMacro MacroName = "CutI" c = "11" DCut = "-D3" />
        <ExecMacro MacroName = "CutI" c = " 8" DCut = "-D3" />
        <ExecMacro MacroName = "CutI" c = " 9" DCut = "-D1" />
        <Cut Color = "clBlack" > <Plane NormVector = " Cx[4]; Cy[4]; Cz[4]" NormDistance = " D3" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ExecMacro MacroName = "CutI" c = " 0" DCut = " D3" />
        <ExecMacro MacroName = "CutI" c = "11" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 8" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 9" DCut = "-D3" />
        <ExecMacro MacroName = "CutI" c = " 3" DCut = " D3" />
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ExecMacro MacroName = "CutI" c = "11" DCut = "-D3" />
        <ExecMacro MacroName = "CutI" c = " 8" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 9" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 4" DCut = " D3" />
        <ExecMacro MacroName = "CutI" c = " 3" DCut = " D3" />
        <HideAll/>

        <LoadFrom File = "Figures\Dodecahedron.xml" />
        <ExecMacro MacroName = "CutI" c = "11" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 8" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 9" DCut = "-D1" />
        <ExecMacro MacroName = "CutI" c = " 0" DCut = " D3" />
        <ExecMacro MacroName = "CutI" c = " 4" DCut = " D3" />

        <ShowAll/>

        <!-- split red part -->

        <Turn Axis = "0" Angle = "2*sAngle" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "  sAngle" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "2" />
        <SaveSolvedState/>

        <!-- align to screen -->

        <Turn NormVector = "1;0;0" Angle = "dAngle" />
        <Turn NormVector = "0;1;0" Angle = "Pi" />

        <!-- default turn for every puzzle in pCubes -->
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
