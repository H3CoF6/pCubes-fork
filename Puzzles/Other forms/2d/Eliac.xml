<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Eliac</Name>
        <Menu>Other forms\2d\Eliac</Menu>
        <Inventor>Galen Ivanov</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-11-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6009</Link>
    </Interface>

    <Script>
        clOrange   := 'FF9730';
        clTurquoise:= '0099AA';
        clPurple   := '800080';
        clWhite    := 'FFFFFF';

        K := 0.6;
        D1 := K * 0.71029864124335 / sqrt(2); <!-- C20 / sqrt(2) -->
        D2 := K * 0.57768415038417; <!-- C15 -->

        D3 := D1 - K * 0.09;
        D4 := D2 - K * 0.09;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D2" >
        <Axis NormVector = " 0; -1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSegment" >
            <HideAll/>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSegment" Color = "clOrange" />
        <Cut Axis = "0" To   = "1" />
        <Cut Axis = "1" From = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clTurquoise" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" From = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clPurple" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1;0" NormDistance = " D3" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1;0" NormDistance = " D4" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;0" NormDistance = "-D3" /> </Cut>
        <Cut Color = "clWhite"    > <Plane NormVector = " 0;-1;0" NormDistance = " D4" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1;0" NormDistance = "-D4" /> </Cut>
        <Cut Color = "clWhite"    > <Plane NormVector = " 1;-1;0" NormDistance = " D3" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>
        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Unbandage" Repeat = "8" />
        <Undo Repeat = "16" />

        <Turn NormVector = "0;0;1" Angle = "-Pi/8" />

        <SaveSolvedState/>

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
