<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sualocin</Name>
        <Menu>Other forms\2d\Sualocin</Menu>
        <Inventor>Dmitry Andreev</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-04-22</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=428688</Link>
    </Interface>

    <Script>
        clPink   := 'EE70A0';
        clGreen  := '227744';
        clYellow := 'FFFF00';
        clBlack  := '333333';

        K := 0.6;
        D1 := K * 0.45;
        D2 := K * 0.60;
        D3 := D1 - K * 0.09;
        D4 := D2 - K * 0.09;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = " 0;-1; 1" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D2" >
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clPink" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clYellow" />
        <Cut  Axis = "0" From  = "1" />
        <Cut  Axis = "1" From  = "1" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi" />
        <Cut  Axis = "1" From  = "1" />
        <Undo/>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clGreen" />
        <Cut  Axis = "0" From  = "1" />
        <Cut  Axis = "1" From  = "1" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi" />
        <Cut  Axis = "1" To    = "1" />
        <Undo/>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clGreen" />
        <Cut Axis = "0" To   = "1" />
        <Cut Axis = "1" From = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = " D3" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 1" NormDistance = " D4" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1;-1" NormDistance = "-D3" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-1; 1" NormDistance = " D4" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-D4" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;-1; 1" NormDistance = " D3" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>
        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = " 2*Pi/3" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Unbandage" Repeat = "8" />
        <Undo Repeat = "16" />

        <SaveSolvedState/>

        <Turn NormVector = "1;-2;2" Angle = "Pi" />
        <Turn NormVector = "1;0;0" Angle = " Pi/4" />
        <Turn NormVector = "0;0;1" Angle = "-ArcCos(2 / sqrt(6)) / 2" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
