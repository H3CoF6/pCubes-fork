<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Albireo</Name>
        <Menu>Other forms\2d\Albireo</Menu>
        <Inventor>Dmitry Andreev</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-08-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7201</Link>
    </Interface>

    <Script>
        clMaroon := '600000';
        clYellow := 'FFBB00';
        clBlack  := '333333';
        clLime   := '00FF00';
        clOrange := 'FF6000';

        K := 0.6;
        phi := (sqrt(5) - 1) / 2; // The golden ratio

        C21 := K * 0.3569761362781;
        C63 := K * 0.9345756579487;

        D1 := K * 0.83;
        D2 := C63 / sqrt(1 + Phi^2);

        DCut1 := D1 - K * 0.06;
        DCut2 := D2 - K * 0.06;

        A := ArcCos(sqrt(5)/3) / 2;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D1" >
        <Axis NormVector = " 1;-2-Phi; 0" />
        <Axis NormVector = " 1;    -1; 1" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi/5" PlaneDistances = "D2" >
        <Axis NormVector = " 0;  -1; Phi" />
        <Axis NormVector = " 1;-Phi;   0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSphere" >
            <HideAll/>
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSphere" Color = "clMaroon" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clLime" />
        <Cut Axis = "1" From = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clYellow" />
        <Cut Axis = "2" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <Cut Axis = "0" To   = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clOrange" />
        <Cut Axis = "3" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <Cut Axis = "0" To   = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut                      > <Plane NormVector = " -1;     1;  -1" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "  0;     1;-Phi" NormDistance = "-DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " -1;   Phi;   0" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = "  1;-2-Phi;   0" NormDistance = " DCut1" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut                      > <Plane NormVector = "-1; 2+Phi;   0" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;     1;-Phi" NormDistance = "-DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;   Phi;   0" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;    -1;   1" NormDistance = " DCut1" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 2+Phi;   0" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;     1;  -1" NormDistance = "-DCut1" /> </Cut>
        <Cut                      > <Plane NormVector = "-1;   Phi;   0" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;    -1; Phi" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "3" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 2+Phi;   0" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;     1;  -1" NormDistance = "-DCut1" /> </Cut>
        <Cut                      > <Plane NormVector = " 0;     1;-Phi" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;  -Phi;   0" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-2-Phi;   0" NormDistance = " DCut1" /> </Cut>
        <Cut                      > <Plane NormVector = "-1;     1;  -1" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;    -1; Phi" NormDistance = " DCut2" /> </Cut>
        <Cut                      > <Plane NormVector = "-1;   Phi;   0" NormDistance = "-DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "3" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-2-Phi;   0" NormDistance = " DCut1" /> </Cut>
        <Cut                      > <Plane NormVector = "-1;     1;  -1" NormDistance = "-DCut1" /> </Cut>
        <Cut                      > <Plane NormVector = " 0;     1;-Phi" NormDistance = "-DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;  -Phi;   0" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut Axis = "2" To = "1" />
        <Cut                      > <Plane NormVector = "-1; 2+Phi;   0" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;    -1;   1" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;    -1; Phi" NormDistance = " DCut2" /> </Cut>
        <Cut                      > <Plane NormVector = "-1;   Phi;   0" NormDistance = "-DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut Axis = "3" To = "1" />
        <Cut                      > <Plane NormVector = "-1; 2+Phi;   0" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;    -1;   1" NormDistance = " DCut1" /> </Cut>
        <Cut                      > <Plane NormVector = " 0;     1;-Phi" NormDistance = "-DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;  -Phi;   0" NormDistance = " DCut2" /> </Cut>

        <ShowAll/>
        <SplitByAxes/>

        <Macro Name = "Unbandage" >
            <Turn Axis = "i" Layer = "1" Angle = "2*Pi/5" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Unbandage" Repeat = "5" i = "2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "5" i = "3" />

        <Turn  Axis = "0" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/3" />
        <Split Axis = "0" From  = "1" />

        <ExecMacro MacroName = "Unbandage" Repeat = "5" i = "2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "5" i = "3" />

        <Undo Repeat = "24" />

        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/3" />
        <Split Axis = "0" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "0" From  = "1" />

        <ExecMacro MacroName = "Unbandage" Repeat = "5" i = "2" />
        <ExecMacro MacroName = "Unbandage" Repeat = "5" i = "3" />

        <Undo Repeat = "24" />

        <RemoveGrayParts/>
        <SaveSolvedState/> <!-- 1st solution -->

        <Hide Axis = "0" To = "0" />
        <Cut Axis = "1" To = "1" />
        <HideAll/>
        <ExecMacro MacroName = "AddSphere" Color = "clMaroon" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" From = "1" />
        <SplitByAxes/>
        <ShowAll/>
        <SaveSolvedState/> <!-- 2nd solution -->

        <!-- align to screen -->
        <Turn NormVector = "0;0;1" Angle = "-A" />
        <Turn NormVector = "0;1;0" Angle = "-Pi / 6" />
        <Turn NormVector = "1;0;0" Angle = " A" />

        <!-- default turn for every puzzle in pCubes -->
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Textures>
        <Texture Name = "mark"  File = "Albireo_mark.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        mark = 0,2,0,  12,2,0
    </SetTextures>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
