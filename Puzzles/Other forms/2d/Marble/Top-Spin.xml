        <Texture Name = "tm_19" File = "Puzzles\Other forms\2D + rotation\Vec\tm_19.vec" />
        <Texture Name = "tm_20" File = "Puzzles\Other forms\2D + rotation\Vec\tm_20.vec" />
    </Textures>

    <SetTextures>
        <!-- texture name = partNo, faceNo, rotate, ... -->
        tm_01 =  4,33,12,  4,16,12
        tm_02 =  5,33,12,  5,16,12
