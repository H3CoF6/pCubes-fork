<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Top-Spin (5 colors)</Name>
        <Menu>Other forms\2d\Marble\Top-Spin (5 colors)</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=892</Link>
    </Interface>

    <Script>
        clBody    := '5BAED8';
        Colors[0] := '2C898E';
        Colors[1] := 'D31312';
        Colors[2] := 'E5FEFA';
        Colors[3] := 'FFB57C';
        Colors[4] := 'D69320';

        R := 0.5;
        H1 := R * 0.06;
        H2 := H1 * 1.3;

        R1 := R  * 0.094;

        dy := R * 1.03;
        for i := 0 to 15 do begin
            x1[i] := R1 * cos(2 * Pi / 16 * (i));
            y1[i] := R1 * sin(2 * Pi / 16 * (i)) + dy;
        end;

        sAngle := 2*Pi / 20;

        D := dy * (cos(1.5 * sAngle) + cos(2.5 * sAngle)) / 2;
    </Script>

    <Axes TurningAngles = "0; sAngle; 0" PlaneDistances = "-H1; H1" >
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi; 0" PlaneDistances = "D" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddBody">
            <Cylinder Color = "cl" Radius = "R" Base = "0; H1; 0" Top = "0; H2; 0" >
                <Base Color = "cl" />
                <Top  Color = "cl" />
            </Cylinder>
            <Cylinder Color = "cl" Radius = "R" Base = "0;-H1; 0" Top = "0;-H2; 0" >
                <Base Color = "cl" />
                <Top  Color = "cl" />
            </Cylinder>
        </Macro>

        <ExecMacro MacroName = "AddBody" cl = "Colors[0]" />
        <Cut> <Plane NormVector = "0;0;1" NormDistance = "D" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "AddBody" cl = "clBody" />
        <Cut> <Plane NormVector = "0;0;-1" NormDistance = "-D" /> </Cut>
        <ShowAll/>

        <Macro Name = "AddPuck" >
            <Part>
                <Vertices Vectors = "x1;  0; y1" />
                <Vertices Vectors = " 0;-H1; dy" />
                <Vertices Vectors = " 0; H1; dy" />

                <Faces>
                    <Face Color = "cl" VertexIndexes = " 0; 1;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 1; 2;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 2; 3;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 3; 4;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 4; 5;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 5; 6;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 6; 7;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 7; 8;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 8; 9;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 9;10;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "10;11;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "11;12;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "12;13;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "13;14;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "14;15;16" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "15; 0;16" InvisibleEdges = "6" />

                    <Face Color = "cl" VertexIndexes = " 1; 0;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 2; 1;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 3; 2;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 4; 3;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 5; 4;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 6; 5;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 7; 6;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 8; 7;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 9; 8;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "10; 9;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "11;10;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "12;11;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "13;12;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "14;13;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = "15;14;17" InvisibleEdges = "6" />
                    <Face Color = "cl" VertexIndexes = " 0;15;17" InvisibleEdges = "6" />
                </Faces>
            </Part>
            <Turn NormVector = "0; 1; 0" Angle = "sAngle" />
        </Macro>

        <Turn NormVector = "0; 1; 0" Angle = "sAngle / 2" />
        <ExecMacro MacroName = "AddPuck" cl = "Colors[0]" Repeat = "2" />
        <ExecMacro MacroName = "AddPuck" cl = "Colors[1]" Repeat = "4" />
        <ExecMacro MacroName = "AddPuck" cl = "Colors[2]" Repeat = "4" />
        <ExecMacro MacroName = "AddPuck" cl = "Colors[3]" Repeat = "4" />
        <ExecMacro MacroName = "AddPuck" cl = "Colors[4]" Repeat = "4" />
        <ExecMacro MacroName = "AddPuck" cl = "Colors[0]" Repeat = "2" />
        <Turn NormVector = "0; 1; 0" Angle = "-sAngle / 2" />

        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = " -20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = "  30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
