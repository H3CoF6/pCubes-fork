<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Elite-2 (AC)</Name>
        <Alias>Sun and Moon Puzzler</Alias>
        <Menu>Other forms\2d\Elite-2 (AC)</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-08-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10347</Link>
    </Interface>

    <Script>
        clBlack   := '333333';
        clWhite   := 'FFFFFF';
        clLime    := 'ADFF2F';
        clGreen   := '008000';
        clRed     := 'FF0000';
        clOrange  := 'FF6000';
        clBlue    := '000080';
        clDeepSky := '00BFFF';
        clGolden  := 'F9B000';

        W := 0.7;
        s2 := sqrt(2);
        C0 := W * (1 - s2 / 3);
        C1 := W * (10 - s2) / 14;
        C2 := W;

        D1 := W * 0.717;
        D2 := C0 * s2;

        DCut1 := D1 - W * 0.1;
        DCut2 := D2 - W * 0.1;
        Dx := C1 / 2;
        Dy := -(C1 + C2) / 2;
    </Script>

    <Axes TurningAngles = "0; Pi / 4" PlaneDistances = "D1" >
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D2" >
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "CreateShape" >
            <Part>
                <Vertices>
                      <Add Vector = "  0;  0; C2" />
                      <Add Vector = "  0;  0;-C2" />
                      <Add Vector = " C2;  0;  0" />
                      <Add Vector = "-C2;  0;  0" />
                      <Add Vector = "  0; C2;  0" />
                      <Add Vector = "  0;-C2;  0" />
                      <Add Vector = " C1;  0; C1" />
                      <Add Vector = " C1;  0;-C1" />
                      <Add Vector = "-C1;  0; C1" />
                      <Add Vector = "-C1;  0;-C1" />
                      <Add Vector = " C1; C1;  0" />
                      <Add Vector = " C1;-C1;  0" />
                      <Add Vector = "-C1; C1;  0" />
                      <Add Vector = "-C1;-C1;  0" />
                      <Add Vector = "  0; C1; C1" />
                      <Add Vector = "  0; C1;-C1" />
                      <Add Vector = "  0;-C1; C1" />
                      <Add Vector = "  0;-C1;-C1" />
                      <Add Vector = " C0; C0; C0" />
                      <Add Vector = " C0; C0;-C0" />
                      <Add Vector = " C0;-C0; C0" />
                      <Add Vector = " C0;-C0;-C0" />
                      <Add Vector = "-C0; C0; C0" />
                      <Add Vector = "-C0; C0;-C0" />
                      <Add Vector = "-C0;-C0; C0" />
                      <Add Vector = "-C0;-C0;-C0" />
                </Vertices>

                <Faces>
                      <Face Color = "Color" VertexIndexes = " 0; 6;18" />
                      <Face Color = "Color" VertexIndexes = " 0;18;14" />
                      <Face Color = "Color" VertexIndexes = " 0;14;22" />
                      <Face Color = "Color" VertexIndexes = " 0;22; 8" />
                      <Face Color = "Color" VertexIndexes = " 0; 8;24" />
                      <Face Color = "Color" VertexIndexes = " 0;24;16" />
                      <Face Color = "Color" VertexIndexes = " 0;16;20" />
                      <Face Color = "Color" VertexIndexes = " 0;20; 6" />
                      <Face Color = "Color" VertexIndexes = " 1; 7;21" />
                      <Face Color = "Color" VertexIndexes = " 1;21;17" />
                      <Face Color = "Color" VertexIndexes = " 1;17;25" />
                      <Face Color = "Color" VertexIndexes = " 1;25; 9" />
                      <Face Color = "Color" VertexIndexes = " 1; 9;23" />
                      <Face Color = "Color" VertexIndexes = " 1;23;15" />
                      <Face Color = "Color" VertexIndexes = " 1;15;19" />
                      <Face Color = "Color" VertexIndexes = " 1;19; 7" />
                      <Face Color = "Color" VertexIndexes = " 2; 6;20" />
                      <Face Color = "Color" VertexIndexes = " 2;20;11" />
                      <Face Color = "Color" VertexIndexes = " 2;11;21" />
                      <Face Color = "Color" VertexIndexes = " 2;21; 7" />
                      <Face Color = "Color" VertexIndexes = " 2; 7;19" />
                      <Face Color = "Color" VertexIndexes = " 2;19;10" />
                      <Face Color = "Color" VertexIndexes = " 2;10;18" />
                      <Face Color = "Color" VertexIndexes = " 2;18; 6" />
                      <Face Color = "Color" VertexIndexes = " 3; 8;22" />
                      <Face Color = "Color" VertexIndexes = " 3;22;12" />
                      <Face Color = "Color" VertexIndexes = " 3;12;23" />
                      <Face Color = "Color" VertexIndexes = " 3;23; 9" />
                      <Face Color = "Color" VertexIndexes = " 3; 9;25" />
                      <Face Color = "Color" VertexIndexes = " 3;25;13" />
                      <Face Color = "Color" VertexIndexes = " 3;13;24" />
                      <Face Color = "Color" VertexIndexes = " 3;24; 8" />
                      <Face Color = "Color" VertexIndexes = " 4;10;19" />
                      <Face Color = "Color" VertexIndexes = " 4;19;15" />
                      <Face Color = "Color" VertexIndexes = " 4;15;23" />
                      <Face Color = "Color" VertexIndexes = " 4;23;12" />
                      <Face Color = "Color" VertexIndexes = " 4;12;22" />
                      <Face Color = "Color" VertexIndexes = " 4;22;14" />
                      <Face Color = "Color" VertexIndexes = " 4;14;18" />
                      <Face Color = "Color" VertexIndexes = " 4;18;10" />
                      <Face Color = "Color" VertexIndexes = " 5;11;20" />
                      <Face Color = "Color" VertexIndexes = " 5;20;16" />
                      <Face Color = "Color" VertexIndexes = " 5;16;24" />
                      <Face Color = "Color" VertexIndexes = " 5;24;13" />
                      <Face Color = "Color" VertexIndexes = " 5;13;25" />
                      <Face Color = "Color" VertexIndexes = " 5;25;17" />
                      <Face Color = "Color" VertexIndexes = " 5;17;21" />
                      <Face Color = "Color" VertexIndexes = " 5;21;11" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 0" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1; 0" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;-1; 0" NormDistance = " DCut1" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-1; 0" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clRed" />
        <Cut Axis = "1" From = "1" />
        <Cut Axis = "0" To   = "1" />
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clLime" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clGolden" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" From = "1" />
        <HideAll/>

        <ShowAll/>

        <Macro Name = "Cut">
            <Turn Axis = "0" Layer = "1" Angle = "Pi/4" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = "Pi/2" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Cut" Repeat = "10" />
        <Undo Repeat = "20" />
        <SaveSolvedState/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/8" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
