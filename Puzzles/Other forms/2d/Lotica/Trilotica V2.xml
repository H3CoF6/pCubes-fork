<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trilotica V2</Name>
        <Menu>Other forms\2d\Lotica\Trilotica V2</Menu>
        <Inventor>El Cubitero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-08</Added>
        <Link></Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clYellow  := 'FFFF00';
        clDeepSky := '00BFFF';
        clBlack   := '333333';

        K := 0.6;
        D1 := K * 0.75;
        D2 := K * 0.75;

        D3 := D1 - K * 0.09;
        D4 := D2 - K * 0.09;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = " 0;-1; 1" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D2" >
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clDeepSky" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clYellow" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" From = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clRed" />
        <Cut Axis = "0" To   = "1" />
        <Cut Axis = "1" From = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = " D3" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 1" NormDistance = " D4" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1;-1" NormDistance = "-D3" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-1; 1" NormDistance = " D4" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-D4" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;-1; 1" NormDistance = " D3" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>
        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = " 2*Pi/3" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Unbandage" Repeat = "8" />
        <Undo Repeat = "16" />

        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = " Pi/4" />
        <Turn NormVector = "0;0;1" Angle = "-ArcCos(2 / sqrt(6)) / 2" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
