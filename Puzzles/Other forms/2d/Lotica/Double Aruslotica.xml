                    <Add Vector = "-C2; C0; C0" />
                    <Add Vector = "-C2; C0;-C0" />
                    <Add Vector = "-C2;-C0; C0" />
                    <Add Vector = "-C2;-C0;-C0" />
                    <Add Vector = " C0; C2; C0" />
                    <Add Vector = " C0; C2;-C0" />
                    <Add Vector = " C0;-C2; C0" />
                    <Add Vector = " C0;-C2;-C0" />
                    <Add Vector = "-C0; C2; C0" />
                    <Add Vector = "-C0; C2;-C0" />
                    <Add Vector = "-C0;-C2; C0" />
                    <Add Vector = "-C0;-C2;-C0" />
                    <Add Vector = " C1; C4; C1" /> 
                    <Add Vector = " C1; C4;-C1" /> 
                    <Add Vector = " C1;-C4; C1" /> 
                    <Add Vector = " C1;-C4;-C1" /> 
                    <Add Vector = "-C1; C4; C1" /> 
                    <Add Vector = "-C1; C4;-C1" /> 
                    <Add Vector = "-C1;-C4; C1" /> 
                    <Add Vector = "-C1;-C4;-C1" /> 
                    <Add Vector = " C1; C1; C4" /> 
                    <Add Vector = " C1; C1;-C4" /> 
                    <Add Vector = " C1;-C1; C4" /> 
                    <Add Vector = " C1;-C1;-C4" /> 
                    <Add Vector = "-C1; C1; C4" /> 
                    <Add Vector = "-C1; C1;-C4" /> 
                    <Add Vector = "-C1;-C1; C4" /> 
                    <Add Vector = "-C1;-C1;-C4" /> 
                    <Add Vector = " C4; C1; C1" /> 
                    <Add Vector = " C4; C1;-C1" /> 
                    <Add Vector = " C4;-C1; C1" /> 
                    <Add Vector = " C4;-C1;-C1" /> 
                    <Add Vector = "-C4; C1; C1" /> 
                    <Add Vector = "-C4; C1;-C1" /> 
                    <Add Vector = "-C4;-C1; C1" /> 
                    <Add Vector = "-C4;-C1;-C1" /> 
                </Vertices>

                <Faces>
                    <Face Color = "Color" VertexIndexes = " 6;30;14;38;22;46" />
                    <Face Color = "Color" VertexIndexes = " 7;47;23;39;15;31" />
                    <Face Color = "Color" VertexIndexes = " 8;48;24;40;16;32" />
                    <Face Color = "Color" VertexIndexes = " 9;33;17;41;25;49" />
                    <Face Color = "Color" VertexIndexes = "10;50;26;42;18;34" />
                    <Face Color = "Color" VertexIndexes = "11;35;19;43;27;51" />
                    <Face Color = "Color" VertexIndexes = "12;36;20;44;28;52" />
                    <Face Color = "Color" VertexIndexes = "13;53;29;45;21;37" />

                    <Face Color = "Color" VertexIndexes = " 0; 6;46;50;10" />
                    <Face Color = "Color" VertexIndexes = " 0;10;34;36;12" />
                    <Face Color = "Color" VertexIndexes = " 0;12;52;48; 8" />
                    <Face Color = "Color" VertexIndexes = " 0; 8;32;30; 6" />

                    <Face Color = "Color" VertexIndexes = " 1; 7;31;33; 9" />
