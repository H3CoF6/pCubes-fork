<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Aruslotica</Name>
        <Menu>Other forms\2d\Lotica\Double Aruslotica</Menu>
        <Inventor>El-Cubitero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-12-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10601</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clYellow := 'FFFF00';
        clGreen  := '00FF00';
        clBlue   := '0000FF';

        K  := 0.14;
        s6 := sqrt(6);
        C0 := k * (3 + s6) / 3;
        C1 := k * (1 + s6);
        C2 := k * (3 + 4 * s6) / 3;
        C3 := k * 3 * (1 + s6) / 2;
        C4 := k;

        D1 := C1 * 2 / sqrt(3);
        D2 := (C0 + C1) / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D1" FixedLayers = "0">
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D2" FixedLayers = "0">
        <Axis NormVector = " 0;-1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "CreateShape" > <!-- Truncated Tetrakis Hexahedron -->
            <Part>
                <Vertices>
                    <Add Vector = "  0;  0; C3" />
                    <Add Vector = "  0;  0;-C3" />
                    <Add Vector = " C3;  0;  0" />
                    <Add Vector = "-C3;  0;  0" />
                    <Add Vector = "  0; C3;  0" />
                    <Add Vector = "  0;-C3;  0" />
                    <Add Vector = " C0; C0; C2" />
                    <Add Vector = " C0; C0;-C2" />
                    <Add Vector = " C0;-C0; C2" />
                    <Add Vector = " C0;-C0;-C2" />
                    <Add Vector = "-C0; C0; C2" />
                    <Add Vector = "-C0; C0;-C2" />
                    <Add Vector = "-C0;-C0; C2" />
                    <Add Vector = "-C0;-C0;-C2" />
                    <Add Vector = " C2; C0; C0" />
                    <Add Vector = " C2; C0;-C0" />
                    <Add Vector = " C2;-C0; C0" />
