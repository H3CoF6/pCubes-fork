                    <Face Color = "Color" VertexIndexes = " 5;25;41;40;24" />
                </Faces>
            </Part>
        </Macro>
        
        <ExecMacro MacroName = "CreateShape" Color = "clBlue" />
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = " D1" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-D2" /> </Cut>
        <HideAll/>
        
        <ExecMacro MacroName = "CreateShape" Color = "clGreen" />
        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = " D1" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = " D2" /> </Cut>
        <HideAll/>
        
        <ExecMacro MacroName = "CreateShape" Color = "clYellow" />
