                    <Face Color = "Color" VertexIndexes = " 3;21;45;44;20" />
                    <Face Color = "Color" VertexIndexes = " 3;20;36;34;18" />

                    <Face Color = "Color" VertexIndexes = " 4;22;38;39;23" />
                    <Face Color = "Color" VertexIndexes = " 4;23;47;51;27" />
                    <Face Color = "Color" VertexIndexes = " 4;27;43;42;26" />
                    <Face Color = "Color" VertexIndexes = " 4;26;50;46;22" />

                    <Face Color = "Color" VertexIndexes = " 5;24;48;52;28" />
