        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = " D2" /> </Cut>
        <HideAll/>
        
        <ExecMacro MacroName = "CreateShape" Color = "clRed" />
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = " D1" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-D2" /> </Cut>
        <ShowAll/>
        <SplitByAxes/>
        
        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = "Pi/3" />
            <Turn Axis = "1" Layer = "1" Angle = "Pi/3" />
            <SplitByAxes/>
            <Turn Axis = "2" Layer = "1" Angle = "Pi" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "5" />
        <Undo Repeat = "100" />
        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = "Pi/4" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
