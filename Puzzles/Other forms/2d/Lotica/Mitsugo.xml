<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mitsugo</Name>
        <Alias>Double Trilotica V2 (AC)</Alias>
        <Menu>Other forms\2d\Lotica\Mitsugo</Menu>
        <Inventor>Karolis Kairys</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-11</Added>
        <Link>http://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10724</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clBlue   := '00BFFF';
        clYellow := 'FFBB00';
        clNavy   := '000077';
        clWhite  := 'FFFFFF';
        clBlack  := '333333';

        K := 0.6;
        D := K * 0.7;

        D1 := K * 0.75;
        D2 := K * 0.75;

        DCut1 := D2 - K * 0.1;
        DCut2 := D1 - K * 0.1;

        DH := K * 0.55;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = " 0;-1; 1" />
    </Axes>

    <Axes TurningAngles = "0; 2*Pi/3" PlaneDistances = "D2" >
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

<!--        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Split>-->
<!--        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Split>-->
<!--        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Split>-->
<!--        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Split>-->
<!--        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Split>-->
    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlue"/>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut Axis = "0" From = "1" />

        <Split Axis = "1" From = "1" />
        <Turn Axis = "1" Layer = "1" Angle = "2*Pi/3" />
        <Split Axis = "0" From = "1" />
        <Undo/>
        <Turn Axis = "1" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "0" From = "1" />
        <Undo/>

        <Split Axis = "2" From = "1" />
        <Turn Axis = "2" Layer = "1" Angle = "2*Pi/3" />
        <Split Axis = "0" From = "1" />
        <Undo/>
        <Turn Axis = "2" Layer = "1" Angle = "-2*Pi/3" />
        <Split Axis = "0" From = "1" />
        <Undo/>
        <HideContaining Vector = " DH;-DH; DH" />
        <HideContaining Vector = "-DH;-DH; DH" />
        <InvertVisibility/>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Split>

        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clWhite"/>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clRed"/>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 0;-1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1;-1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clNavy"/>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clYellow"/>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 0;-1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1;-1" NormDistance = "0" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "2" Layer = "1" />
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlue" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <Cut Axis = "2" To   = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1;-1" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = "-1;-1; 1" NormDistance = " DCut1" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;-1; 1" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;-1; 1" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 1" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0; 1;-1" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-1; 1" NormDistance = " DCut1" /> </Cut>
        <ShowAll/>

        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = " 2*Pi/3" />
            <SplitByAxes/>
            <Turn Axis = "2" Layer = "1" Angle = " 2*Pi/3" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "6" />
        <Undo Repeat = "18" />

        <SaveSolvedState/>

        <Turn NormVector = " 1; 0; 0" Angle = "Pi/4" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
