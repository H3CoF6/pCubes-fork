<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Leonidas Double Crazy</Name>
        <Menu>Other forms\2d\Leonidas Double Crazy</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-08-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9343</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clGreen  := '00FF00';
        clBlue   := '0000FF';
        clYellow := 'FFFF00';
        clBlack  := '333333';

        W := 0.7;
        C0 := W * (1 - sqrt(2) / 3);
        C1 := W * (10 - sqrt(2)) / 14;
        C2 := W;
        C3 := W * (sqrt(8) - 3) / 3;

        D1 := C1 / sqrt(3) * 2.15;
        D2 := C1 / sqrt(3) * 1.85;
        D3 := C0 * (sqrt(3) + sqrt(6)) / 2 + D1 * (sqrt(6) - sqrt(27)) / 6;

        DCut1 := W / sqrt(3);
        DCut2 := W * (3 - sqrt(2)) / sqrt(39 - 24 * sqrt(2));
    </Script>

    <Axes TurningAngles = "0; Pi * 2 / 3; Pi / 3" PlaneDistances = "D2; D3" >
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D1" >
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "CreateShape" >
            <Part>
                <Vertices>
                    <Add Vector = "  0;  0; C2" />
                    <Add Vector = "  0;  0;-C2" />
                    <Add Vector = " C2;  0;  0" />
                    <Add Vector = "-C2;  0;  0" />
                    <Add Vector = "  0; C2;  0" />
                    <Add Vector = "  0;-C2;  0" />
                    <Add Vector = " C1;  0; C1" />
                    <Add Vector = " C1;  0;-C1" />
                    <Add Vector = "-C1;  0; C1" />
                    <Add Vector = "-C1;  0;-C1" />
                    <Add Vector = " C1; C1;  0" />
                    <Add Vector = " C1;-C1;  0" />
                    <Add Vector = "-C1; C1;  0" />
                    <Add Vector = "-C1;-C1;  0" />
                    <Add Vector = "  0; C1; C1" />
                    <Add Vector = "  0; C1;-C1" />
                    <Add Vector = "  0;-C1; C1" />
                    <Add Vector = "  0;-C1;-C1" />
                    <Add Vector = " C0; C0; C0" />
                    <Add Vector = " C0; C0;-C0" />
                    <Add Vector = " C0;-C0; C0" />
                    <Add Vector = " C0;-C0;-C0" />
                    <Add Vector = "-C0; C0; C0" />
                    <Add Vector = "-C0; C0;-C0" />
                    <Add Vector = "-C0;-C0; C0" />
                    <Add Vector = "-C0;-C0;-C0" />
                </Vertices>

                <Faces>
                    <Face Color = "Color" VertexIndexes = " 0; 6;18" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0;18;14" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0;14;22" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0;22; 8" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0; 8;24" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0;24;16" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0;16;20" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0;20; 6" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1; 7;21" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1;21;17" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1;17;25" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1;25; 9" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1; 9;23" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1;23;15" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1;15;19" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 1;19; 7" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2; 6;20" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2;20;11" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2;11;21" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2;21; 7" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2; 7;19" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2;19;10" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2;10;18" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 2;18; 6" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3; 8;22" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3;22;12" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3;12;23" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3;23; 9" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3; 9;25" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3;25;13" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3;13;24" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 3;24; 8" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;10;19" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;19;15" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;15;23" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;23;12" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;12;22" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;22;14" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;14;18" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 4;18;10" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;11;20" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;20;16" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;16;24" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;24;13" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;13;25" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;25;17" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;17;21" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 5;21;11" InvisibleEdges = "-1" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "CreateShape" Color = "clYellow" />
        <Cut  Axis = "0" From = "1" />
        <Cut  Axis = "1" To   = "1" />
        <Cut  Axis = "2" To   = "1" />
        <Cut  Axis = "3" To   = "1" />
        <HideAll/>
        <ExecMacro MacroName = "CreateShape" Color = "clGreen" />
        <Cut  Axis = "1" From = "1" />
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clRed" />
        <Cut  Axis = "2" From = "1" />
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlue" />
        <Cut  Axis = "3" From = "1" />
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-C3; C0;-C0" NormDistance = "-DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-C0; C3;-C0" NormDistance = "-DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-C0; C0;-C3" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = "  1; -1;  1" NormDistance = " DCut1" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "  1; -1;  1" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "10"> <Plane NormVector = " C3;-C0; C0" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "  1; -1;  1" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "10"> <Plane NormVector = " C0;-C3; C0" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "3" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "  1; -1;  1" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "10"> <Plane NormVector = " C0;-C0; C3" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = "-C3;-C0; C0" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " C0; C3; C0" NormDistance = " DCut2" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clBlack" />
        <Cut Axis = "3" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " C0;-C0;-C3" NormDistance = " DCut2" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi"/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi"/>
        <Turn Axis = "3" Layer = "1" Angle = "Pi"/>
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "2" Angle = "Pi/3"/>
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi"/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi"/>
        <Turn Axis = "3" Layer = "1" Angle = "Pi"/>
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "2" Angle = "Pi/3"/>
        <SplitByAxes/>
        <Undo Repeat = "8" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi/2"/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi/2"/>
        <Turn Axis = "3" Layer = "1" Angle = "Pi/2"/>
        <Split Axis = "0" From = "2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi"/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi"/>
        <Turn Axis = "3" Layer = "1" Angle = "Pi"/>
        <Split Axis = "0" From = "2" />
        <Undo Repeat = "6" />

        <SaveSolvedState/>

        <!-- align to screen -->
        <Turn NormVector = " 0; 0; 1" Angle = "-Pi/4" />
        <Turn NormVector = " 1; 0; 0" Angle = " ArcCos(2/sqrt(6))" />
        <Turn NormVector = " 0; 1; 0" Angle = "-Pi/3" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
