<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face of Andromeda Unbandaged</Name>
        <Menu>Other forms\2d\Andromeda\Face of Andromeda Unbandaged</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-10-27</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[0] := 'FF8800'; // Orange
        Colors[1] := 'FFFF00'; // Yellow
        Colors[2] := '00DD00'; // Green
        Colors[3] := '0066FF'; // Blue
        Colors[4] := 'FF0000'; // Red
        Colors[5] := 'AA00AA'; // Violett

        W := 0.5;
        A := W * 1.4;
        B := W * 0.3;

        // code from Pentagonal Icositetrahedron
        K  := 0.5; // result is independent from K
        K1 := (6 * (9 + sqrt(33)))^(1/3);
        K2 := (6 * (9 - sqrt(33)))^(1/3);
        K3 := (2 * (1777 + 33*sqrt(33)))^(1/3);
        K4 := (2 * (1777 - 33*sqrt(33)))^(1/3);

        C0 := K * sqrt(6 * (-6 + K1 + K2)) / 12;
        C1 := K * sqrt(6 * ( 6 + K1 + K2)) / 12;
        C2 := K * sqrt(6 * (18 + K1 + K2)) / 12;
        C3 := K * sqrt(6 * (14 + K3 + K4)) / 12;

        n1 := (c1 - c0)^2;
        n2 := (c1 - c2)^2;
        n3 := (c1 - c2) * (c0 - c1);

        bgx := -n2*n3 + n1^2;
        bgy :=  n1*n2 - n3^2;
        bgz := -n1*n3 + n2^2;

        byx := -n2^2 + n1*n3;
        byy :=  n1^2 - n2*n3;
        byz := -n3^2 + n1*n2;

        A1 := ArcCos((bgx*byx + bgy*byy + bgz*byz) / (bgx^2 + bgy^2 + bgz^2));
        A2 := 2 * Pi - 4 * A1;
        A3 := 2 * A1;
        A4 := 3 * A1;

        D := A * n1 / sqrt(n1^2 + n2^2 + n3^2);
        RCut := W * 0.4;
    </Script>

    <Axes TurningAngles = "2*Pi; 0" AvailableAngles = "-A4; -A3; -A2; -A1; 0; A1; A2; A3; A4" PlaneDistances = "-D" FixedLayers = "1" >
        <Axis NormVector = " n2; n3; n1" />
        <Axis NormVector = " n3;-n2; n1" />
        <Axis NormVector = "-n2;-n3; n1" />
        <Axis NormVector = "-n3; n2; n1" />

        <Axis NormVector = "-n2; n3;-n1" />
        <Axis NormVector = "-n3;-n2;-n1" />
        <Axis NormVector = " n2;-n3;-n1" />
        <Axis NormVector = " n3; n2;-n1" />

        <Axis NormVector = "-n2; n1; n3" />
        <Axis NormVector = " n2; n1;-n3" />
        <Axis NormVector = "-n3; n1;-n2" />
        <Axis NormVector = " n3; n1; n2" />

        <Axis NormVector = "-n3;-n1; n2" />
        <Axis NormVector = " n3;-n1;-n2" />
        <Axis NormVector = "-n2;-n1;-n3" />
        <Axis NormVector = " n2;-n1; n3" />

        <Axis NormVector = "-n1; n3; n2" />
        <Axis NormVector = "-n1;-n3;-n2" />
        <Axis NormVector = "-n1;-n2; n3" />
        <Axis NormVector = "-n1; n2;-n3" />

        <Axis NormVector = " n1;-n3; n2" />
        <Axis NormVector = " n1; n3;-n2" />
        <Axis NormVector = " n1;-n2;-n3" />
        <Axis NormVector = " n1; n2; n3" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <Hide Axis = "16" Layer = "0" />
        <Hide Axis = "17" Layer = "0" />
        <Hide Axis = "18" Layer = "0" />
        <Hide Axis = "19" Layer = "0" />
        <RemoveAllVisible/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Cut Axis = "16" From = "1" />
        <Cut Axis = "17" From = "1" />
        <Cut Axis = "18" From = "1" />
        <Cut Axis = "19" From = "1" />
        <Cut> <Plane NormVector = "1; 0; 0" NormDistance = "RCut" /> </Cut>

        <ShowAll/>

        <Macro Name = "Unbandage" >
        <Turn Axis = "ax1" Layer = "0" Angle = "an1" />
        <Turn Axis = "ax2" Layer = "0" Angle = "an2" />
        <Split Axis = "ax1" From = "1" To = "1"  />
        <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Unbandage" ax1 = "16" ax2 = "19" an1 = " -A2" an2 = "-A1" />
        <ExecMacro MacroName = "Unbandage" ax1 = "17" ax2 = "18" an1 = " -A2" an2 = "-A1" />
        <ExecMacro MacroName = "Unbandage" ax1 = "18" ax2 = "16" an1 = " -A2" an2 = "-A1" />
        <ExecMacro MacroName = "Unbandage" ax1 = "19" ax2 = "17" an1 = " -A2" an2 = "-A1" />

        <Turn NormVector = "0; 1; 0" Angle = "-Pi/2" />

        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = " 90 * Pi/180" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
