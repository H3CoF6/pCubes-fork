<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corner of Celtic Dodecahedron (Sphere)</Name>
        <Menu>Other forms\2d\Corner of Celtic Dodecahedron (Sphere)</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-10-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[ 0] := '8800DD'; // Violett
        Colors[ 1] := '00FF00'; // LightGreen
        Colors[ 2] := 'FFFF00'; // Yellow
        Colors[ 3] := '0000A0'; // Blue
        Colors[ 4] := 'FF0000'; // Red
        Colors[ 5] := '800000'; // Brown
        Colors[ 6] := '008000'; // Green
        Colors[ 7] := 'FF0080'; // Violett
        Colors[ 8] := '3868BF'; // LightBlue
        Colors[ 9] := 'FF6000'; // Orange
        Colors[10] := '00DCB4'; // Cyan
        Colors[11] := 'FFFFFF'; // White

        K   := 0.7;

        s5 := sqrt(5);
        pA1 := 3 - s5;
        pA2 := s5 + 1;
        pB1 := s5 - 1;
        pB2 := 2;
        pB3 := 2 * s5 - 2;
        pC  := 5 - s5;

        A1 := ArcCos(( 5 + 2 * sqrt(5)) / 20);
        A2 := ArcCos((-5 + 2 * sqrt(5)) / 10);
        A3 := ArcCos((-5 -     sqrt(5)) /  8);

        D := K * 0.938; // chosen to prevent overhang bandaging
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " pC ;   0; pB2" />
        <Axis NormVector = " pA2; pA1; pA1" />
        <Axis NormVector = " pA2;-pA1; pA1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "TurnAndSplit" >
            <Turn Axis = "ax1" Layer = "2" Angle = "an1" />
            <Split Axis = "ax2" From = "2"  />
            <Undo/>
        </Macro>
        <ExecMacro MacroName = "TurnAndSplit" ax1 = " 0" ax2 = "1" an1 = " A3" />
        <ExecMacro MacroName = "TurnAndSplit" ax1 = " 0" ax2 = "2" an1 = "-A3" />
        <ExecMacro MacroName = "TurnAndSplit" ax1 = " 1" ax2 = "0" an1 = "-A3" />
        <ExecMacro MacroName = "TurnAndSplit" ax1 = " 1" ax2 = "2" an1 = " A3" />
        <ExecMacro MacroName = "TurnAndSplit" ax1 = " 2" ax2 = "0" an1 = " A3" />
        <ExecMacro MacroName = "TurnAndSplit" ax1 = " 2" ax2 = "1" an1 = "-A3" />

        <Macro Name = "TurnAndSplit2" >
            <Turn Axis = "ax1" Layer = "2" Angle = "an1" />
            <Turn Axis = "ax2" Layer = "2" Angle = "an2" />
            <Split Axis = "ax1" From = "2"  />
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "TurnAndSplit2" ax1 = " 1" ax2 = "0" an1 = "-A3" an2 = "-A2"  />
        <ExecMacro MacroName = "TurnAndSplit2" ax1 = " 1" ax2 = "2" an1 = " A3" an2 = " A2"  />
        <ExecMacro MacroName = "TurnAndSplit2" ax1 = " 0" ax2 = "2" an1 = "-A3" an2 = "-A2"  />
        <ExecMacro MacroName = "TurnAndSplit2" ax1 = " 0" ax2 = "1" an1 = " A3" an2 = " A2"  />
        <ExecMacro MacroName = "TurnAndSplit2" ax1 = " 2" ax2 = "1" an1 = "-A3" an2 = "-A2"  />
        <ExecMacro MacroName = "TurnAndSplit2" ax1 = " 2" ax2 = "0" an1 = " A3" an2 = " A2"  />

        <Cut> <Plane NormVector = " C63; 0; C21" NormDistance = "K * 0.77" /> </Cut>
        <Turn Axis = "0" Layer = "1" Angle = "an1" />
        <SaveSolvedState/>

        <Turn NormVector = "0;0;1" Angle = "-90 * Pi/180" />
        <Turn NormVector = "1;0;0" Angle = " 21 * Pi/180" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
