<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trivial Circles</Name>
        <Menu>Other forms\2d\Trivial Circles</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-08-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6341</Link>
    </Interface>

    <Script>
        clBlue   := '0000BB';
        clOrange := 'FF800A';
        clBlack  := '333333';

        K := 0.6;
        D := K * 0.65;
        DCut := D - K * 0.1;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = " D" FixedLayers = "0" >
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlue" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 0" NormDistance = "0" /> </Cut>
        <Cut Axis = "0" From = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clOrange" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Cut>
        <Cut Axis = "1" From = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 1" NormDistance = " DCut" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;-1; 1" NormDistance = " DCut" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = "-1;-1; 1" NormDistance = " DCut" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-1; 1" NormDistance = " DCut" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "2 * Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "2 * Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "2 * Pi / 3" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "2 * Pi / 3" />
        <SplitByAxes/>
        <Undo Repeat = "4" />
        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = "Pi/4" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
