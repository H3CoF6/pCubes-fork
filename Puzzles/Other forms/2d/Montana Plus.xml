<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Montana Plus</Name>
        <Menu>Other forms\2d\Montana Plus</Menu>
        <Inventor>Karolis Kairysv</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-11-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10827</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=420192</Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clBlue    := '0000FF';
        clYellow  := 'FFFF00';
        clGreen   := '008000';
        clDeepSky := '00BFFF';
        clOrange  := 'FF6000';
        clPink    := 'FF69B4';
        clWhite   := 'FFFFFF';
        clBlack   := '333333';
        clLime    := '00FF00';

        K := 0.6;
        D1 := K * 0.80;
        D2 := K * 0.65;

        DCut1 := D2 - K * 0.1;
        DCut2 := D1 - K * 0.1;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = " 1;-1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D2" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSegment" >
            <HideAll/>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSegment" Color = "clGreen" />
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "2" From = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clRed" />
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "2" From = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clBlue" />
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "2" From = "1" />
        <Cut Axis = "1" To   = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clPink" />
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "2" From = "1" />
        <Cut Axis = "1" To   = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clOrange" />
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "1" From = "1" />
        <Cut Axis = "2" To   = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clDeepSky" />
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "1" From = "1" />
        <Cut Axis = "2" To   = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clLime" />
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "1" From = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clYellow" />
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "  0" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "  0" /> </Cut>
        <Cut Axis = "1" From = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = " D1" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = " D2" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = " D2" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "1" To   = "1" />
        <Cut Axis = "2" To   = "1" />

        <ExecMacro MacroName = "AddSegment" Color = "clBlack" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1; 0" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1; 0; 0" NormDistance = " DCut1" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 0; 0" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Color = "-2" InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 0" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "-2" InvisibleEdges = "-1"> <Plane NormVector = " 0; 1; 0" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-1; 0" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "2" To = "1" />
        <Cut Color = "-2" InvisibleEdges = "-1"> <Plane NormVector = "-1; 0; 0" NormDistance = "-DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;-1; 0" NormDistance = " DCut1" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clBlack" />
        <Cut Axis = "2" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1; 0" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;-1; 0" NormDistance = " DCut1" /> </Cut>
        <ShowAll/>

        <SplitByAxes/>

        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "1" Angle = " Pi" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = " Pi/2" />
            <SplitByAxes/>
            <Turn Axis = "2" Layer = "1" Angle = " Pi/2" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <Undo Repeat = "12" />

        <RemoveContaining Vector = " K; 0; 0" />
        <RemoveContaining Vector = " 0;-K; 0" />

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut Axis = "1" From = "1" />
        <Cut Axis = "0" To   = "1" />
        <Cut> <Plane NormVector = "-1; 0;-1" NormDistance = "-D1" /> </Cut>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "-D1" /> </Cut>
        <Cut> <Plane NormVector = "-1; 0; 1" NormDistance = "-D1" /> </Cut>

        <ExecMacro MacroName = "AddSegment" Color = "clWhite" />
        <Cut Axis = "2" From = "1" />
        <Cut Axis = "0" To   = "1" />
        <Cut> <Plane NormVector = " 0; 1;-1" NormDistance = "-D1" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "-D1" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 1" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
