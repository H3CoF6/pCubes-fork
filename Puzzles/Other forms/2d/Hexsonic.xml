<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Hexsonic</Name>
        <Menu>Other forms\2d\Hexsonic</Menu>
        <Inventor>Karolis Kairysv</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10854</Link>
    </Interface>

    <Script>
        clRed          := 'C80000';
        clLightBlue    := '0077EE';
        clLightGreen   := '00A600';
        clWhite        := 'FFFFFF';
        clYellow       := 'FFFF00';
        clBlue         := '000078';

        k := 1 / 80;
        p0 := k * 45;
        p1 := k * 48;
        p2 := k * 50;
        p3 := k * 12;
        p4 := k * 30;
        p5 := k * 10;
        p6 := k * 2;
        p7 := k * 46;

        D  := k  * 24 * sqrt(2);

        A1 := Arccos(1/3);
    </Script>

    <Axes TurningAngles = "0; Pi" AvailableAngles = "0; A1; Pi; Pi + A1" PlaneDistances = "D" >
        <Axis NormVector = "1;-1; 0" />
    </Axes>
    <Axes TurningAngles = "0; Pi" AvailableAngles = "-A1; 0; Pi-A1; Pi" PlaneDistances = "D" >
        <Axis NormVector = "0;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " p3;  0; p1" /> Up
                <Add Vector = "  0;-p3; p1" />
                <Add Vector = "-p3;  0; p1" />
                <Add Vector = "  0; p3; p1" />
                <Add Vector = " p5;-p5; p2" />
                <Add Vector = "-p5;-p5; p2" />
                <Add Vector = "-p5; p5; p2" />
                <Add Vector = " p5; p5; p2" />
                <Add Vector = " p4;-p4; p4" /> corners
                <Add Vector = "-p4;-p4; p4" />
                <Add Vector = "-p4; p4; p4" />
                <Add Vector = " p4; p4; p4" />
                <Add Vector = " p1;  0; p3" /> right
                <Add Vector = " p1; p3;  0" />
                <Add Vector = " p1;  0;-p3" />
                <Add Vector = " p1;-p3;  0" />
                <Add Vector = " p2; p5; p5" />
                <Add Vector = " p2; p5;-p5" />
                <Add Vector = " p2;-p5;-p5" />
                <Add Vector = " p2;-p5; p5" />
                <Add Vector = "  0;-p1; p3" /> face
                <Add Vector = " p3;-p1;  0" />
                <Add Vector = "  0;-p1;-p3" />
                <Add Vector = "-p3;-p1;  0" />
                <Add Vector = "-p5;-p2; p5" />
                <Add Vector = "-p5;-p2;-p5" />
                <Add Vector = " p5;-p2;-p5" />
                <Add Vector = " p5;-p2; p5" />
                <Add Vector = "-p1;  0; p3" /> left
                <Add Vector = "-p1;-p3;  0" />
                <Add Vector = "-p1;  0;-p3" />
                <Add Vector = "-p1; p3;  0" />
                <Add Vector = "-p2; p5; p5" />
                <Add Vector = "-p2; p5;-p5" />
                <Add Vector = "-p2;-p5;-p5" />
                <Add Vector = "-p2;-p5; p5" />
                <Add Vector = "  0; p1; p3" /> back
                <Add Vector = "-p3; p1;  0" />
                <Add Vector = "  0; p1;-p3" />
                <Add Vector = " p3; p1;  0" />
                <Add Vector = " p5; p2; p5" />
                <Add Vector = " p5; p2;-p5" />
                <Add Vector = "-p5; p2;-p5" />
                <Add Vector = "-p5; p2; p5" />
                <Add Vector = " p4;-p4;-p4" /> corners
                <Add Vector = "-p4;-p4;-p4" />
                <Add Vector = "-p4; p4;-p4" />
                <Add Vector = " p4; p4;-p4" />
                <Add Vector = " p3;  0;-p1" /> down
                <Add Vector = "  0;-p3;-p1" />
                <Add Vector = "-p3;  0;-p1" />
                <Add Vector = "  0; p3;-p1" />
                <Add Vector = " p5;-p5;-p2" />
                <Add Vector = "-p5;-p5;-p2" />
                <Add Vector = "-p5; p5;-p2" />
                <Add Vector = " p5; p5;-p2" />
                <Add Vector = " p6; p6; p7" /> up
                <Add Vector = " p6;-p6; p7" />
                <Add Vector = "-p6;-p6; p7" />
                <Add Vector = "-p6; p6; p7" />
                <Add Vector = " p7; p6; p6" /> right
                <Add Vector = " p7; p6;-p6" />
                <Add Vector = " p7;-p6;-p6" />
                <Add Vector = " p7;-p6; p6" />
                <Add Vector = " p6;-p7; p6" /> face
                <Add Vector = " p6;-p7;-p6" />
                <Add Vector = "-p6;-p7;-p6" />
                <Add Vector = "-p6;-p7; p6" />
                <Add Vector = "-p7;-p6; p6" /> left
                <Add Vector = "-p7;-p6;-p6" />
                <Add Vector = "-p7; p6;-p6" />
                <Add Vector = "-p7; p6; p6" />
                <Add Vector = "-p6; p7; p6" /> back
                <Add Vector = "-p6; p7;-p6" />
                <Add Vector = " p6; p7;-p6" />
                <Add Vector = " p6; p7; p6" />
                <Add Vector = " p6; p6;-p7" /> down
                <Add Vector = "-p6; p6;-p7" />
                <Add Vector = "-p6;-p6;-p7" />
                <Add Vector = " p6;-p6;-p7" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite     " VertexIndexes = "08;19;12;16;11" InvisibleEdges = "16" />
                <Face Color = "clRed       " VertexIndexes = "00;04;08;11;07" InvisibleEdges = " 4" />
                <Face Color = "clLightGreen" VertexIndexes = "04;01;05;09;24" InvisibleEdges = "16" />
                <Face Color = "clRed       " VertexIndexes = "24;20;27;08;04" InvisibleEdges = "16" />
                <Face Color = "clBlue      " VertexIndexes = "02;06;10;32;28;35;09;05" />
                <Face Color = "clWhite     " VertexIndexes = "19;08;27;21;26" InvisibleEdges = "16" />
                <Face Color = "clLightBlue " VertexIndexes = "26;44;18;15;19" InvisibleEdges = "16" />
                <Face Color = "clBlue      " VertexIndexes = "09;35;29;34;45" InvisibleEdges = "16" />
                <Face Color = "clLightGreen" VertexIndexes = "23;24;09;45;25" InvisibleEdges = " 4" />
                <Face Color = "clYellow    " VertexIndexes = "14;18;44;52;48;55;47;17" />
                <Face Color = "clYellow    " VertexIndexes = "45;53;49;52;44" InvisibleEdges = "16" />
                <Face Color = "clLightBlue " VertexIndexes = "22;25;45;44;26" InvisibleEdges = " 4" />

                <Face Color = "clLightGreen" VertexIndexes = "57;01;04;00" />
                <Face Color = "clLightGreen" VertexIndexes = "58;05;01" InvisibleEdges = "1" />
                <Face Color = "clBlue      " VertexIndexes = "58;02;05" InvisibleEdges = "4" />

                <Face Color = "clLightGreen" VertexIndexes = "57;58;01" />

                <Face Color = "clYellow   " VertexIndexes = "61;14;17;13" />
                <Face Color = "clYellow   " VertexIndexes = "62;18;14" InvisibleEdges = "1" />
                <Face Color = "clLightBlue" VertexIndexes = "62;15;18" InvisibleEdges = "4" />
                <Face Color = "clLightBlue" VertexIndexes = "63;12;19;15" />

                <Face                       VertexIndexes = "63;62;61;60" />
                <Face Color = "clLightBlue" VertexIndexes = "63;60;12" />
                <Face Color = "clLightBlue" VertexIndexes = "62;63;15" />
                <Face Color = "clYellow   " VertexIndexes = "61;62;14" />
                <Face Color = "clYellow   " VertexIndexes = "60;61;13" />

                <Face Color = "clRed  " VertexIndexes = "64;27;20" InvisibleEdges = "1" />
                <Face Color = "clWhite" VertexIndexes = "64;21;27" InvisibleEdges = "4" />
                <Face Color = "clWhite" VertexIndexes = "65;22;26;21" />
                <Face Color = "clRed  " VertexIndexes = "67;20;24;23" />

                <Face                   VertexIndexes = "67;66;65;64" />
                <Face Color = "clRed  " VertexIndexes = "67;64;20" />
                <Face Color = "clRed  " VertexIndexes = "66;67;23" />
                <Face Color = "clWhite" VertexIndexes = "65;66;22" />
                <Face Color = "clWhite" VertexIndexes = "64;65;21" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />

        <SplitByAxes/>
        <Split> <Plane NormVector = " 1; 0; 1" NormDistance = "D" /> </Split>
        <Split> <Plane NormVector = "-1;-1; 0" NormDistance = "D" /> </Split>
        <Split> <Plane NormVector = "-1; 0; 1" NormDistance = "D" /> </Split>
        <Split> <Plane NormVector = " 1; 0;-1" NormDistance = "D" /> </Split>
        <Split> <Plane NormVector = " 0;-1;-1" NormDistance = "D" /> </Split>

        <Turn Axis = "1" Layer = "1" Angle = "-A1" />
        <Turn Axis = "0" Layer = "1" Angle = " A1" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = " A1" />
        <Turn Axis = "0" Layer = "1" Angle = "-A1" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "-A1" />
        <Turn Axis = "0" Layer = "1" Angle = " A1" />
        <SplitByAxes/>
        <Undo Repeat = "6" />
        <Turn Axis = "1" Layer = "1" Angle = " Pi" />
        <Turn Axis = "1" Layer = "1" Angle = "-A1" />
        <Turn Axis = "0" Layer = "1" Angle = " A1" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = " A1" />
        <Turn Axis = "0" Layer = "1" Angle = "-A1" />
        <SplitByAxes/>
        <Undo Repeat = "5" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi" />
        <Turn Axis = "0" Layer = "1" Angle = " A1" />
        <Turn Axis = "1" Layer = "1" Angle = "-A1" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "-A1" />
        <Turn Axis = "1" Layer = "1" Angle = " A1" />
        <SplitByAxes/>
        <Undo Repeat = "5" />

        <SaveSolvedState/>

        <Turn NormVector = " 1; 0;-1" Angle = "ArcTan(1/sqrt(2))" />
        <Turn NormVector = " 0; 1; 0" Angle = "-Pi/4" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
