<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triodism</Name>
        <Menu>Other forms\2d\Triodism</Menu>
        <Inventor>Karolis Kairys</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-01-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10732</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clOrange := 'FF9730';
        clBlack  := '222222';
        clWhite  := 'FFFFFF';

        K := 0.6;

        D2 := K * 0.71029864124335 * 1.05; <!-- C20 * 1.05 -->
        D1 := D2 / sqrt(2);
        D3 := D1 * 0.5;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = "-1;-1; 0" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2" PlaneDistances = "D2" >
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clWhite" />
        <Cut Axis = "0" To  = "1" />
        <Cut Axis = "1" To  = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-1; 0" NormDistance = " D3" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1;-1; 0" NormDistance = " D3" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clWhite" />
        <Cut Axis = "0" To  = "1" />
        <Cut Axis = "1" To  = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; 1; 0" NormDistance = "-D3" /> </Cut>
        <Cut Color = "clWhite"    > <Plane NormVector = "-1;-1; 0" NormDistance = " D3" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clWhite" />
        <Cut Axis = "0" To  = "1" />
        <Cut Axis = "1" To  = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1; 1; 0" NormDistance = "-D3" /> </Cut>
        <Cut Color = "clWhite"    > <Plane NormVector = " 1;-1; 0" NormDistance = " D3" /> </Cut>
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clOrange" />
        <Cut Axis = "2" From  = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clRed" />
        <Cut Axis = "1" From  = "1" />
        <Cut Axis = "2" To  = "1" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack" />
        <Cut Axis = "0" From  = "1" />
        <Cut Axis = "2" To  = "1" />

        <ShowAll/>
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = " Pi/2" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = " Pi/2" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" />
        <Turn Axis = "0" Layer = "1" Angle = " Pi" />
        <Turn Axis = "1" Layer = "1" Angle = " Pi" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = " Pi/2" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" />
        <Turn Axis = "1" Layer = "1" Angle = " Pi" />

        <SaveSolvedState/>

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
