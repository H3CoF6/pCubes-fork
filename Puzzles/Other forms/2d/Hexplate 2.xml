<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexplate 2</Name>
        <Menu>Other forms\2d\Hexplate 2</Menu>
        <Inventor>Wu Yuan</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-12-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11592</Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clGreen   := '007700';
        clDeepSky := '00BFFF';

        K  := 0.14;
        s6 := sqrt(6);
        C0 := K * (3 + s6) / 3;
        C1 := K * (1 + s6);
        C2 := K * (3 + 4 * s6) / 3;
        C3 := K * (1 + s6) * 3 / 2;
        C4 := K;

        D1 := C1 * 2 / sqrt(3);
        D2 := D1 * 2 / s6;
    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D1" FixedLayers = "0">
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D2" FixedLayers = "0">
        <Axis NormVector = " 0;-1; 1" />
        <Axis NormVector = "-4;-1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "CreateShape" > <!-- Truncated Tetrakis Hexahedron -->
            <Part>
                <Vertices>
                    <Add Vector = "  0;  0; C3" />
                    <Add Vector = "  0;  0;-C3" />
                    <Add Vector = " C3;  0;  0" />
                    <Add Vector = "-C3;  0;  0" />
                    <Add Vector = "  0; C3;  0" />
                    <Add Vector = "  0;-C3;  0" />
                    <Add Vector = " C0; C0; C2" />
                    <Add Vector = " C0; C0;-C2" />
                    <Add Vector = " C0;-C0; C2" />
                    <Add Vector = " C0;-C0;-C2" />
                    <Add Vector = "-C0; C0; C2" />
                    <Add Vector = "-C0; C0;-C2" />
                    <Add Vector = "-C0;-C0; C2" />
                    <Add Vector = "-C0;-C0;-C2" />
                    <Add Vector = " C2; C0; C0" />
                    <Add Vector = " C2; C0;-C0" />
                    <Add Vector = " C2;-C0; C0" />
                    <Add Vector = " C2;-C0;-C0" />
                    <Add Vector = "-C2; C0; C0" />
                    <Add Vector = "-C2; C0;-C0" />
                    <Add Vector = "-C2;-C0; C0" />
                    <Add Vector = "-C2;-C0;-C0" />
                    <Add Vector = " C0; C2; C0" />
                    <Add Vector = " C0; C2;-C0" />
                    <Add Vector = " C0;-C2; C0" />
                    <Add Vector = " C0;-C2;-C0" />
                    <Add Vector = "-C0; C2; C0" />
                    <Add Vector = "-C0; C2;-C0" />
                    <Add Vector = "-C0;-C2; C0" />
                    <Add Vector = "-C0;-C2;-C0" />
                    <Add Vector = " C1; C4; C1" />
                    <Add Vector = " C1; C4;-C1" />
                    <Add Vector = " C1;-C4; C1" />
                    <Add Vector = " C1;-C4;-C1" />
                    <Add Vector = "-C1; C4; C1" />
                    <Add Vector = "-C1; C4;-C1" />
                    <Add Vector = "-C1;-C4; C1" />
                    <Add Vector = "-C1;-C4;-C1" />
                    <Add Vector = " C1; C1; C4" />
                    <Add Vector = " C1; C1;-C4" />
                    <Add Vector = " C1;-C1; C4" />
                    <Add Vector = " C1;-C1;-C4" />
                    <Add Vector = "-C1; C1; C4" />
                    <Add Vector = "-C1; C1;-C4" />
                    <Add Vector = "-C1;-C1; C4" />
                    <Add Vector = "-C1;-C1;-C4" />
                    <Add Vector = " C4; C1; C1" />
                    <Add Vector = " C4; C1;-C1" />
                    <Add Vector = " C4;-C1; C1" />
                    <Add Vector = " C4;-C1;-C1" />
                    <Add Vector = "-C4; C1; C1" />
                    <Add Vector = "-C4; C1;-C1" />
                    <Add Vector = "-C4;-C1; C1" />
                    <Add Vector = "-C4;-C1;-C1" />
                </Vertices>

                <Faces>
                    <Face Color = "Color" VertexIndexes = " 6;30;14;38;22;46" />
                    <Face Color = "Color" VertexIndexes = " 7;47;23;39;15;31" />
                    <Face Color = "Color" VertexIndexes = " 8;48;24;40;16;32" />
                    <Face Color = "Color" VertexIndexes = " 9;33;17;41;25;49" />
                    <Face Color = "Color" VertexIndexes = "10;50;26;42;18;34" />
                    <Face Color = "Color" VertexIndexes = "11;35;19;43;27;51" />
                    <Face Color = "Color" VertexIndexes = "12;36;20;44;28;52" />
                    <Face Color = "Color" VertexIndexes = "13;53;29;45;21;37" />

                    <Face Color = "Color" VertexIndexes = " 0; 6;46;50;10" />
                    <Face Color = "Color" VertexIndexes = " 0;10;34;36;12" />
                    <Face Color = "Color" VertexIndexes = " 0;12;52;48; 8" />
                    <Face Color = "Color" VertexIndexes = " 0; 8;32;30; 6" />

                    <Face Color = "Color" VertexIndexes = " 1; 7;31;33; 9" />
                    <Face Color = "Color" VertexIndexes = " 1; 9;49;53;13" />
                    <Face Color = "Color" VertexIndexes = " 1;13;37;35;11" />
                    <Face Color = "Color" VertexIndexes = " 1;11;51;47; 7" />

                    <Face Color = "Color" VertexIndexes = " 2;14;30;32;16" />
                    <Face Color = "Color" VertexIndexes = " 2;16;40;41;17" />
                    <Face Color = "Color" VertexIndexes = " 2;17;33;31;15" />
                    <Face Color = "Color" VertexIndexes = " 2;15;39;38;14" />

                    <Face Color = "Color" VertexIndexes = " 3;18;42;43;19" />
                    <Face Color = "Color" VertexIndexes = " 3;19;35;37;21" />
                    <Face Color = "Color" VertexIndexes = " 3;21;45;44;20" />
                    <Face Color = "Color" VertexIndexes = " 3;20;36;34;18" />

                    <Face Color = "Color" VertexIndexes = " 4;22;38;39;23" />
                    <Face Color = "Color" VertexIndexes = " 4;23;47;51;27" />
                    <Face Color = "Color" VertexIndexes = " 4;27;43;42;26" />
                    <Face Color = "Color" VertexIndexes = " 4;26;50;46;22" />

                    <Face Color = "Color" VertexIndexes = " 5;24;48;52;28" />
                    <Face Color = "Color" VertexIndexes = " 5;28;44;45;29" />
                    <Face Color = "Color" VertexIndexes = " 5;29;53;49;25" />
                    <Face Color = "Color" VertexIndexes = " 5;25;41;40;24" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "CreateShape" Color = "clGreen" />
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = " D2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-D1" /> </Cut>
        <Turn NormVector = "1;1;-1" Angle = "Pi" />
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clDeepSky" />
        <Cut> <Plane NormVector = " 0;-1; 1" NormDistance = " D2" /> </Cut>
        <Cut> <Plane NormVector = " 1; 1;-1" NormDistance = "-D1" /> </Cut>
        <HideAll/>

        <ExecMacro MacroName = "CreateShape" Color = "clRed" />
        <Cut> <Plane NormVector = "-1;-1; 1" NormDistance = " D1" /> </Cut>
        <ShowAll/>

        <Macro Name = "UnbandageF" >
            <SplitByAxes/>
            <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
            <SplitByAxes/>
            <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "UnbandageF" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <ExecMacro MacroName = "UnbandageF" />
        <Undo/>

        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <ExecMacro MacroName = "UnbandageF" />
        <Undo/>

        <SaveSolvedState/>

        <!-- Aliases -->
        <Macro Name = "F3" > <Turn Axis = "0" Layers = "1" Angle = "Pi" /> </Macro>
        <Macro Name = "L"  > <Turn Axis = "1" Layers = "1" Angle = "Pi" /> </Macro>
        <Macro Name = "R"  > <Turn Axis = "2" Layers = "1" Angle = "Pi" /> </Macro>

        <ExecMacro MacroName = "R L F3 R F3 L F3 L" />
        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = "Pi/4" />
        <Turn NormVector = "0;0;1" Angle = "Arcsin(1/sqrt(3))" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
