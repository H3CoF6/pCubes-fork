<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexa-Corner</Name>
        <Menu>Other forms\2d\Hexa-Corner</Menu>
        <Inventor>Nathan Wilson</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-22</Added>
        <Link>https://www.youtube.com/watch?v=b_DZ4YTFSZI</Link>
    </Interface>

    <Script>
        Colors[0] := 'FE0000'; // Red
        Colors[1] := 'FF8800'; // Orange
        Colors[2] := '0066FF'; // Blue
        Colors[3] := '00DD00'; // Green
        Colors[4] := 'FFEE00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.5;
        A := W * 1.2;
        B := W * 0.35;

        phi := (Sqrt(5) - 1) / 2; // The golden ratio

        D := W * 0.93;
        RCut := W * 0.05;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "   0;   1;-phi" />
        <Axis NormVector = "   0;  -1;-phi" />
        <Axis NormVector = "-phi;   0;   1" />
        <Axis NormVector = "-phi;   0;  -1" />
        <Axis NormVector = "  -1; phi;   0" />
        <Axis NormVector = "  -1;-phi;   0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "3" Layer = "0" />
        <Hide Axis = "4" Layer = "0" />

        <RemoveAllVisible/>

        <Script>
            for i := 0 to 5 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />

        <Cut Axis = "0" From = "1" />
        <Cut Axis = "3" From = "1" />
        <Cut Axis = "4" From = "1" />

        <ShowAll/>

        <Cut> <Plane NormVector = " 1;-1; 1" NormDistance = "-RCut" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
