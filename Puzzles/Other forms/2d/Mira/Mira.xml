<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mira</Name>
        <Menu>Other forms\2d\Mira\Mira</Menu>
        <Inventor>Dmitry Andreev</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-11-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7177</Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clGreen   := '008000';
        clWhite   := 'FFFFFF';
        clBlack   := '333333';

        K := 0.6;
        phi := (sqrt(5) - 1) / 2; // The golden ratio

        C21 := K * 0.3569761362781;
        C63 := K * 0.9345756579487;
        D1 := C63 / sqrt(1 + phi^2);
        D2 := (C21 + C63 * (phi + 1)) / 2;
        DCut := D1 - K * 0.05;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/5" PlaneDistances = "D1" >
        <Axis NormVector = "0;  -1; phi" />
        <Axis NormVector = "1;-phi;   0" />
    </Axes>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D2" >
        <Axis NormVector = "1;-phi-1; phi" />
    </Axes>

    <Figure>
        <Macro Name = "AddSphere" >
            <HideAll/>
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSphere" Color = "clRed" />
        <Cut Axis = "0" From = "1" />
        <Cut Axis = "2" To = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clGreen" />
        <Cut Axis = "1" From = "1" />
        <Cut Axis = "2" To = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clWhite" />
        <Cut Axis = "2" From = "1" />

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; phi;   0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;  -1; phi" NormDistance = " DCut" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;  -1; phi" NormDistance = " DCut" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-phi;   0" NormDistance = " DCut" /> </Cut>

        <ExecMacro MacroName = "AddSphere" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;   1;-phi" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-phi;   0" NormDistance = " DCut" /> </Cut>

        <ShowAll/>

        <Macro Name = "Unbandage" >
            <SplitByAxes/>
            <Turn Axis = "0" Layer = "1" Angle = "2*Pi/5" />
            <SplitByAxes/>
            <Turn Axis = "1" Layer = "1" Angle = "2*Pi/5" />
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "5" />
        <Undo Repeat = "10" />

        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = "ArcTan(phi)" />
        <Turn NormVector = "0;1;0" Angle = "-Pi/10" />
        <Turn NormVector = "0;0;1" Angle = "-ArcTan(phi)" /> <!-- = ArcTan(2)/2 -->

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
