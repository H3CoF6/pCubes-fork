<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Lemon Wheel</Name>
        <Menu>Other forms\2d\Lemon Wheel</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-09-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[1] := 'FFFF00'; // Yellow
        Colors[2] := '0000FF'; // Blue
        Colors[3] := 'FF0000'; // Red
        Colors[4] := '008000'; // Green
        Colors[5] := 'F0F0F0'; // White
        Colors[6] := '202020'; // Black

        K  := 0.12;
        s6 := sqrt(6);
        C0 := K * (3 + s6) / 3;
        C1 := K * (1 + s6);
        C2 := K * (3 + 4 * s6) / 3;
        C3 := K * 3 * (1 + s6) / 2;
        C4 := K;

        D1 := K * (3 + 2 * s6) / 3;
        D2 := K * (6 + 5 * s6) * sqrt(5) / 10;
        D3 := K * (1 + 2 * s6) / sqrt(3);
        D4 := D2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "D1" FixedLayers = "0">
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D2" FixedLayers = "0">
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Figure>
        <Macro Name = "CreateBody" >
            <Part>
                <Vertices>
                    <Add Vector = "  0;  0; C3" />
                    <Add Vector = "  0;  0;-C3" />
                    <Add Vector = " C3;  0;  0" />
                    <Add Vector = "-C3;  0;  0" />
                    <Add Vector = "  0; C3;  0" />
                    <Add Vector = "  0;-C3;  0" />
                    <Add Vector = " C0; C0; C2" />
                    <Add Vector = " C0; C0;-C2" />
                    <Add Vector = " C0;-C0; C2" />
                    <Add Vector = " C0;-C0;-C2" />
                    <Add Vector = "-C0; C0; C2" />
                    <Add Vector = "-C0; C0;-C2" />
                    <Add Vector = "-C0;-C0; C2" />
                    <Add Vector = "-C0;-C0;-C2" />
                    <Add Vector = " C2; C0; C0" />
                    <Add Vector = " C2; C0;-C0" />
                    <Add Vector = " C2;-C0; C0" />
                    <Add Vector = " C2;-C0;-C0" />
                    <Add Vector = "-C2; C0; C0" />
                    <Add Vector = "-C2; C0;-C0" />
                    <Add Vector = "-C2;-C0; C0" />
                    <Add Vector = "-C2;-C0;-C0" />
                    <Add Vector = " C0; C2; C0" />
                    <Add Vector = " C0; C2;-C0" />
                    <Add Vector = " C0;-C2; C0" />
                    <Add Vector = " C0;-C2;-C0" />
                    <Add Vector = "-C0; C2; C0" />
                    <Add Vector = "-C0; C2;-C0" />
                    <Add Vector = "-C0;-C2; C0" />
                    <Add Vector = "-C0;-C2;-C0" />
                    <Add Vector = " C1; C4; C1" />
                    <Add Vector = " C1; C4;-C1" />
                    <Add Vector = " C1;-C4; C1" />
                    <Add Vector = " C1;-C4;-C1" />
                    <Add Vector = "-C1; C4; C1" />
                    <Add Vector = "-C1; C4;-C1" />
                    <Add Vector = "-C1;-C4; C1" />
                    <Add Vector = "-C1;-C4;-C1" />
                    <Add Vector = " C1; C1; C4" />
                    <Add Vector = " C1; C1;-C4" />
                    <Add Vector = " C1;-C1; C4" />
                    <Add Vector = " C1;-C1;-C4" />
                    <Add Vector = "-C1; C1; C4" />
                    <Add Vector = "-C1; C1;-C4" />
                    <Add Vector = "-C1;-C1; C4" />
                    <Add Vector = "-C1;-C1;-C4" />
                    <Add Vector = " C4; C1; C1" />
                    <Add Vector = " C4; C1;-C1" />
                    <Add Vector = " C4;-C1; C1" />
                    <Add Vector = " C4;-C1;-C1" />
                    <Add Vector = "-C4; C1; C1" />
                    <Add Vector = "-C4; C1;-C1" />
                    <Add Vector = "-C4;-C1; C1" />
                    <Add Vector = "-C4;-C1;-C1" />
                </Vertices>

                <Faces>
                    <Face Color = "Color" VertexIndexes = " 6; 30; 14; 38; 22; 46" />
                    <Face Color = "Color" VertexIndexes = " 7; 47; 23; 39; 15; 31" />
                    <Face Color = "Color" VertexIndexes = " 8; 48; 24; 40; 16; 32" />
                    <Face Color = "Color" VertexIndexes = " 9; 33; 17; 41; 25; 49" />
                    <Face Color = "Color" VertexIndexes = "10; 50; 26; 42; 18; 34" />
                    <Face Color = "Color" VertexIndexes = "11; 35; 19; 43; 27; 51" />
                    <Face Color = "Color" VertexIndexes = "12; 36; 20; 44; 28; 52" />
                    <Face Color = "Color" VertexIndexes = "13; 53; 29; 45; 21; 37" />

                    <Face Color = "Color" VertexIndexes = " 0;  6; 46; 50; 10" />
                    <Face Color = "Color" VertexIndexes = " 0; 10; 34; 36; 12" />
                    <Face Color = "Color" VertexIndexes = " 0; 12; 52; 48;  8" />
                    <Face Color = "Color" VertexIndexes = " 0;  8; 32; 30;  6" />

                    <Face Color = "Color" VertexIndexes = " 1;  7; 31; 33;  9" />
                    <Face Color = "Color" VertexIndexes = " 1;  9; 49; 53; 13" />
                    <Face Color = "Color" VertexIndexes = " 1; 13; 37; 35; 11" />
                    <Face Color = "Color" VertexIndexes = " 1; 11; 51; 47;  7" />

                    <Face Color = "Color" VertexIndexes = " 2; 14; 30; 32; 16" />
                    <Face Color = "Color" VertexIndexes = " 2; 16; 40; 41; 17" />
                    <Face Color = "Color" VertexIndexes = " 2; 17; 33; 31; 15" />
                    <Face Color = "Color" VertexIndexes = " 2; 15; 39; 38; 14" />

                    <Face Color = "Color" VertexIndexes = " 3; 18; 42; 43; 19" />
                    <Face Color = "Color" VertexIndexes = " 3; 19; 35; 37; 21" />
                    <Face Color = "Color" VertexIndexes = " 3; 21; 45; 44; 20" />
                    <Face Color = "Color" VertexIndexes = " 3; 20; 36; 34; 18" />

                    <Face Color = "Color" VertexIndexes = " 4; 22; 38; 39; 23" />
                    <Face Color = "Color" VertexIndexes = " 4; 23; 47; 51; 27" />
                    <Face Color = "Color" VertexIndexes = " 4; 27; 43; 42; 26" />
                    <Face Color = "Color" VertexIndexes = " 4; 26; 50; 46; 22" />

                    <Face Color = "Color" VertexIndexes = " 5; 24; 48; 52; 28" />
                    <Face Color = "Color" VertexIndexes = " 5; 28; 44; 45; 29" />
                    <Face Color = "Color" VertexIndexes = " 5; 29; 53; 49; 25" />
                    <Face Color = "Color" VertexIndexes = " 5; 25; 41; 40; 24" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "Unbandage" >
            <Turn Axis = "ax" Layer = "1" Angle = "Pi/3" />
            <Split Axis = "0" From = "1" />
        </Macro>
        <Macro Name = "AddColor" >
            <ExecMacro MacroName = "CreateBody" Color = "Colors[ax]" />
            <Cut Axis = "ax" From = "1" />
            <ExecMacro MacroName = "Unbandage" Repeat = "6" />
            <HideAll/>
            <Script>Inc(ax);</Script>
        </Macro>
        <ExecMacro MacroName = "AddColor" ax = "1" Repeat = "4" />

        <ExecMacro MacroName = "CreateBody" Color = "Colors[6]" />
        <Cut Axis = "0" From = "1" Color = "Colors[5]"/>
        <Cut Axis = "1" To   = "1" />
        <Cut Axis = "2" To   = "1" />
        <Cut Axis = "3" To   = "1" />
        <Cut Axis = "4" To   = "1" />
        <HideAll/>

        <ExecMacro MacroName = "CreateBody" Color = "Colors[5]" />
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <Split InvisibleEdges2 = "-1"> <Plane NormDistance = "D3" NormVector = " 1;-1;-1" /> </Split>
        <Split InvisibleEdges2 = "-1"> <Plane NormDistance = "D3" NormVector = "-1;-1; 1" /> </Split>
        <Split Color1 = "Colors[5]"  > <Plane NormDistance = "D3" NormVector = " 1;-1; 1" /> </Split>
        <Split Color1 = "Colors[5]"  > <Plane NormDistance = "D3" NormVector = "-1;-1;-1" /> </Split>
        <HideContaining Vector = " D4;-D4; D4" />
        <HideContaining Vector = "-D4;-D4;-D4" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "CreateBody" Color = "Colors[5]" />
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <Split InvisibleEdges2 = "-1"> <Plane NormDistance = "D3" NormVector = " 1;-1; 1" /> </Split>
        <Split InvisibleEdges2 = "-1"> <Plane NormDistance = "D3" NormVector = "-1;-1;-1" /> </Split>
        <Split Color1 = "Colors[5]"  > <Plane NormDistance = "D3" NormVector = " 1;-1;-1" /> </Split>
        <Split Color1 = "Colors[5]"  > <Plane NormDistance = "D3" NormVector = "-1;-1; 1" /> </Split>
        <HideContaining Vector = " D4;-D4;-D4" />
        <HideContaining Vector = "-D4;-D4; D4" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "CreateBody" Color = "Colors[5]" />
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />
        <RemoveAllVisible/>
        <ShowAll/>
        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <Split InvisibleEdges1 = "-1"> <Plane NormDistance = "D3" NormVector = " 1;-1; 1" /> </Split>
        <Split InvisibleEdges1 = "-1"> <Plane NormDistance = "D3" NormVector = "-1;-1;-1" /> </Split>
        <Split InvisibleEdges1 = "-1"> <Plane NormDistance = "D3" NormVector = " 1;-1;-1" /> </Split>
        <Split InvisibleEdges1 = "-1"> <Plane NormDistance = "D3" NormVector = "-1;-1; 1" /> </Split>
        <RemoveContaining Vector = " D4;-D4; D4" />
        <RemoveContaining Vector = "-D4;-D4;-D4" />
        <RemoveContaining Vector = " D4;-D4;-D4" />
        <RemoveContaining Vector = "-D4;-D4; D4" />
        <RemoveContaining Vector = "  0;  0;  0" />
        <ShowAll/>

        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
