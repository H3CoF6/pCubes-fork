        <!-- Rotate Decagonal Faces and Unbandage -->
        <Macro Name = "Unbandage" >
            <Turn  Axis = "0" Layer = "1" Angle = "Pi/5" />
            <Turn  Axis = "1" Layer = "1" Angle = "Pi/5" />
            <SplitByAxes/>
        </Macro>

        <!-- Hide Edge Pieces and Turn -->
        <Macro Name = "Hide" >
            <HideContaining Vector = " C4; -C12*0.95; C3" />
            <HideContaining Vector = " C8; -C10*0.95; C1" />
            <Turn  Axis = "0" Layer = "1" Angle = "Pi/5" />
            <Turn  Axis = "1" Layer = "1" Angle = "Pi/5" />
        </Macro>

        <!-- Create Blue Body and Keep Needed Parts -->
        <ExecMacro MacroName = "CreateBody" Color = "clBlue" />
        <SplitByAxes/>
        <RemoveContaining Vector = " 0;    0;  0" />
        <RemoveContaining Vector = "C6; -C6 ; C6" />
        <RemoveContaining Vector = "C8; -C10; C1" />
        <HideAll/>

        !-- Create Orange Body and Keep Needed Parts -->
        <ExecMacro MacroName = "CreateBody" Color = "clOrange" />
        <SplitByAxes/>
        <RemoveContaining Vector = " 0;    0;  0" />
        <RemoveContaining Vector = "C2; -C13;  0" />
        <RemoveContaining Vector = "C4; -C12; C3" />
        <ShowAll/>
 
        <!-- Unbandage Puzzle -->
        <ExecMacro MacroName = "Unbandage" Repeat = "7" />
        <Undo Repeat = "14"/>

        <!-- Hide Centers and Edges -->
        <ExecMacro MacroName = "Hide" Repeat = "10" />
        <HideContaining Vector = " 0; -f*R; R" />
        <HideContaining Vector = " f*R; -R; 0" />

        <!-- Apply Wedge Cut to Set Numeral Order -->
        <Cut Color = "clBlue"   > <Plane NormVector = " d; f; -1" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clOrange" > <Plane NormVector = "-f; 1;  d" NormDistance = "-DCut1" /> </Cut>

        <!-- Create Puzzle Frame -->
        <HideAll/>
        <ExecMacro MacroName = "CreateBody" Color = "clWhite" />
        <Split> <Plane NormDistance = "DCut3" NormVector = "  0;  -f;  1" /> </Split>
        <Split> <Plane NormDistance = "DCut3" NormVector = "  f;  -1;  0" /> </Split>
        <Cut>   <Plane NormDistance = "-D1"   NormVector = "  0;   f; -1" /> </Cut>
        <Cut>   <Plane NormDistance = "-D1"   NormVector = " -f;   1;  0" /> </Cut>
        <Cut>   <Plane NormDistance = "-D2"   NormVector = "-C6;  C6;-C6" /> </Cut>
        <Cut>   <Plane NormDistance = "-D2"   NormVector = "-C2; C13;  0" /> </Cut>
        <RemoveContaining Vector = "0; 0; 0" />
        <ShowAll/>

        <Hide Axis = "0" Layer = "0"/>
        <Cut Color = "clBlack"> <Plane NormVector = " 0; -f; 1" NormDistance = "DCut2" /> </Cut>
        <ShowAll/>

        <Turn NormVector = "1;0;0" Angle = " Pi / 180 * 20" />
        <Turn NormVector = "0;0;1" Angle = "-Pi / 180 * 30" />
        <Turn NormVector = "0;1;0" Angle = "-Pi / 180 * 21.35" />
        <Turn NormVector = "1;0;0" Angle = "-Pi / 180 * 20" />
