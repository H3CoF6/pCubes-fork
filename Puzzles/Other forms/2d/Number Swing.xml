    <Script>
        clBlue   := '0000FF';
        clOrange := 'FF6000';
        clWhite  := 'FFFFFF';
        clBlack  := '000000';

        K  := 0.082;
        s5 := sqrt(5);
        C0  := K * ( 10 +              sqrt(  50 -  10 * s5)) / 10;
        C1  := K *                     sqrt(  10 +   2 * s5)  /  2;
        C2  := K * ( 15 -     s5 + 4 * sqrt( 125 +  10 * s5)) / 22;
        C3  := K * (  2 +              sqrt(  10 +   2 * s5)) /  2;
        C4  := K *                     sqrt(   5 +   2 * s5);
        C5  := K * (  5 + 5 * s5 + 4 * sqrt(  25 +  10 * s5)) / 10;
        C6  := K * (  5 + 7 * s5 + 2 * sqrt( 850 + 310 * s5)) / 22;
        C7  := K * ( 10 +              sqrt( 650 + 290 * s5)) / 10;
        C8  := K * (  1 +     s5 + 2 * sqrt(   5 +   2 * s5)) /  2;
        C9  := K * (  5 + 5 * s5 +     sqrt( 850 + 310 * s5)) / 10;
        C10 := K * (  2 +              sqrt(  50 +  22 * s5)) /  2;
        C11 := K * (  5 +          4 * sqrt(  25 +  10 * s5)) /  5;
        C12 := K * (  1 +     s5 +     sqrt(  50 +  22 * s5)) /  2;
        C13 := K * ( 10 + 3 * s5 +     sqrt(2050 + 890 * s5)) / 11;
        C14 := K * (  5 + 5 * s5 + 2 * sqrt( 425 + 190 * s5)) / 10;
        C15 := K * (  1 +     s5 + 4 * sqrt(   5 +   2 * s5)) /  2;
        C16 := K;

        f := (1 + s5) / 2; // golden ratio

        D1 := K * (3 + s5 + sqrt(1 + 2 / s5)); <!-- Decagonal Axes Cut -->
        D2 := (C3 + C4 + C12) / sqrt(3); <!-- Triangular Axes Cut -->

        SCut := K * (3 + s5 + sqrt((5 + s5) /  2)); <!-- Decagonal Face Height -->

        DCut1 := SCut - K * 0.0050; <!-- Numeral Wedge Cut -->
        DCut2 := D1   + K * 0.0040; <!-- Blue Side Cut -->
        DCut3 := K * (50 + 26 * s5 + sqrt(410 + 178 * s5)) / 22; <!-- Core Cut From Below -->

        d := K * 0.01;
        R := K * 3.5;
    </Script>

