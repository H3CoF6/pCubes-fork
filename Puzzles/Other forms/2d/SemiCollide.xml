<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>SemiCollide</Name>
        <Menu>Other forms\Sphere\SemiCollide</Menu>
        <Menu>Other forms\2d\SemiCollide</Menu>
        <Inventor>Karolis Kairys</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-02-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10834</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clBlue   := '00BFFF';
        clYellow := 'FFFF00';
        clGreen  := '007700';
        clWhite  := 'FFFFFF';
        clBlack  := '333333';

        K := 0.6;
        D := K * 0.7;

        D1 := K * 0.8;
        D2 := K * 0.1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlue"/>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Split>
        <HideContaining Vector = " 0; 0; K" />
        <HideContaining Vector = " D; 0; D" />
        <HideContaining Vector = "-D; 0; D" />
        <HideContaining Vector = " 0; D; D" />
        <HideContaining Vector = " 0;-D; D" />
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clRed"/>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Split>
        <HideContaining Vector = " D;-D; 0" />
        <HideContaining Vector = "-D; D; 0" />
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clYellow"/>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Split>
        <HideContaining Vector = " D; D; 0" />
        <HideContaining Vector = "-D;-D; 0" />
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clGreen"/>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1"> <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Split>
        <HideContaining Vector = " 0; 0;-K" />
        <HideContaining Vector = " D; 0;-D" />
        <HideContaining Vector = "-D; 0;-D" />
        <HideContaining Vector = " 0; D;-D" />
        <HideContaining Vector = " 0;-D;-D" />
        <RemoveAllVisible/>

        <ShowAll/>
        <SplitByAxes/>
        <Hide Axis = "0" Layer = "0" />
        <Hide Axis = "0" Layer = "2" />
        <Hide Axis = "1" Layer = "0" />
        <Hide Axis = "1" Layer = "2" />
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clBlack"/>
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; K" />
        <RemoveAllVisible/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "clWhite"/>
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0;-K" />
        <RemoveAllVisible/>

        <ShowAll/>

        <Macro Name = "Unbandage" >
            <Turn Axis = "0" Layer = "0" Angle = "Pi/2" />
            <Turn Axis = "0" Layer = "2" Angle = "Pi/2" />
            <Turn Axis = "1" Layer = "0" Angle = "Pi/2" />
            <Turn Axis = "1" Layer = "2" Angle = "Pi/2" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <RemoveContaining Vector = " K; 0; 0" />
        <RemoveContaining Vector = "-K; 0; 0" />
        <RemoveContaining Vector = " 0; K; 0" />
        <RemoveContaining Vector = " 0;-K; 0" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" Color = "-1"/>
        <SplitByAxes/>
        <ExecMacro MacroName = "Unbandage" Repeat = "4" />
        <HideContaining Vector = " K; 0; 0" />
        <HideContaining Vector = "-K; 0; 0" />
        <HideContaining Vector = " 0; K; 0" />
        <HideContaining Vector = " 0;-K; 0" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
