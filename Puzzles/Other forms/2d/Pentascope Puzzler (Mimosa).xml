<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentascope Puzzler (Mimosa)</Name>
        <Menu>Other forms\2d\Pentascope Puzzler (Mimosa)</Menu>
        <Inventor>Dmitry Andreev + Evgeniy Grigoriev</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-09-27</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8034</Link>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?t=39579</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clGreen  := '007700';
        clBlue   := '0000FF';
        clWhite  := 'FFFFFF';
        clBlack  := '333333';

        K := 0.6;
        phi := (sqrt(5) - 1) / 2; // The golden ratio
        C63 := K * 0.9345756579487;
        D1 := C63 / sqrt(1 + Phi^2);
        D2 := K * 0.774;

        DCut1 := D1 - K * 0.05;
        DCut2 := D2 - K * 0.05;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/5" PlaneDistances = "D1" >
        <Axis NormVector = "0;-1; phi" />
    </Axes>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D2" >
        <Axis NormVector = "1;-phi-1; phi" />
    </Axes>

    <Figure>
        // definitions
        <Macro Name = "A"  > <Turn Axis = "0" Layer  = "1" Angle = "-2 * Pi / 5" /> </Macro>
        <Macro Name = "B"  > <Turn Axis = "1" Layer  = "1" Angle = "     Pi    " /> </Macro>
        <Macro Name = "CutA-"  > <Cut Axis = "0" To   = "1" /> </Macro>
        <Macro Name = "CutA+"  > <Cut Axis = "0" From = "1" /> </Macro>
        <Macro Name = "CutB-"  > <Cut Axis = "1" To   = "1" /> </Macro>
        <Macro Name = "CutB+"  > <Cut Axis = "1" From = "1" /> </Macro>
        <Macro Name = "SplitA" > <Split Axis = "0" From = "1" /> </Macro>
        <Macro Name = "SplitB" > <Split Axis = "1" From = "1" /> </Macro>
        <Macro Name = "Undo" > <Undo /> </Macro>

        <Macro Name = "AddSphere" >
            <HideAll/>
            <Script>
                for i := 0 to 11 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Megaminx_Sphere.xml" />
        </Macro>

        <ExecMacro MacroName = "AddSphere CutB-" Color = "clBlack" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;     1;-phi" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 1;-phi-1; phi" NormDistance = " DCut2" /> </Cut>

        <ExecMacro MacroName = "AddSphere CutA- CutB-" Color = "clBlack" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 1;-phi-1; phi" NormDistance = " DCut2" /> </Cut>
        <Cut InvisibleEdges = "-1"> <Plane NormVector = " 0;    -1; phi" NormDistance = " DCut1" /> </Cut>

        <ExecMacro MacroName = "AddSphere CutA-" Color = "clBlack" />
        <Cut InvisibleEdges = "-1"> <Plane NormVector = "-1; phi+1;-phi" NormDistance = "-DCut2" /> </Cut>
        <Cut Color = "clBlack"    > <Plane NormVector = " 0;    -1; phi" NormDistance = " DCut1" /> </Cut>

        <ExecMacro MacroName = "AddSphere CutA+ CutB-             " Color = "clYellow" />
        <ExecMacro MacroName = "AddSphere CutA+ CutB+ B CutA- Undo" Color = "clGreen" />
        <ExecMacro MacroName = "AddSphere CutA- CutB+ B CutA+ Undo" Color = "clBlue" />
        <ExecMacro MacroName = "AddSphere CutB+ CutA- B CutA- Undo" Color = "clWhite" />
        <ExecMacro MacroName = "AddSphere CutB+ CutA+ B CutA+ Undo" Color = "clWhite" />

        <ShowAll/>

        <ExecMacro MacroName = "SplitA A SplitB B" Repeat = "12" />
        <Undo Repeat = "24" />

        <SaveSolvedState/>

        <Turn NormVector = "1;0;0" Angle = " ArcTan(phi)" />
        <Turn NormVector = "0;1;0" Angle = "-Pi/10" />
        <Turn NormVector = "0;0;1" Angle = "-ArcTan(phi) / 2" />

        // default turn for every puzzle in pCubes
        <Turn NormVector = "1;0;0" Angle = "-20 * Pi/180" />
        <Turn NormVector = "0;0;1" Angle = " 30 * Pi/180" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
