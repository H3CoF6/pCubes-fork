<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octagonal Edges A528A00145C03 Extended</Name>
        <Menu>Other forms\3x3x3 variants\Octagonal Edges A528A00145C03 Extended</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3783</Link>
    </Interface>

    <Script>
        Colors[6] := '999999'; // Gray
        Colors[7] := 'B200FF'; // Violett

        W := 0.45;
        D := W / 3;
        RCut := W * 2 * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W = "W * 10" />

        <Cut Color = "Colors[0]"><Plane NormVector = " 0; 1;-1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[1]"><Plane NormVector = " 0; 1; 1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[2]"><Plane NormVector = "-1; 0; 1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[3]"><Plane NormVector = " 1; 0;-1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[4]"><Plane NormVector = "-1;-1; 0" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[5]"><Plane NormVector = " 1;-1; 0" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[6]"><Plane NormVector = " 1; 0; 1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[7]"><Plane NormVector = "-1; 0;-1" NormDistance = "-RCut" /></Cut>

        <SplitByAxes/>
    </Figure>
</xml>
