<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cake</Name>
        <Menu>Other forms\3x3x3 variants\Cylinder\Cake</Menu>
        <Inventor>Yuxin</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-11-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2126</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clYellow := 'FFFF00';
        clGreen  := '009600';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/8; 1/8" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Cylinder Radius = "0.5" Color = "clGreen" >
               <Base X = "0" Y = "0" Z = "-3/8" Color = "clGreen" />
               <Top  X = "0" Y = "0" Z = "-1/8" Color = "clGreen" />
        </Cylinder>
        <Cylinder Radius = "0.4" Color = "clYellow" >
               <Base X = "0" Y = "0" Z = "-1/8" Color = "clYellow" />
               <Top  X = "0" Y = "0" Z = " 1/8" Color = "clYellow" />
        </Cylinder>
        <Cylinder Radius = "0.3" Color = "clRed" >
               <Base X = "0" Y = "0" Z = " 1/8" Color = "clRed" />
               <Top  X = "0" Y = "0" Z = " 3/8" Color = "clRed" />
        </Cylinder>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
