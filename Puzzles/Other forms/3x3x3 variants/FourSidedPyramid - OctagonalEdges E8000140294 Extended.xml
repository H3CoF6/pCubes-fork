<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>FourSidedPyramid - OctagonalEdges E8000140294 Extended</Name>
        <Menu>Other forms\3x3x3 variants\FourSidedPyramid - OctagonalEdges E8000140294 Extended</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3756</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF6000'; // Orange
        Colors[1] := '0000C8'; // Blue  
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := 'FFFFFF'; // White 
        Colors[4] := '009600'; // Green 

        D := 0.12;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0; D*4; D*4" />
                <Add Vector = "   0;-D*8; D*4" />
                <Add Vector = "-D*6;-D*2;-D*2" />
                <Add Vector = "   0; D*4;-D*8" />
                <Add Vector = " D*6;-D*2;-D*2" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" />
                <Face Color = "Colors[2]" VertexIndexes = "0;4;3" />
                <Face Color = "Colors[3]" VertexIndexes = "0;1;4" />
                <Face Color = "Colors[4]" VertexIndexes = "1;2;3;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D * 5" /> </Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "-D * 3" /> </Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D * 3" /> </Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D * 5" /> </Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = " D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D * 5" /> </Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "-D * 7" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = " D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D * 3" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D * 5" /> </Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "-D * 7" /> </Split>

        <Turn NormVector = "1;0;0" Angle = "Pi/4" />
    </Figure>
</xml>
