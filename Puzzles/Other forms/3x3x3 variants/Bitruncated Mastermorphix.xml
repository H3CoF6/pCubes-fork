<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bitruncated Mastermorphix</Name>
        <Menu>Other forms\3x3x3 variants\Bitruncated Mastermorphix</Menu>
        <Inventor>Daniel Bujno</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-07-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6935</Link>
    </Interface>

    <Script>
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        R  := 0.5;
        C0 := R / 2;
        C1 := R;
        C2 := R * sqrt(3) / 2;
        C3 := R * 2;
        H  := R / sqrt(2);

        D := R / 4;
    </Script>

    <Axes TurningAngles = "Pi/2;  0; Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = " C2;-C0; H" />
        <Axis NormVector = "  0; C1; H" />
        <Axis NormVector = "-C2;-C0; H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = " C2" Y = "-C0" Z = " H" />
                <Vector X = "-C2" Y = "-C0" Z = " H" />
                <Vector X = "  0" Y = " C3" Z = "-H" />
                <Vector X = " C2" Y = " C0" Z = "-H" />
                <Vector X = "-C2" Y = " C0" Z = "-H" />
                <Vector X = "  0" Y = "-C1" Z = "-H" />

                <Vector X = "  0" Y = "  0" Z = " H*3" />
            </Vertices>

            <Faces>
                <Face Color = "clRed"    VertexIndexes = " 0; 6; 1; 5" />
                <Face Color = "clBlue"   VertexIndexes = " 1; 6; 2; 4" />
                <Face Color = "clGreen"  VertexIndexes = " 2; 6; 0; 3" />

                <Face Color = "clOrange" VertexIndexes = " 3; 5; 4; 2" />
                <Face Color = "clCyan"   VertexIndexes = " 4; 5; 1" />
                <Face Color = "clPink"   VertexIndexes = " 5; 3; 0" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
