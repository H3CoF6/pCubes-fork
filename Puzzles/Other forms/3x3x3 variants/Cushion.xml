<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cushion</Name>
        <Menu>Other forms\3x3x3 variants\Cushion</Menu>
        <Inventor>Unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-05-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1135</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FFFFFF'; // White
        Colors[ 1] := '0000FF'; // Blue
        Colors[ 2] := 'F4A460'; // SandyBrown
        Colors[ 3] := '006400'; // DarkGreen
        Colors[ 4] := 'FF0000'; // Red
        Colors[ 5] := 'DDBB20'; // Golden
        Colors[ 6] := '808000'; // Olive
        Colors[ 7] := 'D2691E'; // Chocolate
        Colors[ 8] := 'CD853F'; // Peru
        Colors[ 9] := '2E8B57'; // SeaGreen
        Colors[10] := 'ADFF2F'; // GreenYellow
        Colors[11] := '00FF00'; // Lime
        Colors[12] := '008000'; // Green
        Colors[13] := 'FFFF00'; // Yellow

        W := 0.55;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
              <Vertices>
                  <Add Vector = " D; D; W" />
                  <Add Vector = "-D; D; W" />
                  <Add Vector = "-D;-D; W" />
                  <Add Vector = " D;-D; W" />

                  <Add Vector = " W; W; D" />
                  <Add Vector = "-W; W; D" />
                  <Add Vector = "-W;-W; D" />
                  <Add Vector = " W;-W; D" />

                  <Add Vector = " W; W;-D" />
                  <Add Vector = "-W; W;-D" />
                  <Add Vector = "-W;-W;-D" />
                  <Add Vector = " W;-W;-D" />

                  <Add Vector = " D; D;-W" />
                  <Add Vector = "-D; D;-W" />
                  <Add Vector = "-D;-D;-W" />
                  <Add Vector = " D;-D;-W" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 1; 2; 3" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 1; 0; 4; 5" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 2; 1; 5; 6" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 3; 2; 6; 7" />
                <Face Color = "Colors[ 4]" VertexIndexes = " 0; 3; 7; 4" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 5; 4; 8; 9" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 6; 5; 9;10" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 7; 6;10;11" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 4; 7;11; 8" />
                <Face Color = "Colors[ 9]" VertexIndexes = " 9; 8;12;13" />
                <Face Color = "Colors[10]" VertexIndexes = "10; 9;13;14" />
                <Face Color = "Colors[11]" VertexIndexes = "11;10;14;15" />
                <Face Color = "Colors[12]" VertexIndexes = " 8;11;15;12" />
                <Face Color = "Colors[13]" VertexIndexes = "15;14;13;12" />
            </Faces>
        </Part>
        
        <SplitByAxes/>
    </Figure>

</xml>
