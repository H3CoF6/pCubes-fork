<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Odd Cube</Name>
        <Menu>Other forms\3x3x3 variants\Odd Cube</Menu>
        <Inventor>Tim Fitzrandolph</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-06-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7569</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        Colors[0] := clYellow;
        Colors[1] := clWhite;
        Colors[4] := clOrange;
        Colors[5] := clRed;

        Color := clWhite; // sphere's color

        W := 0.405;
        K := W * 0.75;  // sphere's radius

        D := W / 3;
        R := K / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D;D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>
        <RemoveContaining Vector = "-R; R; R" />
        <RemoveContaining Vector = " R; R;-R" />
        <RemoveContaining Vector = "-R; R;-R" />
        <RemoveContaining Vector = "-R;-R;-R" />
        <RemoveContaining Vector = " 0; R;-R" />
        <RemoveContaining Vector = "-R; 0;-R" />
        <RemoveContaining Vector = "-R; R; 0" />
        <HideAll/>

        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Axis = "0" To   = "1" />
        <Cut Axis = "1" From = "2" />
        <Cut Axis = "2" To   = "1" />
        <HideAll/>

        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Axis = "0" From = "1"                     />
        <Cut Axis = "1" From = "2" Color = "Colors[2]" />
        <Cut Axis = "2" To   = "1" Color = "Colors[5]" />
        <HideAll/>

        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Axis = "0" To   = "1" Color = "Colors[1]" />
        <Cut Axis = "1" To   = "2"                     />
        <Cut Axis = "2" To   = "1" Color = "Colors[5]" />
        <HideAll/>

        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Axis = "0" To   = "1" Color = "Colors[1]" />
        <Cut Axis = "1" From = "2" Color = "Colors[2]" />
        <Cut Axis = "2" From = "1"                     />
        <ShowAll/>

        <SplitByAxes/>
    </Figure>
</xml>
