<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Kite 1</Name>
        <Alias>Sharp Edges (10400000)</Alias>
        <Menu>Other forms\3x3x3 variants\Prism\Kite 1</Menu>
        <Menu>Other forms\Prism\Tetragonal Prism\Kite 1</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3084</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.3;
        C := W * 9 / 3;

        D  := W / 3;
        D3 := D * 3;
        D5 := D * 5;
        D7 := D * 7;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-C;-C;-W" />
                <Add Vector = "-C;-C; W" />
                <Add Vector = "-D; W;-W" />
                <Add Vector = "-D; W; W" />
                <Add Vector = " W;-D;-W" />
                <Add Vector = " W;-D; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W; W; W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split InvisibleEdges1 = "1" InvisibleEdges2 = "1" > <Plane NormDistance = "-D3" NormVector = " 1; 0; 0" /> </Split>
        <Split InvisibleEdges1 = "1" InvisibleEdges2 = "1" > <Plane NormDistance = "-D7" NormVector = " 1; 0; 0" /> </Split>
        <Hide> <Plane NormDistance = "-D7" NormVector = " 1; 0; 0" /> </Hide>
        <Split InvisibleEdges1 = "1" InvisibleEdges2 = "1" > <Plane NormDistance = "-D7" NormVector = " 0; 1; 0" /> </Split>
        <Hide> <Plane NormDistance = "-D3" NormVector = " 1; 0; 0" /> </Hide>
        <Split InvisibleEdges1 = "1" InvisibleEdges2 = "1" > <Plane NormDistance = "-D3" NormVector = " 0; 1; 0" /> </Split>
        <ShowAll/>
        <Split> <Plane NormDistance = "-D3" NormVector = " 0; 1; 0" /> </Split>
        <Split> <Plane NormDistance = "-D5" NormVector = " 1; 0; 0" /> </Split>
        <Split> <Plane NormDistance = "-D5" NormVector = " 0; 1; 0" /> </Split>
        <Split> <Plane NormDistance = "-D7" NormVector = " 0; 1; 0" /> </Split>
        <SplitByAxes/>
    </Figure>
</xml>
