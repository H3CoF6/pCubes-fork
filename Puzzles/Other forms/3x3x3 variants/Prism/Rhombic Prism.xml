<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombic Prism</Name>
        <Menu>Other forms\3x3x3 variants\Prism\Rhombic Prism</Menu>
        <Menu>Other forms\Prism\Tetragonal Prism\Rhombic Prism</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-10-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1017</Link>
    </Interface>

    <Script>
        W := 0.35;
        D := W / 3;
        DCut := (D + W) / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W * 3" />
        <Cut Color = "clRed"    ><Plane NormVector = " 1; 0;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clOrange" ><Plane NormVector = "-1; 0; 1" NormDistance = "-DCut" /> </Cut>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
