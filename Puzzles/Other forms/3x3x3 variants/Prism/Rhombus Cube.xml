<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rhombus Cube</Name>
        <Alias>Sharp Edges (180600000)</Alias>
        <Menu>Other forms\Prism\Tetragonal Prism\Rhombus Cube</Menu>
        <Menu>Other forms\3x3x3 variants\Prism\Rhombus Cube</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3790</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        A := W * 3 / 2;
        B := W;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-A; 0;-W" />
                <Add Vector = "-A; 0; W" />
                <Add Vector = " 0; B;-W" />
                <Add Vector = " 0; B; W" />
                <Add Vector = " 0;-B;-W" />
                <Add Vector = " 0;-B; W" />
                <Add Vector = " A; 0;-W" />
                <Add Vector = " A; 0; W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Split> <Plane NormDistance = "-W" NormVector = " 1; 0; 0" /> </Split>
        <Split> <Plane NormDistance = " W" NormVector = " 1; 0; 0" /> </Split>
    </Figure>
</xml>
