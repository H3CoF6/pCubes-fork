<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Five-Sided Sharp Cube</Name>
        <Menu>Other forms\3x3x3 variants\Prism\Five-Sided Sharp Cube</Menu>
        <Menu>Other forms\Prism\Triangular Prism\Five-Sided Sharp Cube</Menu>
        <Aliases>Sharp Edges (28000)</Aliases>
        <Inventor>Benjy Oliver</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3775</Link>
    </Interface>

    <Script>
        Colors[0] := 'A80000'; //clRed
        Colors[1] := 'FFFFFF'; //clWhite
        Colors[2] := '0000A0'; //clBlue
        Colors[3] := '008000'; //clGreen
        Colors[4] := 'FFFF00'; //clYellow

        R := 0.6;
        D := R / 5;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  -R;-D*3;-D*3" />
                <Add Vector = "  -R; D*3;-D*3" />
                <Add Vector = "   R;-D*3;-D*3" />
                <Add Vector = "   R; D*3;-D*3" />
                <Add Vector = "   0;-D*3; D*4.5" />
                <Add Vector = "   0; D*3; D*4.5" />
                <Add Vector = "-D*3;-D*3; 0" />
                <Add Vector = "-D*3; D*3; 0" />
                <Add Vector = " D*3;-D*3; 0" />
                <Add Vector = " D*3; D*3; 0" />
                <Add Vector = "-D*3;-D*3;-D*3" />
                <Add Vector = "-D*3; D*3;-D*3" />
                <Add Vector = " D*3;-D*3;-D*3" />
                <Add Vector = " D*3; D*3;-D*3" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[2]" VertexIndexes = "2;3;5;4" />
                <Face Color = "Colors[3]" VertexIndexes = "10;12;8;4;6" />
                <Face Color = "Colors[3]" VertexIndexes = "10;6;0" />
                <Face Color = "Colors[3]" VertexIndexes = "8;12;2" />
                <Face Color = "Colors[4]" VertexIndexes = "7;5;9;13;11" />
                <Face Color = "Colors[4]" VertexIndexes = "1;7;11" />
                <Face Color = "Colors[4]" VertexIndexes = "3;13;9" />
            </Faces>
        </Part>

        <Split><Plane NormVector = "0;0;1" NormDistance = " D * 3" /></Split>

        <SplitByAxes/>
    </Figure>
</xml>
