<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Oliloy cube</Name>
        <Menu>Other forms\3x3x3 variants\Oliloy cube</Menu>
        <Inventor>Leonardo Oli Loy</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-11-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8570</Link>
    </Interface>
 
    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        clViolet := '7700EE';
        clPink   := 'FF88DD';

        W := 0.5;
        D := W / 3;
        E := (W + D) / 2;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        DCut := (2 * W - D)  / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Cut Color = "clPink"   ><Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clViolet" ><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /></Cut>
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Macro Name = "MakeEdge" >
            <RemoveContaining Vector = " 0;-W; W" />

            <Part>
                <Vertices>
                    <Add Vector = "-D;-W; D" />
                    <Add Vector = "-D;-E; E" />
                    <Add Vector = "-D;-D; D" />
                    <Add Vector = "-D;-D; W" />
                    <Add Vector = " D;-W; D" />
                    <Add Vector = " D;-E; E" />
                    <Add Vector = " D;-D; D" />
                    <Add Vector = " D;-D; W" />
                </Vertices>

                <Faces>
                    <Face                      VertexIndexes = "0;1;3;2" />
                    <Face                      VertexIndexes = "5;4;6;7" />
                    <Face Color = "Colors[c1]" VertexIndexes = "1;0;4;5" InvisibleEdges = "8" />
                    <Face                      VertexIndexes = "2;3;7;6" />
                    <Face                      VertexIndexes = "0;2;6;4" />
                    <Face Color = "Colors[c2]" VertexIndexes = "3;1;5;7" InvisibleEdges = "2" />
                </Faces>
            </Part>
        </Macro>
        <ExecMacro MacroName = "MakeEdge" c1 = "2" c2 = "5" />
        <Turn NormVector = "0;0;1" Angle = "-Pi/2" />
        <ExecMacro MacroName = "MakeEdge" c1 = "1" c2 = "5" />
        <Turn NormVector = "0;1;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "MakeEdge" c1 = "1" c2 = "3" />
        <Turn NormVector = "0;0;1" Angle = "-Pi/2" />
        <ExecMacro MacroName = "MakeEdge" c1 = "4" c2 = "3" />
        <Turn NormVector = "0;1;0" Angle = "-Pi/2" />
        <ExecMacro MacroName = "MakeEdge" c1 = "4" c2 = "0" />
        <Turn NormVector = "0;0;1" Angle = "-Pi/2" />
        <ExecMacro MacroName = "MakeEdge" c1 = "2" c2 = "0" />
        <Turn NormVector = "0;1;0" Angle = "-Pi/2" />

        <Macro Name = "MakeVertex" >
            <RemoveContaining Vector = " W;-W; W" />

            <Part>
                <Vertices>
                    <Add Vector = " D;-W; D" />
                    <Add Vector = " D;-E; E" />
                    <Add Vector = " D;-D; D" />
                    <Add Vector = " D;-D; W" />
                    <Add Vector = " W;-W; D" />
                    <Add Vector = " E;-E; E" />
                    <Add Vector = " W;-D; D" />
                    <Add Vector = " E;-D; E" />
                </Vertices>

                <Faces>
                    <Face                      VertexIndexes = "0;1;3;2" />
                    <Face Color = "Colors[c2]" VertexIndexes = "5;4;6;7" InvisibleEdges = "8" />
                    <Face Color = "Colors[c1]" VertexIndexes = "1;0;4;5" InvisibleEdges = "8" />
                    <Face                      VertexIndexes = "2;3;7;6" />
                    <Face                      VertexIndexes = "0;2;6;4" />
                    <Face Color = "Colors[c3]" VertexIndexes = "1;5;3" InvisibleEdges = "1" />
                    <Face Color = "Colors[c3]" VertexIndexes = "5;7;3" InvisibleEdges = "1" />
                </Faces>
            </Part>
            <Turn NormVector = "1;0;1" Angle = "Pi" />
        </Macro>
        <ExecMacro MacroName = "MakeVertex" c1 = "2" c2 = "1" c3 = "5" />
        <ExecMacro MacroName = "MakeVertex" c1 = "3" c2 = "5" c3 = "1" />
        <Turn NormVector = " 1;-1;-1" Angle = "2*Pi / 3" />
        <ExecMacro MacroName = "MakeVertex" c1 = "1" c2 = "4" c3 = "3" />
        <ExecMacro MacroName = "MakeVertex" c1 = "0" c2 = "3" c3 = "4" />
        <Turn NormVector = " 1;-1;-1" Angle = "2*Pi / 3" />
        <ExecMacro MacroName = "MakeVertex" c1 = "4" c2 = "2" c3 = "0" />
        <ExecMacro MacroName = "MakeVertex" c1 = "5" c2 = "0" c3 = "2" />
        <Turn NormVector = " 1;-1;-1" Angle = "2*Pi / 3" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
