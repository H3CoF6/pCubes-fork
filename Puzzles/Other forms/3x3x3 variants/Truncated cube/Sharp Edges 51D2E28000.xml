<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sharp Edges 51D2E28000</Name>
        <Menu>Other forms\3x3x3 variants\Truncated cube\Sharp Edges 51D2E28000</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-05-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3796</Link>
    </Interface>
 
    <Script>
        Colors[ 0] := 'FF6A00'; // Orange      
        Colors[ 1] := 'FFF08F'; // LightYellow 
        Colors[ 2] := 'FFFF00'; // Yellow      
        Colors[ 3] := 'FF38E4'; // LightViolett
        Colors[ 4] := '007700'; // Green       
        Colors[ 5] := '7777FF'; // LightBlue   
        Colors[ 6] := 'FF0000'; // Red         
        Colors[ 7] := 'B200FF'; // Violett     
        Colors[ 8] := '0000FF'; // Blue        
        Colors[ 9] := 'AAAAAA'; // Gray        
        Colors[10] := 'FFFFFF'; // White       
        Colors[11] := '00FF00'; // LightGreen  

        W := 0.6;
        D := W * 0.27;
        H := W;
        W1 := D * 3;
        ZCut := W1 * 2 - W;
        DCut := W1 * H / sqrt(H^2 + ZCut^2);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " 0; 0;-H" />
                <Add Vector = " 0; 0; H" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;4" />
                <Face Color = "Colors[1]" VertexIndexes = "1;2;4" />
                <Face Color = "Colors[2]" VertexIndexes = "2;3;4" />
                <Face Color = "Colors[3]" VertexIndexes = "3;0;4" />
                <Face Color = "Colors[4]" VertexIndexes = "1;0;5" />
                <Face Color = "Colors[5]" VertexIndexes = "2;1;5" />
                <Face Color = "Colors[6]" VertexIndexes = "3;2;5" />
                <Face Color = "Colors[7]" VertexIndexes = "0;3;5" />
            </Faces>
        </Part>

        <Cut Color = "Colors[ 8]" ><Plane NormVector = "0; H; ZCut" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[ 9]" ><Plane NormVector = "0; H;-ZCut" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[10]" ><Plane NormVector = "0;-H;-ZCut" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[11]" ><Plane NormVector = "0;-H; ZCut" NormDistance = "-DCut" /></Cut>

        <SplitByAxes/>
    </Figure>
</xml>
