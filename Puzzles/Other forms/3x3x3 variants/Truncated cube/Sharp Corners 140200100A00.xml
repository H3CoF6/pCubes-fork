<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sharp Corners 140200100A00</Name>
        <Menu>Other forms\3x3x3 variants\Truncated cube\Sharp Corners 140200100A00</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3794</Link>
    </Interface>
 
    <Script>
        Colors[ 0] := '0000D8'; // LightBlue
        Colors[ 1] := 'C80000'; // Red
        Colors[ 2] := 'FFFF00'; // Yellow
        Colors[ 3] := 'FF800A'; // Orange
        Colors[ 4] := 'FFFFFF'; // White
        Colors[ 5] := '005600'; // DarkGreen
        Colors[ 6] := '00A600'; // LightGreen
        Colors[ 7] := '808000'; // Olive
        Colors[ 8] := 'BF8040'; // Brown
        Colors[ 9] := '000078'; // DarkBlue
        Colors[10] := '800040'; // DarkViolett
        Colors[11] := 'FF0080'; // LightViolett

        W := 0.5;
        D := W * 0.18;

        ax := 0.5;
        ay := 1;
        az := 1;
        DCut := W * 0.5;
        DCut2 := (DCut * sqrt(2 + ax^2) + D * (ax + 2)) / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W = "W * 1.5" />
        <SplitByAxes/>

        <Macro Name = "Cut" >
            <Cut Color = "Colors[i]" ><Plane NormVector = " ax; ay; az" NormDistance = "-DCut" /></Cut>
            <Script>Inc(i);</Script>
            <Turn NormVector = " 1; 1; 1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "Cut" i = "0" Repeat = "3" />
        <Turn NormVector = "-1; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut" Repeat = "3" />
        <Turn NormVector = "-1; 1; 0" Angle = "Pi" />

        <Cut Color = "Colors[ 6]" ><Plane NormVector = " 0;-1; 1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[ 7]" ><Plane NormVector = " 0; 1;-1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[ 8]" ><Plane NormVector = "-1; 0; 1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[ 9]" ><Plane NormVector = " 1; 0;-1" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[10]" ><Plane NormVector = "-1; 1; 0" NormDistance = "-DCut2" /></Cut>
        <Cut Color = "Colors[11]" ><Plane NormVector = " 1;-1; 0" NormDistance = "-DCut2" /></Cut>

        <RemoveGrayParts/>

        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "-ArcTan(sqrt(2))" />
        <Turn NormVector = "0;0;1" Angle = "-Pi/6" />

    </Figure>
</xml>
