<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Halved Hexagonal Dipyramid</Name>
        <Menu>Other forms\3x3x3 variants\Truncated cube\Halved Hexagonal Dipyramid</Menu>
        <Inventor>Eoin Dowling</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-12-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11591</Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clOrange  := 'FF6000';
        clYellow  := 'FFFF00';
        clGreen   := '007700';
        clDeepSky := '00BFFF';
        clPurple  := '6600FF';
        clWhite   := 'FFFFFF';
        clBlack   := '333333';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "-1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " Vx; Vy; Vz" />
            <Vertices Vectors = " Ex; Ey; Ez" />

            <Faces>
                <Face Color = "clBlack" VertexIndexes = "3;5;7" InvisibleEdges = "1" />
                <Face Color = "clBlack" VertexIndexes = "5;6;7" InvisibleEdges = "1" />
                <Face Color = "clBlack" VertexIndexes = "6;3;7" InvisibleEdges = "1" />

                <Face Color = "clWhite" VertexIndexes = "5;3;10; 8" InvisibleEdges = "1" />
                <Face Color = "clWhite" VertexIndexes = "6;5;12;16" InvisibleEdges = "1" />
                <Face Color = "clWhite" VertexIndexes = "3;6;14;18" InvisibleEdges = "1" />

                <Face Color = "clPurple" VertexIndexes = "0; 8;10" />
                <Face Color = "clGreen " VertexIndexes = "0;16;12" />
                <Face Color = "clOrange" VertexIndexes = "0;18;14" />

                <Face Color = "clRed    " VertexIndexes = "0;12;5; 8" />
                <Face Color = "clYellow " VertexIndexes = "0;14;6;16" />
                <Face Color = "clDeepSky" VertexIndexes = "0;10;3;18" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
