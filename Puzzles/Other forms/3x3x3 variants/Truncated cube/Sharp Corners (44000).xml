<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sharp Corners (44000)</Name>
        <Menu>Other forms\3x3x3 variants\Truncated cube\Sharp Corners (44000)</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3793</Link>
    </Interface>

    <Script>
        Colors[6] := '009484';
        Colors[7] := '38ABEA';
        Colors[8] := 'A5211F';

        W := 0.5;
        D := W / 3;
        RCut := W;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[7]"><Plane NormVector = " 2; 2;-1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[8]"><Plane NormVector = "-2;-2;-1" NormDistance = "-RCut" /></Cut>
    </Figure>
</xml>
