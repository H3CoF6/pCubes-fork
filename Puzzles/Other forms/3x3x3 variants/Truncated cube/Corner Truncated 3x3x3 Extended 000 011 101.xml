<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Corner Truncated 3x3x3 Extended 000 011 101</Name>
        <Menu>Other forms\3x3x3 variants\Truncated cube\Corner Truncated 3x3x3 Extended 000 011 101</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3873</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W1 := 0.35;
        W2 := W1 * 5 / 3;
        D  := W1 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W1;-W1; W2" />
                <Add Vector = " W1; W2;-W1" />
                <Add Vector = " W1;-W1;-W1" />
                <Add Vector = "-W2;-W1;-W1" />
                <Add Vector = "-W2; W2; W2" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1;4" />
                <Face Color = "Colors[0]" VertexIndexes = "0;4;3" />
                <Face Color = "Colors[3]" VertexIndexes = "4;1;3" />
                <Face Color = "Colors[5]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" />
                <Face Color = "Colors[4]" VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "W1" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "W1" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "W1" /></Split>

        <SplitByAxes/>
    </Figure>
</xml>
