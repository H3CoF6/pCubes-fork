<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sharp Corners 40000040010 Extended</Name>
        <Menu>Other forms\3x3x3 variants\Truncated cube\Sharp Corners 40000040010 Extended</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3204</Link>
    </Interface>

    <Script>
        Colors[6] := 'FF77BB';

        W := 0.5;
        D := W / 3;
        W0 := W;
        RCut := W;
        RCut2 := W * 29/27 * sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
                		
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W0 = "W" W = "W / 3 * 7" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[0]"><Plane NormVector = " 1; 0; 0" NormDistance = "-W0" /></Cut>
        <Cut Color = "Colors[2]"><Plane NormVector = " 0; 1; 0" NormDistance = "-W0" /></Cut>
        <Cut Color = "Colors[4]"><Plane NormVector = " 0; 0; 1" NormDistance = "-W0" /></Cut>

        <Cut Color = "Colors[1]" ><Plane NormVector = "-2;-1; 2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[3]" ><Plane NormVector = " 2;-2;-1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[5]" ><Plane NormVector = "-1; 2;-2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[6]" ><Plane NormVector = "-1;-1;-1" NormDistance = "-RCut2" /></Cut>
    </Figure>
</xml>
