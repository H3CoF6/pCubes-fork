<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Asym Corners (200000000000000000004000)</Name>
        <Menu>Other forms\3x3x3 variants\Asym Corners\Asym Corners (200000000000000000004000)</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3817</Link>
    </Interface>

    <Script>
        Colors[6] := '4444FF'; // LightBlue   
        Colors[7] := '00FF00'; // LightGreen  

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[6]"><Plane NormVector = "-2; 6; 3" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[7]"><Plane NormVector = " 2;-6;-3" NormDistance = "-W" /></Cut>
    </Figure>
</xml>
