<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4 Corners Rotated</Name>
        <Menu>Other forms\3x3x3 variants\Asym Corners\4 Corners Rotated</Menu>
        <Aliases>Asym Corners (136) 40020060204000801090080010</Aliases>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3183</Link>
    </Interface>

    <Script>
        Colors[ 6] := '009484';
        Colors[ 7] := '38ABEA';
        Colors[ 8] := 'A5211F';
        Colors[ 9] := 'C1C5C8';
        Colors[10] := 'F0B092';
        Colors[11] := 'FB85DB';
        Colors[12] := 'FE800A';
        Colors[13] := 'FFED99';
        Colors[14] := '4D1350';
        Colors[15] := 'E23465';
        Colors[16] := '7D7584';
        Colors[17] := '907409';
        Colors[18] := '478000';
        Colors[19] := '734082';

        W := 0.5;
        D := W / 3;

        t := D * 2; // var

        procedure VecMult(x1, y1, z1, x2, y2, z2, x3, y3, z3);
        begin
          nx := (y1-y3) * (z2-z3) - (y2-y3) * (z1-z3);
          ny := (z1-z3) * (x2-x3) - (z2-z3) * (x1-x3);
          nz := (x1-x3) * (y2-y3) - (x2-x3) * (y1-y3);
        end;

        VecMult(W, W, W,  D,-D, W,  W,-W, t);
        ND := W * (nx + ny + nz) / sqrt(nx^2 + ny^2 + nz^2);
    </Script>


    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[ 8]"><Plane NormVector = "-nz; ny;-nx" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[ 9]"><Plane NormVector = " ny;-nx;-nz" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[10]"><Plane NormVector = "-nx;-nz; ny" NormDistance = "-ND" /></Cut>

        <Cut Color = "Colors[11]"><Plane NormVector = " nz;-ny;-nx" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[12]"><Plane NormVector = "-ny; nx;-nz" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[13]"><Plane NormVector = " nx; nz; ny" NormDistance = "-ND" /></Cut>

        <Cut Color = "Colors[14]"><Plane NormVector = " nz; ny; nx" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[15]"><Plane NormVector = "-ny;-nx; nz" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[16]"><Plane NormVector = " nx;-nz;-ny" NormDistance = "-ND" /></Cut>

        <Cut Color = "Colors[17]"><Plane NormVector = "-nz;-ny; nx" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[18]"><Plane NormVector = " ny; nx; nz" NormDistance = "-ND" /></Cut>
        <Cut Color = "Colors[19]"><Plane NormVector = "-nx; nz;-ny" NormDistance = "-ND" /></Cut>
    </Figure>
</xml>
