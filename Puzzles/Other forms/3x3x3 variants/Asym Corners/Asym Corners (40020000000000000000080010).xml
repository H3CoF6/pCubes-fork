    <Script>
        Colors[6] := 'FF38E4'; // LightViolett
        Colors[7] := 'B200FF'; // Violett     
        Colors[8] := '4444FF'; // LightBlue   
        Colors[9] := '00FF00'; // LightGreen  

        W := 0.5;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[6]"><Plane NormVector = " 3; 6;-2" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[7]"><Plane NormVector = "-3;-6;-2" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[8]"><Plane NormVector = "-3; 6; 2" NormDistance = "-W" /></Cut>
        <Cut Color = "Colors[9]"><Plane NormVector = " 3;-6; 2" NormDistance = "-W" /></Cut>
    </Figure>
</xml>
