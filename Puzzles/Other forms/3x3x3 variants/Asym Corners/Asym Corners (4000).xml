<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Asym Corners (4000)</Name>
        <Menu>Other forms\3x3x3 variants\Asym Corners\Asym Corners (4000)</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3810</Link>
    </Interface>

    <Script>
        Colors[6] := '999999'; // Gray

        W := 0.5;
        D := W / 3;
        RCut := W * 27 / sqrt(769);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[6]"><Plane NormVector = "-12; 20;-15" NormDistance = "-RCut" /></Cut>
    </Figure>
</xml>
