<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Paparats Kvetka</Name>
        <Menu>Other forms\3x3x3 variants\Paparats Kvetka</Menu>
        <Inventor>Andrey Yerashkevich</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3336</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        D := W * 0.25;
        DCut := W / sqrt(3);
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />
        <SplitByAxes/>

        <HideContaining Vector = " W;-W; W"/>
        <HideContaining Vector = "-D;-W; W"/>
        <HideContaining Vector = " W; D; W"/>
        <HideContaining Vector = " W;-W;-D"/>

        <Cut Color = "clBlue" ><Plane NormVector = " 0; 0;-1" NormDistance = "-W" /></Cut>
        <Cut Color = "clBlue" ><Plane NormVector = "-1; 0; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "clBlue" ><Plane NormVector = " 0; 1; 0" NormDistance = "-W" /></Cut>
        <InvertVisibility/>

        <Cut Color = "clYellow" ><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clYellow" ><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clYellow" ><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clYellow" ><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <HideContaining Vector = "-W; W;-W"/>
        <HideContaining Vector = " D; W;-W"/>
        <HideContaining Vector = "-W;-D;-W"/>
        <HideContaining Vector = "-W; W; D"/>

        <Cut Color = "clGreen" ><Plane NormVector = " 0; 0; 1" NormDistance = "-W" /></Cut>
        <Cut Color = "clGreen" ><Plane NormVector = " 1; 0; 0" NormDistance = "-W" /></Cut>
        <Cut Color = "clGreen" ><Plane NormVector = " 0;-1; 0" NormDistance = "-W" /></Cut>
        <InvertVisibility/>

        <Cut Color = "clRed" ><Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clRed" ><Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clRed" ><Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clRed" ><Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /></Cut>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
