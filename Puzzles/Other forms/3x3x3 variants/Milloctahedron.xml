<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Milloctahedron</Name>
        <Menu>Other forms\3x3x3 variants\Milloctahedron</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3428</Link>
    </Interface>

    <Script>
        Colors[ 6] := '009484';
        Colors[ 7] := '38ABEA';
        Colors[ 8] := 'A5211F';
        Colors[ 9] := 'C1C5C8';
        Colors[10] := 'F0B092';
        Colors[11] := 'FB85DB';
        Colors[12] := '4D1350';
        Colors[13] := 'FFED99';

        W := 0.5;
        D := W / 3;
        RCut := W * 2 / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut Color = "Colors[ 6]"><Plane NormVector = " 3; 6; 4" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[ 7]"><Plane NormVector = " 6;-3; 4" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[ 8]"><Plane NormVector = "-3;-6; 4" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[ 9]"><Plane NormVector = "-6; 3; 4" NormDistance = "-RCut" /></Cut>

        <Cut Color = "Colors[10]"><Plane NormVector = " 6; 3;-4" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[11]"><Plane NormVector = " 3;-6;-4" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[12]"><Plane NormVector = "-6;-3;-4" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[13]"><Plane NormVector = "-3; 6;-4" NormDistance = "-RCut" /></Cut>
    </Figure>
</xml>
