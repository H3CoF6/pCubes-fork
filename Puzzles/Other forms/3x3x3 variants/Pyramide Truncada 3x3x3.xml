<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyramide Truncada 3x3x3</Name>
        <Menu>Other forms\3x3x3 variants\Pyramide Truncada 3x3x3</Menu>
        <Inventor>José Ramírez</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-08-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10141</Link>
    </Interface>

    <Script>
        W1 := 0.5;
        H1 :=-W1 * 0.86;
        W2 := W1 * 0.43;
        H2 := W1 * 1.21;

        D  := W1 * 0.18;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-W1;-W1; H1" />
                  <Add Vector = "-W2;-W2; H2" />
                  <Add Vector = "-W1; W1; H1" />
                  <Add Vector = "-W2; W2; H2" />
                  <Add Vector = " W1;-W1; H1" />
                  <Add Vector = " W2;-W2; H2" />
                  <Add Vector = " W1; W1; H1" />
                  <Add Vector = " W2; W2; H2" />
            </Vertices>

            <Faces>
                  <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                  <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                  <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                  <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                  <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                  <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
