<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Truncated MasterMorphix</Name>
        <Menu>Other forms\3x3x3 variants\Archimedean\Truncated MasterMorphix</Menu>
        <Menu>Other forms\Archimedean Solids\Truncated Tetrahedron\Truncated MasterMorphix</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1135</Link>
    </Interface>

    <Script>
        D := 1 / 6;
        H := 0.8;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
              <Vertices>
                  <Add Vector = "-D; D; H" />
                  <Add Vector = "D; -D; H" />
                  <Add Vector = "-H; D; D" />
                  <Add Vector = "-D; H; D" />
                  <Add Vector = "H; -D; D" />
                  <Add Vector = "D; -H; D" />
                  <Add Vector = "-H; -D; -D" />
                  <Add Vector = "D; H; -D" />
                  <Add Vector = "H; D; -D" />
                  <Add Vector = "-D; -H; -D" />
                  <Add Vector = "-D; -D; -H" />
                  <Add Vector = "D; D; -H" />
            </Vertices>
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "0;2;6;9;5;1" />
                <Face Color = "008000" VertexIndexes = "4;5;9;10;11;8" />
                <Face Color = "0046C8" VertexIndexes = "10;6;2;3;7;11" />
                <Face Color = "AA0000" VertexIndexes = "0;1;4;8;7;3" />
                <Face Color = "0046C8" VertexIndexes = "1;5;4" />
                <Face Color = "AA0000" VertexIndexes = "6;10;9" />
                <Face Color = "008000" VertexIndexes = "0;3;2" />
                <Face Color = "FFFF00" VertexIndexes = "7;8;11" />
            </Faces>
        </Part>
        
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
