<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetra Pyramid</Name>
        <Menu>Other forms\3x3x3 variants\Tetra Pyramid</Menu>
        <Inventor>John Lin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2316</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 3;
        DCut1 := W * 5 / 3 / sqrt(3);
        DCut2 := W;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        <RemoveGrayParts/>

        <Cut> <Plane NormVector = "  1;  1; -1" NormDistance = "-DCut1" /> </Cut>
        <Cut> <Plane NormVector = "  1;  2; -2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = "  2;  1; -2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = "  2;  2; -1" NormDistance = "-DCut2" /> </Cut>

        <Cut> <Plane NormVector = "  1; -1;  1" NormDistance = "-DCut1" /> </Cut>
        <Cut> <Plane NormVector = "  1; -2;  2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = "  2; -1;  2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = "  2; -2;  1" NormDistance = "-DCut2" /> </Cut>

        <Cut> <Plane NormVector = " -1; -1; -1" NormDistance = "-DCut1" /> </Cut>
        <Cut> <Plane NormVector = " -1; -2; -2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = " -2; -1; -2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = " -2; -2; -1" NormDistance = "-DCut2" /> </Cut>

        <Cut> <Plane NormVector = " -1;  1;  1" NormDistance = "-DCut1" /> </Cut>
        <Cut> <Plane NormVector = " -1;  2;  2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = " -2;  1;  2" NormDistance = "-DCut2" /> </Cut>
        <Cut> <Plane NormVector = " -2;  2;  1" NormDistance = "-DCut2" /> </Cut>

    </Figure>
</xml>
