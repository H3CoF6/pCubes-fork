<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Double Edge Turning Symmetry</Name>
        <Alias>Octagonal Edges 21E0800104C84 Extended</Alias>
        <Menu>Other forms\3x3x3 variants\Double Edge Turning Symmetry</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-04-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3774</Link>
    </Interface>

    <Script>
        W := 0.4;
        D := W / 3;
        RCut := W * 2 * sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" W = "W * 10" />

        <Cut Color = "Colors[2]"><Plane NormVector = " 0; 1;-1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[0]"><Plane NormVector = " 0; 1; 1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[4]"><Plane NormVector = "-1; 0; 1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[5]"><Plane NormVector = " 1; 0;-1" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[1]"><Plane NormVector = "-1;-1; 0" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[3]"><Plane NormVector = " 1;-1; 0" NormDistance = "-RCut" /></Cut>

        <SplitByAxes/>

        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "3 * D" /></Split>
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "3 * D" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = "5 * D" /></Split>
        <Split><Plane NormVector = "-1; 0; 0" NormDistance = "5 * D" /></Split>

        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "3 * D" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "3 * D" /></Split>
        <Split><Plane NormVector = " 0; 1; 0" NormDistance = "5 * D" /></Split>
        <Split><Plane NormVector = " 0;-1; 0" NormDistance = "5 * D" /></Split>

        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "3 * D" /></Split>
        <Split><Plane NormVector = " 0; 0;-1" NormDistance = "3 * D" /></Split>
        <Split><Plane NormVector = " 0; 0; 1" NormDistance = "5 * D" /></Split>
        <Split><Plane NormVector = " 0; 0;-1" NormDistance = "5 * D" /></Split>

    </Figure>
</xml>
