<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Twisted Octagonal Prism 3x3x3</Name>
        <Menu>Other forms\3x3x3 variants\Twisted Octagonal Prism</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4122</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        DCut := sqrt(2) / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
                <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
                <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[5]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[5]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[0]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[0]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[0]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Cut Color = "Colors[0]" ><Plane NormVector = " 0;-1;-1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[0]" ><Plane NormVector = " 0;-1; 1" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[5]" ><Plane NormVector = "-1; 1; 0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "Colors[5]" ><Plane NormVector = " 1; 1; 0" NormDistance = "-DCut" /></Cut>

        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
