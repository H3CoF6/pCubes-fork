<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Penrose Bandaged</Name>
        <Menu>Other forms\3x3x3 variants\Penrose Bandaged</Menu>
        <Inventor>Sergio Borrego Miras</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9201</Link>
    </Interface>
 
    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        R := W * 2/3;
        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[3]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[1]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[5]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[5]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[3]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        
        <SplitByAxes/>
	
        <RemoveContaining Vector = "-D; W;-W" />
        <RemoveContaining Vector = " W; W;-W" />
        <HideAll/>
        <Cylinder Radius = "R" Color = "Colors[5]">
            <Base X = "-W" Y = " D" Z = "-D" Color = "Colors[3]" />
            <Top  X = " W" Y = " D" Z = "-D" Color = "Colors[1]" />
        </Cylinder>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "D" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "D" /> </Cut>
        <SplitByAxes/>
        <ShowAll/>

        <RemoveContaining Vector = " W;-W; D" />
        <RemoveContaining Vector = " W;-W;-W" />
        <RemoveContaining Vector = " W;-W;-W" />
        <HideAll/>
        <Cylinder Radius = "R" Color = "Colors[1]">
            <Base X = " D" Y = "-D" Z = "-W" Color = "Colors[5]" />
            <Top  X = " D" Y = "-D" Z = " W" Color = "Colors[3]" />
        </Cylinder>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "D" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "D" /> </Cut>
        <SplitByAxes/>
        <ShowAll/>

        <RemoveContaining Vector = "-W;-W; W" />
        <RemoveContaining Vector = "-W; W; W" />

        <Hide Axis = "1" Layers = "0;2" />
        <RemoveAllVisible/>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "Colors[3]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[1]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[5]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[5]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[3]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-D" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-D" /> </Cut>
        <Split> <Plane NormVector = " 0; 0; 1" NormDistance = "D" /> </Split>
        <Hide Axis = "2" Layers = "0;1" />
        <Cut InvisibleEdges = "-1" Color = "-2" > <Plane NormVector = " 1; 0; 0" NormDistance = "-D" /> </Cut>
        <HideAll/>
        <Cylinder Radius = "R" Color = "Colors[3]" Base = "-D;-W; D" Top = "-D; W; D" >
            <Base Color = "Colors[1]" />
            <Top  Color = "Colors[5]" />
        </Cylinder>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = " D" /> </Cut>
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <HideContaining Vector = "-D;0;D" />
        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = " D" /> </Cut>
        <ShowAll/>
        <Hide Axis = "1" Layers = "0;2" />
        <Hide Axis = "2" Layers = "0;1" />
        <HideContaining Vector = " W; 0; W" />
        <Cut InvisibleEdges = "-1" Color = "-2" > <Plane NormVector = "-1; 0; 0" NormDistance = " D" /> </Cut>
        <HideAll/>

        <!-- invisible linking part, check "Wired" on to see it -->
        <Circle Radius = "D/10" Center = "-D; 0; (W+D)/2"/>
        <InvertVisibility/>

        <RemoveGrayParts/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
