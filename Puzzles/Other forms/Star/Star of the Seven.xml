<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star of the Seven</Name>
        <Menu>Other forms\Star\Star of the Seven</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-12-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5305</Link>
    </Interface>

    <Script>
        Colors[0] := 'C80000'; // clRed        
        Colors[1] := 'FF800A'; // clOrange     
        Colors[2] := 'E6C800'; // clYellow     
        Colors[3] := '009600'; // clGreen      
        Colors[4] := '0060BF'; // clSkyBlue    
        Colors[5] := '0000C8'; // clBlue       
        Colors[6] := 'B40078'; // clDarkViolett

        clUp      := '9DAB20'; // Golden
        clDown    := '7F0020'; // Violet
	
        R  := 0.7;
        H  := R * 0.2;
        R3 := R * 0.6;

        D := R * sin(Pi / 14); 
        R1 := D / cos(Pi / 7);
        R2 := D / cos(2 * Pi / 7);

        x1 := 0;
        y1 := R1;

        x2 := R2 * sin(Pi / 7);
        y2 := R2 * cos(Pi / 7);

        y3  :=  R3 * cos(Pi / 7);
        x3  :=  (R - y3) * tan(Pi / 14);
        x3a :=  R3 * sin(Pi / 7);
        y3a :=  y3;
        x3b := -x3 * cos(2 * Pi / 7) + y3 * sin(2 * Pi / 7);
        y3b :=  x3 * sin(2 * Pi / 7) + y3 * cos(2 * Pi / 7);

        for i := 0 to 6 do begin
            x[i] := R1 * sin(2*Pi / 7 * i);
            y[i] := R1 * cos(2*Pi / 7 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
        <Axis NormVector = "x[5]; y[5]; 0" />
        <Axis NormVector = "x[6]; y[6]; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddSegment" >
            <Part>
                <Vertices>
                    <Add Vector = "  0;  -R;  H" />
                    <Add Vector = "  0;  -R; -H" />
                    <Add Vector = " x2; -y2;  H" />
                    <Add Vector = " x2; -y2; -H" />
                    <Add Vector = " x1; -y1;  H" />
                    <Add Vector = " x1; -y1; -H" />
                    <Add Vector = "-x2; -y2;  H" />
                    <Add Vector = "-x2; -y2; -H" />
                </Vertices>

                <Faces>
                    <Face Color = "clUp      " VertexIndexes = "0;2;4;6" />
                    <Face Color = "clDown    " VertexIndexes = "7;5;3;1" />
                    <Face Color = "Colors[c1]" VertexIndexes = "0;1;3;2" />
                    <Face                      VertexIndexes = "2;3;5;4" />
                    <Face                      VertexIndexes = "4;5;7;6" />
                    <Face Color = "Colors[c2]" VertexIndexes = "6;7;1;0" />
                </Faces>
            </Part>

            <Part>
                <Vertices>
                    <Add Vector = "   0;   -R1;  H" />
                    <Add Vector = "   0;   -R1; -H" />
                    <Add Vector = "  x2;   -y2;  H" />
                    <Add Vector = "  x2;   -y2; -H" />
                    <Add Vector = "x[1]; -y[1];  H" />
                    <Add Vector = "x[1]; -y[1]; -H" />
                </Vertices>

                <Faces>
                    <Face Color = "clUp  " VertexIndexes = "0;2;4" />
                    <Face Color = "clDown" VertexIndexes = "5;3;1" />
                    <Face                  VertexIndexes = "0;1;3;2" />
                    <Face                  VertexIndexes = "2;3;5;4" />
                    <Face                  VertexIndexes = "4;5;1;0" />
                </Faces>
            </Part>

            <Part>
                <Vertices>
                    <Add Vector = " x3;  -y3;  H" />
                    <Add Vector = " x3;  -y3; -H" />
                    <Add Vector = "x3a; -y3a;  H" />
                    <Add Vector = "x3a; -y3a; -H" />
                    <Add Vector = "x3b; -y3b;  H" />
                    <Add Vector = "x3b; -y3b; -H" />
                    <Add Vector = " x2;  -y2;  H" />
                    <Add Vector = " x2;  -y2; -H" />
                </Vertices>

                <Faces>
                    <Face Color = "clUp      " VertexIndexes = "0;2;4;6" />
                    <Face Color = "clDown    " VertexIndexes = "7;5;3;1" />
                    <Face Color = "Colors[c1]" VertexIndexes = "0;1;3;2" />
                    <Face Color = "Colors[c1]" VertexIndexes = "2;3;5;4" />
                    <Face                      VertexIndexes = "4;5;7;6" />
                    <Face                      VertexIndexes = "6;7;1;0" />
                </Faces>
            </Part>
            <Turn NormVector = "0;0;1" Angle = "- 	2 * Pi / 7" />
        </Macro>
        <ExecMacro MacroName = "AddSegment" c1 = "0" c2 = "6" />
        <ExecMacro MacroName = "AddSegment" c1 = "1" c2 = "0" />
        <ExecMacro MacroName = "AddSegment" c1 = "2" c2 = "1" />
        <ExecMacro MacroName = "AddSegment" c1 = "3" c2 = "2" />
        <ExecMacro MacroName = "AddSegment" c1 = "4" c2 = "3" />
        <ExecMacro MacroName = "AddSegment" c1 = "5" c2 = "4" />
        <ExecMacro MacroName = "AddSegment" c1 = "6" c2 = "5" />

        <Part>
            <Vertices>
                <Add Vector = "-x[0]; -y[0];  H" />
                <Add Vector = "-x[0]; -y[0]; -H" />
                <Add Vector = "-x[1]; -y[1];  H" />
                <Add Vector = "-x[1]; -y[1]; -H" />
                <Add Vector = "-x[2]; -y[2];  H" />
                <Add Vector = "-x[2]; -y[2]; -H" />
                <Add Vector = "-x[3]; -y[3];  H" />
                <Add Vector = "-x[3]; -y[3]; -H" />
                <Add Vector = "-x[4]; -y[4];  H" />
                <Add Vector = "-x[4]; -y[4]; -H" />
                <Add Vector = "-x[5]; -y[5];  H" />
                <Add Vector = "-x[5]; -y[5]; -H" />
                <Add Vector = "-x[6]; -y[6];  H" />
                <Add Vector = "-x[6]; -y[6]; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clUp  " VertexIndexes = "12;10; 8; 6; 4; 2; 0" />
                <Face Color = "clDown" VertexIndexes = " 1; 3; 5; 7; 9;11;13" />
                <Face                  VertexIndexes = " 2; 3; 1; 0" />
                <Face                  VertexIndexes = " 4; 5; 3; 2" />
                <Face                  VertexIndexes = " 6; 7; 5; 4" />
                <Face                  VertexIndexes = " 8; 9; 7; 6" />
                <Face                  VertexIndexes = "10;11; 9; 8" />
                <Face                  VertexIndexes = "12;13;11;10" />
                <Face                  VertexIndexes = " 0; 1;13;12" />
            </Faces>
        </Part>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
