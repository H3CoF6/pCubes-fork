<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crystal Cube</Name>
        <Menu>Other forms\Star\Escher's solid\Crystal Cube</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-30</Added>
        <Link></Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        D  := W / 2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddCorner" >
            <Part>
                <Vertices>
                    <Add Vector = " W; 0; W" />
                    <Add Vector = " 0; 0; W" />
                    <Add Vector = " W; 0; 0" />
                    <Add Vector = " D; D; D" />
                    <Add Vector = " D;-D; D" />
                </Vertices>
                <Faces>
                    <Face Color = "Color" VertexIndexes = " 1; 4; 0" InvisibleEdges = "1" />
                    <Face Color = "Color" VertexIndexes = " 2; 3; 0" InvisibleEdges = "1" />
                    <Face Color = "Color" VertexIndexes = " 3; 1; 0" InvisibleEdges = "1" />
                    <Face Color = "Color" VertexIndexes = " 4; 2; 0" InvisibleEdges = "1" />
                    <Face                 VertexIndexes = " 3; 2; 4; 1" />
                </Faces>
            </Part>
            <Turn NormVector = "0;1;0" Angle = "Pi/2"/>
        </Macro>
        <Macro Name = "AddBelt" >
            <ExecMacro MacroName = "AddCorner" Color = "Colors[c1]" />
            <ExecMacro MacroName = "AddCorner" Color = "Colors[c1]"  />
            <ExecMacro MacroName = "AddCorner" Color = "Colors[c2]"  />
            <ExecMacro MacroName = "AddCorner" Color = "Colors[c2]"  />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3"/>
        </Macro>
        <ExecMacro MacroName = "AddBelt" c1 = "5" c2 = "4" />
        <ExecMacro MacroName = "AddBelt" c1 = "3" c2 = "2" />
        <ExecMacro MacroName = "AddBelt" c1 = "1" c2 = "0" />

<!--
        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" R = "W2" />
-->
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
