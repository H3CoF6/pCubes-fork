<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Morningstar Dino</Name>
        <Menu>Other forms\Star\Escher's solid\Morningstar Dino</Menu>
        <Inventor>Seth Holiday</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-12-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11568</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // Red
        Colors[ 1] := '008000'; // Green
        Colors[ 2] := '800080'; // Purple
        Colors[ 3] := 'F0F0F0'; // White
        Colors[ 4] := '0000FF'; // Blue
        Colors[ 5] := 'FF6000'; // Orange
        Colors[ 6] := 'FF69B4'; // Pink
        Colors[ 7] := '00FF00'; // Lime
        Colors[ 8] := '000080'; // Navy
        Colors[ 9] := '202020'; // Black
        Colors[10] := '00FFFF'; // Cyan
        Colors[11] := 'FFFF00'; // Yellow

        W  := 0.5;
        V := W * 0.7;  // pillow
        D := V / sqrt(3);
        R := 2 * V * (2 * W - V) / (V + W); // size of core

        DCut := W - (W - V)^2 / (V + W);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddPart" >
            <Part>
                <Vertices>
                    <Add Vector = " 0; 0; W" />
                    <Add Vector = " 0;-W; W" />
                    <Add Vector = " 0;-W; 0" />
                    <Add Vector = " V;-V; V" />
                    <Add Vector = "-V;-V; V" />
                </Vertices>
                <Faces>
                    <Face Color = "Colors[c0]" VertexIndexes = " 0; 4; 1" />
                    <Face Color = "Colors[c1]" VertexIndexes = " 0; 1; 3" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 1; 4; 2" />
                    <Face Color = "Colors[c3]" VertexIndexes = " 1; 2; 3" />
                    <Face                      VertexIndexes = " 3; 2; 4; 0" />
                </Faces>
            </Part>
            <Turn NormVector = "1; 0; 0" Angle = "Pi / 2" />
        </Macro>

        <ExecMacro MacroName = "AddPart" c0 = "1" c1 = "9" c2 = "8" c3 = "0" />
        <ExecMacro MacroName = "AddPart" c0 = "6" c1 = "2" c2 = "1" c3 = "9" />
        <ExecMacro MacroName = "AddPart" c0 = "3" c1 = "7" c2 = "6" c3 = "2" />
        <ExecMacro MacroName = "AddPart" c0 = "8" c1 = "0" c2 = "3" c3 = "7" />

        <Turn NormVector = "1; 0; 0" Angle = "-Pi / 2" />
        <Turn NormVector = "0; 0; 1" Angle = " Pi / 2" />

        <ExecMacro MacroName = "AddPart" c0 = " 5" c1 = "10" c2 = " 1" c3 = " 3" />
        <ExecMacro MacroName = "AddPart" c0 = " 9" c1 = " 7" c2 = " 5" c3 = "10" />
        <ExecMacro MacroName = "AddPart" c0 = " 4" c1 = "11" c2 = " 9" c3 = " 7" />
        <ExecMacro MacroName = "AddPart" c0 = " 1" c1 = " 3" c2 = " 4" c3 = "11" />

        <Turn NormVector = "1; 0; 0" Angle = "-Pi / 2" />
        <Turn NormVector = "0; 0; 1" Angle = " Pi / 2" />

        <ExecMacro MacroName = "AddPart" c0 = " 8" c1 = " 6" c2 = " 5" c3 = " 4" />
        <ExecMacro MacroName = "AddPart" c0 = "10" c1 = "11" c2 = " 8" c3 = " 6" />
        <ExecMacro MacroName = "AddPart" c0 = " 0" c1 = " 2" c2 = "10" c3 = "11" />
        <ExecMacro MacroName = "AddPart" c0 = " 5" c1 = " 4" c2 = " 0" c3 = " 2" />

        <Turn NormVector = "1; 0; 0" Angle = "-Pi / 2" />

        <SplitByAxes/>

        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />
        <Split><Plane NormVector = "1;0;0" /></Split>
        <Split><Plane NormVector = "0;1;0" /></Split>
        <Split><Plane NormVector = "0;0;1" /></Split>
        <HideAll/>

        <Script>
            for i := 0 to 11 do
                Colors[i] := -1;
        </Script>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />
        <SplitByAxes/>

        <Cut><Plane NormVector = " 1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut><Plane NormVector = "-1; 0; 0" NormDistance = "-DCut" /> </Cut>
        <Cut><Plane NormVector = " 0; 1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut><Plane NormVector = " 0;-1; 0" NormDistance = "-DCut" /> </Cut>
        <Cut><Plane NormVector = " 0; 0; 1" NormDistance = "-DCut" /> </Cut>
        <Cut><Plane NormVector = " 0; 0;-1" NormDistance = "-DCut" /> </Cut>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
