<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>StarBurst</Name>
        <Menu>Other forms\Star\StarBurst</Menu>
        <Inventor>Daniel Baamonde</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4159</Link>
    </Interface>

    <Script>
        R := 0.5;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        Colors[0] := '0000C8'; // clRed;
        Colors[1] := '009600'; // clOrange;
        Colors[2] := 'C80000'; // clBlue;
        Colors[3] := 'FF800A'; // clGreen;
        Colors[4] := 'FFFF00'; // clYellow;

        k1 := 3 / sqrt(5);
        k2 := (sqrt(5) + 1) / 4;

        D := R * sqrt((5 + 2 * sqrt(5)) / 15);
    </Script>

    <Axes TurningAngles = "0; Pi * 2 / 3" PlaneDistances = " D" NormVectors = "Cx; Cy; Cz" />

    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face VertexIndexes = " 0; 1; 5" />
                <Face VertexIndexes = " 0; 2; 1" />
                <Face VertexIndexes = " 0; 3; 2" />
                <Face VertexIndexes = " 0; 4; 3" />
                <Face VertexIndexes = " 0; 5; 4" />
                <Face VertexIndexes = " 1;10; 5" />
                <Face VertexIndexes = " 2; 6; 1" />
                <Face VertexIndexes = " 3; 7; 2" />
                <Face VertexIndexes = " 4; 8; 3" />
                <Face VertexIndexes = " 5; 9; 4" />
                <Face VertexIndexes = "11; 7; 8" />
                <Face VertexIndexes = "11; 8; 9" />
                <Face VertexIndexes = "11; 9;10" />
                <Face VertexIndexes = "11;10; 6" />
                <Face VertexIndexes = "11; 6; 7" />
                <Face VertexIndexes = " 7; 3; 8" />
                <Face VertexIndexes = " 8; 4; 9" />
                <Face VertexIndexes = " 9; 5;10" />
                <Face VertexIndexes = "10; 1; 6" />
                <Face VertexIndexes = " 6; 2; 7" />
            </Faces>
        </Part>

        <Macro Name = "AddVertex">
            <Part>
                <Vertices>
                    <Add Vector = "Cx[c]*k1; Cy[c]*k1; Cz[c]*k1" />
                    <Add Vector = "vx[v1]; vy[v1]; vz[v1]" />
                    <Add Vector = "vx[v2]; vy[v2]; vz[v2]" />
                    <Add Vector = "vx[v3]; vy[v3]; vz[v3]" />
                </Vertices>

                <Faces>
                    <Face VertexIndexes = " 0; 1; 2" />
                    <Face VertexIndexes = " 0; 2; 3" />
                    <Face VertexIndexes = " 0; 3; 1" />
                    <Face VertexIndexes = " 1; 3; 2" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "AddVertex" c = " 0" v1 = " 0" v2 = " 1" v3 = " 5" />
        <ExecMacro MacroName = "AddVertex" c = " 1" v1 = " 0" v2 = " 2" v3 = " 1" />
        <ExecMacro MacroName = "AddVertex" c = " 2" v1 = " 0" v2 = " 3" v3 = " 2" />
        <ExecMacro MacroName = "AddVertex" c = " 3" v1 = " 0" v2 = " 4" v3 = " 3" />
        <ExecMacro MacroName = "AddVertex" c = " 4" v1 = " 0" v2 = " 5" v3 = " 4" />
        <ExecMacro MacroName = "AddVertex" c = " 5" v1 = " 5" v2 = " 1" v3 = "10" />
        <ExecMacro MacroName = "AddVertex" c = " 6" v1 = " 1" v2 = " 2" v3 = " 6" />
        <ExecMacro MacroName = "AddVertex" c = " 7" v1 = " 2" v2 = " 3" v3 = " 7" />
        <ExecMacro MacroName = "AddVertex" c = " 8" v1 = " 3" v2 = " 4" v3 = " 8" />
        <ExecMacro MacroName = "AddVertex" c = " 9" v1 = " 4" v2 = " 5" v3 = " 9" />
        <ExecMacro MacroName = "AddVertex" c = "10" v1 = " 7" v2 = " 8" v3 = "11" />
        <ExecMacro MacroName = "AddVertex" c = "11" v1 = " 8" v2 = " 9" v3 = "11" />
        <ExecMacro MacroName = "AddVertex" c = "12" v1 = " 9" v2 = "10" v3 = "11" />
        <ExecMacro MacroName = "AddVertex" c = "13" v1 = "10" v2 = " 6" v3 = "11" />
        <ExecMacro MacroName = "AddVertex" c = "14" v1 = " 6" v2 = " 7" v3 = "11" />
        <ExecMacro MacroName = "AddVertex" c = "15" v1 = " 3" v2 = " 8" v3 = " 7" />
        <ExecMacro MacroName = "AddVertex" c = "16" v1 = " 4" v2 = " 9" v3 = " 8" />
        <ExecMacro MacroName = "AddVertex" c = "17" v1 = " 5" v2 = "10" v3 = " 9" />
        <ExecMacro MacroName = "AddVertex" c = "18" v1 = " 1" v2 = " 6" v3 = "10" />
        <ExecMacro MacroName = "AddVertex" c = "19" v1 = " 2" v2 = " 7" v3 = " 6" />

        <Macro Name = "AddEdge">
            <Part>
                <Vertices>
                    <Add Vector = "Cx[c1]*k1; Cy[c1]*k1; Cz[c1]*k1" />
                    <Add Vector = "Cx[c2]*k1; Cy[c2]*k1; Cz[c2]*k1" />
                    <Add Vector = "vx[v1]; vy[v1]; vz[v1]" />
                    <Add Vector = "vx[v2]; vy[v2]; vz[v2]" />
                    <Add Vector = "(vx[v1] + vx[v2]) * k2; (vy[v1] + vy[v2]) * k2; (vz[v1] + vz[v2]) * k2" />
                </Vertices>

                <Faces>
                    <Face                         VertexIndexes = " 1; 2; 3" />
                    <Face                         VertexIndexes = " 0; 3; 2" />
                    <Face Color = "Colors[Color]" VertexIndexes = " 4; 3; 0" />
                    <Face Color = "Colors[Color]" VertexIndexes = " 4; 0; 2" />
                    <Face Color = "Colors[Color]" VertexIndexes = " 4; 2; 1" />
                    <Face Color = "Colors[Color]" VertexIndexes = " 4; 1; 3" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "AddEdge" c1 = " 2" C2 = " 3" v1 = " 0" v2 = " 3" Color = "0" />
        <ExecMacro MacroName = "AddEdge" c1 = " 6" C2 = "19" v1 = " 2" v2 = " 6" Color = "0" />
        <ExecMacro MacroName = "AddEdge" c1 = "10" C2 = "15" v1 = " 7" v2 = " 8" Color = "0" />
        <ExecMacro MacroName = "AddEdge" c1 = " 9" C2 = "16" v1 = " 9" v2 = " 4" Color = "0" />
        <ExecMacro MacroName = "AddEdge" c1 = " 0" C2 = " 5" v1 = " 1" v2 = " 5" Color = "0" />
        <ExecMacro MacroName = "AddEdge" c1 = "12" C2 = "13" v1 = "10" v2 = "11" Color = "0" />

        <ExecMacro MacroName = "AddEdge" c1 = " 0" C2 = " 4" v1 = " 5" v2 = " 0" Color = "1" />
        <ExecMacro MacroName = "AddEdge" c1 = "12" C2 = "17" v1 = " 9" v2 = "10" Color = "1" />
        <ExecMacro MacroName = "AddEdge" c1 = " 2" C2 = " 7" v1 = " 3" v2 = " 2" Color = "1" />
        <ExecMacro MacroName = "AddEdge" c1 = "10" C2 = "14" v1 = "11" v2 = " 7" Color = "1" />
        <ExecMacro MacroName = "AddEdge" c1 = " 8" C2 = "16" v1 = " 4" v2 = " 8" Color = "1" />
        <ExecMacro MacroName = "AddEdge" c1 = " 6" C2 = "18" v1 = " 6" v2 = " 1" Color = "1" />

        <ExecMacro MacroName = "AddEdge" c1 = " 0" C2 = " 1" v1 = " 0" v2 = " 1" Color = "2" />
        <ExecMacro MacroName = "AddEdge" c1 = " 3" C2 = " 8" v1 = " 4" v2 = " 3" Color = "2" />
        <ExecMacro MacroName = "AddEdge" c1 = "10" C2 = "11" v1 = " 8" v2 = "11" Color = "2" />
        <ExecMacro MacroName = "AddEdge" c1 = "13" C2 = "18" v1 = "10" v2 = " 6" Color = "2" />
        <ExecMacro MacroName = "AddEdge" c1 = " 7" C2 = "19" v1 = " 7" v2 = " 2" Color = "2" />
        <ExecMacro MacroName = "AddEdge" c1 = " 9" C2 = "17" v1 = " 5" v2 = " 9" Color = "2" />

        <ExecMacro MacroName = "AddEdge" c1 = " 8" C2 = "15" v1 = " 8" v2 = " 3" Color = "3" />
        <ExecMacro MacroName = "AddEdge" c1 = " 1" C2 = " 2" v1 = " 0" v2 = " 2" Color = "3" />
        <ExecMacro MacroName = "AddEdge" c1 = "11" C2 = "12" v1 = " 9" v2 = "11" Color = "3" />
        <ExecMacro MacroName = "AddEdge" c1 = " 5" C2 = "18" v1 = " 1" v2 = "10" Color = "3" />
        <ExecMacro MacroName = "AddEdge" c1 = " 4" C2 = " 9" v1 = " 5" v2 = " 4" Color = "3" />
        <ExecMacro MacroName = "AddEdge" c1 = "14" C2 = "19" v1 = " 6" v2 = " 7" Color = "3" />

        <ExecMacro MacroName = "AddEdge" c1 = " 7" C2 = "15" v1 = " 3" v2 = " 7" Color = "4" />
        <ExecMacro MacroName = "AddEdge" c1 = " 3" C2 = " 4" v1 = " 0" v2 = " 4" Color = "4" />
        <ExecMacro MacroName = "AddEdge" c1 = " 5" C2 = "17" v1 = "10" v2 = " 5" Color = "4" />
        <ExecMacro MacroName = "AddEdge" c1 = "13" C2 = "14" v1 = " 6" v2 = "11" Color = "4" />
        <ExecMacro MacroName = "AddEdge" c1 = "11" C2 = "16" v1 = " 8" v2 = " 9" Color = "4" />
        <ExecMacro MacroName = "AddEdge" c1 = " 1" C2 = " 6" v1 = " 2" v2 = " 1" Color = "4" />
        <ShowAll/>

        <SplitByAxes/>

        <SaveSolvedState/>

    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
