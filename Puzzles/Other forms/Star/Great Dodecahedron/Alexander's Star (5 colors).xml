<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Alexander's Star (5 colors)</Name>
        <Menu>Other forms\Star\Great Dodecahedron\Alexander's Star (5 colors)</Menu>
        <Inventor>Mike Grimsley</Inventor>
        <Programmer>MakerMouse</Programmer>
        <Added>2018-02-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2889</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        Color[ 0] := 'FFFFFF'; // White;
        Color[ 1] := '0000A0'; // Blue;
        Color[ 2] := 'FF0000'; // Red;
        Color[ 3] := '138808'; // IndiaGreen;
        Color[ 4] := 'FFFF00'; // Yellow;

        D := Rsin;

        K1 := (sqrt(5) - 1)/4;
        K2 := sqrt((25 - 11 * sqrt(5)) * 2) / 4;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "AddPart">
            <Part>
                <Vertices>
                    <Add Vector = "Vx[i1]; Vy[i1]; Vz[i1]" />
                    <Add Vector = "Vx[i2]; Vy[i2]; Vz[i2]" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 - (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) / R * K2; (Vy[i1] + Vy[i2]) * K1 - (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) / R * K2; (Vz[i1] + Vz[i2]) * K1 - (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) / R * K2" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 + (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) / R * K2; (Vy[i1] + Vy[i2]) * K1 + (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) / R * K2; (Vz[i1] + Vz[i2]) * K1 + (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) / R * K2" />
                </Vertices>
                <Faces>
                    <Face Color = "Color[c1]" VertexIndexes = "0;2;1" />
                    <Face Color = "Color[c2]" VertexIndexes = "0;1;3" />
                    <Face VertexIndexes = "2;0;3" />
                    <Face VertexIndexes = "1;2;3" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 1" c1 = " 0" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 2" c1 = " 2" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 3" c1 = " 3" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 4" c1 = " 4" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 5" c1 = " 1" c2 = " 4" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 2" c1 = " 0" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 3" c1 = " 2" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 4" c1 = " 3" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 5" c1 = " 4" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 1" c1 = " 1" c2 = " 2" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 6" c1 = " 3" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 7" c1 = " 4" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 8" c1 = " 1" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 9" c1 = " 0" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = "10" c1 = " 2" c2 = " 3" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = "10" c1 = " 4" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 6" c1 = " 1" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 7" c1 = " 0" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 8" c1 = " 2" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 9" c1 = " 3" c2 = " 0" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = " 7" c1 = " 1" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = " 8" c1 = " 0" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = " 9" c1 = " 2" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "10" c1 = " 3" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = " 6" c1 = " 4" c2 = " 0" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = "11" c1 = " 2" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = "11" c1 = " 3" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = "11" c1 = " 4" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "11" c1 = " 1" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = "11" c1 = " 0" c2 = " 1" />

        <SaveSolvedState/> <!-- First soled state -->

        <RemoveContaining Vector = "Ex; Ey; Ez" />

        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 1" c1 = " 4" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 2" c1 = " 3" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 3" c1 = " 2" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 4" c1 = " 0" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 5" c1 = " 1" c2 = " 0" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 2" c1 = " 4" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 3" c1 = " 3" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 4" c1 = " 2" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 5" c1 = " 0" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 1" c1 = " 1" c2 = " 2" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 6" c1 = " 0" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 7" c1 = " 1" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 8" c1 = " 4" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 9" c1 = " 3" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = "10" c1 = " 2" c2 = " 4" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = "10" c1 = " 3" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 6" c1 = " 2" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 7" c1 = " 0" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 8" c1 = " 1" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 9" c1 = " 4" c2 = " 3" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = " 7" c1 = " 2" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = " 8" c1 = " 0" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = " 9" c1 = " 1" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "10" c1 = " 4" c2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = " 6" c1 = " 3" c2 = " 1" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = "11" c1 = " 4" c2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = "11" c1 = " 3" c2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = "11" c1 = " 2" c2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "11" c1 = " 0" c2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = "11" c1 = " 1" c2 = " 0" />

        <SaveSolvedState/> <!-- Second soled state -->

        // gray part

        <HideAll/>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
        <RemoveContaining Vector = "Ex; Ey; Ez" />
        <RemoveContaining Vector = "0; 0; 0" />
        <ShowAll/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
