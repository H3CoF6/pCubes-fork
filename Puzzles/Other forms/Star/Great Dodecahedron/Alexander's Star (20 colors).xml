        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = "11" c1 = " 6" C2 = "19" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
