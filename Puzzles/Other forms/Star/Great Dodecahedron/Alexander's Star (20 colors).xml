<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Alexander's Star (20 colors)</Name>
        <Menu>Other forms\Star\Great Dodecahedron\Alexander's Star (20 colors)</Menu>
        <Inventor>Adam Alexander</Inventor>
        <Programmer>MakerMouse</Programmer>
        <Added>2018-01-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2889</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        Colors[ 0] := 'FF0000';
        Colors[ 1] := '800000';
        Colors[ 2] := '808000';
        Colors[ 3] := '000080';
        Colors[ 4] := 'FF7F50';
        Colors[ 5] := '00BFFF';
        Colors[ 6] := 'DC143C';
        Colors[ 7] := '2E8B57';
        Colors[ 8] := 'FFFF00';
        Colors[ 9] := 'E69BE2';
        Colors[10] := 'FF6000';
        Colors[11] := '004444';
        Colors[12] := 'DDBB20';
        Colors[13] := '0000FF';
        Colors[14] := '00FF00';
        Colors[15] := '008080';
        Colors[16] := 'CD5C5C';
        Colors[17] := '006400';
        Colors[18] := 'F0E68C';
        Colors[19] := 'FF69B4';

        D := Rsin;

        K1 := (sqrt(5) - 1)/4;
        K2 := sqrt((25 - 11 * sqrt(5)) * 2) / 4;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "AddPart">
            <Part>
                <Vertices>
                    <Add Vector = "Vx[i1]; Vy[i1]; Vz[i1]" />
                    <Add Vector = "Vx[i2]; Vy[i2]; Vz[i2]" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 - (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) / R * K2; (Vy[i1] + Vy[i2]) * K1 - (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) / R * K2; (Vz[i1] + Vz[i2]) * K1 - (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) / R * K2" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 + (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) / R * K2; (Vy[i1] + Vy[i2]) * K1 + (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) / R * K2; (Vz[i1] + Vz[i2]) * K1 + (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) / R * K2" />
                </Vertices>
                <Faces>
                    <Face Color = "Colors[c1]" VertexIndexes = "0;2;1" />
                    <Face Color = "Colors[c2]" VertexIndexes = "0;1;3" />
                    <Face VertexIndexes = "2;0;3" />
                    <Face VertexIndexes = "1;2;3" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 1" c1 = " 0" C2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 2" c1 = " 2" C2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 3" c1 = " 3" C2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 4" c1 = " 4" C2 = " 3" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 5" c1 = " 1" C2 = " 4" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 2" c1 = " 0" C2 = " 5" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 3" c1 = " 2" C2 = " 7" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 4" c1 = " 3" C2 = " 8" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 5" c1 = " 4" C2 = " 9" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 1" c1 = " 1" C2 = "10" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 6" c1 = " 5" C2 = "11" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 7" c1 = " 7" C2 = "12" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 8" c1 = " 8" C2 = "13" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 9" c1 = " 9" C2 = "14" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = "10" c1 = "10" C2 = "15" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = "10" c1 = "11" C2 = "10" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 6" c1 = "12" C2 = " 5" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 7" c1 = "13" C2 = " 7" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 8" c1 = "14" C2 = " 8" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 9" c1 = "15" C2 = " 9" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = " 7" c1 = "12" C2 = "16" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = " 8" c1 = "13" C2 = "17" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = " 9" c1 = "14" C2 = "18" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "10" c1 = "15" C2 = "19" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = " 6" c1 = "11" C2 = " 6" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = "11" c1 = "16" C2 = " 6" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = "11" c1 = "17" C2 = "16" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = "11" c1 = "18" C2 = "17" />
