    <Script>
        clYellow       := 'EDFF11';
        clLightBlue    := '5080FF';
        clBlue         := '0000C8';
        clOrange       := '884000';
        clOrange1      := 'FFB000';
        clLightViolett := 'FF00B0';
        clRed          := 'FF0000';
        clLightGreen   := '80FF80';
        clGreen        := '009600';
        clViolett      := '7700CD';
        clGray         := '808080';
        clWhite        := 'FFFFFF';

        mAngle := ArcTan(0.5);
        As := sin(mAngle);
        Ac := cos(mAngle);
        sAngle := PI * 2 / 5;
        for i := 1 to 5 do begin
            ax[i] := sin(sAngle * (i - 1)) * Ac;
            ay[i] := cos(sAngle * (i - 1)) * Ac;
        end;

        R := 0.7;
        Rsin := R * sin(mAngle);
        Rcos := R * cos(mAngle);
        D := 0.1;

        for i := 1 to 5 do begin
            X[i] := Rcos * sin(sAngle * (i - 1));
            Y[i] := Rcos * cos(sAngle * (i - 1));
            Z[i] := Rsin;
        end;
        for i := 6 to 10 do begin
            X[i] := Rcos * sin(sAngle * (i - 0.5));
            Y[i] := Rcos * cos(sAngle * (i - 0.5));
            Z[i] := -Rsin;
        end;

        D1 := RSin;

        dAngle := (Arctan(2) + Arcsin(2/3)) / 2;
        dAngle2 := (Arctan(2) - Arcsin(2/3)) / 2;
        K := D1 / sin(dAngle);
        Rsin := K * sin(dAngle);
        Rcos := K * cos(dAngle);
        R2sin := K * sin(dAngle2);
        R2cos := K * cos(dAngle2);

        for i := 0 to 4 do begin
            x1[i] := Rcos * sin(sAngle * (i - 0.5));
            y1[i] := Rcos * cos(sAngle * (i - 0.5));
            z1[i] := Rsin;
        end;

        for i := 5 to 9 do begin
            x1[i] := R2cos * sin(sAngle * (i - 0.5));
            y1[i] := R2cos * cos(sAngle * (i - 0.5));
            z1[i] := R2sin;
        end;

        for i := 10 to 14 do begin
            x1[i] := R2cos * sin(sAngle * i);
            y1[i] := R2cos * cos(sAngle * i);
            z1[i] := -R2sin;
        end;

        for i := 15 to 19 do begin
            x1[i] := Rcos * sin(sAngle * i);
            y1[i] := Rcos * cos(sAngle * i);
            z1[i] := -Rsin;
        end;

        d1 := R * sin(mAngle);
        d2 := R2sin;

    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D1; -D2; D2; D1" >
        <Axis NormVector = "   0;      0;  1" />
        <Axis NormVector = "ax[1]; ay[1]; As" />
        <Axis NormVector = "ax[2]; ay[2]; As" />
