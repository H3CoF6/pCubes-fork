<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Turn</Name>
        <Menu>Other forms\Star\Star Turn</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7901</Link>
    </Interface>

    <Script>
        clRed    := 'EE0000';
        clYellow := 'FFFF00';
        clGreen  := '00AA00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF7700';
        clPurple := 'AA00AA';
        clCyan   := '00DDDD';

        R := 0.7;
        H := R * 0.1;

        R1 := R * (3 - sqrt(5)) / 2;

        sAngle := Pi * 2 / 5;
        for i := 0 to 4 do begin
            x[i]  := R  * sin(sAngle * i);
            y[i]  := R  * cos(sAngle * i);
            xi[i] := R1 * sin(sAngle * (i + 0.5));
            yi[i] := R1 * cos(sAngle * (i + 0.5));
        end;

        D := R1 * sin(Pi / 10);
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D" >
        <Axis NormVector = "xi[0]; yi[0]; 0" />
        <Axis NormVector = "xi[1]; yi[1]; 0" />
        <Axis NormVector = "xi[2]; yi[2]; 0" />
        <Axis NormVector = "xi[3]; yi[3]; 0" />
        <Axis NormVector = "xi[4]; yi[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "  x;  y;  H" />
            <Vertices Vectors = "  x;  y; -H" />
            <Vertices Vectors = " xi; yi;  H" />
            <Vertices Vectors = " xi; yi; -H" />

            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 14;4;13;3;12;2;11;1;10;0" />
                <Face Color = "clYellow" VertexIndexes = " 5;15;6;16;7;17;8;18;9;19" />
                <Face Color = "clGreen " VertexIndexes = " 5;0;10;15" />
                <Face Color = "clGreen " VertexIndexes = " 2;7;16;11" />
                <Face Color = "clWhite " VertexIndexes = " 1;6;15;10" />
                <Face Color = "clWhite " VertexIndexes = " 9;4;14;19" />
                <Face Color = "clOrange" VertexIndexes = " 0;5;19;14" />
                <Face Color = "clOrange" VertexIndexes = " 8;3;13;18" />
                <Face Color = "clPurple" VertexIndexes = " 6;1;11;16" />
                <Face Color = "clPurple" VertexIndexes = " 3;8;17;12" />
                <Face Color = "clCyan  " VertexIndexes = " 7;2;12;17" />
                <Face Color = "clCyan  " VertexIndexes = " 4;9;18;13" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
