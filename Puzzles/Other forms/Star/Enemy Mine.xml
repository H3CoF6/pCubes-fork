<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Enemy Mine</Name>
        <Menu>Other forms\Star\Enemy Mine</Menu>
        <Inventor>Mark Lodge</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-01-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9694</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';
        CenterColor := '303030';

        W := 0.8;
        D := W / 9 * sqrt(3) * 1.3;

        WQ := D * sqrt(3);
        A := WQ * 1.5;
        B := A - WQ;

        procedure Add1( X1, Y1, Z1);
        begin
            Wx[idx] := X1;
            Wy[idx] := Y1;
            Wz[idx] := Z1;
            Inc(idx);
        end;

        procedure Add4( X, Y, Z);
        begin
            Add1( X, Y, Z);
            Add1( Y,-X, Z);
            Add1(-X,-Y, Z);
            Add1(-Y, X, Z);
        end;

        idx := 0;
        Add4( 0, B, A);
        Add4( 0, B,-A);
        Add4( A, 0, B);
        Add4( A, 0,-B);
        Add4( A, B, 0);
        Add4( A,-B, 0);

        procedure GetVertices();
        begin
            for i := 0 to (Length(Vertices) + 1) div 3 - 1 do
                v[i] := StrToInt(Copy( Vertices, i * 3 + 1, 2));
        end;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <!-- Octahedron -->

        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
        <HideContaining Vectors = "Ex;Ey;Ez" />
        <RemoveAllVisible/>

        <!-- Pillowed cube -->

        <Script>
            W := WQ;
            include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>

        <Macro Name = "AddColor" >
            <Script>
                Color := Colors[c];
                GetVertices;
            </Script>
            <Face Color = "Color" VertexIndexes = "v[0];v[1];v[2]" InvisibleEdges = "4" />
            <Face Color = "Color" VertexIndexes = "v[0];v[2];v[3]" InvisibleEdges = "5" />
            <Face Color = "Color" VertexIndexes = "v[0];v[3];v[4]" InvisibleEdges = "1" />
            <Face Color = "Color" VertexIndexes = "v[0];v[4];v[5]" InvisibleEdges = "4" />
            <Face Color = "Color" VertexIndexes = "v[0];v[5];v[6]" InvisibleEdges = "5" />
            <Face Color = "Color" VertexIndexes = "v[0];v[6];v[7]" InvisibleEdges = "1" />
            <Face Color = "Color" VertexIndexes = "v[0];v[7];v[8]" InvisibleEdges = "4" />
            <Face Color = "Color" VertexIndexes = "v[0];v[8];v[9]" InvisibleEdges = "5" />
            <Face Color = "Color" VertexIndexes = "v[0];v[9];v[1]" InvisibleEdges = "1" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx;Vy;Vz" />
            <Vertices Vectors = "Ex;Ey;Ez" />
            <Vertices Vectors = "Wx;Wy;Wz" />

            <Faces>
                <ExecMacro MacroName = "AddColor" c = "0" Vertices = "' 1; 8;22;23;10;30;38;19;41;29'" />
                <ExecMacro MacroName = "AddColor" c = "1" Vertices = "' 5;11;21;22; 8;29;37;12;40;28'" />
                <ExecMacro MacroName = "AddColor" c = "2" Vertices = "' 7; 9;20;21;11;28;36;13;43;31'" />
                <ExecMacro MacroName = "AddColor" c = "3" Vertices = "' 3;10;23;20; 9;31;39;18;42;30'" />
                <ExecMacro MacroName = "AddColor" c = "5" Vertices = "' 4;15;26;25;16;32;40;12;37;33'" />
                <ExecMacro MacroName = "AddColor" c = "6" Vertices = "' 6;16;25;24;14;35;43;13;36;32'" />
                <ExecMacro MacroName = "AddColor" c = "7" Vertices = "' 2;14;24;27;17;34;42;18;39;35'" />
                <ExecMacro MacroName = "AddColor" c = "4" Vertices = "' 0;17;27;26;15;33;41;19;38;34'" />
                <Face Color = "CenterColor" VertexIndexes = "38;30;42;34" />
                <Face Color = "CenterColor" VertexIndexes = "36;28;40;32" />
                <Face Color = "CenterColor" VertexIndexes = "37;29;41;33" />
                <Face Color = "CenterColor" VertexIndexes = "39;31;43;35" />
                <Face Color = "CenterColor" VertexIndexes = "25;26;27;24" />
                <Face Color = "CenterColor" VertexIndexes = "23;22;21;20" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveContaining Vectors = "Ex;Ey;Ez" />
        <ShowAll/>

        <!--  -->

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
