    <Script>
        cl[ 0] := 'ffffff'; //white
        cl[ 1] := 'ff0000'; //red
        cl[ 2] := '0000cd'; //mediumblue
        cl[ 3] := '008000'; //green
        cl[ 4] := '800080'; //purple
        cl[ 5] := 'ffff00'; //yellow
        cl[ 6] := '9370db'; //mediumpurple
        cl[ 7] := 'ff8c00'; //darkorange
        cl[ 8] := '1e90ff'; //dodgerblue
        cl[ 9] := 'ff69b4'; //hotpink
        cl[10] := 'adff2f'; //greenyellow
        cl[11] := 'a9a9a9'; //darkgray

        cl[12] := '9400d3'; //darkviolet
        cl[13] := 'ff4500'; //orangered
        cl[14] := '696969'; //dimgray
        cl[15] := 'ff1493'; //deeppink
        cl[16] := '7fffd4'; //aquamarine
        cl[17] := '8b4513'; //saddlebrown
        cl[18] := 'd2b48c'; //tan
        cl[19] := 'dda0dd'; //plum
        cl[20] := '6b8e23'; //olivedrab
        cl[21] := '32cd32'; //limegreen
        cl[22] := 'ffd700'; //gold
        cl[23] := '90ee90'; //lightgreen
        cl[24] := 'eee8aa'; //palegoldenrod
        cl[25] := '800000'; //maroon
        cl[26] := '4682b4'; //steelblue
        cl[27] := 'bdb76b'; //darkkhaki
        cl[28] := '87cefa'; //lightskyblue
        cl[29] := '006400'; //darkgreen
        cl[30] := '000080'; //navy
        cl[31] := '008080'; //teal

        R := 0.7;

        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        mul := (sqrt(5)-2)*5;
        for i := 0 to 11 do begin
            Wx[i] := Cx[i] * mul;
            Wy[i] := Cy[i] * mul;
            Wz[i] := Cz[i] * mul;
        end;
        R2 := sqrt(Wx[0]*Wx[0] + Wy[0]*Wy[0] + Wz[0]*Wz[0]);

        K1 := (sqrt(5)*3-5)/4;                     // 0.42705098312484227231
        K2 := sqrt((7-sqrt(5)*3)*3/2)/2;           // 0.33079226912480374885
        K3 := (sqrt(5)*3+5)/20;                    // 0.58541019662496845446
        K4 := (sqrt(5)-1)/4;                       // 0.30901699437494742410
        K5 := sqrt(sqrt((65-sqrt(5)*29)*6/5)/2)/2; // 0.23181989086381806018
        K2R := K2 / R;
        K5R := K5 / sqrt(R * R2);

        D1 := R * sqrt(5)/3;
        D2 := R * sqrt((sqrt(5)*2+5)/15);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
        <Axis NormVector = "Vx[6]; Vy[6]; Vz[6]" />
        <Axis NormVector = "Vx[7]; Vy[7]; Vz[7]" />
        <Axis NormVector = "Vx[8]; Vy[8]; Vz[8]" />
        <Axis NormVector = "Vx[9]; Vy[9]; Vz[9]" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "AddDodecEdge">
            <Part>
                <Vertices>
                    <Add Vector = "Vx[i1]; Vy[i1]; Vz[i1]" />
                    <Add Vector = "Vx[i2]; Vy[i2]; Vz[i2]" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 - (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) * K2R;
                                   (Vy[i1] + Vy[i2]) * K1 - (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) * K2R;
                                   (Vz[i1] + Vz[i2]) * K1 - (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) * K2R" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 + (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) * K2R;
                                   (Vy[i1] + Vy[i2]) * K1 + (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) * K2R;
                                   (Vz[i1] + Vz[i2]) * K1 + (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) * K2R" />
                </Vertices>
                <Faces>
                    <Face Color = "cl[c1]" VertexIndexes = "0;2;1" />
                    <Face Color = "cl[c2]" VertexIndexes = "0;1;3" />
                    <Face VertexIndexes = "2;0;3" />
                    <Face VertexIndexes = "1;2;3" />
                </Faces>
            </Part>
        </Macro>
        
        <Macro Name = "AddStiEdge">
            <Part>
                <Vertices>
                    <Add Vector = "Wx[iw]; Wy[iw]; Wz[iw]" />
                    <Add Vector = "Vx[iv]; Vy[iv]; Vz[iv]" />
                    <Add Vector = "Wx[iw] * K3 + Vx[iv] * K4 - (Wy[iw] * Vz[iv] - Wz[iw] * Vy[iv]) * K5R;
                                   Wy[iw] * K3 + Vy[iv] * K4 - (Wz[iw] * Vx[iv] - Wx[iw] * Vz[iv]) * K5R;
                                   Wz[iw] * K3 + Vz[iv] * K4 - (Wx[iw] * Vy[iv] - Wy[iw] * Vx[iv]) * K5R" />
                    <Add Vector = "Wx[iw] * K3 + Vx[iv] * K4 + (Wy[iw] * Vz[iv] - Wz[iw] * Vy[iv]) * K5R;
                                   Wy[iw] * K3 + Vy[iv] * K4 + (Wz[iw] * Vx[iv] - Wx[iw] * Vz[iv]) * K5R;
                                   Wz[iw] * K3 + Vz[iv] * K4 + (Wx[iw] * Vy[iv] - Wy[iw] * Vx[iv]) * K5R" />
                </Vertices>
                <Faces>
                    <Face Color = "cl[ca]" VertexIndexes = "0;2;1" />
                    <Face Color = "cl[cb]" VertexIndexes = "0;1;3" />
                    <Face VertexIndexes = "2;0;3" />
                    <Face VertexIndexes = "1;2;3" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "AddStiStar">
