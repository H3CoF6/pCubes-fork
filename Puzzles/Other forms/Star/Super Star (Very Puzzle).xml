            <ExecMacro MacroName = "AddStiEdge" iw = "iw1" iv = "iv4" ca = "c4" cb = "c2" />
            <ExecMacro MacroName = "AddStiEdge" iw = "iw1" iv = "iv5" ca = "c5" cb = "c3" />
