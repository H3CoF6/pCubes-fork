<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Four-Pointed Star</Name>
        <Menu>Other forms\Star\Four-Pointed Star</Menu>
        <Inventor>Guan Yang</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-01-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8140</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        K  := 0.3;

        C0 := K * 5 / 3;
        C1 := K;

        D := K / sqrt(3);

        DCut := K * 1.5;
        DCut2 := (DCut * sqrt(6) * 2 + C1) / 3 / sqrt(3);
    </Script>

    <Axes TurningAngles = "2*Pi / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1; C1; C1" />
                <Add Vector = " C1;-C1;-C1" />
                <Add Vector = "-C1;-C1; C1" />
                <Add Vector = "-C1; C1;-C1" />
                <Add Vector = " C0;-C0; C0" />
                <Add Vector = " C0; C0;-C0" />
                <Add Vector = "-C0; C0; C0" />
                <Add Vector = "-C0;-C0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[5]" VertexIndexes = "4;0;2" />
                <Face Color = "Colors[2]" VertexIndexes = "4;2;1" />
                <Face Color = "Colors[1]" VertexIndexes = "4;1;0" />

                <Face Color = "Colors[1]" VertexIndexes = "5;0;1" />
                <Face Color = "Colors[4]" VertexIndexes = "5;1;3" />
                <Face Color = "Colors[3]" VertexIndexes = "5;3;0" />

                <Face Color = "Colors[3]" VertexIndexes = "6;0;3" />
                <Face Color = "Colors[0]" VertexIndexes = "6;3;2" />
                <Face Color = "Colors[5]" VertexIndexes = "6;2;0" />

                <Face Color = "Colors[2]" VertexIndexes = "7;1;2" />
                <Face Color = "Colors[0]" VertexIndexes = "7;2;3" />
                <Face Color = "Colors[4]" VertexIndexes = "7;3;1" />
            </Faces>
        </Part>

        <Macro Name = "Split" >
            <Split Axis = "ax" From = "1" />
            <Script>Inc(ax);</Script>
        </Macro>

        <ExecMacro MacroName = "Split" ax = "0" Repeat = "7" />

        <!-- cut edge parts for better control -->
        <Macro Name = "Cut" >
            <Cut><Plane NormVector = " 2; 1;-1" NormDistance = "-DCut" /> </Cut>
            <Turn NormVector = " 1;-1; 1" Angle = "2*Pi / 3" />
        </Macro>
        <Macro Name = "Cut3" >
            <Hide><Plane NormVector = " 1;-1; 1" NormDistance = " D" /> </Hide>
            <ExecMacro MacroName = "Cut" Repeat = "3" />
            <ShowAll/>
            <Turn NormVector = " 0; 0; 1" Angle = "Pi" />
        </Macro>
        <ExecMacro MacroName = "Cut3" Repeat = "2" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut3" Repeat = "2" />
        <Turn NormVector = " 0; 1; 0" Angle = "Pi" />

        <!-- cut inner parts for better visibility -->
        <HideContaining Vector = " C1;-C1;-C1" />
        <HideContaining Vector = "-C1; C1;-C1" />
        <HideContaining Vector = "-C1;-C1; C1" />
        <HideContaining Vector = " C1; C1; C1" />
        <InvertVisibility/>
        <Cut><Plane NormVector = "-1; 1; 1" NormDistance = "-DCut2" /> </Cut>
        <Cut><Plane NormVector = " 1;-1; 1" NormDistance = "-DCut2" /> </Cut>
        <Cut><Plane NormVector = " 1; 1;-1" NormDistance = "-DCut2" /> </Cut>
        <Cut><Plane NormVector = "-1;-1;-1" NormDistance = "-DCut2" /> </Cut>
        <ShowAll/>

        <SaveSolvedState/>
        <Turn Axis = "4" Layers = "0-1" Angle = "Pi/2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
