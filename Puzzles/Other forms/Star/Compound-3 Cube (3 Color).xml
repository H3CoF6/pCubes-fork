<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Compound-3 Cube (3 Color)</Name>
        <Menu>Other forms\Star\Compound-3 Cube (3 Color)</Menu>
        <Inventor>Eitan Cher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1783</Link>
        <Link>https://www.youtube.com/watch?v=Ynn3A2jfPEs</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clBlue   := '0000A0';
        clRed    := 'FF0000';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        s2 := sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-W; W" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = "-1; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-W; W" FixedLayers = "1" >
        <Axis NormVector = " 1; 0;  0" />
        <Axis NormVector = " 0; 1;  0" />
        <Axis NormVector = " 1; 1; s2" />
        <Axis NormVector = "-1; 1; s2" />
        <Axis NormVector = " 1;-1; s2" />
        <Axis NormVector = "-1;-1; s2" />
    </Axes>

    <Figure>
        <Macro Name = "AddCube" >
            <LoadFrom File = "Figures\CubeMono.xml" Width = "W" />
            <SplitByAxes/>
            <HideContaining Vector = "Vx;Vy;Vz" />
            <RemoveContaining Vector = " W; W; 0" />
            <RemoveContaining Vector = "-W; W; 0" />
            <RemoveContaining Vector = " W;-W; 0" />
            <RemoveContaining Vector = "-W;-W; 0" />
            <HideContaining Vector = "Ex; Ey; Ez" />
            <RemoveAllVisible/>
            <Turn NormVector = "s2; 0; 1" Angle = "2 * Pi / 3" />
        </Macro>

        <Macro Name = "AddGray" >
            <HideAll/>
            <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />
            <SplitByAxes/>
            <RemoveContaining Vector = "Vx;Vy;Vz" />
            <Cut><Plane NormVector = "-1; 1; s2" NormDistance = "-W" /> </Cut>
            <Cut><Plane NormVector = " 1;-1; s2" NormDistance = "-W" /> </Cut>
            <Cut><Plane NormVector = "-1; 1;-s2" NormDistance = "-W" /> </Cut>
            <Cut><Plane NormVector = " 1;-1;-s2" NormDistance = "-W" /> </Cut>
            <Cut><Plane NormVector = "-1; 1;  0" NormDistance = "-W" /> </Cut>
            <Cut><Plane NormVector = " 1;-1;  0" NormDistance = "-W" /> </Cut>
            <RemoveContaining Vector = " 0; 0; KeepCenter" />
            <Turn NormVector = "s2; 0; 1" Angle = "2 * Pi / 3" />
        </Macro>

        <ExecMacro MacroName = "AddCube" Color = "clBlue  " />
        <ExecMacro MacroName = "AddCube" Color = "clYellow" />
        <ExecMacro MacroName = "AddCube" Color = "clRed   " />
        <ExecMacro MacroName = "AddGray" KeepCenter = "0" />
        <ExecMacro MacroName = "AddGray" KeepCenter = "0" />
        <ExecMacro MacroName = "AddGray" KeepCenter = "1" />
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
