<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>PentaBarrel</Name>
        <Menu>Other forms\Star\PentaBarrel</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-09-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6998</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF6000'; // clOrange
        Colors[2] := '008000'; // clGreen
        Colors[3] := '0000A0'; // clBlue
        Colors[4] := '800080'; // clViolett

        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        R := 0.65;
        H := 0.5;

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;

        D1 := H / 3;
        D2 := R * 0.31;
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "-D1;D1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D2" >
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
        <Axis NormVector = " x[3]; y[3]; 0" />
        <Axis NormVector = " x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite  " VertexIndexes = "0;1;2" />
                <Face                     VertexIndexes = "1;0;3;4" />
                <Face                     VertexIndexes = "0;2;5;3" />
                <Face                     VertexIndexes = "2;1;4;5" />
                <Face Color = "clYellow " VertexIndexes = "5;4;3" />
            </Faces>
        </Part>
        <Cut Axis = "1" To = "1" />
        <Cut Axis = "3" To = "1" />
        <Cut Axis = "4" To = "1" />

        <Macro Name = "Ray">
            <InvertVisibility />
            <Part>
                <Vertices>
                    <Add Vector = "x[0]; y[0];  H" />
                    <Add Vector = "x[2]; y[2];  H" />
                    <Add Vector = "x[3]; y[3];  H" />
                    <Add Vector = "x[0]; y[0]; -H" />
                    <Add Vector = "x[2]; y[2]; -H" />
                    <Add Vector = "x[3]; y[3]; -H" />
                </Vertices>

                <Faces>
                    <Face Color = "clWhite   " VertexIndexes = "0;1;2" />
                    <Face Color = "Colors[c1]" VertexIndexes = "1;0;3;4" />
                    <Face Color = "Colors[c2]" VertexIndexes = "0;2;5;3" />
                    <Face Color = "Colors[c3]" VertexIndexes = "2;1;4;5" />
                    <Face Color = "clYellow  " VertexIndexes = "5;4;3" />
                </Faces>
            </Part>
            <Cut Axis = "1" From = "1" />
            <ShowAll/>
            <Turn Axis = "0" From = "0" To = "2" Angle = "2 * Pi / 5" />
        </Macro>
        <ExecMacro MacroName = "Ray" c1 = "1" c2 = "0" c3 = "3" />
        <ExecMacro MacroName = "Ray" c1 = "0" c2 = "4" c3 = "3" />
        <ExecMacro MacroName = "Ray" c1 = "4" c2 = "3" c3 = "3" />
        <ExecMacro MacroName = "Ray" c1 = "3" c2 = "2" c3 = "3" />
        <ExecMacro MacroName = "Ray" c1 = "2" c2 = "1" c3 = "3" />

        <Macro Name = "Segment">
            <InvertVisibility />
            <Cylinder Radius = "0.5" Color = "Colors[c1]" >
                   <Base X = "0" Y = "0" Z = "-H" Color = "clYellow" />
                   <Top  X = "0" Y = "0" Z = " H" Color = "clWhite" />
            </Cylinder>

            <Cut Axis = "3" From = "1" />
            <Cut Axis = "4" From = "1" />
            <ShowAll/>
            <Turn Axis = "0" From = "0" To = "2" Angle = "2 * Pi / 5" />
        </Macro>
        <ExecMacro MacroName = "Segment" c1 = "3" a1 = "0" a2 = "1" />
        <ExecMacro MacroName = "Segment" c1 = "2" a1 = "0" a2 = "1" />
        <ExecMacro MacroName = "Segment" c1 = "1" a1 = "0" a2 = "1" />
        <ExecMacro MacroName = "Segment" c1 = "0" a1 = "0" a2 = "1" />
        <ExecMacro MacroName = "Segment" c1 = "4" a1 = "0" a2 = "1" />

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
