<?xml version = "1.0" encoding = "UTF-8" ?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Star</Name>
        <Menu>Other forms\Star\Stellated Octahedron\Dino Star</Menu>
        <Inventor>Gabor Molnar</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=920</Link>
    </Interface>

    <Script>
        clBlue         := '0000C8';
        clGreen        := '009600';
        clRed          := 'C80000';
        clOrange       := 'FF800A';
        clYellow       := 'FFFF00';
        clWhite        := 'FFFFFF';
        clViolett      := '7700CD';
        clLightViolett := 'FF00B0';

        Colors[0] := clViolett;
        Colors[1] := clGreen;
        Colors[2] := clYellow;
        Colors[3] := clOrange;
        Colors[4] := clRed;
        Colors[5] := clWhite;
        Colors[6] := clBlue;
        Colors[7] := clLightViolett;

        W := 0.5;

        R := W * sqrt(6) / 3;
        D1 := W * 1 / 3;
        D2 := W * (1 / 3 + 0.04); // 0.04 - circle thickness
        DC := D2 * sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-sqrt(3) / 6; sqrt(3) / 6" FixedLayers = "1" >
        <Axis NormVector =  "1;  1;  1" />
        <Axis NormVector =  "1; -1; -1" />
        <Axis NormVector = "-1;  1; -1" />
        <Axis NormVector = "-1; -1;  1" />
    </Axes>

    <Figure>

        <Macro Name = "AddCircle">
            <Cylinder Radius = "R" Color = "Color" >
                <Base X = "cx*D1" Y = "cy*D1" Z = "cz*D1" />
                <Top  X = "cx*D2" Y = "cy*D2" Z = "cz*D2" Color = "Color" />
            </Cylinder>
            <Split> <Plane NormVector = " cx;-cy; cz" NormDistance = "DC" /></Split>
            <Split> <Plane NormVector = "-cx; cy; cz" NormDistance = "DC" /></Split>
            <Split> <Plane NormVector = " cx; cy;-cz" NormDistance = "DC" /></Split>
            <RemoveContaining Vector =  "cx*D2; cy*D2; cz*D2" />
        </Macro>
        <ExecMacro MacroName = "AddCircle" Color = "Colors[0]" cx = "-1" cy = "-1" cz = "-1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[1]" cx = "-1" cy = "-1" cz = " 1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[2]" cx = "-1" cy = " 1" cz = "-1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[3]" cx = "-1" cy = " 1" cz = " 1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[4]" cx = " 1" cy = "-1" cz = "-1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[5]" cx = " 1" cy = "-1" cz = " 1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[6]" cx = " 1" cy = " 1" cz = "-1" />
        <ExecMacro MacroName = "AddCircle" Color = "Colors[7]" cx = " 1" cy = " 1" cz = " 1" />

        <Part>
            <Vertices>
                 <Add Vector = "-W; -W; -W" />
                 <Add Vector = " W; -W;  W" />
                 <Add Vector = "-W;  W;  W" />
                 <Add Vector = " W;  W; -W" />
            </Vertices>

            <Faces>
                <Face VertexIndexes = "1;2;0" />
                <Face VertexIndexes = "2;3;0" />
                <Face VertexIndexes = "3;1;0" />
                <Face VertexIndexes = "3;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />

        <Part>
            <Vertices>
                <Add Vector = "-W; -W;  W" />
                <Add Vector = "-W;  W; -W" />
                <Add Vector = " W; -W; -W" />
                <Add Vector = " W;  W;  W" />
            </Vertices>

            <Faces>
                <Face VertexIndexes = "1;2;0" />
                <Face VertexIndexes = "2;3;0" />
                <Face VertexIndexes = "3;1;0" />
                <Face VertexIndexes = "3;2;1" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>

