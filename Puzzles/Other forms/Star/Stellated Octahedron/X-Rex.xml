<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>X-Rex</Name>
        <Menu>Other forms\Star\Stellated Octahedron\X-Rex</Menu>
        <Inventor>Benjy Oliver</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-12-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4501</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        Colors[ 6] := '00FFFF'; // clCyan
        Colors[ 7] := '008080'; // clTeal
        Colors[ 8] := 'FF00FF'; // clFuchsia
        Colors[ 9] := '00FF00'; // clLime
        Colors[10] := 'FF69B4'; // clPink
        Colors[11] := '004000'; // clDarkGreen
        Colors[12] := '808000'; // clOlive
        Colors[13] := '800000'; // clBrown

        W := 0.5;
        A := W * 1.3;
        B := A - W;

        D := W / sqrt(3);

        Nx := 2 - (B + A) / W;
        ND := (B + A) / sqrt(Nx^2 + 2);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube Pillowed.xml" />
        <SplitByAxes/>

        <Macro Name = "Cut1" >
            <HideContaining Vector = " 0;-W; W"/>
            <InvertVisibility/>
            <Split><Plane NormVector = "1;0;0" /></Split>
            <HideContaining Vector = "-W;-W; W"/>
            <Cut Color = "Colors[c]" ><Plane NormVector = " Nx; 1;-1" NormDistance = "-ND" /></Cut>
            <ShowAll/>
            <Turn NormVector = "-1;-1; 1" Angle = "2*Pi/3" />
        </Macro>
        <Macro Name = "Cut3" >
            <ExecMacro MacroName = "Cut1" Repeat = "3" />
            <Script> Inc(c); </Script>
            <Turn NormVector = " 0; 0; 1" Angle = "Pi/2" />
        </Macro>
        <ExecMacro MacroName = "Cut3" c = "6" Repeat = "4" />
        <Turn NormVector = " 1; 0; 0" Angle = "Pi" />
        <ExecMacro MacroName = "Cut3" Repeat = "4" />
        <Turn NormVector = " 1; 0; 0" Angle = "Pi" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
