<?xml version = "1.0" encoding = "UTF-8" ?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dual Helicoptrahedron</Name>
        <Menu>Other forms\Star\Stellated Octahedron\Dual Helicoptrahedron</Menu>
        <Inventor>Traiphum Prungtaengkit</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3598</Link>
    </Interface>

    <Script>
        clBlue         := '0000C8';
        clGreen        := '009600';
        clRed          := 'C80000';
        clOrange       := 'FF800A';
        clYellow       := 'FFFF00';
        clWhite        := 'FFFFFF';
        clViolett      := '7700CD';
        clLightViolett := 'FF00B0';

        Colors[0] := clViolett;
        Colors[1] := clGreen;
        Colors[2] := clYellow;
        Colors[3] := clOrange;
        Colors[4] := clRed;
        Colors[5] := clWhite;
        Colors[6] := clBlue;
        Colors[7] := clLightViolett;

        W := 0.5;

        D := W / sqrt(2);
        DCut := W / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 1; 0" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 0; 1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = " 0; 1;-1" />
    </Axes>

    <Figure>

        <Part>
            <Vertices>
                 <Add Vector = "-W; -W; -W" />
                 <Add Vector = " W; -W;  W" />
                 <Add Vector = "-W;  W;  W" />
                 <Add Vector = " W;  W; -W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "1;2;0" />
                <Face Color = "Colors[2]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[4]" VertexIndexes = "3;1;0" />
                <Face Color = "Colors[7]" VertexIndexes = "3;2;1" />
            </Faces>
        </Part>

        <Split><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /></Split>
        <RemoveContaining Vector = "0; 0; 0" />

        <Part>
            <Vertices>
                <Add Vector = "-W; -W;  W" />
                <Add Vector = "-W;  W; -W" />
                <Add Vector = " W; -W; -W" />
                <Add Vector = " W;  W;  W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;2;0" />
                <Face Color = "Colors[5]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[3]" VertexIndexes = "3;1;0" />
                <Face Color = "Colors[6]" VertexIndexes = "3;2;1" />
            </Faces>
        </Part>

        <Split><Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /></Split>
        <RemoveContaining Vector = "0; 0; 0" />

        <SplitByAxes/>
    </Figure>
</xml>
