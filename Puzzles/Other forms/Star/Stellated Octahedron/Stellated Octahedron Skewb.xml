<?xml version = "1.0" encoding = "UTF-8" ?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Stellated Octahedron Skewb</Name>
        <Menu>Other forms\Star\Stellated Octahedron\Stellated Octahedron Skewb</Menu>
        <Menu>Other forms\Skewb variants\Star\Stellated Octahedron Skewb</Menu>
        <Inventor>Jürgen Brandt</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-11-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3222</Link>
    </Interface>

    <Script>
        Colors[0] := '009600'; // Green
        Colors[1] := 'C80000'; // Yellow
        Colors[2] := 'FFFF00'; // Red
        Colors[3] := 'FF00B0'; // LightViolett
        Colors[4] := '0000C8'; // Violett
        Colors[5] := 'FFFFFF'; // White
        Colors[6] := 'FF800A'; // Orange
        Colors[7] := '7700CD'; // Blue

        W := 0.5;

        D := W / sqrt(2);
        DCut := W / sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>

        <Part>
            <Vertices>
                 <Add Vector = "-W; -W; -W" />
                 <Add Vector = " W; -W;  W" />
                 <Add Vector = "-W;  W;  W" />
                 <Add Vector = " W;  W; -W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "1;2;0" />
                <Face Color = "Colors[1]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[2]" VertexIndexes = "3;1;0" />
                <Face Color = "Colors[3]" VertexIndexes = "3;2;1" />
            </Faces>
        </Part>

        <Split><Plane NormVector = " 1; 1; 1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = " 1;-1;-1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = "-1; 1;-1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = "-1;-1; 1" NormDistance = "-DCut" /></Split>
        <RemoveContaining Vector = "0; 0; 0" />

        <Part>
            <Vertices>
                <Add Vector = "-W; -W;  W" />
                <Add Vector = "-W;  W; -W" />
                <Add Vector = " W; -W; -W" />
                <Add Vector = " W;  W;  W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[4]" VertexIndexes = "1;2;0" />
                <Face Color = "Colors[5]" VertexIndexes = "2;3;0" />
                <Face Color = "Colors[6]" VertexIndexes = "3;1;0" />
                <Face Color = "Colors[7]" VertexIndexes = "3;2;1" />
            </Faces>
        </Part>

        <Split><Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /></Split>
        <Split><Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /></Split>
        <RemoveContaining Vector = "0; 0; 0" />

        <SplitByAxes/>
    </Figure>
</xml>
