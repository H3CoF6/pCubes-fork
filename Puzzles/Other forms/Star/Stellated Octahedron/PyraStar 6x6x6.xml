<?xml version = "1.0" encoding = "UTF-8" ?>
<xml Data_Version = "2" >

    <Interface>
        <Name>PyraStar 6x6x6</Name>
        <Menu>Other forms\Star\Stellated Octahedron\PyraStar 6x6x6</Menu>
        <Inventor>Alberto Costa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7539</Link>
    </Interface>

    <Script>
        Colors[0] := '0000C8'; // clBlue
        Colors[1] := '009600'; // clGreen
        Colors[2] := 'C80000'; // clRed
        Colors[3] := 'FFFF00'; // clYellow

        W := 0.5;

        include 'Figures\Scripts\Tetrahedron_Standard_Colors.inc';

        D := W * 0.24;

    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2*D;-D;0;D;2*D" >
        <Axis NormVector =  "1; 0; 0" />
        <Axis NormVector =  "0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                 <Add Vector = "-W; -W; -W" />
                 <Add Vector = "-W;  0;  0" />
                 <Add Vector = " 0; -W;  0" />
                 <Add Vector = " 0;  0; -W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[2]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[2]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = "-W;  W; -W" />
                 <Add Vector = " 0;  W;  0" />
                 <Add Vector = "-W;  0;  0" />
                 <Add Vector = " 0;  0; -W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[1]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[2]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = " W;  W; -W" />
                 <Add Vector = " W;  0;  0" />
                 <Add Vector = " 0;  W;  0" />
                 <Add Vector = " 0;  0; -W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[0]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[0]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = " W; -W; -W" />
                 <Add Vector = " 0; -W;  0" />
                 <Add Vector = " W;  0;  0" />
                 <Add Vector = " 0;  0; -W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[2]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[3]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[0]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = "-W;  W;  W" />
                 <Add Vector = "-W;  0;  0" />
                 <Add Vector = " 0;  W;  0" />
                 <Add Vector = " 0;  0;  W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[1]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = "-W; -W;  W" />
                 <Add Vector = " 0; -W;  0" />
                 <Add Vector = "-W;  0;  0" />
                 <Add Vector = " 0;  0;  W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[3]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[2]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[1]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = " W; -W;  W" />
                 <Add Vector = " W;  0;  0" />
                 <Add Vector = " 0; -W;  0" />
                 <Add Vector = " 0;  0;  W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[3]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[3]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[3]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                 <Add Vector = " W;  W;  W" />
                 <Add Vector = " 0;  W;  0" />
                 <Add Vector = " W;  0;  0" />
                 <Add Vector = " 0;  0;  W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[1]" VertexIndexes = "0;1;3" />
                <Face Color = "Colors[0]" VertexIndexes = "0;2;1" />
                <Face Color = "Colors[3]" VertexIndexes = "0;3;2" />
                <Face                     VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
        <Turn From = "0" To = "5" Angle = "Pi / 2" />
        <SaveSolvedState/>
        <Undo/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>

