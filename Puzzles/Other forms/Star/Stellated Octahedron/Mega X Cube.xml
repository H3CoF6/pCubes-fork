<?xml version = "1.0" encoding = "UTF-8" ?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mega X Cube</Name>
        <Menu>Other forms\Star\Stellated Octahedron\Mega X Cube</Menu>
        <Inventor>Manish Rathod</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11832</Link>
        <Link>https://www.youtube.com/watch?v=ztKWlB9kQ4U</Link>
    </Interface>

    <Script>
        Colors[0] := '7700CD'; // Violett
        Colors[1] := '009600'; // Green
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := 'FF800A'; // Orange
        Colors[4] := 'C80000'; // Red
        Colors[5] := 'FFFFFF'; // White
        Colors[6] := '0000C8'; // Blue
        Colors[7] := 'FF00B0'; // LightViolett

        W := 0.5;

        D := W * sqrt((5 - 2 * sqrt(5)) / 5);
        DCut := W / sqrt(3);

        include 'Figures\Scripts\Dodecahedron_Sq_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "0; 2*Pi / 5" PlaneDistances = "D" NormVectors = "Cx;Cy;Cz" />

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "W" Color = "-1" />

        <Split Color2 = "Colors[0]" ><Plane NormVector = "-1;-1;-1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[1]" ><Plane NormVector = " 1;-1;-1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[2]" ><Plane NormVector = "-1; 1;-1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[3]" ><Plane NormVector = " 1; 1;-1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[4]" ><Plane NormVector = "-1;-1; 1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[5]" ><Plane NormVector = " 1;-1; 1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[6]" ><Plane NormVector = "-1; 1; 1" NormDistance = "DCut" /></Split>
        <Split Color2 = "Colors[7]" ><Plane NormVector = " 1; 1; 1" NormDistance = "DCut" /></Split>
        <RemoveGrayParts/>
        <RemoveContaining Vector = "0;0;0" />

        <SplitByAxes/>
    </Figure>
</xml>
