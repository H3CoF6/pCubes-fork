<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

<!-- form is Triangular orthobicupola -->

    <Interface>
        <Name>AntiRainbow</Name>
        <Menu>Other forms\Johnson Solids\(J27) Triangular Orthobicupola\AntiRainbow</Menu>
        <Inventor>William Kretschmer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4326</Link>
    </Interface>

    <Script>
        clWhite   := 'F0F0F0';
        clCyan    := '00FFFF';
        clTeal    := '008080';
        clBlue    := '0000FF';
        clRed     := 'FF0000';
        clBrown   := '800000';
        clYellow  := 'FFFF00';
        clOrange  := 'FF6000';
        clGolden  := 'DDBB20';
        clOlive   := '808000';
        clLime    := '00FF00';
        clGreen   := '008000';
        clPink    := 'FF69B4';
        clFuchsia := 'FF00FF';

        X1 := 1 / 2;
        X2 := 1 / 4;
        X3 := 3 / 4;
        Y1 := 1 / sqrt(3);
        Y2 := 1 / 2 / sqrt(3);
        Y3 := 5 / 4 / sqrt(3);
        Y4 := 1 / 4 / sqrt(3);
        H  := 1 / 2;

        ax  := sqrt(3) / 2;
        ay1 := 1;
        ay2 := 1 / 2;
        az  := 1 / sqrt(3);

        A1  := ArcCos(1/7);

        D  := 5 / 13;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "  0;-ay1; az" />
        <Axis NormVector = " ax; ay2; az" />
        <Axis NormVector = "-ax; ay2; az" />
        <Axis NormVector = "  0;-ay1;-az" />
        <Axis NormVector = " ax; ay2;-az" />
        <Axis NormVector = "-ax; ay2;-az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  Y1;  H" />
                <Add Vector = " X1; -Y2;  H" />
                <Add Vector = "-X1; -Y2;  H" />

                <Add Vector = "-X2;  Y3;  0" />
                <Add Vector = " X2;  Y3;  0" />
                <Add Vector = " X3; -Y4;  0" />
                <Add Vector = " X1; -Y1;  0" />
                <Add Vector = "-X1; -Y1;  0" />
                <Add Vector = "-X3; -Y4;  0" />

                <Add Vector = "  0;  Y1; -H" />
                <Add Vector = " X1; -Y2; -H" />
                <Add Vector = "-X1; -Y2; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clYellow"  VertexIndexes = " 0; 2; 1" />

                <Face Color = "clGolden"  VertexIndexes = " 0; 4; 3" />
                <Face Color = "clRed"     VertexIndexes = " 0; 1; 5; 4" />
                <Face Color = "clPink"    VertexIndexes = " 1; 6; 5" />
                <Face Color = "clBlue"    VertexIndexes = " 1; 2; 7; 6" />
                <Face Color = "clBrown"   VertexIndexes = " 2; 8; 7" />
                <Face Color = "clGreen"   VertexIndexes = " 2; 0; 3; 8" />

                <Face Color = "clOlive"   VertexIndexes = " 9; 3; 4" />
                <Face Color = "clOrange"  VertexIndexes = " 9; 4; 5;10" />
                <Face Color = "clFuchsia" VertexIndexes = "10; 5; 6" />
                <Face Color = "clCyan"    VertexIndexes = "10; 6; 7;11" />
                <Face Color = "clTeal"    VertexIndexes = "11; 7; 8" />
                <Face Color = "clLime"    VertexIndexes = "11; 8; 3; 9" />

                <Face Color = "clWhite"   VertexIndexes = "  9;10;11" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Turn Axis = "5" Layer = "1" Angle = "Pi" />
        <Hide Axis = "0" Layer="1" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Turn Axis = "5" Layer = "1" Angle = "Pi" />
        <ShowAll/>

        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Turn Axis = "6" Layer = "1" Angle = "Pi" />
        <Hide Axis = "0" Layer="1" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Turn Axis = "6" Layer = "1" Angle = "Pi" />
        <ShowAll/>

        <Turn Axis = "3" Layer = "1" Angle = "Pi" />
        <Turn Axis = "4" Layer = "1" Angle = "Pi" />
        <Hide Axis = "0" Layer="1" />
        <SplitByAxes/>
        <Turn Axis = "3" Layer = "1" Angle = "Pi" />
        <Turn Axis = "4" Layer = "1" Angle = "Pi" />
        <ShowAll/>

        <HideContaining Vector = "  0; Y1; H" />
        <HideContaining Vector = " X1;-Y2; H" />
        <HideContaining Vector = "-X1;-Y2; H" />
        <HideContaining Vector = "  0; Y1;-H" />
        <HideContaining Vector = " X1;-Y2;-H" />
        <HideContaining Vector = "-X1;-Y2;-H" />

        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Turn Axis = "4" Layer = "1" Angle = "Pi" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Hide Axis = "0" Layer="1" />
        <SplitByAxes/>
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <Turn Axis = "4" Layer = "1" Angle = "Pi" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi" />
        <ShowAll/>

        <HideContaining Vector = "  0; Y1; H" />
        <HideContaining Vector = " X1;-Y2; H" />
        <HideContaining Vector = "-X1;-Y2; H" />
        <HideContaining Vector = "  0; Y1;-H" />
        <HideContaining Vector = " X1;-Y2;-H" />
        <HideContaining Vector = "-X1;-Y2;-H" />

        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Turn Axis = "5" Layer = "1" Angle = "Pi" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Hide Axis = "0" Layer="1" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <Turn Axis = "5" Layer = "1" Angle = "Pi" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi" />
        <ShowAll/>

        <HideContaining Vector = "  0; Y1; H" />
        <HideContaining Vector = " X1;-Y2; H" />
        <HideContaining Vector = "-X1;-Y2; H" />
        <HideContaining Vector = "  0; Y1;-H" />
        <HideContaining Vector = " X1;-Y2;-H" />
        <HideContaining Vector = "-X1;-Y2;-H" />

        <Turn  Axis = "3" Layer = "1" Angle = "Pi" />
        <Turn  Axis = "6" Layer = "1" Angle = "Pi" />
        <Turn  Axis = "3" Layer = "1" Angle = "Pi" />
        <Hide  Axis = "0" Layer="1" />
        <SplitByAxes/>
        <Turn  Axis = "3" Layer = "1" Angle = "Pi" />
        <Turn  Axis = "6" Layer = "1" Angle = "Pi" />
        <Turn  Axis = "3" Layer = "1" Angle = "Pi" />
        <ShowAll/>

        <Turn  Axis = "1" Layer = "1" Angle = " A1" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "1" Layer = "1" Angle = "-A1" />
        <Split Axis = "3" From  = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = " A1" />

        <Turn  Axis = "2" Layer = "1" Angle = " A1" />
        <Split Axis = "3" From  = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "2" Layer = "1" Angle = "-A1" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = " A1" />

        <Turn  Axis = "3" Layer = "1" Angle = " A1" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "3" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "3" Layer = "1" Angle = "-A1" />
        <Split Axis = "2" From  = "1" />
        <Turn  Axis = "3" Layer = "1" Angle = " A1" />
        
        <Turn  Axis = "4" Layer = "1" Angle = " A1" />
        <Split Axis = "6" From  = "1" />
        <Turn  Axis = "4" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "4" Layer = "1" Angle = "-A1" />
        <Split Axis = "5" From  = "1" />
        <Turn  Axis = "4" Layer = "1" Angle = " A1" />

        <Turn  Axis = "5" Layer = "1" Angle = " A1" />
        <Split Axis = "4" From  = "1" />
        <Turn  Axis = "5" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "5" Layer = "1" Angle = "-A1" />
        <Split Axis = "6" From  = "1" />
        <Turn  Axis = "5" Layer = "1" Angle = " A1" />

        <Turn  Axis = "6" Layer = "1" Angle = " A1" />
        <Split Axis = "5" From  = "1" />
        <Turn  Axis = "6" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "6" Layer = "1" Angle = "-A1" />
        <Split Axis = "4" From  = "1" />
        <Turn  Axis = "6" Layer = "1" Angle = " A1" />

    </Figure>
</xml>
