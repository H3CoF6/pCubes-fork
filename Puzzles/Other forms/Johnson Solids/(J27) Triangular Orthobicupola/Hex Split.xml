<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hex Split</Name>
        <Menu>Other forms\Johnson Solids\(J27) Triangular Orthobicupola\Hex Split</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-30</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2776</Link>
    </Interface>

    <Script>
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBrown  := '800000';
        clSilver := 'A0A0A0';
        clOrange := 'FF6000';
        clPink   := 'FF69B4';

        W := 0.55;

        pA := W;
        pB := W / sqrt(3);
        pC := pB * 2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "-pB; 0; pB" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 1; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " pB;  pB;  pA" />
                <Add Vector = " pB; -pB;  pA" />
                <Add Vector = "-pB; -pB;  pA" />
                <Add Vector = "-pB;  pB;  pA" />

                <Add Vector = " pC;  pB;  0" />
                <Add Vector = " pC; -pB;  0" />
                <Add Vector = " pB; -pC;  0" />
                <Add Vector = "-pB; -pC;  0" />
                <Add Vector = "-pC; -pB;  0" />
                <Add Vector = "-pC;  pB;  0" />
                <Add Vector = "-pB;  pC;  0" />
                <Add Vector = " pB;  pC;  0" />

                <Add Vector = " pB;  pB; -pA" />
                <Add Vector = " pB; -pB; -pA" />
                <Add Vector = "-pB; -pB; -pA" />
                <Add Vector = "-pB;  pB; -pA" />

                <Add Vector = " pB;  0 ;  pA" />
                <Add Vector = " 0 ; -pB;  pA" />
                <Add Vector = "-pB;  0 ;  pA" />
                <Add Vector = " 0 ;  pB;  pA" />
                <Add Vector = " 0 ;  0 ;  pA" />

                <Add Vector = " pC;  0 ;  0" />
                <Add Vector = " 0 ; -pC;  0" />
                <Add Vector = "-pC;  0 ;  0" />
                <Add Vector = " 0 ;  pC;  0" />

                <Add Vector = " pB;  0 ; -pA" />
                <Add Vector = " 0 ; -pB; -pA" />
                <Add Vector = "-pB;  0 ; -pA" />
                <Add Vector = " 0 ;  pB; -pA" />
                <Add Vector = " 0 ;  0 ; -pA" />
            </Vertices>

            <Faces>
                <Face Color = "clRed   " VertexIndexes = "20;17; 1;16" />
                <Face Color = "clGreen " VertexIndexes = "20;18; 2;17" />
                <Face Color = "clBlue  " VertexIndexes = "20;19; 3;18" />
                <Face Color = "clYellow" VertexIndexes = "20;16; 0;19" />

                <Face Color = "clYellow" VertexIndexes = " 0;16;21; 4" />
                <Face Color = "clRed   " VertexIndexes = "16; 1; 5;21" />
                <Face Color = "clRed   " VertexIndexes = " 1;17;22; 6" />
                <Face Color = "clGreen " VertexIndexes = "17; 2; 7;22" />
                <Face Color = "clGreen " VertexIndexes = " 2;18;23; 8" />
                <Face Color = "clBlue  " VertexIndexes = "18; 3; 9;23" />
                <Face Color = "clBlue  " VertexIndexes = " 3;19;24;10" />
                <Face Color = "clYellow" VertexIndexes = "19; 0;11;24" />

                <Face Color = "clYellow" VertexIndexes = " 0; 4;11" />
                <Face Color = "clRed   " VertexIndexes = " 1; 6; 5" />
                <Face Color = "clGreen " VertexIndexes = " 2; 8; 7" />
                <Face Color = "clBlue  " VertexIndexes = " 3;10; 9" />

                <Face Color = "clOrange" VertexIndexes = " 4;21;25;12" />
                <Face Color = "clPink  " VertexIndexes = "21; 5;13;25" />
                <Face Color = "clPink  " VertexIndexes = " 6;22;26;13" />
                <Face Color = "clBrown " VertexIndexes = "22; 7;14;26" />
                <Face Color = "clBrown " VertexIndexes = " 8;23;27;14" />
                <Face Color = "clSilver" VertexIndexes = "23; 9;15;27" />
                <Face Color = "clSilver" VertexIndexes = "10;24;28;15" />
                <Face Color = "clOrange" VertexIndexes = "24;11;12;28" />

                <Face Color = "clOrange" VertexIndexes = "12;11; 4" />
                <Face Color = "clPink  " VertexIndexes = "13; 5; 6" />
                <Face Color = "clBrown " VertexIndexes = "14; 7; 8" />
                <Face Color = "clSilver" VertexIndexes = "15; 9;10" />

                <Face Color = "clPink  " VertexIndexes = "29;25;13;26" />
                <Face Color = "clBrown " VertexIndexes = "29;26;14;27" />
                <Face Color = "clSilver" VertexIndexes = "29;27;15;28" />
                <Face Color = "clOrange" VertexIndexes = "29;28;12;25" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "1" From = "1" To = "2" Angle = "   Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "1" From = "1" To = "2" Angle = "-2*Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "1" From = "1" To = "2" Angle = "   Pi/3" />

        <Turn Axis = "2" From = "1" To = "2" Angle = "   Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "2" From = "1" To = "2" Angle = "-2*Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "2" From = "1" To = "2" Angle = "   Pi/3" />

        <Turn Axis = "1" From = "1" To = "2" Angle = "   Pi/3" />
        <Turn Axis = "2" From = "1" To = "2" Angle = "  -Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "2" From = "1" To = "2" Angle = " 2*Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "2" From = "1" To = "2" Angle = "  -Pi/3" />
        <Turn Axis = "1" From = "1" To = "2" Angle = "  -Pi/3" />
        <RemoveGrayParts/>

        <Turn Axis = "1" From = "1" To = "2" Angle = "  -Pi/3" />
        <Turn Axis = "2" From = "1" To = "2" Angle = "  -Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "2" From = "1" To = "2" Angle = " 2*Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "2" From = "1" To = "2" Angle = "  -Pi/3" />
        <Turn Axis = "1" From = "1" To = "2" Angle = "   Pi/3" />
        <RemoveGrayParts/>

        <Turn Axis = "2" From = "1" To = "2" Angle = "   Pi/3" />
        <Turn Axis = "1" From = "1" To = "2" Angle = "  -Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "1" From = "1" To = "2" Angle = " 2*Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "1" From = "1" To = "2" Angle = "  -Pi/3" />
        <Turn Axis = "2" From = "1" To = "2" Angle = "  -Pi/3" />
        <RemoveGrayParts/>

        <Turn Axis = "2" From = "1" To = "2" Angle = "  -Pi/3" />
        <Turn Axis = "1" From = "1" To = "2" Angle = "  -Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "1" From = "1" To = "2" Angle = " 2*Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "1" From = "1" To = "2" Angle = "  -Pi/3" />
        <Turn Axis = "2" From = "1" To = "2" Angle = "   Pi/3" />
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
