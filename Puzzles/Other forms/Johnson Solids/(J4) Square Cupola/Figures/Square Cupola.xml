<?xml version = "1.0" encoding = "UTF-8"?>
<xml>
    <Script>
        if not VarExists('Colors[0]') then begin
            Colors[0] := '51C4FA';
            Colors[1] := '009484';
            Colors[2] := '38ABEA';
            Colors[3] := 'FE800A';
            Colors[4] := '907409';
            Colors[5] := '478000';
            Colors[6] := 'A0A0A0';
            Colors[7] := 'E75911';
            Colors[8] := '009500';
            Colors[9] := '404040';
        end;

        if not VarExists('W') then
            W := 0.6;
        if not VarExists('DH') then
            DH := 0;
        A := W * (sqrt(2) - 1);
    </Script>

        <Part>
            <Vertices>
                <Add Vector = " A; A; W + DH" />
                <Add Vector = " A;-A; W + DH" />
                <Add Vector = "-A; A; W + DH" />
                <Add Vector = "-A;-A; W + DH" />
                <Add Vector = " W; A; A + DH" />
                <Add Vector = " W;-A; A + DH" />
                <Add Vector = "-W; A; A + DH" />
                <Add Vector = "-W;-A; A + DH" />
                <Add Vector = " A; W; A + DH" />
                <Add Vector = " A;-W; A + DH" />
                <Add Vector = "-A; W; A + DH" />
                <Add Vector = "-A;-W; A + DH" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 0; 2; 3; 1" />
                <Face Color = "Colors[1]" VertexIndexes = " 0; 1; 5; 4" />
                <Face Color = "Colors[2]" VertexIndexes = " 0; 8;10; 2" />
                <Face Color = "Colors[3]" VertexIndexes = " 6; 7; 3; 2" />
                <Face Color = "Colors[4]" VertexIndexes = "11; 9; 1; 3" />
                <Face Color = "Colors[5]" VertexIndexes = " 0; 4; 8" />
                <Face Color = "Colors[6]" VertexIndexes = " 1; 9; 5" />
                <Face Color = "Colors[7]" VertexIndexes = " 2;10; 6" />
                <Face Color = "Colors[8]" VertexIndexes = " 3; 7;11" />
                <Face Color = "Colors[9]" VertexIndexes = " 4; 5; 9;11; 7; 6;10; 8" />
            </Faces>
        </Part>
</xml>
