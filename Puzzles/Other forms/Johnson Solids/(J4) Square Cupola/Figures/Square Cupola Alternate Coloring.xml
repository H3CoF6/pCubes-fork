<?xml version = "1.0" encoding = "UTF-8"?>
<xml>
    <Script>
        if not VarExists('Colors[0]') then begin
            Colors[0] := '00B0F0'; // Blue
            Colors[1] := '00AA00'; // Green
            Colors[2] := 'FF0000'; // Red
            Colors[3] := 'FFFF00'; // Yellow
            Colors[4] := '404040'; // Gray
        end;

        if not VarExists('W') then
            W := 0.6;
        if not VarExists('DH') then
            DH := 0;
        A := W * (sqrt(2) - 1);
    </Script>

        <Part>
            <Vertices>
                <Add Vector = " A; A; W + DH" />
                <Add Vector = " A;-A; W + DH" />
                <Add Vector = "-A; A; W + DH" />
                <Add Vector = "-A;-A; W + DH" />
                <Add Vector = " W; A; A + DH" />
                <Add Vector = " W;-A; A + DH" />
                <Add Vector = "-W; A; A + DH" />
                <Add Vector = "-W;-A; A + DH" />
                <Add Vector = " A; W; A + DH" />
                <Add Vector = " A;-W; A + DH" />
                <Add Vector = "-A; W; A + DH" />
                <Add Vector = "-A;-W; A + DH" />
                <Add Vector = " 0; A; W + DH" />
                <Add Vector = " 0;-A; W + DH" />
                <Add Vector = " 0; W; A + DH" />
                <Add Vector = " 0;-W; A + DH" />
                <Add Vector = " A; 0; W + DH" />
                <Add Vector = "-A; 0; W + DH" />
                <Add Vector = " W; 0; A + DH" />
                <Add Vector = "-W; 0; A + DH" />
                <Add Vector = " 0; 0; W + DH" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 2;17;20;12" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "12;14;10; 2" InvisibleEdges = "1" />
                <Face Color = "Colors[0]" VertexIndexes = " 2;10; 6" />
                <Face Color = "Colors[0]" VertexIndexes = "19;17; 2; 6" InvisibleEdges = "1" />

                <Face Color = "Colors[1]" VertexIndexes = " 3;13;20;17" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "17;19; 7; 3" InvisibleEdges = "1" />
                <Face Color = "Colors[1]" VertexIndexes = " 3; 7;11" />
                <Face Color = "Colors[1]" VertexIndexes = "15;13; 3;11" InvisibleEdges = "1" />

                <Face Color = "Colors[2]" VertexIndexes = " 1;16;20;13" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "13;15; 9; 1" InvisibleEdges = "1" />
                <Face Color = "Colors[2]" VertexIndexes = " 1; 9; 5" />
                <Face Color = "Colors[2]" VertexIndexes = "18;16; 1; 5" InvisibleEdges = "1" />

                <Face Color = "Colors[3]" VertexIndexes = " 0;12;20;16" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "16;18; 4; 0" InvisibleEdges = "1" />
                <Face Color = "Colors[3]" VertexIndexes = " 0; 4; 8" />
                <Face Color = "Colors[3]" VertexIndexes = "14;12; 0; 8" InvisibleEdges = "1" />

                <Face Color = "Colors[4]" VertexIndexes = " 8; 4; 5; 9;11; 7; 6;10" InvisibleEdges = "" />
            </Faces>
        </Part>
</xml>
