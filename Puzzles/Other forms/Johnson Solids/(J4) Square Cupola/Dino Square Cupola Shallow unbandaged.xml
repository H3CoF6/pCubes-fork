<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Square Cupola Shallow unbandaged</Name>
        <Menu>Other forms\Johnson Solids\(J4) Square Cupola\Dino Square Cupola Shallow unbandaged</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.6;
        A := W * (sqrt(2) - 1);
        D := W * 0.906;

        A1 := ArcCos((sqrt(2) - 2) / 4);
        A2 := ArcCos(-(2 * sqrt(2) + 1) / 4);

        DH := - W * 0.7;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " A; A; W" BaseVector = "0; 0; DH" />
        <Axis NormVector = " A;-A; W" BaseVector = "0; 0; DH" />
        <Axis NormVector = "-A; A; W" BaseVector = "0; 0; DH" />
        <Axis NormVector = "-A;-A; W" BaseVector = "0; 0; DH" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Square Cupola.xml" />

        <SplitByAxes/>

        <Macro Name = "Split">
            <Turn Axis = "Ax" Angle = " A1" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "Ax" Angle = "-2*A1" Layer = "1" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
        </Macro>
        <ExecMacro MacroName = "Split" Ax = " 0" />
        <ExecMacro MacroName = "Split" Ax = " 1" />
        <ExecMacro MacroName = "Split" Ax = " 2" />
        <ExecMacro MacroName = "Split" Ax = " 3" />

        <Macro Name = "Split1" >
            <Turn  Axis = "Ax1" Layer = "1" Angle = " A * A1" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = "-A * A2" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = "-A * A1" />
            <Turn  Axis = "Ax1" Layer = "1" Angle = " A * A2" />
            <Split Axis = "Ax2" From  = "1" />
            <Undo Repeat = "4" />
        </Macro>

        <ExecMacro MacroName = "Split1" Ax1 = "0" Ax2 = "2" A = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = "1" Ax2 = "0" A = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = "2" Ax2 = "3" A = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = "3" Ax2 = "1" A = " 1" />
        <ExecMacro MacroName = "Split1" Ax1 = "0" Ax2 = "1" A = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = "1" Ax2 = "3" A = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = "2" Ax2 = "0" A = "-1" />
        <ExecMacro MacroName = "Split1" Ax1 = "3" Ax2 = "2" A = "-1" />
    </Figure>
</xml>
