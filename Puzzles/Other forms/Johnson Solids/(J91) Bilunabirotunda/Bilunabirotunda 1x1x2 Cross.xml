<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bilunabirotunda 1x1x2 Cross</Name>
        <Menu>Other forms\Johnson Solids\(J91) Bilunabirotunda\Bilunabirotunda 1x1x2 Cross</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2021-04-30</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';
        clRed    := 'FF0000';
        clBlue   := '0000FF';
        clGreen  := '008000';
        clOrange := 'FF800A';

        clGray   := '808080';
        clLime   := '00FF00';
        clPurple := '800080';
        clPink   := 'FF69B4';
        clGolden := 'DDBB20';
        clNavy   := '000080';
        clCyan   := '00FFFF';
        clBlack  := '404040';

        R := 0.5;

        C0 := R * (1 + sqrt(5)) / 4;
        C1 := R * (3 + sqrt(5)) / 4;
        C2 := R / 2;

        RCut := R * 0.97;
    </Script>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-C2; C2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2; C0; C2" />
                <Add Vector = " C2; C0;-C2" />
                <Add Vector = " C2;-C0; C2" />
                <Add Vector = " C2;-C0;-C2" />
                <Add Vector = "-C2; C0; C2" />
                <Add Vector = "-C2; C0;-C2" />
                <Add Vector = "-C2;-C0; C2" />
                <Add Vector = "-C2;-C0;-C2" />
                <Add Vector = " C1; C2;  0" />
                <Add Vector = " C1;-C2;  0" />
                <Add Vector = "-C1; C2;  0" />
                <Add Vector = "-C1;-C2;  0" />
                <Add Vector = "  0;  0; C0" />
                <Add Vector = "  0;  0;-C0" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange" VertexIndexes = "12;2;9;8;0" />
                <Face Color = "clWhite"  VertexIndexes = "12;4;10;11;6" />
                <Face Color = "clYellow" VertexIndexes = "13;1;8;9;3" />
                <Face Color = "clRed"    VertexIndexes = "13;7;11;10;5" />

                <Face Color = "clGreen"  VertexIndexes = "0;1;5;4" />
                <Face Color = "clBlue"   VertexIndexes = "3;2;6;7" />

                <Face Color = "clGray"   VertexIndexes = "8;1;0" />
                <Face Color = "clPink"   VertexIndexes = "9;2;3" />
                <Face Color = "clPurple" VertexIndexes = "10;4;5" />
                <Face Color = "clLime"   VertexIndexes = "11;7;6" />
                <Face Color = "clGolden" VertexIndexes = "12;6;2" />
                <Face Color = "clNavy"   VertexIndexes = "12;0;4" />
                <Face Color = "clBlack"  VertexIndexes = "13;3;7" />
                <Face Color = "clCyan"   VertexIndexes = "13;5;1" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Hide Axis = "1" From = "0" To = "1" />
        <Cut><Plane NormVector = " 1; 1;-0.7" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 1;-1;-0.7" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = "-1; 1;-0.7" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = "-1;-1;-0.7" NormDistance = "-RCut" /></Cut>
        <ShowAll/>
        <Hide Axis = "1" From = "1" To = "2" />
        <Cut><Plane NormVector = " 1; 1; 0.7" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = " 1;-1; 0.7" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = "-1; 1; 0.7" NormDistance = "-RCut" /></Cut>
        <Cut><Plane NormVector = "-1;-1; 0.7" NormDistance = "-RCut" /></Cut>
        <ShowAll/>
    </Figure>
</xml>
