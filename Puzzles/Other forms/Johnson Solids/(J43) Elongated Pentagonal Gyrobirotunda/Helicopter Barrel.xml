<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter Barrel J43</Name>
        <Menu>Other forms\Johnson Solids\(J43) Elongated Pentagonal Gyrobirotunda\Helicopter Barrel</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-04-24</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?p=428382</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clLightGreen   := '00FF00';
        clLightViolett := 'FF0080';
        clBlue         := '0000A0';
        clRed          := 'FF0000';
        clBrown        := '800000';
        clGreen        := '008000';
        clViolett      := '800080';
        clLightBlue    := '3868BF';
        clOrange       := 'FF6000';
        clCyan         := '00DCB4';
        clWhite        := 'FFFFFF';

        Color := 'FFFFFF';

        R := 0.35;
        s5 := sqrt(5);
        C0  := R * sqrt(10 * (5 - s5)) / 20;
        C1  := R * sqrt(10 * (5 + s5)) / 20;
        C2  := R * sqrt(5 * (5 + 2 * s5)) / 10;
        C3  := R * (1 + s5) / 4;
        C4  := R * sqrt(10 * (5 + s5)) / 10;
        C5  := R * sqrt(2 * (5 + s5)) / 4;
        C6  := R * sqrt(10 * (25 + 11 * s5)) / 20;
        C7  := R * (3 + s5) / 4;
        C8  := R * (5 + sqrt(10 * (5 + s5))) / 10;
        C9  := R * sqrt(5 * (5 + 2 * s5)) / 5;
        C10 := R * sqrt(5 + 2 * s5) / 2;
        C11 := R * (1 + s5) / 2;
        C12 := R * (5 + 2*sqrt(5*(5 + 2*s5))) / 10;
        C13 := R / 2;

        D1 := R * 3 * (s5 + 3) / 12;
        D2 := C7;

        jAngle := Arctan(2);
    </Script>

    <Axes TurningAngles = "0; Pi" JumbleAngle = "jAngle" PlaneDistances = "D1" >
        <Axis NormVector = "  C3; C0; C12 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = " -C3; C0; C12 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = " C13;-C2; C12 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = "-C13;-C2; C12 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = "   0; C4; C12 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = "  C7;-C1;  C8 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = " -C7;-C1;  C8 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = "  C3; C6;  C8 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = " -C3; C6;  C8 - C13" BaseVector = " 0; 0; C13" />
        <Axis NormVector = "   0;-C9;  C8 - C13" BaseVector = " 0; 0; C13" />
                                                                
        <Axis NormVector = "  C3;-C0;-C12 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = " -C3;-C0;-C12 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = " C13; C2;-C12 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = "-C13; C2;-C12 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = "   0;-C4;-C12 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = "  C7; C1; -C8 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = " -C7; C1; -C8 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = "  C3;-C6; -C8 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = " -C3;-C6; -C8 + C13" BaseVector = " 0; 0;-C13" />
        <Axis NormVector = "   0; C9; -C8 + C13" BaseVector = " 0; 0;-C13" />
    </Axes>

    <Axes TurningAngles = "Pi; 0; Pi" PlaneDistances = "-D2; D2" >
        <Axis NormVector = " C11;   0; 0" />
        <Axis NormVector = "  C7;  C5; 0" />
        <Axis NormVector = "  C7; -C5; 0" />
        <Axis NormVector = " C13; C10; 0" />
        <Axis NormVector = " C13;-C10; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C11;   0; C13" />
                <Add Vector = " C11;   0;-C13" />
                <Add Vector = "-C11;   0; C13" />
                <Add Vector = "-C11;   0;-C13" />
                <Add Vector = "  C7;  C5; C13" />
                <Add Vector = "  C7;  C5;-C13" />
                <Add Vector = "  C7; -C5; C13" />
                <Add Vector = "  C7; -C5;-C13" />
                <Add Vector = " -C7;  C5; C13" />
                <Add Vector = " -C7;  C5;-C13" />
                <Add Vector = " -C7; -C5; C13" />
                <Add Vector = " -C7; -C5;-C13" />
                <Add Vector = " C13; C10; C13" />
                <Add Vector = " C13; C10;-C13" />
                <Add Vector = " C13;-C10; C13" />
                <Add Vector = " C13;-C10;-C13" />
                <Add Vector = "-C13; C10; C13" />
                <Add Vector = "-C13; C10;-C13" />
                <Add Vector = "-C13;-C10; C13" />
                <Add Vector = "-C13;-C10;-C13" />
                <Add Vector = "  C3;  C0; C12" />
                <Add Vector = "  C3; -C0;-C12" />
                <Add Vector = " -C3;  C0; C12" />
                <Add Vector = " -C3; -C0;-C12" />
                <Add Vector = " C13; -C2; C12" />
                <Add Vector = " C13;  C2;-C12" />
                <Add Vector = "-C13; -C2; C12" />
                <Add Vector = "-C13;  C2;-C12" />
                <Add Vector = "   0;  C4; C12" />
                <Add Vector = "   0; -C4;-C12" />
                <Add Vector = "  C7; -C1;  C8" />
                <Add Vector = "  C7;  C1; -C8" />
                <Add Vector = " -C7; -C1;  C8" />
                <Add Vector = " -C7;  C1; -C8" />
                <Add Vector = "  C3;  C6;  C8" />
                <Add Vector = "  C3; -C6; -C8" />
                <Add Vector = " -C3;  C6;  C8" />
                <Add Vector = " -C3; -C6; -C8" />
                <Add Vector = "   0; -C9;  C8" />
                <Add Vector = "   0;  C9; -C8" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite       " VertexIndexes = "21;29;23;27;25" />
                <Face Color = "clYellow      " VertexIndexes = "20;28;22;26;24" />
                <Face Color = "clCyan        " VertexIndexes = "35;21;31; 1; 7" />
                <Face Color = "clGreen       " VertexIndexes = "37;29;35;15;19" />
                <Face Color = "clViolett     " VertexIndexes = "33;23;37;11; 3" />
                <Face Color = "clLightBlue   " VertexIndexes = "39;27;33; 9;17" />
                <Face Color = "clOrange      " VertexIndexes = "31;25;39;13; 5" />
                <Face Color = "clLightViolett" VertexIndexes = "34;20;30; 0; 4" />
                <Face Color = "clLightGreen  " VertexIndexes = "36;28;34;12;16" />
                <Face Color = "clBrown       " VertexIndexes = "32;22;36; 8; 2" />
                <Face Color = "clRed         " VertexIndexes = "38;26;32;10;18" />
                <Face Color = "clBlue        " VertexIndexes = "30;24;38;14; 6" />
                <Face Color = "clCyan        " VertexIndexes = " 7; 1; 0; 6" />
                <Face Color = "clGreen       " VertexIndexes = "19;15;14;18" />
                <Face Color = "clViolett     " VertexIndexes = " 3;11;10; 2" />
                <Face Color = "clLightBlue   " VertexIndexes = "17; 9; 8;16" />
                <Face Color = "clOrange      " VertexIndexes = " 5;13;12; 4" />
                <Face Color = "clLightViolett" VertexIndexes = " 4; 0; 1; 5" />
                <Face Color = "clLightGreen  " VertexIndexes = "16;12;13;17" />
                <Face Color = "clBrown       " VertexIndexes = " 2; 8; 9; 3" />
                <Face Color = "clRed         " VertexIndexes = "18;10;11;19" />
                <Face Color = "clBlue        " VertexIndexes = " 6;14;15; 7" />
                <Face Color = "clBlue        " VertexIndexes = "35; 7;15" />
                <Face Color = "clRed         " VertexIndexes = "37;19;11" />
                <Face Color = "clBrown       " VertexIndexes = "33; 3; 9" />
                <Face Color = "clLightGreen  " VertexIndexes = "39;17;13" />
                <Face Color = "clLightViolett" VertexIndexes = "31; 5; 1" />
                <Face Color = "clWhite       " VertexIndexes = "35;29;21" />
                <Face Color = "clWhite       " VertexIndexes = "37;23;29" />
                <Face Color = "clWhite       " VertexIndexes = "33;27;23" />
                <Face Color = "clWhite       " VertexIndexes = "39;25;27" />
                <Face Color = "clWhite       " VertexIndexes = "31;21;25" />
                <Face Color = "clOrange      " VertexIndexes = "34; 4;12" />
                <Face Color = "clLightBlue   " VertexIndexes = "36;16; 8" />
                <Face Color = "clViolett     " VertexIndexes = "32; 2;10" />
                <Face Color = "clGreen       " VertexIndexes = "38;18;14" />
                <Face Color = "clCyan        " VertexIndexes = "30; 6; 0" />
                <Face Color = "clYellow      " VertexIndexes = "34;28;20" />
                <Face Color = "clYellow      " VertexIndexes = "36;22;28" />
                <Face Color = "clYellow      " VertexIndexes = "32;26;22" />
                <Face Color = "clYellow      " VertexIndexes = "38;24;26" />
                <Face Color = "clYellow      " VertexIndexes = "30;20;24" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Macros>
        <Macro Name = "RandomSwap" >
            <Turn Axis = "Random(20)" Layer = "1" Angle = "Pi" />
            <Turn Axis = "Random(5)+20" Layer = "Random(2)*2" Angle = "Pi" />
        </Macro>
        <Macro Name = "RandomJumble" >
            <Turn Axis = "Random(20)" Layer = "1" Angle = "Arctan(2)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "many random turns" >
            <ExecMacro MacroName = "RandomSwap" Repeat = "200" /> <!-- Full Non-Jumbling Scramble -->
            <ExecMacro MacroName = "RandomJumble" Repeat = "200" /> <!-- Jumbling -->
        </Macro>
    </Macros>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
