<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Enneaminx Jumble</Name>
        <Menu>Other forms\Johnson Solids\Near-miss\Enneaminx Jumble</Menu>
        <Inventor>Chandler Griscom</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3495</Link>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clBlack       := '202020';
        clCyan        := '00FFFF';
        clBlue        := '0000FF';
        clNavy        := '000080';
        clRed         := 'FF0000';
        clBrown       := '800000';
        clYellow      := 'FFFF00';
        clOrange      := 'FF6000';
        clOlive       := '808000';
        clLime        := '00FF00';
        clGreen       := '008000';
        clPink        := 'FF69B4';
        clPurple      := '800080';

        pA2 := 0.55;
        pB2 := pA2 * (cos(Pi/9) + cos(2*Pi/9)) / (1 + cos(Pi/9));
        pB1 := pA2 * (cos(Pi/9) + cos(4*Pi/9)) / (1 + cos(Pi/9));
        pA1 := pA2 * (cos(Pi/9) + cos(6*Pi/9)) / (1 + cos(Pi/9));
        D := pA2 / sqrt(3);

        // Calcs angle from 2 to 3 while rotating over 1
        function Angle(x1, y1, z1, x2, y2, z2, x3, y3, z3);
        begin
          vx := y1 * z2 - y2 * z1;
          vy := z1 * x2 - z2 * x1;
          vz := x1 * y2 - x2 * y1;
          wx := y1 * z3 - y3 * z1;
          wy := z1 * x3 - z3 * x1;
          wz := x1 * y3 - x3 * y1;
          Result := ArcCos((vx*wx + vy*wy + vz*wz) / (vx^2 + vy^2 + vz^2));
        end;

        A := Angle(1, 1, 1,  pA2, pA1, -pA1,  pA2, -pA1, pA1); // 0.748263344884625

    </Script>

    <Axes TurningAngles = "2*Pi/3" JumbleAngle = "A" PlaneDistances = "-D;D" FixedLayers = "1">
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " pA1;  pA1;  pA2" />
                <Add Vector = " pA1; -pA1;  pA2" />
                <Add Vector = "-pA1; -pA1;  pA2" />
                <Add Vector = "-pA1;  pA1;  pA2" />

                <Add Vector = " pB1;    0;  pB2" />
                <Add Vector = "   0; -pB1;  pB2" />
                <Add Vector = "-pB1;    0;  pB2" />
                <Add Vector = "   0;  pB1;  pB2" />

                <Add Vector = " pA2;  pA1;  pA1" />
                <Add Vector = " pA2;  pA1; -pA1" />
                <Add Vector = " pA2; -pA1; -pA1" />
                <Add Vector = " pA2; -pA1;  pA1" />

                <Add Vector = " pB2;  pB1;    0" />
                <Add Vector = " pB2;    0; -pB1" />
                <Add Vector = " pB2; -pB1;    0" />
                <Add Vector = " pB2;    0;  pB1" />

                <Add Vector = " pA1; -pA2;  pA1" />
                <Add Vector = " pA1; -pA2; -pA1" />
                <Add Vector = "-pA1; -pA2; -pA1" />
                <Add Vector = "-pA1; -pA2;  pA1" />

                <Add Vector = " pB1; -pB2;    0" />
                <Add Vector = "   0; -pB2; -pB1" />
                <Add Vector = "-pB1; -pB2;    0" />
                <Add Vector = "   0; -pB2;  pB1" />

                <Add Vector = "-pA2;  pA1;  pA1" />
                <Add Vector = "-pA2;  pA1; -pA1" />
                <Add Vector = "-pA2; -pA1; -pA1" />
                <Add Vector = "-pA2; -pA1;  pA1" />

                <Add Vector = "-pB2;  pB1;    0" />
                <Add Vector = "-pB2;    0; -pB1" />
                <Add Vector = "-pB2; -pB1;    0" />
                <Add Vector = "-pB2;    0;  pB1" />

                <Add Vector = " pA1;  pA2;  pA1" />
                <Add Vector = " pA1;  pA2; -pA1" />
                <Add Vector = "-pA1;  pA2; -pA1" />
                <Add Vector = "-pA1;  pA2;  pA1" />

                <Add Vector = " pB1;  pB2;    0" />
                <Add Vector = "   0;  pB2; -pB1" />
                <Add Vector = "-pB1;  pB2;    0" />
                <Add Vector = "   0;  pB2;  pB1" />

                <Add Vector = " pA1;  pA1; -pA2" />
                <Add Vector = " pA1; -pA1; -pA2" />
                <Add Vector = "-pA1; -pA1; -pA2" />
                <Add Vector = "-pA1;  pA1; -pA2" />

                <Add Vector = " pB1;    0; -pB2" />
                <Add Vector = "   0; -pB1; -pB2" />
                <Add Vector = "-pB1;    0; -pB2" />
                <Add Vector = "   0;  pB1; -pB2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "  3; 2; 1; 0" />
                <Face                    VertexIndexes = "  0; 1; 4" />
                <Face                    VertexIndexes = "  1; 2; 5" />
                <Face                    VertexIndexes = "  2; 3; 6" />
                <Face                    VertexIndexes = "  3; 0; 7" />

                <Face Color = "clBrown " VertexIndexes = " 11;10; 9; 8" />
                <Face                    VertexIndexes = "  8; 9;12" />
                <Face                    VertexIndexes = "  9;10;13" />
                <Face                    VertexIndexes = " 10;11;14" />
                <Face                    VertexIndexes = " 11; 8;15" />

                <Face Color = "clOlive " VertexIndexes = " 19;18;17;16" />
                <Face                    VertexIndexes = " 16;17;20" />
                <Face                    VertexIndexes = " 17;18;21" />
                <Face                    VertexIndexes = " 18;19;22" />
                <Face                    VertexIndexes = " 19;16;23" />

                <Face Color = "clPurple" VertexIndexes = " 27;24;25;26" />
                <Face                    VertexIndexes = " 25;24;28" />
                <Face                    VertexIndexes = " 26;25;29" />
                <Face                    VertexIndexes = " 27;26;30" />
                <Face                    VertexIndexes = " 24;27;31" />

                <Face Color = "clNavy  " VertexIndexes = " 35;32;33;34" />
                <Face                    VertexIndexes = " 33;32;36" />
                <Face                    VertexIndexes = " 34;33;37" />
                <Face                    VertexIndexes = " 35;34;38" />
                <Face                    VertexIndexes = " 32;35;39" />

                <Face Color = "clBlack " VertexIndexes = " 43;40;41;42" />
                <Face                    VertexIndexes = " 41;40;44" />
                <Face                    VertexIndexes = " 42;41;45" />
                <Face                    VertexIndexes = " 43;42;46" />
                <Face                    VertexIndexes = " 40;43;47" />

                <Face Color = "clGreen " VertexIndexes = " 0; 4;15; 8;12;36;32;39; 7" />
                <Face Color = "clBlue  " VertexIndexes = " 1; 5;23;16;20;14;11;15; 4" />
                <Face Color = "clRed   " VertexIndexes = " 2; 6;31;27;30;22;19;23; 5" />
                <Face Color = "clYellow" VertexIndexes = " 3; 7;39;35;38;28;24;31; 6" />

                <Face Color = "clOrange" VertexIndexes = "13;10;14;20;17;21;45;41;44" />
                <Face Color = "clLime  " VertexIndexes = "21;18;22;30;26;29;46;42;45" />
                <Face Color = "clCyan  " VertexIndexes = "29;25;28;38;34;37;47;43;46" />
                <Face Color = "clPink  " VertexIndexes = "37;33;36;12; 9;13;44;40;47" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "0" Angle = "A" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-2*A" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "A" Layer = "0" />

        <Turn Axis = "1" Angle = "A" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-2*A" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "A" Layer = "0" />

        <Turn Axis = "2" Angle = "A" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-2*A" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "A" Layer = "2" />

        <Turn Axis = "3" Angle = "A" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "3" Angle = "-2*A" Layer = "2" />
        <SplitByAxes/>
        <Turn Axis = "3" Angle = "A" Layer = "2" />
    </Figure>
</xml>
