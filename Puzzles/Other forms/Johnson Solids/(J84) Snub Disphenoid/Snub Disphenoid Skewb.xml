<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Snub Disphenoid Skewb</Name>
        <Menu>Other forms\Johnson Solids\(J84) Snub Disphenoid\Snub Disphenoid Skewb</Menu>
        <Menu>Other forms\Skewb variants\Snub Disphenoid Skewb</Menu>
        <Inventor>not invented</Inventor>
        <Added>2020-06-29</Added>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11271</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';
        clRed    := 'FF0000';
        clBlue   := '0000FF';
        clGreen  := '008000';
        clGray   := '808080';
        clLime   := '00FF00';
        clPurple := '800080';
        clPink   := 'FF69B4';
        clGolden := 'DDBB20';
        clNavy   := '000080';
        clCyan   := '00FFFF';

        k := 0.5;

        q := 0.169022229424176; // 2*q^3+11*q^2+4*q-1=0, q=sqrt(97)/3 * sin( Pi/6 + arccos(881/(97*sqrt(97)))/3 ) - 11/6;
        r := k * sqrt(q);
        s := k * sqrt((1 - q) / q / 2);
        t := k * sqrt((1 - q) * 2);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " t; r; 0" />
                <Add Vector = "-t; r; 0" />
                <Add Vector = " 0;-r; t" />
                <Add Vector = " 0;-r;-t" />
                <Add Vector = " k;-s; 0" />
                <Add Vector = "-k;-s; 0" />
                <Add Vector = " 0; s; k" />
                <Add Vector = " 0; s;-k" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"  VertexIndexes = "1;5;2" />
                <Face Color = "clYellow" VertexIndexes = "1;3;5" />
                <Face Color = "clRed"    VertexIndexes = "1;7;3" />
                <Face Color = "clBlue"   VertexIndexes = "1;6;7" />
                <Face Color = "clGreen"  VertexIndexes = "1;2;6" />
                <Face Color = "clGray"   VertexIndexes = "4;2;5" />
                <Face Color = "clLime"   VertexIndexes = "3;4;5" />
                <Face Color = "clPurple" VertexIndexes = "3;0;4" />
                <Face Color = "clPink"   VertexIndexes = "0;2;4" />
                <Face Color = "clGolden" VertexIndexes = "6;0;7" />
                <Face Color = "clNavy"   VertexIndexes = "6;2;0" />
                <Face Color = "clCyan"   VertexIndexes = "7;0;3" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
