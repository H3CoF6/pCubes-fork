<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Elongated Square Cupola Shallow</Name>
        <Menu>Other forms\Johnson Solids\(J19) Elongated Square Cupola\Dino Elongated Square Cupola Shallow</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.6;
        A := W * (sqrt(2) - 1);
        D := W * 0.906;

        A1 := ArcCos((sqrt(2) + 2) / 8);
        A2 := ArcCos((sqrt(2) - 2) / 4);
        A3 := A1 + A2;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " A; A; W" />
        <Axis NormVector = " A;-A; W" />
        <Axis NormVector = "-A; A; W" />
        <Axis NormVector = "-A;-A; W" />
        <Axis NormVector = " A; W; A" />
        <Axis NormVector = "-A; W; A" />
        <Axis NormVector = " A;-W; A" />
        <Axis NormVector = "-A;-W; A" />
        <Axis NormVector = " W; A; A" />
        <Axis NormVector = " W;-A; A" />
        <Axis NormVector = "-W; A; A" />
        <Axis NormVector = "-W;-A; A" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Elongated Square Cupola.xml" />

        <SplitByAxes/>

        <Macro Name = "Split1">
            <Turn Axis = "ax1" Angle = "Ang" Layer = "1" />
            <Split Axis = "ax2" From  = "1" />
            <Undo/>
        </Macro>

        <ExecMacro MacroName = "Split1" Ax1 = " 4" Ax2 = " 5" Ang = " A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = " 5" Ax2 = " 4" Ang = "-A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = " 6" Ax2 = " 7" Ang = "-A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = " 7" Ax2 = " 6" Ang = " A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = " 8" Ax2 = " 9" Ang = "-A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = " 9" Ax2 = " 8" Ang = " A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = "10" Ax2 = "11" Ang = " A2"/>
        <ExecMacro MacroName = "Split1" Ax1 = "11" Ax2 = "10" Ang = "-A2"/>
    </Figure>
</xml>
