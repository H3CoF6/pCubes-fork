<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cheops Cube</Name>
        <Menu>Other forms\3x3x3 variants\Johnson\Cheops Cube</Menu>
        <Menu>Other forms\Johnson Solids\(J1) Square Pyramid\Cheops Cube</Menu>
        <Menu>Other forms\Pyramid\Squared Pyramid\Cheops Cube</Menu>
        <Aliases>Sharp Edges (AA000)</Aliases>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3772</Link>
    </Interface>

    <Script>
        clRed     := 'C80000';
        clYellow  := 'FFFF00';
        clGreen   := '009600';
        clBlue    := '0000C8';
        clViolett := '800080';

        W := 0.5;
        D := W / 5;
        B := 3 * D;
        H := D * 9 / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -B" />
                <Add Vector = "-W;  W; -B" />
                <Add Vector = " W;  W; -B" />
                <Add Vector = " W; -W; -B" />
                <Add Vector = " 0;  0;  H" />

                <Add Vector = "-3*D; -3*D; 0" />
                <Add Vector = "-3*D;  3*D; 0" />
                <Add Vector = " 3*D;  3*D; 0" />
                <Add Vector = " 3*D; -3*D; 0" />

                <Add Vector = "-W; -3*D; -B" />
                <Add Vector = "-W;  3*D; -B" />
                <Add Vector = "-3*D;  W; -B" />
                <Add Vector = " 3*D;  W; -B" />
                <Add Vector = " W;  3*D; -B" />
                <Add Vector = " W; -3*D; -B" />
                <Add Vector = " 3*D; -W; -B" />
                <Add Vector = "-3*D; -W; -B" />

                <Add Vector = "-3*D; -3*D; -B" />
                <Add Vector = "-3*D;  3*D; -B" />
                <Add Vector = " 3*D;  3*D; -B" />
                <Add Vector = " 3*D; -3*D; -B" />
            </Vertices>

            <Faces>
                <Face Color = "clRed    " VertexIndexes = " 1;10; 6" />
                <Face Color = "clRed    " VertexIndexes = "10; 9; 5; 4; 6" />
                <Face Color = "clRed    " VertexIndexes = " 9; 0; 5" />
                <Face Color = "clYellow " VertexIndexes = " 2;12; 7" />
                <Face Color = "clYellow " VertexIndexes = "12;11; 6; 4; 7" />
                <Face Color = "clYellow " VertexIndexes = "11; 1; 6" />
                <Face Color = "clGreen  " VertexIndexes = " 3;14; 8" />
                <Face Color = "clGreen  " VertexIndexes = "14;13; 7; 4; 8" />
                <Face Color = "clGreen  " VertexIndexes = "13; 2; 7" />
                <Face Color = "clBlue   " VertexIndexes = " 0;16; 5" />
                <Face Color = "clBlue   " VertexIndexes = "16;15; 8; 4; 5" />
                <Face Color = "clBlue   " VertexIndexes = "15; 3; 8" />
                <Face Color = "clViolett" VertexIndexes = " 0; 9;17;16" />
                <Face Color = "clViolett" VertexIndexes = " 9;10;18;17" />
                <Face Color = "clViolett" VertexIndexes = " 1;11;18;10" />
                <Face Color = "clViolett" VertexIndexes = "11;12;19;18" />
                <Face Color = "clViolett" VertexIndexes = " 2;13;19;12" />
                <Face Color = "clViolett" VertexIndexes = "13;14;20;19" />
                <Face Color = "clViolett" VertexIndexes = " 3;15;20;14" />
                <Face Color = "clViolett" VertexIndexes = "15;16;17;20" />
                <Face Color = "clViolett" VertexIndexes = "17;18;19;20" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <ShowAll/>
    </Figure>
</xml>
