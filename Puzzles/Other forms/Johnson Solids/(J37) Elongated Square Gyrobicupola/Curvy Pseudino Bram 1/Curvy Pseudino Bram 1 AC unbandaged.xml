            <Turn  Axis = "Ax2" Layer = "L" Angle = "B * A1" />
            <Split Axis = "Ax1" From  = "1" />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Split1" Ax1 = " 0" Ax2 = "15" Ax3 = " 8" />
