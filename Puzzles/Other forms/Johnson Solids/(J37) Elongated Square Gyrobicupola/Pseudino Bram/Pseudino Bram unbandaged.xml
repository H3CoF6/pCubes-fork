<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pseudino Bram unbandaged</Name>
        <Menu>Other forms\Johnson Solids\(J37) Elongated Square Gyrobicupola\Pseudino Bram\Pseudino Bram unbandaged</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-22</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.6;
        D := W * sqrt((7 + 4 * sqrt(2)) / 17);

        C0 := W * (2 - sqrt(2));
        C1 := W;
        C2 := W * (sqrt(2) - 1);

        A1 := ArcCos((sqrt(2) + 2) / 8);
        A2 := ArcCos((sqrt(2) - 2) / 4);
        A3 := A1 + A2;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " C1; C2; C2" />
        <Axis NormVector = " C1; C2;-C2" />
        <Axis NormVector = " C1;-C2; C2" />
        <Axis NormVector = " C1;-C2;-C2" />
        <Axis NormVector = " C2; C1; C2" />
        <Axis NormVector = " C2; C1;-C2" />
        <Axis NormVector = " C2;-C1; C2" />
        <Axis NormVector = " C2;-C1;-C2" />
    </Axes>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " C0;  0; C1" />
        <Axis NormVector = "-C0;  0; C1" />
        <Axis NormVector = "  0; C0; C1" />
        <Axis NormVector = "  0;-C0; C1" />
        <Axis NormVector = " C2; C2;-C1" />
        <Axis NormVector = " C2;-C2;-C1" />
        <Axis NormVector = "-C2; C2;-C1" />
        <Axis NormVector = "-C2;-C2;-C1" />
    </Axes>

    <Figure>
        <LoadFrom File = "..\Figures\Elongated Square Gyrobicupola.xml" />

        <SplitByAxes/>

        <Macro Name = "Split1" >
            <Turn  Axis = "Ax1" Layer = "0" Angle = " A1" />
            <Turn  Axis = "Ax1" Layer = "2" Angle = "-A1" />
            <Turn  Axis = "Ax2" Layer = "1" Angle = " A1" />
            <Turn  Axis = "Ax3" Layer = "1" Angle = " A1" />
            <Split Axis = "Ax1" From  = "1" />
            <Split Axis = "Ax1" From  = "2" />
            <Undo Repeat = "4" />
        </Macro>
        <Macro Name = "Split2" >
            <Turn  Axis = "Ax1" Layer = "1" Angle = "A * A1" />
            <Turn  Axis = "Ax2" Layer = "L" Angle = "B * A1" />
            <Split Axis = "Ax1" From  = "1" />
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Split1" Ax1 = " 0" Ax2 = "15" Ax3 = " 8" />
        <ExecMacro MacroName = "Split1" Ax1 = " 6" Ax2 = "14" Ax3 = "11" />
        <ExecMacro MacroName = "Split1" Ax1 = " 1" Ax2 = "12" Ax3 = " 9" />
        <ExecMacro MacroName = "Split1" Ax1 = " 7" Ax2 = "13" Ax3 = "10" />

        <ExecMacro MacroName = "Split2" Ax1 = " 8" Ax2 = "2" L = "2" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = " 8" Ax2 = "0" L = "2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = " 9" Ax2 = "3" L = "0" A = "-1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = " 9" Ax2 = "1" L = "0" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = "10" Ax2 = "4" L = "2" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = "10" Ax2 = "7" L = "0" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = "11" Ax2 = "5" L = "0" A = "-1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = "11" Ax2 = "6" L = "2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = "12" Ax2 = "5" L = "2" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = "12" Ax2 = "1" L = "2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = "13" Ax2 = "3" L = "2" A = "-1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = "13" Ax2 = "7" L = "2" A = " 1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = "14" Ax2 = "2" L = "0" A = "-1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = "14" Ax2 = "6" L = "0" A = " 1" B = " 1" />
        <ExecMacro MacroName = "Split2" Ax1 = "15" Ax2 = "4" L = "0" A = "-1" B = "-1" />
        <ExecMacro MacroName = "Split2" Ax1 = "15" Ax2 = "0" L = "0" A = " 1" B = " 1" />
    </Figure>
</xml>
