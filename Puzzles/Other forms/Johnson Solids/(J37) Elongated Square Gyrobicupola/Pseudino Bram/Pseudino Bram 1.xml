<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pseudino Bram 1</Name>
        <Menu>Other forms\Johnson Solids\(J37) Elongated Square Gyrobicupola\Pseudino Bram\Pseudino Bram 1</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos + Evgeniy Grigoriev</Programmer>
        <Added>2017-07-01</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.6;
        s2 := sqrt(2);

        D := W * 0.906;

        C0 := W * (2 - s2);
        C1 := W;
        C2 := W * (s2 - 1);

        A1 := ArcCos((s2 + 2) / 8);
        A2 := ArcCos((s2 - 2) / 4);
        A3 := A1 + A2;
    </Script>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " C1; C2; C2" />
        <Axis NormVector = " C1; C2;-C2" />
        <Axis NormVector = " C1;-C2; C2" />
        <Axis NormVector = " C1;-C2;-C2" />
        <Axis NormVector = " C2; C1; C2" />
        <Axis NormVector = " C2; C1;-C2" />
        <Axis NormVector = " C2;-C1; C2" />
        <Axis NormVector = " C2;-C1;-C2" />
    </Axes>

    <Axes TurningAngles = "2 * Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " C0;  0; C1" />
        <Axis NormVector = "-C0;  0; C1" />
        <Axis NormVector = "  0; C0; C1" />
        <Axis NormVector = "  0;-C0; C1" />
        <Axis NormVector = " C2; C2;-C1" />
        <Axis NormVector = " C2;-C2;-C1" />
        <Axis NormVector = "-C2; C2;-C1" />
        <Axis NormVector = "-C2;-C2;-C1" />
    </Axes>

    <Figure>
        <LoadFrom File = "..\Figures\Elongated Square Gyrobicupola.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
