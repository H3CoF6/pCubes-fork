    <Script>
        W := 0.4;
        X := W * sqrt(3);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = " 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " X; 0;-W" />
                <Add Vector = " 0; W;-W" />
                <Add Vector = " 0;-W;-W" />
                <Add Vector = "-X; W; 0" />
                <Add Vector = "-X;-W; 0" />
                <Add Vector = " X; 0; W" />
                <Add Vector = " 0; W; W" />
                <Add Vector = " 0;-W; W" />
            </Vertices>

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "2;1;0" />
                <Face Color = "640064" VertexIndexes = "7;5;6" />
                <Face Color = "009600" VertexIndexes = "6;1;3" />
                <Face Color = "0000C8" VertexIndexes = "7;4;2" />
                <Face Color = "C80000" VertexIndexes = "6;5;0;1" />
                <Face Color = "FF800A" VertexIndexes = "7;2;0;5" />
                <Face Color = "5F5F5F" VertexIndexes = "4;3;1;2" />
                <Face Color = "FFFFFF" VertexIndexes = "7;6;3;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
