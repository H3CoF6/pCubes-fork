<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DFT Gyrobifastigium</Name>
        <Menu>Other forms\Johnson Solids\(J26) Gyrobifastigium\DFT Gyrobifastigium</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-04-20</Added>
    </Interface>

    <Script>
        R := 0.4;
        u := sqrt(3) * R;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " R;-u; 0" />
        <Axis NormVector = " R; u; 0" />
        <Axis NormVector = "-R; 0;-u" />
        <Axis NormVector = "-R; 0; u" />
    </Axes>

    <Axes TurningAngles = "Pi / 6" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " u;  0; -R" />
                <Add Vector = " 0;  R; -R" />
                <Add Vector = " 0; -R; -R" />
                <Add Vector = "-u;  R;  0" />
                <Add Vector = "-u; -R;  0" />
                <Add Vector = " u;  0;  R" />
                <Add Vector = " 0;  R;  R" />
                <Add Vector = " 0; -R;  R" />
            </Vertices>

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "2;1;0" />
                <Face Color = "640064" VertexIndexes = "7;5;6" />
                <Face Color = "009600" VertexIndexes = "6;1;3" />
                <Face Color = "0000C8" VertexIndexes = "7;4;2" />
                <Face Color = "C80000" VertexIndexes = "6;5;0;1" />
                <Face Color = "FF800A" VertexIndexes = "7;2;0;5" />
                <Face Color = "5F5F5F" VertexIndexes = "4;3;1;2" />
                <Face Color = "FFFFFF" VertexIndexes = "7;6;3;4" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
