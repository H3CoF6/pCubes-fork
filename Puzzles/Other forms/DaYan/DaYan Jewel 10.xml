<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DaYan Jewel 10</Name>
        <Menu>Other forms\DaYan\DaYan Jewel 10</Menu>
        <Menu>Other forms\Archimedean Solids\Truncated Tetrahedron\DaYan Jewel 10</Menu>
        <Menu>Other forms\Archimedean Solids\DaYan\DaYan Jewel 10</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-12-02</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.67;
        D1 := W / 3;
        D2 := W / 9 * sqrt(3);
        DCut := W * 5 / 9 * sqrt(3);
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>                

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <Cut Color = "clRed   " > <Plane NormDistance = "-DCut" NormVector = "-1;-1; 1" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormDistance = "-DCut" NormVector = "-1; 1;-1" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormDistance = "-DCut" NormVector = " 1;-1;-1" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormDistance = "-DCut" NormVector = " 1; 1; 1" /> </Cut>

        <SplitByAxes/>

        <Hide Axis = "0" Layers = "0;2" />
        <Hide Axis = "1" Layers = "0;2" />
        <Hide Axis = "2" Layers = "0;2" />
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
