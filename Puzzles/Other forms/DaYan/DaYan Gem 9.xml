<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DaYan Gem 9</Name>
        <Menu>Other forms\DaYan\DaYan Gem 9</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11519</Link>
    </Interface>

    <Script>
        clYellow  := 'EDFF11';
        clBlue    := '0000FF';
        clOrange  := 'FF5C00';
        clRed     := 'FF0000';
        clGreen   := '1D9F00';
        clViolett := '7700CD';
        clGray    := '45575E';
        clWhite   := 'FFFFFF';

        clYellow1 := 'EDFF15';
        clBlue1   := '0000FD';
        clOrange1 := 'FF5C05';
        clRed1    := 'FF0005';
        clGreen1  := '1D9F05';
        clWhite1  := 'FFFFF0';

        Scale := 1.2;
        R     := Scale * 3 / 4;
        DCut  := Scale * 5 / 12;
        D     := sqrt(2) * DCut - R / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1;  1;  0" />
        <Axis NormVector = " 1; -1;  0" />
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = " 1;  0; -1" />
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 0;  1; -1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-R; 0; 0" />
                <Add Vector = "R; 0; 0" />
                <Add Vector = "0; -R; 0" />
                <Add Vector = "0; R; 0" />
                <Add Vector = "0; 0; -R" />
                <Add Vector = "0; 0; R" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen"   VertexIndexes = "0;2;5" />
                <Face Color = "clWhite"   VertexIndexes = "5;2;1" />
                <Face Color = "clGray"    VertexIndexes = "5;1;3" />
                <Face Color = "clRed"     VertexIndexes = "5;3;0" />
                <Face Color = "clViolett" VertexIndexes = "4;2;0" />
                <Face Color = "clOrange"  VertexIndexes = "4;1;2" />
                <Face Color = "clBlue"    VertexIndexes = "4;3;1" />
                <Face Color = "clYellow"  VertexIndexes = "4;0;3" />
            </Faces>
        </Part>

        <Cut Color = "clWhite1 " > <Plane NormVector = " 1;  0;  0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clYellow1" > <Plane NormVector = "-1;  0;  0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlue1  " > <Plane NormVector = " 0;  1;  0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clGreen1 " > <Plane NormVector = " 0; -1;  0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clRed1   " > <Plane NormVector = " 0;  0;  1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clOrange1" > <Plane NormVector = " 0;  0; -1" NormDistance = "-DCut" /> </Cut>
        <SplitByAxes/>
    </Figure>
</xml>
