<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DaYan Jewel 7</Name>
        <Menu>Other forms\DaYan\DaYan Jewel 7</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-12-23</Added>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clNavy   := '000080';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clLime   := '00FF00';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        K := 1.16;
        C0 := K * (2 - sqrt(2)) / 8;
        C1 := K * (2 + sqrt(2)) / 8;

        D1 := K / 4;
        D2 := K * (1 + sqrt(2)) / sqrt(3) / 4;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector=" 1; 0; 0" />
        <Axis NormVector=" 0; 1; 0" />
        <Axis NormVector=" 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2" FixedLayers = "1" >
        <Axis NormVector=" 1; 1;-1" />
        <Axis NormVector="-1;-1;-1" />
        <Axis NormVector="-1; 1; 1" />
        <Axis NormVector=" 1;-1; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;-C1; C1" />
                <Add Vector = " C1; C1;-C1" />
                <Add Vector = "-C1; C1; C1" />
                <Add Vector = "-C1;-C1;-C1" />
                <Add Vector = " C1; C0; C1" />
                <Add Vector = " C1;-C0;-C1" />
                <Add Vector = "-C1;-C0; C1" />
                <Add Vector = "-C1; C0;-C1" />
                <Add Vector = " C1; C1; C0" />
                <Add Vector = " C1;-C1;-C0" />
                <Add Vector = "-C1;-C1; C0" />
                <Add Vector = "-C1; C1;-C0" />
                <Add Vector = " C0; C1; C1" />
                <Add Vector = " C0;-C1;-C1" />
                <Add Vector = "-C0;-C1; C1" />
                <Add Vector = "-C0; C1;-C1" />
            </Vertices>
            <Faces>
                <Face Color = "clOrange" VertexIndexes = "0; 9; 5; 1; 8; 4" />
                <Face Color = "clBlue  " VertexIndexes = "0;14;10; 3;13; 9" />
                <Face Color = "clYellow" VertexIndexes = "1; 5;13; 3; 7;15" />
                <Face Color = "clGreen " VertexIndexes = "1;15;11; 2;12; 8" />
                <Face Color = "clWhite " VertexIndexes = "2; 6;14; 0; 4;12" />
                <Face Color = "clRed   " VertexIndexes = "2;11; 7; 3;10; 6" />
                <Face Color = "clCyan  " VertexIndexes = "4; 8;12" />
                <Face Color = "clLime  " VertexIndexes = "5; 9;13" />
                <Face Color = "clPink  " VertexIndexes = "6;10;14" />
                <Face Color = "clNavy  " VertexIndexes = "7;11;15" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
