<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DaYan Gem 7</Name>
        <Menu>Other forms\DaYan\DaYan Gem 7</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-10-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4308</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        Width := 0.5;
        C0 := Width;
        C1 := Width * (2 * sqrt(3) + 5) / 13;
        C2 := Width * (4 * sqrt(3) - 3) / 13;

        D1 := C0 * sqrt(2) / 2;
        D2 := C0 / 2 + C2;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = "1;  1;  0" />
        <Axis NormVector = "1; -1;  0" />
        <Axis NormVector = "1;  0;  1" />
        <Axis NormVector = "1;  0; -1" />
        <Axis NormVector = "0;  1;  1" />
        <Axis NormVector = "0;  1; -1" />
    </Axes>
   
    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C2;  C2;  C0" />
                <Add Vector = " C2;  C2; -C0" />
                <Add Vector = " C2; -C2;  C0" />
                <Add Vector = " C2; -C2; -C0" />
                <Add Vector = "-C2;  C2;  C0" />
                <Add Vector = "-C2;  C2; -C0" />
                <Add Vector = "-C2; -C2;  C0" />
                <Add Vector = "-C2; -C2; -C0" />
                <Add Vector = " C0;  C2;  C2" />
                <Add Vector = " C0;  C2; -C2" />
                <Add Vector = " C0; -C2;  C2" />
                <Add Vector = " C0; -C2; -C2" />
                <Add Vector = "-C0;  C2;  C2" />
                <Add Vector = "-C0;  C2; -C2" />
                <Add Vector = "-C0; -C2;  C2" />
                <Add Vector = "-C0; -C2; -C2" />
                <Add Vector = " C2;  C0;  C2" />
                <Add Vector = " C2;  C0; -C2" />
                <Add Vector = " C2; -C0;  C2" />
                <Add Vector = " C2; -C0; -C2" />
                <Add Vector = "-C2;  C0;  C2" />
                <Add Vector = "-C2;  C0; -C2" />
                <Add Vector = "-C2; -C0;  C2" />
                <Add Vector = "-C2; -C0; -C2" />
                <Add Vector = " C1;  C1;  C1" />
                <Add Vector = " C1;  C1; -C1" />
                <Add Vector = " C1; -C1;  C1" />
                <Add Vector = " C1; -C1; -C1" />
                <Add Vector = "-C1;  C1;  C1" />
                <Add Vector = "-C1;  C1; -C1" />
                <Add Vector = "-C1; -C1;  C1" />
                <Add Vector = "-C1; -C1; -C1" />
            </Vertices>
            <Faces>
                <Face Color = "009000"   VertexIndexes = "24;0;2;26;10;8" />
                <Face Color = "FFFFF7"   VertexIndexes = "24;8;9;25;17;16" />
                <Face Color = "C00000"   VertexIndexes = "24;16;20;28;4;0" />
                <Face Color = "3F3FFF"   VertexIndexes = "27;3;1;25;9;11" />
                <Face Color = "F7F700"   VertexIndexes = "27;11;10;26;18;19" />
                <Face Color = "C00000"   VertexIndexes = "27;19;23;31;7;3" />
                <Face Color = "009000"   VertexIndexes = "29;5;7;31;15;13" />
                <Face Color = "F7F700"   VertexIndexes = "29;13;12;28;20;21" />
                <Face Color = "FF00FF"   VertexIndexes = "29;21;17;25;1;5" />
                <Face Color = "0000C0"   VertexIndexes = "30;6;4;28;12;14" />
                <Face Color = "FFFFF7"   VertexIndexes = "30;14;15;31;23;22" />
                <Face Color = "FF00FF"   VertexIndexes = "30;22;18;26;2;6" />
                <Face Color = "clWhite"  VertexIndexes = "0;4;6;2" />
                <Face Color = "clYellow" VertexIndexes = "1;3;7;5" />
                <Face Color = "clOrange" VertexIndexes = "8;10;11;9" />
                <Face Color = "clREd"    VertexIndexes = "12;13;15;14" />
                <Face Color = "clGreen"  VertexIndexes = "16;17;21;20" />
                <Face Color = "clBlue"   VertexIndexes = "18;22;23;19" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveGrayParts/>
   </Figure>

   <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>

