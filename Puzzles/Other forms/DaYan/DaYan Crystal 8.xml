<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DaYan Crystal 8</Name>
        <Menu>Other forms\DaYan\DaYan Crystal 8</Menu>
        <Menu>Other forms\Archimedean Solids\DaYan\DaYan Crystal 8</Menu>
        <Menu>Other forms\Archimedean Solids\Truncated Cube\DaYan Crystal 8</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-03-04</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'FFFFFF';

        S := 1/3;

        C0 := S * (1 + sqrt(2)) / 2;
        C1 := S / 2;

        C2 := (C0 + C1) / 2;
        C3 := 2 * C0 * sqrt(3) / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2; 0; Pi / 2" PlaneDistances = "-C2; C2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3; 0; 2 * Pi / 3" PlaneDistances = "-C3; C3" >
        <Axis NormVector = "1; 1; 1" />
        <Axis NormVector = "1; 1;-1" />
        <Axis NormVector = "1;-1; 1" />
        <Axis NormVector = "1;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C0;  C1;  C0" />
                <Add Vector = " C0;  C1; -C0" />
                <Add Vector = " C0; -C1;  C0" />
                <Add Vector = " C0; -C1; -C0" />
                <Add Vector = "-C0;  C1;  C0" />
                <Add Vector = "-C0;  C1; -C0" />
                <Add Vector = "-C0; -C1;  C0" />
                <Add Vector = "-C0; -C1; -C0" />
                <Add Vector = " C0;  C0;  C1" />
                <Add Vector = " C0;  C0; -C1" />
                <Add Vector = " C0; -C0;  C1" />
                <Add Vector = " C0; -C0; -C1" />
                <Add Vector = "-C0;  C0;  C1" />
                <Add Vector = "-C0;  C0; -C1" />
                <Add Vector = "-C0; -C0;  C1" />
                <Add Vector = "-C0; -C0; -C1" />
                <Add Vector = " C1;  C0;  C0" />
                <Add Vector = " C1;  C0; -C0" />
                <Add Vector = " C1; -C0;  C0" />
                <Add Vector = " C1; -C0; -C0" />
                <Add Vector = "-C1;  C0;  C0" />
                <Add Vector = "-C1;  C0; -C0" />
                <Add Vector = "-C1; -C0;  C0" />
                <Add Vector = "-C1; -C0; -C0" />
            </Vertices>

            <Faces>
                <Face Color = "51C4FA" VertexIndexes = "0;2;10;11;3;1;9;8" />
                <Face Color = "075AFF" VertexIndexes = "0;16;20;4;6;22;18;2" />
                <Face Color = "FF8009" VertexIndexes = "12;13;5;7;15;14;6;4" />
                <Face Color = "FFFFFE" VertexIndexes = "12;20;16;8;9;17;21;13" />
                <Face Color = "FACC06" VertexIndexes = "19;23;7;5;21;17;1;3" />
                <Face Color = "01FF00" VertexIndexes = "19;11;10;18;22;14;15;23" />
                <Face Color = "FFFF01" VertexIndexes = "0;8;16" />
                <Face Color = "009484" VertexIndexes = "1;17;9" />
                <Face Color = "FF0001" VertexIndexes = "2;18;10" />
                <Face Color = "C1C5C8" VertexIndexes = "3;11;19" />
                <Face Color = "38ABEA" VertexIndexes = "4;20;12" />
                <Face Color = "018000" VertexIndexes = "5;13;21" />
                <Face Color = "9F0000" VertexIndexes = "6;14;22" />
