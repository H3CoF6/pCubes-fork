<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetracopter 12 Unbandaged</Name>
        <Menu>Other forms\Prism\Tetracopter\12 Unbandaged</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-12-02</Added>
        <Link>https://www.youtube.com/watch?v=gwUSL0OCUE8</Link>
    </Interface>

    <Script>
        clYellow := 'FFFF00';
        clBlue   := '0000A0';
        clOrange := 'FF6000';
        clRed    := 'FF0000';
        clGreen  := '008000';
        clWhite  := 'FFFFFF';

        H := 0.55;
        W := 0.45;

        D1 := W / sqrt(2);
        D2 := H / sqrt(3);

        x := 0.06; // to remove small elements
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 0;  0; 1" />
        <Axis NormVector = " 1;  1; 0" />
        <Axis NormVector = " 1; -1; 0" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "  W;  0; D1" />
        <Axis NormVector = " -W;  0; D1" />
        <Axis NormVector = "  0;  W; D1" />
        <Axis NormVector = "  0; -W; D1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  W;   W;   H" />
                <Add Vector = "  W;  -W;   H" />
                <Add Vector = " -W;  -W;   H" />
                <Add Vector = " -W;   W;   H" />

                <Add Vector = "  W;   W;  -H" />
                <Add Vector = "  W;  -W;  -H" />
                <Add Vector = " -W;  -W;  -H" />
                <Add Vector = " -W;   W;  -H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "3;2;1;0" />
                <Face Color = "clOrange" VertexIndexes = "0;1;5;4" />
                <Face Color = "clBlue  " VertexIndexes = "1;2;6;5" />
                <Face Color = "clRed   " VertexIndexes = "2;3;7;6" />
                <Face Color = "clGreen " VertexIndexes = "3;0;4;7" />
                <Face Color = "clYellow" VertexIndexes = "4;5;6;7" />
            </Faces>
        </Part>

        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "5" From = "2" />
        <Split Axis = "6" From = "1" />
        <Split Axis = "6" From = "2" />

        <RemoveContaining Vector = "  W    ;  W    ;  0" />
        <RemoveContaining Vector = " -W    ;  W    ;  0" />
        <RemoveContaining Vector = " -W    ; -W    ;  0" />
        <RemoveContaining Vector = "  W    ; -W    ;  0" />

        <RemoveContaining Vector = "  W - x;  W    ;  x" />
        <RemoveContaining Vector = "  W    ;  W - x;  x" />
        <RemoveContaining Vector = "  W - x;  W    ; -x" />
        <RemoveContaining Vector = "  W    ;  W - x; -x" />

        <RemoveContaining Vector = " -W + x;  W    ;  x" />
        <RemoveContaining Vector = " -W    ;  W - x;  x" />
        <RemoveContaining Vector = " -W + x;  W    ; -x" />
        <RemoveContaining Vector = " -W    ;  W - x; -x" />

        <RemoveContaining Vector = "  W - x; -W    ;  x" />
        <RemoveContaining Vector = "  W    ; -W + x;  x" />
        <RemoveContaining Vector = "  W - x; -W    ; -x" />
        <RemoveContaining Vector = "  W    ; -W + x; -x" />

        <RemoveContaining Vector = " -W + x; -W    ;  x" />
        <RemoveContaining Vector = " -W    ; -W + x;  x" />
        <RemoveContaining Vector = " -W + x; -W    ; -x" />
        <RemoveContaining Vector = " -W    ; -W + x; -x" />

        <RemoveContaining Vector = " 0; 0; 0" />

    </Figure>
</xml>
