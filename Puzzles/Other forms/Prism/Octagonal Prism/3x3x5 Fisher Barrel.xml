<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x5 Fisher Barrel</Name>
        <Menu>Other forms\Prism\Octagonal Prism\3x3x5 Fisher Barrel</Menu>
        <Inventor>Calvin Fan</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-10-23</Added>
        <Link>http://www.hknowstore.com/locale/en-US/item.aspx?corpname=nowstore&amp;itemid=c0e5cfee-39b3-468c-bdd3-128a2f5199f2</Link>
    </Interface>

    <Script>
        W := 0.33;
		H := W / 3 * 5;
        D := W / 3 - 0.001; // to avoid some turns
        D2 := 3 * D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
	<Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D; D; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-D;-H" />
                <Add Vector = "-W; D;-H" />
                <Add Vector = "-D; W;-H" />
                <Add Vector = " D; W;-H" />
                <Add Vector = " W; D;-H" />
                <Add Vector = " W;-D;-H" />
                <Add Vector = " D;-W;-H" />
                <Add Vector = "-D;-W;-H" />
                <Add Vector = "-W;-D; H" />
                <Add Vector = "-W; D; H" />
                <Add Vector = "-D; W; H" />
                <Add Vector = " D; W; H" />
                <Add Vector = " W; D; H" />
                <Add Vector = " W;-D; H" />
                <Add Vector = " D;-W; H" />
                <Add Vector = "-D;-W; H" />
            </Vertices>

            <Faces>
                <Face Color = "0000C8" VertexIndexes = "0;1;2;3;4;5;6;7" />
                <Face Color = "009600" VertexIndexes = "15;14;13;12;11;10;9;8" />
                <Face Color = "C80000" VertexIndexes = "1;0;8;9" />
                <Face Color = "C80000" VertexIndexes = "2;1;9;10" />
                <Face Color = "FFFF00" VertexIndexes = "3;2;10;11" />
                <Face Color = "FFFF00" VertexIndexes = "4;3;11;12" />
                <Face Color = "FF800A" VertexIndexes = "5;4;12;13" />
                <Face Color = "FF800A" VertexIndexes = "6;5;13;14" />
                <Face Color = "FFFFFF" VertexIndexes = "7;6;14;15" />
                <Face Color = "FFFFFF" VertexIndexes = "0;7;15;8" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
