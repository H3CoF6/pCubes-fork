<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Brick Barrel 4x4x4</Name>
        <Menu>Other forms\Prism\Octagonal Prism\Brick Barrel 4x4x4</Menu>
        <Inventor>Ray Bruner</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-07-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7479</Link>
    </Interface>

    <Script>
        W := 0.5;
        D := W / 2;
        Colors[6] := '00FF00'; // clLightGreen  
        Colors[7] := 'FF0080'; // clLightViolett
        Colors[8] := '800080'; // clViolett     
        Colors[9] := '3868BF'; // clLightBlue   
    </Script>
 
    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Cut Color = "Colors[6]"> <Plane NormVector = " 1; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[7]"> <Plane NormVector = "-1; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[8]"> <Plane NormVector = "-1;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "Colors[9]"> <Plane NormVector = " 1;-1; 0" NormDistance = "-W" /> </Cut>
        <Turn Axis = "2" Layer = "0" Angle = "Pi / 4" />
        <Turn Axis = "2" Layer = "2" Angle = "Pi / 4" />
        <SplitByAxes/>
        <Turn Axis = "2" Layer = "0" Angle = "-Pi / 4" />
        <Turn Axis = "2" Layer = "2" Angle = "-Pi / 4" />
        <RemoveGrayParts/>
    </Figure>
</xml>
