<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Solar flare</Name>
        <Menu>Other forms\Prism\Octagonal Prism\Solar flare</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-04-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5418</Link>
    </Interface>

    <Script>
        H := 0.5;
        sAngle := PI * 2 / 8;
        RCut := 0.6;
        F := 0.75 * RCut;

        for i := 0 to 7 do begin
            x[i] := sin(sAngle * i);
            y[i] := cos(sAngle * i);
        end;
        for i := 0 to 7 do begin
            x1[i] := sin(sAngle * (i + 0.5));
            y1[i] := cos(sAngle * (i + 0.5));
        end;
        E := (RCut + F) / cos(sAngle / 2) / 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-F; F" FixedLayers = "1" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-E; E" FixedLayers = "1" >
        <Axis NormVector = "x1[0]; y1[0]; 0" />
        <Axis NormVector = "x1[1]; y1[1]; 0" />
        <Axis NormVector = "x1[2]; y1[2]; 0" />
        <Axis NormVector = "x1[3]; y1[3]; 0" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 2; -2;  2" />
                <Add Vector = "-2;  2;  2" />
                <Add Vector = " 2;  2; -2" />
                <Add Vector = "-2; -2; -2" />
            </Vertices>
            <Faces>
                <Face VertexIndexes = "0;1;3" />
                <Face VertexIndexes = "1;2;3" />
                <Face VertexIndexes = "0;3;2" />
                <Face VertexIndexes = "0;2;1" />
            </Faces>
        </Part>

        <Cut Color="FF0000" >
            <Plane>
                <NormVector X = "x[0]" Y = "y[0]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="008000" >
            <Plane>
                <NormVector X = "x[1]" Y = "y[1]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="700070" >
            <Plane>
                <NormVector X = "x[2]" Y = "y[2]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="0050FF" >
            <Plane>
                <NormVector X = "x[3]" Y = "y[3]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="FF8000" >
            <Plane>
                <NormVector X = "x[4]" Y = "y[4]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="80FF00" >
            <Plane>
                <NormVector X = "x[5]" Y = "y[5]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color = "FF60A0" >
            <Plane>
                <NormVector X = "x[6]" Y = "y[6]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color = "0000A0" >
            <Plane>
                <NormVector X = "x[7]" Y = "y[7]" Z = "0" />
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>

        <Cut Color = "FFFF00" >
            <Plane>
                <NormVector X = "0" Y = "0" Z = "1" />
                <NormDistance> -H / 2 </NormDistance>
            </Plane>
        </Cut>
        <Cut Color = "FFFFFF" >
            <Plane>
                <NormVector X = "0" Y = "0" Z = "-1" />
                <NormDistance> -H / 2 </NormDistance>
            </Plane>
        </Cut>

        <SplitByAxes/>
    </Figure>
</xml>
