<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tower Cube</Name>
        <Menu>Other forms\Prism\Octagonal Prism\Tower Cube</Menu>
        <Inventor>Dragan Tutić</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-04-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3404</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00'; // Yellow
        Colors[1] := '808080'; // Gray
        Colors[2] := '008000'; // Green
        Colors[3] := '0000A0'; // Blue
        Colors[4] := 'FF6000'; // Orange
        Colors[5] := 'FFFFFF'; // White
        Colors[6] := '800080'; // Violett
        Colors[7] := 'FF0000'; // Red

        W := 0.45;
        H := W;

        D := W / 2;
        D2 := H / 2;
        DCut := W;

        R := W / cos(Pi/8);
        for i := 0 to 7 do begin
            x[i] := R * cos(2 * Pi / 8 * (i+0.5));
            y[i] := R * sin(2 * Pi / 8 * (i+0.5));
        end;
    </Script>

    <Axes TurningAngles = "Pi/4" PlaneDistances = "-D; 0; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" /> 0..7
            <Vertices Vectors = "x; y;-H" /> 8..15
            <Vertices Vectors = "0; 0; H" /> 16
            <Vertices Vectors = "0; 0;-H" /> 17
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 8; 9; 1; 0" />
                <Face Color = "Colors[1]" VertexIndexes = " 9;10; 2; 1" />
                <Face Color = "Colors[2]" VertexIndexes = "10;11; 3; 2" />
                <Face Color = "Colors[3]" VertexIndexes = "11;12; 4; 3" />
                <Face Color = "Colors[4]" VertexIndexes = "12;13; 5; 4" />
                <Face Color = "Colors[5]" VertexIndexes = "13;14; 6; 5" />
                <Face Color = "Colors[6]" VertexIndexes = "14;15; 7; 6" />
                <Face Color = "Colors[7]" VertexIndexes = "15; 8; 0; 7" />
                <Face Color = "Colors[0]" VertexIndexes = " 0; 1; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = " 1; 2; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = " 2; 3; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = " 3; 4; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = " 4; 5; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = " 5; 6; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[6]" VertexIndexes = " 6; 7; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[7]" VertexIndexes = " 7; 0; 16" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = " 9; 8; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "10; 9; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "11;10; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "12;11; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "13;12; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "14;13; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[6]" VertexIndexes = "15;14; 17" InvisibleEdges = "6" />
                <Face Color = "Colors[7]" VertexIndexes = " 8;15; 17" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Turn Axis = "2" Layers = "1;3" Angle = "Pi/4" />
        <SplitByAxes/>
        <Undo Repeat = "2" />

        <Turn NormVector = "0; 0; 1" Angle = "Pi/4" />
        <RemoveGrayParts/>
    </Figure>
</xml>
