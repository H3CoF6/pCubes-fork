<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4x4x6 Octagonal Wall Barrel</Name>
        <Menu>Other forms\Prism\Octagonal Prism\4x4x6 Octagonal Wall Barrel</Menu>
        <Inventor>Matthew Street</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-10-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6493</Link>
    </Interface>
 
    <Script>
        clWhite   := 'FFFFFF';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clCoral   := 'FF7F50';
        clPink    := 'FF69B4';
        clGreen   := '008000';
        clViolett := '800080';
        clCyan    := '00FFFF';
        clYellow  := 'FFFF00';

        W := 0.45;
        R := W / cos(Pi/8);

        for i := 0 to 7 do begin
            x[i] := R * cos(2 * Pi / 8 * (i+0.5));
            y[i] := R * sin(2 * Pi / 8 * (i+0.5));
        end;

        D := W / 2 * 0.92;
        H := D * 3;
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D*2; -D; 0; D; D*2" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices Vectors = " x; y; H" />
            <Vertices Vectors = " x; y;-H" />
            <Faces>
                <Face Color = "clWhite  " VertexIndexes = "0;1;2;3;4;5;6;7" />
                <Face Color = "clBlue   " VertexIndexes = "8;9;1;0" />
                <Face Color = "clOrange " VertexIndexes = "9;10;2;1" />
                <Face Color = "clRed    " VertexIndexes = "10;11;3;2" />
                <Face Color = "clCoral  " VertexIndexes = "11;12;4;3" />
                <Face Color = "clPink   " VertexIndexes = "12;13;5;4" />
                <Face Color = "clGreen  " VertexIndexes = "13;14;6;5" />
                <Face Color = "clViolett" VertexIndexes = "14;15;7;6" />
                <Face Color = "clCyan   " VertexIndexes = "15;8;0;7" />
                <Face Color = "clYellow " VertexIndexes = "15;14;13;12;11;10;9;8" />
            </Faces>
        </Part>

        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "2" From = "5" />
        <Turn Axis = "2" Layers = "1;3;5" Angle = "Pi/4" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />

        <Undo/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <!-- Scramble macro -->
        <Macro Name = "Sc1" >
            <Turn Axis = "Random(2)" Layer = "Random(6)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Sc2" >
            <Turn Axis = "Random(3)" Layer = "Random(6)" Angle = "Pi/4 * (Random(7) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <Turn Axis = "2" Layers = "1;3;5" Angle = "Pi/4" />
            <ExecMacro MacroName = "Sc1" Repeat = "300" />
            <ExecMacro MacroName = "Sc2" Repeat = "10" />
        </Macro>
    </Macros>
</xml>
