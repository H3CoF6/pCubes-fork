<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentacopter 15</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Edge Turning\Pentacopter 15</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9229</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clWhite   := 'FFFFFF';
        clViolett := '800080';

        R := 0.6;
        H := R * 0.85;

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;

        D1 := (R / 4 + H * sin(Pi/5)) / sqrt(1 + sin(Pi/5)^2);
        D2 := R * cos(Pi/5)^2;
        AZ := R * sin(Pi/5);

        A1 := ArcCos((sqrt(5) - 5) / 8);
        A2 := ArcCos(-(1 + 5 * sqrt(5)) / 16);

        RCut := R * 0.7;
    </Script>

    <Axes TurningAngles = "2 * Pi; 0" AvailableAngles = "-A2;-A1; 0; A1; A2" PlaneDistances = "-D1" FixedLayers = "1" >
        <Axis NormVector = " x[0]; y[0]; AZ" />
        <Axis NormVector = " x[1]; y[1]; AZ" />
        <Axis NormVector = " x[2]; y[2]; AZ" />
        <Axis NormVector = " x[3]; Y[3]; AZ" />
        <Axis NormVector = " x[4]; y[4]; AZ" />
        <Axis NormVector = " x[0]; y[0];-AZ" />
        <Axis NormVector = " x[1]; y[1];-AZ" />
        <Axis NormVector = " x[2]; y[2];-AZ" />
        <Axis NormVector = " x[3]; y[3];-AZ" />
        <Axis NormVector = " x[4]; y[4];-AZ" />
    </Axes>

    <Axes TurningAngles = "0; Pi/2" AvailableAngles = "Pi" PlaneDistances = "D2" NormVectors = " x; y; 0" />

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "clWhite  " VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clGreen  " VertexIndexes = "5;6;1;0" />
                <Face Color = "clRed    " VertexIndexes = "6;7;2;1" />
                <Face Color = "clOrange " VertexIndexes = "7;8;3;2" />
                <Face Color = "clViolett" VertexIndexes = "8;9;4;3" />
                <Face Color = "clBlue   " VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Hide><Plane NormVector = "-x[0];-y[0]; 0" NormDistance = "-RCut" /></Hide>
        <Hide><Plane NormVector = "-x[1];-y[1]; 0" NormDistance = "-RCut" /></Hide>
        <Hide><Plane NormVector = "-x[2];-y[2]; 0" NormDistance = "-RCut" /></Hide>
        <Hide><Plane NormVector = "-x[3];-y[3]; 0" NormDistance = "-RCut" /></Hide>
        <Hide><Plane NormVector = "-x[4];-y[4]; 0" NormDistance = "-RCut" /></Hide>
        <InvertVisibility/>
        <RemoveAllVisible/>
        <ShowAll/>
    </Figure>
</xml>
