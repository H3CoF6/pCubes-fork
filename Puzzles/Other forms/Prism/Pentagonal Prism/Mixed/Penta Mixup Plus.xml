<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Penta Mixup Plus</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Mixed\Penta Mixup Plus</Menu>
        <Inventor>Braden G.</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10684</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';

        R := 0.65;

        H := R * sin(Pi / 5);
        sAngle := PI * 2 / 5;
        for i := 0 to 4 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D1 := R / 2;
        D2 := R * sqrt((5-sqrt(5))/40); // 0.26286556;
    </Script>

    <Axes TurningAngles = "Pi/2; 0" PlaneDistances = "-D1" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "2*Pi/5;2*Pi/10;2*Pi/5" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = "5;6;1;0" />
                <Face Color = "clBlue  " VertexIndexes = "6;7;2;1" />
                <Face Color = "clGreen " VertexIndexes = "7;8;3;2" />
                <Face Color = "clOrange" VertexIndexes = "8;9;4;3" />
                <Face Color = "clPurple" VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clWhite " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "5" Angle = "2*Pi/10" Layer = "1" />
        <SplitByAxes/>
        <Undo />
        <RemoveGrayParts/>

        <Macro Name = "SplitPart">
            <Turn Axis = "Ax" Angle = "Pi/2" Layer = "0" />
            <Split Axis = "5" From = "1"/>
            <Split Axis = "5" From = "2"/>
            <Undo />
        </Macro>

        <ExecMacro MacroName = "SplitPart" Ax = "0"/>
        <ExecMacro MacroName = "SplitPart" Ax = "1"/>
        <ExecMacro MacroName = "SplitPart" Ax = "2"/>
        <ExecMacro MacroName = "SplitPart" Ax = "3"/>
        <ExecMacro MacroName = "SplitPart" Ax = "4"/>

        <Turn Axis = "5" Angle = "2*Pi/10" Layer = "1" />
        <ExecMacro MacroName = "SplitPart" Ax = "0"/>
        <ExecMacro MacroName = "SplitPart" Ax = "1"/>
        <ExecMacro MacroName = "SplitPart" Ax = "2"/>
        <ExecMacro MacroName = "SplitPart" Ax = "3"/>
        <ExecMacro MacroName = "SplitPart" Ax = "4"/>
        <Undo />
        <Macro Name = "SplitPart2">
            <Turn Axis = "Ax" Angle = "Pi/2" Layer = "0" />
            <Turn Axis = "5" Angle = "2*Pi/10" Layer = "1" />
            <Split Axis = "Ax" From = "1"/>
            <Turn Axis = "Ax" Angle = "-Pi/2" Layer = "0" />
            <Split Axis = "5" From = "1"/>
            <Split Axis = "5" From = "2"/>
            <Undo/>
            <Turn Axis = "5" Angle = "-2*2*Pi/10" Layer = "1" />
            <Split Axis = "Ax" From = "1"/>
            <Turn Axis = "Ax" Angle = "-Pi/2" Layer = "0" />
            <Split Axis = "5" From = "1"/>
            <Split Axis = "5" From = "2"/>
            <Undo Repeat ="4"/>
        </Macro>

        <ExecMacro MacroName = "SplitPart2" Ax = "0"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "1"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "2"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "3"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "4"/>

        <Turn Axis = "5" Angle = "2*Pi/10" Layer = "1" />

        <ExecMacro MacroName = "SplitPart2" Ax = "0"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "1"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "2"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "3"/>
        <ExecMacro MacroName = "SplitPart2" Ax = "4"/>
        <Undo />

        <Macro Name = "SplitPart3">
            <Turn Axis = "Ax" Angle = "Pi/2" Layer = "0" />
            <Turn Axis = "5" Angle = "2*Pi/5" Layer = "0" />
            <Turn Axis = "5" Angle = "2*Pi/5" Layer = "2" />
            <Split Axis = "Ax1" From = "1"/>
            <Turn Axis = "5" Angle = "-2*2*Pi/5" Layer = "0" />
            <Turn Axis = "5" Angle = "-2*2*Pi/5" Layer = "2" />
            <Split Axis = "Ax2" From = "1"/>
            <Undo Repeat ="5"/>
        </Macro>

        <ExecMacro MacroName = "SplitPart3" Ax1 = "4" Ax = "0" Ax2 = "1"/>
        <ExecMacro MacroName = "SplitPart3" Ax1 = "0" Ax = "1" Ax2 = "2"/>
        <ExecMacro MacroName = "SplitPart3" Ax1 = "1" Ax = "2" Ax2 = "3"/>
        <ExecMacro MacroName = "SplitPart3" Ax1 = "2" Ax = "3" Ax2 = "4"/>
        <ExecMacro MacroName = "SplitPart3" Ax1 = "3" Ax = "4" Ax2 = "0"/>
    </Figure>
</xml>
