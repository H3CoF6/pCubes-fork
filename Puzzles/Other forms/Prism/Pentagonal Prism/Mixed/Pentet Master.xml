<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentet Master</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Mixed\Pentet Master</Menu>
        <Inventor>Michael Sun</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-04-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5325</Link>
    </Interface>

    <Script>
        clBlue    := '0000C8';
        clGreen   := '009600';
        clRed     := 'C80000';
        clOrange  := 'FF800A';
        clViolett := '7700CD';
        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        H := 0.5;
        sAngle := PI * 2 / 5;
        R := 0.6;

        F1 := R * (1 + cos(sAngle)) / 2 + 0.1;
        F2 := R * (1 + cos(sAngle)) / 2 - 0.1;

        for i := 0 to 4 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "F1; F2" FixedLayers = "0" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H / 2" />
                <Add Vector = "x[1]; y[1]; -H / 2" />
                <Add Vector = "x[2]; y[2]; -H / 2" />
                <Add Vector = "x[3]; y[3]; -H / 2" />
                <Add Vector = "x[4]; y[4]; -H / 2" />
                <Add Vector = "x[0]; y[0]; H / 2" />
                <Add Vector = "x[1]; y[1]; H / 2" />
                <Add Vector = "x[2]; y[2]; H / 2" />
                <Add Vector = "x[3]; y[3]; H / 2" />
                <Add Vector = "x[4]; y[4]; H / 2" />
            </Vertices>
            <Faces>
                <Face Color = "clRed"     VertexIndexes = "5;6;1;0" />
                <Face Color = "clOrange"  VertexIndexes = "6;7;2;1" />
                <Face Color = "clGreen"   VertexIndexes = "7;8;3;2" />
                <Face Color = "clViolett" VertexIndexes = "8;9;4;3" />
                <Face Color = "clBlue"    VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow"  VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clWhite"   VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
