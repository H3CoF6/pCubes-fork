<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dino Pent</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Mixed\Dino Pent</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-31</Added>
        <Link>https://www.youtube.com/watch?v=65HBB3_SlPA</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clWhite   := 'FFFFFF';
        clViolett := '800080';

        H := 0.4;
        R := H * sqrt(2 * (1 + 1 / sqrt(5)));
        D := H * sqrt((19 + 42 / sqrt(5)) / 41);

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;

        A1 := ArcCos((sqrt(5) - 5) / 8);
        A2 := Pi - ArcCos((1 + 5 * sqrt(5)) / 16);
    </Script>

    <Axes TurningAngles = "0; 2 * Pi" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D" >
        <Axis NormVector = " x[0]; y[0];  H" />
        <Axis NormVector = " x[1]; y[1];  H" />
        <Axis NormVector = " x[2]; y[2];  H" />
        <Axis NormVector = " x[3]; Y[3];  H" />
        <Axis NormVector = " x[4]; y[4];  H" />
        <Axis NormVector = " x[0]; y[0]; -H" />
        <Axis NormVector = " x[1]; y[1]; -H" />
        <Axis NormVector = " x[2]; y[2]; -H" />
        <Axis NormVector = " x[3]; y[3]; -H" />
        <Axis NormVector = " x[4]; y[4]; -H" />
    </Axes>
    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite  " VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clGreen  " VertexIndexes = "5;6;1;0" />
                <Face Color = "clRed    " VertexIndexes = "6;7;2;1" />
                <Face Color = "clOrange " VertexIndexes = "7;8;3;2" />
                <Face Color = "clViolett" VertexIndexes = "8;9;4;3" />
                <Face Color = "clBlue   " VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "0"  Layer = "1" Angle = "   A1" />
        <Turn  Axis = "1"  Layer = "1" Angle = "  -A1" />
        <Turn  Axis = "7"  Layer = "1" Angle = "   A1" />
        <Split Axis = "10" From  = "1" />
        <Turn  Axis = "7"  Layer = "1" Angle = "  -A1" />
        <Turn  Axis = "1"  Layer = "1" Angle = "   A1" />
        <Turn  Axis = "0"  Layer = "1" Angle = "-2*A1" />
        <Turn  Axis = "4"  Layer = "1" Angle = "   A1" />
        <Split Axis = "10" From  = "1" />
        <Turn  Axis = "4"  Layer = "1" Angle = "  -A1" />
        <Turn  Axis = "0"  Layer = "1" Angle = "   A1" />

        <Turn  Axis = "3"  Layer = "1" Angle = "   A1" />
        <Turn  Axis = "5"  Layer = "1" Angle = "   A1" />
        <Turn  Axis = "9"  Layer = "1" Angle = "  -A1" />
        <Split Axis = "10" From  = "1" />
        <Turn  Axis = "3"  Layer = "1" Angle = "  -A1" />
        <Turn  Axis = "9"  Layer = "1" Angle = "   A1" />
        <Turn  Axis = "5"  Layer = "1" Angle = "-2*A1" />
        <Turn  Axis = "6"  Layer = "1" Angle = "   A1" />
        <Split Axis = "10" From  = "1" />
        <Turn  Axis = "6"  Layer = "1" Angle = "  -A1" />
        <Turn  Axis = "5"  Layer = "1" Angle = "   A1" />
    </Figure>
</xml>
