<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Prisminx Crystal 1</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Prisminx Crystal 1</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2015-05-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1885</Link>
    </Interface>

    <Script>
        D := 0.7;
        H := 0.8;
        for i := 0 to 4 do begin
            x[i] := D * cos(2 * Pi / 5 * i);
            y[i] := D * sin(2 * Pi / 5 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 5" PlaneDistances = "-H/6; H/6" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
              <Vertices>
                  <Add Vector = "x[0]; y[0]; H / 2" />
                  <Add Vector = "x[1]; y[1]; H / 2" />
                  <Add Vector = "x[2]; y[2]; H / 2" />
                  <Add Vector = "x[3]; y[3]; H / 2" />
                  <Add Vector = "x[4]; y[4]; H / 2" />
                  <Add Vector = "x[0]; y[0]; -H / 2" />
                  <Add Vector = "x[1]; y[1]; -H / 2" />
                  <Add Vector = "x[2]; y[2]; -H / 2" />
                  <Add Vector = "x[3]; y[3]; -H / 2" />
                  <Add Vector = "x[4]; y[4]; -H / 2" />
            </Vertices>
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "1;0;5;6" />
                <Face Color = "FF64FF" VertexIndexes = "2;1;6;7" />
                <Face Color = "FF6000" VertexIndexes = "3;2;7;8" />
                <Face Color = "00FF00" VertexIndexes = "4;3;8;9" />
                <Face Color = "FF0000" VertexIndexes = "0;4;9;5" />
                <Face Color = "646464" VertexIndexes = "9;8;7;6;5" />
                <Face Color = "C8C8C8" VertexIndexes = "0;1;2;3;4" />
            </Faces>
        </Part>
        
        <SplitByAxes/>
    </Figure>
</xml>