<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>OctoPent</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\OctoPent</Menu>
        <Inventor>Jack R Tully</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=587</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clWhite   := 'FFFFFF';
        clViolett := '800080';

        H := 0.4;
        R := H  / sin(Pi / 5);

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;

        D := -(x[1] + x[2]) / 2  + H * tan (Pi / 8) * cos (Pi / 10);
    </Script>

    <Axes TurningAngles = "Pi/4"  PlaneDistances = "-D" FixedLayers = "1" >
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
        <Axis NormVector = " x[3]; y[3]; 0" />
        <Axis NormVector = " x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite  " VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clGreen  " VertexIndexes = "5;6;1;0" />
                <Face Color = "clRed    " VertexIndexes = "6;7;2;1" />
                <Face Color = "clOrange " VertexIndexes = "7;8;3;2" />
                <Face Color = "clViolett" VertexIndexes = "8;9;4;3" />
                <Face Color = "clBlue   " VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "2" Angle = "   Pi  " Layer = "0" />
        <Turn Axis = "1" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-3*Pi/4" Layer = "0" />
        <Turn Axis = "2" Angle = "  -Pi  " Layer = "0" />

        <Turn Axis = "3" Angle = "   Pi  " Layer = "0" />
        <Turn Axis = "2" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-3*Pi/4" Layer = "0" />
        <Turn Axis = "3" Angle = "  -Pi  " Layer = "0" />

        <Turn Axis = "4" Angle = "   Pi  " Layer = "0" />
        <Turn Axis = "3" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "3" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "3" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "3" Angle = "-3*Pi/4" Layer = "0" />
        <Turn Axis = "4" Angle = "  -Pi  " Layer = "0" />

        <Turn Axis = "0" Angle = "   Pi  " Layer = "0" />
        <Turn Axis = "4" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "4" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "4" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "4" Angle = "-3*Pi/4" Layer = "0" />
        <Turn Axis = "0" Angle = "  -Pi  " Layer = "0" />

        <Turn Axis = "1" Angle = "   Pi  " Layer = "0" />
        <Turn Axis = "0" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "   Pi/4" Layer = "0" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-3*Pi/4" Layer = "0" />
        <Turn Axis = "1" Angle = "  -Pi  " Layer = "0" />
    </Figure>
</xml>
