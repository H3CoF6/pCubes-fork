<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Star Prism Baby</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Star Prism Baby</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-07-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6182</Link>
    </Interface>

    <Script>
        clRed     := 'EE0000';
        clGreen   := '00CC00';
        clBlue    := '0099EE';
        clOrange  := 'FF7700';
        clYellow  := 'FFFF00';
        clGray    := '555555';
        clWhite   := 'FFFFFF';

        R := 0.65;
        H := R * 0.6;
        sAngle := 2*PI / 5;

        for i := 0 to 4 do begin
            x[i] := R * cos(sAngle * i);
            y[i] := R * sin(sAngle * i);
        end;

        Da := (x[1] + x[2]) / 2;
    </Script>

    <Axes TurningAngles = "Pi; 0" PlaneDistances = "Da" FixedLayers = "1" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " x; y; H" />
            <Vertices Vectors = " x; y;-H" />
            <Faces>
                <Face Color = "clOrange" VertexIndexes = "1;0;5;6" />
                <Face Color = "clRed   " VertexIndexes = "2;1;6;7" />
                <Face Color = "clBlue  " VertexIndexes = "3;2;7;8" />
                <Face Color = "clGreen " VertexIndexes = "4;3;8;9" />
                <Face Color = "clYellow" VertexIndexes = "0;4;9;5" />
                <Face Color = "clGray  " VertexIndexes = "9;8;7;6;5" />
                <Face Color = "clWhite " VertexIndexes = "0;1;2;3;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
