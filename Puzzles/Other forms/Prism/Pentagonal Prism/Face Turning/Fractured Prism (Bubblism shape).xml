<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fractured Prism (Bubblism shape)</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Fractured Prism (Bubblism shape)</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>uot</Programmer>
        <Added>2020-07-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3477</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clGreen   := '008000';
        clWhite   := 'FFFFFF';
        clViolett := '800080';

        R := 0.65;
        H := R * sqrt((-sqrt(5) + 5) / 8);
        T := R * sqrt((sqrt(5) + 5) / 10);

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;

        D := -(x[1]+x[2]) / 2;

        A1 := ArcCos((sqrt(5) - 5) / 8);
        A2 := Pi - ArcCos((1 + 5 * sqrt(5)) / 16);
    </Script>

    <Axes TurningAngles = "Pi/2"  PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " -x[0]; -y[0]; 0" />
        <Axis NormVector = " -x[1]; -y[1]; 0" />
        <Axis NormVector = " -x[2]; -y[2]; 0" />
        <Axis NormVector = " -x[3]; -y[3]; 0" />
        <Axis NormVector = " -x[4]; -y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "0; 0; T" />
            <Vertices Vectors = "0; 0;-T" />

            <Faces>
                <Face Color = "clGreen  " VertexIndexes = "5;6;1;0" />
                <Face Color = "clRed    " VertexIndexes = "6;7;2;1" />
                <Face Color = "clOrange " VertexIndexes = "7;8;3;2" />
                <Face Color = "clViolett" VertexIndexes = "8;9;4;3" />
                <Face Color = "clBlue   " VertexIndexes = "9;5;0;4" />

                <Face Color = "clWhite  " VertexIndexes = "10;0;1" InvisibleEdges = "5" />
                <Face Color = "clWhite  " VertexIndexes = "10;1;2" InvisibleEdges = "5" />
                <Face Color = "clWhite  " VertexIndexes = "10;2;3" InvisibleEdges = "5" />
                <Face Color = "clWhite  " VertexIndexes = "10;3;4" InvisibleEdges = "5" />
                <Face Color = "clWhite  " VertexIndexes = "10;4;0" InvisibleEdges = "5" />

                <Face Color = "clYellow " VertexIndexes = "11;9;8" InvisibleEdges = "5" />
                <Face Color = "clYellow " VertexIndexes = "11;8;7" InvisibleEdges = "5" />
                <Face Color = "clYellow " VertexIndexes = "11;7;6" InvisibleEdges = "5" />
                <Face Color = "clYellow " VertexIndexes = "11;6;5" InvisibleEdges = "5" />
                <Face Color = "clYellow " VertexIndexes = "11;5;9" InvisibleEdges = "5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn Axis = "a1" Layer = "1" Angle = "Pi" />
            <Turn Axis = "a2" Layer = "1" Angle = "Pi/2" />
            <SplitByAxes/>
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "Split" a1 = "0" a2 = "1" />
        <ExecMacro MacroName = "Split" a1 = "1" a2 = "2" />
        <ExecMacro MacroName = "Split" a1 = "2" a2 = "3" />
        <ExecMacro MacroName = "Split" a1 = "3" a2 = "4" />
        <ExecMacro MacroName = "Split" a1 = "4" a2 = "0" />
    </Figure>

    <Procedures CheckSolved = "EachPlaneHasOneColor" />
</xml>
