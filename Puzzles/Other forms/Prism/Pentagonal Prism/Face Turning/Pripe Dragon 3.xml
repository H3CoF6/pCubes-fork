<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pripe Dragon 3</Name>
        <Aliases>Prisma Pentagonal 3x3x3 Tipo Dragon</Aliases>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Pripe Dragon 3</Menu>
        <Inventor>César Gustavo Hernández Martínez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9000</Link>
    </Interface>

    <Script>
        Color := '700000';

        R := 0.6;
        for i := 0 to 4 do begin
            x[i] := R * sin(2*Pi/5 * i);
            y[i] := R * cos(2*Pi/5 * i);
        end;

        H := R * 0.7;

        D1 := H / 3;
        D2 :=-R * 0.45;

        DX := R * 0.05;
        DY := R * 0.10;
        DZ :=-R * 0.10;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D1; D1" NormVectors = "0; 0; 1" />

    <Axes TurningAngles = "Pi; 0" NormVectors = "x; y; 0" PlaneDistances = "D2" />

    <Figure>
        <Turn NormVector = "1;0;0" Angle = "0.1" />
        <Turn NormVector = "0;1;0" Angle = "0.2" />
        <Turn NormVector = "0;0;1" Angle = "0.1" />
        <Transfer Vector = "-DX;-DY;-DZ" />
        <Part>
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "x; y; H" />

            <Faces>
                <Face Color = "Color" VertexIndexes = "0;1;2;3;4" />
                <Face Color = "Color" VertexIndexes = "9;8;7;6;5" />
                <Face Color = "Color" VertexIndexes = "1;0; 5; 6" />
                <Face Color = "Color" VertexIndexes = "2;1; 6; 7" />
                <Face Color = "Color" VertexIndexes = "3;2; 7; 8" />
                <Face Color = "Color" VertexIndexes = "4;3; 8; 9" />
                <Face Color = "Color" VertexIndexes = "0;4; 9; 5" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Transfer Vector = " DX; DY; DZ" />
    </Figure>

    <Procedures CheckSolved = "CountUniquePlanes = 7" />
</xml>
