<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Pentagonal Prizm</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Pentagonal Master</Menu>
        <Inventor>Jack Tully</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-22</Added>
    </Interface>

   <Script>
      R := 0.65;
      H := R * sqrt((5 - sqrt(5)) / 2) / 2;
      Da := R * (sqrt(5) + 2) / 8; 

      for i := 0 to 4 do begin
         x[i] := R * cos(2 * Pi / 5 * i);
         y[i] := R * sin(2 * Pi / 5 * i);
      end;
   </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-Da" FixedLayers = "1" TurnAxesWithLayer = "1" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-H/2; 0; H/2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; H" />
                <Add Vector = "x[1]; y[1]; H" />
                <Add Vector = "x[2]; y[2]; H" />
                <Add Vector = "x[3]; y[3]; H" />
                <Add Vector = "x[4]; y[4]; H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
            </Vertices>
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "1;0;5;6" />
                <Face Color = "FF64FF" VertexIndexes = "2;1;6;7" />
                <Face Color = "FF6000" VertexIndexes = "3;2;7;8" />
                <Face Color = "00FF00" VertexIndexes = "4;3;8;9" />
                <Face Color = "FF0000" VertexIndexes = "0;4;9;5" />
                <Face Color = "646464" VertexIndexes = "9;8;7;6;5" />
                <Face Color = "C8C8C8" VertexIndexes = "0;1;2;3;4" />
            </Faces>
        </Part>
      
        <SplitByAxes/>

        <Turn Axis = "0" Angle = "Pi / 2" Layer = "0" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "0" Angle = "-Pi / 2" Layer = "0" />

        <Turn Axis = "1" Angle = "Pi / 2" Layer = "0" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "1" Angle = "-Pi / 2" Layer = "0" />

        <Turn Axis = "2" Angle = "Pi / 2" Layer = "0" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "2" Angle = "-Pi / 2" Layer = "0" />

        <Turn Axis = "3" Angle = "Pi / 2" Layer = "0" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "3" Angle = "-Pi / 2" Layer = "0" />

        <Turn Axis = "4" Angle = "Pi / 2" Layer = "0" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "4" Angle = "-Pi / 2" Layer = "0" />
    </Figure>
</xml>
