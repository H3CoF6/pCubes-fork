<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Floppy Pyraminx Crystal</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Floppy Pyraminx Crystal</Menu>
        <Inventor>Zijian Wang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7925</Link>
    </Interface>

    <Script>
        R := 0.7;
        H := R * 0.2;
        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />
            <Faces>
                <Face Color = "0044FF" VertexIndexes = "1;0;5;6" />
                <Face Color = "FF7700" VertexIndexes = "2;1;6;7" />
                <Face Color = "CC00DD" VertexIndexes = "3;2;7;8" />
                <Face Color = "00BB00" VertexIndexes = "4;3;8;9" />
                <Face Color = "FF0000" VertexIndexes = "0;4;9;5" />
                <Face Color = "FFFF00" VertexIndexes = "9;8;7;6;5" />
                <Face Color = "202020" VertexIndexes = "0;1;2;3;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
