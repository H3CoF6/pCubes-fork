<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Pentagonal Tiger</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Pentagonal Tiger</Menu>
        <Inventor>Jacob Duong-Tran</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2024-10-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=12043</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';

        R := 0.65;
        H := R * sqrt(30 - 6 * sqrt(5)) / 12;
        D := R * (sqrt(5) + 3) / 12;

        sAngle := 2*Pi / 5;
        for i := 0 to 4 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;
    </Script>

    <Axes TurningAngles = " Pi / 3; 0" PlaneDistances = "-D" NormVectors = " x; y; 0" />

    <Axes TurningAngles = "2*Pi / 5" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = " x; y;-H" />
            <Vertices Vectors = " x; y; H" />
            <Faces>
                <Face Color = "clRed   " VertexIndexes = "5;6;1;0" />
                <Face Color = "clBlue  " VertexIndexes = "6;7;2;1" />
                <Face Color = "clGreen " VertexIndexes = "7;8;3;2" />
                <Face Color = "clOrange" VertexIndexes = "8;9;4;3" />
                <Face Color = "clPurple" VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clWhite " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>

        <SplitByAxes/>
        
        <Macro Name = "Split" >
            <Turn  Axis = "a" Layer = "0" Angle = " Pi / 3" />
            <Split Axis = "5" From  = "1" />
            <Turn  Axis = "a" Layer = "0" Angle = " Pi / 3" />
            <Split Axis = "5" From  = "1" />
            <Undo  Repeat = "2" />
            <Script>inc(a);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" a = "0" Repeat = "5" />
    </Figure>
</xml>
