<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Floppy Pentagonal Super</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Face Turning\Floppy Pentagonal Super</Menu>
        <Inventor>Beni Issler</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-01-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6650</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';

        R := 0.65;

        s5 := sqrt(5);
        HS := R * sqrt((5 + s5) / 2) / 6;
        H := HS * (s5 - 1) / 2;
        RS := R * (1 + s5) / 6;

        sAngle := Pi * 2 / 5;
        for i := 0 to 4 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
            z[i] := 0;
            xs[i] := RS * sin(sAngle * i);
            ys[i] := RS * cos(sAngle * i);
        end;

        D := R * (s5 + 3) / 12;
    </Script>

    <Axes TurningAngles = "Pi/2; 0" NormVectors = " x; y; z" PlaneDistances = "-D" />

    <Figure>
        <Part>
            <Vertices Vectors = "  x;  y; -H" />
            <Vertices Vectors = "  x;  y;  H" />
            <Vertices Vectors = " xS; yS;-HS" />
            <Vertices Vectors = " xS; yS; HS" />

            <Faces>
                <Face Color = "clRed   " VertexIndexes = "5;6;1;0" />
                <Face Color = "clBlue  " VertexIndexes = "6;7;2;1" />
                <Face Color = "clGreen " VertexIndexes = "7;8;3;2" />
                <Face Color = "clOrange" VertexIndexes = "8;9;4;3" />
                <Face Color = "clPurple" VertexIndexes = "9;5;0;4" />

                <Face Color = "clYellow" VertexIndexes = "10;11;12;13;14" />
                <Face Color = "clYellow" VertexIndexes = "0;1;11;10" InvisibleEdges = "10" />
                <Face Color = "clYellow" VertexIndexes = "1;2;12;11" InvisibleEdges = "10" />
                <Face Color = "clYellow" VertexIndexes = "2;3;13;12" InvisibleEdges = "10" />
                <Face Color = "clYellow" VertexIndexes = "3;4;14;13" InvisibleEdges = "10" />
                <Face Color = "clYellow" VertexIndexes = "4;0;10;14" InvisibleEdges = "10" />

                <Face Color = "clWhite " VertexIndexes = "19;18;17;16;15" />
                <Face Color = "clWhite " VertexIndexes = "6;5;15;16" InvisibleEdges = "10" />
                <Face Color = "clWhite " VertexIndexes = "7;6;16;17" InvisibleEdges = "10" />
                <Face Color = "clWhite " VertexIndexes = "8;7;17;18" InvisibleEdges = "10" />
                <Face Color = "clWhite " VertexIndexes = "9;8;18;19" InvisibleEdges = "10" />
                <Face Color = "clWhite " VertexIndexes = "5;9;19;15" InvisibleEdges = "10" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
