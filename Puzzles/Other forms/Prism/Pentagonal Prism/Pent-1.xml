<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pent-1</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Pent-1</Menu>
        <Menu>Other forms\Square-1\Pent-1</Menu>
        <Inventor>Isaiah Tucker (TwistyTurtle)</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-04-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9862</Link>
    </Interface>

    <Script>
        Colors[0] := '0000A0'; // Blue
        Colors[1] := '800080'; // Violett
        Colors[2] := 'FF0000'; // Red
        Colors[3] := 'FF6000'; // Orange
        Colors[4] := '008000'; // Green
        Colors[5] := 'FFFF00'; // Yellow
        Colors[6] := 'FFFFFF'; // White

        R := 0.55;
        H := R * 0.8;
        D := H / 3;

        for i := 0 to 4 do begin
            x[i] := R * cos(2 * Pi / 5 * i);
            y[i] := R * sin(2 * Pi / 5 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = "4 * Pi / 5" />
        <Part>
            <Vertices Vectors = "x; y; H" /> 0..4
            <Vertices Vectors = "x; y;-H" /> 5..9
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 5; 6; 1; 0" />
                <Face Color = "Colors[1]" VertexIndexes = " 6; 7; 2; 1" />
                <Face Color = "Colors[2]" VertexIndexes = " 7; 8; 3; 2" />
                <Face Color = "Colors[3]" VertexIndexes = " 8; 9; 4; 3" />
                <Face Color = "Colors[4]" VertexIndexes = " 9; 5; 0; 4" />
                <Face Color = "Colors[5]" VertexIndexes = " 0; 1; 2; 3; 4" />
                <Face Color = "Colors[6]" VertexIndexes = " 9; 8; 7; 6; 5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "1" Layers = "1" Angle = "2 * Pi / 5" />
        <SplitByAxes/>
        <Turn Axis = "1" Layers = "1" Angle = "2 * Pi / 5" />
        <SplitByAxes/>
        <Turn Axis = "1" Layers = "1" Angle = "2 * Pi / 5" />
        <SplitByAxes/>
        <Turn Axis = "1" Layers = "1" Angle = "2 * Pi / 5" />
        <SplitByAxes/>
        <Turn Axis = "1" Layers = "1" Angle = "2 * Pi / 5" />
        <SplitByAxes/>
    </Figure>
</xml>
