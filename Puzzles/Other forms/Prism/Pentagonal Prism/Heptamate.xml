<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Heptamate</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Heptamate</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-12-30</Added>
    </Interface>

    <Script>
        R := 0.5;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';

        sAngle := Pi * 2 / 5;
        dAngle := sAngle / 4;
        for i := 0 to 4 do begin
            x[i] := R * sin(sAngle * i + dAngle);
            y[i] := R * cos(sAngle * i + dAngle);
        end;

        //H := -(x[0]*cx[3]+y[0]*cy[3])/cz[3];
        H := R * sqrt((5 - sqrt(5)) / 2);

    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "cx[0]; cy[0]; cz[0]" />
        <Axis NormVector = "cx[1]; cy[1]; cz[1]" />
        <Axis NormVector = "cx[2]; cy[2]; cz[2]" />
        <Axis NormVector = "cx[3]; cy[3]; cz[3]" />
        <Axis NormVector = "cx[4]; cy[4]; cz[4]" />
        <Axis NormVector = "cx[5]; cy[5]; cz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = "5;6;1;0" />
                <Face Color = "clBlue  " VertexIndexes = "6;7;2;1" />
                <Face Color = "clGreen " VertexIndexes = "7;8;3;2" />
                <Face Color = "clOrange" VertexIndexes = "8;9;4;3" />
                <Face Color = "clPurple" VertexIndexes = "9;5;0;4" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clWhite " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
