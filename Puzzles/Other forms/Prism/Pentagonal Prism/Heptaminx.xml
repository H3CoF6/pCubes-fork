<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Heptaminx</Name>
        <Menu>Other forms\Prism\Pentagonal Prism\Heptaminx</Menu>
        <Inventor>Andrew Frost</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-09-09</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4323</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';
        clPurple := clViolett;

        D  := R * 0.53;
        R2 := R * 0.9;
        H  := R * 0.71;

        DA := Pi / 10;
        for i := 0 to 4 do begin
            x[i] := R2 * sin(sAngle * i + DA);
            y[i] := R2 * cos(sAngle * i + DA);
        end;

        Colors[0] := clRed;
        Colors[1] := clBlue;
        Colors[2] := clGreen;
        Colors[3] := clOrange;
        Colors[4] := clViolett;

        clTop     := clWhite;
        clBottom  := clYellow;
    </Script>

    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D; D">
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "5;6;1;0" />
                <Face Color = "Colors[1]" VertexIndexes = "6;7;2;1" />
                <Face Color = "Colors[2]" VertexIndexes = "7;8;3;2" />
                <Face Color = "Colors[3]" VertexIndexes = "8;9;4;3" />
                <Face Color = "Colors[4]" VertexIndexes = "9;5;0;4" />
                <Face Color = "clBottom " VertexIndexes = "0;1;2;3;4" />
                <Face Color = "clTop    " VertexIndexes = "9;8;7;6;5" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
