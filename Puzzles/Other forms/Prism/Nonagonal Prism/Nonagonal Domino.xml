<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Nonagonal Domino</Name>
        <Menu>Other forms\Prism\Nonagonal Prism\Nonagonal Domino</Menu>
        <Inventor>Matt Bahner</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3676</Link>
    </Interface>

    <Script>
        clYellow  := 'FFFF00';
        clBlue    := '0000A0';
        clOrange  := 'FF6000';
        clRed     := 'FF0000';
        clCoral   := 'FF7F50';
        clWhite   := 'FFFFFF';
        clGreen   := '008000';
        clViolett := '800080';
        clCyan    := '00FFFF';
        clPink    := 'FF69B4';
        clLime    := '00FF00';

        R := 0.65;
        H := 0.5;

        for i := 0 to 8 do begin
            x[i] := R * cos(2 * Pi / 9 * i);
            y[i] := R * sin(2 * Pi / 9 * i);

            x[i] := R * cos(2 * Pi / 9 * (i+0.5));
            y[i] := R * sin(2 * Pi / 9 * (i+0.5));
            ax[i] := cos(2 * Pi / 9 * i);
            ay[i] := sin(2 * Pi / 9 * i);
        end;

        D := R * cos(pi /3) * cos(Pi / 9);
    </Script>

    <Axes TurningAngles = "2*Pi/9" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi; 0" PlaneDistances = "-D">
        <Axis NormVector = " ax[0]; ay[0]; 0" />
        <Axis NormVector = " ax[1]; ay[1]; 0" />
        <Axis NormVector = " ax[2]; ay[2]; 0" />
        <Axis NormVector = " ax[3]; ay[3]; 0" />
        <Axis NormVector = " ax[4]; ay[4]; 0" />
        <Axis NormVector = " ax[5]; ay[5]; 0" />
        <Axis NormVector = " ax[6]; ay[6]; 0" />
        <Axis NormVector = " ax[7]; ay[7]; 0" />
        <Axis NormVector = " ax[8]; ay[8]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
                <Add Vector = "x[6]; y[6];  H" />
                <Add Vector = "x[7]; y[7];  H" />
                <Add Vector = "x[8]; y[8];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
                <Add Vector = "x[6]; y[6]; -H" />
                <Add Vector = "x[7]; y[7]; -H" />
                <Add Vector = "x[8]; y[8]; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite  " VertexIndexes = "0;1;2;3;4;5;6;7;8" />
                <Face Color = "clGreen  " VertexIndexes = "9;10;1;0" />
                <Face Color = "clRed    " VertexIndexes = "10;11;2;1" />
                <Face Color = "clOrange " VertexIndexes = "11;12;3;2" />
                <Face Color = "clViolett" VertexIndexes = "12;13;4;3" />
                <Face Color = "clBlue   " VertexIndexes = "13;14;5;4" />
                <Face Color = "clCyan   " VertexIndexes = "14;15;6;5" />
                <Face Color = "clLime   " VertexIndexes = "15;16;7;6" />
                <Face Color = "clPink   " VertexIndexes = "16;17;8;7" />
                <Face Color = "clCoral  " VertexIndexes = "17; 9;0;8" />
                <Face Color = "clYellow " VertexIndexes = "17;16;15;14;13;12;11;10;9" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
