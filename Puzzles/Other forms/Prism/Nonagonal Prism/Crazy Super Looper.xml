<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy Super Looper</Name>
        <Menu>Other forms\2d\Looper\Crazy Super Looper</Menu>
        <Menu>Other forms\Prism\Nonagonal Prism\Crazy Super Looper</Menu>
        <Inventor>El Cubitero</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2023-08-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9420</Link>
    </Interface>

    <Script>
        clWhite   := 'FFFFFF';
        clRed     := 'FF0000';
        clOrange  := 'FF6000';
        clYellow  := 'FFFF00';
        clLime    := '00FF00';
        clDeepSky := '00BFFF';
        clPurple  := '8060B0';
        clBlack   := '333333';

        R := 0.65;
        H := 2 * R * sin(Pi / 18);
        A := 2 * Pi / 9;

        for i := 0 to 8 do begin
            x[i] := R * cos(A * (i+0.5));
            y[i] := R * sin(A * (i+0.5));
        end;
        for i := 0 to 3 do begin
            ax[i] :=-cos(A * (i + 1));
            ay[i] :=-sin(A * (i + 1));
        end;

        D1 := R * cos(2 * A);
        D2 := D1 * 3;

        Height := 0.001;

        // dots
        dr := 0.016;
        dx[0] := 0.72; dy[0] := 0;
        dx[1] := 0.68; dy[1] := 0.035;
        dx[2] := 0.68; dy[2] :=-0.035;
        dx[3] := 0.55; dy[3] := 0;
        dx[4] := 0.49; dy[4] := 0;
    </Script>

    <Axes TurningAngles = "0; Pi; Pi" PlaneDistances = "D1; D2" NormVectors = " ax; ay; 0" />

    <Figure>
        <Macro Name = "CreatePrism" >
            <HideAll/>
            <Part>
                <Vertices Vectors = "x; y; H" />
                <Vertices Vectors = "x; y;-H" />

                <Faces>
                    <Face Color = "Color" VertexIndexes = "0;1;2;3;4;5;6;7;8" />
                    <Face Color = "Color" VertexIndexes = " 9;10;1;0" />
                    <Face Color = "Color" VertexIndexes = "10;11;2;1" />
                    <Face Color = "Color" VertexIndexes = "11;12;3;2" />
                    <Face Color = "Color" VertexIndexes = "12;13;4;3" />
                    <Face Color = "Color" VertexIndexes = "13;14;5;4" />
                    <Face Color = "Color" VertexIndexes = "14;15;6;5" />
                    <Face Color = "Color" VertexIndexes = "15;16;7;6" />
                    <Face Color = "Color" VertexIndexes = "16;17;8;7" />
                    <Face Color = "Color" VertexIndexes = "17; 9;0;8" />
                    <Face Color = "Color" VertexIndexes = "17;16;15;14;13;12;11;10;9" />
                </Faces>
            </Part>
        </Macro>

        <Macro Name = "CreateSector" >
            <ExecMacro MacroName = "CreatePrism" />
            <Cut> <Plane NormVector = " x[4]; y[4]; 0" NormDistance = " D1" /> </Cut>
            <Cut> <Plane NormVector = " x[5]; y[5]; 0" NormDistance = " D1" /> </Cut>
            <Cut> <Plane NormVector = "-x[6];-y[6]; 0" NormDistance = "-D1" /> </Cut>
            <Turn NormVector = "0;0;1" Angle = "-A" />
        </Macro>

        <Macro Name = "Unbandage" >
            <Split> <Plane NormVector = " x[i]; y[i]; 0" NormDistance = " D1" /> </Split>
            <Split> <Plane NormVector = " x[i]; y[i]; 0" NormDistance = " D2" /> </Split>
            <Script>Inc(i);</Script>
        </Macro>

        <Macro Name = "Remove" >
            <Turn NormVector = "0;0;1" Angle = " A/2" />
            <RemoveContaining Vector = "Dis; 0; 0" />
            <Turn NormVector = "0;0;1" Angle = " Ang" />
            <RemoveContaining Vector = "Dis; 0; 0" />
            <Turn NormVector = "0;0;1" Angle = "-2*Ang" />
            <RemoveContaining Vector = "Dis; 0; 0" />
            <Turn NormVector = "0;0;1" Angle = " Ang" />
            <Turn NormVector = "0;0;1" Angle = "-A/2" />

            <Turn NormVector = "0;0;1" Angle = "-A" />
        </Macro>

        <ExecMacro MacroName = "CreateSector" Color = "clRed    " />
        <ExecMacro MacroName = "CreateSector" Color = "clOrange " />
        <ExecMacro MacroName = "CreateSector" Color = "clYellow " />
        <ExecMacro MacroName = "CreateSector" Color = "clLime   " />
        <ExecMacro MacroName = "CreateSector" Color = "clDeepSky" />
        <ExecMacro MacroName = "CreateSector" Color = "clPurple " />
        <Turn NormVector = "0;0;1" Angle = "A*6" />
        <ShowAll/>

        <ExecMacro MacroName = "Unbandage" i = "0" Repeat = "9" />
        <Hide Axis = "0" From = "1" />
        <Cut  Axis = "2" From = "1" />

        <ExecMacro MacroName = "CreatePrism" Color = "clWhite" />
        <ExecMacro MacroName = "Unbandage" i = "4" Repeat = "5" />
        <RemoveContaining Vector = "0;0;0" />
        <HideContaining Vector = " x[5]/R*D1; y[5]/R*D1; 0" />
        <HideContaining Vector = " x[6]/R*D1; y[6]/R*D1; 0" />
        <HideContaining Vector = " x[7]/R*D1; y[7]/R*D1; 0" />
        <RemoveAllVisible/>

        <ExecMacro MacroName = "CreatePrism" Color = "clBlack" />
        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut Axis = "2" To = "1" />
        <ShowAll/>

        <ExecMacro MacroName = "Remove" Dis = "-R * 0.55" Ang = "Pi/20" Repeat = "6" />
        <Turn NormVector = "0;0;1" Angle = "A * 6" />

        <Macro Name = "CreateDot" >
            <!-- <Cylinder Radius = "DR" Color = "clBlack" Base = "-dotX * R; -dotY * R; H" Top = "-dotX * R; -dotY * R; H + Height" TopColor = "clBlack" /> -->
            <Circle Radius = "DR * R" Color = "clBlack" Base = "-dotX * R; -dotY * R; H" Center = "-dotX * R; -dotY * R; H + Height" />
        </Macro>

        <Macro Name = "CreateDots" >
            <ExecMacro MacroName = "CreateDot" dotX = "dx[0]" dotY = "dy[0]" />
            <ExecMacro MacroName = "CreateDot" dotX = "dx[1]" dotY = "dy[1]" />
            <ExecMacro MacroName = "CreateDot" dotX = "dx[2]" dotY = "dy[2]" />
            <ExecMacro MacroName = "CreateDot" dotX = "dx[3]" dotY = "dy[3]" />
            <ExecMacro MacroName = "CreateDot" dotX = "dx[4]" dotY = "dy[4]" />
            <Turn NormVector = "0;0;1" Angle = "-A" />
        </Macro>

        <ExecMacro MacroName = "CreateDots" Repeat = "5" />
        <Turn NormVector = "0;0;1" Angle = "A * 5" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
