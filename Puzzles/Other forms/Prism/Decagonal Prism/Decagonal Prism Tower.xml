<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Decagonal Prism Tower</Name>
        <Menu>Other forms\Prism\Decagonal Prism\Decagonal Prism Tower</Menu>
        <Menu>Other forms\Multi-core\Decagonal Prism Tower</Menu>
        <Inventor>David Gugl</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7761</Link>
    </Interface>

    <Script>
        clTop     := 'AFAFAF'; // LightGray
        clBottom  := 'FFFFFF'; // White;
        Colors[0] := 'FF0000'; // Red;
        Colors[1] := 'FF6000'; // Orange;
        Colors[2] := 'FFFF00'; // Yellow;
        Colors[3] := '008000'; // Green;
        Colors[4] := '2828FF'; // LightBlue;
        Colors[5] := '0000A0'; // Blue;
        Colors[6] := '800080'; // Violett;
        Colors[7] := 'FF0080'; // LightViolett;
        Colors[8] := '00FF00'; // LightGreen;
        Colors[9] := '800000'; // Brown;

        R := 0.55;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        Ratio := (5-sqrt(5)) / 2;

        D := (R2Sin + RSin * Ratio) / (1 + Ratio);
        H := (RSin - D) * sqrt(5) / 2;

        DCut := (D + RSin) / 2;
        RCut := DCut * sqrt(Ratio);
        HCut := DCut/As - RCut * 2*cos(sAngle) / cos(sAngle / 4);
    </Script>

    <Axes TurningAngles = "0; sAngle" PlaneDistances = "D" >
        <Axis NormVector = "Cx[ 1]; Cy[ 1]; Cz[ 1]" BaseVector = "0; 0; h" />
        <Axis NormVector = "Cx[ 2]; Cy[ 2]; Cz[ 2]" BaseVector = "0; 0; h" />
        <Axis NormVector = "Cx[ 3]; Cy[ 3]; Cz[ 3]" BaseVector = "0; 0; h" />
        <Axis NormVector = "Cx[ 4]; Cy[ 4]; Cz[ 4]" BaseVector = "0; 0; h" />
        <Axis NormVector = "Cx[ 5]; Cy[ 5]; Cz[ 5]" BaseVector = "0; 0; h" />
        <Axis NormVector = "Cx[ 6]; Cy[ 6]; Cz[ 6]" BaseVector = "0; 0;-h" />
        <Axis NormVector = "Cx[ 7]; Cy[ 7]; Cz[ 7]" BaseVector = "0; 0;-h" />
        <Axis NormVector = "Cx[ 8]; Cy[ 8]; Cz[ 8]" BaseVector = "0; 0;-h" />
        <Axis NormVector = "Cx[ 9]; Cy[ 9]; Cz[ 9]" BaseVector = "0; 0;-h" />
        <Axis NormVector = "Cx[10]; Cy[10]; Cz[10]" BaseVector = "0; 0;-h" />
    </Axes>
    <Axes TurningAngles = "sAngle; 0; sAngle" PlaneDistances = "-D-H; D+H" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "1" Color = "-1" />

        <Macro Name = "MakeSide" >
            <Cut Color = "Colors[i]" > <Plane NormDistance = "-RCut" NormVector = "-sin((i+0.5)*Pi/5); -cos((i+0.5)*Pi/5); 0" /> </Cut>
            <Script> Inc(i); </Script>
        </Macro>
        <Cut Color = "clTop   " > <Plane NormDistance = "-HCut" NormVector = "0; 0; 1" /> </Cut>
        <Cut Color = "clBottom" > <Plane NormDistance = "-HCut" NormVector = "0; 0;-1" /> </Cut>
        <ExecMacro MacroName = "MakeSide" Repeat = "10" i = "0" />
        <SplitByAxes/>

        <Macro Name = "Split" >
            <Turn  Axis = "Ax" Layer = "1" Angle = "A * sAngle" />
            <Split Axis = "10" From  = "1" />
            <Split Axis = "10" From  = "2" />
            <Undo Repeat = "2" />
            <Script>Inc(Ax);</Script>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "10" Ax = "0" A = " 2" />
        <ExecMacro MacroName = "Split" Repeat = "10" Ax = "0" A = "-2" />
    </Figure>
</xml>
