<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Decagonal Pentultimate</Name>
        <Menu>Other forms\Prism\Decagonal Prism\Decagonal Pentultimate</Menu>
        <Inventor>Michael Beach</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-10-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9128</Link>
    </Interface>

    <Script>
        clTop     := 'AFAFAF'; // LightGray
        clBottom  := 'FFFFFF'; // White
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FF6000'; // Orange
        Colors[2] := 'FFFF00'; // Yellow
        Colors[3] := '008000'; // Green
        Colors[4] := '2828FF'; // LightBlue
        Colors[5] := '0000A0'; // Blue
        Colors[6] := '800080'; // Violett
        Colors[7] := 'FF0080'; // LightViolett
        Colors[8] := '00FF00'; // LightGreen
        Colors[9] := '800000'; // Brown

        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';
        H := R * 0.9;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
        <Axis NormVector = "Cx[4]; Cy[4]; Cz[4]" />
        <Axis NormVector = "Cx[5]; Cy[5]; Cz[5]" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\CubeMono.xml" Width = "2 * R" Color = "-1" />

        <Macro Name = "MakeSide" >
            <Cut Color = "Colors[i]" > <Plane NormDistance = "-R" NormVector = "-sin(2*Pi / 10 * i); -cos(2*Pi / 10 * i); 0" /> </Cut>
            <Script> Inc(i); </Script>
        </Macro>
        <Cut Color = "clTop   " > <Plane NormDistance = "-H" NormVector = " 0; 0; 1" /> </Cut>
        <Cut Color = "clBottom" > <Plane NormDistance = "-H" NormVector = " 0; 0;-1" /> </Cut>
        <ExecMacro MacroName = "MakeSide" Repeat = "10" i = "0" />
        <SplitByAxes/>
    </Figure>
</xml>
