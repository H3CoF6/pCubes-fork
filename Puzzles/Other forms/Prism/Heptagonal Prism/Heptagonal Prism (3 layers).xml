<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Heptagonal Prism (3 layers)</Name>
        <Menu>Other forms\Prism\Heptagonal Prism\Heptagonal Prism (3 layers)</Menu>
        <Inventor>Mark Segedin</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2627</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clPink   := 'FF69B4';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.6;

        H := R * sin(Pi / 7);
        sAngle := PI * 2 / 7;
        for i := 0 to 6 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D1 := R * (cos(Pi / 7) - 2 * sin(Pi / 7) / 3 * sin(2 * Pi / 7));
        D2 := H / 3;
    </Script>

    <Axes TurningAngles = "Pi; 0" PlaneDistances = "-D1" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[3]; y[3]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
        <Axis NormVector = "x[5]; y[5]; 0" />
        <Axis NormVector = "x[6]; y[6]; 0" />
    </Axes>

    <Axes TurningAngles = "2*Pi/7" PlaneDistances = "-D2; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
                <Add Vector = "x[6]; y[6]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
                <Add Vector = "x[6]; y[6];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 7; 8; 1; 0" />
                <Face Color = "clBlue  " VertexIndexes = " 8; 9; 2; 1" />
                <Face Color = "clGreen " VertexIndexes = " 9;10; 3; 2" />
                <Face Color = "clOrange" VertexIndexes = "10;11; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "11;12; 5; 4" />
                <Face Color = "clCyan  " VertexIndexes = "12;13; 6; 5" />
                <Face Color = "clPink  " VertexIndexes = "13; 7; 0; 6" />

                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4;5;6" />
                <Face Color = "clWhite " VertexIndexes = "13;12;11;10;9;8;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
