<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Heptagonal Floppy</Name>
        <Menu>Other forms\Prism\Heptagonal Prism\Heptagonal Floppy</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-07-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6791</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clPink   := 'FF69B4';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.6;

        H := R * sin(Pi / 7) / 3;
        sAngle := Pi * 2 / 7;
        for i := 0 to 6 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D1 := R * (cos(Pi / 7) - 2 * sin(Pi / 7) / 3 * sin(2 * Pi / 7));
        D2 := H / 3;
    </Script>

    <Axes TurningAngles = "Pi; 0" PlaneDistances = "-D1" NormVectors = "x; y; 0" />

    <Figure>
        <Part>
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "x; y; H" />
            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 7; 8; 1; 0" />
                <Face Color = "clBlue  " VertexIndexes = " 8; 9; 2; 1" />
                <Face Color = "clGreen " VertexIndexes = " 9;10; 3; 2" />
                <Face Color = "clOrange" VertexIndexes = "10;11; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "11;12; 5; 4" />
                <Face Color = "clCyan  " VertexIndexes = "12;13; 6; 5" />
                <Face Color = "clPink  " VertexIndexes = "13; 7; 0; 6" />

                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4;5;6" />
                <Face Color = "clWhite " VertexIndexes = "13;12;11;10;9;8;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
