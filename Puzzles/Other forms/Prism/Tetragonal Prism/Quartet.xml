<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Quartet</Name>
        <Menu>Other forms\Prism\Tetragonal Prism\Quartet</Menu>
        <Inventor>Orinzie Mitchell</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-03-22</Added>
    </Interface>

    <Script>
        W := 0.5;
        H := W * 0.5;
        D := W / sqrt(2);
    </Script>

    <Axes TurningAngles = " Pi; 0; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "Pi / 4" />
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "H" />

        <SplitByAxes/>
    </Figure>
</xml>
