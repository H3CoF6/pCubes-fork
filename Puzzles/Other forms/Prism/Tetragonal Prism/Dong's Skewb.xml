<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Dong's Skewb</Name>
        <Menu>Other forms\Prism\Tetragonal Prism\Dong's Skewb</Menu>
        <Menu>Other forms\Skewb variants\Prism\Dong's Skewb</Menu>
        <Inventor>Yong Xue Dong</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-11-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2169</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        s2 := sqrt(2);

        W1 := 0.5;
        w2 := W1 / s2;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "   1;     1; 2" />
        <Axis NormVector = "  -1;    -1; 2" />
        <Axis NormVector = "s2-1; -s2-1; 0" />
        <Axis NormVector = "s2+1; -s2+1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " -W1; -W1; -W1" />
                <Add Vector = " -W1; -W1;  W1" />
                <Add Vector = " -W2;  W2; -W1" />
                <Add Vector = " -W2;  W2;  W1" />
                <Add Vector = "  W2; -W2; -W1" />
                <Add Vector = "  W2; -W2;  W1" />
                <Add Vector = "  W1;  W1; -W1" />
                <Add Vector = "  W1;  W1;  W1" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
