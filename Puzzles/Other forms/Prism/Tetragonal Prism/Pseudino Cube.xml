<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pseudino Cube</Name>
        <Menu>Other forms\Prism\Tetragonal Prism\Pseudino Cube</Menu>
        <Menu>Other forms\Multi-core\Pseudino Cube</Menu>
        <Inventor>Daniel Bujno</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-06</Added>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        W1 := 0.45;
        W2 := 2 * W1;
        Wn := -W1;
        H := W1 * sqrt(2);
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 1; 0" BaseVector = "W1; 0; 0" />
        <Axis NormVector = "1;-1; 0" BaseVector = "W1; 0; 0" />
    </Axes>
    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "-1;-1; 0" BaseVector = "Wn; 0; 0" />
        <Axis NormVector = "-1; 1; 0" BaseVector = "Wn; 0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-W2; -W1;  0" />
                  <Add Vector = "  0; -W1;  H" />
                  <Add Vector = "-W2;  W1;  0" />
                  <Add Vector = "  0;  W1;  H" />
                  <Add Vector = "  0; -W1; -H" />
                  <Add Vector = " W2; -W1;  0" />
                  <Add Vector = "  0;  W1; -H" />
                  <Add Vector = " W2;  W1;  0" />
            </Vertices>

            <Faces>
                  <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                  <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                  <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                  <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                  <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                  <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <HideContaining Vector = " 0; 0; 0" />
        <Split> <Plane NormDistance = "0" NormVector = "0; 0; 1" /> </Split>
        <ShowAll/>
    </Figure>
</xml>
