<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pillarminx</Name>
        <Menu>Other forms\Prism\Tetragonal Prism\Pillarminx</Menu>
        <Inventor>Justin Eplett</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-10-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7025</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=33817</Link>
    </Interface>
	
    <Script>
        W := 0.25;
        H := W * 3 / sqrt(2); // W * 2.1
        D := W / sqrt(6);

        A := sqrt(2)/2;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D" >
        <Axis NormVector = " 1; 0; A" />
        <Axis NormVector = "-1; 0; A" />
        <Axis NormVector = " 0; 1;-A" />
        <Axis NormVector = " 0;-1;-A" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-W;-W;-H" />
                  <Add Vector = "-W;-W; H" />
                  <Add Vector = "-W; W;-H" />
                  <Add Vector = "-W; W; H" />
                  <Add Vector = " W;-W;-H" />
                  <Add Vector = " W;-W; H" />
                  <Add Vector = " W; W;-H" />
                  <Add Vector = " W; W; H" />
            </Vertices>
  
            <Faces>
                  <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                  <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                  <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                  <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                  <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                  <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
