    <Script>
        W := 0.55;
        D := W / 3;

        WX := W;
        WY := W;
        WZ := W / 3;

        s := sin(Pi/8);
        c := cos(Pi/8);
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = " c; s; 0" />
        <Axis NormVector = "-c; s; 0" />
        <Axis NormVector = " s; c; 0" />
        <Axis NormVector = "-s; c; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" />
        <SplitByAxes/>
    </Figure>
