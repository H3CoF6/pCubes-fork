<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triangular Prism Junior</Name>
        <Menu>Other forms\Prism\Triangular Prism\Triangular Prism Junior</Menu>
        <Menu>Other forms\2x2x2 variants\Triangular Prism Junior</Menu>
        <Inventor>Kyler van der Gaag</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2208</Link>
        <Added>2017-10-10</Added>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        R := 0.7;

        H := R * 0.7;
        sAngle := PI * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        da := sAngle / 4;
        for i := 0 to 2 do begin
            ax[i] := sin(sAngle * i - da);
            ay[i] := cos(sAngle * i - da);
        end;
        az := sqrt(2) / 2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" >
        <Axis NormVector = "ax[0]; ay[0]; az" />
        <Axis NormVector = "ax[1]; ay[1]; az" />
        <Axis NormVector = "ax[2]; ay[2]; az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "3;4;1;0" />
                <Face Color = "clRed   " VertexIndexes = "4;5;2;1" />
                <Face Color = "clGreen " VertexIndexes = "5;3;0;2" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2" />
                <Face Color = "clWhite " VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
