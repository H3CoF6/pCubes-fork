<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half A 3x3x3</Name>
        <Menu>Other forms\Prism\Triangular Prism\Half a 3x3x3</Menu>
        <Inventor>Mr. Slenkovich</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2018-09-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4829</Link>
    </Interface>
 
    <Script>
        clBlue      := '0000C8';
        clRed       := 'C80000';
        clYellow    := 'FFFF00';
        clWhite     := 'FFFFFF';
        clPayneGrey := '536878';
        W := 1 / 3;
        H := W * 3 / 2;
        D := W / 2;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -H" />
                <Add Vector = "-W; -W;  H" />
                <Add Vector = "-W;  2*W; -H" />
                <Add Vector = "-W;  2*W;  H" />
                <Add Vector = " 2*W; -W; -H" />
                <Add Vector = " 2*W; -W;  H" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue       " VertexIndexes = "1;0;4;5" />
                <Face Color = "clRed        " VertexIndexes = "0;1;3;2" />
                <Face Color = "clYellow     " VertexIndexes = "0;2;4" />
                <Face Color = "clWhite      " VertexIndexes = "3;1;5" />
                <Face Color = "clPayneGrey  " VertexIndexes = "2;3;5;4" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Split><Plane NormDistance = "W" NormVector = "1; 0; 0" /></Split>
        <Split><Plane NormDistance = "W" NormVector = "0; 1; 0" /></Split>
    </Figure>
</xml>
