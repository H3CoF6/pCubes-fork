<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triaprism 3</Name>
        <Menu>Other forms\Prism\Triangular Prism\Triaprism 3</Menu>
        <Menu>Other forms\3x3x3 variants\Prism\Triaprism 3</Menu>
        <Inventor>César Gustavo Hernández Martínez</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9537</Link>
    </Interface>

    <Script>
        R := 0.6;
        D := R * 0.17;
        H := D * sqrt(3) + R * sqrt(2) / 4;

        for i := 0 to 2 do begin
            x[i] := R * cos(2 * Pi / 3 * i);
            y[i] := R * sin(2 * Pi / 3 * i);
        end;
        az := R / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" NormVectors = "x; y; -az" />

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "007900" VertexIndexes = " 1; 0; 3; 4" />
                <Face Color = "1414BF" VertexIndexes = " 2; 1; 4; 5" />
                <Face Color = "C80000" VertexIndexes = " 0; 2; 5; 3" />

                <Face Color = "FFFF00" VertexIndexes = "5;4;3" />
                <Face Color = "CCCCCC" VertexIndexes = "0;1;2" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
