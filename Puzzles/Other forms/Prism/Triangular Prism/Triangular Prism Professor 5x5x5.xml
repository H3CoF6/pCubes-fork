<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >
    <Interface>
        <Name>Triangular Prism Professor 5x5x5</Name>
        <Menu>Other forms\Prism\Triangular Prism\Triangular Prism Professor 5x5x5</Menu>
        <Inventor>Minh Thang Vo</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-05-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2246</Link>
    </Interface>

    <Script>
        clBlue    := '0000C8';
        clGreen   := '009600';
        clRed     := 'C80000';
        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        R := 0.7;

        H := R * 0.6;
        sAngle := PI * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        da := sAngle / 4;
        for i := 0 to 2 do begin
            ax[i] := sin(sAngle * i + da);
            ay[i] := cos(sAngle * i + da);
        end;
        az := sqrt(2) / 2;

        D1 := R * 0.085;
        D2 := 3 * D1;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1; -D2; D2; D1" >
        <Axis NormVector = "ax[0]; ay[0]; az" />
        <Axis NormVector = "ax[1]; ay[1]; az" />
        <Axis NormVector = "ax[2]; ay[2]; az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[0]; y[0]; H" />
                <Add Vector = "x[1]; y[1]; H" />
                <Add Vector = "x[2]; y[2]; H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = "3;4;1;0" />
                <Face Color = "clBlue  " VertexIndexes = "4;5;2;1" />
                <Face Color = "clGreen " VertexIndexes = "5;3;0;2" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2" />
                <Face Color = "clWhite " VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
