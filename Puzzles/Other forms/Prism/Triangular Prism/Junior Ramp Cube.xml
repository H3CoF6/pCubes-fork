<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Junior Ramp Cube</Name>
        <Menu>Other forms\2x2x2 variants\Junior Ramp Cube</Menu>
        <Menu>Other forms\Prism\Triangular Prism\Junior Ramp Cube</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4449</Link>
    </Interface>

    <Script>
        clWhite  := 'FFFFFF';
        clRed    := 'CF0000';
        clBlue   := '0077FF';
        clPink   := 'FF4488';
        clGreen  := '007700';

        W1 := 0.3;
        W2 := W1 * 3;
        H :=  W1;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W1;-W1;-H" />
                <Add Vector = " W2;-W1;-H" />
                <Add Vector = "-W1; W2;-H" />
                <Add Vector = "-W1;-W1; H" />
                <Add Vector = " W2;-W1; H" />
                <Add Vector = "-W1; W2; H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite" VertexIndexes = "2;1;0" />
                <Face Color = "clRed  " VertexIndexes = "3;4;5" />
                <Face Color = "clBlue " VertexIndexes = "0;1;4;3" />
                <Face Color = "clPink " VertexIndexes = "1;2;5;4" />
                <Face Color = "clGreen" VertexIndexes = "2;0;3;5" />
            </Faces>
        </Part>

        <SplitByAxes />
    </Figure>
</xml>
