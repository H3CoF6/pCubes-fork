<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Prism Z</Name>
        <Menu>Other forms\Prism\Triangular Prism\Prism Z</Menu>
        <Inventor>limCube</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-08-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9040</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=37067</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        R := 0.6;

        sAngle := Pi * 2 / 3;

        for i := 0 to 2 do begin
            x[i] := R * cos(sAngle * i);
            y[i] := R * sin(sAngle * i);
        end;
        az := R * sqrt(2) / 4;

        H := 2 * az;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" TurnAxesWithLayer = "0" > <!-- White center is a core -->
        <Axis NormVector = "   0;    0; -1" />
        <Axis NormVector = "x[0]; y[0]; az" />
        <Axis NormVector = "x[1]; y[1]; az" />
        <Axis NormVector = "x[2]; y[2]; az" />
        <Axis NormVector = "x[0]; y[0]; -H" />
        <Axis NormVector = "x[1]; y[1]; -H" />
        <Axis NormVector = "x[2]; y[2]; -H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "x; y; H" />
            <Faces>
                <Face Color = "clRed   " VertexIndexes = "0;1;4;3" />
                <Face Color = "clBlue  " VertexIndexes = "1;2;5;4" />
                <Face Color = "clGreen " VertexIndexes = "2;0;3;5" />
                <Face Color = "clYellow" VertexIndexes = "2;1;0" />
                <Face Color = "clWhite " VertexIndexes = "3;4;5" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3"/>

        <SplitByAxes/>
        <Undo/>
    </Figure>
</xml>
