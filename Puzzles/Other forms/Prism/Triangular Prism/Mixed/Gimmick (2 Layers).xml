<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Gimmick (2 Layers)</Name>
        <Menu>Other forms\Prism\Triangular Prism\Mixed\Gimmick (2 Layers)</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4256</Link>
    </Interface>

    <Script>
        Colors[0] := 'EDFF11'; // clYellow
        Colors[1] := 'EE0000'; // clRed
        Colors[2] := '00CC00'; // clGreen
        Colors[3] := '0088EE'; // clBlue
        Colors[4] := 'FFFFFF'; // clWhite

        R := 0.7;
        sAngle := Pi * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D := R / 2;
        H := R / sqrt(3);
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "0;Pi" PlaneDistances = "D" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "x; y; H" />
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;2" />
                <Face Color = "Colors[1]" VertexIndexes = "2;5;3;0" />
                <Face Color = "Colors[2]" VertexIndexes = "0;3;4;1" />
                <Face Color = "Colors[3]" VertexIndexes = "1;4;5;2" />
                <Face Color = "Colors[4]" VertexIndexes = "4;3;5" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
