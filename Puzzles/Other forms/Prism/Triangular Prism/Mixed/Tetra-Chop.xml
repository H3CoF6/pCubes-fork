<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetra-Chop</Name>
        <Menu>Other forms\Prism\Triangular Prism\Mixed\Tetra-Chop</Menu>
        <Inventor>Reiden Chea</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5741</Link>
        <Added>2017-01-03</Added>
    </Interface>

    <Script>
        clBlue    := '0000C8';
        clGreen   := '009600';
        clRed     := 'C80000';
        clOrange  := 'FF800A';
        clViolett := '7700CD';
        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        R := 0.65;

        H := R * sqrt(3);
        sAngle := PI * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

//        D := R / 2 / sqrt(7);

    </Script>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "y[0]; x[0]; 0" />
        <Axis NormVector = "y[1]; x[1]; 0" />
        <Axis NormVector = "y[2]; x[2]; 0" />
    </Axes>

<!--    <Axes TurningAngles = "Pi" PlaneDistances = "D" >
        <Axis NormVector = "x[0]; y[0]; R * sqrt(3) / 2" />
        <Axis NormVector = "x[1]; y[1]; R * sqrt(3) / 2" />
        <Axis NormVector = "x[2]; y[2]; R * sqrt(3) / 2" />
    </Axes>-->

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H / 2" />
                <Add Vector = "x[1]; y[1]; -H / 2" />
                <Add Vector = "x[2]; y[2]; -H / 2" />
                <Add Vector = "x[0]; y[0]; H / 2" />
                <Add Vector = "x[1]; y[1]; H / 2" />
                <Add Vector = "x[2]; y[2]; H / 2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed"     VertexIndexes = "3;4;1;0" />
                <Face Color = "clBlue"    VertexIndexes = "4;5;2;1" />
                <Face Color = "clGreen"   VertexIndexes = "5;3;0;2" />
                <Face Color = "clYellow"  VertexIndexes = "0;1;2" />
                <Face Color = "clWhite"   VertexIndexes = "5;4;3" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
