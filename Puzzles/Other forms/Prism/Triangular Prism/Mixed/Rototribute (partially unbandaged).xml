    <Script>
        clBlue    := '0000C8';
        clGreen   := '009600';
        clRed     := 'C80000';
        clOrange  := 'FF800A';
        clViolett := '7700CD';
        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        cl[0] := clViolett; // top and bottom
        cl[1] := clGreen;

        cl[2] := clRed; // sides
        cl[3] := clYellow;
        cl[4] := clOrange;

        R := 0.5;
        H := R * sqrt(3) / 2;
        sAngle := Pi * 2 / 3;

        cd := 10;
        dAngle := Pi / 3 / cd;
        bz := R * sqrt(3);

        for i := 0 to 2 do begin
            ax[i] := R * cos(sAngle * i);
            ay[i] := R * sin(sAngle * i);
            for j := 0 to cd do begin
                vx[i,j] :=  ax[i]/2 - R*3/2 * cos(sAngle * i + dAngle * j);
                vy[i,j] := -ay[i]/2 + R*3/2 * sin(sAngle * i + dAngle * j);
            end;
        end;

        D := R / 2;
        JAngle := Arctan(1/2)*2;
    </Script>

    <Axes TurningAngles = "Pi" AvailableAngles = "-JAngle; 0; JAngle; Pi/2; Pi-JAngle; Pi; Pi+JAngle; Pi*3/2;" PlaneDistances = "D" TurnAxesWithLayer = "0">
