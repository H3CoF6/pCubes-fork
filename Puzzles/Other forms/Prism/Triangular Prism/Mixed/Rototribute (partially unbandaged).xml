        <Axis NormVector = " ax[1];  ay[1];   0"/>
        <Axis NormVector = " ax[2];  ay[2];   0"/>
        <Axis NormVector = "-ax[0]; -ay[0]; -bz"/>
        <Axis NormVector = "-ax[1]; -ay[1]; -bz"/>
        <Axis NormVector = "-ax[2]; -ay[2]; -bz"/>
        <Axis NormVector = "-ax[0]; -ay[0];  bz"/>
        <Axis NormVector = "-ax[1]; -ay[1];  bz"/>
        <Axis NormVector = "-ax[2]; -ay[2];  bz"/>
    </Axes>

