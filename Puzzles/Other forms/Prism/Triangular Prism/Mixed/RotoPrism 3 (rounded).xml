    <Interface>
        <Name>RotoPrism 3 (rounded)</Name>
        <Menu>Other forms\Prism\Triangular Prism\Mixed\RotoPrism 3 (rounded)</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-08-31</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2980</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clBlue1        := '0000A1';
        clRed          := 'FF0000';
        clRed1         := 'FF0001';
        clGreen        := '008000';
        clGreen1       := '008001';
        clWhite        := 'FFFFFF';

        cl[0] := clYellow; // top and bottom
        cl[1] := clWhite;

        cl[2] := clGreen; // sides
        cl[3] := clRed;
        cl[4] := clBlue;

        H := 0.5;
        sAngle := PI * 2 / 3;

        cd := 8;
        dAngle := Pi / 3 / cd;

        for i := 0 to 2 do begin
            ax[i] := cos(sAngle * i);
            ay[i] := sin(sAngle * i);

            ox := H/2 * sin(sAngle*i + Pi/3);
            oy := H/2 * cos(sAngle*i + Pi/3);
            for j := 0 to cd do begin
                x[i,j] := ox - H * sqrt(3)/2 * cos(sAngle*i + Pi/3 + dAngle*j);
                y[i,j] := oy + H * sqrt(3)/2 * sin(sAngle*i + Pi/3 + dAngle*j);
            end;
        end;

    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
    </Axes>

