<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>RotoPrism 3</Name>
        <Menu>Other forms\Prism\Triangular Prism\Mixed\RotoPrism 3</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-12-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2979</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clBlue1        := '0000A1';
        clRed          := 'FF0000';
        clRed1         := 'FF0001';
        clGreen        := '008000';
        clGreen1       := '008001';
        clWhite        := 'FFFFFF';

        H := 0.5;
        sAngle := PI * 2 / 3;

        for i := 0 to 2 do begin
            ax[i] := cos(sAngle * i);
            ay[i] := sin(sAngle * i);

            X[i * 2] := H * (sin(sAngle * (i-1)) + cos(sAngle * (i-1)) * sqrt(3) / 2);
            Y[i * 2] := H * (cos(sAngle *  (i-1)) - sin(sAngle * (i-1)) * sqrt(3) / 2);

            X[i * 2 + 1] := H * sin(sAngle * i);
            Y[i * 2 + 1] := H * cos(sAngle * i);
        end;

    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />

                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "5;4;3;2;1;0" />
                <Face Color = "clGreen " VertexIndexes = "0;1;7;6" />
                <Face Color = "clGreen1" VertexIndexes = "1;2;8;7" />
                <Face Color = "clRed   " VertexIndexes = "2;3;9;8" />
                <Face Color = "clRed1  " VertexIndexes = "3;4;10;9" />
                <Face Color = "clBlue  " VertexIndexes = "4;5;11;10" />
                <Face Color = "clBlue1 " VertexIndexes = "5;0;6;11" />
                <Face Color = "clYellow" VertexIndexes = "6;7;8;9;10;11" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <Turn Angle = " Pi    " Axis = "0" Layer = "0" />
        <Turn Angle = " Pi / 2" Axis = "1" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-Pi / 2" Axis = "1" Layer = "1" />
        <Turn Angle = "-Pi    " Axis = "0" Layer = "0" />

        <Turn Angle = " Pi    " Axis = "1" Layer = "0" />
        <Turn Angle = " Pi / 2" Axis = "2" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-Pi / 2" Axis = "2" Layer = "1" />
        <Turn Angle = "-Pi    " Axis = "1" Layer = "0" />

        <Turn Angle = " Pi    " Axis = "2" Layer = "0" />
        <Turn Angle = " Pi / 2" Axis = "0" Layer = "1" />
        <SplitByAxes/>
        <Turn Angle = "-Pi / 2" Axis = "0" Layer = "1" />
        <Turn Angle = "-Pi    " Axis = "2" Layer = "0" />

    </Figure>
</xml>
