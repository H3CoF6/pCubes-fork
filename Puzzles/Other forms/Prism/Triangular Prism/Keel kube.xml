<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Keel kube</Name>
        <Menu>Other forms\Prism\Triangular Prism\Keel kube</Menu>
        <Menu>Other forms\3x3x3 variants\Prism\Keel kube</Menu>
        <Inventor>José Romero</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-07-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8939</Link>
    </Interface>

    <Script>
        R := 0.56;
        H1 := R * 0.9;
        H2 := R * 0.6;
        D := R * 0.25;

        for i := 0 to 2 do begin
            x[i] := R * cos(2 * Pi / 3 * i);
            y[i] := R * sin(2 * Pi / 3 * i);
        end;

        az := R / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" NormVectors = "x; y; az" />

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H1" />
            <Vertices Vectors = "x; y;-H2" />

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = " 1; 0; 3; 4" />
                <Face Color = "FF64FF" VertexIndexes = " 2; 1; 4; 5" />
                <Face Color = "FF6000" VertexIndexes = " 0; 2; 5; 3" />

                <Face Color = "646464" VertexIndexes = "5;4;3" />
                <Face Color = "C8C8C8" VertexIndexes = "0;1;2" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
