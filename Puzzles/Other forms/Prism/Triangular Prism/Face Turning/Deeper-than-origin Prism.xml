<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Deeper-than-origin Prism</Name>
        <Menu>Other forms\Prism\Triangular Prism\Face Turning\Deeper-than-origin Prism</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2020-02-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7211</Link>
    </Interface>

    <Script>
        clYellow := 'EDFF11';
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clOrange := 'FF9600';

        R := 0.7;
        H := R * 0.9;

        sAngle := Pi * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D1 := H / 3;
        D2 := R / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D2" TurnAxesWithLayer = "1" >
        <Axis NormVector = "x[1]; y[1]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "x; y; H" />
            <Faces>
                <Face Color = "clOrange" VertexIndexes = "0;1;2" />
                <Face Color = "clRed   " VertexIndexes = "4;3;5" />
                <Face Color = "clYellow" VertexIndexes = "0;3;4;1" />
                <Face Color = "clGreen " VertexIndexes = "1;4;5;2" />
                <Face Color = "clBlue  " VertexIndexes = "2;5;3;0" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <HideContaining Vector = " 0; 0;-H" />
        <Split><Plane NormDistance = " D1" NormVector = "   0;    0; 1" /></Split>
        <Split><Plane NormDistance = "-D2" NormVector = "x[0]; y[0]; 0" /></Split>
        <Split><Plane NormDistance = "-D2" NormVector = "x[2]; y[2]; 0" /></Split>
        <ShowAll/>
    </Figure>
</xml>
