<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentahedron Standard 5-Layers</Name>
        <Menu>Other forms\Prism\Triangular Prism\Face Turning\Pentahedron Standard 5-Layers</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-09-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3739</Link>
    </Interface>

    <Script>
        clYellow  := 'EDFF11';
        clBlue    := '5050FF';
        clOrange  := 'FF5C00';
        clViolett := '7700CD';
        clWhite   := 'FFFFFF';

        H := 0.5;
        R := H * 2 / sqrt(3);

        for i := 0 to 2 do begin
            Vx[i] := R * cos(2*Pi * i / 3);
            Vy[i] := R * sin(2*Pi * i / 3);
        end;

        D1 := H / 3;
        D2 := H * 0.85;

    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D1; -D2; D2; D1" TurnAxesWithLayer = "2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "2" >
        <Axis NormVector = " Vx[0]; Vy[0]; 0" />
        <Axis NormVector = " Vx[1]; Vy[1]; 0" />
        <Axis NormVector = " Vx[2]; Vy[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0];  H" />
                <Add Vector = "Vx[1]; Vy[1];  H" />
                <Add Vector = "Vx[2]; Vy[2];  H" />
                <Add Vector = "Vx[0]; Vy[0]; -H" />
                <Add Vector = "Vx[1]; Vy[1]; -H" />
                <Add Vector = "Vx[2]; Vy[2]; -H" />
            </Vertices>
            <Faces>
                <Face Color = "clViolett" VertexIndexes = "0;1;2" />
                <Face Color = "clYellow"  VertexIndexes = "4;3;5" />
                <Face Color = "clBlue"    VertexIndexes = "0;3;4;1" />
                <Face Color = "clOrange"  VertexIndexes = "1;4;5;2" />
                <Face Color = "clWhite"   VertexIndexes = "2;5;3;0" />
            </Faces>
        </Part>

        <SplitByAxes/>

    </Figure>

</xml>
