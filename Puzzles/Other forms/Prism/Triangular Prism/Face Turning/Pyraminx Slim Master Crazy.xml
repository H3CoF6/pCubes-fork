<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pyraminx Slim Master Crazy</Name>
        <Menu>Other forms\Prism\Triangular Prism\Face Turning\Pyraminx Slim Master Crazy</Menu>
        <Inventor>Zsolt Árpád Papp</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2019-11-21</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7720</Link>
    </Interface>

    <Script>
        clYellow := 'EDFF11';
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clWhite  := 'FFFFFF';

        R := 0.7;
        sAngle := Pi * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        RC := R * 0.38;
        delta := 0.001;
    	H := R * 3/16;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-1/8 * R; 1/4 * R; 5/8 * R" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
    </Axes>
    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-H; H" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clWhite " VertexIndexes = "0;1;2" />
                <Face Color = "clYellow" VertexIndexes = "4;3;5" />
                <Face Color = "clGreen " VertexIndexes = "0;3;4;1" />
                <Face Color = "clBlue  " VertexIndexes = "1;4;5;2" />
                <Face Color = "clRed   " VertexIndexes = "2;5;3;0" />
            </Faces>
        </Part>

        <Circle Radius = "RC" Color = "clYellow"  Center = "0; 0;  H + delta" />
        <Circle Radius = "RC" Color = "clWhite"   Center = "0; 0; -H - delta" />

        <Connect Axis = "3" Layers = "0;2" />
        <SplitByAxes/>
    </Figure>
</xml>
