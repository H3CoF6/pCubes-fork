<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Prizmix Baby</Name>
        <Menu>Other forms\Prism\Triangular Prism\Face Turning\Prizmix Baby</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-25</Added>
        <Link>http://tonyfisherpuzzles.net/009%20Triangular%20Prism%20(%20Rubik%20type%20puzzle%20).html</Link>
    </Interface>

    <Script>
        clYellow := 'EDFF11';
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clWhite  := 'FFFFFF';

        R := 0.7;
        sAngle := Pi * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D := R / 4;
        H := R * sqrt(3)/2;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "D" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[1]; y[1]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clWhite " VertexIndexes = "0;1;2" />
                <Face Color = "clYellow" VertexIndexes = "4;3;5" />
                <Face Color = "clGreen " VertexIndexes = "0;3;4;1" />
                <Face Color = "clBlue  " VertexIndexes = "1;4;5;2" />
                <Face Color = "clRed   " VertexIndexes = "2;5;3;0" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
