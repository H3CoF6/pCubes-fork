<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Professor TriFlop</Name>
        <Menu>Other forms\Prism\Triangular Prism\Face Turning\Professor TriFlop</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-08-02</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7265</Link>
    </Interface>

    <Script>
        clYellow := 'EDFF11';
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clWhite  := 'FFFFFF';

        R := 0.7;
        sAngle := Pi * 2 / 3;
        for i := 0 to 2 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;

        D1 := R * 0.1;
        D2 := R * 0.3;
        H := R / 4;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D1;-D2" NormVectors = " x; y; 0" />

    <Figure>
        <Part>
            <Vertices Vectors = " x; y;-H" />
            <Vertices Vectors = " x; y; H" />
            <Faces>
                <Face Color = "clWhite " VertexIndexes = "0;1;2" />
                <Face Color = "clYellow" VertexIndexes = "4;3;5" />
                <Face Color = "clGreen " VertexIndexes = "0;3;4;1" />
                <Face Color = "clBlue  " VertexIndexes = "1;4;5;2" />
                <Face Color = "clRed   " VertexIndexes = "2;5;3;0" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
