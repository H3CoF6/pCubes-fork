<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triangular Prism</Name>
        <Aliases>Standard 3-Layers Pentahedron Puzzle</Aliases>
        <Menu>Other forms\Prism\Triangular Prism\Face Turning\Triangular Prism</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-11-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=465</Link>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3738</Link>
    </Interface>

    <Script>
        clYellow  := 'EDFF11';
        clBlue    := '5050FF';
        clOrange  := 'FF5C00';
        clViolett := '7700CD';
        clWhite   := 'FFFFFF';

        Y := sqrt(3) / 4;
        K := 2 / sqrt(3);
        L := -0.07;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "L" >
        <Axis NormVector = "   1;            0; 0" />
        <Axis NormVector = "-0.5;  sqrt(3) / 2; 0" />
        <Axis NormVector = "-0.5; -sqrt(3) / 2; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-0.25 * K;  Y * K; 0.5" />
                <Add Vector = "-0.25 * K; -Y * K; 0.5" />
                <Add Vector = " 0.5  * K; 0; 0.5" />
                <Add Vector = "-0.25 * K;  Y * K; -0.5" />
                <Add Vector = "-0.25 * K; -Y * K; -0.5" />
                <Add Vector = " 0.5  * K; 0; -0.5" />
            </Vertices>
            <Faces>
                <Face Color = "clViolett" VertexIndexes = "0;1;2" />
                <Face Color = "clYellow"  VertexIndexes = "4;3;5" />
                <Face Color = "clOrange"  VertexIndexes = "0;3;4;1" />
                <Face Color = "clWhite"   VertexIndexes = "1;4;5;2" />
                <Face Color = "clBlue"    VertexIndexes = "2;5;3;0" />
            </Faces>
        </Part>

        <SplitByAxes/>

    </Figure>
</xml>
