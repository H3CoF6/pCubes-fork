<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Half-Cube 2x2x2</Name>
        <Menu>Other forms\Prism\Triangular Prism\Half-Cube 2x2x2</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-13</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6679</Link>
    </Interface>

    <Script>
        clGreen  := '00AA00';
        clYellow := 'FFFF00';
        clBlue   := '0033EE';
        clRed    := 'FF0000';
        clOrange := 'FF800A';

        W1 := 0.3;
        W2 := W1 * 3;
        H :=  W1 * 1.2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W1;-W1;-H" />
                <Add Vector = " W2;-W1;-H" />
                <Add Vector = "-W1; W2;-H" />
                <Add Vector = "-W1;-W1; H" />
                <Add Vector = " W2;-W1; H" />
                <Add Vector = "-W1; W2; H" />
            </Vertices>

            <Faces>
                <Face Color = "clGreen " VertexIndexes = "2;1;0" />
                <Face Color = "clBlue  " VertexIndexes = "3;4;5" />
                <Face Color = "clRed   " VertexIndexes = "0;1;4;3" />
                <Face Color = "clYellow" VertexIndexes = "1;2;5;4" />
                <Face Color = "clOrange" VertexIndexes = "2;0;3;5" />
            </Faces>
        </Part>

        <SplitByAxes />
        <Turn Axis = "0" Layer = "0" Angle = "Pi/2" />
        <Split Axis = "1" From = "1"/>
        <Undo/>
        <Turn Axis = "1" Layer = "0" Angle = "Pi/2" />
        <Split Axis = "0" From = "1"/>
        <Undo/>
    </Figure>
</xml>
