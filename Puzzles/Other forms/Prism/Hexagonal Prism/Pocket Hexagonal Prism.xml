<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pocket Hexagonal Prism</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Pocket Hexagonal Prism</Menu>
        <Inventor>Haavizhag Havok</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9114</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF64FF';
        Colors[1] := 'FF6000';
        Colors[2] := '00FF00';
        Colors[3] := '0064FF';
        Colors[4] := 'FF0000';
        Colors[5] := 'FFFF00';
        Colors[6] := '646464';
        Colors[7] := 'C8C8C8';

        R := 0.56;
        H := R * 0.935;

        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;

        for i := 0 to 2 do begin
            ax[i] := cos(2 * Pi / 3 * i);
            ay[i] := sin(2 * Pi / 3 * i);
        end;
        az := 1 / sqrt(2);

        D := R * 0.2;

        DX :=-D * sqrt(8/3);
        DY := 0;
        DZ := R * 0.11;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "-ax[0];-ay[0];-az" />
        <Axis NormVector = " ax[1]; ay[1]; az" />
        <Axis NormVector = " ax[2]; ay[2]; az" />
    </Axes>

    <Figure>
        <Transfer Vector = " DX; DY; DZ" />

        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "Colors[1]" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "Colors[2]" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "Colors[3]" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "Colors[4]" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "Colors[5]" VertexIndexes = " 0; 5;11; 6" />
                <Face Color = "Colors[6]" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "Colors[7]" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>

        <Transfer Vector = "-DX;-DY;-DZ" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />

        <Hide Axis = "0" To = "1" />
        <Hide Axis = "1" To = "1" />
        <Hide Axis = "2" To = "1" />
        <SplitByAxes/>
        <ShowAll/>
        <Turn NormVector = "0;0;1" Angle = "2*Pi/3" />
    </Figure>
</xml>
