<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexed Mixup</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Mixed\Hexed Mixup</Menu>
        <Inventor>Oskar Van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2607</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPale   := 'D07090';
        clPurple := '800080';

        R := 0.55;
        H := R * cos(Pi / 6);
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi/3 * (i + 0.5));
            y[i] := R * sin(Pi/3 * (i + 0.5));
        end;
        for i := 0 to 2 do begin
            ax[i] := cos(2*Pi/3 * i);
            ay[i] := sin(2*Pi/3 * i);
        end;
        D := R * sqrt(3) / 7;
    </Script>

    <Axes TurningAngles = "Pi; Pi/2; Pi" PlaneDistances = "-D; D" >
        <Axis NormVector = "Ay[0]; Ax[0]; 0" />
        <Axis NormVector = "Ay[1]; Ax[1]; 0" />
        <Axis NormVector = "Ay[2]; Ax[2]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
            </Vertices>
            <Faces>
                <Face Color = "clYellow" VertexIndexes = "5;4;10;11" />
                <Face Color = "clBlue  " VertexIndexes = "0;5;11;6" />
                <Face Color = "clPurple" VertexIndexes = "1;0;6;7" />
                <Face Color = "clPale  " VertexIndexes = "2;1;7;8" />
                <Face Color = "clWhite " VertexIndexes = "3;2;8;9" />
                <Face Color = "clGreen " VertexIndexes = "4;3;9;10" />
                <Face Color = "clOrange" VertexIndexes = "11;10;9;8;7;6" />
                <Face Color = "clRed"    VertexIndexes = "0;1;2;3;4;5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "2" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-Pi/2" Layer = "1" />

        <HideContaining Vector = " 0.01;  0.01;  H/2" />
        <HideContaining Vector = "-0.01; -0.01;  H/2" />
        <HideContaining Vector = " 0.01;  0.01; -H/2" />
        <HideContaining Vector = "-0.01; -0.01; -H/2" />

        <Turn Axis = "1" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "1" Angle = "-Pi/2" Layer = "1" />
        <Turn Axis = "0" Angle = " Pi/2" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-Pi/2" Layer = "1" />

        <ShowAll/>

        <Turn Axis = "2" Angle = " Pi/2" Layer = "1" />
        <Split Axis = "0" From = "1" /> <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" /> <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" /> <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Angle = " Pi  " Layer = "1" />
