        <Split Axis = "1" From = "1" /> <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" /> <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Angle = " Pi  " Layer = "1" />
        <Split Axis = "0" From = "1" /> <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "1" /> <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" /> <Split Axis = "2" From = "2" />
        <Turn Axis = "2" Angle = " Pi/2" Layer = "1" />
