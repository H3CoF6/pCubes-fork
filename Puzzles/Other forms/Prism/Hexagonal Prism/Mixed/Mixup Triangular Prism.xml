<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup Triangular Prism</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Mixed\Mixup Triangular Prism</Menu>
        <Inventor>Adrián Cures</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-09-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9087</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00';
        Colors[1] := 'FF64FF';
        Colors[2] := 'FF6000';
        Colors[3] := '00FF00';
        Colors[4] := '0064FF';
        Colors[5] := 'FF0000';
        Colors[6] := '646464';
        Colors[7] := 'C8C8C8';

        R := 0.6;

        for i := 0 to 2 do begin
            ax[i] := R * sin(2*Pi/3 * i);
            ay[i] := R * cos(2*Pi/3 * i);
        end;

        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * (i+0.5));
            y[i] := R * sin(Pi / 3 * (i+0.5));
        end;

        H := R * 0.8;

        D1 := H / 3;
        D2 :=-R * 0.25;
    </Script>

    <Axes TurningAngles = "2 * Pi / 6" PlaneDistances = "-D1; D1" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "D2" NormVectors = "ax; ay; 0" />

    <Figure>

        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "Colors[1]" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "Colors[2]" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "Colors[3]" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "Colors[4]" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "Colors[5]" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "Colors[6]" VertexIndexes = "11;10;9;8;7;6" />
                <Face Color = "Colors[7]" VertexIndexes = "0;1;2;3;4;5" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />

        <Turn Axis = "0" Layer = "2" Angle = "Pi/3" />
        <SplitByAxes/>
        <Turn Axis = "0" Layer = "1" Angle = "Pi/3" />
        <SplitByAxes/>
        <Undo/>
        <Undo/>
    </Figure>
</xml>
