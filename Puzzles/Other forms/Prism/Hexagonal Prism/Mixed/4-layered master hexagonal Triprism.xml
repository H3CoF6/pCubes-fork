<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>4-layered master hexagonal Triprism</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Mixed\4-layered master hexagonal Triprism</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-11-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6693</Link>
    </Interface>

    <Script>
        R := 0.6;
        H := R * sqrt(3) / 2;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * (i + 0.5));
            y[i] := R * sin(Pi / 3 * (i + 0.5));
        end;

        D := R * 0.5;
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-H/2; 0; H/2" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; H" />
                <Add Vector = "x[1]; y[1]; H" />
                <Add Vector = "x[2]; y[2]; H" />
                <Add Vector = "x[3]; y[3]; H" />
                <Add Vector = "x[4]; y[4]; H" />
                <Add Vector = "x[5]; y[5]; H" />
                <Add Vector = "x[0]; y[0];-H" />
                <Add Vector = "x[1]; y[1];-H" />
                <Add Vector = "x[2]; y[2];-H" />
                <Add Vector = "x[3]; y[3];-H" />
                <Add Vector = "x[4]; y[4];-H" />
                <Add Vector = "x[5]; y[5];-H" />
            </Vertices>
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "1;0;6;7" />
                <Face Color = "FF64FF" VertexIndexes = "2;1;7;8" />
                <Face Color = "FF6000" VertexIndexes = "3;2;8;9" />
                <Face Color = "00FF00" VertexIndexes = "4;3;9;10" />
                <Face Color = "0064FF" VertexIndexes = "5;4;10;11" />
                <Face Color = "FF0000" VertexIndexes = "0;5;11;6" />
                <Face Color = "646464" VertexIndexes = "11;10;9;8;7;6" />
                <Face Color = "C8C8C8" VertexIndexes = "0;1;2;3;4;5" />
            </Faces>
        </Part>
        
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "Pi / 2" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi / 2" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi / 2" />
        <Split Axis = "3" From = "2" />
        <Undo Repeat = "3" />
    </Figure>
</xml>
