<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hex Hexagonal Triprism</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Mixed\Hex Hexagonal Triprism</Menu>
        <Inventor>Dario Dagné</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-12-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6792</Link>
    </Interface>

    <Script>
        Colors[0] := 'FFFF00'; // clYellow
        Colors[1] := '00BF00'; // clBrightGreen
        Colors[2] := '0064FF'; // clSkyBlue
        Colors[3] := 'AF34AF'; // clBrightViolet
        Colors[4] := 'FF0000'; // clRed
        Colors[5] := 'FF6000'; // clOrange
        Colors[6] := '646464'; // clDarkGray
        Colors[7] := 'FFFFFF'; // clWhite

        R := 0.6;
        H := R * sqrt(3) / 2;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi/3 * i);
            y[i] := R * sin(Pi/3 * i);
        end;

        D := R * 0.5;
    </Script>

    <Axes TurningAngles = "0; Pi/6" PlaneDistances = "D" >
        <Axis NormVector = "x[0]; y[0]; 0" />
        <Axis NormVector = "x[2]; y[2]; 0" />
        <Axis NormVector = "x[4]; y[4]; 0" />
    </Axes>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; H" />
                <Add Vector = "x[1]; y[1]; H" />
                <Add Vector = "x[2]; y[2]; H" />
                <Add Vector = "x[3]; y[3]; H" />
                <Add Vector = "x[4]; y[4]; H" />
                <Add Vector = "x[5]; y[5]; H" />
                <Add Vector = "x[0]; y[0];-H" />
                <Add Vector = "x[1]; y[1];-H" />
                <Add Vector = "x[2]; y[2];-H" />
                <Add Vector = "x[3]; y[3];-H" />
                <Add Vector = "x[4]; y[4];-H" />
                <Add Vector = "x[5]; y[5];-H" />
            </Vertices>
            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "Colors[1]" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "Colors[2]" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "Colors[3]" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "Colors[4]" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "Colors[5]" VertexIndexes = " 0; 5;11; 6" />
                <Face Color = "Colors[6]" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "Colors[7]" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>
        
        <Split Axis = "0" From = "1" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "2" From = "1" />

        <Hide Axis = "0" Layer = "0" />
        <Turn Axis = "0" Layer = "1" Angle = "-Pi / 6" />
        <Cut><Plane NormVector = "X[1];Y[1];0" NormDistance = "-R / 2" /></Cut>
        <Cut><Plane NormVector = "X[5];Y[5];0" NormDistance = "-R / 2" /></Cut>
        <ShowAll/>
        <Hide Axis = "1" Layer = "0" />
        <Turn Axis = "1" Layer = "1" Angle = "-Pi / 6" />
        <Cut><Plane NormVector = "X[3];Y[3];0" NormDistance = "-R / 2" /></Cut>
        <Cut><Plane NormVector = "X[1];Y[1];0" NormDistance = "-R / 2" /></Cut>
        <ShowAll/>
        <Hide Axis = "2" Layer = "0" />
        <Turn Axis = "2" Layer = "1" Angle = "-Pi / 6" />
        <Cut><Plane NormVector = "X[5];Y[5];0" NormDistance = "-R / 2" /></Cut>
        <Cut><Plane NormVector = "X[3];Y[3];0" NormDistance = "-R / 2" /></Cut>
        <ShowAll/>
        <Split Axis = "3" From = "1" />

        <Hide Axis = "0" Layer = "0" />
        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <Cut><Plane NormVector = "X[1];Y[1];0" NormDistance = "-R / 2" /></Cut>
        <Cut><Plane NormVector = "X[5];Y[5];0" NormDistance = "-R / 2" /></Cut>
        <ShowAll/>
        <Hide Axis = "1" Layer = "0" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi / 3" />
        <Cut><Plane NormVector = "X[3];Y[3];0" NormDistance = "-R / 2" /></Cut>
        <Cut><Plane NormVector = "X[1];Y[1];0" NormDistance = "-R / 2" /></Cut>
        <ShowAll/>
        <Hide Axis = "2" Layer = "0" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi / 3" />
        <Cut><Plane NormVector = "X[5];Y[5];0" NormDistance = "-R / 2" /></Cut>
        <Cut><Plane NormVector = "X[3];Y[3];0" NormDistance = "-R / 2" /></Cut>
        <ShowAll/>
        <Split Axis = "3" From = "1" />

        <Turn Axis = "0" Layer = "1" Angle = "Pi / 3" />
        <Turn Axis = "1" Layer = "1" Angle = "Pi / 3" />
        <Turn Axis = "2" Layer = "1" Angle = "Pi / 3" />
        <Split Axis = "3" From = "1" />
        <Undo Repeat = "9" />
    </Figure>
</xml>
