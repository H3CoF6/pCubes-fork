<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Edge Hexagonal Prism 4</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Edge Turning\Edge Hexagonal Prism 4</Menu>
        <Inventor>virtual</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-08-02</Added>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.42;
        sAngle := PI * 2 / 6;
        for i := 0 to 5 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
            ax[i] := sin(sAngle * (i + 0.5));
            ay[i] := cos(sAngle * (i + 0.5));
        end;
        az := 0.5;

        H := R * sqrt(3) * 3 / 4;
        D := (-sqrt(3) * R + H) / sqrt(5);

        A1 := ArcCos(-7/8);
        A2 := ArcCos(-1/4);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1;0;A1;A2" PlaneDistances = "-D;D" FixedLayers = "1">
        <Axis NormVector = " ax[0]; ay[0]; az" />
        <Axis NormVector = " ax[1]; ay[1]; az" />
        <Axis NormVector = " ax[2]; ay[2]; az" />
        <Axis NormVector = " ax[3]; ay[3]; az" />
        <Axis NormVector = " ax[4]; ay[4]; az" />
        <Axis NormVector = " ax[5]; ay[5]; az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = "x[0]" Y = "y[0]" Z = "-H" />
                <Vector X = "x[1]" Y = "y[1]" Z = "-H" />
                <Vector X = "x[2]" Y = "y[2]" Z = "-H" />
                <Vector X = "x[3]" Y = "y[3]" Z = "-H" />
                <Vector X = "x[4]" Y = "y[4]" Z = "-H" />
                <Vector X = "x[5]" Y = "y[5]" Z = "-H" />

                <Vector X = "x[0]" Y = "y[0]" Z = " H" />
                <Vector X = "x[1]" Y = "y[1]" Z = " H" />
                <Vector X = "x[2]" Y = "y[2]" Z = " H" />
                <Vector X = "x[3]" Y = "y[3]" Z = " H" />
                <Vector X = "x[4]" Y = "y[4]" Z = " H" />
                <Vector X = "x[5]" Y = "y[5]" Z = " H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 6; 7; 1; 0" />
                <Face Color = "clBlue  " VertexIndexes = " 7; 8; 2; 1" />
                <Face Color = "clGreen " VertexIndexes = " 8; 9; 3; 2" />
                <Face Color = "clOrange" VertexIndexes = " 9;10; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "10;11; 5; 4" />
                <Face Color = "clCyan  " VertexIndexes = "11; 6; 0; 5" />
                <Face Color = "clYellow" VertexIndexes = "0;1;2;3;4;5" />
                <Face Color = "clWhite " VertexIndexes = "11;10;9;8;7;6" />
            </Faces>
        </Part>

        <SplitByAxes/>

    </Figure>
</xml>
