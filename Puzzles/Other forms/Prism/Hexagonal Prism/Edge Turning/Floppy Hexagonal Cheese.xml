<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Floppy Hexagonal Cheese</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Edge Turning\Floppy Hexagonal Cheese</Menu>
        <Inventor>Alexander Sosnovsky</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-01-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9508</Link>
    </Interface>

    <Script>
        R := 0.6;
        H := R / 2;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * (i + 0.5));
            y[i] := R * sin(Pi / 3 * (i + 0.5));
        end;
    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "0" NormVectors = "x; y; 0" />

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H / 2" />
            <Vertices Vectors = "x; y;-H / 2" />
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "1;0;6;7" />
                <Face Color = "FF64FF" VertexIndexes = "2;1;7;8" />
                <Face Color = "FF6000" VertexIndexes = "3;2;8;9" />
                <Face Color = "00FF00" VertexIndexes = "4;3;9;10" />
                <Face Color = "0064FF" VertexIndexes = "5;4;10;11" />
                <Face Color = "FF0000" VertexIndexes = "0;5;11;6" />
                <Face Color = "646464" VertexIndexes = "11;10;9;8;7;6" />
                <Face Color = "C8C8C8" VertexIndexes = "0;1;2;3;4;5" />
            </Faces>
        </Part>
        
        <SplitByAxes/>
    </Figure>
</xml>
