<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexminx-Prism</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hexminx-Prism</Menu>
        <Inventor>Claus Wenicker</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2021-04-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3551</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.55;

        fAngle := PI * 2 / 6;
        for i := 0 to 5 do begin
            x[i] := R * cos(fAngle * i);
            y[i] :=-R * sin(fAngle * i);
        end;

        D := R * 0.6;
        H := R * (36/41);

        sAngle := 2 * Pi / 5;

        s3 := sqrt(3);
        s5 := sqrt(5);
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-s3;     -1; (3 + s5) / 2" />
        <Axis NormVector = " s3;     -1; (3 + s5) / 2" />
        <Axis NormVector = "-s3;      1; (3 - s5) / 2" />
        <Axis NormVector = " s3;      1; (3 - s5) / 2" />
        <Axis NormVector = "  0; 3 - s5;            1" />
        <Axis NormVector = "  0;-3 - s5;            1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y;-H" />
            <Vertices Vectors = "x; y; H" />
            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 6; 7; 1; 0" />
                <Face Color = "clBlue  " VertexIndexes = " 7; 8; 2; 1" />
                <Face Color = "clGreen " VertexIndexes = " 8; 9; 3; 2" />
                <Face Color = "clOrange" VertexIndexes = " 9;10; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "10;11; 5; 4" />
                <Face Color = "clCyan  " VertexIndexes = "11; 6; 0; 5" />
                <Face Color = "clYellow" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
                <Face Color = "clWhite " VertexIndexes = "11;10; 9; 8; 7; 6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <RemoveContaining Vectors = "x; y;-H" />
        <RemoveContaining Vectors = "x; y; H" />
        <RemoveGrayParts/>
    </Figure>
</xml>
