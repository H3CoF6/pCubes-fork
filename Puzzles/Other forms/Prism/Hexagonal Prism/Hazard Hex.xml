<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hazard Hex</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hazard Hex</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-08-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6329</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.55;
        sAngle := PI * 2 / 6;
        for i := 0 to 5 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;
        H := R * sqrt(2)/2;

        for i := 0 to 2 do begin
            ax[i] := sin(sAngle * 2 * i + sAngle/2);
            ay[i] := cos(sAngle * 2 * i + sAngle/2);
        end;

        D  := R * sqrt(3) / 4;
    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "ax[0]; ay[0]; 0" />
        <Axis NormVector = "ax[1]; ay[1]; 0" />
        <Axis NormVector = "ax[2]; ay[2]; 0" />
        <Axis NormVector = "x[1]/2; y[1]/2; H" />
        <Axis NormVector = "x[3]/2; y[3]/2; H" />
        <Axis NormVector = "x[5]/2; y[5]/2; H" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 6; 7; 1; 0" />
                <Face Color = "clBlue  " VertexIndexes = " 7; 8; 2; 1" />
                <Face Color = "clGreen " VertexIndexes = " 8; 9; 3; 2" />
                <Face Color = "clOrange" VertexIndexes = " 9;10; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "10;11; 5; 4" />
                <Face Color = "clCyan  " VertexIndexes = "11; 6; 0; 5" />
                <Face Color = "clYellow" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
                <Face Color = "clWhite " VertexIndexes = "11;10; 9; 8; 7; 6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Remove">
            <RemoveContaining Vector = "R * sin(sAngle * 2 * Id + dA) * K; R * cos(sAngle * 2 * Id + dA) * K; H" />
            <RemoveContaining Vector = "R * sin(sAngle * 2 * Id - dA) * K; R * cos(sAngle * 2 * Id - dA) * K; H" />
            <RemoveContaining Vector = "R * sin(sAngle * (2 * Id + 1) + dA) * K; R * cos(sAngle * (2 * Id + 1) + dA) * K; -H" />
            <RemoveContaining Vector = "R * sin(sAngle * (2 * Id + 1) - dA) * K; R * cos(sAngle * (2 * Id + 1) - dA) * K; -H" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "Remove" Repeat = "3" Id = "0" K = "0.8" dA = "-0.6" />
    </Figure>
</xml>
