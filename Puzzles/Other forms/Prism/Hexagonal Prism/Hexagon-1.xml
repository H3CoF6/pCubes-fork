<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagon-1</Name>
        <Class>TSquare1</Class>
        <Menu>Other forms\Prism\Hexagonal Prism\Hexagon-1</Menu>
        <Inventor>Chris Witham</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-05-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2830</Link>
    </Interface>

    <Script>
        <!--Source : Andrea's code for Square-1-->
        S0 := sin (Pi / 18);
        C0 := cos (Pi / 18);

        R := 0.6;
        H := 0.85 * R;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;
    </Script>

    <Axes TurningAngles = "Pi / 9" PlaneDistances = "-H/4; H/4" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "C0; S0; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
            </Vertices>
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "FF64FF" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "FF6000" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "00FF00" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "0064FF" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "FF0000" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "646464" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "C8C8C8" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "1" Angle = " 2 * Pi / 9" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "     Pi / 9" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " 2 * Pi / 9" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "     Pi / 9" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " 2 * Pi / 9" />
        <Split Axis = "1" From  = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = "-8 * Pi / 9" />
    </Figure>
</xml>
