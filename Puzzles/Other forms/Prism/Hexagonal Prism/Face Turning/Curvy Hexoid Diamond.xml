<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Curvy Hexoid Diamond</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Face Turning\Curvy Hexoid Diamond</Menu>
        <Inventor>Mohammad Badir</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2024-11-25</Added>
        <Link>http://twistypuzzles.com/museum/museum_showitem.php?pkey=12311</Link>
    </Interface>

    <Script>
        clBlue   := '0055EE';
        clGreen  := '00AA00';
        clRed    := 'EE0000';
        clPurple := '8800BB';
        clYellow := 'FFEE00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6600';
        clRose   := 'EE77AA';

        R := 0.6;

        H := R * sin(Pi / 9);
        sAngle := 2 * Pi / 6;
        for i := 0 to 5 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;
        for i := 0 to 2 do begin
            ax[i] := sin(sAngle * (2 * i + 0.5));
            ay[i] := cos(sAngle * (2 * i + 0.5));
        end;

        D1 := R * 0.52;
        D2 := R * 0.69;
        DH := H / 3;
        DCut := R * 0.75;
    </Script>

    <Axes TurningAngles = "Pi; Pi; 0; Pi; Pi" NormVectors = " ax; ay; 0" PlaneDistances = "-D2;-D1; D1; D2" />

    <Axes TurningAngles = "2*Pi / 6" NormVectors = " 0; 0; 1" PlaneDistances = "-DH; DH" />

    <Figure>
        <Part>
            <Vertices Vectors = " x; y;-H" />
            <Vertices Vectors = " x; y; H" />
            <Faces>
                <Face                    VertexIndexes = " 6; 7; 1; 0" />
                <Face                    VertexIndexes = " 7; 8; 2; 1" />
                <Face Color = "clOrange" VertexIndexes = " 8; 9; 3; 2" />
                <Face                    VertexIndexes = " 9;10; 4; 3" />
                <Face                    VertexIndexes = "10;11; 5; 4" />
                <Face Color = "clPurple" VertexIndexes = "11; 6; 0; 5" />
                <Face Color = "clYellow" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
                <Face Color = "clWhite " VertexIndexes = "11;10; 9; 8; 7; 6" />
            </Faces>
        </Part>
        <Cut Color = "clBlue " > <Plane NormVector = " ax[0]; ay[0]; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clRed  " > <Plane NormVector = "-ax[2];-ay[2]; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clRose " > <Plane NormVector = "-ax[0];-ay[0]; 0" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clGreen" > <Plane NormVector = " ax[2]; ay[2]; 0" NormDistance = "-DCut" /> </Cut>

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "1" From = "1" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "2" />
        <RemoveGrayParts/>
    </Figure>
</xml>
