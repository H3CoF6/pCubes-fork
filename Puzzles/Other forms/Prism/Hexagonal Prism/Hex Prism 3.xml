<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hex Prism 3</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hex Prism 3</Menu>
        <Menu>Other forms\3x3x3 variants\Prism\Hex Prism 3</Menu>
        <Inventor>Andreas Nortmann</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-05-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2829</Link>
    </Interface>

    <Script>
        R := 0.56;
        H := R * 7/sqrt(32);
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;

        for i := 0 to 2 do begin
            ax[i] := cos(2 * Pi / 3 * i);
            ay[i] := sin(2 * Pi / 3 * i);
        end;
        az := 1 / sqrt(2);

        D1 := R * sqrt(3/32);
        D2 := D1 * 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" NormVectors = "ax; ay; az" />

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "FF64FF" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "FF6000" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "00FF00" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "0064FF" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "FF0000" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "646464" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "C8C8C8" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Split><Plane NormVector = "ax[0]; ay[0]; az" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = "ax[0]; ay[0]; az" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = "ax[1]; ay[1]; az" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = "ax[1]; ay[1]; az" NormDistance = "-D2" /></Split>
        <Split><Plane NormVector = "ax[2]; ay[2]; az" NormDistance = " D2" /></Split>
        <Split><Plane NormVector = "ax[2]; ay[2]; az" NormDistance = "-D2" /></Split>
    </Figure>
</xml>
