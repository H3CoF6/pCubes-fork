<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagonal Prism Mirror</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hexagonal Prism Mirror</Menu>
        <Menu>Other forms\3x3x3 variants\Prism\Hexagonal Prism Mirror</Menu>
        <Inventor>Roberto Cazares</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-01</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9226</Link>
    </Interface>

    <Script>
        R := 0.56;
        H := R * 1.05;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;

        D := R * 0.27;

        DX := R * 0.14;
        DY := R * 0.21;
        DZ := R * 0.3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Turn NormVector = "0;0;1" Angle = "-Pi/4" />
        <Turn NormVector = "0;1;0" Angle = "-ArcTan(sqrt(2))" />

        <Transfer Vector = " DX; DY; DZ" />

        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "FF64FF" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "FF6000" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "00FF00" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "0064FF" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "FF0000" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "646464" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "C8C8C8" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Transfer Vector = "-DX;-DY;-DZ" />
    </Figure>
</xml>
