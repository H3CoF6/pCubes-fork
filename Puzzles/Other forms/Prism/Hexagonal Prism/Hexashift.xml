<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexashift</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hexashift</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-04-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7940</Link>
    </Interface>

    <Script>
        R := 0.6;

        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * (i+0.5));
            y[i] := R * sin(Pi / 3 * (i+0.5));
        end;

        az := sqrt(2) / 4;
        bz := sqrt(3) / 2;

        H := R * 3/4 * sqrt(3/2);
        D := H / 3;
    </Script>

    <Axes TurningAngles = "Pi/3; 0; Pi/3" PlaneDistances = "-D; D" >
        <Axis NormVector = "  0;   0; -1" />
        <Axis NormVector = "  1;   0; az" />
        <Axis NormVector = "-1/2;-bz; az" />
        <Axis NormVector = "-1/2; bz; az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "0066FF" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "FF66FF" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "FF7700" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "00EE00" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "9900EE" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "FF0000" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "FFFF00" VertexIndexes = "11;10;9;8;7;6" />
                <Face Color = "FFFFFF" VertexIndexes = "0;1;2;3;4;5" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" To = "1" />
        <Split Axis = "0" From = "2" To = "2" />
        <Turn Axis = "0" Layers = "0;2" Angle = "-Pi/3" />
        <SplitByAxes/>
        <Undo/>

        <RemoveGrayParts/>
    </Figure>
</xml>
