<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hourglass Prism</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hourglass Prism</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-05-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7449</Link>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.45;
        sAngle := PI * 2 / 6;
        for i := 0 to 5 do begin
            x[i] := R * sin(sAngle * i);
            y[i] := R * cos(sAngle * i);
        end;
        H := R * 3 / sqrt(6);
        D := R / sqrt(6);

        az := sqrt(2) / 4;
    </Script>

    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D; D">
        <Axis NormVector = "  0;          0;   1" />
        <Axis NormVector = " -1;          0; -az" />
        <Axis NormVector = "1/2;  sqrt(3)/2; -az" />
        <Axis NormVector = "1/2; -sqrt(3)/2; -az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = "x[0]" Y = "y[0]" Z = "-H" />
                <Vector X = "x[1]" Y = "y[1]" Z = "-H" />
                <Vector X = "x[2]" Y = "y[2]" Z = "-H" />
                <Vector X = "x[3]" Y = "y[3]" Z = "-H" />
                <Vector X = "x[4]" Y = "y[4]" Z = "-H" />
                <Vector X = "x[5]" Y = "y[5]" Z = "-H" />

                <Vector X = "x[0]" Y = "y[0]" Z = " H" />
                <Vector X = "x[1]" Y = "y[1]" Z = " H" />
                <Vector X = "x[2]" Y = "y[2]" Z = " H" />
                <Vector X = "x[3]" Y = "y[3]" Z = " H" />
                <Vector X = "x[4]" Y = "y[4]" Z = " H" />
                <Vector X = "x[5]" Y = "y[5]" Z = " H" />
            </Vertices>
            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 6; 7; 1; 0" />
                <Face Color = "clBlue  " VertexIndexes = " 7; 8; 2; 1" />
                <Face Color = "clGreen " VertexIndexes = " 8; 9; 3; 2" />
                <Face Color = "clOrange" VertexIndexes = " 9;10; 4; 3" />
                <Face Color = "clPurple" VertexIndexes = "10;11; 5; 4" />
                <Face Color = "clCyan  " VertexIndexes = "11; 6; 0; 5" />
                <Face Color = "clYellow" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
                <Face Color = "clWhite " VertexIndexes = "11;10; 9; 8; 7; 6" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
