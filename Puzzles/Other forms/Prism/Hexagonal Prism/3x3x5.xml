<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagonal Prism 3x3x5</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\3x3x5</Menu>
        <Inventor>Nguyễn Hoang Khanh</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-02-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5987</Link>
    </Interface>

    <Script>
        R := 0.6;
        H := R * 0.884;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;

        for i := 0 to 2 do begin
            ax[i] := cos(2 * Pi / 3 * i);
            ay[i] := sin(2 * Pi / 3 * i);
        end;
        az := 1 / sqrt(2);

        D1 := (R * sqrt(2) - H) / sqrt(3);
        D2 := D1 * 2;

    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "ax[0]; ay[0]; az" />
        <Axis NormVector = "ax[1]; ay[1]; az" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "ax[2]; ay[2]; az" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "x[0]; y[0];  H" />
                <Add Vector = "x[1]; y[1];  H" />
                <Add Vector = "x[2]; y[2];  H" />
                <Add Vector = "x[3]; y[3];  H" />
                <Add Vector = "x[4]; y[4];  H" />
                <Add Vector = "x[5]; y[5];  H" />
                <Add Vector = "x[0]; y[0]; -H" />
                <Add Vector = "x[1]; y[1]; -H" />
                <Add Vector = "x[2]; y[2]; -H" />
                <Add Vector = "x[3]; y[3]; -H" />
                <Add Vector = "x[4]; y[4]; -H" />
                <Add Vector = "x[5]; y[5]; -H" />
            </Vertices>
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "1;0;6;7" />
                <Face Color = "FF64FF" VertexIndexes = "2;1;7;8" />
                <Face Color = "FF6000" VertexIndexes = "3;2;8;9" />
                <Face Color = "00FF00" VertexIndexes = "4;3;9;10" />
                <Face Color = "0064FF" VertexIndexes = "5;4;10;11" />
                <Face Color = "FF0000" VertexIndexes = "0;5;11;6" />
                <Face Color = "646464" VertexIndexes = "11;10;9;8;7;6" />
                <Face Color = "C8C8C8" VertexIndexes = "0;1;2;3;4;5" />
            </Faces>
        </Part>
        
        <SplitByAxes/>
    </Figure>
</xml>
