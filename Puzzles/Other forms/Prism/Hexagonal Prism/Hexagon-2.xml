<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hexagon-2</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hexagon-2</Menu>
        <Inventor>Alexander Sosnovsky</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9588</Link>
    </Interface>

    <Script>
        R := 0.6;
        H := R * 0.7;
        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;

        D := H / 3;
    </Script>

    <Axes TurningAngles = "Pi / 9" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Figure>
        <Turn NormVector = "0; 0; 1" Angle = " Pi / 18" />
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />
            <Faces>
                <Face Color = "FFFF00" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "FF64FF" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "FF6000" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "00FF00" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "0064FF" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "FF0000" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "646464" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "C8C8C8" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>
        <SplitByAxes/>

        <Macro Name = "TurnAndSplit" >
            <Turn  Axis = "0" Layer = "1" Angle = " Pi / 9" />
            <Split Axis = "1" From  = "1" />
        </Macro>
        <ExecMacro MacroName = "TurnAndSplit" Repeat = "8" />
        <Undo Repeat = "8" />
    </Figure>
</xml>
