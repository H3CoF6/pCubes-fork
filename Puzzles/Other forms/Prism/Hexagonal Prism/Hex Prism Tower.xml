<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Hex Prism Tower</Name>
        <Menu>Other forms\Prism\Hexagonal Prism\Hex Prism Tower</Menu>
        <Menu>Other forms\Multi-core\Hex Prism Tower</Menu>
        <Inventor>Josh Bostick</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-09-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2178</Link>
    </Interface>

    <Script>
        R := 0.56;
        H := R * sqrt(2);
        D := R * sqrt(6) / 8;
        dz := R * 3 * sqrt(2) / 8;

        for i := 0 to 5 do begin
            x[i] := R * cos(Pi / 3 * i);
            y[i] := R * sin(Pi / 3 * i);
        end;

        for i := 0 to 2 do begin
            ax[i] := cos(2 * Pi / 3 * i);
            ay[i] := sin(2 * Pi / 3 * i);
            az[i] := 1 / sqrt(2);
        end;
    </Script>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = " D" >
        <Axis NormVector = " ax[0]; ay[0]; az[0]" BaseVector = "0; 0; dz" />
        <Axis NormVector = " ax[1]; ay[1]; az[1]" BaseVector = "0; 0; dz" />
        <Axis NormVector = " ax[2]; ay[2]; az[2]" BaseVector = "0; 0; dz" />
    </Axes>

    <Axes TurningAngles = "0; Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "-ax[0];-ay[0];-az[0]" BaseVector = "0; 0;-dz" />
        <Axis NormVector = "-ax[1];-ay[1];-az[1]" BaseVector = "0; 0;-dz" />
        <Axis NormVector = "-ax[2];-ay[2];-az[2]" BaseVector = "0; 0;-dz" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x; y; H" />
            <Vertices Vectors = "x; y;-H" />

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = " 1; 0; 6; 7" />
                <Face Color = "FF64FF" VertexIndexes = " 2; 1; 7; 8" />
                <Face Color = "FF6000" VertexIndexes = " 3; 2; 8; 9" />
                <Face Color = "00FF00" VertexIndexes = " 4; 3; 9;10" />
                <Face Color = "0064FF" VertexIndexes = " 5; 4;10;11" />
                <Face Color = "FF0000" VertexIndexes = " 0; 5;11; 6" />

                <Face Color = "646464" VertexIndexes = "11;10; 9; 8; 7; 6" />
                <Face Color = "C8C8C8" VertexIndexes = " 0; 1; 2; 3; 4; 5" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <HideContaining Vector = "0;0;0" />
        <Split><Plane NormVector = "-ax[0];-ay[0];-az[0]" /></Split>
        <Split><Plane NormVector = "-ax[1];-ay[1];-az[1]" /></Split>
        <Split><Plane NormVector = "-ax[2];-ay[2];-az[2]" /></Split>
        <ShowAll/>
    </Figure>
</xml>
