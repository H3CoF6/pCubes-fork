<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bygride 3-4</Name>
        <Menu>Other forms\Bi Axes\Bygride 3-4</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-09-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6630</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clBlack  := '202020';
        clBlack1 := '202021';
        clBlack2 := '202022';
        clYellow := 'FFFF00';
        clBlue   := '0000FF';
        clGreen  := '008000';     
        clRed    := 'FF0000';
        clCyan   := '00FFFF';
        clLime   := '00FF00';     
        clOrange := 'FF6000';

        K := 0.2;
        pX1 := K * sqrt(2);
        pX2 := K * (2 + sqrt(2));
        pX3 := K * (1 + sqrt(2));
        pX4 := K * 2;
        pX5 := K;

        pY1 := K * sqrt(4 + 9/2 * sqrt(2));
        pY2 := K / 2^(1/4);
        pY3 := pY2 * 3;

        A1 := Pi*2/3;
        A2 := Pi/2;
        D1 := K * sqrt(1 / sqrt(2) - 2/3);
        D2 := pY2;
    </Script>       

    <Axes TurningAngles = "A1" PlaneDistances = "D1" FixedLayers = "0" >
        <Axis NormVector = " pX3; pY2; pX3" />
    </Axes>
    <Axes TurningAngles = "A2" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " pX1;-pY1;   0" />
                <Add Vector = "   0;-pY1; pX1" />
                <Add Vector = "-pX1;-pY1;   0" />
                <Add Vector = "   0;-pY1;-pX1" />

                <Add Vector = " pX2;-pY2;   0" />
                <Add Vector = "   0;-pY2; pX2" />
                <Add Vector = "-pX2;-pY2;   0" />
                <Add Vector = "   0;-pY2;-pX2" />

                <Add Vector = " pX3; pY2; pX3" />
                <Add Vector = "-pX3; pY2; pX3" />
                <Add Vector = " pX3; pY2;-pX3" />

                <Add Vector = "-pX4; pY3; pX1" />
                <Add Vector = " pX5; pY1; pX5" />
                <Add Vector = " pX1; pY3;-pX4" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"  VertexIndexes = "0;1;2;3" />
                <Face Color = "clBlue"   VertexIndexes = "8;5;1;0;4" />
                <Face Color = "clRed"    VertexIndexes = "9;6;2;1;5" />
                <Face Color = "clYellow" VertexIndexes = "6;7;3;2" />
                <Face Color = "clGreen"  VertexIndexes = "10;4;0;3;7" />

                <Face Color = "clCyan"   VertexIndexes = "12;11;9;5;8" />
                <Face Color = "clLime"   VertexIndexes = "13;12;8;4;10" />

                <Face Color = "clBlack1" VertexIndexes = "13;10;7" />
                <Face Color = "clOrange" VertexIndexes = "11;12;13" />
                <Face Color = "clBlack2" VertexIndexes = "6;9;11" />
                <Face Color = "clBlack"  VertexIndexes = "7;6;11;13" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Macro Name = "Pair">
            <Turn Axis = "0" Angle = "A1" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "1" Angle = "A2" Layer = "1" />
            <SplitByAxes/>
        </Macro>

        <ExecMacro MacroName = "Pair" Repeat = "7" />
        <Undo Repeat = "14" />
    </Figure>
</xml>
