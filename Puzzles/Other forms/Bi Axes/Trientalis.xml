<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Trientalis</Name>
        <Menu>Other forms\Bi Axes\Trientalis</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-04-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7412</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBlue   := '0000FF';

        A := Pi*2/3;

        K := 1.2;
        D := -K * 0.04; // var

        s := sin(Pi/14);

        ax := sqrt(1 + 2 * s);
        az := sqrt(2 * (1 - s));

        Px := k * s * 2 * ax / az;
        Py := k * ax;
        Pk := k * s * 2;
        Pz := k;

        DCut := D * sqrt(3 / 2 * (1 - s)) - k * s;
        DCut2 := -Px * Pz / sqrt((Pk + Pz) ^ 2  + Px ^ 2);
        DCut3 := -K * 0.512858431636279 - D * 1.10768806731937;
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " ax; 0; az" />
        <Axis NormVector = "-ax; 0; az" />
        <Axis1 NormVector = "0; y1; z1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " Px;  0; Pk" />
                <Add Vector = "-Px;  0; Pk" />
                <Add Vector = "  0; Py;-Pz" />
                <Add Vector = "  0;-Py;-Pz" />
            </Vertices>

            <Faces>
                <Face Color = "clRed   " VertexIndexes = "0;2;1" />
                <Face Color = "clYellow" VertexIndexes = "1;3;0" />
                <Face Color = "clGreen " VertexIndexes = "0;3;2" />
                <Face Color = "clBlue  " VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Cut><Plane NormVector = "0;0;1" NormDistance = "DCut" /></Cut>

        <SplitByAxes/>

        <Macro Name = "RR">
            <Turn Axis = "0" Angle = " A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>
        <ExecMacro MacroName = "RR" Repeat = "16" />
        <Undo Repeat = "32" />

        <Macro Name = "LL">
            <Turn Axis = "0" Angle = "-A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = " A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>
        <ExecMacro MacroName = "LL" Repeat = "16" />
        <Undo Repeat = "32" />

        <!-- cut 4 pieces -->
        <Turn Axis = "0" Angle = "-A" Layer = "1" /> <SplitByAxes/>
        <Cut><Plane NormVector = "Pk + Pz;0;Px" NormDistance = "DCut2" /></Cut>
        <Turn Axis = "0" Angle = "-A" Layer = "1" /> <SplitByAxes/>
        <Cut><Plane NormVector = "Pk + Pz;0;Px" NormDistance = "DCut2" /></Cut>
        <Undo Repeat = "2" />
        <Turn Axis = "1" Angle = "A" Layer = "1" /> <SplitByAxes/>
        <Cut><Plane NormVector = "-Pk - Pz;0;Px" NormDistance = "DCut2" /></Cut>
        <Turn Axis = "1" Angle = "A" Layer = "1" /> <SplitByAxes/>
        <Cut><Plane NormVector = "-Pk - Pz;0;Px" NormDistance = "DCut2" /></Cut>
        <Undo Repeat = "2" />

        <!-- cut base -->
        <HideContaining Vector = "0; 0; DCut" />
        <InvertVisibility/>
        <Cut><Plane NormVector = "0;  Pk + Pz; Py" NormDistance = "DCut3" /></Cut>
        <Cut><Plane NormVector = "0; -Pk - Pz; Py" NormDistance = "DCut3" /></Cut>
        <ShowAll/>
    </Figure>
</xml>
