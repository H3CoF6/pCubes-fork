            <Turn NormVector = " ax;-ay; 0" Angle = "-sAngle" />
            <Turn NormVector = "-ax;-ay; 0" Angle = "-sAngle" />
        <ExecMacro MacroName = "CutAndTurn" Repeat = "8" />
            <Turn NormVector = "-ax;-ay; 0" Angle = " sAngle" />
-->

        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " Dt * sAngle" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt * sAngle" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Dt = " 1" Repeat = "7" />
        <Undo Repeat = "400" />
        <ExecMacro MacroName = "SplitPart" Dt = "-1" Repeat = "7" />
        <Undo Repeat = "400" />

        <Turn Axis = "0" Angle = " sAngle" Layer = "1" /> <SplitByAxes/>
        <Turn Axis = "1" Angle = "-sAngle" Layer = "1" /> <SplitByAxes/>

        <ExecMacro MacroName = "SplitPart" Dt = "-1" Repeat = "9" />
        <Undo Repeat = "400" />
<Circle1 Radius = "0.1" Center = " L; -K; 0" />
<Circle1 Radius = "0.01" Center = "-Ans_X;-Ans_Y;-Ans_Z" />

