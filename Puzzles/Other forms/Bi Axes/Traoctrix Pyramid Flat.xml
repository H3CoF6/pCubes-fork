    <Script>
        include 'Figures\Scripts\Vectors.inc';

        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clGreen  := '008000';
        clBlue   := '0000FF';
        clBlack1 := '010101';
        clBlack2 := '010102';

        K := 0.5;

        s2 := sqrt(2);
        Angle  := Arccos(1 - 2 / 3 * (1 + s2)); // angle between axes
        AngleM := (Pi - Angle) / 2;
        ax := cos(AngleM); // sqrt((1 + s2) / 3)
        ay := sin(AngleM); // sqrt((2 - s2) / 3)

        pX := K * sqrt(2 + 3 / s2);
        pY := K / s2;
        pZ := K * sqrt((s2 + 1) / 2));

        DCut := K * sqrt((10 - s2) / 6);

        sAngle := 2*Pi / 3;

        D := ay * Py * 1.0;
    L := - ay*(Py + K) / ax; // -K / sqrt(s2)

        // octagon's centers
        cY :=-K * (2 - s2) / 2;
        cZ := K * sqrt((s2 - 1) / 2); // cY * sqrt(3) * ax;
        dX := K * (s2 - 1) / sqrt(s2);
        dY := K * (s2 - 1);


        VectorRotatePoint( -L, -K, 0,  ax,-ay, 0, -sAngle, False);
        VectorNormalToPlane( L, -K, 0, Ans_X, Ans_Y, Ans_Z, Ans_X, Ans_Y,-Ans_Z);

<!--        VectorRotatePoint( 0, cY, cZ,  ax,-ay, 0, -sAngle, False);-->
//ShowMessage(Ans_X/Ans_Y);
//ShowMessage(-Ans_Y);
//ShowMessage(-Ans_Z);
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D" FixedLayers = "0" >
        <Axis NormVector = " ax;-ay; 0" />
        <Axis NormVector = "-ax;-ay; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " Px; -K;  0" />
                <Add Vector = "-Px; -K;  0" />
                <Add Vector = "  0; Py; Pz" />
                <Add Vector = "  0; Py;-Pz" />
            </Vertices>

            <Faces>
                <Face Color = "clRed   " VertexIndexes = "0;2;1" />
                <Face Color = "clYellow" VertexIndexes = "1;3;0" />
                <Face Color = "clGreen " VertexIndexes = "0;3;2" />
                <Face Color = "clBlue  " VertexIndexes = "1;2;3" />
            </Faces>
        </Part>

        <Cut Color = "clBlack1" ><Plane NormVector = "-Px;K;0" NormDistance = "-DCut" /></Cut>
        <Cut Color = "clBlack2" ><Plane NormVector = " Px;K;0" NormDistance = "-DCut" /></Cut>

<!--        <Macro Name = "CutAndTurn" >
            <Cut Color = "FFFFFF" ><Plane NormVector = " dx; K; 0" NormDistance = "-0.42" /></Cut>
             <Cut1><Plane NormVector = "-dx; K; 0" NormDistance = "-0.415" /></Cut1>
            <Turn NormVector = "0;Cy;Cz" Angle = "Pi/4" />
        </Macro>
        <ExecMacro MacroName = "CutAndTurn" Repeat = "8" />
        <Turn NormVector = "0;1;0" Angle = "Pi" />
        <ExecMacro MacroName = "CutAndTurn" Repeat = "8" />
        <Turn NormVector = "0;1;0" Angle = "Pi" />-->
