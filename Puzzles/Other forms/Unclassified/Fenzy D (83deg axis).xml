        C10 :=  K * 1.46462574227217328487;
        C11 :=  K * 0.48151479042544999054;
        C12 :=  K * 0.37160314575966565895;
        C13 :=  K * 1.24680065715558604121;
        C14 :=  K * 0.49078639588838429839;
        C15 := -K * 1.03894751157819269926;
        C16 :=  K * 0.78306375526361943509;
        C17 :=  K * 1.22675759336153266355;
        C18 :=  K * 0.64765128714898767153;
        C19 :=  K * 0.09531883546954607419;
        C20 :=  K * 0.86482873694073557696;
        C21 := -K * 1.08464631948733039347;
        C22 :=  K * 0.89395946967203702585;
        C23 :=  K * 0.94521809293187508283;
        C24 :=  K * 0.49078639588838429839;
        C25 :=  K * 0.44072926196501705478;
        C26 := -K * 1.22407454604278570412;
        C27 :=  K * 0.58355117540674564774;
        C28 :=  K * 1.01074028462102136571;
        C29 :=  K * 0.23892629135752467792;
        C30 :=  K * 0.93941875006975640222;
        C31 :=  K * 0.69254625065171947808;
        C32 :=  K * 0.60947129467030628027;
        C33 := -K * 1.00221870778758843158;
        C34 :=  K * 0.20812513714041271568;
        C35 :=  K * 0.95975871171959059334;
        C36 :=  K * 0.67435955731707004187;

        Vx[ 0,0] :=  0;   Vy[ 0,0] :=  0;   Vz[ 0] :=  C1;
        Vx[ 1,0] :=  0;   Vy[ 1,0] :=  0;   Vz[ 1] := -C1;
        Vx[ 2,0] :=  C2;  Vy[ 2,0] :=  C3;  Vz[ 2] :=  C4;
        Vx[ 3,0] :=  C5;  Vy[ 3,0] :=  C6;  Vz[ 3] := -C4;
        Vx[ 4,0] :=  C7;  Vy[ 4,0] :=  C8;  Vz[ 4] :=  C9;
        Vx[ 5,0] :=  C10; Vy[ 5,0] :=  C11; Vz[ 5] := -C9;
        Vx[ 6,0] :=  C12; Vy[ 6,0] :=  C13; Vz[ 6] :=  C14;
        Vx[ 7,0] :=  C15; Vy[ 7,0] :=  C16; Vz[ 7] := -C14;
        Vx[ 8,0] :=  C17; Vy[ 8,0] :=  C18; Vz[ 8] :=  C19;
        Vx[ 9,0] :=  C20; Vy[ 9,0] :=  C21; Vz[ 9] := -C19;
        Vx[10,0] :=  C22; Vy[10,0] :=  C23; Vz[10] :=  C24;
        Vx[11,0] :=  C25; Vy[11,0] :=  C26; Vz[11] := -C24;
        Vx[12,0] :=  C27; Vy[12,0] :=  C28; Vz[12] :=  C29;
        Vx[13,0] :=  C30; Vy[13,0] :=  C31; Vz[13] := -C29;
        Vx[14,0] :=  C32; Vy[14,0] :=  C33; Vz[14] :=  C34;
        Vx[15,0] :=  C35; Vy[15,0] :=  C36; Vz[15] := -C34;

        cos1 := cos(Pi*2/3);
        sin1 := sin(Pi*2/3);
        cos2 := cos(Pi*4/3);
        sin2 := sin(Pi*4/3);

        for i := 0 to 15 do begin
            Vx[i,1] := Vx[i,0] * cos1 - Vy[i,0] * sin1;
            Vy[i,1] := Vx[i,0] * sin1 + Vy[i,0] * cos1;
            Vx[i,2] := Vx[i,0] * cos2 - Vy[i,0] * sin2;
            Vy[i,2] := Vx[i,0] * sin2 + Vy[i,0] * cos2;
        end;

        D  := K * 0.60033069350611780071;

        A1 := arctan(9.15103255567986085730); // 83.76361813813520689187 degs
        A2 := Pi-arctan(1.72227389860018545831); // 120.140639022813555011 degs
    </Script>

