        K  := 0.45;

        // angle between axes = 83degs
        N1 :=  0.76512772641559767178;
        N2 :=  0.64387853067958270039;
        N3 :=  0.70112333817564542796;
        N4 := -0.30634376506686278194;

        C1 :=  K * 1.55308796978297798430;
        C2 :=  K * 0.68201144002495703706;
        C3 :=  K * 1.18127846546643975833;
        C4 :=  K * 0.74264650041924391887;
        C5 :=  K * 1.09792313257692321013;
        C6 :=  K * 0.80939682001607726748;
