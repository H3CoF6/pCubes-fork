<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cupcake 2x2x3</Name>
        <Menu>Other forms\Unclassified\Cupcake 2x2x3</Menu>
        <Inventor>Javier Alla La</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9239</Link>
    </Interface>

    <Script>
        Color1 := 'CBC974';
        Color2 := '8D5615';
        R1 := 0.45;
        R2 := 0.6;
        D  := R1 / 3;
        H  := 2 * D;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <Cylinder Radius = "R1" Color = "Color1" Top = "0; 0; H" >
               <Base Color = "Color1" />
               <Top  Color = "Color1" />
        </Cylinder>
        <Cylinder Radius = "R2" Color = "Color2" Top = "0; 0;-H" >
               <Base Color = "Color2" />
               <Top  Color = "Color2" />
        </Cylinder>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
