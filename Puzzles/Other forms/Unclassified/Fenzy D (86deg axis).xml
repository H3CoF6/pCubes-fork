        clLGreen := '30E020';
        clViolet := '602090';
        clSilver := 'A0A0A0';

        K  := 0.45;

        // angle between axes = 86degs
        N1 :=  0.78750387353793365293;
        N2 :=  0.61630970231106227533;
        N3 :=  0.57091036376371396439;
        N4 := -0.54242391852169793179;

        C1 :=  K * 1.62256085901318900110;
        C2 :=  K * 0.73615247289103711048;
        C3 :=  K * 1.27505348516474687668;
        C4 :=  K * 0.68192513359404878555;
        C5 :=  K * 1.41192522499767709482;
        C6 :=  K * 0.41731164899822221856;
        C7 :=  K * 0.97708746577612732937;
        C8 := -K * 1.24019323711628075418;
        C9 :=  K * 0.37406491420052164643;
        C10 :=  K * 1.56258258183242076734;
        C11 :=  K * 0.22608594852334417053;
        C12 :=  K * 0.54903018881382301544;
        C13 :=  K * 1.29766192824124226072;
        C14 :=  K * 0.53735709817992773611;
        C15 := -K * 0.89432492620515598928;
        C16 :=  K * 1.08882668712879343324;
        C17 :=  K * 1.44516984663000507153;
        C18 :=  K * 0.36797326698102989327;
        C19 := -K * 0.22403809582030673061;
        C20 :=  K * 0.79423728881846247133;
        C21 := -K * 1.26218356029207689634;
        C22 :=  K * 0.84929310097390356928;
        C23 :=  K * 1.12430505507795879762;
        C24 :=  K * 0.53735709817992773611;
        C25 := -K * 0.15870362619123762161;
        C26 := -K * 1.40006206550619499505;
        C27 :=  K * 0.66217081689668947425;
        C28 :=  K * 1.14691349815445418167;
        C29 :=  K * 0.39278906276580668667;
        C30 :=  K * 1.27002993817578340120;
        C31 :=  K * 0.37537277356746589943;
        C32 :=  K * 0.66644292401623871125;
        C33 := -K * 1.14629537825375493978;
        C34 :=  K * 0.38733027979971282029;
        C35 :=  K * 1.27270129927214827777;
        C36 :=  K * 0.37198208022459751729;

        Vx[ 0,0] :=   0; Vy[ 0,0] :=   0; Vz[ 0] :=  C1;
        Vx[ 1,0] :=   0; Vy[ 1,0] :=   0; Vz[ 1] := -C1;
        Vx[ 2,0] :=  C2; Vy[ 2,0] :=  C3; Vz[ 2] :=  C4;
        Vx[ 3,0] :=  C5; Vy[ 3,0] :=  C6; Vz[ 3] := -C4;
        Vx[ 4,0] :=  C7; Vy[ 4,0] :=  C8; Vz[ 4] :=  C9;
        Vx[ 5,0] := C10; Vy[ 5,0] := C11; Vz[ 5] := -C9;
        Vx[ 6,0] := C12; Vy[ 6,0] := C13; Vz[ 6] := C14;
        Vx[ 7,0] := C15; Vy[ 7,0] := C16; Vz[ 7] :=-C14;
        Vx[ 8,0] := C17; Vy[ 8,0] := C18; Vz[ 8] := C19;
        Vx[ 9,0] := C20; Vy[ 9,0] := C21; Vz[ 9] :=-C19;
        Vx[10,0] := C22; Vy[10,0] := C23; Vz[10] := C24;
        Vx[11,0] := C25; Vy[11,0] := C26; Vz[11] :=-C24;
        Vx[12,0] := C27; Vy[12,0] := C28; Vz[12] := C29;
        Vx[13,0] := C30; Vy[13,0] := C31; Vz[13] :=-C29;
        Vx[14,0] := C32; Vy[14,0] := C33; Vz[14] := C34;
        Vx[15,0] := C35; Vy[15,0] := C36; Vz[15] :=-C34;

        cos1 := cos(Pi*2/3);
        sin1 := sin(Pi*2/3);
        cos2 := cos(Pi*4/3);
        sin2 := sin(Pi*4/3);

        for i := 0 to 15 do begin
            Vx[i,1] := Vx[i,0] * cos1 - Vy[i,0] * sin1;
            Vy[i,1] := Vx[i,0] * sin1 + Vy[i,0] * cos1;
            Vx[i,2] := Vx[i,0] * cos2 - Vy[i,0] * sin2;
            Vy[i,2] := Vx[i,0] * sin2 + Vy[i,0] * cos2;
        end;

        D  := K * 0.76354179359415624268;

        A1 := arctan(15.30294839036799782998); // 86.26121507645540148373 degs
        A2 := Pi-arctan(4.03169449292322474606); // 103.9302130979232371562 degs
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2-A1; -A2; -A1; 0; A1; A2; A2+A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = "N1;      0;        N2" />
        <Axis NormVector = "N1*cos1; N1*sin1;  N2" />
        <Axis NormVector = "N1*cos2; N1*sin2;  N2" />
        <Axis NormVector = "N3;      N4;      -N2" />
        <Axis NormVector = "N3*cos1+N4*sin1; -N3*sin1+N4*cos1; -N2" />
        <Axis NormVector = "N3*cos2+N4*sin2; -N3*sin2+N4*cos2; -N2" />
    </Axes>

