<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Triangulator</Name>
        <Menu>Other forms\Unclassified\Triangulator</Menu>
        <Inventor>Evgeniy Grigoriev, Aleh Hladzilin</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-06-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9047</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=36975</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPink   := 'FF69B4';

        R := 0.7;

        for i := 0 to 5 do begin
            x[i] := R * sin(Pi / 3 * i);
            y[i] := R * cos(Pi / 3 * i);
        end;

        H := R / sqrt(2);
        az := R / sqrt(2) / 2;
        D := H / 3;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "0; 2 * Pi / 3" PlaneDistances = "D*1.5" >
        <Axis NormVector = " x[1]; y[1]; az" BaseVector = "0;0;-D/2" />
        <Axis NormVector = " x[3]; y[3]; az" BaseVector = "0;0;-D/2" />
        <Axis NormVector = " x[5]; y[5]; az" BaseVector = "0;0;-D/2" />
    </Axes>

    <Figure>
        <Macro Name = "Body" >
            <Part>
                <Vertices>
                    <Add Vector = "x[0]; y[0]; H+D" />
                    <Add Vector = "x[2]; y[2]; H+D" />
                    <Add Vector = "x[4]; y[4]; H+D" />
                    <Add Vector = "x[1]; y[1];-H+D" />
                    <Add Vector = "x[3]; y[3];-H+D" />
                    <Add Vector = "x[5]; y[5];-H+D" />
                </Vertices>

                <Faces>
                    <Face Color = "clWhite"  VertexIndexes = "2;1;0" />
                    <Face Color = "clYellow" VertexIndexes = "3;4;5" />

                    <Face Color = "clRed"    VertexIndexes = "0;1;3" />
                    <Face Color = "clBlue"   VertexIndexes = "1;2;4" />
                    <Face Color = "clGreen"  VertexIndexes = "2;0;5" />

                    <Face Color = "clOrange" VertexIndexes = "4;3;1" />
                    <Face Color = "clCyan"   VertexIndexes = "5;4;2" />
                    <Face Color = "clPink"   VertexIndexes = "3;5;0" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "Body" />

        <SplitByAxes/>

        <HideContaining Vector = "0;0;0" />
        <Cut><Plane NormVector = "0;0;-1" NormDistance = "0" /></Cut>
        <HideAll/>

        <ExecMacro MacroName = "Body" />
        <Split Axis = "0" From = "1" />
        <Split Color2 = "clRed"   Axis = "1" From = "1" />
        <Split Color2 = "clBlue"  Axis = "2" From = "1" />
        <Split Color2 = "clGreen" Axis = "3" From = "1" />

        <HideContaining Vector = "x[1]*0.6; y[1]*0.6; az" />
        <HideContaining Vector = "x[3]*0.6; y[3]*0.6; az" />
        <HideContaining Vector = "x[5]*0.6; y[5]*0.6; az" />
        <RemoveAllVisible/>
        <ShowAll/>
        <Cut Color = "clWhite" ><Plane NormVector = "0; 0;-1" NormDistance = "-2*D" /></Cut>

        <Turn  Axis = "1" Layer = "1" Angle = "2 * Pi / 3" />
        <Turn  Axis = "2" Layer = "1" Angle = "2 * Pi / 3" />
        <Turn  Axis = "3" Layer = "1" Angle = "2 * Pi / 3" />
        <Split Axis = "0" From = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = "2 * Pi / 3" />
        <Turn  Axis = "2" Layer = "1" Angle = "2 * Pi / 3" />
        <Turn  Axis = "3" Layer = "1" Angle = "2 * Pi / 3" />
        <Split Axis = "0" From = "1" />
        <Undo Repeat = "6" />

        <HideContaining Vector = "0; 0;-H+D " />
        <InvertVisibility/>
        <Split><Plane NormVector = "x[1]; y[1]; az" NormDistance = "-D*2/3" /></Split>
        <Split><Plane NormVector = "x[3]; y[3]; az" NormDistance = "-D*2/3" /></Split>
        <Split><Plane NormVector = "x[5]; y[5]; az" NormDistance = "-D*2/3" /></Split>
        <ShowAll/>
    </Figure>
</xml>
