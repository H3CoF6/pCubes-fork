<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>PentaJumble</Name>
        <Menu>Other forms\Unclassified\PentaJumble</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-29</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2929</Link>
    </Interface>

    <Script>
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clPurple := '800080';

        X1 := 0.18;
        X2 := X1 * (1 + sqrt(5)) / 2;
        X3 := X2 + X1;
        z1 := X1 * sqrt((sqrt(5) + 2) / 2);
        Z2 := z1 * sqrt(5);

        D := Z2 * X2 / sqrt(X2^2 + (z1 + Z2)^2);

        pA1 := z1 + Z2;
        pA2 := X2;

        A1  := 2*Pi/5;

        dt  := X1;
    </Script>

    <Axes TurningAngles = "0; A1" PlaneDistances = "D" >
        <Axis NormVector = "   0; pA1; pA2" />
        <Axis NormVector = "   0;-pA1; pA2" />
        <Axis NormVector = " pA1;   0;-pA2" />
        <Axis NormVector = "-pA1;   0;-pA2" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;  X1;  Z2" />
                <Add Vector = "   0; -X1;  Z2" />

                <Add Vector = " X3;  X2;  z1" />
                <Add Vector = " X3; -X2;  z1" />
                <Add Vector = "-X3; -X2;  z1" />
                <Add Vector = "-X3;  X2;  z1" />

                <Add Vector = " X2;  X3; -z1" />
                <Add Vector = " X2; -X3; -z1" />
                <Add Vector = "-X2; -X3; -z1" />
                <Add Vector = "-X2;  X3; -z1" />

                <Add Vector = " X1;    0; -Z2" />
                <Add Vector = "-X1;    0; -Z2" />
            </Vertices>

            <Faces>
                <Face Color = "clCyan  " VertexIndexes = " 0; 1; 3; 2" />
                <Face Color = "clPink  " VertexIndexes = " 1; 0; 5; 4" />

                <Face Color = "clYellow" VertexIndexes = " 1; 4; 8; 7; 3" />
                <Face Color = "clRed   " VertexIndexes = " 0; 2; 6; 9; 5" />
                <Face Color = "clGreen " VertexIndexes = " 2; 3; 7;10; 6" />
                <Face Color = "clOrange" VertexIndexes = " 4; 5; 9;11; 8" />

                <Face Color = "clBlue  " VertexIndexes = " 7; 8;11;10" />
                <Face Color = "clPurple" VertexIndexes = " 9; 6;10;11" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "4"/>

        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "4"/>

        <HideContaining Vector = " X2; X3;-Z1" />
        <HideContaining Vector = " X2;-X3;-Z1" />
        <HideContaining Vector = "-X2;-X3;-Z1" />
        <HideContaining Vector = "-X2; X3;-Z1" />

        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "3" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "0" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "1" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "14"/>

        <ShowAll/>

        <HideContaining Vector = " X3; X2; Z1" />
        <HideContaining Vector = " X3;-X2; Z1" />
        <HideContaining Vector = "-X3;-X2; Z1" />
        <HideContaining Vector = "-X3; X2; Z1" />

        <HideContaining Vector = " (X3-dt); (X2-dt); Z1" />
        <HideContaining Vector = " (X3-dt);-(X2-dt); Z1" />
        <HideContaining Vector = "-(X3-dt);-(X2-dt); Z1" />
        <HideContaining Vector = "-(X3-dt); (X2-dt); Z1" />

        <Turn Axis = "2" Angle = "A1" Layer = "1" />
        <Turn Axis = "3" Angle = "A1" Layer = "1" />
        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "1" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "2" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "3" Angle = "-2*A1" Layer = "1" />
        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "14"/>

        <ShowAll/>

        <Hide Axis = "2" Layer = "0"/>
        <Hide Axis = "0" Layer = "1"/>
        <Hide Axis = "1" Layer = "1"/>
        <Turn Axis = "2" Angle = "-A1" Layer = "1" />
        <Turn Axis = "0" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "2"/>

        <ShowAll/>

        <Hide Axis = "3" Layer = "0"/>
        <Hide Axis = "0" Layer = "1"/>
        <Hide Axis = "1" Layer = "1"/>
        <Turn Axis = "3" Angle = "-A1" Layer = "1" />
        <Turn Axis = "1" Angle = "A1" Layer = "1" />
        <SplitByAxes/>
        <Undo Repeat = "2"/>

        <ShowAll/>

    </Figure>
</xml>
