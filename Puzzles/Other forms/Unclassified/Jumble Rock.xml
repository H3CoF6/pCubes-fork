    <Script>
        clRed          := 'FF0000';
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';

        clOlive        := '808000';
        clCyan         := '00DCB4';
        clLightBlue    := '2828FF';
        clLightViolett := 'FF0080';
        clLightGreen   := '00FF00';
        clBrown        := '800000';

        clViolett      := '800080';
        clGray         := 'AAAAAA';
        clTeal         := '008080';
        clCoral        := 'FF7F50';
        clLime         := '00FF00';
        clDarkGreen    := '006400';
        clFuchsia      := 'FF00FF';
        clPurple       := '800080';
        clPink         := 'FF69B4';
        clPale         := 'DB7093';

        // Pentagons
        cl[ 0] := clBlue;
        cl[ 1] := clYellow;
        cl[ 2] := clRed;
        cl[ 3] := clWhite;
        cl[ 4] := clOrange;
        cl[ 5] := clGreen;

        // Rhombi
        cl[ 6] := clLightGreen;
        cl[ 7] := clCyan;
        cl[ 8] := clCoral;
        cl[ 9] := clLightViolett;
        cl[10] := clFuchsia;
        cl[11] := clLightBlue;

        // Non turning faces
        cl[12] := clViolett;
        cl[13] := clBrown;
        cl[14] := clGray;
        cl[15] := clOlive;
        cl[16] := clTeal;
        cl[17] := clPale;

        W := 0.7;

        ay0 := sqrt((3 - sqrt(3)) * 2) / 3;
        az := sqrt(sqrt(3)*2 + 3) / 3;
        by0 := -sqrt((3 - sqrt(3)) * 6) / 3;
        bz := sqrt((sqrt(3)*2 - 3) / 3);

        for i := 0 to 2 do begin
            ax[i]   := ay0 * sin(Pi*2/3 * i);
            ay[i]   := ay0 * cos(Pi*2/3 * i);
            ax[i+3] := ay0 * cos(Pi*2/3 * i);
            ay[i+3] := ay0 * sin(Pi*2/3 * i);

            bx[i]   := by0 * sin(Pi*2/3 * i);
            by[i]   := by0 * cos(Pi*2/3 * i);
            bx[i+3] := by0 * cos(Pi*2/3 * i);
            by[i+3] := by0 * sin(Pi*2/3 * i);
        end;

        z0 := W;
        y1 := W * (-0.57039978477823479531); // (-sqrt(sqrt(3)-1)) * 2/3;    
        z1 := W *   0.82136720504591819568;  // (sqrt(3)*2-1) / 3;           
        x2 := W *   0.49398070393112768953;  // sqrt((sqrt(3)-1)*3) / 3;     
        y2 := W * (-0.70276151547313798139); // (-sqrt(sqrt(3)*17-25)) / 3;  
        z2 := W *   0.51196612828741513765;  // (5-sqrt(3)*2) / 3;           
        x3 := W * (-0.98796140786225537905); // (-sqrt((sqrt(3)-1)*3)) * 2/3;
        z3 := W *   0.15470053837925152902;  // (sqrt(3)*2-3) / 3;           
        x4 := W *   0.45476241335486007883;
        y4 := W * (-0.77068958733723318654);
        z4 := W *   0.35318142166156464492;
        x5 := W * (-0.90952482670972015767);
        z5 := W *   0.31348524500510202174;
        x6 := W * (-0.87030653613345254698);
        y6 := W * (-0.14636465301663042653);
        z6 := W *   0.22181085189147148603;
        x7 := W *   0.60112706637149050537;
        y7 := W * (-0.56246395312297008093);
        z7 := W *   0.49778405031714534488;

        vx[ 0,0] :=  0;        vy[ 0,0] :=  0;        vz[ 0] :=  z0;
        vx[ 1,0] :=  0;        vy[ 1,0] :=  0;        vz[ 1] := -z0;

        vx[ 2,0] :=  0;        vy[ 2,0] :=  y1;       vz[ 2] :=  z1;
        vx[ 3,0] :=  y1;       vy[ 3,0] :=  0;        vz[ 3] := -z1;

        vx[ 4,0] :=  x2;       vy[ 4,0] :=  y2;       vz[ 4] :=  z2;
        vx[ 5,0] := -x2;       vy[ 5,0] :=  y2;       vz[ 5] :=  z2;
        vx[ 6,0] :=  y2;       vy[ 6,0] :=  x2;       vz[ 6] := -z2;
        vx[ 7,0] :=  y2;       vy[ 7,0] := -x2;       vz[ 7] := -z2;

        vx[ 8,0] :=  x3;       vy[ 8,0] :=  0;        vz[ 8] :=  z3;
        vx[ 9,0] := -x3;       vy[ 9,0] :=  0;        vz[ 9] :=  z3;
        vx[10,0] :=  0;        vy[10,0] :=  x3;       vz[10] := -z3;
        vx[11,0] :=  0;        vy[11,0] := -x3;       vz[11] := -z3;

        vx[12,0] :=  x4;       vy[12,0] :=  y4;       vz[12] :=  z4;
        vx[13,0] := -x4;       vy[13,0] :=  y4;       vz[13] :=  z4;
        vx[14,0] :=  y4;       vy[14,0] :=  x4;       vz[14] := -z4;
        vx[15,0] :=  y4;       vy[15,0] := -x4;       vz[15] := -z4;

        vx[16,0] :=  x5;       vy[16,0] :=  0;        vz[16] :=  z5;
        vx[17,0] := -x5;       vy[17,0] :=  0;        vz[17] :=  z5;
        vx[18,0] :=  0;        vy[18,0] :=  x5;       vz[18] := -z5;
        vx[19,0] :=  0;        vy[19,0] := -x5;       vz[19] := -z5;

        vx[20,0] :=  x6;       vy[20,0] :=  y6;       vz[20] :=  z6;
        vx[21,0] := -x6;       vy[21,0] :=  y6;       vz[21] :=  z6;
        vx[22,0] :=  y6;       vy[22,0] :=  x6;       vz[22] := -z6;
        vx[23,0] :=  y6;       vy[23,0] := -x6;       vz[23] := -z6;

        vx[24,0] :=  x7;       vy[24,0] :=  y7;       vz[24] :=  z7;
        vx[25,0] := -x7;       vy[25,0] :=  y7;       vz[25] :=  z7;
        vx[26,0] :=  y7;       vy[26,0] :=  x7;       vz[26] := -z7;
        vx[27,0] :=  y7;       vy[27,0] := -x7;       vz[27] := -z7;

        vx[28,0] :=  x4+x7-x2; vy[28,0] :=  y4+y7-y2; vz[28] :=  z4+z7-z2;
        vx[29,0] := -x4-x7+x2; vy[29,0] :=  y4+y7-y2; vz[29] :=  z4+z7-z2;
        vx[30,0] :=  y4+y7-y2; vy[30,0] :=  x4+x7-x2; vz[30] := -z4-z7+z2;
        vx[31,0] :=  y4+y7-y2; vy[31,0] := -x4-x7+x2; vz[31] := -z4-z7+z2;

        cos1 := cos(Pi*2/3);
        sin1 := sin(Pi*2/3);
        cos2 := cos(Pi*4/3);
        sin2 := sin(Pi*4/3);

        for i := 0 to 31 do begin
            vx[i,1] := vx[i,0] * cos1 - vy[i,0] * sin1;
            vy[i,1] := vx[i,0] * sin1 + vy[i,0] * cos1;
            vx[i,2] := vx[i,0] * cos2 - vy[i,0] * sin2;
            vy[i,2] := vx[i,0] * sin2 + vy[i,0] * cos2;
        end;

        D := W * 0.71291867674665091885;
        angle := arctan(sqrt(sqrt(3)*2+3)); // 1.196061894086157 = 68.529deg
    </Script>

