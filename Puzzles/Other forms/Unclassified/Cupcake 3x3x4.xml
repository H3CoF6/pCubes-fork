<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cupcake 3x3x4</Name>
        <Menu>Other forms\Unclassified\Cupcake 3x3x4</Menu>
        <Inventor>Javier Alla La</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2021-11-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9245</Link>
    </Interface>

    <Script>
        Color1 := 'b57b55';
        Color2 := '498384';
        Color3 := '77a342';
        R1 := 0.4;
        R2 := 0.5;
        R3 := 0.6;
        D  := R1 / 4;
        H  := 3 * D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-2*D; 0; 2*D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Cylinder Radius = "R1" Color = "Color1" Base = "0; 0; D" Top = "0; 0; H" >
               <Base Color = "Color1" />
               <Top  Color = "Color1" />
        </Cylinder>
        <Cylinder Radius = "R2" Color = "Color2" Base = "0; 0;-D" Top = "0; 0; D" >
               <Base Color = "Color2" />
               <Top  Color = "Color2" />
        </Cylinder>
        <Cylinder Radius = "R3" Color = "Color3" Base = "0; 0;-H" Top = "0; 0;-D" >
               <Base Color = "Color3" />
               <Top  Color = "Color3" />
        </Cylinder>

        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
