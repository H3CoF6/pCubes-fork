<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Rocket Twist</Name>
        <Menu>Other forms\Unclassified\Rocket Twist</Menu>
        <Inventor>Oskar Van Deventer</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-08-16</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7576</Link>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Dodecahedron_Coordinates.inc';

        D := -R * sqrt((85 - 38 * sqrt(5)) / 15);
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "D" NormVectors = " Cx; Cy; Cz" TurnAxesWithPartNo = "0" />

    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "Cut" >
            <Cut Color = "Color" > <Plane NormVector = "-Cx[ax];-Cy[ax];-Cz[ax]" NormDistance = "-R2Sin" /> </Cut>
        </Macro>
        <Macro Name = "Split" >
            <Split> <Plane NormVector = " Cx[ax]; Cy[ax]; Cz[ax]" NormDistance = "D" /> </Split>
        </Macro>

        <ExecMacro MacroName = "Cut" Ax = " 1" Color = "clRed   " />
        <ExecMacro MacroName = "Cut" Ax = " 4" Color = "clGreen " />
        <ExecMacro MacroName = "Cut" Ax = "10" Color = "clYellow" />

        <ExecMacro MacroName = "Split" Ax = " 1" />
        <ExecMacro MacroName = "Split" Ax = " 4" />
        <ExecMacro MacroName = "Split" Ax = "10" />

        <Macro Name = "Vertex" >
            <HideContaining Vector = " Vx[v]; Vy[v]; Vz[v]" />
            <InvertVisibility/>
            <ExecMacro MacroName = "Split" />
            <ExecMacro MacroName = "Cut" Color = "clBlue" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "Vertex" v = "14" ax = "11" />
        <ExecMacro MacroName = "Vertex" v = "15" ax = " 7" />
        <ExecMacro MacroName = "Vertex" v = "18" ax = " 8" />

        <Macro Name = "CutVertex" >
            <HideContaining Vector = " Vx[v]; Vy[v]; Vz[v]" />
            <InvertVisibility/>
            <ExecMacro MacroName = "Split" ax = "c1" />
            <ExecMacro MacroName = "Split" ax = "c2" />
            <ExecMacro MacroName = "Split" ax = "c3" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "CutVertex" v = " 2" c1 = " 7" c2 = " 8" c3 = "11" />
        <ExecMacro MacroName = "CutVertex" v = "14" c1 = " 2" c2 = " 3" c3 = "10" />
        <ExecMacro MacroName = "CutVertex" v = "15" c1 = " 0" c2 = " 3" c3 = " 4" />
        <ExecMacro MacroName = "CutVertex" v = "18" c1 = " 0" c2 = " 1" c3 = " 2" />

        <Macro Name = "CutBottom" >
            <Hide Axis = "c1" Layer = "1" />
            <Hide Axis = "c2" Layer = "1" />
            <ExecMacro MacroName = "Cut" ax = "c3" Color = "clBlue" />
            <ShowAll/>
        </Macro>
        <ExecMacro MacroName = "CutBottom" c1 = " 1" c2 = " 4" c3 = "11" />
        <ExecMacro MacroName = "CutBottom" c1 = " 4" c2 = "10" c3 = " 8" />
        <ExecMacro MacroName = "CutBottom" c1 = "10" c2 = " 1" c3 = " 7" />

        <RemoveGrayParts/>

        <Turn NormVector = "0;0;1" Angle = "-sAngle" />
        <Turn NormVector = "1;0;0" Angle = "Arctan(-RCos/RSin)" />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>

