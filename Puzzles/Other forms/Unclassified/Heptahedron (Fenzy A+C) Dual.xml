<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Heptahedron (Fenzy A+C) Dual</Name>
        <Menu>Other forms\Unclassified\Heptahedron (Fenzy A+C) Dual</Menu>
        <Inventor></Inventor>
        <Programmer>uot</Programmer>
        <Added>2020-08-13</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'FAFAFA';
        clYellow := 'F0E400';
        clBlue   := '1010D0';
        clRed    := 'C80000';
        clOrange := 'F07000';
        clGreen  := '008000';
        clViolet := '640064';
        clGray   := '5F5F5F';

        clCyan   := '20D0C0';
        clPink   := 'E860C0';

        K  := 0.65;

        // angle between axes = 77.869542155423386806 degs
        N1 := -0.72565450331380011592;
        N2 :=  0.68805925749197071360;
        N3 :=  0.97767166754628583615;
        N4 := -0.21013831273060308487;

        C1 :=  K * N1;
        C2 :=  K * N2;
        C3 :=  K * N3;
        C4 :=  K * N4;
        C5 := -K * 0.70377334265892079372;
        C6 := -K * 0.30253457818265076326;
        C7 := -K;

        Vx[ 0,0] :=  C1;  Vy[ 0,0] :=  0;  Vz[ 0] :=  C2;
        Vx[ 1,0] :=  C3;  Vy[ 1,0] :=  0;  Vz[ 1] :=  C4;
        Vx[ 2,0] :=  C5;  Vy[ 2,0] :=  0;  Vz[ 2] :=  C6;
        Vx[ 3,0] :=   0;  Vy[ 3,0] :=  0;  Vz[ 3] :=  C7;

        cos1 := cos(Pi*2/3);
        sin1 := sin(Pi*2/3);
        cos2 := cos(Pi*4/3);
        sin2 := sin(Pi*4/3);

        for i := 0 to 3 do begin
            Vx[i,1] := Vx[i,0] * cos1 - Vy[i,0] * sin1;
            Vy[i,1] := Vx[i,0] * sin1 + Vy[i,0] * cos1;
            Vx[i,2] := Vx[i,0] * cos2 - Vy[i,0] * sin2;
            Vy[i,2] := Vx[i,0] * sin2 + Vy[i,0] * cos2;
        end;

        D  := K * 0.43376283428410288621;
        A1 := Pi * 4/9; // 80 degs
        A2 := Pi * 7/9; // 140 degs
        A3 := Pi * 2/9; // 40 degs
    </Script>

    <Axes TurningAngles = "Pi*2" AvailableAngles = "-A1*3; -A1*2; -A1; 0; A1; A1*2; A1*3" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " N1;      0;       N2" />
        <Axis NormVector = " N1*cos1; N1*sin1; N2" />
        <Axis NormVector = " N1*cos2; N1*sin2; N2" />
    </Axes>

    <Axes TurningAngles = "Pi*2" AvailableAngles = "-A2; -A1; 0; A1; A2" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " N3;      0;       N4" />
        <Axis NormVector = " N3*cos1; N3*sin1; N4" />
        <Axis NormVector = " N3*cos2; N3*sin2; N4" />
    </Axes>

    <Axes TurningAngles = "Pi*2/3"  PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = " 0; 0;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[ 0,0]; Vy[ 0,0]; Vz[ 0]" />
                <Add Vector = "Vx[ 0,1]; Vy[ 0,1]; Vz[ 0]" />
                <Add Vector = "Vx[ 0,2]; Vy[ 0,2]; Vz[ 0]" />
                <Add Vector = "Vx[ 1,0]; Vy[ 1,0]; Vz[ 1]" />
                <Add Vector = "Vx[ 1,1]; Vy[ 1,1]; Vz[ 1]" />
                <Add Vector = "Vx[ 1,2]; Vy[ 1,2]; Vz[ 1]" />
                <Add Vector = "Vx[ 2,0]; Vy[ 2,0]; Vz[ 2]" />
                <Add Vector = "Vx[ 2,1]; Vy[ 2,1]; Vz[ 2]" />
                <Add Vector = "Vx[ 2,2]; Vy[ 2,2]; Vz[ 2]" />
                <Add Vector = "Vx[ 3,0]; Vy[ 3,0]; Vz[ 3]" />
            </Vertices>

            <Faces>
                <Face Color = "clViolet" VertexIndexes = "0;1;2" />
                <Face Color = "clWhite"  VertexIndexes = "0;5;1" />
                <Face Color = "clOrange" VertexIndexes = "1;3;2" />
                <Face Color = "clRed"    VertexIndexes = "2;4;0" />
                <Face Color = "clGreen"  VertexIndexes = "0;6;5" InvisibleEdges = "1" />
                <Face Color = "clGreen"  VertexIndexes = "0;4;6" InvisibleEdges = "4" />
                <Face Color = "clBlue"   VertexIndexes = "1;7;3" InvisibleEdges = "1" />
                <Face Color = "clBlue"   VertexIndexes = "1;5;7" InvisibleEdges = "4" />
                <Face Color = "clYellow" VertexIndexes = "2;8;4" InvisibleEdges = "1" />
                <Face Color = "clYellow" VertexIndexes = "2;3;8" InvisibleEdges = "4" />

                <Face Color = "clGray"   VertexIndexes = "3;9;8" InvisibleEdges = "2" />
                <Face Color = "clGray"   VertexIndexes = "4;8;9" InvisibleEdges = "2" />
                <Face Color = "clPink"   VertexIndexes = "3;7;9" InvisibleEdges = "2" />
                <Face Color = "clPink"   VertexIndexes = "5;9;7" InvisibleEdges = "2" />
                <Face Color = "clCyan"   VertexIndexes = "4;9;6" InvisibleEdges = "2" />
                <Face Color = "clCyan"   VertexIndexes = "5;6;9" InvisibleEdges = "2" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "0" Layer = "1" Angle = "-A1" />
        <Hide  Axis = "2" Layer = "0" />
        <Split Axis = "4" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Turn  Axis = "1" Layer = "1" Angle = "-A1" />
        <Hide  Axis = "0" Layer = "0" />
        <Split Axis = "5" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Turn  Axis = "2" Layer = "1" Angle = "-A1" />
        <Hide  Axis = "1" Layer = "0" />
        <Split Axis = "3" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Turn  Axis = "0" Layer = "1" Angle = "A1" />
        <Hide  Axis = "1" Layer = "0" />
        <Split Axis = "5" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Turn  Axis = "1" Layer = "1" Angle = "A1" />
        <Hide  Axis = "2" Layer = "0" />
        <Split Axis = "3" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Turn  Axis = "2" Layer = "1" Angle = "A1" />
        <Hide  Axis = "0" Layer = "0" />
        <Split Axis = "4" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Hide  Axis = "6" Layer = "0" />
        <Turn  Axis = "3" Layer = "1" Angle = "A1" />
        <Turn  Axis = "4" Layer = "1" Angle = "A1" />
        <Turn  Axis = "5" Layer = "1" Angle = "A1" />
        <Split Axis = "6" From = "1"/>
        <Turn  Axis = "3" Layer = "1" Angle = "-A1*2" />
        <Turn  Axis = "4" Layer = "1" Angle = "-A1*2" />
        <Turn  Axis = "5" Layer = "1" Angle = "-A1*2" />
        <Split Axis = "6" From = "1"/>
        <Turn  Axis = "3" Layer = "1" Angle = "A1" />
        <Turn  Axis = "4" Layer = "1" Angle = "A1" />
        <Turn  Axis = "5" Layer = "1" Angle = "A1" />
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
