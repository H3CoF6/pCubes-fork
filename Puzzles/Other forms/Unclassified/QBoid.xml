<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>QBoid 1x2x3</Name>
        <Menu>Other forms\Unclassified\QBoid 1x2x3</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2019-11-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=881</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clBlack  := '000000';

        W  := 0.6;
        H  := W / 4;
        H2 := H / 6;
        B  := 2 * W / 3;
        B2 := W / 2;
        A  := W / 3;

        D := W / 3;
    </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "-D; D">
        <Axis NormVector = "1; 0; 0" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "0">
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-A;  -B;  -H" />
                <Add Vector = "-A;  -B;   H" />
                <Add Vector = "-A;   B;  -H" />
                <Add Vector = "-A;   B;   H" />
                <Add Vector = " A;  -B;  -H" />
                <Add Vector = " A;  -B;   H" />
                <Add Vector = " A;   B;  -H" />
                <Add Vector = " A;   B;   H" />
                <Add Vector = "-W; -B2; -H2" />
                <Add Vector = "-W; -B2;  H2" />
                <Add Vector = "-W;  B2; -H2" />
                <Add Vector = "-W;  B2;  H2" />
                <Add Vector = " W; -B2; -H2" />
                <Add Vector = " W; -B2;  H2" />
                <Add Vector = " W;  B2; -H2" />
                <Add Vector = " W;  B2;  H2" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = " 0; 1; 9; 8" />
                <Face Color = "clWhite " VertexIndexes = " 5; 4;12;13" />
                <Face Color = "clWhite " VertexIndexes = " 1; 0; 4; 5" />
                <Face Color = "clOrange" VertexIndexes = " 6; 7;15;14" />
                <Face Color = "clOrange" VertexIndexes = " 3; 2;10;11" />
                <Face Color = "clOrange" VertexIndexes = " 2; 3; 7; 6" />
                <Face Color = "clYellow" VertexIndexes = " 6; 4; 0; 2" />
                <Face Color = "clYellow" VertexIndexes = " 2; 0; 8;10" />
                <Face Color = "clYellow" VertexIndexes = " 4; 6;14;12" />
                <Face Color = "clRed   " VertexIndexes = " 3; 1; 5; 7" />
                <Face Color = "clRed   " VertexIndexes = "13;15; 7; 5" />
                <Face Color = "clRed   " VertexIndexes = "11; 9; 1; 3" />
                <Face Color = "clBlack " VertexIndexes = " 8; 9;11;10" />
                <Face Color = "clBlack " VertexIndexes = "13;12;14;15" />
            </Faces>
        </Part>

        <SplitByAxes />

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
