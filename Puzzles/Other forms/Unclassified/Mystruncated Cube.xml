<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mystruncated Cube</Name>
        <Menu>Other forms\Unclassified\Mystruncated Cube</Menu>
        <Inventor>Dragan Tutić</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-01-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3164</Link>
    </Interface>

    <Script>
        W := 0.5;
        D1 := W * 1 / 3;
        DCut1 := D1 * sqrt(3);
        DCut2 := DCut1 * 5 / 3;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <ShowAll/>

        <Cut Color = "bbbbbb"> <Plane NormVector = " 1;-1; 1" NormDistance = "-DCut1" /> </Cut>
        <Cut Color = "bbbbba"> <Plane NormVector = "-1; 1;-1" NormDistance = "-DCut2" /> </Cut>

        <Split Axis = "0" From  = "2" />
        <Split Axis = "1" From  = "1" />
        <Split Axis = "2" From  = "2" />
        <HideContaining Vector = "0; 0; 0" />
        <SplitByAxes/>
        <ShowAll/>
    </Figure>
</xml>
