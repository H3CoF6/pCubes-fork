    <Script>
        clOrange := 'FF800A';
        clGreen  := '009600';
        clPurple := '5800D3';
		clBlack  := '333333';
		
        s5 := sqrt(5);

        Scale := 1;
        C0 := Scale * (3 * s5 + 1) / 44;
        C1 := Scale * (s5 - 1) / 6;
        C2 := Scale * (s5 + 4) / 22;
        C3 := Scale * sqrt((5 - s5) / 30);
        C4 := Scale / 3;
        C5 := Scale * (5 * s5 + 9) / 44;
        C6 := Scale * sqrt((5 + s5) / 30);
        C7 := Scale * (s5 + 1) / 6;
		C8 := (C3 + C6) / 3;
		C9 := (C3 + C6 * 2) / 3;
		CA := C6 / 3;
    </Script>

