        Colors[14] := 'FF700A';
        Colors[15] := '4D1340';
        Colors[16] := '9E0000';
        Colors[17] := '7F7040';

        R := 0.5;
        Pillow := 1.1;
        R1 := R * cos(Pi/6);

        D := R * sqrt(6)/4;

        H := D * sqrt(3);
        H1 := H / 2;
        H2 := H / 3;

        for i := 0 to 5 do begin
            ax[i] := cos(Pi/3 * i);
            ay[i] := sin(Pi/3 * i);

            x1[i] := R1 * cos(Pi/3 * (i - 0.5));
            y1[i] := R1 * sin(Pi/3 * (i - 0.5));
            x2[i] := R * cos(Pi/3 * i);
            y2[i] := R * sin(Pi/3 * i);

            x20[i] := x2[i] / 2 * Pillow;
            y20[i] := y2[i] / 2 * Pillow;
            x30[i] := x1[i] * Pillow;
            y30[i] := y1[i] * Pillow;
        end;
        az := 1/sqrt(2);
        z20 := (H + H / 3) / 2 * Pillow;
    </Script>

