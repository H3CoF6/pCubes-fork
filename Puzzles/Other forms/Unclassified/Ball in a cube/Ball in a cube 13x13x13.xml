<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ball in a cube 13x13x13</Name>
        <Menu>Other forms\Unclassified\Ball in a cube\Ball in a cube 13x13x13</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-03-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5310</Link>
    </Interface>                   

    <Script>
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clBlue   := '0000A0';
        clGreen  := '008000';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W * 0.065;
        K := 0.6;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-11*D; -9*D; -7*D; -5*D; -3*D; -D; D; 3*D; 5*D; 7*D; 9*D; 11*D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "12" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "12" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "12" />

        <RemoveContaining Vector = " 0; 0; 0" />
        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "12" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "12" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "12" />

        <RemoveContaining Vector = " 0; 0; 0" />
        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <HideContaining Vector = " 0; 0;-W" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
