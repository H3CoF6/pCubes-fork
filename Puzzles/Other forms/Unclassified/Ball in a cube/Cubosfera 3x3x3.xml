<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cubosfera 3x3x3</Name>
        <Menu>Other forms\Unclassified\Ball in a cube\Cubosfera 3x3x3</Menu>
        <Menu>Other forms\3x3x3 variants\Cubosfera 3x3x3</Menu>
        <Aliases>Tire with internal structure fail</Aliases>
        <Inventor>Joachim Solborg</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2022-06-05</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=8621</Link>
    </Interface>                   

    <Script>
        W := 0.5;
        D  := W / 3;
        DW := D;
        Delta := W * 0.01;
        K  := sqrt((DW + D)^2 * 2 + (W - DW)^2);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "1" />
        <RemoveContaining Vector = "0;0;0"/>
        <HideAll/>

        <Transfer Vector = " DW; DW;-DW" />
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <Transfer Vector = "-DW;-DW; DW" />

        <Cut Axis = "0" To = "2" />
        <Cut Axis = "1" To = "2" />
        <Cut Axis = "2" From = "1" />
        <HideAll/>

        <Macro Name = "AddSegments" >
            <Transfer Vector = " DW; DW;-DW" />
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
            <Transfer Vector = "-DW;-DW; DW" />
            <Cut>  <Plane NormVector = " 0; 0; 1" NormDistance = " W" /></Cut>
            <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D" /></Split>
            <Cut>  <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /></Cut>
            <Split><Plane NormVector = " 0; 1; 0" NormDistance = " D" /></Split>
            <Cut>  <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /></Cut>
            <HideContaining Vector = " D + Delta; 0; W + Delta" />
            <HideContaining Vector = " 0; D + Delta; W + Delta" />
            <RemoveAllVisible/>
            <Turn NormVector = "-1;-1; 1" Angle = "2*Pi/3" />
        </Macro>
        <ExecMacro MacroName = "AddSegments" Color = "clWhite" />
        <ExecMacro MacroName = "AddSegments" Color = "clBlue" />
        <ExecMacro MacroName = "AddSegments" Color = "clRed" />

        <ShowAll/>
        <SplitByAxes/>
        <RemoveGrayParts/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
