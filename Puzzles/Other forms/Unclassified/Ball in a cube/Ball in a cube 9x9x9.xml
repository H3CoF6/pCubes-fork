<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ball in a cube 9x9x9</Name>
        <Menu>Other forms\Unclassified\Ball in a cube\Ball in a cube 9x9x9</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2020-03-03</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6372</Link>
    </Interface>                   

    <Script>
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clBlue   := '0000A0';
        clGreen  := '008000';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W * 0.1;
        K := 0.58;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-7 * D; -5 * D; -3 * D; -1 * D; 1 * D; 3 * D; 5 * D; 7 * D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "8" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "8" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "8" />

        <RemoveContaining Vector = " 0; 0; 0" />
        <RemoveContaining Vector = " W; 0; 0" />
        <RemoveContaining Vector = "-W; 0; 0" />
        <RemoveContaining Vector = " 0; W; 0" />
        <RemoveContaining Vector = " 0;-W; 0" />
        <RemoveContaining Vector = " 0; 0; W" />
        <RemoveContaining Vector = " 0; 0;-W" />
        <HideAll/>

        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />

        <Split Color2 = "clOrange" Axis = "0" From = "1" />
        <Split Color1 = "clRed   " Axis = "0" From = "8" />
        <Split Color2 = "clGreen " Axis = "1" From = "1" />
        <Split Color1 = "clBlue  " Axis = "1" From = "8" />
        <Split Color2 = "clWhite " Axis = "2" From = "1" />
        <Split Color1 = "clYellow" Axis = "2" From = "8" />


        <RemoveContaining Vector = " 0; 0; 0" />
        <HideContaining Vector = " W; 0; 0" />
        <HideContaining Vector = "-W; 0; 0" />
        <HideContaining Vector = " 0; W; 0" />
        <HideContaining Vector = " 0;-W; 0" />
        <HideContaining Vector = " 0; 0; W" />
        <HideContaining Vector = " 0; 0;-W" />
        <RemoveAllVisible/>
        <ShowAll/>

        <SplitByAxes/>
    </Figure>
</xml>
