<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Anti Penta Tower</Name>
        <Menu>Other forms\Unclassified\Anti Penta Tower</Menu>
        <Inventor>Walaber</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-05-23</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7441</Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF6000'; // clOrange
        Colors[ 1] := '00FFFF'; // clCyan  
        Colors[ 2] := '00FF00'; // clLime  
        Colors[ 3] := '0000FF'; // clBlue  
        Colors[ 4] := '008000'; // clGreen 
        Colors[ 5] := 'FF69B4'; // clPink  
        Colors[ 6] := 'FF0000'; // clRed   
        Colors[ 7] := '800080'; // clPurple
        Colors[ 8] := '808000'; // clOlive 
        Colors[ 9] := '000080'; // clNavy  
        Colors[10] := 'FFFF00'; // clYellow
        Colors[11] := 'F0F0F0'; // clWhite 

        R1 := 0.55;
        R2 := R1 * 1.5;
        H := R1 * 1.0;
        D1 := (R2 * cos (Pi / 5) + R1) / 2 * cos(Pi / 5);
        D2 := H * 0.5;

        for i := 0 to 4 do begin
            x1[i] := R1 * sin(Pi / 5 * (2 * i));
            y1[i] := R1 * cos(Pi / 5 * (2 * i));
            x2[i] := R2 * sin(Pi / 5 * (2 * i + 1));
            y2[i] := R2 * cos(Pi / 5 * (2 * i + 1));
        end;

    </Script>

    <Axes TurningAngles = "0; Pi" PlaneDistances = "D1" >
        <Axis NormVector = "x2[0]; y2[0]; 0" />
        <Axis NormVector = "x2[1]; y2[1]; 0" />
        <Axis NormVector = "x2[2]; y2[2]; 0" />
        <Axis NormVector = "x2[3]; y2[3]; 0" />
        <Axis NormVector = "x2[4]; y2[4]; 0" />
    </Axes>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D2; D2" FixedLayers = "1" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices Vectors = "x1; y1;  H" />
            <Vertices Vectors = "x2; y2;  0" />
            <Vertices Vectors = "x1; y1; -H" />

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = "0;1;5" />
                <Face Color = "Colors[ 1]" VertexIndexes = "1;2;6" />
                <Face Color = "Colors[ 2]" VertexIndexes = "2;3;7" />
                <Face Color = "Colors[ 3]" VertexIndexes = "3;4;8" />
                <Face Color = "Colors[ 4]" VertexIndexes = "4;0;9" />

                <Face Color = "Colors[ 5]" VertexIndexes = "6;5;1" InvisibleEdges = "1" />
                <Face Color = "Colors[ 6]" VertexIndexes = "7;6;2" InvisibleEdges = "1" />
                <Face Color = "Colors[ 7]" VertexIndexes = "8;7;3" InvisibleEdges = "1" />
                <Face Color = "Colors[ 8]" VertexIndexes = "9;8;4" InvisibleEdges = "1" />
                <Face Color = "Colors[ 9]" VertexIndexes = "5;9;0" InvisibleEdges = "1" />

                <Face Color = "Colors[ 9]" VertexIndexes = "9;5;10" InvisibleEdges = "1" />
                <Face Color = "Colors[ 8]" VertexIndexes = "8;9;14" InvisibleEdges = "1" />
                <Face Color = "Colors[ 7]" VertexIndexes = "7;8;13" InvisibleEdges = "1" />
                <Face Color = "Colors[ 6]" VertexIndexes = "6;7;12" InvisibleEdges = "1"  />
                <Face Color = "Colors[ 5]" VertexIndexes = "5;6;11" InvisibleEdges = "1" />

                <Face Color = "Colors[ 4]" VertexIndexes = "10;14; 9" />
                <Face Color = "Colors[ 3]" VertexIndexes = "14;13; 8" />
                <Face Color = "Colors[ 2]" VertexIndexes = "13;12; 7" />
                <Face Color = "Colors[ 1]" VertexIndexes = "12;11; 6" />
                <Face Color = "Colors[ 0]" VertexIndexes = "11;10; 5" />

                <Face Color = "Colors[10]" VertexIndexes = "10;11;12;13;14" />
                <Face Color = "Colors[11]" VertexIndexes = " 4; 3; 2; 1; 0" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
