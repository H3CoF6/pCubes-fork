<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Icosioctahedron Star1</Name>
        <Menu>Other forms\Unclassified\Icosioctahedron Star1</Menu>
        <Inventor>Seth Holoday</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2019-04-01</Added>
        <Link></Link>
    </Interface>

    <Script>
        Colors[ 0] := 'FF0000'; // clRed
        Colors[ 1] := '0000FF'; // clBlue
        Colors[ 2] := 'FFFF00'; // clYellow
        Colors[ 3] := '008000'; // clGreen

        Colors[ 4] := 'F0E68C'; // clKhaki
        Colors[ 5] := 'DDBB20'; // clGolden
        Colors[ 6] := '808000'; // clOlive
        Colors[ 7] := 'D2691E'; // clChocolate
        Colors[ 8] := 'CD853F'; // clPeru
        Colors[ 9] := 'F4A460'; // clSandyBrown

        Colors[10] := 'ADFF2F'; // clGreenYellow
        Colors[11] := '00FF00'; // clLime
        Colors[12] := '006400'; // clDarkGreen
        Colors[13] := '2E8B57'; // clSeaGreen
        Colors[14] := '66CDAA'; // clAquaMarine
        Colors[15] := '8FBC8F'; // clDarkSeaGreen

        Colors[16] := '00FFFF'; // clCyan
        Colors[17] := '008080'; // clTeal
        Colors[18] := '000080'; // clNavy
        Colors[19] := '00BFFF'; // clDeepSky
        Colors[20] := '1E90FF'; // clDodgerBlue
        Colors[21] := '87CEEB'; // clSkyBlue

        Colors[22] := 'FF7F50'; // clCoral
        Colors[23] := 'CD5C5C'; // clIndian
        Colors[24] := '800000'; // clBrown
        Colors[25] := 'DC143C'; // clCrimson
        Colors[26] := 'D07090'; // clPale
        Colors[27] := 'DA70D6'; // clOrchid

        K  := 0.2;

        C0 := K * 3;
        C1 := K * 1;
        C2 := K * 5/3;

        D  := K * 7 / sqrt(11);
        D2 := K * 2.1;

        // Calc all Jumble Angle
        A1 := ArcCos( 7 / 18);
        A2 := ArcCos(-5 / 6);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1;-A2; 0; A2; A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " C0; C1; C1" />
        <Axis NormVector = " C1; C0; C1" />
        <Axis NormVector = " C1; C1; C0" />
        <Axis NormVector = "-C0;-C1; C1" />
        <Axis NormVector = "-C1;-C0; C1" />
        <Axis NormVector = "-C1;-C1; C0" />
        <Axis NormVector = " C0;-C1;-C1" />
        <Axis NormVector = " C1;-C0;-C1" />
        <Axis NormVector = " C1;-C1;-C0" />
        <Axis NormVector = "-C0; C1;-C1" />
        <Axis NormVector = "-C1; C0;-C1" />
        <Axis NormVector = "-C1; C1;-C0" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "D2" FixedLayers = "0" >
        <Axis NormVector = "-1; 1; 1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C0; C1; C1" />
                <Add Vector = " C1; C0; C1" />
                <Add Vector = " C1; C1; C0" />
                <Add Vector = "-C0;-C1; C1" />
                <Add Vector = "-C1;-C0; C1" />
                <Add Vector = "-C1;-C1; C0" />
                <Add Vector = " C0;-C1;-C1" />
                <Add Vector = " C1;-C0;-C1" />
                <Add Vector = " C1;-C1;-C0" />
                <Add Vector = "-C0; C1;-C1" />
                <Add Vector = "-C1; C0;-C1" />
                <Add Vector = "-C1; C1;-C0" />

                <Add Vector = "-C2; C2; C2" />
                <Add Vector = " C2;-C2; C2" />
                <Add Vector = " C2; C2;-C2" />
                <Add Vector = "-C2;-C2;-C2" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 1; 2" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 3; 4; 5" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 6; 7; 8" />
                <Face Color = "Colors[ 3]" VertexIndexes = " 9;10;11" />

                <Face Color = "Colors[ 4]" VertexIndexes = "12; 5; 2" />
                <Face Color = "Colors[ 5]" VertexIndexes = "12; 3; 5" />
                <Face Color = "Colors[ 6]" VertexIndexes = "12; 9; 3" />
                <Face Color = "Colors[ 7]" VertexIndexes = "12;10; 9" />
                <Face Color = "Colors[ 8]" VertexIndexes = "12; 1;10" />
                <Face Color = "Colors[ 9]" VertexIndexes = "12; 2; 1" />

                <Face Color = "Colors[10]" VertexIndexes = "13; 2; 5" />
                <Face Color = "Colors[11]" VertexIndexes = "13; 0; 2" />
                <Face Color = "Colors[12]" VertexIndexes = "13; 6; 0" />
                <Face Color = "Colors[13]" VertexIndexes = "13; 7; 6" />
                <Face Color = "Colors[14]" VertexIndexes = "13; 4; 7" />
                <Face Color = "Colors[15]" VertexIndexes = "13; 5; 4" />

                <Face Color = "Colors[16]" VertexIndexes = "14; 0; 6" />
                <Face Color = "Colors[17]" VertexIndexes = "14; 1; 0" />
                <Face Color = "Colors[18]" VertexIndexes = "14;10; 1" />
                <Face Color = "Colors[19]" VertexIndexes = "14;11;10" />
                <Face Color = "Colors[20]" VertexIndexes = "14; 8;11" />
                <Face Color = "Colors[21]" VertexIndexes = "14; 6; 8" />

                <Face Color = "Colors[22]" VertexIndexes = "15;11; 8" />
                <Face Color = "Colors[23]" VertexIndexes = "15; 9;11" />
                <Face Color = "Colors[24]" VertexIndexes = "15; 3; 9" />
                <Face Color = "Colors[25]" VertexIndexes = "15; 4; 3" />
                <Face Color = "Colors[26]" VertexIndexes = "15; 7; 4" />
                <Face Color = "Colors[27]" VertexIndexes = "15; 8; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
