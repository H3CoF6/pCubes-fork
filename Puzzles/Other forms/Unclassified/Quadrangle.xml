<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Quadrangle</Name>
        <Menu>Other forms\Unclassified\Quadrangle</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2018-10-25</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7030</Link>
    </Interface>

    <Script>
        clBlue    := '0000C8';
        clGreen   := '009600';
        clRed     := 'C80000';
        clYellow  := 'FFFF00';
        clWhite   := 'FFFFFF';

        clBlue1   := '0000C7';
        clRed1    := 'C70000';
        clYellow1 := 'FFFE00';
        clWhite1  := 'FFFFFE';

        s3 := 1 / sqrt(3);

        X1 := 0.45;
        X2 := X1 * 1.3;
        Z1 := -X1 * s3;
        Z2 := X1 * 2 * s3;
        D := -X1 * 0.15;
//        Delta := 0.001;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3; 0; 2 * Pi / 3" PlaneDistances = "-X1; X1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = " X1" Y = "-X2" Z = "Z1" />
                <Vector X = "  0" Y = "-X2" Z = "Z2" />
                <Vector X = "-X1" Y = "-X2" Z = "Z1" />
                <Vector X = "-X2" Y = "-X1" Z = "Z1" />
                <Vector X = "-X2" Y = "  0" Z = "Z2" />
                <Vector X = "-X2" Y = " X1" Z = "Z1" />
                <Vector X = "-X1" Y = " X2" Z = "Z1" />
                <Vector X = "  0" Y = " X2" Z = "Z2" />
                <Vector X = " X1" Y = " X2" Z = "Z1" />
                <Vector X = " X2" Y = " X1" Z = "Z1" />
                <Vector X = " X2" Y = "  0" Z = "Z2" />
                <Vector X = " X2" Y = "-X1" Z = "Z1" />
                <Vector X = "-X1" Y = "-X1" Z = "Z1" />
                <Vector X = "-X1" Y = " X1" Z = "Z1" />
                <Vector X = " X1" Y = " X1" Z = "Z1" />
                <Vector X = " X1" Y = "-X1" Z = "Z1" />
                <Vector X = " 0" Y = " 0" Z = "Z2" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue1 " VertexIndexes = "0;1;2" />
                <Face Color = "clBlue  " VertexIndexes = "4;3;12;16" />
                <Face Color = "clBlue  " VertexIndexes = "11;10;16;15" />
                <Face Color = "clYellow1" VertexIndexes = "3;4;5" />
                <Face Color = "clYellow" VertexIndexes = "7;6;13;16" />
                <Face Color = "clYellow" VertexIndexes = "2;1;16;12" />
                <Face Color = "clWhite1 " VertexIndexes = "9;10;11" />
                <Face Color = "clWhite " VertexIndexes = "1;0;15;16" />
                <Face Color = "clWhite " VertexIndexes = "8;7;16;14" />
                <Face Color = "clRed1   " VertexIndexes = "6;7;8" />
                <Face Color = "clRed   " VertexIndexes = "10;9;14;16" />
                <Face Color = "clRed   " VertexIndexes = "5;4;16;13" />
                <Face Color = "clGreen " VertexIndexes = "0;2;12;3;5;13;6;8;14;9;11;15" />
            </Faces>
        </Part>

        <Split> <Plane NormVector = " 1; 0; 1/sqrt(3)" NormDistance = "-z1" /> </Split>
        <Split> <Plane NormVector = " 0; 1; 1/sqrt(3)" NormDistance = "-z1" /> </Split>
        <Split> <Plane NormVector = "-1; 0; 1/sqrt(3)" NormDistance = "-z1" /> </Split>
        <Split> <Plane NormVector = " 0;-1; 1/sqrt(3)" NormDistance = "-z1" /> </Split>

        <Macro Name = "TurnAndSplit">
            <SplitByAxes/>
            <Turn Axis = "0" Layer = "0" Angle = "2 * Pi / 3" />
            <Turn Axis = "0" Layer = "2" Angle = "2 * Pi / 3" />
            <Turn Axis = "1" Layer = "0" Angle = "2 * Pi / 3" />
            <Turn Axis = "1" Layer = "2" Angle = "2 * Pi / 3" />
        </Macro>

        <ExecMacro MacroName = "TurnAndSplit" />
        <ExecMacro MacroName = "TurnAndSplit" />
        <ExecMacro MacroName = "TurnAndSplit" />

