<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Clover Chop</Name>
        <Menu>Other forms\Unclassified\Clover Chop</Menu>
        <Inventor>Matt Lozano</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-14</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7398</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF6600'; // clOrange
        Colors[2] := '0066FF'; // clBlue
        Colors[3] := '00DD00'; // clGreen
        Colors[4] := 'FFEE00'; // clYellow
        Colors[5] := 'AA00AA'; // clViolett

        K := 0.6;
        DV := K * 0.88;
        DE := K * 0.88;
        DCut := K * 0.08;
        A3 := Pi * 2 / 3;
    </Script>

    <Axes TurningAngles = "0; A3" PlaneDistances = "DV" >
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1; 1;-1" />
        <Axis NormVector = "-1;-1;-1" />
    </Axes>
        <Axes TurningAngles = "0; Pi" PlaneDistances = "DE" >
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 1; 0;-1" />
        <Axis NormVector = " 0; 1;-1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <Turn NormVector = "1; 0; 0" Angle = "Pi" />
        <SplitByAxes/>

        <Turn Axis = "0" Layer = "1" Angle = "A3" />
        <Turn Axis = "1" Layer = "1" Angle = "A3" />
        <Turn Axis = "2" Layer = "1" Angle = "A3" />
        <Turn Axis = "3" Layer = "1" Angle = "A3" />
        <SplitByAxes/>
        <Undo Repeat = "4"/>

        <Cut> <Plane NormVector = "0; 0; 1" NormDistance = "DCut" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
