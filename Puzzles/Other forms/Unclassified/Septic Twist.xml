    <Script>
        Colors[ 0] := '303030'; // clBlack
        Colors[ 1] := '0000FF'; // clBlue
        Colors[ 2] := 'FF0000'; // clRed
        Colors[ 3] := 'FFFF00'; // clYellow
        Colors[ 4] := 'FF6000'; // clOrange
        Colors[ 5] := '008000'; // clGreen
        Colors[ 6] := 'FF69B4'; // clPink
        Colors[ 7] := '800000'; // clBrown
        Colors[ 8] := '00BFFF'; // clDeepSky
        Colors[ 9] := 'FFAFA0'; //
        Colors[10] := '2E8B57'; // clSeaGreen
        Colors[11] := '800080'; // clPurple
        Colors[12] := 'F0F0F0'; // clWhite
        Colors[13] := 'A0A0A0'; // Silver

        cosa := 1 / 2 / cos(3*Pi/14);
        sina := sqrt(1 - cosa^2);
        cosa2 := -sin(Pi/14) / cos(3*Pi/14);
        sina2 := sqrt(1 - cosa2^2);

        D := 0.28;
        DV := D * (1 + 2 * sina^2 * (1 / cos(2*Pi/7) - 1));
        RD := D * sina / cosa / cos(2*Pi/7);
        RV := D * sina / cosa / cos(Pi/7);
        sAngle := 2 * Pi/7;

        procedure CalcTop(idx, iC, R, DD, dA);
        begin
          for i := 0 to 7 do begin
            Vx[idx, i] := iC * (DD * sina - R * cos(2*Pi/7 * (i + dA)) * cosa);
            Vy[idx, i] := iC * (          - R * sin(2*Pi/7 * (i + dA)));
            Vz[idx, i] :=      (DD * cosa + R * cos(2*Pi/7 * (i + dA)) * sina);
          end;
        end;

        CalcTop( 0, 1, RV, DV,   0);
        CalcTop( 1, 1, RD, D ,   0);
        CalcTop( 2, 1, RV, D , 0.5);
        CalcTop( 3,-1, RV, DV,   0);
        CalcTop( 4,-1, RD, D ,   0);
        CalcTop( 5,-1, RV, D , 0.5);

        procedure CalcBottom(idx, iC, R, DD, dA);
        begin
          for i := 0 to 7 do begin
            Vx[idx, i] := iC * (             R * sin(2*Pi/7 * (i + dA)));
            Vy[idx, i] := iC * (DD * sina2 - R * cos(2*Pi/7 * (i + dA)) * cosa2);
            Vz[idx, i] :=      (DD * cosa2 + R * cos(2*Pi/7 * (i + dA)) * sina2);
          end;
        end;

        CalcBottom( 6, 1, RV, DV,   0);
        CalcBottom( 7, 1, RD, D ,   0);
        CalcBottom( 8, 1, RV, D , 0.5);
        CalcBottom( 9,-1, RV, DV,   0);
        CalcBottom(10,-1, RD, D ,   0);
        CalcBottom(11,-1, RV, D , 0.5);
    </Script>

