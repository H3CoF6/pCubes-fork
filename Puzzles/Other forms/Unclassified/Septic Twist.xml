        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-01-11</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2983</Link>
