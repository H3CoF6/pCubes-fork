<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>UFO FTO</Name>
        <Menu>Other forms\Unclassified\UFO FTO</Menu>
        <Inventor>Arno Brugger</Inventor>
        <Programmer>Ginanjar Syahfia</Programmer>
        <Added>2017-07-28</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3347</Link>
    </Interface>

    <Script>
        K  := 0.045;
        W  := K * 18;
        W1 := K *  8;
        W2 := K * 10;
        W3 := K *  6;
        W4 := K * 12;
        W5 := K *  3;

        D  := W * sqrt(3) / 9;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "-D; D" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = " 1; -1; -1" />
        <Axis NormVector = "-1;  1; -1" />
        <Axis NormVector = "-1; -1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " W1;  0;-W2" />
                <Add Vector = "  0; W1;-W2" />
                <Add Vector = "-W1;  0;-W2" />
                <Add Vector = "  0;-W1;-W2" />

                <Add Vector = "  W;  0;  0" />
                <Add Vector = "  0;  W;  0" />
                <Add Vector = " -W;  0;  0" />
                <Add Vector = "  0; -W;  0" />

                <Add Vector = " W4;  0; W3" />
                <Add Vector = "  0; W4; W3" />
                <Add Vector = "-W4;  0; W3" />
                <Add Vector = "  0;-W4; W3" />

                <Add Vector = " W5; W5; W4" />
                <Add Vector = "-W5; W5; W4" />
                <Add Vector = "-W5;-W5; W4" />
                <Add Vector = " W5;-W5; W4" />
            </Vertices>

            <Faces>
                <Face Color = "BABABA" VertexIndexes = "0;3;2;1" />

                <Face Color = "605290" VertexIndexes = "1;5;4;0" />
                <Face Color = "B79FB9" VertexIndexes = "2;6;5;1" />
                <Face Color = "921614" VertexIndexes = "3;7;6;2" />
                <Face Color = "BD3A6C" VertexIndexes = "0;4;7;3" />

                <Face Color = "1292F0" VertexIndexes = "5; 9;12; 8;4" />
                <Face Color = "0559A4" VertexIndexes = "6;10;13; 9;5" />
                <Face Color = "5CA12B" VertexIndexes = "7;11;14;10;6" />
                <Face Color = "35C583" VertexIndexes = "4; 8;15;11;7" />

                <Face Color = "C0DAFC" VertexIndexes = " 8;12;15" />
                <Face Color = "FAFE07" VertexIndexes = " 9;13;12" />
                <Face Color = "C8AD6B" VertexIndexes = "10;14;13" />
                <Face Color = "F09F01" VertexIndexes = "11;15;14" />

                <Face Color = "FEFEFE" VertexIndexes = "12;13;14;15" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
