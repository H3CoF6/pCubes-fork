<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Scalium</Name>
        <Menu>Other forms\Unclassified\Scalium</Menu>
        <Inventor>Timur Evbatyrov</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-03-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1753</Link>
    </Interface>

    <Script>
        clRed    := 'C80000';
        clGreen  := '009600';
        clBlue   := '0000C8';
        clOrange := 'FF800A';

        W := 0.5;

        D := W / sqrt(3);
        D2 := D / 3;
        DCut := D2 * 5;
        W1 := W / 2;
    </Script>

    <Axes TurningAngles = "Pi / 3" PlaneDistances = "-D; D2" FixedLayers = "1" >
        <Axis NormVector = " 1; 1; 1" />
        <Axis NormVector = " 1;-1;-1" />
        <Axis NormVector = "-1;-1; 1" />
        <Axis NormVector = "-1; 1;-1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W; W; W" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />

                <Face Color = "clBlue" VertexIndexes = "2;6;4" />
                <Face Color = "clGreen" VertexIndexes = "0;2;4" />

                <Face Color = "clRed   " VertexIndexes = "1;5;7" />
                <Face Color = "clOrange" VertexIndexes = "3;1;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn Angle = " Pi / 3 " Axis = "0" Layer = "0" />
        <Split Axis = "1" From = "1"/>
        <Split Axis = "2" From = "1"/>
        <Split Axis = "3" From = "1"/>
        <Turn Angle = "-Pi / 3 " Axis = "0" Layer = "0" />

        <Turn Angle = " Pi / 3 " Axis = "1" Layer = "0" />
        <Split Axis = "0" From = "1"/>
        <Split Axis = "2" From = "1"/>
        <Split Axis = "3" From = "1"/>
        <Turn Angle = "-Pi / 3 " Axis = "1" Layer = "0" />

        <Turn Angle = " Pi / 3 " Axis = "2" Layer = "0" />
        <Split Axis = "0" From = "1"/>
        <Split Axis = "1" From = "1"/>
        <Split Axis = "3" From = "1"/>
        <Turn Angle = "-Pi / 3 " Axis = "2" Layer = "0" />

        <Turn Angle = " Pi / 3 " Axis = "3" Layer = "0" />
        <Split Axis = "0" From = "1"/>
        <Split Axis = "1" From = "1"/>
        <Split Axis = "2" From = "1"/>
        <Turn Angle = "-Pi / 3 " Axis = "3" Layer = "0" />

        <RemoveContaining Vector = " W1;  W;  W" />
        <RemoveContaining Vector = "  W; W1;  W" />
        <RemoveContaining Vector = "  W;  W; W1" />
        <RemoveContaining Vector = "-W1; -W;  W" />
        <RemoveContaining Vector = " -W;-W1;  W" />
        <RemoveContaining Vector = " -W; -W; W1" />
        <RemoveContaining Vector = "-W1;  W; -W" />
        <RemoveContaining Vector = " -W; W1; -W" />
        <RemoveContaining Vector = " -W;  W;-W1" />
        <RemoveContaining Vector = " W1; -W; -W" />
        <RemoveContaining Vector = "  W;-W1; -W" />
        <RemoveContaining Vector = "  W; -W;-W1" />

        <Turn Angle = " Pi / 3 " Axis = "0" Layer = "0" />
        <Turn Angle = "-Pi / 3 " Axis = "1" Layer = "0" />
        <Turn Angle = " Pi / 3 " Axis = "2" Layer = "0" />
        <Turn Angle = "-Pi / 3 " Axis = "3" Layer = "0" />

        <Cut Color = "clOrange" > <Plane NormVector = "-1;-1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 1;-1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 1;-1; 1" NormDistance = "-DCut" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = "-1; 1; 1" NormDistance = "-DCut" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
