<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>QuadStar</Name>
        <Menu>Other forms\Unclassified\QuadStar</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-04-24</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=3473</Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clSilver := 'A0A0A0';
        clCyan   := '00FFFF';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clBrown  := '800000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clLime   := '00FF00';
        clGreen  := '008000';
        clPink   := 'FF69B4';
        clPurple := '800080';

        R := 0.7;
        pA := R * sqrt((sqrt(5) + 2) / 8);
        pB := R * sqrt(5) / 2;
        pC := R * sqrt((5 * sqrt(5) - 10) / 8);
        pD := R * 0.5;

        D := R * sqrt(sqrt(5) / 40);
    </Script>

    <Axes TurningAngles = "2*Pi/5" PlaneDistances = "D" FixedLayers = "0">
        <Axis NormVector = "  pB;  0 ;  pC" />
        <Axis NormVector = "  0 ; -pB; -pC" />
        <Axis NormVector = " -pB;  0 ;  pC" />
        <Axis NormVector = "  0 ;  pB; -pC" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  pD;  pA" />
                <Add Vector = "  0; -pD;  pA" />

                <Add Vector = " pB;  0 ;  pC" />
                <Add Vector = " 0 ; -pB; -pC" />
                <Add Vector = "-pB;  0 ;  pC" />
                <Add Vector = " 0 ;  pB; -pC" />

                <Add Vector = " pD;   0; -pA" />
                <Add Vector = "-pD;   0; -pA" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite " VertexIndexes = "0; 1; 2" />
                <Face Color = "clSilver" VertexIndexes = "1; 0; 4" />
                <Face Color = "clRed   " VertexIndexes = "1; 3; 2" />
                <Face Color = "clBrown " VertexIndexes = "1; 4; 3" />
                <Face Color = "clYellow" VertexIndexes = "0; 2; 5" />
                <Face Color = "clOrange" VertexIndexes = "4; 0; 5" />

                <Face Color = "clPink  " VertexIndexes = "7; 6; 3" />
                <Face Color = "clPurple" VertexIndexes = "6; 7; 5" />
                <Face Color = "clGreen " VertexIndexes = "2; 3; 6" />
                <Face Color = "clLime  " VertexIndexes = "5; 2; 6" />
                <Face Color = "clCyan  " VertexIndexes = "4; 7; 3" />
                <Face Color = "clBlue  " VertexIndexes = "4; 5; 7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Hide  Axis = "1" Layer = "1" />
        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "1" From  = "1" /> 
        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "1" From  = "1" /> 
        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "1" From  = "1" /> 
        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "1" From  = "1" /> 
        <Turn  Axis = "0" Layer = "1" Angle = " 2*Pi/5" />
        <ShowAll/>

        <Hide  Axis = "0" Layer = "1" />
        <Turn  Axis = "3" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "0" From  = "1" /> 
        <Turn  Axis = "3" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "0" From  = "1" /> 
        <Turn  Axis = "3" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "0" From  = "1" /> 
        <Turn  Axis = "3" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "0" From  = "1" /> 
        <Turn  Axis = "3" Layer = "1" Angle = " 2*Pi/5" />
        <ShowAll/>

        <Hide  Axis = "3" Layer = "1" />
        <Turn  Axis = "2" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "3" From  = "1" /> 
        <Turn  Axis = "2" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "3" From  = "1" /> 
        <Turn  Axis = "2" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "3" From  = "1" /> 
        <Turn  Axis = "2" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "3" From  = "1" /> 
        <Turn  Axis = "2" Layer = "1" Angle = " 2*Pi/5" />
        <ShowAll/>

        <Hide  Axis = "2" Layer = "1" />
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "2" From  = "1" /> 
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "2" From  = "1" /> 
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "2" From  = "1" /> 
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/5" />
        <Split Axis = "2" From  = "1" /> 
        <Turn  Axis = "1" Layer = "1" Angle = " 2*Pi/5" />
        <ShowAll/>
    </Figure>
</xml>
