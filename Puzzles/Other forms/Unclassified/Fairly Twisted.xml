    <Script>
        clBlue   := '0000FF';
        clGreen  := '008000';
        clOrange := 'FF6000';
        clPink   := 'FF69B4';
        clPurple := '800080';
        clRed    := 'FF0000';
        clSilver := 'A0A0A0';
        clWhite  := 'F0F0F0';
        clYellow := 'FFFF00';

        R := 0.5;

        s3 := sqrt(3);
        s5 := sqrt(5);

        n1 := sqrt((5 + 2 * s5) / 5);
        n2 := 1;
        n3 := sqrt((5 - 2 * s5) / 5);
        n4 := sqrt((5 - s5) / 10);
        n5 := sqrt((3 + s5) / 2);
        n6 := sqrt(2 * (5 + s5) / 5);

        C1  := R * 1.0661408512011672875;  // 1/5   * s3 * sqrt(5 + 2 * s5)
        C2  := R * 0.81445913672820349352; // 1/5   * s3 * sqrt(2 * (5 - s5))
        C3  := R * 0.32945564141853277035; // 1/10  * s3 * sqrt(1/2 * (5 + s5))
        C4  := R * 1.0139602038233318562;  // 1/2   * s3 * sqrt(1/10 * (7 + 3 * s5))
        C5  := R * 0.86252606701911641408; // 1/10  * s3 * sqrt(1/2 * (25 + 11 * s5))
        C6  := R * 0.62666186920259016764; // 1/2   * s3 * sqrt(1/10 * (3 + s5))
        C7  := R * 1.3178225656741310814;  // 1/5   * s3 * sqrt(2 * (5 + s5))
        C8  := R * 0.25168171447296379394; // 1/5   * s3 * sqrt(5 - 2 * s5)
        C9  := R * 0.40722956836410174676; // 1/5   * s3 * sqrt((5 - s5) / 2)
        C10 := R * 1.2533237384051803353;  //         s3 * sqrt(1/10 * (3 + s5))
        C11 := R * 1.0661408512011672875;  // =C1
        C12 := R * 0.77459666924148337704; //         s3 / s5
        C13 := R * 0.58113735589149656429; // 1/10  * s3 * sqrt(1/2 * (65 - 19 * s5))
        C14 := R * 0.65891128283706554070; // 1/5   * s3 * sqrt(1/2 * (5 + s5))
        C15 := R * 0.47872706916369695825; //         s3 * sqrt(1/10 * (3 - s5))
        C16 := R * 0.81445913672820349352; // =C2
        C17 := R * 1.1468589304078246468;  // 3/11  * s3 * sqrt(1/5 * (25 + 2 * s5))
        C18 := R * 0.27774726218800838990; // 1/11  * s3 * (4 - s5)
        C19 := R * 0.38228631013594154892; // 1/11  * s3 * sqrt(1/5 * (25 + 2 * s5))
        C20 := R * 0.85481817633153217317; // 1/11  * s3 * sqrt(1 * (25 + 2 * s5))
        C21 := R * 0.52830668717408778572; // 1/22  * s3 * sqrt(2 * (65 - 19 * s5))
        C22 := R * 0.72715177269043445181; // 1/22  * s3 * (7  + s5)
        C23 := R * 0.76457262027188309785; // 2/11  * s3 * sqrt(1/5 * (25 + 2 * s5))
        C24 := R * 0.89880902100485212382; // 1/11  * s3 * sqrt(2 * (23 - 3 * s5))
        C25 := R * 1.1439147781467362639;  // 1/10  * s3 * sqrt(1/2 * (85 + s5))
        C26 := R * 0.23936353458184847912; // 1/2   * s3 * sqrt(1/10 * (3 - s5))
        C27 := R * 1.0910841094293274853;  // 1/11  * s3 * sqrt(1/10 * (545 - 29 * s5))
        C28 := R * 0.44940451050242606191; // 1/22  * s3 * (3 * s5 - 1)
        C29 := R * 0.64349550146189705889; // 1/55  * s3 * sqrt(905 - 218 * s5)
        C30 := R * 0.89517721593486085283; // 1/55  * s3 * sqrt(2 * (205 + 89 * s5))
        C31 := R * 0.19885104575555501537; // 1/110 * s3 * sqrt(1/2 * (3805 - 1559 * s5))
        C32 := R * 0.61200058987195471947; // 1/22  * s3 * sqrt(1/10 * (687 - 37 * s5))
        C33 := R * 0.52059879648650354481; // 1/110 * s3 * sqrt(1/2 * (1625 + 251 * s5))
        C34 := R * 0.37823716567585267407; // 1/22  * s3 * sqrt(1/10 * (1123 - 399 * s5))
        C35 := R * 0.97589529514151821213; // 1/55  * s3 * sqrt(2 * (545 - 29 * s5))
        C36 := R * 0.51289090579891930390; // 3/55  * s3 * sqrt(25 + 2 * s5)
        C37 := R * 0.93553625553818953248; // 1/55  * s3 * sqrt(565 + 142 * s5)
        C38 := R * 0.07676745521231982156; // 1/11  * s3 * sqrt(1/10 * (103 - 45 * s5))
        C39 := R * 0.57819320363040818140; // 1/55  * s3 * sqrt(1/2 * (985 - 139 * s5))
        C40 := R * 0.71174195155447431927; // 1/110 * s3 * sqrt(1/2 * (3145 + 421 * s5))
        C41 := R * 0.78951587850004329568; // 1/55  * s3 * sqrt(1/2 * (745 + 229 * s5))
        C42 := R * 0.57361686226579480869; // 1/11  * s3 * sqrt(1/10 * (287 - 69 * s5))
        C43 := R * 0.80198750761412339460; // 1/110 * s3 * sqrt(1/2  * (5365 - 79 * s5))
        C44 := R * 0.48778823810858597269; // 3/22  * s3 * sqrt(1/10 * (27 + 7 * s5))
        C45 := R * 0.83351409043418692557; // 1/11  * s3 * sqrt(2/5 * (2125 - 919 * s5))
        C46 := R * 0.74326853437453785024; // 1/11  * s3 * sqrt(1/5 * (2665 - 1142 * s5))

        A1 := ArcCos(1/4);     // 75.5
        A2 := 2 * Pi / 3;      // 120
        A3 := 4 * Pi / 3 - A1; // 164.5

        D  := R * (3 + 2 * s5) / 11;
//ShowMessage(D);
//ShowMessage(A1+A2); //1.318 (75)
//ShowMessage((A1+A3)/Pi); //2.094 (120)
//ShowMessage(2*A1+A3); //2.871
//ShowMessage(2*A2+A3); 

//a1 + a3 = 4*Pi/3
    </Script>

