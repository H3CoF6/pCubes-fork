<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x3x5 Rocket I</Name>
        <Menu>Other forms\Unclassified\3x3x5 Rocket I</Menu>
        <Inventor>Calvin Fan</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-10-23</Added>
        <Link>http://www.hknowstore.com/locale/en-US/item.aspx?corpname=nowstore&amp;itemid=68d52031-4dee-4715-8c44-6731e63dc0fc</Link>
    </Interface>

    <Script>
        W := 0.4;
        H := W / 3 * 5;

        D := W / 3 - 0.001;
        D2 := 3 * D;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D; D; D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;  W; -D" />
                <Add Vector = "-W; -W; -D" />
                <Add Vector = " W;  W; -D" />
                <Add Vector = " W; -W; -D" />
                
                <Add Vector = "-W;  W; -H" />
                <Add Vector = "-W; -W; -H" />
                <Add Vector = " W;  W; -H" />
                <Add Vector = " W; -W; -H" />
            </Vertices>
            <Faces>
                <Face Color = "      " VertexIndexes = "0;1;3;2" />
                <Face Color = "0000C8" VertexIndexes = "5;4;6;7" />
                <Face Color = "FFFFFF" VertexIndexes = "1;0;4;5" />
                <Face Color = "FFFF00" VertexIndexes = "2;3;7;6" />
                <Face Color = "C80000" VertexIndexes = "0;2;6;4" />
                <Face Color = "FF800A" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
        <Part>
            <Vertices>
                <Add Vector = "-W;-D;-D" />
                <Add Vector = "-W; D;-D" />
                <Add Vector = "-D; W;-D" />
                <Add Vector = " D; W;-D" />
                <Add Vector = " W; D;-D" />
                <Add Vector = " W;-D;-D" />
                <Add Vector = " D;-W;-D" />
                <Add Vector = "-D;-W;-D" />
                <Add Vector = "-W;-D; H" />
                <Add Vector = "-W; D; H" />
                <Add Vector = "-D; W; H" />
                <Add Vector = " D; W; H" />
                <Add Vector = " W; D; H" />
                <Add Vector = " W;-D; H" />
                <Add Vector = " D;-W; H" />
                <Add Vector = "-D;-W; H" />
            </Vertices>

            <Faces>
                <Face                  VertexIndexes = "0;1;2;3;4;5;6;7" />
                <Face Color = "009600" VertexIndexes = "15;14;13;12;11;10;9;8" />
                <Face Color = "FFFFFF" VertexIndexes = "1;0; 8; 9" />
                <Face Color = "C80000" VertexIndexes = "2;1; 9;10" />
                <Face Color = "C80000" VertexIndexes = "3;2;10;11" />
                <Face Color = "FFFF00" VertexIndexes = "4;3;11;12" />
                <Face Color = "FFFF00" VertexIndexes = "5;4;12;13" />
                <Face Color = "FF800A" VertexIndexes = "6;5;13;14" />
                <Face Color = "FF800A" VertexIndexes = "7;6;14;15" />
                <Face Color = "FFFFFF" VertexIndexes = "0;7;15; 8" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
