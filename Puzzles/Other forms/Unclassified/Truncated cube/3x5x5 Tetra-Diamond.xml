<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>3x5x5 Tetra-Diamond</Name>
        <Menu>Other forms\Unclassified\Truncated cube\3x5x5 Tetra-Diamond</Menu>
        <Inventor>Joshua Riegel</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2022-08-11</Added>
        <Link>http://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9842</Link>
    </Interface>

    <Script>
        Colors[ 6] := '009484';
        Colors[ 7] := '38ABEA';
        Colors[ 8] := 'A5211F';
        Colors[ 9] := 'C1C5C8';
        Colors[10] := 'F0B092';
        Colors[11] := 'FB85DB';
        Colors[12] := '4D1350';
        Colors[13] := 'FFED99';

        W := 0.5;
        RCut := W * 7 * sqrt(6) / 18;
        D := W * 2 / 11;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D*3; -D; D; D*3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />
        <RemoveGrayParts/>

        <Cut Color = "Colors[ 6]"><Plane NormVector = " 5; 5; 2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[ 7]"><Plane NormVector = " 5;-5; 2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[ 8]"><Plane NormVector = "-5;-5; 2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[ 9]"><Plane NormVector = "-5; 5; 2" NormDistance = "-RCut" /></Cut>

        <Cut Color = "Colors[10]"><Plane NormVector = " 5; 5;-2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[11]"><Plane NormVector = " 5;-5;-2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[12]"><Plane NormVector = "-5;-5;-2" NormDistance = "-RCut" /></Cut>
        <Cut Color = "Colors[13]"><Plane NormVector = "-5; 5;-2" NormDistance = "-RCut" /></Cut>
    </Figure>
</xml>
