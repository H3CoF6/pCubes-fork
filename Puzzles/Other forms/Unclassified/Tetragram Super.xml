<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetragram Super</Name>
        <Menu>Other forms\Unclassified\Tetragram Super</Menu>
        <Inventor>not invente</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-12-19</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'F0F0F0';
        clBlue   := '0000FF';
        clRed    := 'FF0000';
        clYellow := 'FFFF00';
        clOrange := 'FF6000';
        clGreen  := '008000';
        clCyan   := '00FFFF';
        clLime   := '00FF00';
        clKhaki  := 'F0E68C';
        clGray   := '505080';

        K := 0.30;

        s2  := sqrt(2);
        s5  := sqrt(5);
        pX0 := K * sqrt(2);
        pX1 := K * sqrt(3 + s5);
        pX2 := K * sqrt((3 + s5) / 5);
        pX3 := K * s2;
        pZ0 := K * sqrt(1 + s5);
        pZ1 := K * sqrt((s5 - 1) / 5);
        pZ2 := K * sqrt(s5 - 1);
        pZ3 := K * sqrt(2 * (2 + s5));
        pZ4 := pZ2 * 1.5;
        D   := K * sqrt((s5 - 1) / 2);

        nX := sqrt(2 + s5);
        nZ := 1;

        A1 := Arccos((3 + 2 * s5) / 11);
        A2 := Pi - A1;

        Cx[0] := 0;   Cy[0] := 0;   Cz[0] := pZ0;
        Cx[1] := pX2; Cy[1] := pX2; Cz[1] := pZ1;
        Cx[2] :=-pX2; Cy[2] := pX2; Cz[2] := pZ1;
        Cx[3] :=-pX2; Cy[3] :=-pX2; Cz[3] := pZ1;
        Cx[4] := pX2; Cy[4] :=-pX2; Cz[4] := pZ1;
        Cx[5] := pX3; Cy[5] := 0;   Cz[5] :=-pZ2;
        Cx[6] := 0;   Cy[6] := pX3; Cz[6] :=-pZ2;
        Cx[7] :=-pX3; Cy[7] := 0;   Cz[7] :=-pZ2;
        Cx[8] := 0;   Cy[8] :=-pX3; Cz[8] :=-pZ2;
        Cx[9] := 0;   Cy[9] := 0;   Cz[9] :=-pZ4;

        pillow := 1.16;
        for i := 0 to 9 do begin
          Cx[i] := Cx[i] * pillow;
          Cy[i] := Cy[i] * pillow;
          Cz[i] := Cz[i] * pillow;
        end;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1; 0; Pi; A1; A2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " nX;  0; 1" />
        <Axis NormVector = "  0; nX; 1" />
        <Axis NormVector = "-nX;  0; 1" />
        <Axis NormVector = "  0;-nX; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Pyramid4" >
            <Face Color = "Color" VertexIndexes = "i1;i2;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i2;i3;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i3;i4;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i4;i1;i0" InvisibleEdges = "6" />
        </Macro>

        <Macro Name = "Pyramid5" >
            <Face Color = "Color" VertexIndexes = "i1;i2;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i2;i3;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i3;i4;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i4;i5;i0" InvisibleEdges = "6" />
            <Face Color = "Color" VertexIndexes = "i5;i1;i0" InvisibleEdges = "6" />
        </Macro>

        <Part>
            <Vertices>
                <Add Vector = " pX0;   0; pZ0" />
                <Add Vector = "   0; pX0; pZ0" />
                <Add Vector = "-pX0;   0; pZ0" />
                <Add Vector = "   0;-pX0; pZ0" />
                <Add Vector = " pX1;   0;   0" />
                <Add Vector = "   0; pX1;   0" />
                <Add Vector = "-pX1;   0;   0" />
                <Add Vector = "   0;-pX1;   0" />
                <Add Vector = " pX0; pX0;-pZ2" />
                <Add Vector = "-pX0; pX0;-pZ2" />
                <Add Vector = "-pX0;-pX0;-pZ2" />
                <Add Vector = " pX0;-pX0;-pZ2" />
                <Add Vector = "   0;   0;-pZ3" />
            </Vertices>

            <Vertices Vectors = "Cx;Cy;Cz" />

            <Faces>
                <ExecMacro MacroName = "Pyramid4" Color = "clWhite " i0 = "13" i1 = " 0" i2 = " 1" i3 = " 2" i4 = " 3" />

                <ExecMacro MacroName = "Pyramid5" Color = "clBlue  " i0 = "14" i1 = " 1" i2 = " 0" i3 = " 4" i4 = " 8" i5 = " 5" />
                <ExecMacro MacroName = "Pyramid5" Color = "clYellow" i0 = "15" i1 = " 2" i2 = " 1" i3 = " 5" i4 = " 9" i5 = " 6" />
                <ExecMacro MacroName = "Pyramid5" Color = "clGreen " i0 = "16" i1 = " 3" i2 = " 2" i3 = " 6" i4 = "10" i5 = " 7" />
                <ExecMacro MacroName = "Pyramid5" Color = "clRed   " i0 = "17" i1 = " 0" i2 = " 3" i3 = " 7" i4 = "11" i5 = " 4" />

                <ExecMacro MacroName = "Pyramid4" Color = "clLime  " i0 = "18" i1 = " 4" i2 = "11" i3 = "12" i4 = " 8" />
                <ExecMacro MacroName = "Pyramid4" Color = "clOrange" i0 = "19" i1 = " 5" i2 = " 8" i3 = "12" i4 = " 9" />
                <ExecMacro MacroName = "Pyramid4" Color = "clCyan  " i0 = "20" i1 = " 6" i2 = " 9" i3 = "12" i4 = "10" />
                <ExecMacro MacroName = "Pyramid4" Color = "clKhaki " i0 = "21" i1 = " 7" i2 = "10" i3 = "12" i4 = "11" />

<!--
                <Face Color = "clWhite " VertexIndexes = " 0; 1; 2; 3" />
                <Face Color = "clBlue  " VertexIndexes = " 1; 0; 4; 8; 5" />
                <Face Color = "clYellow" VertexIndexes = " 2; 1; 5; 9; 6" />
                <Face Color = "clGreen " VertexIndexes = " 3; 2; 6;10; 7" />
                <Face Color = "clRed   " VertexIndexes = " 0; 3; 7;11; 4" />
                <Face Color = "clLime  " VertexIndexes = " 4;11;12; 8" />
                <Face Color = "clOrange" VertexIndexes = " 5; 8;12; 9" />
                <Face Color = "clCyan  " VertexIndexes = " 6; 9;12;10" />
                <Face Color = "clKhaki " VertexIndexes = " 7;10;12;11" />
-->

            </Faces>
        </Part>

        <Cut><Plane NormVector = "0;0;1" NormDistance = "-pZ4" /></Cut>

        <SplitByAxes/>

        <Macro Name = "Split">
            <Turn Axis = "0" Angle = " Pi" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "1" Angle = " Pi" Layer = "1" />
            <SplitByAxes/>
            <Turn Axis = "2" Angle = " Pi" Layer = "1" />
            <SplitByAxes/>
	            <Turn Axis = "3" Angle = " Pi" Layer = "1" />
            <SplitByAxes/>
        </Macro>
        <ExecMacro MacroName = "Split" Repeat = "3"/>
        <Undo Repeat = "12"/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
