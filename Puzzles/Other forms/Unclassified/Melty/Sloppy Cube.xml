<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

<!-- Sloppy Cube is a cubic shapemod of Melty D -->

    <Interface>
        <Name>Sloppy Cube</Name>
        <Menu>Other forms\Unclassified\Melty\Sloppy Cube</Menu>
        <Menu>Other cubes\Unclassified\Sloppy Cube</Menu>
        <Inventor>Oskar van Deventer</Inventor>
        <Programmer>Evgeniy Grigoriev, Boris</Programmer>
        <Added>2020-02-04</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7884</Link>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=35326</Link>
        <Link>https://i.materialise.com/en/shop/item/sloppy-cube</Link>
    </Interface>

    <Script>
        W := 0.5;
        D  := W / 3;

        s := cos(87 * Pi / 180);  // 87 degrees
        // Solve (a - b - a * b) / (1 + a^2 + b^2) = s
        a := -1 + 1 / sqrt((2 + 4 * s) / (5 + s - 3 * sqrt(1 - 6 * s - 7 * s^2)));
        b := a * (a + 1) / (a + 3);

        ax[0] :=-1; ay[0] :=-b; az[0] :=-a;
        ax[1] := 1; ay[1] :=-a; az[1] :=-b;
        ax[2] :=-b; ay[2] :=-1; az[2] := a;
        ax[3] :=-a; ay[3] := 1; az[3] := b;
        ax[4] := b; ay[4] := a; az[4] :=-1;
        ax[5] := a; ay[5] := b; az[5] := 1;

        function AngleI(i1, i2, i3);
        begin
            x1 := ay[i1] * az[i2] - ay[i2] * az[i1];
            y1 := az[i1] * ax[i2] - az[i2] * ax[i1];
            z1 := ax[i1] * ay[i2] - ax[i2] * ay[i1];
            x2 := ay[i1] * az[i3] - ay[i3] * az[i1];
            y2 := az[i1] * ax[i3] - az[i3] * ax[i1];
            z2 := ax[i1] * ay[i3] - ax[i3] * ay[i1];
            Result := ArcCos((x1*x2 + y1*y2 + z1*z2) / (x1^2 + y1^2 + z1^2));
        end;

        A1 := AngleI(1,2,5);
        A2 := AngleI(1,2,4);
        A3 := AngleI(1,4,5);
    </Script>

    <Axes TurningAngles = "0; 2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" NormVectors = "ax; ay; az" />

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>

    <Macros>
        <Macro Name = "RandomTurns" >
            <Turn Axis = "Random(6)" Layer = "1" Angle = "Random * 2 * Pi" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" >
            <ExecMacro MacroName = "RandomTurns" Repeat = "20000" />
        </Macro>
    </Macros>
</xml>
