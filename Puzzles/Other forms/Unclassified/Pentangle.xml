<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pentangle</Name>
        <Menu>Other forms\Unclassified\Pentangle</Menu>
        <Inventor>Justin Costa</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-04-01</Added>
        <Link>https://www.instagram.com/p/BqajoOnn69q/</Link>
    </Interface>

    <Script>
        Colors[0]  := 'F0F0F0'; // clWhite
        Colors[1]  := 'FFFF01'; // clYellow1
        Colors[2]  := 'FF0000'; // clRed
        Colors[3]  := '00FF00'; // clLime
        Colors[4]  := '800080'; // clViolett
        Colors[5]  := 'FF6000'; // clOrange
        Colors[6]  := '0000F0'; // clBlue
        Colors[7]  := '0000F1'; // clBlue1
        Colors[8]  := 'FF0001'; // clRed1
        Colors[9]  := 'FFFF00'; // clYellow
        Colors[10] := '0000AF'; // clDarkBlue
        Colors[11] := '008000'; // clGreen
        Colors[12] := 'F0F0F1'; // clWhite1

        R := 0.4;
        L := R * 1.5;
        D1 := R * 1.1;
        D2 := R * 0.5;

        for i := 0 to 4 do begin
            x[i] := R * sin(i * 2 * Pi / 5);
            z[i] := R * cos(i * 2 * Pi / 5);
        end;

        M := X[2];
        H1 := -z[2] + 0.001;

    </Script>

    <Axes TurningAngles = "2 * Pi / 5; 0; 2 * Pi / 5" PlaneDistances = "-D1; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2; 0" PlaneDistances = "-D2" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = "x[0]" Y = "-L" Z = "z[0]" />
                <Vector X = "x[1]" Y = "-L" Z = "z[1]" />
                <Vector X = "x[2]" Y = "-L" Z = "z[2]" />
                <Vector X = "x[3]" Y = "-L" Z = "z[3]" />
                <Vector X = "x[4]" Y = "-L" Z = "z[4]" />
                <Vector X = "x[0]" Y = " L" Z = "z[0]" />
                <Vector X = "x[1]" Y = " L" Z = "z[1]" />
                <Vector X = "x[2]" Y = " L" Z = "z[2]" />
                <Vector X = "x[3]" Y = " L" Z = "z[3]" />
                <Vector X = "x[4]" Y = " L" Z = "z[4]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "4;3;2;1;0" />
                <Face Color = "Colors[1]" VertexIndexes = "5;6;7;8;9" />
                <Face Color = "Colors[2]" VertexIndexes = "0;1;6;5" />
                <Face Color = "Colors[3]" VertexIndexes = "1;2;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "2;3;8;7" />
                <Face Color = "Colors[5]" VertexIndexes = "3;4;9;8" />
                <Face Color = "Colors[6]" VertexIndexes = "4;0;5;9" />
            </Faces>
        </Part>

        <Split> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Split>
        <RemoveContaining Vector = " R/2; 0; 0" />
        <RemoveContaining Vector = "-R/2; 0; 0" />
        <HideAll/>

        <Part>
            <Vertices>
                <Vector X = "-L" Y = "x[0]" Z = "z[0]" />
                <Vector X = "-L" Y = "x[1]" Z = "z[1]" />
                <Vector X = "-L" Y = "x[2]" Z = "z[2]" />
                <Vector X = "-L" Y = "x[3]" Z = "z[3]" />
                <Vector X = "-L" Y = "x[4]" Z = "z[4]" />
                <Vector X = " L" Y = "x[0]" Z = "z[0]" />
                <Vector X = " L" Y = "x[1]" Z = "z[1]" />
                <Vector X = " L" Y = "x[2]" Z = "z[2]" />
                <Vector X = " L" Y = "x[3]" Z = "z[3]" />
                <Vector X = " L" Y = "x[4]" Z = "z[4]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 7]" VertexIndexes = "0;1;2;3;4" />
                <Face Color = "Colors[ 8]" VertexIndexes = "9;8;7;6;5" />
                <Face Color = "Colors[ 9]" VertexIndexes = "5;6;1;0" />
                <Face Color = "Colors[10]" VertexIndexes = "6;7;2;1" />
                <Face Color = "Colors[ 4]" VertexIndexes = "7;8;3;2" />
                <Face Color = "Colors[11]" VertexIndexes = "8;9;4;3" />
                <Face Color = "Colors[12]" VertexIndexes = "9;5;0;4" />
            </Faces>
        </Part>

        <Split> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Split>
        <Split> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Split>
        <RemoveContaining Vector = "0; R/2; 0" />
        <RemoveContaining Vector = "0;-R/2; 0" />
        <ShowAll/>

        <SplitByAxes/>

        <Part>
            <Vertices>
                <Vector X = "-M" Y = "-M" Z = "-H1" />
                <Vector X = "-M" Y = " M" Z = "-H1" />
                <Vector X = " M" Y = " M" Z = "-H1" />
                <Vector X = " M" Y = "-M" Z = "-H1" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 4]" VertexIndexes = "0;1;2;3" InvisibleEdges = "15" />
            </Faces>
        </Part>


        <Macro Name = "TurnAndSplit">
            <Turn Axis = "0" Layer = "0" Angle = "2 * Pi / 5" />
            <Turn Axis = "0" Layer = "2" Angle = "2 * Pi / 5" />
            <Turn Axis = "1" Layer = "0" Angle = "2 * Pi / 5" />
            <Turn Axis = "1" Layer = "2" Angle = "2 * Pi / 5" />
            <Split Axis = "2" From = "1" />
        </Macro>
        <ExecMacro MacroName = "TurnAndSplit" Repeat = "5" />
        <Undo Repeat = "20" />
    </Figure>
</xml>
