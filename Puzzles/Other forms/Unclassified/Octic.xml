<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octic</Name>
        <Menu>Other forms\Unclassified\Octic</Menu>
        <Inventor>Hung Nguyễn</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-03-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5057</Link>
    </Interface>

    <Script>
        Colors[0] := 'FF0000'; // Red
        Colors[1] := 'FFA500'; // Orange
        Colors[2] := '0000FF'; // Blue
        Colors[3] := '00FF00'; // Green
        Colors[4] := 'FFFF00'; // Yellow
        Colors[5] := 'FFFFFF'; // White

        W := 0.8;
        include 'Figures\Scripts\Octahedron_Coordinates.inc';

        D1 := W / 7;
        D2 := W * 3 / 7;

        DCut := W * 3 * sqrt(2) / 7;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />
            <Vertices Vectors = "Cx; Cy; Cz" />
            <Vertices Vectors = "Ex; Ey; Ez" />

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;16; 6;15" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "0;15; 9;14" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "0;14;13;17" InvisibleEdges = "6" />
                <Face Color = "Colors[0]" VertexIndexes = "0;17;10;16" InvisibleEdges = "6" />

                <Face Color = "Colors[1]" VertexIndexes = "1;23; 7;24" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "1;24;11;25" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "1;25;12;22" InvisibleEdges = "6" />
                <Face Color = "Colors[1]" VertexIndexes = "1;22; 8;23" InvisibleEdges = "6" />

                <Face Color = "Colors[2]" VertexIndexes = "2;21; 6;16" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "2;16;10;20" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "2;20;11;24" InvisibleEdges = "6" />
                <Face Color = "Colors[2]" VertexIndexes = "2;24; 7;21" InvisibleEdges = "6" />

                <Face Color = "Colors[3]" VertexIndexes = "3;18; 8;22" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "3;22;12;19" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "3;19;13;14" InvisibleEdges = "6" />
                <Face Color = "Colors[3]" VertexIndexes = "3;14; 9;18" InvisibleEdges = "6" />

                <Face Color = "Colors[4]" VertexIndexes = "4;20;10;17" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "4;25;11;20" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "4;19;12;25" InvisibleEdges = "6" />
                <Face Color = "Colors[4]" VertexIndexes = "4;17;13;19" InvisibleEdges = "6" />

                <Face Color = "Colors[5]" VertexIndexes = "5;15; 6;21" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "5;21; 7;23" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "5;23; 8;18" InvisibleEdges = "6" />
                <Face Color = "Colors[5]" VertexIndexes = "5;18; 9;15" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />

        <RemoveContaining Vector = "Ex;Ey;Ez" />

        <Macro Name = "CutEdge">
            <Cut Color = "Color"><Plane NormVector = "Ex[i];Ey[i];Ez[i]" NormDistance = "-DCut" /></Cut>
            <Script>Inc(i);</Script>
        </Macro>

        <Macro Name = "CutColor">
            <HideContaining Vector = "Vx[v];Vy[v];Vz[v]" />
            <InvertVisibility/>
            <ExecMacro MacroName = "CutEdge" Color = "Colors[v]" i = "0" Repeat = "12" />
            <ShowAll/>
            <Script>Inc(v);</Script>
        </Macro>
        <ExecMacro MacroName = "CutColor" v = "0" Repeat = "6" />

        <SplitByAxes/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
