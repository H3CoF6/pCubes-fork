<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Tetrasect</Name>
        <Menu>Other forms\Unclassified\Tetrasect</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-06-19</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6255</Link>
    </Interface>

    <Script>
        Colors[0] := 'F0F0F0'; // White
        Colors[1] := '00FFFF'; // Cyan
        Colors[2] := '0000FF'; // Blue
        Colors[3] := 'FF0000'; // Red
        Colors[4] := 'FFFF00'; // Yellow
        Colors[5] := 'FF6000'; // Orange
        Colors[6] := '008000'; // Green
        Colors[7] := '800080'; // Purple

        W  := 0.5;
        D  := W * 0.3;
        D2 := W / sqrt(3);
        RC := W * 1.3;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D;D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "2*Pi/3" PlaneDistances = "-D2;D2" FixedLayers = "1" >
        <Axis NormVector = " W; W; W" />
        <Axis NormVector = "-W; W; W" />
        <Axis NormVector = "-W;-W; W" />
        <Axis NormVector = " W;-W; W" />
    </Axes>

    <Figure>
        <Macro Name = "AddV" >
            <Part>
                <Vertices>
                    <Add Vector = " 0; 0; W" />
                    <Add Vector = " W; W; W" />
                    <Add Vector = " W; 0; 0" />
                    <Add Vector = " 0; W; 0" />
                </Vertices>
                <Faces>
                    <Face Color = "Colors[c1]" VertexIndexes = " 0; 2; 1" />
                    <Face Color = "Colors[c2]" VertexIndexes = " 0; 1; 3" />
                    <Face Color = "Colors[c3]" VertexIndexes = " 1; 2; 3" />
                    <Face                      VertexIndexes = " 0; 3; 2" />
                </Faces>
            </Part>
            <Cut Color = "Colors[c4]" ><Plane NormVector = "-1;-1;-1" NormDistance = "-RC" /></Cut>
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
        </Macro>

        <ExecMacro MacroName = "AddV" c1 = "4" c2 = "5" c3 = "2" c4 = "6" />
        <ExecMacro MacroName = "AddV" c1 = "0" c2 = "6" c3 = "3" c4 = "4" />
        <ExecMacro MacroName = "AddV" c1 = "5" c2 = "4" c3 = "7" c4 = "0" />
        <ExecMacro MacroName = "AddV" c1 = "6" c2 = "0" c3 = "1" c4 = "5" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <ExecMacro MacroName = "AddV" c1 = "2" c2 = "7" c3 = "4" c4 = "3" />
        <ExecMacro MacroName = "AddV" c1 = "1" c2 = "3" c3 = "6" c4 = "2" />
        <ExecMacro MacroName = "AddV" c1 = "7" c2 = "2" c3 = "5" c4 = "1" />
        <ExecMacro MacroName = "AddV" c1 = "3" c2 = "1" c3 = "0" c4 = "7" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <Part>
            <Vertices>
                <Add Vector = "-W; 0; 0" />
                <Add Vector = " W; 0; 0" />
                <Add Vector = " 0;-W; 0" />
                <Add Vector = " 0; W; 0" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " 0; 0; W" />
            </Vertices>
            <Faces>
                <Face VertexIndexes = "1;5;2" />
                <Face VertexIndexes = "2;5;0" />
                <Face VertexIndexes = "0;5;3" />
                <Face VertexIndexes = "3;5;1" />
                <Face VertexIndexes = "2;4;1" />
                <Face VertexIndexes = "0;4;2" />
                <Face VertexIndexes = "3;4;0" />
                <Face VertexIndexes = "1;4;3" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
