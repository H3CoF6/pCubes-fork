    <Script>
        clWhite  := 'FAFAFA';
        clYellow := 'F0E400';
        clBlue   := '1010D0';
        clRed    := 'C80000';
        clOrange := 'F07000';
        clGreen  := '008000';

        clCyan   := '20D0C0';
        clPink   := 'E860C0';
        clLGreen := '30E020';
        clViolet := '602090';
        clSilver := 'A0A0A0';

        K  := 0.45;

        // angle between axes = 77.869542155423386806 degs
        N1 :=  0.62843523424033001745;
        N2 :=  0.77786191343020616003;
        N3 :=  0.96281863809995625155;
        N4 :=  0.27014860748733366741;
        N5 :=  0.84668850065537765228;
        N6 := -0.33438340385962623410;
        N7 := -0.41389167916400379868;

        C1 :=  K * 0.67790923320117327896;
        C2 :=  K * 1.28557521937307865265;
        C3 :=  K * 1.03861720206561240008;
        C4 := -K * 0.91334463913911299004;
        C5 :=  K * 0.44647558819579864088;
        C6 :=  K * 1.39932517093005152120;
        C7 :=  K * 0.36070796886443912112;
        C8 :=  K * 0.15505934452594254567;
        C9 :=  K * 0.36070796886443912112;
        C10 := -K * 1.23054590347584714789;
        C11 := -K * 0.68404028665133746609;
        C12 :=  K * 0.84668850065537765228;
        C13 :=  K * 0.48598053179093853116;
        C14 := -K * 1.07666432963281883697;
        C15 :=  K * 0.29405183038070378335;
        C16 := -K * 0.74456537168490861673;
        C17 := -K * 1.21302122877673238650;
        C18 :=  K * 1.19507891298911345011;
        C19 := -K * 0.55763475084067392994;
        C20 :=  K * 1.14074033103608143562;
        C21 :=  K * 0.55263667027467386893;
        C22 :=  K * 0.36397023426620236135;
        C23 :=  K * 0.39617495935117281889;
        C24 := -K * 0.90102708260840966676;
        C25 := -K * 0.87770480322580903468;
        C26 :=  K * 0.53376507880837555221;
        C27 :=  K * 0.69022678973187660224;
        C28 := -K * 0.98886396587068432374;
        C29 := -K * 0.07321017341933033120;
        C30 := -K * 0.66131383418073789790;
        C31 := -K * 1.13862830056408863572;
        C32 :=  K * 0.03546699048673369777;
        C33 := -K * 0.86556009212167596899;
        C34 := -K * 0.75129926741514549854;
        C35 :=  K * 0.02891295555113870434;
        C36 := -K * 0.81777554510423894793;
        C37 := -K * 0.80331187501316528390;

        D  := K * 0.63041493819180925460;

        A1 := Pi * 4/9; // 80 degs
        DCut := (C35*(C33-C36) + C36*(C35+C32)) / sqrt((C33-C36)^2+(C35+C32)^2);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1*3; -A1*2; -A1; 0; A1; A1*2; A1*3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " N1; 0; N2" />
        <Axis NormVector = "-N1; 0; N2" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1*3; -A1*2; -A1; 0; A1; A1*2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0; N3; N4" />
        <Axis NormVector = " 0;-N3; N4" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1; 0; A1; A1*2; A1*3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " N5; N6; N7" />
        <Axis NormVector = "-N5;-N6; N7" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;  C1;  C2" />
                <Add Vector = "   0; -C1;  C2" />
                <Add Vector = "  C3;  C4;  C5" />
                <Add Vector = "  C3; -C4;  C5" />
                <Add Vector = " -C3; -C4;  C5" />
                <Add Vector = " -C3;  C4;  C5" />
                <Add Vector = "  C6;  C7;  C8" />
                <Add Vector = " -C6; -C7;  C8" />
                <Add Vector = "  C9; C10; C11" />
                <Add Vector = " -C9;-C10; C11" />
                <Add Vector = " C12; C13; C14" />
                <Add Vector = "-C12;-C13; C14" />
                <Add Vector = "  C9;-C10; C11" />
                <Add Vector = " -C9; C10; C11" />
                <Add Vector = " C15; C16; C17" />
                <Add Vector = "-C15;-C16; C17" />
                <Add Vector = "   0; C18; C19" />
                <Add Vector = "   0;-C18; C19" />
                <Add Vector = " C20; C21; C22" />
                <Add Vector = "-C20;-C21; C22" />
                <Add Vector = " C23; C24; C25" />
                <Add Vector = "-C23;-C24; C25" />
                <Add Vector = " C23;-C24; C25" />
                <Add Vector = "-C23; C24; C25" />
                <Add Vector = " C26; C27; C28" />
                <Add Vector = "-C26;-C27; C28" />
                <Add Vector = " C29; C30; C31" />
                <Add Vector = "-C29;-C30; C31" />
                <Add Vector = " C32; C33; C34" />
                <Add Vector = "-C32;-C33; C34" />
                <Add Vector = "-C32; C33; C34" />
                <Add Vector = " C32;-C33; C34" />
                <Add Vector = " C35; C36; C37" />
                <Add Vector = "-C35;-C36; C37" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"  VertexIndexes = " 1; 2; 6;18; 3; 0" />
                <Face Color = "clRed"    VertexIndexes = " 0; 4; 7;19; 5; 1" />
                <Face Color = "clGreen"  VertexIndexes = " 0; 3;12;16; 9; 4" />
                <Face Color = "clBlue"   VertexIndexes = " 1; 5;13;17; 8; 2" />
                <Face Color = "clOrange" VertexIndexes = " 6; 2; 8;20;14;10" />
                <Face Color = "clYellow" VertexIndexes = " 7; 4; 9;21;15;11" />

                <Face Color = "clPink"   VertexIndexes = " 3;18;22;12" />
                <Face Color = "clPink"   VertexIndexes = " 6;10;24;18" />
                <Face Color = "clPink"   VertexIndexes = "18;24;22" />

                <Face Color = "clCyan"   VertexIndexes = " 5;19;23;13" />
                <Face Color = "clCyan"   VertexIndexes = " 7;11;25;19" />
                <Face Color = "clCyan"   VertexIndexes = "19;25;23" />

                <Face Color = "clViolet" VertexIndexes = "10;14;26;24" />
                <Face Color = "clViolet" VertexIndexes = "11;15;27;25" />
                <Face1 Color = "clViolet" VertexIndexes = "24;26;25;27" />
                <Face Color = "clViolet" VertexIndexes = "24;26;25" InvisibleEdges = "4" />
                <Face Color = "clViolet" VertexIndexes = "24;25;27" InvisibleEdges = "1" />

                <Face Color = "clSilver" VertexIndexes = " 8;17;28;20" />
                <Face Color = "clSilver" VertexIndexes = "13;23;30;17" />
                <Face Color = "clSilver" VertexIndexes = "14;20;32;26" />
                <Face Color = "clSilver" VertexIndexes = "17;30;28" />
                <Face Color = "clSilver" VertexIndexes = "20;28;32" />
                <Face Color = "clSilver" VertexIndexes = "28;30;32" InvisibleEdges = "2" />
                <Face Color = "clSilver" VertexIndexes = "30;23;26;32" InvisibleEdges = "10" />
                <Face Color = "clSilver" VertexIndexes = "23;25;26" InvisibleEdges = "4" />

                <Face Color = "clSilver" VertexIndexes = " 9;16;29;21" />
                <Face Color = "clSilver" VertexIndexes = "12;22;31;16" />
                <Face Color = "clSilver" VertexIndexes = "15;21;33;27" />
                <Face Color = "clSilver" VertexIndexes = "16;31;29" />
                <Face Color = "clSilver" VertexIndexes = "21;29;33" />
                <Face Color = "clSilver" VertexIndexes = "29;31;33" InvisibleEdges = "2" />
                <Face Color = "clSilver" VertexIndexes = "31;22;27;33" InvisibleEdges = "10" />
                <Face Color = "clSilver" VertexIndexes = "22;24;27" InvisibleEdges = "4" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "2" Layer = "1" Angle = "-A1" />
        <Split Axis = "0" From = "1"/>
        <Undo Repeat = "1"/>

        <Turn  Axis = "3" Layer = "1" Angle = "-A1" />
        <Split Axis = "1" From = "1"/>
        <Undo Repeat = "1"/>

        <Turn  Axis = "4" Layer = "1" Angle = "A1" />
        <Split Axis = "0" From = "1"/>
        <Turn  Axis = "4" Layer = "1" Angle = "A1" />
        <Split Axis = "0" From = "1"/>
        <Undo Repeat = "2"/>

        <Turn  Axis = "5" Layer = "1" Angle = "A1" />
        <Split Axis = "1" From = "1"/>
        <Turn  Axis = "5" Layer = "1" Angle = "A1" />
        <Split Axis = "1" From = "1"/>
        <Undo Repeat = "2"/>

        <Macro Name = "Split" >
            <Turn  Axis = "ax1" Layer = "1" Angle = "angle" />
            <Hide  Axis = "ax2" Layer = "0" />
            <Turn  Axis = "ax1" Layer = "1" Angle = "angle" />
            <Split Axis = "ax2" From = "1"/>
            <Undo Repeat = "2"/>
            <ShowAll/>
        </Macro>

        <ExecMacro MacroName = "Split" ax1 = " 2" ax2 = " 0" angle = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = " 2" ax2 = " 1" angle = " A1" />
        <ExecMacro MacroName = "Split" ax1 = " 3" ax2 = " 1" angle = "-A1" />
        <ExecMacro MacroName = "Split" ax1 = " 3" ax2 = " 0" angle = " A1" />

        <Turn  Axis = "4" Layer = "1" Angle = " A1" />
        <ExecMacro MacroName = "Split" ax1 = " 4" ax2 = " 0" angle = " A1" />
        <Undo Repeat = "1"/>

        <Turn  Axis = "5" Layer = "1" Angle = " A1" />
        <ExecMacro MacroName = "Split" ax1 = " 5" ax2 = " 1" angle = " A1" />
        <Undo Repeat = "1"/>

        // split non-convex (unconvex) part into several
        <HideContaining Vector = "0;0;0" />
        <InvertVisibility/>

        <Split Color1 = "-2" InvisibleEdges1 = "15" Color2 = "-2" InvisibleEdges2 = "15" ><Plane NormVector = "C33-C36; C35+C32; 0" NormDistance = "DCut" /></Split>
        <Split Color1 = "-2" InvisibleEdges1 = "15" Color2 = "-2" InvisibleEdges2 = "15" ><Plane NormVector = "C33-C36; C35+C32; 0" NormDistance = "-DCut" /></Split>
        <Split Color1 = "-2" InvisibleEdges1 = "127" Color2 = "-2" InvisibleEdges2 = "127" ><Plane NormVector = "C27;-C26; 0" NormDistance = "0" /></Split>

        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

