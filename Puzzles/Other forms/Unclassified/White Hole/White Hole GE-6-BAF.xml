<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>White Hole GE-6-BAF</Name>
        <Menu>Other forms\Unclassified\White Hole\White Hole GE-6-BAF</Menu>
        <Inventor>Francisco Bedmar Alvarez</Inventor>
        <Programmer>Boris, Skallos</Programmer>
        <Added>2023-12-31</Added>
        <Link>https://www.twistypuzzles.com/cgi-bin/puzzle.cgi?pkey=11679</Link>
        <Link>https://twistypuzzles.com/forum/viewtopic.php?p=426542</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Vectors.inc';

        Colors[ 0] := '0000FF'; // Blue
        Colors[ 1] := '00BFFF'; // DeepSky
        Colors[ 2] := '007700'; // Green
        Colors[ 3] := 'FFFF00'; // Yellow
        Colors[ 4] := 'FF6000'; // Orange
        Colors[ 5] := 'FF0000'; // Red

        Colors[ 6] := '44AA99'; // Teal
        Colors[ 7] := '00FFFF'; // Cyan
        Colors[ 8] := '00FF00'; // Lime
        Colors[ 9] := 'F0E68C'; // Khaki
        Colors[10] := 'FF7F50'; // Coral
        Colors[11] := 'CD5C5C'; // Indian

        clTop     := 'FFFFFF'; // White
        clBottom  := '333333'; // Black

        R1 := 0.5;
        N := 6;
        nAngle := 2*Pi / N;
        nAngle2 := nAngle / 2;

        H1 := R1 * sqrt((cos(nAngle2) - cos(nAngle)) / 2);

        A1 := VectorRotatingAngle(0, R1, H1, R1 * sin(nAngle), R1 *cos(nAngle), H1, R1 * sin(nAngle2), R1 * cos(nAngle2),-H1);  // (A[0], A[1], B[0])
        A2 := A1 * 2;
        A3 := A1 * 3;

        VectorRotatePoint(R1 * sin(nAngle), R1 *cos(nAngle), H1,  0, R1, H1, -A1, True);  // (A[1], A[0], -A1, True)
        H2 := Ans_Z;                                                                                                                  
        R2 := VectorLength(Ans_X, Ans_Y, 0);                                                                                          

        D := VectorDistanceToPlane(0, R1, H1, R1 * sin(nAngle), R1 * cos(nAngle), H1, 0);  // (A[0], A[1], 0)                     

        DCut := D * 0.9;

        for i := 0 to N - 1 do begin
            sa := sin(nAngle * i);
            ca := cos(nAngle * i);
            sa2 := sin(nAngle * (i + 1/2));
            ca2 := cos(nAngle * (i + 1/2));

            Ax[i] :=  R1 * sa;
            Ay[i] :=  R1 * ca;

            Bx[i] :=  R1 * sa2;
            By[i] :=  R1 * ca2;

            Cx[i] :=  R2 * sa2;
            Cy[i] :=  R2 * ca2;

            Dx[i] :=  R2 * sa;
            Dy[i] :=  R2 * ca;
        end;
        Az := H1;
        Bz :=-H1;
        Cz := H2;
        Dz :=-H2;

        function Next(i); // cycle in N-ring (0..5, 6..11 etc)
        begin
            Result := i + 1;
            if Result mod N = 0 then
                Result := Result - N;
        end;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" NormVectors = " Ax; Ay; Az" FixedLayers = "0" />
    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3;-A2;-A1; 0; A1; A2; A3" PlaneDistances = "D" NormVectors = " Bx; By; Bz" FixedLayers = "0" />

    <Figure>
        <Macro Name = "CreateCoreSlice" >
            <LoadFrom File = "Figures\CubeMono.xml" Width = "H2 * 1.1" Color = "-1" />
            <Cut> <Plane NormVector = "-Bx[0];-By[0];-Bz" NormDistance = "-D" /> </Cut>
            <Cut                      Color = "-2" > <Plane NormVector = " Bx[1]; By[1]; 0" /> </Cut>
            <Cut                      Color = "-2" > <Plane NormVector = " Bx[5]; By[5]; 0" /> </Cut>
            <Cut InvisibleEdges = "2" Color = "-2" > <Plane NormVector = " Bx[0] - Ax[0]; By[0] - Ay[0]; Bz - Az" /> </Cut>
            <Cut InvisibleEdges = "6" Color = "-2" > <Plane NormVector = " Bx[0] - Ax[1]; By[0] - Ay[1]; Bz - Az" /> </Cut>
            <Cut InvisibleEdges = "18" > <Plane NormVector = " Bx[0]; By[0]; Bz" NormDistance = " DCut" /> </Cut>
            <Cut InvisibleEdges = "10" Color = "Clr" > <Plane NormVector = " 0; 0; 1" NormDistance = "-H2" /> </Cut>
            <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" Color1 = "-2" Color2 = "-2" > <Plane NormVector = " Ax[2]; Ay[2]; 0" /> </Split>
            <HideAll/>
            <Turn NormVector = "0;0;1" Angle = "nAngle" />
        </Macro>
        <ExecMacro MacroName = "CreateCoreSlice" Clr = "clBottom" Repeat = "N" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />
        <Turn NormVector = "0;0;1" Angle = " Pi/N" />
        <ExecMacro MacroName = "CreateCoreSlice" Clr = "clTop   " Repeat = "N" />
        <Turn NormVector = "0;0;1" Angle = "-Pi/N" />
        <Turn NormVector = "1;0;0" Angle = "Pi" />

        <Macro Name = "AddColor" >
            <Face Color = "Colors[c]" VertexIndexes = "v1;v2;v3" />
            <Face Color = "Colors[c]" VertexIndexes = "v1;v4;v2" />
            <Face Color = "Colors[c]" VertexIndexes = "v1;v5;v4" />
            <Script>
                c  := Next(c );
                v1 := Next(v1);
                v2 := Next(v2);
                v3 := Next(v3);
                v4 := Next(v4);
                v5 := Next(v5);
            </Script>
        </Macro>

        <Part>
            <Vertices Vectors = "Ax;Ay;Az" />
            <Vertices Vectors = "Bx;By;Bz" />
            <Vertices Vectors = "Cx;Cy;Cz" />
            <Vertices Vectors = "Dx;Dy;Dz" />

            <Faces>
                <ExecMacro MacroName = "AddColor" c = " 0" v1 = " 0" v2 = " 1" v3 = " 6" v4 = "12" v5 = "17" Repeat = "N" />
                <ExecMacro MacroName = "AddColor" c = " 6" v1 = " 7" v2 = " 6" v3 = " 1" v4 = "19" v5 = "20" Repeat = "N" />

                <Face Color = "clTop   " VertexIndexes = "17;16;15;14;13;12" />
                <Face Color = "clBottom" VertexIndexes = "18;19;20;21;22;23" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveContaining Vector = "0;0;0" />

        <Macro Name = "Unbandage" >
            <Turn  Axis = "i  " Layer = "1" Angle = " A1" />
            <Turn  Axis = "i+N" Layer = "1" Angle = "-A1" />
            <Split Axis = "i  " From  = "1" />
            <Undo  Repeat = "2" />

            <Turn  Axis = "i+N" Layer = "1" Angle = " A1" />
            <Turn  Axis = "i  " Layer = "1" Angle = "-A1" />
            <Split Axis = "i+N" From  = "1" />
            <Undo  Repeat = "2" />

            <Script>inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "Unbandage" i = "0" Repeat = "N" />
        <ShowAll/>

        <SaveSolvedState/> <!-- solution 1 -->

        <Macro Name = "Xchange6" >
            <Turn Axis = "ax1" Layers = "1" Angle = " A3" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A3" />
            <Turn Axis = "ax1" Layers = "1" Angle = "-A3" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A3" />
        </Macro>
        <Macro Name = "Xchange4" >
            <Turn Axis = "ax4" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax1" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax4" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax5" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax3" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax3" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax5" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax4" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax1" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax2" Layers = "1" Angle = "-A1" />
            <Turn Axis = "ax1" Layers = "1" Angle = " A1" />
            <Turn Axis = "ax4" Layers = "1" Angle = " A1" />
        </Macro>
        <ExecMacro MacroName = "Xchange6" ax1 = " 1" ax2 = " 0" />
        <ExecMacro MacroName = "Xchange6" ax1 = " 3" ax2 = " 2" />
        <ExecMacro MacroName = "Xchange4" ax1 = " 3" ax2 = " 4" ax3 = " 5" ax4 = " 9" ax5 = "10" />
        <SaveSolvedState/> <!-- solution 2 -->

        <ExecMacro MacroName = "Xchange6" ax1 = "10" ax2 = "11" />
        <ExecMacro MacroName = "Xchange6" ax1 = " 8" ax2 = " 9" />
        <ExecMacro MacroName = "Xchange4" ax1 = " 8" ax2 = " 7" ax3 = " 6" ax4 = " 2" ax5 = " 1" />
        <SaveSolvedState/> <!-- solution 3 -->

        <ExecMacro MacroName = "Xchange4" ax1 = " 3" ax2 = " 4" ax3 = " 5" ax4 = " 9" ax5 = "10" />
        <ExecMacro MacroName = "Xchange6" ax1 = " 3" ax2 = " 2" Repeat = "2" />
        <ExecMacro MacroName = "Xchange6" ax1 = " 1" ax2 = " 0" Repeat = "2" />
        <SaveSolvedState/> <!-- solution 4 -->

        <Undo Repeat = "86" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
