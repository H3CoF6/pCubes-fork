<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fenzy C Dual (80deg turn)</Name>
        <Menu>Other forms\Unclassified\Fenzy C Dual (80deg turn)</Menu>
        <Inventor></Inventor>
        <Programmer>uot</Programmer>
        <Added>2020-08-13</Added>
        <Link></Link>
    </Interface>

    <Script>
        clWhite  := 'FAFAFA';
        clYellow := 'F0E400';
        clBlue   := '1010D0';
        clRed    := 'C80000';
        clOrange := 'F07000';
        clGreen  := '008000';
        clViolet := '640064';
        clGray   := '5F5F5F';

        clCyan   := '20D0C0';
        clPink   := 'E860C0';

        K  := 0.65;

        // angle between axes = 77.869542155423386806 degs
        N1 := -0.72565450331380011592;
        N2 :=  0.68805925749197071360;
        N3 :=  0.97767166754628583615;
        N4 := -0.21013831273060308487;
        N5 :=  0;
        N6 := -1;

        C1 :=  K * N1;
        C2 :=  K * N2;
        C3 :=  K * N3;
        C4 :=  K * N4;
        C5 :=  K * N5;
        C6 :=  K * N6;
        C7 := -K * 0.70377334265892079372;
        C8 := -K * 0.30253457818265076326;
        C9 :=  K * 0.63212750636366150172;
        C10 :=  K * 0.53041795744676208967;
        C11 := -K / 3;
        C12 :=  K * 0.70634229545192592752;
        C13 :=  K * 0.18623412954431402014;
        C14 :=  K * 0.78766388832132549566;
        C15 := -K * 0.16929851399507125088;

        cos1 := cos(Pi*2/3);
        sin1 := sin(Pi*2/3);
        cos2 := cos(Pi*4/3);
        sin2 := sin(Pi*4/3);

        D  := K * 0.43376283428410288621;

        A1 := Pi * 4/9; // 80 degs
        A2 := Pi * 7/9; // 140 degs
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1*3; -A1*2; -A1; 0; A1; A1*2; A1*3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " N1; 0; N2" />
        <Axis NormVector = " N5; 0; N6" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1*3; -A1*2; -A1; 0; A1; A1*2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " N1*cos1; N1*sin1; N2" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1*2; -A1; 0; A1; A1*2; A1*3" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " N1*cos2; N1*sin2; N2" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2-A1; -A2; -A1; 0; A1; A2; A2+A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " N3*cos1; N3*sin1; N4" />
        <Axis NormVector = " N3*cos2; N3*sin2; N4" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " C1;   0;  C2"/>
                <Add Vector = "C1*cos1; C1*sin1; C2"/>
                <Add Vector = "C1*cos2; C1*sin2; C2"/>
                <Add Vector = "C3*cos1; C3*sin1; C4"/>
                <Add Vector = "C3*cos2; C3*sin2; C4"/>
                <Add Vector = " C5;   0;  C6"/>

                <Add Vector = " C7;   0;  C8"/>
                <Add Vector = " C9; C10; C11"/>
                <Add Vector = " C9;-C10; C11"/>
                <Add Vector = "C12;   0; C13"/>
                <Add Vector = "C14;   0; C15"/>
            </Vertices>

            <Faces>
                <Face Color = "clViolet" VertexIndexes = "0;1; 2" />
                <Face Color = "clRed"    VertexIndexes = "0;2; 3" />
                <Face Color = "clWhite"  VertexIndexes = "1;0; 4" />

                <Face Color = "clGreen"  VertexIndexes = "6;0; 3" InvisibleEdges = "1" />
                <Face Color = "clGray"   VertexIndexes = "6;3; 5" InvisibleEdges = "4" />
                <Face Color = "clGray"   VertexIndexes = "6;5; 4" InvisibleEdges = "1" />
                <Face Color = "clGreen"  VertexIndexes = "6;4; 0" InvisibleEdges = "4" />

                <Face Color = "clBlue"   VertexIndexes = "1;4; 8" InvisibleEdges = "2" />
                <Face Color = "clBlue"   VertexIndexes = "5;8; 4" InvisibleEdges = "2" />
                <Face Color = "clYellow" VertexIndexes = "2;7; 3" InvisibleEdges = "2" />
                <Face Color = "clYellow" VertexIndexes = "5;3; 7" InvisibleEdges = "2" />

                <Face Color = "clOrange" VertexIndexes = "1;9; 2" InvisibleEdges = "3" />
                <Face Color = "clOrange" VertexIndexes = "1;8;10;9" InvisibleEdges = "14" />
                <Face Color = "clOrange" VertexIndexes = "2;9;10;7" InvisibleEdges = "7" />
                <Face Color = "clOrange" VertexIndexes = "5;7;10;8" InvisibleEdges = "6" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Turn  Axis = "2" Layer = "1" Angle = "-A1" />
        <Split Axis = "5" From = "1"/>
        <Hide  Axis = "5" Layer = "0" />
        <Turn  Axis = "2" Layer = "1" Angle = "-A1" />
        <Split Axis = "5" From = "1"/>
        <Undo Repeat = "2"/>
        <ShowAll/>

        <Turn  Axis = "3" Layer = "1" Angle = "A1" />
        <Split Axis = "4" From = "1"/>
        <Hide  Axis = "4" Layer = "0" />
        <Turn  Axis = "3" Layer = "1" Angle = "A1" />
        <Split Axis = "4" From = "1"/>
        <Undo Repeat = "2"/>
        <ShowAll/>

        <Hide  Axis = "3" Layer = "0" />
        <Turn  Axis = "2" Layer = "1" Angle = "A1" />
        <Split Axis = "3" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Hide  Axis = "4" Layer = "0" />
        <Turn  Axis = "0" Layer = "1" Angle = "-A1" />
        <Split Axis = "4" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Hide  Axis = "5" Layer = "0" />
        <Turn  Axis = "0" Layer = "1" Angle = "A1" />
        <Split Axis = "5" From = "1"/>
        <Undo Repeat = "1"/>
        <ShowAll/>

        <Turn  Axis = "1" Layer = "1" Angle = "-A1" />
        <Split Axis = "4" From = "1"/>
        <Undo Repeat = "1"/>

        <Turn  Axis = "1" Layer = "1" Angle = "A1" />
        <Split Axis = "5" From = "1"/>
        <Undo Repeat = "1"/>

        <Hide  Axis = "1" Layer = "0" />
        <Turn  Axis = "4" Layer = "1" Angle = "-A1" />
        <Turn  Axis = "5" Layer = "1" Angle = "A1" />
        <Split Axis = "1" From = "1"/>
        <Undo Repeat = "2"/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
