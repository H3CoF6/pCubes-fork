<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Bicone Fisher Skewb (2 colors)</Name>
        <Menu>Other forms\Bicone\Bicone Fisher Skewb (2 colors)</Menu>
        <Menu>Other forms\Skewb variants\Bicone\Bicone Fisher Skewb (2 colors)</Menu>
        <Inventor>JoseRo</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-05</Added>
        <Link>https://www.instagram.com/p/CJdSfw2K2L-/</Link>
    </Interface>

    <Script>
        Color1 := '0077EE'; // Blue
        Color2 := 'FFFFFF'; // White

        H := 0.7;
        R := H * 0.8;

        for i := 0 to 59 do begin
            x[i] := R * cos(2 * Pi / 60 * i);
            y[i] := R * sin(2 * Pi / 60 * i);
        end;

        for i := 0 to 2 do begin
            ax[i] := sin(2 * Pi / 3 * (i + 0.25));
            ay[i] := cos(2 * Pi / 3 * (i + 0.25));
        end;
        az := -1/sqrt(8);
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "ax[0]; ay[0]; az" />
        <Axis NormVector = "ax[1]; ay[1]; az" />
        <Axis NormVector = "ax[2]; ay[2]; az" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace1" >
            <Face Color = "Color1" VertexIndexes = "0; i + 2; (i + 1) mod 60 + 2" InvisibleEdges = "5" />
            <Script> Inc(i); </Script>
        </Macro>

        <Macro Name = "AddFace2" >
            <Face Color = "Color2" VertexIndexes = "1; (i + 1) mod 60 + 2; i + 2" InvisibleEdges = "5" />
            <Script> Inc(i); </Script>
        </Macro>

        <Part>
            <Vertices Vectors = "0; 0; H" />
            <Vertices Vectors = "0; 0;-H" />
            <Vertices Vectors = "x; y; 0" />

            <Faces>
                <ExecMacro MacroName = "AddFace1" i = "0" Repeat = "60" />
                <ExecMacro MacroName = "AddFace2" i = "0" Repeat = "60" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
