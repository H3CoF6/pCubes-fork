<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Biconeminx (2 colors)</Name>
        <Menu>Other forms\Bicone\Biconeminx (2 colors)</Menu>
        <Inventor>Alexandr Bezrukov</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2021-05-08</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7203</Link>
    </Interface>

    <Script>
        Color0 := '0033FF'; // Blue
        Color1 := 'DDAA00'; // Gold

        H := 0.7;
        R := H * 0.725;

        s3 := sqrt(3);
        s5 := sqrt(5);

        D := R * sqrt((5 - s5) / 10);

        for i := 0 to 59 do begin
            x[i] := R * cos(2 * Pi / 60 * i);
            y[i] := R * sin(2 * Pi / 60 * i);
        end;
    </Script>

    <Axes TurningAngles = "2 * Pi / 5" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "-s3;-1; (3 + s5) / 2" />
        <Axis NormVector = " s3;-1; (3 + s5) / 2" />
        <Axis NormVector = "-s3; 1; (3 - s5) / 2" />
        <Axis NormVector = " s3; 1; (3 - s5) / 2" />
        <Axis NormVector = "  0; 3 - s5; 1" />
        <Axis NormVector = "  0;-3 - s5; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddFace1" >
            <Face Color = "Color0" VertexIndexes = "0; i + 2; (i + 1) mod 60 + 2" InvisibleEdges = "5" />
            <Script> Inc(i); </Script>
        </Macro>

        <Macro Name = "AddFace2" >
            <Face Color = "Color1" VertexIndexes = "1; (i + 1) mod 60 + 2; i + 2" InvisibleEdges = "5" />
            <Script> Inc(i); </Script>
        </Macro>

        <Part>
            <Vertices Vectors = "0; 0; H" />
            <Vertices Vectors = "0; 0;-H" />
            <Vertices Vectors = "x; y; 0" />

            <Faces>
                <ExecMacro MacroName = "AddFace1" i = "0" Repeat = "60" />
                <ExecMacro MacroName = "AddFace2" i = "0" Repeat = "60" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
