<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda House Red</Name>
        <Menu>Other forms\Bermuda Cubes\House Red</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-03-26</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2814</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        Colors[0] := clBlue;
        Colors[1] := clGreen;
        Colors[2] := clWhite;
        Colors[3] := clYellow;
        Colors[4] := clOrange;

        W := 0.5;
        D := W * (sqrt(2) - 1);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W * 1.5" DWZ = "W * 0.5"  />
        <Split Axis = "2" From = "2" />
        <Split Axis = "1" From = "1" />
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "W" /></Hide>
        <Split Axis = "1" From = "2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <HideContaining Vector = " W; 0; W" />
        <Cut Color = "clRed" ><Plane NormVector = "-1; 0;-1" NormDistance = "-W" /></Cut>
        <Cut Color = "clRed" ><Plane NormVector = " 1; 0;-1" NormDistance = "-W" /></Cut>
        <InvertVisibility/>
        <Cut Color = "clRed" ><Plane NormVector = " 0;-1;-1" NormDistance = "-W" /></Cut>
        <Cut Color = "clRed" ><Plane NormVector = " 0; 1;-1" NormDistance = "-W" /></Cut>
        <Hide Axis = "1" From = "1" />
        <Split><Plane NormVector = "-1; 0;-1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = " 1; 0; 0" NormDistance = " D" /></Split>
        <Hide> <Plane NormVector = "-1; 0;-1" NormDistance = " D" /></Hide>
        <Split><Plane NormVector = "-1; 0; 1" NormDistance = " D" /></Split>
        <Split><Plane NormVector = "-1; 0; 1" NormDistance = "-D" /></Split>
        <InvertVisibility/>
        <HideContaining Vector = " 0;-W; 0" />
        <SplitByAxes/>
        <ShowAll/>
        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
