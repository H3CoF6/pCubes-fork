<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Bermuda House - Charon</Name>
        <Menu>Other forms\Bermuda Cubes\House - Charon</Menu>
        <Inventor>Wu Zhe</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2023-09-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=11414</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';
        clLightViolett := 'FF0080';
        clViolett      := '800080';

        Colors[0] := clGreen;
        Colors[1] := clRed;
        Colors[2] := clWhite;
        Colors[3] := clYellow;
        Colors[4] := clViolett;

        W := 0.5;
        D := W * (sqrt(2) - 1);
        S := (W + D) / sqrt(2);
    </Script>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "-D; D" TurnAxesWithLayer = "1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" WX = "W" WY = "W" WZ = "W * 1.5" DWZ = "W * 0.5"  />
        <Split Axis = "2" From = "2" />
        <Split Axis = "1" From = "1" />
        <Hide><Plane NormVector = " 0; 0; 1" NormDistance = "W" /></Hide>
        <Split Axis = "1" From = "2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <HideContaining Vector = " W; 0; W" />
        <Cut Color = "clBlue" ><Plane NormVector = "-1; 0;-1" NormDistance = "-S" /></Cut>
        <Cut Color = "clLightViolett" ><Plane NormVector = " 1; 0;-1" NormDistance = "-S" /></Cut>
        <InvertVisibility/>
        <Cut Color = "clBlue" ><Plane NormVector = " 0;-1;-1" NormDistance = "-S" /></Cut>
        <Cut Color = "clBlue" ><Plane NormVector = " 0; 1;-1" NormDistance = "-S" /></Cut>
        <Hide Axis = "1" From = "1" />
        <Split><Plane NormVector = "-1; 0;-1" NormDistance = "D" /></Split>
        <Split><Plane NormVector = " 1; 0;-1" NormDistance = "D" /></Split>
        <HideContaining Vector = " 0;-W; 0" />
        <Split><Plane NormVector = " 1; 0; 1" NormDistance = "D" /></Split>
        <Split><Plane NormVector = "-1; 0; 1" NormDistance = "D" /></Split>
        <ShowAll/>
        <Hide Axis = "1" Layer = "0" />
        <Split Axis = "2" From = "1" />
        <Hide Axis = "2" From = "1" />
        <Split><Plane NormVector = " 1; 1; 0" NormDistance = "D" /></Split>
        <Split><Plane NormVector = "-1; 1; 0" NormDistance = "D" /></Split>
        <HideContaining Vector = " 0; 0;-W" />
        <Split><Plane NormVector = "-1;-1; 0" NormDistance = "D" /></Split>
        <Split><Plane NormVector = " 1;-1; 0" NormDistance = "D" /></Split>
        <ShowAll/>
        <HideContaining Vector = " 0; 0; 0" />
        <InvertVisibility/>
        <SplitByAxes/>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
