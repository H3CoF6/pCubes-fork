<?xml version = "1.0" encoding = "UTF-8"?>
<xml>
    <Script>
        if not VarExists('W') then
            W := 0.5;
        if not VarExists('Colors[0]') then begin
            Colors[ 0] := 'FF800A';
            Colors[ 1] := 'FF800A';
            Colors[ 2] := 'FFFF00';
            Colors[ 3] := 'FFFF00';
            Colors[ 4] := 'C80000';
            Colors[ 5] := 'C80000';
            Colors[ 6] := 'FFFFFF';
            Colors[ 7] := '0000C8';
            Colors[ 8] := '964B00';
            Colors[ 9] := '009600';
            Colors[10] := '009600';
            Colors[11] := '964B00';
            Colors[12] := '0000C8';
            Colors[13] := 'FFFFFF';
        end;
    </Script>

        <Part>
            <Vertices>
                <Add Vector = "-W;-W; 0" />
                <Add Vector = "-W; 0; W" />
                <Add Vector = "-W; W; 0" />
                <Add Vector = "-W; 0;-W" />
                <Add Vector = " 0;-W;-W" />
                <Add Vector = " 0;-W; W" />
                <Add Vector = " 0; W; W" />
                <Add Vector = " 0; W;-W" />
                <Add Vector = " W;-W; 0" />
                <Add Vector = " W; 0; W" />
                <Add Vector = " W; W; 0" />
                <Add Vector = " W; 0;-W" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[ 0]" VertexIndexes = " 0; 4; 8; 5" />
                <Face Color = "Colors[ 1]" VertexIndexes = " 2; 6;10; 7" />
                <Face Color = "Colors[ 2]" VertexIndexes = " 0; 1; 2; 3" />
                <Face Color = "Colors[ 3]" VertexIndexes = "11;10; 9; 8" />
                <Face Color = "Colors[ 4]" VertexIndexes = " 3; 7;11; 4" />
                <Face Color = "Colors[ 5]" VertexIndexes = " 1; 5; 9; 6" />
                <Face Color = "Colors[ 6]" VertexIndexes = " 0; 3; 4" />
                <Face Color = "Colors[ 7]" VertexIndexes = " 2; 7; 3" />
                <Face Color = "Colors[ 8]" VertexIndexes = " 0; 5; 1" />
                <Face Color = "Colors[ 9]" VertexIndexes = " 1; 6; 2" />
                <Face Color = "Colors[10]" VertexIndexes = " 4;11; 8" />
                <Face Color = "Colors[11]" VertexIndexes = " 7;10;11" />
                <Face Color = "Colors[12]" VertexIndexes = " 5; 8; 9" />
                <Face Color = "Colors[13]" VertexIndexes = " 6; 9;10" />
            </Faces>
        </Part>
</xml>
