# The upstream sources use CRLF; keep it that way so diffs stay small and
# the files keep working with the original Lazarus project.
*.pas  text eol=crlf
*.lpr  text eol=crlf
*.lpi  text eol=crlf
*.lfm  text eol=crlf
*.lps  text eol=crlf
*.inc  text eol=crlf

# Shell scripts in this repo are LF.
*.sh   text eol=lf

# Binary/runtime assets are left untouched.
*.exe  binary
*.ico  binary
*.res  binary
*.zip  binary
*.png  binary
