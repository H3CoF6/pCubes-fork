# ============================================================
#  Lazarus / Free Pascal build artifacts
# ============================================================

# Compiled units, objects and other compiler output
lib/
*.o
*.ppu
*.a
*.compiled
*.or
*.rst
*.dbg

# Executables and shared libraries
*.exe
*.dll
*.so

# Compiled binary produced by FPC/Lazarus on Unix
/Lazarus_sources/pCubes

# Application bundle Lazarus writes next to the project on macOS
/Lazarus_sources/pCubes.app/

# Lazarus per-user session / local settings (machine specific)
*.lps
*.lpi.local

# Linker scratch file that embeds local machine paths
link*.res

# ============================================================
#  pCubes generated data
# ============================================================

# Puzzle library cache (regenerated on startup)
Puzzles.cache

# ============================================================
#  Misc
# ============================================================
*.bak
*.tmp
*~
