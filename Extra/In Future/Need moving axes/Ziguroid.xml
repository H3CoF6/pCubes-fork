		<RemoveContaining Vector = "-W;-W; 0" />
		<RemoveContaining Vector = " S; U; T" />
		<RemoveContaining Vector = " S; U;-T" />
		<RemoveContaining Vector = " U; S; T" />
		<RemoveContaining Vector = " U; S;-T" />
		<RemoveContaining Vector = " S;-U; T" />
		<RemoveContaining Vector = " S;-U;-T" />
		<RemoveContaining Vector = " U;-S; T" />
		<RemoveContaining Vector = " U;-S;-T" />
		<RemoveContaining Vector = "-S; U; T" />
		<RemoveContaining Vector = "-S; U;-T" />
		<RemoveContaining Vector = "-U; S; T" />
		<RemoveContaining Vector = "-U; S;-T" />
		<RemoveContaining Vector = "-S;-U; T" />
		<RemoveContaining Vector = "-S;-U;-T" />
		<RemoveContaining Vector = "-U;-S; T" />
		<RemoveContaining Vector = "-U;-S;-T" />
-->
    </Figure>
</xml>
