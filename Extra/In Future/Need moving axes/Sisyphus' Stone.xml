<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

<!-- JumbleAngles are not adequate when there is a zero-based axes -->

    <Interface>
        <Name>Sisyphus' Stone</Name>
        <Menu>Test\Other forms\Catalan Solids\Rhombic Dodecahedron\Sisyphus' Stone</Menu>
        <Inventor>Vladi Delimollov</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2026-06-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6910</Link>
    </Interface>

    <Script>
        Clr[0] := '0000D8'; // LightBlue
        Clr[1] := 'C80000'; // Red
        Clr[2] := 'FFFFFF'; // White
        Clr[3] := 'FFFF00'; // Yellow
        Clr[4] := 'FF800A'; // Orange
        Clr[5] := '00A600'; // LightGreen
        Clr[6] := '353535'; // Black

        K := 0.65;
        D := K * 0.6;

        A := Arccos(1/3);
    </Script>

    <Axes TurningAngles = " 0; Pi" JumbleAngle = "A" PlaneDistances = "D" >
        <Axis NormVector = " 0; 1; 1" />
        <Axis NormVector = "-1; 1; 0" />
        <Axis NormVector = "-1; 0;-1" />
        <Axis NormVector = " 0;-1;-1" />
        <Axis NormVector = " 1;-1; 0" />
        <Axis NormVector = " 1; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi/3" PlaneDistances = "0" >
        <Axis NormVector = "-1;-1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddColorBody" >
            <HideAll/>
            <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere_Mono.xml" />
        </Macro>

        <Macro Name = "AddColor" >
            <Script>
                A1 := A * ka;
                A2 := (Pi-A) * ka;
            </Script>

            <ExecMacro MacroName = "AddColorBody" />
            <SplitByAxes/>

            <Cut Axis = "ax1" From = "1" />
            <Turn Axis = "ax1" Layer = "1" Angle = " Pi" />
            <Cut Axis = "ax2" To = "1" />
            <Undo/>

            <Turn Axis = "ax1" Layer = "1" Angle = " A1" />
            <SplitByAxes/>
            <Undo/>

            <Turn Axis = "ax1" Layer = "1" Angle = "-A2" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A1" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />

            <Turn Axis = "ax1" Layer = "1" Angle = " A1" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A1" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />

            <Hide Axis = "ax1" Layer = "0" />
            <Hide Axis = "ax2" Layer = "0" />
            <Turn Axis = "ax2" Layer = "1" Angle = " A1" />
            <Split Axis = "ax1" From = "1" />
            <Undo/>
            <ShowAll/>

            <Hide Axis = "ax1" Layer = "0" />
            <Turn Axis = "ax1" Layer = "1" Angle = " A1" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A2" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />
            <ShowAll/>

            <Hide Axis = "ax1" Layer = "0" />
            <Turn Axis = "ax1" Layer = "1" Angle = "-A2" />
            <Turn Axis = "ax2" Layer = "1" Angle = "-A2" />
            <Split Axis = "ax1" From = "1" />
            <Undo Repeat = "2" />

            <Turn Axis = "ax2" Layer = "1" Angle = " A2" />
            <Split Axis = "ax1" From = "1" />
            <Undo/>
            <ShowAll/>

            <Hide Axis = "ax2" Layer = "0" />
            <Turn Axis = "ax1" Layer = "1" Angle = " Pi" />
            <Turn Axis = "6" Layer = "1 - (ka + 1) div 2" Angle = "-Pi/3" />
            <Turn Axis = "ax1" Layer = "1" Angle = "-A2" />
            <Split Axis = "ax2" From = "1" />
            <Undo/>
            <Turn Axis = "ax2" Layer = "1" Angle = " A2" />
            <Split Axis = "ax1" From = "1" />
            <Undo/>
            <sHOWaLL/>
            <Undo Repeat = "2" />
        </Macro>

        <ExecMacro MacroName = "AddColor" Color = "Clr[1]" ka = "-1" ax1 = "0" ax2 = "5" />
        <ExecMacro MacroName = "AddColor" Color = "Clr[2]" ka = " 1" ax1 = "1" ax2 = "0" />
        <ExecMacro MacroName = "AddColor" Color = "Clr[3]" ka = "-1" ax1 = "2" ax2 = "1" />
        <ExecMacro MacroName = "AddColor" Color = "Clr[4]" ka = " 1" ax1 = "3" ax2 = "2" />
        <ExecMacro MacroName = "AddColor" Color = "Clr[5]" ka = "-1" ax1 = "4" ax2 = "3" />
        <ExecMacro MacroName = "AddColor" Color = "Clr[0]" ka = " 1" ax1 = "5" ax2 = "4" />
        <ExecMacro MacroName = "AddColorBody" Color = "Clr[6]" />

        <Cut Axis = "0" To = "1" />
        <Cut Axis = "1" To = "1" />
        <Cut Axis = "2" To = "1" />
        <Cut Axis = "3" To = "1" />
        <Cut Axis = "4" To = "1" />
        <Cut Axis = "5" To = "1" />
        <Split Axis = "6" From = "1" />
        <ShowAll/>
        <SaveSolvedState/>

        <Turn NormVector = "-1; 1;0" Angle = " Arctan(sqrt(2))" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
