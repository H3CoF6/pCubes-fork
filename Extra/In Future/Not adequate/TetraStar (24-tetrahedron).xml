<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>TetraStar (24-tetrahedron)</Name>
        <Menu>Other forms\Tetrahedron\TetraStar (24-tetrahedron)</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2014-05-22</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4039</Link>
    </Interface>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "0" TurnAxesWithPartNo = "0" >
        <Axis NormVector = " 1;  1;  0" />
        <Axis NormVector = " 1; -1;  0" />
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 0;  1; -1" />
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = "-1;  0;  1" />
    </Axes>

    <Script>
        R := 0.5;
    </Script>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " R;  R;  R" />
                <Add Vector = "-R; -R;  R" />
                <Add Vector = " R; -R; -R" />
                <Add Vector = "-R;  R; -R" />
            </Vertices>
            <Faces>
                <Face Color = "C80000" VertexIndexes = "0;3;1" />
                <Face Color = "0000C8" VertexIndexes = "1;3;2" />
                <Face Color = "009600" VertexIndexes = "0;2;3" />
                <Face Color = "FFFF00" VertexIndexes = "0;1;2" />
            </Faces>
        </Part>
        <SplitByAxes/>
    </Figure>
</xml>
