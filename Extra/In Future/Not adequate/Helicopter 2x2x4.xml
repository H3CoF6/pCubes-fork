<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter 2x2x4</Name>
        <Menu1>Other cubes\Mixed\Face-Edge\Helicopter 2x2x4</Menu1>
        <Menu>Test\Helicopter 2x2x4</Menu>
        <Inventor>Grégoire Pfennig</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2018-11-06</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6449</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        H := 3 * W / 2;
        D := W / sqrt(2);
        A := W / 2;
    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "0" TurnAxesWithLayer = "0" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-A; 0; A" >
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0;-1; 1" BaseVector = " 0; 0;  A"/>
        <Axis NormVector = "-1; 0; 1" BaseVector = " 0; 0; A"/>
        <Axis NormVector = " 0; 1; 1" BaseVector = " 0; 0; A"/>
        <Axis NormVector = " 1; 0; 1" BaseVector = " 0; 0; A"/>
        <Axis NormVector = " 0;-1;-1" BaseVector = " 0; 0;-A"/>
        <Axis NormVector = "-1; 0;-1" BaseVector = " 0; 0;-A"/>
        <Axis NormVector = " 0; 1;-1" BaseVector = " 0; 0;-A"/>
        <Axis NormVector = " 1; 0;-1" BaseVector = " 0; 0;-A"/>
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-W; -W; -H" />
                  <Add Vector = "-W; -W;  H" />
                  <Add Vector = "-W;  W; -H" />
                  <Add Vector = "-W;  W;  H" />
                  <Add Vector = " W; -W; -H" />
                  <Add Vector = " W; -W;  H" />
                  <Add Vector = " W;  W; -H" />
                  <Add Vector = " W;  W;  H" />
            </Vertices>

            <Faces>
                  <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                  <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                  <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                  <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                  <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                  <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        

        <Turn Axis = "3" Angle = "Pi" Layer = "1" />
        <Turn Axis = "5" Angle = "Pi" Layer = "1" />
        <Turn Axis = "7" Angle = "Pi" Layer = "1" />
        <Turn Axis = "9" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>
        <Turn Axis = "4" Angle = "Pi" Layer = "1" />
        <Turn Axis = "6" Angle = "Pi" Layer = "1" />
        <Turn Axis = "8" Angle = "Pi" Layer = "1" />
        <Turn Axis = "10" Angle = "Pi" Layer = "1" />
        <SplitByAxes/>

        <Undo Repeat = "8"/>
    </Figure>
</xml>
