    </Interface>

    <Script>
        W := 1.5 * 0.5;
        include 'Figures\Scripts\Octahedron_Standard_Colors.inc';
        include 'Figures\Scripts\Octahedron_Coordinates.inc';
        k := 1.5;
        D := 0.6;
        jumAngle := ArcCos(1/3);

//ShowMessage((Cx[0]*Cx[1] + Cy[0]*Cy[1] + Cz[0]*Cz[1]) / (Cx[0]^2 + Cy[0]^2 + Cz[0]^2));
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "Cx[0]; Cy[0]; Cz[0]" />
        <Axis NormVector = "Cx[1]; Cy[1]; Cz[1]" />
        <Axis NormVector = "Cx[2]; Cy[2]; Cz[2]" />
        <Axis NormVector = "Cx[3]; Cy[3]; Cz[3]" />
    </Axes>

    <Axes TurningAngles = "Pi" JumbleAngle = "jumAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "Ex[0]; Ey[0]; Ez[0]" />
        <Axis NormVector = "Ex[1]; Ey[1]; Ez[1]" />
        <Axis NormVector = "Ex[2]; Ey[2]; Ez[2]" />
        <Axis NormVector = "Ex[3]; Ey[3]; Ez[3]" />
        <Axis NormVector = "Ex[4]; Ey[4]; Ez[4]" />
        <Axis NormVector = "Ex[5]; Ey[5]; Ez[5]" />
    </Axes>
    
    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />

                <Add Vector = "Ex[ 0]*k; Ey[ 0]*k; Ez[ 0]*k" /> 6
                <Add Vector = "Ex[ 1]*k; Ey[ 1]*k; Ez[ 1]*k" /> 7
                <Add Vector = "Ex[ 2]*k; Ey[ 2]*k; Ez[ 2]*k" /> 8
                <Add Vector = "Ex[ 3]*k; Ey[ 3]*k; Ez[ 3]*k" /> 9
                <Add Vector = "Ex[ 4]*k; Ey[ 4]*k; Ez[ 4]*k" />10
                <Add Vector = "Ex[ 5]*k; Ey[ 5]*k; Ez[ 5]*k" />11
