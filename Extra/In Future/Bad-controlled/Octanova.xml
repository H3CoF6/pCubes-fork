                <Add Vector = "Ex[ 7]*k; Ey[ 7]*k; Ez[ 7]*k" />13
                <Add Vector = "Ex[ 8]*k; Ey[ 8]*k; Ez[ 8]*k" />14
                <Add Vector = "Ex[ 9]*k; Ey[ 9]*k; Ez[ 9]*k" />15
                <Add Vector = "Ex[10]*k; Ey[10]*k; Ez[10]*k" />16
                <Add Vector = "Ex[11]*k; Ey[11]*k; Ez[11]*k" />17

            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = " 5; 7;13" />
                <Face Color = "Colors[0]" VertexIndexes = " 0; 8; 7" />
                <Face Color = "Colors[0]" VertexIndexes = " 2;13; 8" />
                <Face Color = "Colors[0]" VertexIndexes = " 7; 8;13" />

                <Face Color = "Colors[1]" VertexIndexes = " 5;13;15" />
                <Face Color = "Colors[1]" VertexIndexes = " 2;16;13" />
                <Face Color = "Colors[1]" VertexIndexes = " 1;15;16" />
                <Face Color = "Colors[1]" VertexIndexes = "13;16;15" />

                <Face Color = "Colors[2]" VertexIndexes = " 5;15;10" />
                <Face Color = "Colors[2]" VertexIndexes = " 1;14;15" />
                <Face Color = "Colors[2]" VertexIndexes = " 3;10;14" />
                <Face Color = "Colors[2]" VertexIndexes = "15;14;10" />

                <Face Color = "Colors[3]" VertexIndexes = " 5;10; 7" />
