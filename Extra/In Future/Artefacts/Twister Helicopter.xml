<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

// not belle

    <Interface>
        <Name>Twister Helicopter</Name>
        <Menu>Other forms\Twister\Helicopter</Menu>
        <Inventor>davidcubes</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2017-10-16</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=9&amp;t=32316</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        N := 5;
        Delta := 0.0001;

        // fill array
        x[0, 0] :=  W;
        x[0, N] := -W;
        x[N, 0] := -W;
        x[N, N] := -W;
        y[0, 0] := -W;
        y[0, N] := -W;
        y[N, 0] := -W;
        y[N, N] :=  W;
        for Row := 0 to N do begin
            z[Row] := -W + 2 * W / N * Row;
            x[0, Row] := x[0, 0] + (x[0, N] - x[0, 0]) / N * Row;
            y[0, Row] := y[0, 0] + (y[0, N] - y[0, 0]) / N * Row;
            x[N, Row] := x[N, 0] + (x[N, N] - x[N, 0]) / N * Row;
            y[N, Row] := y[N, 0] + (y[N, N] - y[N, 0]) / N * Row;

            for i := 1 to N - 1 do begin
              x[i, Row] := x[0, Row] + (x[N, Row] - x[0, Row]) / N * i;
              y[i, Row] := y[0, Row] + (y[N, Row] - y[0, Row]) / N * i;
            end;
        end;

        kc := 0.3;

        D := sqrt(2) / 4;
        D1 := D - W * 0.001;

    </Script>

    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>
    <Axes TurningAngles = "0" PlaneDistances = "0" > <!-- fake axis for figure creation -->
        <Axis NormVector = " 0;  0;  1" />
    </Axes>
 
    <Figure>
        <Macro Name = "AddFace" >
            <Part>
                <Vertices>
                    <Add Vector = " x[i, Row]; y[i, Row]; z[Row]" />
                    <Add Vector = " x[i + 1, Row]; y[i + 1, Row]; z[Row]" />
                    <Add Vector = " x[i, Row + 1]; y[i, Row + 1]; z[Row + 1]" />
<!--                    <Add Vector = " (x[i] + x[i + 1] + x[i + N4])*kc; (y[i] + y[i+1] + y[i + N4])*kc; (2*z[i]+z[i + N4])*kc" />-->
                </Vertices>
                <Faces>
                    <Face Color = "colors[c1]" VertexIndexes = "0;2;1" InvisibleEdges = "Inv1" />
                    <Face Color = "0"          VertexIndexes = "0;1;2" InvisibleEdges = "7" />
<!--                    <Face Color = "0"          VertexIndexes = "0;1;3" InvisibleEdges = "7" />
                    <Face Color = "0"          VertexIndexes = "1;2;3" InvisibleEdges = "7" />
                    <Face Color = "0"          VertexIndexes = "2;0;3" InvisibleEdges = "7" />-->
                </Faces>
            </Part>

            <Part>
                <Vertices>
                    <Add Vector = " x[i + 1, Row]; y[i + 1, Row]; z[Row]" />
                    <Add Vector = " x[i + 1, Row + 1]; y[i + 1, Row + 1]; z[Row + 1]" />
                    <Add Vector = " x[i, Row + 1]; y[i, Row + 1]; z[Row + 1]" />
                    <Add Vector = " (x[i + 1, Row] + x[i, Row + 1] + x[i + 1, Row + 1])*kc; (y[i + 1, Row] + y[i, Row + 1] + y[i + 1, Row + 1])*kc; (z[Row] + 2*z[Row+1])*kc" />
                </Vertices>
                <Faces>
                    <Face Color = "colors[c1]" VertexIndexes = "0;2;1" InvisibleEdges = "Inv2" />
<!--                    <Face Color = "0"          VertexIndexes = "0;1;2" InvisibleEdges = "7" />-->
                    <Face Color = "0"          VertexIndexes = "1;2;3" InvisibleEdges = "7" />
                    <Face Color = "0"          VertexIndexes = "2;0;3" InvisibleEdges = "7" />
                    <Face Color = "0"          VertexIndexes = "0;1;3" InvisibleEdges = "7" />
                </Faces>
            </Part>
            <Script>Inc(i);</Script>

        </Macro>

        <Macro Name = "AddFaceH" >
            <ExecMacro MacroName = "AddFace" i = "0  " Repeat = "1    " Inv1 = "6" Inv2 = "7" />
            <ExecMacro MacroName = "AddFace" i = "1  " Repeat = "N - 2" Inv1 = "7" Inv2 = "7" />
            <ExecMacro MacroName = "AddFace" i = "N-1" Repeat = "1    " Inv1 = "7" Inv2 = "3" />
            <Script>Inc(Row);</Script>
        </Macro>

        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "2" c2 = "1" Row = "0" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "0" c2 = "2" Row = "0" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "3" c2 = "0" Row = "0" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />
        <ExecMacro MacroName = "AddFaceH" j = "0" Repeat = "N" c1 = "1" c2 = "3" Row = "0" />
        <Turn Axis = "6" From = "0" To = "1" Angle = "Pi / 2" />

        // Top
        <Part>
            <Vertices>
                <Add Vector = "-W; -W;  W" />
                <Add Vector = "-W; -W;  W+Delta" />
                <Add Vector = "-W;  W;  W" />
                <Add Vector = "-W;  W;  W+Delta" />
                <Add Vector = " W; -W;  W" />
                <Add Vector = " W; -W;  W+Delta" />
                <Add Vector = " W;  W;  W" />
                <Add Vector = " W;  W;  W+Delta" />
            </Vertices>

            <Faces>
                <Face Color = "0"         VertexIndexes = "1;0;4;5" />
                <Face Color = "0"         VertexIndexes = "2;3;7;6" />
                <Face Color = "0"         VertexIndexes = "0;1;3;2" />
                <Face Color = "0"         VertexIndexes = "5;4;6;7" />
                <Face Color = "0"         VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        // Bottom
        <Part>
            <Vertices>
                <Add Vector = "-W; -W; -W-Delta" />
                <Add Vector = "-W; -W; -W" />
                <Add Vector = "-W;  W; -W-Delta" />
                <Add Vector = "-W;  W; -W" />
                <Add Vector = " W; -W; -W-Delta" />
                <Add Vector = " W; -W; -W" />
                <Add Vector = " W;  W; -W-Delta" />
                <Add Vector = " W;  W; -W" />
            </Vertices>

            <Faces>
                <Face Color = "0"         VertexIndexes = "1;0;4;5" />
                <Face Color = "0"         VertexIndexes = "2;3;7;6" />
                <Face Color = "0"         VertexIndexes = "0;1;3;2" />
                <Face Color = "0"         VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "0"         VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        // Expand gaps
        <Split Axis  = "0" From  = "1" Color2 = "0" />
        <Split Axis  = "0" From  = "2" Color2 = "0" />
        <Hide  Axis  = "0" Layer = "0" />
        <Hide  Axis  = "0" Layer = "2" />
        <Cut   Color = "0"> <Plane NormVector = " 0; 1; 1" NormDistance = "-D1" /> </Cut>
        <Cut   Color = "0"> <Plane NormVector = " 0;-1;-1" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <Split Axis  = "1" From  = "1" Color2 = "0" />
        <Split Axis  = "1" From  = "2" Color2 = "0" />
        <Hide  Axis  = "1" Layer = "0" />
        <Hide  Axis  = "1" Layer = "2" />
        <Cut   Color = "0"> <Plane NormVector = " 1; 0; 1" NormDistance = "-D1" /> </Cut>
        <Cut   Color = "0"> <Plane NormVector = "-1; 0;-1" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <Split Axis  = "2" From  = "1" Color2 = "0" />
        <Split Axis  = "2" From  = "2" Color2 = "0" />
        <Hide  Axis  = "2" Layer = "0" />
        <Hide  Axis  = "2" Layer = "2" />
        <Cut   Color = "0"> <Plane NormVector = " 0;-1; 1" NormDistance = "-D1" /> </Cut>
        <Cut   Color = "0"> <Plane NormVector = " 0; 1;-1" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <Split Axis  = "3" From  = "1" Color2 = "0" />
        <Split Axis  = "3" From  = "2" Color2 = "0" />
        <Hide  Axis  = "3" Layer = "0" />
        <Hide  Axis  = "3" Layer = "2" />
        <Cut   Color = "0"> <Plane NormVector = "-1; 0; 1" NormDistance = "-D1" /> </Cut>
        <Cut   Color = "0"> <Plane NormVector = " 1; 0;-1" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <Split Axis  = "4" From  = "1" Color2 = "0" />
        <Split Axis  = "4" From  = "2" Color2 = "0" />
        <Hide  Axis  = "4" Layer = "0" />
        <Hide  Axis  = "4" Layer = "2" />
        <Cut   Color = "0"> <Plane NormVector = "-1; 1; 0" NormDistance = "-D1" /> </Cut>
        <Cut   Color = "0"> <Plane NormVector = " 1;-1; 0" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <Split Axis  = "5" From  = "1" Color2 = "0" />
        <Split Axis  = "5" From  = "2" Color2 = "0" />
        <Hide  Axis  = "5" Layer = "0" />
        <Hide  Axis  = "5" Layer = "2" />
        <Cut   Color = "0"> <Plane NormVector = " 1; 1; 0" NormDistance = "-D1" /> </Cut>
        <Cut   Color = "0"> <Plane NormVector = "-1;-1; 0" NormDistance = "-D1" /> </Cut>
        <ShowAll/>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
