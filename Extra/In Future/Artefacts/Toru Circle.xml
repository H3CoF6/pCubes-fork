<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Toru Circle</Name>
        <Menu>Other forms\Catalan solids\Rhombic Dodecahedron\Face Turning\Toru Circle</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-09-30</Added>
    </Interface>

    <Script>
        R := 0.7;
        D1 := R * sqrt(2) / 2;

        Delta := 0.001;

        D2 := R * sqrt(2) / 6 + Delta * sqrt(2) / 3;

        RC := 0.235;
        KC := R / 2 + delta;
    </Script>

    <Axes TurningAngles = "0; Pi; 0; Pi; 0" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-D1; -D2; D2; D1" >
        <Axis NormVector = "1;  1;  0" />
        <Axis NormVector = "1; -1;  0" />
        <Axis NormVector = "1;  0;  1" />
        <Axis NormVector = "1;  0; -1" />
        <Axis NormVector = "0;  1;  1" />
        <Axis NormVector = "0;  1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Rhombic Dodecahedron.xml" />

        <Circle Color = "FF0080" Radius = "RC" Center = " KC; KC;  0" />
        <Circle Color = "BF8040" Radius = "RC" Center = " KC;-KC;  0" />
        <Circle Color = "808000" Radius = "RC" Center = "-KC; KC;  0" />
        <Circle Color = "800040" Radius = "RC" Center = "-KC;-KC;  0" />
        <Circle Color = "FFFFFF" Radius = "RC" Center = "  0; KC; KC" />
        <Circle Color = "000078" Radius = "RC" Center = "  0; KC;-KC" />
        <Circle Color = "0000D8" Radius = "RC" Center = "  0;-KC; KC" />
        <Circle Color = "FFFF00" Radius = "RC" Center = "  0;-KC;-KC" />
        <Circle Color = "C80000" Radius = "RC" Center = " KC;  0; KC" />
        <Circle Color = "005600" Radius = "RC" Center = " KC;  0;-KC" />
        <Circle Color = "00A600" Radius = "RC" Center = "-KC;  0; KC" />
        <Circle Color = "FF800A" Radius = "RC" Center = "-KC;  0;-KC" />

        <SplitByAxes/>
    </Figure>
</xml>
