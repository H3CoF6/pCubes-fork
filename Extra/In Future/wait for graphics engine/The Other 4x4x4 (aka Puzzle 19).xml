<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

   <Interface>
        <Name>The Other 4x4x4 (aka Puzzle 19)</Name>
        
        <Menu>Cubic\Unclassified\The Other 4x4x4 (aka Puzzle 19)</Menu>
        <Inventor>Carl N. Hoff</Inventor>
        <Programmer>xchemist</Programmer>
        <Added></Added>
	<Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6808</Link>
    </Interface>

 <Script>
	
        W := 0.5;
        W1 := W;
        D1 := W / 3;
        D2 := 2 * W / 3;

        W2 := W * 0.50;

        HX := W * 0.08;
        WX := W * 0.10;

	clRed    := 'FF0000';
        clWhite  := 'AA00AA';
        clOrange := 'FF8800';
        clYellow := 'FFFF00';
        clGreen  := '00DD00';
        clBlue   := '0066FF';

        Colors[0] := 'FF0000'; // clRed
        Colors[1] := 'FF8800'; // clOrange
        Colors[2] := '0066FF'; // clBlue
        Colors[3] := '00DD00'; // clGreen
        Colors[4] := 'FFFF00'; // clYellow
        Colors[5] := 'AA00AA'; // clViolett

	include 'Figures\Scripts\Cube_Coordinates.inc';
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
	<Macro Name = "Cube" >
        <Part>
        <Vertices>
            <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
            <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
            <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
            <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
            <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
            <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
            <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
            <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
        </Vertices>

        <Faces>
            <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
            <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
            <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
            <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
            <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
            <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
        </Faces>
    </Part>
	</Macro>

	<ExecMacro MacroName = "Cube" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />

        <Macro Name = "HideCenters">
            <HideContaining Vector = "Cx[i];Cy[i];Cz[i]" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "HideCenters" Repeat = "6" i = "0" />

        <RemoveGrayParts/>
        <InvertVisibility/>

        <Split> <Plane NormVector = " 1; 0; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = "-1; 0; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0; 1; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0;-1; 0" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0; 0; 1" NormDistance = "W - HX" /> </Split>
        <Split> <Plane NormVector = " 0; 0;-1" NormDistance = "W - HX" /> </Split>

        <RemoveGrayParts/>

        <Macro Name = "RemoveCenters">
            <RemoveContaining Vector = "Cx[i];Cy[i];Cz[i]" />
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenters" Repeat = "6" i = "0" />

	<Script> WE := 2*D1; DCut1 := W1; DCut2 := W1 + HX; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

       

        <SplitByAxes/>
 <ShowAll/>
<RemoveContaining Vector = " W*0.9; 0; 0" />
<RemoveContaining Vector = " 0; 0; W*0.9" />
<RemoveContaining Vector = " 0; W*0.9; 0" />
<RemoveContaining Vector = " -W*0.9; 0; 0" />
<RemoveContaining Vector = " 0; 0; -W*0.9" />
<RemoveContaining Vector = " 0; -W*0.9; 0" />

<RemoveContaining Vector = " W1; 0; 0" />
<RemoveContaining Vector = " 0; 0; W1" />
<RemoveContaining Vector = " 0; W1; 0" />
<RemoveContaining Vector = " -W1; 0; 0" />
<RemoveContaining Vector = " 0; 0; -W1" />
<RemoveContaining Vector = " 0; -W1; 0" />

        <Script>
            W := W2;
	include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>
        <ExecMacro MacroName = "Cube" />
        <ShowAll/>
        <SplitByAxes/>

        <Script> WE := WX; DCut1 := W1; DCut2 := W1 + HX; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := WX; DCut1 := W2; DCut2 := W2 + HX; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <ShowAll/>

        <RemoveGrayParts/>

<ShowAll/>
<Connect Layers = "1;3" />
</Figure>
</xml>
