<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

Visualization-engine must be updated

   <Interface>
      <Name>Square-1 Master</Name>
      <Menu>Other cubes\Square-1\Square-1 Master</Menu>
      <Inventor>Ben Streeter</Inventor>
   </Interface>

    <Script>
        S16 := sin (Pi / 8);
        C16 := cos (Pi / 8);

        W := 1;
        H := W / C16;
    </Script>

    <Axes TurningAngles = "Pi / 8" PlaneDistances = "-1/6; 0; 1/6" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " C16; S16; 0" />
        <Axis NormVector = "-S16; C16; 0" />
    </Axes>

    <Figure>
           <Part>
               <Vertices>
                   <Add Vector = "-W / 2; -W / 2; -H / 2" />
                   <Add Vector = "-W / 2; -W / 2; H / 2" />
                   <Add Vector = "-W / 2; W / 2; -H / 2" />
                   <Add Vector = "-W / 2; W / 2; H / 2" />
                   <Add Vector = "W / 2; -W / 2; -H / 2" />
                   <Add Vector = "W / 2; -W / 2; H / 2" />
                   <Add Vector = "W / 2; W / 2; -H / 2" />
                   <Add Vector = "W / 2; W / 2; H / 2" />
               </Vertices>

               <Faces>
                   <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                   <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                   <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                   <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                   <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                   <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
               </Faces>
           </Part>

        <SplitByAxes/>

           <Turn Axis = "0" Angle = "Pi / 8" From = "0" To = "0" />
           <Turn Axis = "0" Angle = "Pi / 8" From = "3" To = "3" />
           <Split>
               <Plane NormDistance = "0" >
                   <NormVector X = "C16" Y = "S16" Z = "0" />
               </Plane>
           </Split>
           <Turn Axis = "0" Angle = "Pi / 8" From = "0" To = "0" />
           <Turn Axis = "0" Angle = "Pi / 8" From = "3" To = "3" />
           <Split>
               <Plane NormDistance = "0" >
                   <NormVector X = "C16" Y = "S16" Z = "0" />
               </Plane>
           </Split>
           <Turn Axis = "0" Angle = "Pi / 4" From = "0" To = "0" />
           <Turn Axis = "0" Angle = "Pi / 4" From = "3" To = "3" />
           <Split>
               <Plane NormDistance = "0" >
                   <NormVector X = "C16" Y = "S16" Z = "0" />
               </Plane>
           </Split>
           <Turn Axis = "0" Angle = "Pi / 8" From = "0" To = "0" />
           <Turn Axis = "0" Angle = "Pi / 8" From = "3" To = "3" />
           <Split>
               <Plane NormDistance = "0" >
                   <NormVector X = "C16" Y = "S16" Z = "0" />
               </Plane>
           </Split>
           <Turn Axis = "0" Angle = "Pi / 8" From = "0" To = "0" />
           <Turn Axis = "0" Angle = "Pi / 8" From = "3" To = "3" />
           <Split>
               <Plane NormDistance = "0" >
                   <NormVector X = "C16" Y = "S16" Z = "0" />
               </Plane>
           </Split>
           <Turn Axis = "0" Angle = "-Pi * 3 / 4" From = "0" To = "0" />
           <Turn Axis = "0" Angle = "-Pi * 3 / 4" From = "3" To = "3" />
    </Figure>
</xml>
