    <Figure>
        <Cylinder Radius = "R" Color = "clRed   " >
            <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
            <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Cut>
        <HideContaining Vector = "0; 0; 0" />
        <Cylinder Radius = "R" Color = "clGreen " >
            <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
            <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Cut>
        <HideContaining Vector = "0; 0; 0" />
        <Cylinder Radius = "R" Color = "clOrange" >
            <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
            <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Cut>
        <HideContaining Vector = "0; 0; 0" />
        <Cylinder Radius = "R" Color = "clBlue  " >
            <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
            <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Cut>
        <ShowAll/>
        <Circle Radius = "R" Color = "clWhite " > <Center X =  "0" Y =  "0" Z = " H2" /> </Circle>
        <Circle Radius = "R" Color = "clYellow" > <Center X =  "0" Y =  "0" Z = "-H2" /> </Circle>
        <SplitByAxes/>
