    <Interface>
        <Name>Hexcopter 18</Name>
        <Menu>Grigr\Hexcopter 18</Menu>
        <Inventor>Joseph Wong</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-07-12</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6118</Link>
