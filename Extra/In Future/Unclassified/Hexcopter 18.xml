    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clPurple := '800080';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';
        clOrange := 'FF6000';
        clCyan   := '00FFFF';

        R := 0.6;
        H := R * 0.65;
        D := R * 0.7;

        for i := 0 to 5 do begin
            x[i] := R * sin(Pi / 3 * i);
            y[i] := R * cos(Pi / 3 * i);
        end;
        az := R / 2;

        A2 := ArcCos(-1/4);
        A1 := ArcCos(-7/8); // 2*(Pi-A1)

        B1 := ArcCos(3/5);
        B2 := Pi - B1;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A2;-A1;0;A1;A2;Pi" PlaneDistances = "-D;D" FixedLayers = "1" >
        <Axis NormVector = " y[0]; x[0]; az" />
        <Axis NormVector = " y[1]; x[1]; az" />
        <Axis NormVector = " y[2]; x[2]; az" />
        <Axis NormVector = " y[3]; x[3]; az" />
        <Axis NormVector = " y[4]; x[4]; az" />
        <Axis NormVector = " y[5]; x[5]; az" />
    </Axes>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-B2;-B1;0;B1;B2;Pi" PlaneDistances = "0" TurnAxesWithLayer = "0" >
<!--    <Axes TurningAngles = "2*Pi" AvailableAngles = "-B2;-B1;0;B1;B2;Pi" PlaneDistances = "0" TurnAxesWithPartNo = "30" >-->
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Vector X = "x[0]" Y = "y[0]" Z = "-H" />
                <Vector X = "x[1]" Y = "y[1]" Z = "-H" />
                <Vector X = "x[2]" Y = "y[2]" Z = "-H" />
                <Vector X = "x[3]" Y = "y[3]" Z = "-H" />
                <Vector X = "x[4]" Y = "y[4]" Z = "-H" />
                <Vector X = "x[5]" Y = "y[5]" Z = "-H" />

                <Vector X = "x[0]" Y = "y[0]" Z = " H" />
