<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Ten Billion Barrel</Name>
        <Class>TConstrained</Class>
        <Menu>Cubic\Multi-core\Ten Billion Barrel</Menu>
        <Inventor>Leslie Le</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2020-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=10</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        D := W / 6;
        Wx := D;
        Wy := D;
        Wz := D;
        DWy := -W;

        Ay := -W * 6.5;

        sAngle := 2 * pi / 7;

        for i := 0 to 6 do begin
            Qx[i] := Ay * sin(sAngle * i);
            Qy[i] := Ay * cos(sAngle * i);
            Qz[i] := 0;
        end;
    </Script>

    <Axes TurningAngles = "0; 2*Pi/5; 2*Pi/5; 0" PlaneDistances = "-4 * D; 0; 4 * D" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes TurningAngles = "2 * Pi / 10000" PlaneDistances = "-1;1" >
        <Axis NormVector = "1; 0; 0" BaseVector = "0; 1000; 0" MinAngles = "0; -Pi/5000; 0" MaxAngles = "0; Pi/5000; 0" />
    </Axes>

    <Figure>
        <Macro Name = "AddPart">
            <Script>
                for i := 0 to 5 do
                    Colors[i] := Color;
            </Script>
            <LoadFrom File = "Figures\Cuboid.xml" />
            <Turn1 NormVector = "0; 0; 1" Angle = "2 * Pi / 7" />
        </Macro>

        <Macro Name = "AddColumn">
            <ExecMacro MacroName = "AddPart" Color = "770000" DWz = "-3 * D" />
            <ExecMacro MacroName = "AddPart"                  DWz = "-1 * D" />
            <ExecMacro MacroName = "AddPart"                  DWz = " 1 * D" />
            <ExecMacro MacroName = "AddPart"                  DWz = " 3 * D" />
            <ExecMacro MacroName = "AddPart" Color = "444444" WZ = "2 * D" DWz = " 6 * D" />
            <ExecMacro MacroName = "AddPart" Color = "444444" WZ = "2 * D" DWz = "-6 * D" />
            <SaveSolvedState/>
        </Macro>
        <ExecMacro MacroName = "AddColumn" Color = "770000" WZ = "D" DWz = "-3 * D" />
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />

</xml>
