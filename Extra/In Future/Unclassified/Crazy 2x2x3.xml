<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Crazy 2x2x3</Name>
        <Menu>Grigr\Crazy 2x2x3</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-07</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2707</Link>
    </Interface>

    <Script>
        Delta := 0.002;
        R := 0.35;
        D := 0.5 + Delta;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6"  TurnAxesWithPartNo = "7">
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

           <Circle Radius = "R" Color = "clOrange" > <Center X =  "D" Y =  "0" Z =  "0" /> </Circle>
           <Circle Radius = "R" Color =    "clRed" > <Center X = "-D" Y =  "0" Z =  "0" /> </Circle>
           <Circle Radius = "R" Color =  "clGreen" > <Center X =  "0" Y =  "D" Z =  "0" /> </Circle>
           <Circle Radius = "R" Color =   "clBlue" > <Center X =  "0" Y = "-D" Z =  "0" /> </Circle>
           <Circle Radius = "R" Color =  "clWhite" > <Center X =  "0" Y =  "0" Z =  "D" /> </Circle>
           <Circle Radius = "R" Color = "clYellow" > <Center X =  "0" Y =  "0" Z = "-D" /> </Circle>

        <SplitByAxes/>
    </Figure>
</xml>
