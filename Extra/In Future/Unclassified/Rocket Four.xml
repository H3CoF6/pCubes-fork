    <Script>
        K := 0.5;

        A1 := ArcCos(3/4);
        A2 := Pi - ArcCos(3/4);
        A3 := ArcCos(9/16);
        A4 := Pi - A3;

        s6 := sqrt(6);
    </Script>       

