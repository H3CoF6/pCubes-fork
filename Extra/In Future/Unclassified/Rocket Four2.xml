    <Script>
        K := 0.5;

        A1 := Pi/2;

        // Calcs angle from 2 to 3 while rotating over 1
        function Angle(x1, y1, z1, x2, y2, z2, x3, y3, z3);
        begin
          vx := y1 * z2 - y2 * z1;
          vy := z1 * x2 - z2 * x1;
          vz := x1 * y2 - x2 * y1;
          wx := y1 * z3 - y3 * z1;
          wy := z1 * x3 - z3 * x1;
          wz := x1 * y3 - x3 * y1;
          Result := ArcCos((vx*wx + vy*wy + vz*wz) / (vx^2 + vy^2 + vz^2));
        end;
        A1 := Angle(-27.77492045,-0.00014384,-11.33815655, -0.00042335,27.77461953,-11.33889366,  0.00126567,27.7741288,11.34009559);
ShowMessage(cos(A1));
        A2 := Pi-A1;

        D := K* 0.0;       
    </Script>       

