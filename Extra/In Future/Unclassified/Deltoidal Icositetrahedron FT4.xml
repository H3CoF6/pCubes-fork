<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

D := 0 -> make AxesTurnWithPartNo

    <Interface>
        <Name>Deltoidal Icositetrahedron FT4</Name>
        <Menu>Other forms\Deltoidal Icositetrahedron\FT4</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-01-10</Added>
    </Interface>

    <Script>
        clWhite       := 'F0F0F0';
        clSilver      := 'C0C0C0';
        clGray        := '808080';
        clBlack       := '202020';

        clCyan        := '00FFFF';
        clTeal        := '008080';
        clBlue        := '0000FF';
        clNavy        := '000080';

        clRed         := 'FF0000';
        clBrown       := '800000';
        clCoral       := 'FF7F50';
        clIndian      := 'CD5C5C';

        clYellow      := 'FFFF00';
        clOlive       := '808000';
        clOrange      := 'FF6000';
        clGolden      := 'DDBB20';

        clLime        := '00FF00';
        clGreen       := '008000';
        clDarkGreen   := '006400';
        clGreenYellow := 'ADFF2F';

        clFuchsia     := 'FF00FF';
        clPurple      := '800080';
        clPink        := 'FF69B4';
        clPale        := 'DB7093';

        K  := 0.5;

        C0 := K * (4 + sqrt(2)) / 7;
        C1 := K * sqrt(2);

        nA := 1;
        n0 := sqrt(2) + 1;

        A1 := ArcCos( sqrt(2) / 8 + 0.25);
        A2 := ArcCos( sqrt(2) / 4 - 0.5 );
        A3 := ArcCos(-sqrt(2) / 2 - 0.25);

        D := 0;

        // external variable
        FixedPartNo := 0;
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A3; -A2; -A1; 0; A1; A2; A3" PlaneDistances = "-D; D" Tur111nAxesWithLayer = "1">
        <Axis NormVector = " nA; nA; n0" />
        <Axis NormVector = "-nA; nA; n0" />
        <Axis NormVector = " nA;-nA; n0" />
        <Axis NormVector = "-nA;-nA; n0" />

        <Axis NormVector = " nA; n0; nA" />
        <Axis NormVector = "-nA; n0; nA" />
        <Axis NormVector = " nA; n0;-nA" />
        <Axis NormVector = "-nA; n0;-nA" />

        <Axis NormVector = " n0; nA; nA" />
        <Axis NormVector = " n0;-nA; nA" />
        <Axis NormVector = " n0; nA;-nA" />
        <Axis NormVector = " n0;-nA;-nA" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "   0;    0;   C1" />
                <Add Vector = "   0;    0;  -C1" />
                <Add Vector = "  C1;    0;    0" />
                <Add Vector = " -C1;    0;    0" />
                <Add Vector = "   0;   C1;    0" />
                <Add Vector = "   0;  -C1;    0" />
                <Add Vector = "   K;    0;    K" />
                <Add Vector = "   K;    0;   -K" />
                <Add Vector = "  -K;    0;    K" />
                <Add Vector = "  -K;    0;   -K" />
                <Add Vector = "   K;    K;    0" />
                <Add Vector = "   K;   -K;    0" />
                <Add Vector = "  -K;    K;    0" />
                <Add Vector = "  -K;   -K;    0" />
                <Add Vector = "   0;    K;    K" />
                <Add Vector = "   0;    K;   -K" />
                <Add Vector = "   0;   -K;    K" />
                <Add Vector = "   0;   -K;   -K" />
                <Add Vector = "  C0;   C0;   C0" />
                <Add Vector = "  C0;   C0;  -C0" />
                <Add Vector = "  C0;  -C0;   C0" />
                <Add Vector = "  C0;  -C0;  -C0" />
                <Add Vector = " -C0;   C0;   C0" />
                <Add Vector = " -C0;   C0;  -C0" />
                <Add Vector = " -C0;  -C0;   C0" />
                <Add Vector = " -C0;  -C0;  -C0" />
            </Vertices>

            <Faces>
                <Face Color = "clWhite"       VertexIndexes = " 0;  6; 18; 14" />
                <Face Color = "clSilver"      VertexIndexes = " 0; 14; 22;  8" />
                <Face Color = "clGray"        VertexIndexes = " 0;  8; 24; 16" />
                <Face Color = "clBlack"       VertexIndexes = " 0; 16; 20;  6" />
                <Face Color = "clCyan"        VertexIndexes = " 1;  9; 23; 15" />
                <Face Color = "clTeal"        VertexIndexes = " 1; 15; 19;  7" />
                <Face Color = "clBlue"        VertexIndexes = " 1;  7; 21; 17" />
                <Face Color = "clNavy"        VertexIndexes = " 1; 17; 25;  9" />
                <Face Color = "clRed"         VertexIndexes = " 2;  7; 19; 10" />
                <Face Color = "clBrown"       VertexIndexes = " 2; 10; 18;  6" />
                <Face Color = "clCoral"       VertexIndexes = " 2;  6; 20; 11" />
                <Face Color = "clIndian"      VertexIndexes = " 2; 11; 21;  7" />
                <Face Color = "clYellow"      VertexIndexes = " 3;  8; 22; 12" />
                <Face Color = "clOlive"       VertexIndexes = " 3; 12; 23;  9" />
                <Face Color = "clOrange"      VertexIndexes = " 3;  9; 25; 13" />
                <Face Color = "clGolden"      VertexIndexes = " 3; 13; 24;  8" />
                <Face Color = "clLime"        VertexIndexes = " 4; 10; 19; 15" />
                <Face Color = "clGreen"       VertexIndexes = " 4; 15; 23; 12" />
                <Face Color = "clDarkGreen"   VertexIndexes = " 4; 12; 22; 14" />
                <Face Color = "clGreenYellow" VertexIndexes = " 4; 14; 18; 10" />
                <Face Color = "clFuchsia"     VertexIndexes = " 5; 11; 20; 16" />
                <Face Color = "clPurple"      VertexIndexes = " 5; 16; 24; 13" />
                <Face Color = "clPink"        VertexIndexes = " 5; 13; 25; 17" />
                <Face Color = "clPale"        VertexIndexes = " 5; 17; 21; 11" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
