<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

Make controls as in 2x2x4

    <Interface>
        <Name>Gorgon 2x2x3</Name>
        <Menu1>Cubic\Gorgon 2x2x3</Menu1>
        <Menu>Test\Gorgon 2x2x3</Menu>
        <Inventor>Andrey Polyakov</Inventor>
        <Programmer>Skallos</Programmer>
    </Interface>
  
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/3; 0; 1/3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
  
    <Figure>
        <Part>
            <Vertices>
                  <Add Vector = "-1/3; -1/3; -2/3" />
                  <Add Vector = "-1/3; -1/3; 2/3" />
                  <Add Vector = "-1/3; 1/3; -2/3" />
                  <Add Vector = "-1/3; 1/3; 2/3" />
                  <Add Vector = "1/3; -1/3; -2/3" />
                  <Add Vector = "1/3; -1/3; 2/3" />
                  <Add Vector = "1/3; 1/3; -2/3" />
                  <Add Vector = "1/3; 1/3; 2/3" />
            </Vertices>
  
            <Faces>
                  <Face Color = "0000C8" VertexIndexes = "1;0;4;5" />
                  <Face Color = "009600" VertexIndexes = "2;3;7;6" />
                  <Face Color = "C80000" VertexIndexes = "0;1;3;2" />
                  <Face Color = "FF800A" VertexIndexes = "5;4;6;7" />
                  <Face Color = "FFFF00" VertexIndexes = "0;2;6;4" />
                  <Face Color = "FFFFFF" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>
           <Split Axis = "0" From = "2" />
           <Split Axis = "1" From = "2" />
           <Split Axis = "2" From = "2" />
           <Split Axis = "2" From = "3" />
        <ShowAll/>
    </Figure>
</xml>
