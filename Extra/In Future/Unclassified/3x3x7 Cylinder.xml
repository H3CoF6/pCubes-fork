<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

Make LxMxN

    <Interface>
        <Name>3x3x7 Cylinder</Name>
        <Class>TCuboid</Class>
        <Menu>Skallos\3x3x7 Barrel</Menu>
        <Menu>Other forms\Cylinder\3x3x7 Cylinder</Menu>
        <Inventor>Tony Fisher</Inventor>
        <Programmer>Skallos</Programmer>
    </Interface>

    <Script>
        Z := 7;

        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        R := 1.5 / Z;
        Delta := 0.002;
        H1 := 0.5;
        H2 := H1 + Delta;
        D := 1 / 2 / Z;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-5/14; -3/14; -1/14; 1/14; 3/14; 5/14" >
    <Axes1 TurningAngles = "Pi / 2" PlaneDistances = "-D; D" />
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes1 TurningAngles = "Pi / 2" PlaneDistances = "-5/14; -3/14; -1/14; 1/14; 3/14; 5/14" >
        <Axis NormVector = "0; 0; 1" />
    </Axes1>

    <Figure>
        <Cylinder Radius = "R" Color = "clRed   " >
           <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
           <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Cut>
        <HideContaining Vector = "0; 0; 0" />
        <Cylinder Radius = "R" Color = "clGreen " >
           <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
           <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = " 1; 1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Cut>
        <HideContaining Vector = "0; 0; 0" />
        <Cylinder Radius = "R" Color = "clOrange" >
           <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
           <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = "-1; 1; 0" NormDistance = "0" /> </Cut>
        <HideContaining Vector = "0; 0; 0" />
        <Cylinder Radius = "R" Color = "clBlue  " >
           <Base X = "0" Y = "0" Z = " H1" Color = "clWhite "/>
           <Top  X = "0" Y = "0" Z = "-H1" Color = "clYellow" />
        </Cylinder>
        <Cut> <Plane NormVector = "-1;-1; 0" NormDistance = "0" /> </Cut>
        <Cut> <Plane NormVector = " 1;-1; 0" NormDistance = "0" /> </Cut>
        <ShowAll/>
        <Circle Radius = "R" Color = "clWhite " > <Center X =  "0" Y =  "0" Z = " H2" /> </Circle>
        <Circle Radius = "R" Color = "clYellow" > <Center X =  "0" Y =  "0" Z = "-H2" /> </Circle>
        <SplitByAxes/>
    </Figure>
</xml>
