<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Matryoshka Cube (no super 'stickers')</Name>
        <Menu>Cubic\Bandaged\Matryoshka Cube (no super 'stickers')</Menu>
        <Inventor>Sam Jiang</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-02-20</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=6956</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Coordinates.inc';
        W := 0.5;

        D1 := W * 3 / 20;
        D2 := W * 6 / 20;
        D3 := W * 10 / 20;
        f := 1;

        clRed    := 'DD0000';
        clOrange := 'FF6600';
        clBlue   := '0000DD';
        clGreen  := '009900';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        Colors[0] := clBlue;
        Colors[1] := clWhite;
        Colors[2] := clOrange;
        Colors[3] := clRed;
        Colors[4] := clGreen;
        Colors[5] := clYellow;
    </Script>

    <Axes TurningAngles = "Pi / 2;0;0;0;0;0" PlaneDistances = "-D3; -D1; -D2; D2; D1; D3" >
        <Axis NormVector = "0; 0; -1" />
        <Axis NormVector = "-1; 0; 0" />
        <Axis NormVector = "0; -1; 0" />
    </Axes>

    <Figure>
        <Script>W := 0.6;</Script>
        <Part>
            <Vertices>
                <Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
                <Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
                <Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
                <Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
                <Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
                <Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
                <Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
                <Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
            </Vertices>

            <Faces>
                <Face Color = "Colors[0]" VertexIndexes = "0;1;3;2" />
                <Face Color = "Colors[1]" VertexIndexes = "5;4;6;7" />
                <Face Color = "Colors[2]" VertexIndexes = "1;0;4;5" />
                <Face Color = "Colors[3]" VertexIndexes = "2;3;7;6" />
                <Face Color = "Colors[4]" VertexIndexes = "0;2;6;4" />
                <Face Color = "Colors[5]" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Script> W := 0.5;</Script>

        <Split><Plane NormDistance = " D3" NormVector = " 1; 0; 0" /></Split>
        <Split><Plane NormDistance = " D3" NormVector = " 0; 1; 0" /></Split>
        <Split><Plane NormDistance = " D3" NormVector = " 0; 0; 1" /></Split>
        <Split><Plane NormDistance = "-D3" NormVector = " 1; 0; 0" /></Split>
        <Split><Plane NormDistance = "-D3" NormVector = " 0; 1; 0" /></Split>
        <Split><Plane NormDistance = "-D3" NormVector = " 0; 0; 1" /></Split>

        <Macro Name = "RemoveCenters" >
            <RemoveContaining Vector = "f*Cx[Id]; f*Cy[Id]; f*Cz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "RemoveCenters" Id = "0" Repeat = "6" />

        <SplitByAxes/>
        <Split><Plane NormDistance = " D3" NormVector = " 1; 0; 0" /></Split>
        <Split><Plane NormDistance = " D3" NormVector = " 0; 1; 0" /></Split>
        <Split><Plane NormDistance = " D3" NormVector = " 0; 0; 1" /></Split>

        <Macro Name = "HideCorners" >
            <HideContaining Vector = "f*Vx[Id]; f*Vy[Id]; f*Vz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "HideCorners" f = "0.6" Id = "0" Repeat = "8" />

        <InvertVisibility/>

        <Macro Name = "Cut" >
            <Cut Color = "Colors[Id]"> <Plane NormVector = "-Cx[Id]; -Cy[Id]; -Cz[Id]" NormDistance = "-W" /> </Cut>
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "Cut" Id = "0" Repeat = "6" />

        <ShowAll/>
        <Macro Name = "HideEdges" >
            <HideContaining Vector = "f*Ex[Id]; f*Ey[Id]; f*Ez[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "HideEdges" Id = "0" Repeat = "12" />

        <InvertVisibility/>

        <Macro Name = "Cut2" >
            <Cut> <Plane NormVector = "-Cx[Id]; -Cy[Id]; -Cz[Id]" NormDistance = "-W" /> </Cut>
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "Cut2" Id = "0" Repeat = "6" />

        <ShowAll/>

        <Hide Axis = "0" From = "2" To = "4" />
        <Hide Axis = "1" From = "2" To = "4" />
        <Hide Axis = "2" From = "2" To = "4" />

        <ExecMacro MacroName = "Cut2" Id = "0" Repeat = "6" />
        <ShowAll/>
        <ExecMacro MacroName = "Cut" Id = "0" Repeat = "6" />
        <ShowAll/>

        <Macro Name = "AddCenters" >
        <HideAll/>

        <Part>
            <Vertices>
                <Add Vector = "-DCut2; -WE; -WE" />
                <Add Vector = "-DCut2; -WE;  WE" />
                <Add Vector = "-DCut2;  WE; -WE" />
                <Add Vector = "-DCut2;  WE;  WE" />
                <Add Vector = " DCut2; -WE; -WE" />
                <Add Vector = " DCut2; -WE;  WE" />
                <Add Vector = " DCut2;  WE; -WE" />
                <Add Vector = " DCut2;  WE;  WE" />
            </Vertices>

            <Faces>
                <Face VertexIndexes = "1;0;4;5" />
                <Face VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed   " VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                <Face VertexIndexes = "0;2;6;4" />
                <Face VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WE; -DCut2; -WE" />
                <Add Vector = "-WE; -DCut2;  WE" />
                <Add Vector = "-WE;  DCut2; -WE" />
                <Add Vector = "-WE;  DCut2;  WE" />
                <Add Vector = " WE; -DCut2; -WE" />
                <Add Vector = " WE; -DCut2;  WE" />
                <Add Vector = " WE;  DCut2; -WE" />
                <Add Vector = " WE;  DCut2;  WE" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue  " VertexIndexes = "1;0;4;5" />
                <Face Color = "clGreen " VertexIndexes = "2;3;7;6" />
                <Face VertexIndexes = "0;1;3;2" />
                <Face VertexIndexes = "5;4;6;7" />
                <Face VertexIndexes = "0;2;6;4" />
                <Face VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Part>
            <Vertices>
                <Add Vector = "-WE;-WE;-DCut2" />
                <Add Vector = "-WE;-WE; DCut2" />
                <Add Vector = "-WE; WE;-DCut2" />
                <Add Vector = "-WE; WE; DCut2" />
                <Add Vector = " WE;-WE;-DCut2" />
                <Add Vector = " WE;-WE; DCut2" />
                <Add Vector = " WE; WE;-DCut2" />
                <Add Vector = " WE; WE; DCut2" />
            </Vertices>

            <Faces>
                <Face VertexIndexes = "1;0;4;5" />
                <Face VertexIndexes = "2;3;7;6" />
                <Face VertexIndexes = "0;1;3;2" />
                <Face VertexIndexes = "5;4;6;7" />
                <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite " VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <Split> <Plane NormVector = " 1; 0; 0" NormDistance = "DCut1" /> </Split>
        <Split> <Plane NormVector = "-1; 0; 0" NormDistance = "DCut1" /> </Split>
        <Split> <Plane NormVector = " 0; 1; 0" NormDistance = "DCut1" /> </Split>
        <Split> <Plane NormVector = " 0;-1; 0" NormDistance = "DCut1" /> </Split>
        <Split> <Plane NormVector = " 0; 0; 1" NormDistance = "DCut1" /> </Split>
        <Split> <Plane NormVector = " 0; 0;-1" NormDistance = "DCut1" /> </Split>
        <RemoveContaining Vector = " 0; 0; 0" />
</Macro>
        <ExecMacro MacroName = "AddCenters" WE = "D3" DCut1 = "D3" Dcut2 = "W+0.1" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "0" From = "5" />
        <Split Axis = "1" From = "5" />
        <Split Axis = "2" From = "5" />

        <ExecMacro MacroName = "RemoveCenters" f = "0.6" Id = "0" Repeat = "6" />

        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "3" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "4" />


        <Hide Axis = "0" From = "2" To = "4" />
        <Hide Axis = "1" From = "2" To = "4" />
        <Hide Axis = "2" From = "2" To = "4" />

        <Macro Name = "Cut3" >
            <Cut Color = "Colors[Id]"> <Plane NormVector = "-Cx[Id]; -Cy[Id]; -Cz[Id]" NormDistance = "-W+D3/3" /> </Cut>
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "Cut3" Id = "0" Repeat = "6" />

        <InvertVisibility/>
        <Hide Axis = "0" From = "3" To = "3" />
        <Hide Axis = "1" From = "3" To = "3" />
        <Hide Axis = "2" From = "3" To = "3" />
        <InvertVisibility/>
        <ExecMacro MacroName = "HideEdges" f = "0.5" Id = "0" Repeat = "12" />
        <ExecMacro MacroName = "Cut3" Id = "0" Repeat = "6" />
        <ShowAll/>
        <ExecMacro MacroName = "Cut2" Id = "0" Repeat = "6" />
        <ExecMacro MacroName = "AddCenters" WE = "D2" DCut1 = "D3" Dcut2 = "W+0.1" />
        <SplitByAxes/>

        <Hide Axis = "0" From = "3" To = "3" />
        <Hide Axis = "1" From = "3" To = "3" />
        <Hide Axis = "2" From = "3" To = "3" />

        <Macro Name = "Cut3" >
            <Cut Color = "Colors[Id]"> <Plane NormVector = "-Cx[Id]; -Cy[Id]; -Cz[Id]" NormDistance = "-W+D3/3" /> </Cut>
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "Cut" Id = "0" Repeat = "6" />

        <ShowAll/>

        <Macro Name = "HideCenters" >
            <HideContaining Vector = "f*Cx[Id]; f*Cy[Id]; f*Cz[Id]" />
            <Script> Inc(Id); </Script>
        </Macro>
        <ExecMacro MacroName = "HideCenters" f = "0.6" Id = "0" Repeat = "6" />

        <InvertVisibility/>

        <ExecMacro MacroName = "Cut3" Id = "0" Repeat = "6" />
        <ShowAll/>
        <ExecMacro MacroName = "Cut2" Id = "0" Repeat = "6" />

        <ShowAll/>

        <Connect Layers = "0;1;3" />
    </Figure>
</xml>











