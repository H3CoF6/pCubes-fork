    <Script>
        D := 0.789;

        mAngle := ArcTan(0.5);
        As := sin(mAngle);
        Ac := cos(mAngle);
        sAngle := PI * 2 / 5;
        for i := 0 to 4 do begin
            x[i] := -sin(sAngle * i) * Ac;
            y[i] := -As;
            z[i] := -cos(sAngle * i) * Ac;
        end;
        x[5] := 0;
        y[5] := -1;
        z[5] := 0;


        R := 0.7;
        D := R * 0.5;
        D1 := R * 0.5725;
    </Script>

