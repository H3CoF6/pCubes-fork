<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Professor Durer's Solid</Name>
        <Menu>Other forms\Unclassified\Professor Durer's Solid</Menu>
        <Inventor>James William Turner</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-02-17</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=4530</Link>
        <Link>http://dmccooey.com/polyhedra/Durer.html</Link>
    </Interface>

    <Script>
        // Durer's Solid with 3*pi/7 apex angle and 4/7 truncation

        clWhite        := 'F0F0F0';
        clCyan         := '00FFFF';
        clBlue         := '0000FF';
        clRed          := 'FF0000';
        clYellow       := 'FFFF00';
        clOrange       := 'FF6000';
        clGreen        := '008000';
        clPink         := 'FF69B4';

        K  := 0.7;
        C0 := K * 0.205698288537214990965172182329;
        C1 := K * 0.347016074064856157129977942028;
        C2 := C0 * sqrt(3);
        C3 := C0 * 7 / 4;
        C4 := 2 * C0;
        C5 := C3 * sqrt(3);
        C6 := K * 0.644458423263304291812816178052;
        C7 := C3 * 2;

        // C0 = 0.205698288537214990965172182329
        // C1 = 0.347016074064856157129977942028
        // C2 = 0.356279886776419160300002790860
        // C3 = 0.359972004940126234189051319076
        // C4 = 0.411396577074429981930344364658
        // C5 = 0.623489801858733530525004884004
        // C6 = 0.644458423263304291812816178052
        // C7 = 0.719944009880252468378102638152

        // C0 = square-root of a root of the polynomial:  3176523*(x^3) - 432180*(x^2) + 14112*x - 64
        // C1 = square-root of a root of the polynomial:  1728*(x^3) - 576*(x^2) + 36*x + 1
        // C2 = root of the polynomial:  343*(x^3) + 98*(x^2) - 56*x - 8
        // C3 = square-root of a root of the polynomial:  1728*(x^3) - 720*(x^2) + 72*x - 1
        // C4 = square-root of a root of the polynomial:  3176523*(x^3) - 1728720*(x^2) + 225792*x - 4096
        // C5 = root of the polynomial:  8*(x^3) + 4*(x^2) - 4*x - 1
        // C6 = square-root of a root of the polynomial:  203297472*(x^3) - 233722944*(x^2) + 50381604*x + 4826809
        // C7 = square-root of a root of the polynomial:  27*(x^3) - 45*(x^2) + 18*x - 1

        pA2 := C1;
        pA3 := C3 / 2;
        pB1 := C1 * sqrt(3) / 2;
        pB2 := C1 / 2;

        A1 := ArcCos((C3^2 - 2 * C1^2) / (2 * c3^2 + 2 * C1^2));

        D1 := (pA2 * (C0 - C4*2) / 3 + pA3 * C6) / sqrt(pA2^2 + pA3^2);
        D2 := (pA2 * (C0*2 - C4) / 3 + pA3 * C6) / sqrt(pA2^2 + pA3^2);
    </Script>

    <Axes TurningAngles = "2*Pi" AvailableAngles = "-A1; 0; A1" PlaneDistances = "-D2;-D1;D1;D2" TurnAxesWithLayer = "2" >
        <Axis NormVector = "   0; pA2; pA3" />
        <Axis NormVector = "-pB1;-pB2; pA3" />
        <Axis NormVector = " pB1;-pB2; pA3" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  C7; -C1" />
                <Add Vector = "  0; -C7;  C1" />
                <Add Vector = " C5;  C3;  C1" />
                <Add Vector = " C5; -C3; -C1" />
                <Add Vector = "-C5;  C3;  C1" />
                <Add Vector = "-C5; -C3; -C1" />
                <Add Vector = "-C2;  C0;  C6" />
                <Add Vector = " C2; -C0; -C6" />
                <Add Vector = " C2;  C0;  C6" />
                <Add Vector = "-C2; -C0; -C6" />
                <Add Vector = "  0; -C4;  C6" />
                <Add Vector = "  0;  C4; -C6" />
            </Vertices>

            <Faces>
                <Face Color = "clRed   " VertexIndexes = " 0; 11;  9;  5;  4" />
                <Face Color = "clGreen " VertexIndexes = " 1; 10;  6;  4;  5" />
                <Face Color = "clBlue  " VertexIndexes = " 2;  8; 10;  1;  3" />
                <Face Color = "clOrange" VertexIndexes = " 3;  7; 11;  0;  2" />
                <Face Color = "clPink  " VertexIndexes = " 4;  6;  8;  2;  0" />
                <Face Color = "clCyan  " VertexIndexes = " 5;  9;  7;  3;  1" />
                <Face Color = "clYellow" VertexIndexes = " 6; 10;  8" />
                <Face Color = "clWhite " VertexIndexes = " 7;  9; 11" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
