<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mixup 4x4</Name>
        <Menu>Grigr\Mixup 4x4</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2017-12-28</Added>
        <Link></Link>
    </Interface>

Axes 0; 4 must be without jumble

    <Script>
        W := 0.5;
        D := W * 2 * (2 * sqrt(2) - 1) / 7;

        A := ArcTan(sqrt(2) + 0.5);
    </Script>

    <Axes TurningAngles = "Pi/2" JumbleAngle = "A" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn  Axis = "Ax0" Layer = "1" Angle = "A" />
            <Turn  Axis = "Ax0" Layer = "2" Angle = "A" />
            <Split Axis = "Ax1" From  = "2" />
            <Split Axis = "Ax2" From  = "2" />
            <Turn  Axis = "Ax0" Layer = "1" Angle = "-2*A" />
            <Turn  Axis = "Ax0" Layer = "2" Angle = "-2*A" />
            <Split Axis = "Ax1" From  = "2" />
            <Split Axis = "Ax2" From  = "2" />
            <Turn  Axis = "Ax0" Layer = "1" Angle = "A" />
            <Turn  Axis = "Ax0" Layer = "2" Angle = "A" />
        </Macro>

        <ExecMacro MacroName = "SplitPart" Ax0 = "0" Ax1 = "1" Ax2 = "2" />
        <ExecMacro MacroName = "SplitPart" Ax0 = "1" Ax1 = "0" Ax2 = "2" />
        <ExecMacro MacroName = "SplitPart" Ax0 = "2" Ax1 = "1" Ax2 = "0" />

        <RemoveGrayParts/>
    </Figure>
</xml>
