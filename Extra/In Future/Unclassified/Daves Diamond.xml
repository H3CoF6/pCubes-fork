<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

Like a BigChop
Learn Jumbling?

    <Interface>
        <Name>Daves Diamond</Name>
        <Class>TBigChop</Class>
        <Menu>Test\Daves Diamond</Menu>
        <Menu>Other forms\Daves Diamond</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>Skallos</Programmer>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
      
        A := 0.5;
        B := (1 + sqrt(3)) / 2;
        C := (1 - sqrt(3)) / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = "A;B;C" />
        <Axis NormVector = "A;C;B" />
        <Axis NormVector = "B;A;C" />
        <Axis NormVector = "B;C;A" />
        <Axis NormVector = "C;A;B" />
        <Axis NormVector = "C;B;A" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "-W;-W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W; W; W" />
            </Vertices>

            <Faces>
                <Face Color = "clBlue " VertexIndexes = "1;0;4;5" />
                <Face Color = "clBlue " VertexIndexes = "2;3;7;6" />
                <Face Color = "clRed  " VertexIndexes = "0;1;3;2" />
                <Face Color = "clRed  " VertexIndexes = "5;4;6;7" />
                <Face Color = "clWhite" VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite" VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Cut Color = "clOrange" > <Plane NormVector = " 2; 2;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clOrange" > <Plane NormVector = "-2;-2; 1" NormDistance = "-W" /> </Cut>
        <Cut Color = " clGreen" > <Plane NormVector = " 2;-1; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = " clGreen" > <Plane NormVector = "-2; 1;-2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = "-1; 2; 2" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 1;-2;-2" NormDistance = "-W" /> </Cut>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
