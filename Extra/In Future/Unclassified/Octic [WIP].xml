<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Octic</Name>
        <Menu>Other forms\Unclassified\Octic</Menu>
        <Inventor>Hung Nguyễn</Inventor>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5057</Link>
    </Interface>
	
	<Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
		include 'Figures\Scripts\Colors.inc';
		R := W * 7 * sqrt(3) / 9;
		P := R * 2 / sqrt(3);
		
		Color[0] := clWhite;
		Color[1] := clYellow;
		Color[2] := clGreen;
        Color[3] := clBlue;
        Color[4] := clRed;
        Color[5] := clOrange;
    </Script>
 
    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>
 
    <Figure>
        <Part>
			<Vertices>
				<Add Vector = "Vx[0]; Vy[0]; Vz[0]" />
				<Add Vector = "Vx[1]; Vy[1]; Vz[1]" />
				<Add Vector = "Vx[2]; Vy[2]; Vz[2]" />
				<Add Vector = "Vx[3]; Vy[3]; Vz[3]" />
				<Add Vector = "Vx[4]; Vy[4]; Vz[4]" />
				<Add Vector = "Vx[5]; Vy[5]; Vz[5]" />
				<Add Vector = "Vx[6]; Vy[6]; Vz[6]" />
				<Add Vector = "Vx[7]; Vy[7]; Vz[7]" />
			</Vertices>

			<Faces>
				<Face VertexIndexes = "0;1;3;2" />
				<Face VertexIndexes = "5;4;6;7" />
				<Face VertexIndexes = "1;0;4;5" />
				<Face VertexIndexes = "2;3;7;6" />
				<Face VertexIndexes = "0;2;6;4" />
				<Face VertexIndexes = "3;1;5;7" />
			</Faces>
		</Part>
		
		<Macro Name = "CutCorners">
            <Cut> <Plane NormVector = "-Vx[i];-Vy[i];-Vz[i]" NormDistance = "-R+0.0005" /> </Cut>
            <Script>Inc(i);</Script>
        </Macro>
        <ExecMacro MacroName = "CutCorners" i = "0" Repeat = "8" />
		
		<Macro Name = "AddCenter">
			<Part>
				<Vertices>
					<Add Vector = "P * Vx[v]; P * Vy[v]; P * Vz[v]" />
					<Add Vector = "(2 * Vx[v] + Vx[v1]) / 3; (2 * Vy[v] + Vy[v1]) / 3; (2 * Vz[v] + Vz[v1]) / 3" />
					<Add Vector = "(2 * Vx[v] + Vx[v2]) / 3; (2 * Vy[v] + Vy[v2]) / 3; (2 * Vz[v] + Vz[v2]) / 3" />
					<Add Vector = "(2 * Vx[v] + Vx[v3]) / 3; (2 * Vy[v] + Vy[v3]) / 3; (2 * Vz[v] + Vz[v3]) / 3" />
				</Vertices>

				<Faces>
					<Face Color = "Color[a]" VertexIndexes = " 0; 3; 1" InvisibleEdges = "5" />
					<Face Color = "Color[b]" VertexIndexes = " 0; 1; 2" InvisibleEdges = "5" />
					<Face Color = "Color[c]" VertexIndexes = " 0; 2; 3" InvisibleEdges = "5" />
				</Faces>
			</Part>
		</Macro>
		<ExecMacro MacroName = "AddCenter" v = "0" v1 = "1" v2 = "2" v3 = "4" a = "3" b = "4" c = "1"/>
		<ExecMacro MacroName = "AddCenter" v = "1" v1 = "3" v2 = "0" v3 = "5" a = "0" b = "4" c = "3"/>
		<ExecMacro MacroName = "AddCenter" v = "2" v1 = "0" v2 = "3" v3 = "6" a = "1" b = "4" c = "2"/>
		<ExecMacro MacroName = "AddCenter" v = "3" v1 = "2" v2 = "1" v3 = "7" a = "2" b = "4" c = "0"/>
		<ExecMacro MacroName = "AddCenter" v = "4" v1 = "0" v2 = "6" v3 = "5" a = "3" b = "1" c = "5"/>
		<ExecMacro MacroName = "AddCenter" v = "5" v1 = "7" v2 = "1" v3 = "4" a = "5" b = "0" c = "3"/>
		<ExecMacro MacroName = "AddCenter" v = "6" v1 = "4" v2 = "2" v3 = "7" a = "5" b = "1" c = "2"/>
		<ExecMacro MacroName = "AddCenter" v = "7" v1 = "3" v2 = "5" v3 = "6" a = "2" b = "0" c = "5"/>
		
		
        <SplitByAxes/>
    </Figure>
</xml>
