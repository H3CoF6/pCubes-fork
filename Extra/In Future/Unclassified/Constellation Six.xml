    <Script>
        clYellow       := 'FFFF00';        clLightViolett := 'FF0080';
        clBlue         := '0000A0';        clLightBlue    := '2828FF';
        clOrange       := 'FF6000';        clViolett      := '800080';
        clRed          := 'FF0000';        clBrown        := '800000';
        clGreen        := '008000';        clLightGreen   := '00FF00';
        clWhite        := 'FFFFFF';        clCyan         := '00DCB4';

    p0 :=0.5;
    pA :=0.5773502692;
    pB :=0.2886751346;
    pC :=0.3333333333;
    </Script>

    <Axes TurningAngles = "Pi/2"  PlaneDistances = "0" FixedLayers = "0" >        
    <Axis NormVector = "  0; pA;  0" />
        <Axis NormVector = " p0;-pB;  0" />
        <Axis NormVector = "-p0;-pB;  0" />
    </Axes>

    <Figure>
    <Part>
        <Vertices>
            <Add Vector = "  0;  pA;   0" /> 0
        <Add Vector = " p0; -pB;   0" /> 1
        <Add Vector = "-p0; -pB;   0" /> 2

            <Add Vector = "  0;   0;  pC" /> 3
            <Add Vector = "  0;   0; -pC" /> 4
        </Vertices>

        <Faces>
        <Face Color = "clOrange" VertexIndexes = "0;3;1" />
                <Face Color = "clYellow" VertexIndexes = "1;3;2" />
                <Face Color = "clRed   " VertexIndexes = "2;3;0" />

                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue  " VertexIndexes = "2;0;4" />
        </Faces>
    </Part>
    <SplitByAxes/>

    <Turn Axis = "0" Angle = "Pi/2" From = "1" To = "1" />
    <SplitByAxes/>
    <Turn Axis = "0" Angle = "-Pi/2" From = "1" To = "1" />

    <Turn Axis = "1" Angle = "Pi/2" From = "1" To = "1" />
    <SplitByAxes/>
    <Turn Axis = "1" Angle = "-Pi/2" From = "1" To = "1" />

    <Turn Axis = "2" Angle = "Pi/2" From = "1" To = "1" />
    <SplitByAxes/>
