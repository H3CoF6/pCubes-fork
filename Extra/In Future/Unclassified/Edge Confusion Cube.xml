<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Edge Confusion Cube</Name>
        <Menu>Edge Confusion Cube</Menu>
        <Inventor>Evgeniy Grigoriev</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2019-05-18</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7416</Link>
    </Interface>

    <Script>
        W := 0.5;

        D1 := W * 0.3;
        D2 := W * 0.5;

    </Script>

    <Axes TurningAngles = "Pi/2" PlaneDistances = "-D1;-D2;D2;D1" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <Script>W := 0.55;</Script>
        <LoadFrom File = "Figures\Cube.xml" />
        <Script>
            W := 0.5;
            include 'Figures\Scripts\Cube_Coordinates.inc';
        </Script>

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "3" />

        <HideContaining Vector = "Cx[0];Cy[0];Cz[0]" />
        <HideContaining Vector = "Cx[1];Cy[1];Cz[1]" />
        <HideContaining Vector = "Cx[2];Cy[2];Cz[2]" />
        <HideContaining Vector = "Cx[3];Cy[3];Cz[3]" />
        <HideContaining Vector = "Cx[4];Cy[4];Cz[4]" />
        <HideContaining Vector = "Cx[5];Cy[5];Cz[5]" />

        <HideContaining Vector = "Vx[5];Vy[5];Vz[5]" />

        <SplitByAxes />

        <RemoveGrayParts/>

        <HideContaining Vector = "Vx[0];Vy[0];Vz[0]" />
        <HideContaining Vector = "Vx[1];Vy[1];Vz[1]" />
        <HideContaining Vector = "Vx[2];Vy[2];Vz[2]" />
        <HideContaining Vector = "Vx[3];Vy[3];Vz[3]" />
        <HideContaining Vector = "Vx[4];Vy[4];Vz[4]" />
        <HideContaining Vector = "Vx[6];Vy[6];Vz[6]" />
        <HideContaining Vector = "Vx[7];Vy[7];Vz[7]" />

        <HideContaining Vector = "Ex[ 0];Ey[ 0];Ez[ 0]" />
        <HideContaining Vector = "Ex[ 1];Ey[ 1];Ez[ 1]" />
        <HideContaining Vector = "Ex[ 2];Ey[ 2];Ez[ 2]" />
        <HideContaining Vector = "Ex[ 3];Ey[ 3];Ez[ 3]" />
        <HideContaining Vector = "Ex[ 4];Ey[ 4];Ez[ 4]" />
        <HideContaining Vector = "Ex[ 5];Ey[ 5];Ez[ 5]" />
        <HideContaining Vector = "Ex[ 6];Ey[ 6];Ez[ 6]" />
        <HideContaining Vector = "Ex[ 7];Ey[ 7];Ez[ 7]" />
        <HideContaining Vector = "Ex[ 8];Ey[ 8];Ez[ 8]" />
        <HideContaining Vector = "Ex[ 9];Ey[ 9];Ez[ 9]" />
        <HideContaining Vector = "Ex[10];Ey[10];Ez[10]" />
        <HideContaining Vector = "Ex[11];Ey[11];Ez[11]" />

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <Cut> <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut> <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

        <Cut Color = "clOrange" > <Plane NormVector = "-1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clRed   " > <Plane NormVector = " 1; 0; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clGreen " > <Plane NormVector = " 0;-1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clBlue  " > <Plane NormVector = " 0; 1; 0" NormDistance = "-W" /> </Cut>
        <Cut Color = "clWhite " > <Plane NormVector = " 0; 0;-1" NormDistance = "-W" /> </Cut>
        <Cut Color = "clYellow" > <Plane NormVector = " 0; 0; 1" NormDistance = "-W" /> </Cut>

        <ShowAll/>

    </Figure>
</xml>
