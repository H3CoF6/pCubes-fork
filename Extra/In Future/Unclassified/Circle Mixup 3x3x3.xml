<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

Permanenly blocked


    <Interface>
        <Name>Circle Mixup 3x3x3</Name>
        <Menu>Other cubes\Mixup\Circle Mixup 3x3x3</Menu>
        <Menu>Skallos\Circle Mixup 3x3x3</Menu>
        <Inventor></Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-06-10</Added>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        Delta := 0.02;
        R := 0.4;
        D := 0.5 + Delta;

        D1 := 0.5;
        D2 := D1 / (1 + sqrt(2));
    </Script>

    <Axes TurningAngles = "0; Pi/2; Pi/4; Pi/4; Pi/2; 0" PlaneDistances = "-D1; -D2; 0; D2; D1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Circle Radius = "R" Color = "clBlue"   > <Center X =  "0" Y = "-D" Z =  "0" /> </Circle>
        <Circle Radius = "R" Color = "clOrange" > <Center X =  "D" Y =  "0" Z =  "0" /> </Circle>
        <Circle Radius = "R" Color = "clRed"    > <Center X = "-D" Y =  "0" Z =  "0" /> </Circle>
        <Circle Radius = "R" Color = "clGreen"  > <Center X =  "0" Y =  "D" Z =  "0" /> </Circle>
        <Circle Radius = "R" Color = "clWhite"  > <Center X =  "0" Y =  "0" Z =  "D" /> </Circle>
        <Circle Radius = "R" Color = "clYellow" > <Center X =  "0" Y =  "0" Z = "-D" /> </Circle>-->

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />

        <Turn Axis = "0" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />

        <Turn Axis = "1" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "2" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "2" />



        <Turn Axis = "1" Angle = "Pi / 2" From = "1" To = "4" />



        <Turn Axis = "0" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />

        <Turn Axis = "1" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "2" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "2" />



        <Turn Axis = "1" Angle = "-Pi / 2" From = "1" To = "4" />
        <Turn Axis = "2" Angle = "Pi / 2" From = "1" To = "4" />



        <Turn Axis = "0" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />

        <Turn Axis = "1" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "4" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Turn Axis = "1" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "2" Angle = "Pi / 4" Layer = "2" />
        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "4" />
        <Turn Axis = "2" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "0" Angle = "-Pi / 4" Layer = "2" />

        <Turn Axis = "2" Angle = "-Pi / 2" From = "1" To = "4" />

        <RemoveGrayParts/>

<!-- cutting circles -->

        <Hide Axis = "0" From = "1" To = "4" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "1" Layer = "4" />
        <Hide Axis = "2" From = "1" To = "3" />
        <Cut> <Plane NormVector = "0; 0; 1" NormDistance = "D2 + Delta" /> </Cut>
        <ShowAll/>

        <Turn Axis = "2" Angle = "Pi / 2" Layer = "4" />
        <Hide Axis = "0" From = "1" To = "4" />
        <Hide Axis = "1" Layer = "1" />
        <Hide Axis = "1" Layer = "4" />
        <Hide Axis = "2" From = "1" To = "3" />
        <Cut> <Plane NormVector = "0; 0; 1" NormDistance = "D2 + Delta" /> </Cut>
        <ShowAll/>
        <Turn Axis = "2" Angle = "-Pi / 2" Layer = "4" />

    </Figure>
</xml>
