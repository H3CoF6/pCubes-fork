<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Flat Pyramid HeptaQuad</Name>
        <Menu>Other forms\Pyramid\Biaxes Virtual\Flat Pyramid HeptaQuad</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-02-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clYellow  := 'FFFF00';
        clGreen   := '008000';
        clBlue    := '0000FF';
        clOrange  := 'FF6000';
        clFuchsia := 'FF00FF';
        clBlack1  := '010101';
        clBlack2  := '010102';

        K := 0.5;

        pX := K * 3.01489262;
        pY := K * 1.24723170;
        pZ := K * 1.05357302;

        AngleD := 143.3;

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2;
        x := cos(AngleM);
        y := sin(AngleM);

        A := Pi/2;

        D := 0;   // 1 middle point
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "-D" FixedLayers = "0" >
        <Axis NormVector = " x; -y; 0" />
        <Axis NormVector = "-x; -y; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " Px; -K;   0" />
                <Add Vector = "-Px; -K;   0" />
                <Add Vector = "  0;  0;  Pz" />
                <Add Vector = "  0;  0; -Pz" />
                <Add Vector = "  0; Py;   0" />
            </Vertices>

            <Faces>
                <Face Color = "clRed    " VertexIndexes = "2;1;0" />
                <Face Color = "clYellow " VertexIndexes = "0;1;3" />
                <Face Color = "clGreen  " VertexIndexes = "2;0;4" />
                <Face Color = "clBlue   " VertexIndexes = "1;2;4" />
                <Face Color = "clOrange " VertexIndexes = "0;3;4" />
                <Face Color = "clFuchsia" VertexIndexes = "1;4;3" />
            </Faces>
        </Part>

        <Cut Color = "clBlack1" ><Plane NormVector = "-Px; K; 0" NormDistance = "-K * 0.63" /></Cut>
        <Cut Color = "clBlack2" ><Plane NormVector = " Px; K; 0" NormDistance = "-K * 0.63" /></Cut>
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Dt = " 1" Repeat = "5" />
        <Undo Repeat = "200" />
        <ExecMacro MacroName = "SplitPart" Dt = "-1" Repeat = "5" />
        <Undo Repeat = "200" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
