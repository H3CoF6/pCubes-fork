<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Flat Pyramid OctaPent</Name>
        <Menu>Other forms\Pyramid\Biaxes Virtual\Flat Pyramid OctaPent</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-02-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        clRed     := 'FF0000';
        clYellow  := 'FFFF00';
        clGreen   := '008000';
        clBlue    := '0000FF';
        clOrange  := 'FF6000';
        clFuchsia := 'FF00FF';
        clOlive   := '808000';
        clNavy    := '000080';
        clBlack1  := '010101';
        clBlack2  := '010102';

        K := 0.5;

        pX := K * 1.16672002;
        pY := K * 0.43685723;
        pZ := K * 1.02084659;
        pY2:= K * 3.45928170;
        pZ2:= K * 1.90828817;

        AngleD := 98.80;

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2;
        x := cos(AngleM);
        y := sin(AngleM);

        A := 2*Pi/5;

        D := K * 0.2842;   // 1 middle point
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " x; -y; 0" />
        <Axis NormVector = "-x; -y; 0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " Px;  -K;    0" />
                <Add Vector = "-Px;  -K;    0" />
                <Add Vector = "  0; -Py;   Pz" />
                <Add Vector = "  0; -Py;  -Pz" />
                <Add Vector = "  0; Py2;  Pz2" />
                <Add Vector = "  0; Py2; -Pz2" />
            </Vertices>

            <Faces>
                <Face Color = "clRed    " VertexIndexes = "2;1;0" />
                <Face Color = "clYellow " VertexIndexes = "0;1;3" />
                <Face Color = "clGreen  " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue   " VertexIndexes = "0;4;2" />
                <Face Color = "clOrange " VertexIndexes = "1;5;3" />
                <Face Color = "clFuchsia" VertexIndexes = "0;3;5" />
                <Face Color = "clOlive  " VertexIndexes = "1;4;5" />
                <Face Color = "clNavy   " VertexIndexes = "0;5;4" />
            </Faces>
        </Part>

        <Cut Color = "clBlack1" ><Plane NormVector = "0;-1; 0" NormDistance = "-K * 0.475" /></Cut>
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Repeat = "4" />
        <Undo Repeat = "100" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
