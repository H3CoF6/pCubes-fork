<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sphere Traoctrix 1</Name>
        <Menu>Other forms\Sphere\Biaxes Virtual\Sphere Traoctrix 1</Menu>
        <Inventor>not invented</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-02-26</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=1&amp;t=32731</Link>
    </Interface>

    <Script>
        K := 0.7;

        AngleD := 127.5516; // Bram      // Arccos(-2 / 3 * (1 + sqrt(2)) + 1)

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2;
        x := cos(AngleM);
        y := sin(AngleM);

        A := Pi*2/3;

        D := K * 0.120;      // 1 narrow parts
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "-D" FixedLayers = "0" >
        <Axis NormVector = " x; -y; 0" />
        <Axis NormVector = "-x; -y; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Dt=" 1" Repeat = "10" />
        <Undo Repeat = "400" />
        <ExecMacro MacroName = "SplitPart" Dt="-1" Repeat = "10" />
        <Undo Repeat = "400" />

        <Turn Axis = "0" Angle = " A" Layer = "1" /> <SplitByAxes/>
        <Turn Axis = "1" Angle = "-A" Layer = "1" /> <SplitByAxes/>

        <ExecMacro MacroName = "SplitPart" Dt="-1" Repeat = "10" />
        <Undo Repeat = "400" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
