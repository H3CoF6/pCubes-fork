    <Script>
        K := 0.7;

        AngleD := 116.56505118;

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2;
        x := cos(AngleM);
        y := sin(AngleM);

        A := 2*Pi/5;

        D := K * 0.10;
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " x; -y; 0" />
        <Axis NormVector = "-x; -y; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Dt = " 1" Repeat = "4" />
        <Undo Repeat = "200" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
