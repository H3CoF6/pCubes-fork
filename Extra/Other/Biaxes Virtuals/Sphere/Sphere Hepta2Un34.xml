    <Script>
        K := 0.7;

        AngleD := 116.14;

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2;
        x := sin(2*AngleM);
        y := cos(2*AngleM);

        A1 := Pi*2/3;
        A2 := Pi/2;

        D := 0;    // normal
    </Script>

    <Axes TurningAngles = "A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " x; y; 0" />
    </Axes>
    <Axes TurningAngles = "A2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Repeat = "4" />
        <Undo Repeat = "200" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
