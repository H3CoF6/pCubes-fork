<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sphere OctaQuad</Name>
        <Menu>Other forms\Sphere\Biaxes Virtual\Sphere OctaQuad</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-01-27</Added>
        <Link></Link>
    </Interface>

    <Script>
        K := 0.7;

        AngleD := 114.48;

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2;
        x := cos(AngleM);
        y := sin(AngleM);

        A := Pi/2;

        D := 0;  // 1 middle point
    </Script>

    <Axes TurningAngles = "A" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " x; -y; 0" />
        <Axis NormVector = "-x; -y; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " Dt*A" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-Dt*A" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        <ExecMacro MacroName = "SplitPart" Dt = " 1" Repeat = "5" />
        <Undo Repeat = "200" />
        <ExecMacro MacroName = "SplitPart" Dt = "-1" Repeat = "5" />
        <Undo Repeat = "200" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
