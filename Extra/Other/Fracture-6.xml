<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Fracture-6</Name>
        <Menu>Grigr\Fracture-6</Menu>
        <Inventor>David Pitcher</Inventor>
    <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2016-11-30</Added>
        <Link>http://twistypuzzles.com/forum/viewtopic.php?f=15&amp;t=23436</Link>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clBlue         := '0000A0';
        clOrange       := 'FF6000';
        clRed          := 'FF0000';
        clGreen        := '008000';
        clWhite        := 'FFFFFF';
        clLightViolett := 'FF0080';
        clLightBlue    := '2828FF';
        clViolett      := '800080';
        clBrown        := '800000';
        clLightGreen   := '00FF00';
        clCyan         := '00DCB4';

        p0 := 0.5;
        pA := 0.5773502692;
        pB := 0.2886751346;
        pC := 0.3333333333;
    </Script>

    <Axes TurningAngles = "Pi/2"  PlaneDistances = "0" FixedLayer="0">
        <Axis NormVector = "  0; pA;  0" />
        <Axis NormVector = " p0;-pB;  0" />
        <Axis NormVector = "-p0;-pB;  0" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "  0;  pA;   0" />
                <Add Vector = " p0; -pB;   0" />
                <Add Vector = "-p0; -pB;   0" />

                <Add Vector = "  0;   0;  pC" />
                <Add Vector = "  0;   0; -pC" />
            </Vertices>

            <Faces>
                <Face Color = "clOrange" VertexIndexes = "0;3;1" />
                <Face Color = "clYellow" VertexIndexes = "1;3;2" />
                <Face Color = "clRed   " VertexIndexes = "2;3;0" />

                <Face Color = "clViolett" VertexIndexes = "0;1;4" />
                <Face Color = "clGreen " VertexIndexes = "1;2;4" />
                <Face Color = "clBlue  " VertexIndexes = "2;0;4" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <Hide Axis = "0" From = "1" To = "1" />
        <Turn Axis = "1" Angle = "-Pi/2" From = "1" To = "1"/>
        <SplitByAxes/>
        <ShowAll/>
        <Turn Axis = "1" Angle = "Pi/2" From = "1" To = "1"/>

        <Hide Axis = "1" From = "1" To = "1" />
        <Turn Axis = "2" Angle = "-Pi/2" From = "1" To = "1"/>
        <SplitByAxes/>
        <ShowAll/>
        <Turn Axis = "2" Angle = "Pi/2" From = "1" To = "1"/>

        <Hide Axis = "2" From = "1" To = "1" />
        <Turn Axis = "0" Angle = "-Pi/2" From = "1" To = "1"/>
        <SplitByAxes/>
        <ShowAll/>
        <Turn Axis = "0" Angle = "Pi/2" From = "1" To = "1"/>

    </Figure>
</xml>
