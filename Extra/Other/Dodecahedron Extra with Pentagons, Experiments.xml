    <Figure>
        <LoadFrom File = "Figures\Dodecahedron.xml" />

        <Macro Name = "CalcInit1" >
            <Script>
                TP := sqrt(5) * D1; // top of pyramide
                DK1 := TP / RSin;

                KSide1 := D1 / RSin / (1 - As); // base pentagon on the 0-plane
                KH1 := (TP - H1) / TP; // resulting pentagon
                KH2 := (TP - H2) / TP;
            </Script>
        </Macro>

        <Macro Name = "CalcInit12" >
            <ExecMacro MacroName = "CalcInit1" />
            <Script>
                DK2 := sqrt(5) * D2 / RSin;
                KSide2 := D2 / RSin / (1 - As); // base pentagon on the 0-plane
                KS2 := KSide2 / KSide1;
            </Script>
        </Macro>

        <Macro Name = "CalcCoordinatesOfPyramide1" >
            <Script>
                TopX := Cx[C] * DK1;
                TopY := Cy[C] * DK1;
                TopZ := Cz[C] * DK1;

                for i := 0 to 4 do begin
                    Vii := Vi[C,i];
                    XS := TopX - (Vx[Vii] - Cx[C]) * KSide1;
                    YS := TopY - (Vy[Vii] - Cy[C]) * KSide1;
                    ZS := TopZ - (Vz[Vii] - Cz[C]) * KSide1;
                    XB[i] := TopX - XS * KH1;
                    YB[i] := TopY - YS * KH1;
                    ZB[i] := TopZ - ZS * KH1;
                    XB[i + 5] := TopX - XS * KH2;
                    YB[i + 5] := TopY - YS * KH2;
                    ZB[i + 5] := TopZ - ZS * KH2;
                end;
                // opposite
                for i := 0 to 9 do begin
                    XB1[i] := -XB[i];
                    YB1[i] := -YB[i];
                    ZB1[i] := -ZB[i];
                end;
                C1 := Co[C];
            </Script>
        </Macro>

        <Macro Name = "CalcCoordinatesOfPyramide2" >
            <Script>
                Top1X := Cx[C] * DK1;
                Top1Y := Cy[C] * DK1;
                Top1Z := Cz[C] * DK1;
                Top2X := Cx[C] * DK2;
                Top2Y := Cy[C] * DK2;
                Top2Z := Cz[C] * DK2;

                for i := 0 to 4 do begin
                    XS1 := (Vx[Vi[C,i]] - Cx[C]) * KSide1;
                    YS1 := (Vy[Vi[C,i]] - Cy[C]) * KSide1;
                    ZS1 := (Vz[Vi[C,i]] - Cz[C]) * KSide1;
                    XB1[i] := Top1X - (Top1X - XS1) * KH1;
                    YB1[i] := Top1Y - (Top1Y - YS1) * KH1;
                    ZB1[i] := Top1Z - (Top1Z - ZS1) * KH1;
                    XB1[i + 5] := Top1X - (Top1X - XS1) * KH2;
                    YB1[i + 5] := Top1Y - (Top1Y - YS1) * KH2;
                    ZB1[i + 5] := Top1Z - (Top1Z - ZS1) * KH2;
                end;
            </Script>
        </Macro>

