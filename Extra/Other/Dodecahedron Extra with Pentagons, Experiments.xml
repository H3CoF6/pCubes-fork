        <Macro Name = "CalcCoordinatesTwoLayers" >
            <ExecMacro MacroName = "CalcCoordinates" D = "D1" />

            <Script>
                for i := 0 to 9 do begin
                    x1[i] := XB[i];
                    y1[i] := YB[i];
                    z1[i] := ZB[i];
                end;
//ShowMessage(y1[i]);
            </Script>


            <ExecMacro MacroName = "CalcCoordinates" D = "D2" />
            <Script>
                for i := 0 to 9 do begin
                    x3[i] := XB[i];
                    y3[i] := YB[i];
                    z3[i] := ZB[i];
                end;
//ShowMessage(y3[i]);

//                if c = 11 then begin
                    if abs(x3[1] - x1[1]) > abs(y3[1] - y1[1]) then begin
                        K3 := (x3[1] - x1[1]) / (x1[2] - x1[1] + x1[0] - x1[1]);
                        K4 := (x3[6] - x1[6]) / (x1[7] - x1[6] + x1[5] - x1[6]);
                    end else begin
                        K3 := (y3[1] - y1[1]) / (y1[2] - y1[1] + y1[0] - y1[1]);
                        K4 := (y3[6] - y1[6]) / (y1[7] - y1[6] + y1[5] - y1[6]);
                    end;
//                end;

//ShowMessage(K4);
                for i := 0 to 4 do begin
                    x2[i] := x1[i] + (x1[(i + 1) mod 5] - x1[i]) * K3;
                    y2[i] := y1[i] + (y1[(i + 1) mod 5] - y1[i]) * K3;
                    z2[i] := z1[i] + (z1[(i + 1) mod 5] - z1[i]) * K3;
                    x4[i] := x1[i] + (x1[(i + 4) mod 5] - x1[i]) * K3;
                    y4[i] := y1[i] + (y1[(i + 4) mod 5] - y1[i]) * K3;
                    z4[i] := z1[i] + (z1[(i + 4) mod 5] - z1[i]) * K3;

                    x2[i + 5] := x1[i + 5] + (x1[(i + 1) mod 5 + 5] - x1[i + 5]) * K4;
                    y2[i + 5] := y1[i + 5] + (y1[(i + 1) mod 5 + 5] - y1[i + 5]) * K4;
                    z2[i + 5] := z1[i + 5] + (z1[(i + 1) mod 5 + 5] - z1[i + 5]) * K4;
                    x4[i + 5] := x1[i + 5] + (x1[(i + 4) mod 5 + 5] - x1[i + 5]) * K4;
                    y4[i + 5] := y1[i + 5] + (y1[(i + 4) mod 5 + 5] - y1[i + 5]) * K4;
                    z4[i + 5] := z1[i + 5] + (z1[(i + 4) mod 5 + 5] - z1[i + 5]) * K4;
                end;

            </Script>
        </Macro>

