<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Dino Chop Cube (Little Chop + Dino + 2*2)</Name>
        <Class>TLittleChop</Class>
        <Menu>Other cubes\Dino Chop Cube (Little Chop + Dino + 2*2)</Menu>
        <Inventor>Vladimir Yaroslavskiy</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2340</Link>
        <Video>https://www.youtube.com/watch?v=uJJSJcFp77k</Video>
    </Interface>

    <Axes TurningAngles = "Pi / 4" PlaneDistances = "0">
        <Axis NormVector = " 1;  1;  0" />
        <Axis NormVector = " 1; -1;  0" />
        <Axis NormVector = " 0;  1;  1" />
        <Axis NormVector = " 0;  1; -1" />
        <Axis NormVector = " 1;  0;  1" />
        <Axis NormVector = "-1;  0;  1" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "0" >
        <Axis NormVector = " 0;  0;  1" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 1;  0;  0" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "sqrt(3)/6" FixedLayer = "1">
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1; -1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
