    <Script>
        // empiric values
        R := 0.7;
        D := 0.8086 * R; 
        //RCut := (1 + As) / 2 * R; // this value is for real Icosidodecahedron, but for square sides there is another value
        RCut := 0.751 * R;
        D1 := 0.769 * R;
        D2 := 0.709 * R;
        D3 := 0.786 * R;

        Rout := sqrt(3) / 4 * (1 + sqrt(5));
        Rin := 0.5 * sqrt(2.5 + 1.1 * sqrt(5));

        dAngle := Arcsin(Rin / Rout);
        Rsin := sin(dAngle);
        Rcos := cos(dAngle);

        dAngle2 := dAngle - 2 * Arcsin(1 / 2 / Rout);
        R2sin := sin(dAngle2);
        R2cos := cos(dAngle2);

        mAngle := ArcTan(0.5);
        As := sin(mAngle);
        Ac := cos(mAngle);

        sAngle := PI * 2 / 5;

        for i := 0 to 4 do begin
            ax[i] := Rcos * sin(sAngle * (i - 0.5)) * D1;
            ay[i] := Rcos * cos(sAngle * (i - 0.5)) * D1;
            az[i] := Rsin * D1;
        end;
        for i := 5 to 9 do begin
            ax[i] := R2cos * sin(sAngle * (i - 0.5)) * D1;
            ay[i] := R2cos * cos(sAngle * (i - 0.5)) * D1;
            az[i] := R2sin * D1;
        end;

        bx[0] := 0;
        by[0] := 0;
        bz[0] := R;

        for i := 1 to 5 do begin
            bx[i] := R * sin(sAngle * (i - 1)) * Ac;
            by[i] := R * cos(sAngle * (i - 1)) * Ac;
            bz[i] := R * As;
        end;
        for i := 6 to 10 do begin
            bx[i] := R * Ac * sin(sAngle * (i - 0.5));
            by[i] := R * Ac * cos(sAngle * (i - 0.5));
            bz[i] := -R * As;
        end;

        bx[11] := 0;
        by[11] := 0;
        bz[11] := -R;

        for i := 0 to 11 do begin
            dx[i] := bx[i] * D2 / R;
            dy[i] := by[i] * D2 / R;
            dz[i] := bz[i] * D2 / R;
        end;

        for i := 0 to 4 do begin
            x[i] := Rcos * sin(sAngle * (i - 0.5));
            y[i] := Rcos * cos(sAngle * (i - 0.5));
            z[i] := Rsin;
        end;
        for i := 5 to 9 do begin
            x[i] := R2cos * sin(sAngle * (i - 0.5));
            y[i] := R2cos * cos(sAngle * (i - 0.5));
            z[i] := R2sin;
        end;
        for i := 10 to 14 do begin
            x[i] := R2cos * sin(sAngle * i);
            y[i] := R2cos * cos(sAngle * i);
            z[i] := -R2sin;
        end;

        for i := 0 to 4 do begin
          cx[i] := x[i] + x[i + 1];
          cy[i] := y[i] + y[i + 1];
          cz[i] := z[i] + z[i + 1];

          cx[i + 5] := x[i] + x[i + 5];
          cy[i + 5] := y[i] + y[i + 5];
          cz[i + 5] := z[i] + z[i + 5];

          cx[i + 10] := x[i + 5] + x[i + 10];
          cy[i + 10] := y[i + 5] + y[i + 10];
          cz[i + 10] := z[i + 5] + z[i + 10];
        end;

        cx[4] := x[4] + x[0];
        cy[4] := y[4] + y[0];
        cz[4] := z[4] + z[0];
        br := sqrt(cx[0] ^ 2 + cy[0] ^ 2 + cz[0] ^ 2);

        for i := 0 to 14 do begin
          cx[i] := cx[i]  * D3 / br;
          cy[i] := cy[i]  * D3 / br;
          cz[i] := cz[i]  * D3 / br;
        end;
    </Script>

