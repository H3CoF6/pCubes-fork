<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

   <Interface>
      <Name>Void Octagonal Prism</Name>
      <Menu>Other forms\FT Void Puzzles\Void Octagonal Prism</Menu>
   </Interface>

   <Script>
      H := 0.5;
      sAngle := PI * 2 / 8;
      RCut := 0.6;
      F := 0.5;
      S := 0.5;

      for i := 0 to 7 do begin
         x[i] := sin(sAngle * i);
         y[i] := cos(sAngle * i);
      end;
      for i := 0 to 7 do begin
         x1[i] := sin(sAngle * (i + 0.5));
         y1[i] := cos(sAngle * (i + 0.5));
      end;
      E := (RCut + F) / cos(sAngle / 2) / 2 ;
   </Script>

    <Axes TurningAngles = "Pi" PlaneDistances = "F" FixedLayer = "0" >
        <Axis NormVector = " x[0]; y[0]; 0" />
        <Axis NormVector = " x[1]; y[1]; 0" />
        <Axis NormVector = " x[2]; y[2]; 0" />
        <Axis NormVector = " x[3]; y[3]; 0" />
        <Axis NormVector = "-x[0];-y[0]; 0" />
        <Axis NormVector = "-x[1];-y[1]; 0" />
        <Axis NormVector = "-x[2];-y[2]; 0" />
        <Axis NormVector = "-x[3];-y[3]; 0" />
    </Axes>



    <Axes TurningAngles = "Pi * 2 / 8;" PlaneDistances = "0.15" FixedLayer = "0">
        <Axis NormVector = "0; 0; 1" />
        <Axis NormVector = "0; 0;-1" />
    </Axes>

   <Figure>
        <Part>
            <Vertices>
                <Add Vector = "2; -2; 2"/>
                <Add Vector = "-2; 2; 2"/>
                <Add Vector = "2; 2; -2"/>
                <Add Vector = "-2; -2; -2"/>
            </Vertices>
            <Faces>
                <Face VertexIndexes = "0;1;3"/>
                <Face VertexIndexes = "1;2;3"/>
                <Face VertexIndexes = "0;3;2"/>
                <Face VertexIndexes = "0;2;1"/>
            </Faces>
        </Part>

        <Cut Color="FF0000">
            <Plane>
                <NormVector X = "x[0]" Y = "y[0]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="008000">
            <Plane>
                <NormVector X = "x[1]" Y = "y[1]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="700070">
            <Plane>
                <NormVector X = "x[2]" Y = "y[2]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="0050FF">
            <Plane>
                <NormVector X = "x[3]" Y = "y[3]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="FF8000">
            <Plane>
                <NormVector X = "x[4]" Y = "y[4]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color="80FF00">
            <Plane>
                <NormVector X = "x[5]" Y = "y[5]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color = "FF60A0">
            <Plane>
                <NormVector X = "x[6]" Y = "y[6]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>
        <Cut Color = "0000A0">
            <Plane>
                <NormVector X = "x[7]" Y = "y[7]" Z = "0"/>
                <NormDistance> -RCut </NormDistance>
            </Plane>
        </Cut>

        <Cut Color = "FFFF00">
            <Plane>
                <NormVector X = "0" Y = "0" Z = "1"/>
                <NormDistance> -H / 2 </NormDistance>
            </Plane>
        </Cut>
        <Cut Color = "FFFFFF">
            <Plane>
                <NormVector X = "0" Y = "0" Z = "-1"/>
                <NormDistance> -H / 2 </NormDistance>
            </Plane>
        </Cut>

        <SplitByAxes/>

        <RemoveContaining Vector = "   0;   0;   0"/>
        <RemoveContaining Vector = "   0;   0; 0.2"/>
        <RemoveContaining Vector = "   0;   0;-0.2"/>
        <RemoveContaining Vector = " x[0]*S; y[0]*S; 0" />
        <RemoveContaining Vector = " x[1]*S; y[1]*S; 0" />
        <RemoveContaining Vector = " x[2]*S; y[2]*S; 0" />
        <RemoveContaining Vector = " x[3]*S; y[3]*S; 0" />
        <RemoveContaining Vector = "-x[0]*S;-y[0]*S; 0" />
        <RemoveContaining Vector = "-x[1]*S;-y[1]*S; 0" />
        <RemoveContaining Vector = "-x[2]*S;-y[2]*S; 0" />
        <RemoveContaining Vector = "-x[3]*S;-y[3]*S; 0" />
    </Figure>
</xml>
