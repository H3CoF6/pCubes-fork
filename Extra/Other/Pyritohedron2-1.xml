<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Pyritohedron2-1</Name>
        <Menu>Grigr\Pyritohedron2-1</Menu>
        <Inventor>Bo HU</Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
    </Interface>

    <Script>
        clYellow       := 'FFFF00';
        clLightBlue    := '2828FF';
        clBlue         := '0000A0';
        clBrown        := '800000';
        clOrange       := 'FF6000';
        clLightViolett := 'FF0080';
        clRed          := 'FF0000';
        clLightGreen   := '00FF00';
        clGreen        := '008000';
        clViolett      := '800080';
        clCyan         := '00DCB4';
        clWhite        := 'FFFFFF';

        R := 0.8;

        //k := 0.77878026293;
        k := 0.838;
        b := (R * k);
        c := (R * sqrt(3 / 4 - k^2));
        a := (R * k^2 / (2 * k - sqrt(3 / 4 - k^2)));

        ss := b / sqrt(b^2 + (b - c)^2);
        cs := (b - c) / sqrt(b^2 + (b - c)^2);

        D := 0.399;

        A0 := 0;
        A1 := Arccos((a^2-(a-c)^2-(a-b)^2) / (a^2+(a-c)^2+(a-b)^2));
        A2 := Arccos((a*(c-a)+(c-a)*(a-b)-a*(a-b)) / (a^2+(a-c)^2+(a-b)^2));
        A3 := A1 + A2;
        A4 := 2 * Pi - (A2 + A1 + A2);
        A5 := A2 + A1 + A2;
        A6 := 2 * Pi - A3;
        A7 := 2 * Pi - A2;
        A8 := 2 * Pi - A1;
    </Script>

    <Axes AvailableAngles = "A0; A1; A2; A3; A4; A5; A6; A7; A8" PlaneDistances = "-D; D" FixedLayer = "1">
        <Axis NormVector = "   0;  ss;  cs" />
        <Axis NormVector = "   0; -ss;  cs" />
        <Axis NormVector = "  ss;  cs;   0" />
        <Axis NormVector = " -ss;  cs;   0" />
        <Axis NormVector = "  cs;   0;  ss" />
        <Axis NormVector = "  cs;   0; -ss" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0;  c;  b" />
                <Add Vector = " 0; -c;  b" />
                <Add Vector = " 0; -c; -b" />
                <Add Vector = " 0;  c; -b" />

                <Add Vector = " c;  b;  0" />
                <Add Vector = "-c;  b;  0" />
                <Add Vector = "-c; -b;  0" />
                <Add Vector = " c; -b;  0" />

                <Add Vector = " b;  0;  c" />
                <Add Vector = " b;  0; -c" />
                <Add Vector = "-b;  0; -c" />
                <Add Vector = "-b;  0;  c" />

                <Add Vector = " a;  a;  a" />
                <Add Vector = " a;  a; -a" />
                <Add Vector = " a; -a;  a" />
                <Add Vector = " a; -a; -a" />
                <Add Vector = "-a;  a;  a" />
                <Add Vector = "-a;  a; -a" />
                <Add Vector = "-a; -a;  a" />
                <Add Vector = "-a; -a; -a" />

            </Vertices>

            <Faces>
                <Face Color = "clBlue        " VertexIndexes = "1;18;6;7;14" />
                <Face Color = "clBrown       " VertexIndexes = "0;12;4;5;16" />
                <Face Color = "clCyan        " VertexIndexes = "2;15;7;6;19" />
                <Face Color = "clLightBlue   " VertexIndexes = "3;17;5;4;13" />
                <Face Color = "clLightViolett" VertexIndexes = "7;15;9;8;14" />
                <Face Color = "clLightGreen  " VertexIndexes = "4;12;8;9;13" />
                <Face Color = "clGreen       " VertexIndexes = "6;18;11;10;19" />
                <Face Color = "clViolett     " VertexIndexes = "5;17;10;11;16" />
                <Face Color = "clYellow      " VertexIndexes = "0;1;14;8;12" />
                <Face Color = "clRed         " VertexIndexes = "1;0;16;11;18" />
                <Face Color = "clOrange      " VertexIndexes = "2;3;13;9;15" />
                <Face Color = "clWhite       " VertexIndexes = "3;2;19;10;17" />
            </Faces>
        </Part>

        <SplitByAxes/>
    </Figure>
</xml>
