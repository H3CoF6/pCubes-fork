<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Mastermorphynx + Pyraminx</Name>
        <Menu>KnightCrawler\Tetrahedron\Mix\Mastermorphynx + Pyraminx</Menu>
        <Inventor></Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>
        Cut := 60/180*0.5;
        N := 3;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D" FixedLayers = "1" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>
    <Axes TurningAngles = "Pi" PlaneDistances = "-Cut;Cut" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" /><Axis NormVector = "0; 1; 0" /><Axis NormVector = "0; 0; 1" />
    </Axes>
    <Axes>
        <Axis NormVector = "-1; 0; 0" /><Axis NormVector = "0; -1; 0" /><Axis NormVector = "0; 0; -1" />
    </Axes>
    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>