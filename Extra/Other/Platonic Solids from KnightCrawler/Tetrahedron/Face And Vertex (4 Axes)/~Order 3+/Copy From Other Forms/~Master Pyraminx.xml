<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Master Pyraminx</Name>
        <Menu>KnightCrawler\Tetrahedron\Face And Vertex (4 Axes)\Master Pyraminx</Menu>
        <Inventor>Katsuhiko Okamoto</Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>
        N := 4;
        D := 2 * sqrt(3) / 3 / N;
        D0 := -sqrt(3) / 6;
    </Script>

    <Axes TurningAngles = "2 * Pi / 3" PlaneDistances = "D0 + D; D0 + 2*D; D0 + 3*D" >
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Tetrahedron.xml" />

        <SplitByAxes/>
    </Figure>
</xml>
