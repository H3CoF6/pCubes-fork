<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Edge Cut 075 (Jumbling)</Name>
        <Menu>KnightCrawler\Octahedron\Edge (12 Axes)\Edge Cut 075 (Jumbling)</Menu>
        <Inventor></Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>    Degree:=75;
        Cut := (180-Degree)/180*sqrt(0.75*0.75+0.75*0.75)/2;
    </Script>
    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-Cut;Cut" >
        <Axis NormVector = "-1; -1; 0" />
        <Axis NormVector = "1; -1; 0" />
        <Axis NormVector = "-1; 0; -1" />
        <Axis NormVector = "-1; 0; 1" />
        <Axis NormVector = "0; -1; -1" />
        <Axis NormVector = "0; 1; -1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>