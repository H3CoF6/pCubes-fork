    </Axes>
    <Axes>
        <Axis NormVector = "1; 1; 0" /><Axis NormVector = "-1; 1; 0" /><Axis NormVector = "1; 0; 1" /><Axis NormVector = "1; 0; -1" /><Axis NormVector = "0; 1; 1" /><Axis NormVector = "0; -1; 1" />
    </Axes>

