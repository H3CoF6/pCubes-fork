<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Face Cut 180 090 (Master FTO)</Name>
        <Menu>KnightCrawler\Octahedron\Face (8 Axes)\Face Cut 180 090 (Master FTO)</Menu>
        <Inventor></Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>    Degree:=180;
        Cut := (180-Degree)/180*sqrt(0.75)/2;
        Cut2 := (180-90)/180*sqrt(0.75)/2;
    </Script>
    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "Cut;-Cut2;Cut2" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>
    <Axes>
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = "-1;  1; -1" />
    </Axes>
    <Figure>
        <LoadFrom File = "Figures\Octahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>