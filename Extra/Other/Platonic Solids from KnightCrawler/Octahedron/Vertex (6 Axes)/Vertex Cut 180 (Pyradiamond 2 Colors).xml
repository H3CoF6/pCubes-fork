<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Vertex Cut 180 (Pyradiamond 2 Colors)</Name>
        <Menu>KnightCrawler\Octahedron\Vertex (6 Axes)\Vertex Cut 180 (Pyradiamond 2 Colors)</Menu>
        <Inventor></Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>
    <Script>    Degree:=180;
        Cut := (180-Degree)/180*0.75;
        R := 0.5 * 1.5;
    </Script>
    <Axes TurningAngles = "Pi/2" PlaneDistances = "-Cut;Cut" >



        <Axis NormVector = "1; 0; 0" /><Axis NormVector = "0; 1; 0" /><Axis NormVector = "0; 0; 1" />
    </Axes>
   <Axes>
        <Axis NormVector = "-1; 0; 0" /><Axis NormVector = "0; -1; 0" /><Axis NormVector = "0; 0; -1" />
    </Axes>
    <Figure>
    <Part>
        <Vertices>
            <Add Vector = "-R; 0; 0" />
            <Add Vector = "R; 0; 0" />
            <Add Vector = "0; -R; 0" />
            <Add Vector = "0; R; 0" />
            <Add Vector = "0; 0; -R" />
            <Add Vector = "0; 0; R" />
        </Vertices>

        <Faces>
            <Face Color = "0000C8" VertexIndexes = "0;2;5" />
            <Face Color = "0000C8" VertexIndexes = "5;2;1" />
            <Face Color = "0000C8" VertexIndexes = "5;1;3" />
            <Face Color = "0000C8" VertexIndexes = "5;3;0" />
            <Face Color = "C80000" VertexIndexes = "4;2;0" />
            <Face Color = "C80000" VertexIndexes = "4;1;2" />
            <Face Color = "C80000" VertexIndexes = "4;3;1" />
            <Face Color = "C80000" VertexIndexes = "4;0;3" />
        </Faces>
    </Part>
        <SplitByAxes/>

    </Figure>
    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>