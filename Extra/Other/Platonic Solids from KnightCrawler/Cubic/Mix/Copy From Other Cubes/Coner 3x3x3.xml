<?xml version = "1.0" encoding = "UTF-8"?>

<xml Data_Version = "2" >
    <Interface>
        <Name>Coner 3x3x3</Name>
        <Menu>KnightCrawler\Cubic\Mix\Coner 3x3x3</Menu>
        <Inventor>Minh Sanghsu</Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>
        Width := 0.5;
        D := Width / (1 + sqrt(2));
        D1 := Width * (sqrt(3) - sqrt(2 / 3));
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D1; D1" FixedLayers = "1" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
