<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter Skewb 60</Name>
        <Menu>KnightCrawler\Cubic\Mix\Helicopter Skewb 60</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>
 
    <Script>
        W := sqrt(2) / 4;
    </Script>
 
    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-W; W" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>
 
    <Axes TurningAngles = "Pi / 3" PlaneDistances = "0" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = " 1; -1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = "-1;  1; 1" />
    </Axes>
 
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
 
        <SplitByAxes/>
    </Figure>
</xml>
