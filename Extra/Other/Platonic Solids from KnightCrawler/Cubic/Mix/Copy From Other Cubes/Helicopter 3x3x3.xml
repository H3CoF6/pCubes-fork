<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Helicopter 3x3x3</Name>
        <Menu>KnightCrawler\Cubic\Mix\Helicopter 3x3x3</Menu>
        <Inventor>Jason Smith</Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>
 
    <Script>
        Width333 := 1 / 16;
        W := sqrt(2) / 4 + Width333 / sqrt(2);
    </Script>
 
    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-W; W" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-Width333; Width333" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
 
        <SplitByAxes/>
    </Figure>
</xml>
