    <Interface>
        <Name>Vertex Cut 090 (Compy Cube)</Name>
        <Menu>KnightCrawler\Cubic\Vertex (8 Axes)\Vertex Cut 090 (Compy Cube)</Menu>
        <Inventor></Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>    Degree:=90;
        Cut := (180-Degree)/180*sqrt(3)/2;
    </Script>
    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-Cut;Cut" FixedLayers = "1" >
        <Axis NormVector = " 1;  1;  1" />
        <Axis NormVector = "-1;  1;  1" />
        <Axis NormVector = "-1; -1;  1" />
        <Axis NormVector = " 1; -1;  1" />
    </Axes>
    <Axes>
        <Axis NormVector = " -1;  -1;  -1" />
        <Axis NormVector = "1;  -1;  -1" />
        <Axis NormVector = "1; 1;  -1" />
        <Axis NormVector = " -1; 1;  -1" />
    </Axes>
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>