<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Compy Skewb</Name>
        <Menu>KnightCrawler\Cubic\Vertex (8 Axes)\Compy Skewb</Menu>
        <Inventor>Tom van der Zanden</Inventor>
        <Programmer>Skallos</Programmer>
        <Added></Added>
    </Interface>

    <Script>
        D := 2 * sqrt(3) / 9;
        D2 := 2 * D;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "-D2; -D; 0; D; D2" >
        <Axis NormVector = " 1;  1; 1" />
        <Axis NormVector = "-1;  1; 1" />
        <Axis NormVector = "-1; -1; 1" />
        <Axis NormVector = " 1; -1; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
