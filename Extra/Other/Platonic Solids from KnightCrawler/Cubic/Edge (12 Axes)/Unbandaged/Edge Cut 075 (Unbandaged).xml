<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Edge Cut 075 (Unbandaged)</Name>
        <Menu>KnightCrawler\Cubic\Edge (12 Axes)\Unbandaged\Edge Cut 075 (Unbandaged)</Menu>
        <Inventor></Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>    Degree:=75;
        Cut := (180-Degree)/180*sqrt(2)/2;
        jumAngle := ArcCos(1 / 3);
    </Script>
    <Axes TurningAngles = "Pi" JumbleAngle = "Arccos(1/3)" PlaneDistances = "-Cut;Cut" FixedLayers = "1" >
        <Axis NormVector = " 0;  1; 1" />
        <Axis NormVector = " 1;  0; 1" />
        <Axis NormVector = " 0; -1; 1" />
        <Axis NormVector = "-1;  0; 1" />
        <Axis NormVector = "-1;  1; 0" />
        <Axis NormVector = " 1;  1; 0" />
    </Axes>
    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />
        <SplitByAxes/>
        // up-down
        // -0 -5
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "0" />

        // -3 -4
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "2" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "2" />
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "0" />

        // -2 +5
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "0" />

        // -1 +4
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "0" />


        // left-right
        // -4 -0
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "2" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "4" From = "2" />
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "0" />

        // -3 -2
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "2" />
        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "2" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "0" />

        // +5 +0
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "2" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "0" />

        // +1 +2
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "2" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "2" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "0" />


        // face-back
        // +2 +3
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "2" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "2" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "2" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "2" Angle =  "JumAngle" Layer = "0" />

        // -4 +1
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "4" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "2" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "4" From = "2" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "4" Angle = "-JumAngle" Layer = "0" />

        // -0 -3
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "0" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "3" Angle = "-JumAngle" Layer = "2" />
        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "2" />
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "3" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "0" Angle = "-JumAngle" Layer = "0" />

        // -5 -1
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "5" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "0" />
        <Turn Axis = "1" Angle = "-JumAngle" Layer = "2" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "5" From = "2" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "2" />
        <Turn Axis = "1" Angle =  "JumAngle" Layer = "0" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "2" />
        <Turn Axis = "5" Angle = "-JumAngle" Layer = "0" />
    </Figure>
</xml>