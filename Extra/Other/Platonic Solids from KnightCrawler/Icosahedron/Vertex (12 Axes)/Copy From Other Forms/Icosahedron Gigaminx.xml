<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Icosahedron Gigaminx</Name>
        <Menu>KnightCrawler\Icosahedron\Vertex (12 Axes)\Icosahedron Gigaminx</Menu>
        <Inventor>Ola Jansson</Inventor>
        <Programmer></Programmer>
        <Added></Added>
    </Interface>

    <Script>
        D1 := 0.365;
        D2 := 0.42;
        mAngle := ArcTan(0.5);
        As := sin(mAngle);
        Ac := cos(mAngle);
        sAngle := PI * 2 / 5;
        for i := 1 to 5 do begin
            x[i] := sin(sAngle * (i - 1)) * Ac;
            y[i] := cos(sAngle * (i - 1)) * Ac;
        end;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D2; -D1; D1; D2" FixedLayers = "2" >
        <Axis NormVector = "   0;    0;  1" />
        <Axis NormVector = "x[1]; y[1]; As" />
        <Axis NormVector = "x[2]; y[2]; As" />
        <Axis NormVector = "x[3]; y[3]; As" />
        <Axis NormVector = "x[4]; y[4]; As" />
        <Axis NormVector = "x[5]; y[5]; As" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Icosahedron.xml" />
        <SplitByAxes/>
    </Figure>

    <Procedures CheckSolved = "EachColorHasSameOrOppositeDirection" />
</xml>
