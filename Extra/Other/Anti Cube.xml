<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Anti Cube</Name>
        <Menu>Grigr\Anti Cube</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
    </Interface>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3/10; -1/10; 1/10; 3/10" >
        <Axis NormVector = " 0;  0;  1" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 1;  0;  0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-0.01; 0.01" >
        <Axis NormVector = " 0;  0;  1" />
        <Axis NormVector = " 0;  1;  0" />
        <Axis NormVector = " 1;  0;  0" />
    </Axes>

    <Axes TurningAngles = "Pi" PlaneDistances = "-0.53; 0.53" >
        <Axis NormVector = " 0.1; 0.9; 0" />
        <Axis NormVector = " 0.9; 0.1; 0" />
        <Axis NormVector = " -0.1;0.9; 0" />
        <Axis NormVector = " -0.9;0.1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Split Axis = "0" From = "1" />
        <Split Axis = "0" From = "4" />
        <Split Axis = "1" From = "1" />
        <Split Axis = "1" From = "4" />
        <Split Axis = "2" From = "1" />
        <Split Axis = "2" From = "4" />

        <HideContaining Vector = " 0.5;  0  ;  0  " />
        <HideContaining Vector = "-0.5;  0  ;  0  " />
        <HideContaining Vector = " 0  ;  0.5;  0  " />
        <HideContaining Vector = " 0  ; -0.5;  0  " />
        <HideContaining Vector = " 0  ;  0  ;  0.5" />
        <HideContaining Vector = " 0  ;  0  ; -0.5" />

        <Split Axis = "0" From = "2" />
        <Split Axis = "0" From = "3" />
        <Split Axis = "1" From = "2" />
        <Split Axis = "1" From = "3" />
        <Split Axis = "2" From = "2" />
        <Split Axis = "2" From = "3" />

        <ShowAll/>

        <HideContaining Vector = " 0.5;  0.5;  0  " />
        <HideContaining Vector = "-0.5;  0.5;  0  " />
        <HideContaining Vector = "-0.5; -0.5;  0  " />
        <HideContaining Vector = " 0.5; -0.5;  0  " />
        <HideContaining Vector = " 0.5;  0  ;  0.5" />
        <HideContaining Vector = "-0.5;  0  ;  0.5" />
        <HideContaining Vector = "-0.5;  0  ; -0.5" />
        <HideContaining Vector = " 0.5;  0  ; -0.5" />
        <HideContaining Vector = " 0  ;  0.5;  0.5" />
        <HideContaining Vector = " 0  ; -0.5;  0.5" />
        <HideContaining Vector = " 0  ; -0.5; -0.5" />
        <HideContaining Vector = " 0  ;  0.5; -0.5" />

        <Split Axis = "3" From = "1" />
        <Split Axis = "3" From = "2" />
        <Split Axis = "4" From = "1" />
        <Split Axis = "4" From = "2" />
        <Split Axis = "5" From = "1" />
        <Split Axis = "5" From = "2" />

        <ShowAll/>

        <Hide Axis = "0" From = "0" To = "1" />
        <Hide Axis = "0" From = "3" To = "4" />
        <Hide Axis = "3" From = "0" To = "0" />
        <Hide Axis = "3" From = "2" To = "2" />

        <Split Axis = "6" From = "1" />
        <Split Axis = "6" From = "2" />
        <Split Axis = "7" From = "1" />
        <Split Axis = "7" From = "2" />
        <Split Axis = "8" From = "1" />
        <Split Axis = "8" From = "2" />
        <Split Axis = "9" From = "1" />
        <Split Axis = "9" From = "2" />

        <HideContaining Vector = " 0.5;  0.5; 0" />
        <HideContaining Vector = "-0.5;  0.5; 0" />
        <HideContaining Vector = "-0.5; -0.5; 0" />
        <HideContaining Vector = " 0.5; -0.5; 0" />

        <Cut Axis = "3" From = "1" To = "1" />

        <RemoveGrayParts/>

        <ShowAll/>
    </Figure>
</xml>
