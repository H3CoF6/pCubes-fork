<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sphere Un35-2</Name>
        <Menu>Grigr\Sphere Un35-2</Menu>
        <Inventor></Inventor>
        <Programmer>Evgeniy Grigoriev</Programmer>
        <Added>2018-01-27</Added>
        <Link></Link>
    </Interface>

    <Script>
        K := 0.7;

        AngleD := 125.0;

        Angle  := AngleD * Pi/180;
        AngleM := (Pi - Angle)/2; 
        x := sin(2*AngleM);
        y := cos(2*AngleM);

        A1 := Pi*2/3;
        A2 := Pi*2/5;

        D := K* 0.08;       // 1 normal
    </Script>       

    <Axes TurningAngles = "A1" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " x; y; 0" />
    </Axes>
    <Axes TurningAngles = "A2" PlaneDistances = "D" FixedLayers = "0" >
        <Axis NormVector = " 0;-1; 0" />
    </Axes>

    <Figure>
        <LoadFrom File = "Puzzles\Other forms\Sphere\_Macro_For_Cubic_Sphere.xml" />
        <SplitByAxes/>

        <Macro Name = "SplitPart">
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "0" Angle = " A1" Layer = "1" /> <SplitByAxes/>
            <Turn Axis = "1" Angle = "-A2" Layer = "1" /> <SplitByAxes/>
            <RemoveGrayParts/>
        </Macro>

        /////////////////////

        <ExecMacro MacroName = "SplitPart" Repeat = "3" />
        <Undo Repeat = "200" />

        <SaveSolvedState/>
    </Figure>
    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
