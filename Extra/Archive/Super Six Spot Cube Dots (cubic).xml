<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Six Spot Cube Dots (cubic)</Name>
        <Menu>Other cubes\Vertex Turning\Super Six Spot Cube Dots (cubic)</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added></Added>
        <Link>https://oliverstickers.com/super-six-spot-cube-dots.html</Link>
    </Interface>

    <Script>
        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';
        clWhite     := 'F0F0F0';
        clLightBlue := '0088FF';
        clRed       := 'FF0000';
        clYellow    := 'FFFF00';
        clLime      := '00FF00';
        clOrange    := 'FF8800';
        clBlack     := '202020';
        R  := W * 0.15;
        Wc := W * 1.001;
        BigW := W;

        DC := W / 2;

        RCut := W * (sqrt(3) - 0.08);
        RCu2 := W * (sqrt(2) - 0.02);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" FixedLayers = "1" >
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>
    <Figure>

        <Part>
            <Vertices Vectors = "Vx; Vy; Vz" />

            <Faces>
                <Face Color = "clRed"       VertexIndexes = "0;1;3;2" />
                <Face Color = "clOrange"    VertexIndexes = "5;4;6;7" />
                <Face Color = "clLightBlue" VertexIndexes = "1;0;4;5" />
                <Face Color = "clLime"      VertexIndexes = "2;3;7;6" />
                <Face Color = "clYellow"    VertexIndexes = "0;2;6;4" />
                <Face Color = "clWhite"     VertexIndexes = "3;1;5;7" />
            </Faces>
        </Part>

        <SplitByAxes/>
        <RemoveContaining Vector = " vx[0]; vy[0]; vz[0]" />
        <RemoveContaining Vector = " vx[3]; vy[3]; vz[3]" />
        <RemoveContaining Vector = " vx[5]; vy[5]; vz[5]" />
        <RemoveContaining Vector = " vx[6]; vy[6]; vz[6]" />

        <InvertVisibility/>

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "BigW" />
        <SplitByAxes/>
        <HideContaining Vector = " vx[0]; vy[0]; vz[0]" />
        <HideContaining Vector = " vx[3]; vy[3]; vz[3]" />
        <HideContaining Vector = " vx[5]; vy[5]; vz[5]" />
        <HideContaining Vector = " vx[6]; vy[6]; vz[6]" />
        <RemoveAllVisible/>
        <ShowAll/>

        <Cylinder Radius = "R" Color = "clBlack" >
            <Base X = " DC" Y = " DC" Z = "W" />
            <Top  X = " DC" Y = " DC" Z = "Wc" Color = "clBlack" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlack" >
            <Base X = "DC" Y = "-DC" Z = "-W" />
            <Top  X = "DC" Y = "-DC" Z = "-Wc" Color = "clBlack" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlack" >
            <Base X = "-DC" Y = "W"  Z = "-DC" />
            <Top  X = "-DC" Y = "Wc" Z = "-DC" Color = "clBlack" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlack" >
            <Base X = "DC" Y = "-W"  Z = "-DC" />
            <Top  X = "DC" Y = "-Wc" Z = "-DC" Color = "clBlack" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlack" >
            <Base X = "W" Y = "DC"  Z = "DC" />
            <Top  X = "WC" Y = "DC" Z = "DC" Color = "clBlack" />
        </Cylinder>
        <Cylinder Radius = "R" Color = "clBlack" >
            <Base X = "-W" Y = "-DC"  Z = "DC" />
            <Top  X = "-Wc" Y = "-DC" Z = "DC" Color = "clBlack" />
        </Cylinder>
        <SplitByAxes/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>


