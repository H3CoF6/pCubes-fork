<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Alexander's Star (Skallos)</Name>
        <Menu>Other forms\Star\Alexander's Star Skallos</Menu>
        <Menu>Test\Alexander's Star Skallos</Menu>
        <Inventor>Aleksandr Ordynets</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2016-03-23</Added>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';

        D := Rsin + 0.00001;
    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = "Vx[ 0]; Vy[ 0]; Vz[ 0]" />
                <Add Vector = "Vx[ 1]; Vy[ 1]; Vz[ 1]" />
                <Add Vector = "Vx[ 2]; Vy[ 2]; Vz[ 2]" />
                <Add Vector = "Vx[ 3]; Vy[ 3]; Vz[ 3]" />
                <Add Vector = "Vx[ 4]; Vy[ 4]; Vz[ 4]" />
                <Add Vector = "Vx[ 5]; Vy[ 5]; Vz[ 5]" />
                <Add Vector = "Vx[ 6]; Vy[ 6]; Vz[ 6]" />
                <Add Vector = "Vx[ 7]; Vy[ 7]; Vz[ 7]" />
                <Add Vector = "Vx[ 8]; Vy[ 8]; Vz[ 8]" />
                <Add Vector = "Vx[ 9]; Vy[ 9]; Vz[ 9]" />
                <Add Vector = "Vx[10]; Vy[10]; Vz[10]" />
                <Add Vector = "Vx[11]; Vy[11]; Vz[11]" />
            </Vertices>

            <Faces>
                <Face Color = "FFFF00" VertexIndexes = "1;5;4;3;2" />
                <Face Color = "FF0080" VertexIndexes = "6;7;8;9;10" />
                <Face Color = "0000A0" VertexIndexes = "0;1;10;9;4" />
                <Face Color = "FF0000" VertexIndexes = "0;2;6;10;5" />
                <Face Color = "800000" VertexIndexes = "0;3;7;6;1" />
                <Face Color = "00FF00" VertexIndexes = "0;4;8;7;2" />
                <Face Color = "00DCB4" VertexIndexes = "0;5;9;8;3" />
                
                <Face Color = "008000" VertexIndexes = "11;10;1;2;7" />
                <Face Color = "800080" VertexIndexes = "11;6;2;3;8" />
                <Face Color = "2828FF" VertexIndexes = "11;7;3;4;9" />
                <Face Color = "FF6000" VertexIndexes = "11;8;4;5;10" />
                <Face Color = "FFFFFF" VertexIndexes = "11;9;5;1;6" />
            </Faces>
        </Part>
        <SplitByAxes/>
        <RemoveContaining Vector = "0; 0; 0" />
    </Figure>
</xml>
