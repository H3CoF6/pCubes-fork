<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Fourcylinder 4x4x4</Name>
        <Menu>Other forms\Catalan Solids\Deltoidal Icositetrahedron\Fourcylinder 4x4x4</Menu>
        <Inventor>Alexandr Abalikhin</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-15</Added>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=5477</Link>
    </Interface>

    <Script>
        include 'Figures\Scripts\Deltoidal Icositetrahedron_24_Colors.inc';

        W  := 0.45;
        C0 := W * (4 + sqrt(2)) / 7;
        D := C0 / 2;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; 0; D" >
        <Axis NormVector = " 1; 0; 0" />
        <Axis NormVector = " 0; 1; 0" />
        <Axis NormVector = " 0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Deltoidal Icositetrahedron.xml" />
        <SplitByAxes/>
    </Figure>
</xml>
