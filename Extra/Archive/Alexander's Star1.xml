<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

One of realizations of Alexander's star

    <Interface>
        <Name>Alexander's Star1</Name>
        <Menu>Other forms\Intersecting Solids\Alexander's Star1</Menu>
        <Menu>Test\Alexander's Star1</Menu>
        <Inventor>Aleksandr Ordynets</Inventor>
    </Interface>

    <Script>
        R := 0.7;
        include 'Figures\Scripts\Icosahedron_Coordinates.inc';
        include 'Figures\Scripts\Dodecahedron_Standard_Colors.inc';

        D := Rsin;

        K1 := (sqrt(5) - 1)/4;
        K2 := sqrt((25 - 11 * sqrt(5)) * 2) / 4;

    </Script>

    <Axes TurningAngles = "sAngle" PlaneDistances = "-D; D" FixedLayers = "1" >
        <Axis NormVector = "Vx[0]; Vy[0]; Vz[0]" />
        <Axis NormVector = "Vx[1]; Vy[1]; Vz[1]" />
        <Axis NormVector = "Vx[2]; Vy[2]; Vz[2]" />
        <Axis NormVector = "Vx[3]; Vy[3]; Vz[3]" />
        <Axis NormVector = "Vx[4]; Vy[4]; Vz[4]" />
        <Axis NormVector = "Vx[5]; Vy[5]; Vz[5]" />
    </Axes>

    <Figure>
        <Macro Name = "AddPart">
            <Part>
                <Vertices>
                    <Add Vector = "Vx[i1]; Vy[i1]; Vz[i1]" />
                    <Add Vector = "Vx[i2]; Vy[i2]; Vz[i2]" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 - (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) / R * K2; (Vy[i1] + Vy[i2]) * K1 - (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) / R * K2; (Vz[i1] + Vz[i2]) * K1 - (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) / R * K2" />
                    <Add Vector = "(Vx[i1] + Vx[i2]) * K1 + (Vy[i1] * Vz[i2] - Vz[i1] * Vy[i2]) / R * K2; (Vy[i1] + Vy[i2]) * K1 + (Vz[i1] * Vx[i2] - Vx[i1] * Vz[i2]) / R * K2; (Vz[i1] + Vz[i2]) * K1 + (Vx[i1] * Vy[i2] - Vy[i1] * Vx[i2]) / R * K2" />
                </Vertices>
                <Faces>
                    <Face Color = "Colors[c1]" VertexIndexes = "0;2;1" />
                    <Face Color = "Colors[c2]" VertexIndexes = "0;1;3" />
                    <Face VertexIndexes = "2;0;3" />
                    <Face VertexIndexes = "1;2;3" />
                </Faces>
            </Part>
        </Macro>

        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 1" c1 = " 9" C2 = " 7" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 2" c1 = " 0" C2 = "10" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 3" c1 = " 5" C2 = " 9" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 4" c1 = " 7" C2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 0" i2 = " 5" c1 = "10" C2 = " 5" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 2" c1 = " 3" C2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 3" c1 = " 3" C2 = " 6" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 4" c1 = " 3" C2 = " 8" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 5" c1 = " 3" C2 = "11" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 1" c1 = " 3" C2 = " 2" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = " 6" c1 = " 9" C2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 7" c1 = " 0" C2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 8" c1 = " 5" C2 = " 6" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 9" c1 = " 7" C2 = " 8" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = "10" c1 = "10" C2 = "11" />

        <ExecMacro MacroName = "AddPart" i1 = " 1" i2 = "10" c1 = " 4" C2 = " 7" />
        <ExecMacro MacroName = "AddPart" i1 = " 2" i2 = " 6" c1 = " 6" C2 = "10" />
        <ExecMacro MacroName = "AddPart" i1 = " 3" i2 = " 7" c1 = " 8" C2 = " 9" />
        <ExecMacro MacroName = "AddPart" i1 = " 4" i2 = " 8" c1 = "11" C2 = " 0" />
        <ExecMacro MacroName = "AddPart" i1 = " 5" i2 = " 9" c1 = " 2" C2 = " 5" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = " 7" c1 = " 9" C2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = " 8" c1 = " 0" C2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = " 9" c1 = " 5" C2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "10" c1 = " 7" C2 = " 1" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = " 6" c1 = "10" C2 = " 1" />

        <ExecMacro MacroName = "AddPart" i1 = " 6" i2 = "11" c1 = " 6" C2 = " 2" />
        <ExecMacro MacroName = "AddPart" i1 = " 7" i2 = "11" c1 = " 8" C2 = " 4" />
        <ExecMacro MacroName = "AddPart" i1 = " 8" i2 = "11" c1 = "11" C2 = " 6" />
        <ExecMacro MacroName = "AddPart" i1 = " 9" i2 = "11" c1 = " 2" C2 = " 8" />
        <ExecMacro MacroName = "AddPart" i1 = "10" i2 = "11" c1 = " 4" C2 = "11" />
    </Figure>
</xml>
