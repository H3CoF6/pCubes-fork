<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super Six Spot Cube Triangles (cubic)</Name>
        <Menu>Other cubes\Vertex Turning\Super Six Spot Cube Triangles (cubic)</Menu>
        <Inventor>David Pitcher</Inventor>
        <Programmer>xchemist</Programmer>
        <Added></Added>
        <Link>https://oliverstickers.com/super-six-spot-cube-triangles.html</Link>
    </Interface>

    <Script>
        W  := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        clWhite       := 'F0F0F0';
        clSilver      := 'C0C0C0';
        clBlue        := '0000FF';
        clLightBlue   := '0088FF';
        clRed         := 'FF0000';
        clDarkRed     := 'BB0000';
        clYellow      := 'FFFF00';
        clGolden      := 'DDBB20';
        clLime        := '00FF00';
        clGreen       := '008000';
        clOrange      := 'FF8800';
        clDarkOrange  := 'DD3300';

        BigW := W;
        e  := 5;
        RCut := W * (sqrt(3) - 0.08);
        RCu2 := W * (sqrt(2) - 0.02);
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" FixedLayers = "1">
        <Axis NormVector = "-1; -1; -1" />
        <Axis NormVector = " 1;  1; -1" />
        <Axis NormVector = " 1; -1;  1" />
        <Axis NormVector = "-1;  1;  1" />
    </Axes>

    <Figure>
        <Part>
            <Vertices>
                <Add Vector = " 0; 0; W" />
                <Add Vector = " 0; 0;-W" />
                <Add Vector = " W; 0; 0" />
                <Add Vector = "-W; 0; 0" />
                <Add Vector = " 0; W; 0" />
                <Add Vector = " 0;-W; 0" />
                <Add Vector = " W; W; W" />
                <Add Vector = " W; W;-W" />
                <Add Vector = " W;-W; W" />
                <Add Vector = " W;-W;-W" />
                <Add Vector = "-W; W; W" />
                <Add Vector = "-W; W;-W" />
                <Add Vector = "-W;-W; W" />
                <Add Vector = "-W;-W;-W" />
            </Vertices>

            <Faces>
                <Face Color = "clSilver "    VertexIndexes = "0; 6;10" InvisibleEdges = "e" />
                <Face Color = "clSilver"     VertexIndexes = "0;10;12" InvisibleEdges = "e" />
                <Face Color = "clWhite"      VertexIndexes = "0;12; 8" InvisibleEdges = "e" />
                <Face Color = "clWhite"      VertexIndexes = "0; 8; 6" InvisibleEdges = "e" />
                <Face Color = "clGolden"     VertexIndexes = "1; 7; 9" InvisibleEdges = "e" />
                <Face Color = "clGolden"     VertexIndexes = "1; 9;13" InvisibleEdges = "e" />
                <Face Color = "clYellow"     VertexIndexes = "1;13;11" InvisibleEdges = "e" />
                <Face Color = "clYellow"     VertexIndexes = "1;11; 7" InvisibleEdges = "e" />
                <Face Color = "clDarkOrange" VertexIndexes = "2; 6; 8" InvisibleEdges = "e" />
                <Face Color = "clOrange"     VertexIndexes = "2; 8; 9" InvisibleEdges = "e" />
                <Face Color = "clOrange"     VertexIndexes = "2; 9; 7" InvisibleEdges = "e" />
                <Face Color = "clDarkOrange" VertexIndexes = "2; 7; 6" InvisibleEdges = "e" />
                <Face Color = "clRed"        VertexIndexes = "3;10;11" InvisibleEdges = "e" />
                <Face Color = "clDarkRed"    VertexIndexes = "3;11;13" InvisibleEdges = "e" />
                <Face Color = "clDarkRed"    VertexIndexes = "3;13;12" InvisibleEdges = "e" />
                <Face Color = "clRed"        VertexIndexes = "3;12;10" InvisibleEdges = "e" />
                <Face Color = "clLime"       VertexIndexes = "4; 6; 7" InvisibleEdges = "e" />
                <Face Color = "clGreen "     VertexIndexes = "4; 7;11" InvisibleEdges = "e" />
                <Face Color = "clGreen"      VertexIndexes = "4;11;10" InvisibleEdges = "e" />
                <Face Color = "clLime"       VertexIndexes = "4;10; 6" InvisibleEdges = "e" />
                <Face Color = "clBlue"       VertexIndexes = "5; 8;12" InvisibleEdges = "e" />
                <Face Color = "clLightBlue"  VertexIndexes = "5;12;13" InvisibleEdges = "e" />
                <Face Color = "clLightBlue"  VertexIndexes = "5;13; 9" InvisibleEdges = "e" />
                <Face Color = "clBlue"       VertexIndexes = "5; 9; 8" InvisibleEdges = "e" />
            </Faces>
        </Part>

        <SplitByAxes/>

        <RemoveContaining Vector = " vx[0]; vy[0]; vz[0]" />
        <RemoveContaining Vector = " vx[3]; vy[3]; vz[3]" />
        <RemoveContaining Vector = " vx[5]; vy[5]; vz[5]" />
        <RemoveContaining Vector = " vx[6]; vy[6]; vz[6]" />

        <InvertVisibility/>

        <LoadFrom File = "Figures\CubeMono.xml" Color = "-1" Width = "BigW" />
        <Macro Name = "CutGray">
            <Cut> <Plane NormVector = "-cx[id]; -cy[id]; -cz[id]" NormDistance = "-0.5" /> </Cut>
            <Script>Inc(id);</Script>
        </Macro>
        <ExecMacro MacroName = "CutGray" Repeat = "6" id = "0" />
        <SplitByAxes/>
        <HideContaining Vector = " vx[0]; vy[0]; vz[0]" />
        <HideContaining Vector = " vx[3]; vy[3]; vz[3]" />
        <HideContaining Vector = " vx[5]; vy[5]; vz[5]" />
        <HideContaining Vector = " vx[6]; vy[6]; vz[6]" />
        <RemoveAllVisible/>
        <ShowAll/>

        <!-- cut edges and vertices for better control -->
        <Cut> <Plane NormVector = " 1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1; -1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  1" NormDistance = "-RCut" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1; -1" NormDistance = "-RCut" /> </Cut>

        <Cut> <Plane NormVector = " 1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1; -1;  0" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = "-1;  0; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0;  1; -1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1;  1" NormDistance = "-RCu2" /> </Cut>
        <Cut> <Plane NormVector = " 0; -1; -1" NormDistance = "-RCu2" /> </Cut>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>


