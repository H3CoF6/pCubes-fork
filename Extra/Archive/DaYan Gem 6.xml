           <Cut Color="E75911" > <!-- оранж -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 7)" Y="-K" Z="cos(Pi / 8 + Pi / 4 * 7)" />
                   <NormDistance> -D </NormDistance>
               </Plane>
           </Cut>

        <SplitByAxes/>

           <Turn Axis = "0" Angle = "-Pi / 4" Layer = "0" />
           <Turn Axis = "0" Angle = "-Pi / 4" Layer = "4" />
           <Split Axis = "1" From = "1" />
           <Split Axis = "1" From = "2" />
           <Split Axis = "1" From = "3" />
           <Split Axis = "1" From = "4" />
           <Split Axis = "2" From = "1" />
           <Split Axis = "2" From = "2" />
           <Split Axis = "2" From = "3" />
           <Split Axis = "2" From = "4" />
           <Turn Axis = "0" Angle = "Pi / 4" Layer = "0" />
           <Turn Axis = "0" Angle = "Pi / 4" Layer = "4" />

           <Turn Axis = "1" Angle = "-Pi / 4" Layer = "0" />
           <Turn Axis = "1" Angle = "-Pi / 4" Layer = "4" />
           <Split Axis = "0" From = "1" />
           <Split Axis = "0" From = "2" />
           <Split Axis = "0" From = "3" />
           <Split Axis = "0" From = "4" />
           <Split Axis = "2" From = "1" />
           <Split Axis = "2" From = "2" />
           <Split Axis = "2" From = "3" />
           <Split Axis = "2" From = "4" />
           <Turn Axis = "1" Angle = "Pi / 4" Layer = "0" />
           <Turn Axis = "1" Angle = "Pi / 4" Layer = "4" />

           <Turn Axis = "2" Angle = "-Pi / 4" Layer = "0" />
           <Turn Axis = "2" Angle = "-Pi / 4" Layer = "4" />
           <Split Axis = "0" From = "1" />
           <Split Axis = "0" From = "2" />
           <Split Axis = "0" From = "3" />
           <Split Axis = "0" From = "4" />
           <Split Axis = "1" From = "1" />
           <Split Axis = "1" From = "2" />
           <Split Axis = "1" From = "3" />
           <Split Axis = "1" From = "4" />
           <Turn Axis = "2" Angle = "Pi / 4" Layer = "0" />
           <Turn Axis = "2" Angle = "Pi / 4" Layer = "4" />

    </Figure>
