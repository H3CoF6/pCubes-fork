<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>DaYan Gem 6</Name>
        <Menu>Other forms\DaYan\DaYan Gem 6</Menu>
        <Inventor>Daqing Bao</Inventor>
        <Programmer>Boris</Programmer>
        <Added>2016-04-05</Added>
    </Interface>

    <Script>
        clBlue   := '0000C8';
        clGreen  := '009600';
        clRed    := 'C80000';
        clOrange := 'FF800A';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 0.5;
        D := 1.11 * W; // empiric value
        D1 := D / sqrt(1 + 2 * (sin(3 * Pi / 8) / sin(Pi / 8))^2);
        D2 := D1 * sin(3 * Pi / 8) / sin(Pi / 8);
        K := cos(Pi / 8);
    </Script>

    <Axes TurningAngles = "Pi/4; Pi/2; 0; Pi/2; Pi/4" PlaneDistances = "-D2; -D1; D1; D2" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
           <Part>
               <Vertices>
                   <Add Vector = "-W; -W; -W" />
                   <Add Vector = "-W; -W;  W" />
                   <Add Vector = "-W;  W; -W" />
                   <Add Vector = "-W;  W;  W" />
                   <Add Vector = " W; -W; -W" />
                   <Add Vector = " W; -W;  W" />
                   <Add Vector = " W;  W; -W" />
                   <Add Vector = " W;  W;  W" />
               </Vertices>

               <Faces>
                   <Face Color = "clBlue"   VertexIndexes = "1;0;4;5" />
                   <Face Color = "clGreen"  VertexIndexes = "2;3;7;6" />
                   <Face Color = "clRed"    VertexIndexes = "0;1;3;2" />
                   <Face Color = "clOrange" VertexIndexes = "5;4;6;7" />
                   <Face Color = "clYellow" VertexIndexes = "0;2;6;4" />
                   <Face Color = "clWhite"  VertexIndexes = "3;1;5;7" />
               </Faces>
           </Part>

           <Cut Color="51C4FA" > <!-- нежно-голубой -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 1)" Y="cos(Pi / 8 + Pi / 4 * 1)" Z="-K" />
                   <NormDistance> -D </NormDistance>
               </Plane>
           </Cut>
           <Cut Color="0CA498" > <!-- зел-сал -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 2)" Y="cos(Pi / 8 + Pi / 4 * 2)" Z="-K" />
                   <NormDistance> -D </NormDistance>
               </Plane>
           </Cut>
           <Cut Color="9aE24E" > <!-- св зел -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 5)" Y="cos(Pi / 8 + Pi / 4 * 5)" Z="-K" />
                   <NormDistance> -D </NormDistance>
               </Plane>
           </Cut>
           <Cut Color="075AFF" > <!-- тёмно-синий -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 6)" Y="cos(Pi / 8 + Pi / 4 * 6)" Z="-K" />
                   <NormDistance> -D </NormDistance>
               </Plane>
           </Cut>

<!-- -->

           <Cut Color="103583" > <!--  -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 1)" Y="cos(Pi / 8 + Pi / 4 * 1)" Z="K" />
