               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 0)" Y="-K" Z="cos(Pi / 8 + Pi / 4 * 0)" />
                   <NormDistance> -D </NormDistance>
               </Plane>
           </Cut>
           <Cut Color="7D7584" > <!--  -->
               <Plane>
                   <NormVector X="sin(Pi / 8 + Pi / 4 * 1)" Y="-K" Z="cos(Pi / 8 + Pi / 4 * 1)" />
                   <NormDistance> -D </NormDistance>
