   <Interface>
        <Name>Synchro Loop1</Name>
        <Menu>Other forms\Synchro Loop1</Menu>
        <Inventor>Tim Fitzrandolph</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2020-04-10</Added>
