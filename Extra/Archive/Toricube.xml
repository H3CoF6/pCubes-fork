<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Toricube</Name>
        <Menu>Other forms\3x3x3 variants\Toricube</Menu>
        <Inventor>Tim Fitzrandolph</Inventor>
        <Programmer>Skallos</Programmer>
        <Link>https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=7309</Link>
    </Interface>

    <Script>
        clRed    := 'FF0000';
        clOrange := 'FF6000';
        clBlue   := '0000A0';
        clGreen  := '008000';
        clYellow := 'FFFF00';
        clWhite  := 'FFFFFF';

        W := 1 / 2;
        R := W / 3;

        for i := 0 to 44 do begin
            Vx[i] := (2 * R - R * cos(2 * pi * (Int(i / 5) - 2) / 16)) * cos(2 * pi * (i mod 5) / 16);
            Vy[i] := (2 * R - R * cos(2 * pi * (Int(i / 5) - 2) / 16)) * sin(2 * pi * (i mod 5) / 16);
            Vz[i] :=  2 * R + R * sin(2 * pi * (Int(i / 5) - 2) / 16);
        end;

        D := (Vx[42] + Vy[42] + Vz[42]) / 3;

        cs := cos(pi / 8);
        ss := sin(pi / 8);

        cx := cos(3 * pi / 16);
        sx := sin(3 * pi / 16);
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D; D" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <Macro Name = "Edge" >
            <!--<HideAll/>-->
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />
                <Vertices Vectors = "Vz; Vx; Vy" />

                <Faces>
                    <Face VertexIndexes = "49;54;59;64;69;74;79;84;40;35;30;25;20;15;10;5;0" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "1;6;11;16;21;26;31;36;41" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "88;83;78;73;68;63;58;53;48" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "88;48;1;41" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = "41;40;88" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 0; 1;48" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = "41;36;35;40" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "36;31;30;35" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "31;26;25;30" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "26;21;20;25" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "21;16;15;20" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "16;11;10;15" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "11; 6; 5;10" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 6; 1; 0; 5" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = "88;89;84;83" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "83;84;79;78" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "78;79;74;73" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "73;74;69;68" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "68;69;64;63" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "63;64;59;58" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "58;59;54;53" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "53;54;49;48" InvisibleEdges = "-1" />
                </Faces>
            </Part>

            <!--<Cut> <Plane NormVector = "ss;-cs;0" NormDistance = "-W / 100" /> </Cut>
            <Cut> <Plane NormVector = "0;-cs;ss" NormDistance = "-W / 100" /> </Cut>-->
        </Macro>

        <Macro Name = "Wedge" >
            <!--<HideAll/>-->
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />
                <Vertices Vectors = "Vz; Vx; Vy" />

                <Faces>
                    <Face VertexIndexes = " 2; 1;41;42" InvisibleEdges = "-1" />
                    <Face VertexIndexes = " 1;48;88;41" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "48;47;87;88" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "47; 2;42;87" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = " 1; 2;47;48" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "42;41;88;87" InvisibleEdges = "-1" />
                </Faces>
            </Part>

            <!--<Turn NormVector = "0;0;1" Angle = "-3*Pi/16" />
            <Cut> <Plane NormVector = " 1; 0;-1" NormDistance = "-W/10" /> </Cut>
            <Turn NormVector = "0;0;1" Angle = " 3*Pi/16" />
            <Turn NormVector = "1;0;0" Angle = " 3*Pi/16" />
            <Cut> <Plane NormVector = "-1; 0; 1" NormDistance = "-W/10" /> </Cut>
            <Turn NormVector = "1;0;0" Angle = "-3*Pi/16" />-->
        </Macro>

        <Macro Name = "Side1" >
            <!--<HideAll/>-->
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />

                <Faces>
                    <Face VertexIndexes = "41;36;31;26;21;16;11;6;1" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "2;7;12;17;22;27;32;37;42" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "1;2;42;41" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = " 2; 1; 6; 7" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 7; 6;11;12" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "12;11;16;17" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "17;16;21;22" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "22;21;26;27" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "27;26;31;32" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "32;31;36;37" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "37;36;41;42" InvisibleEdges = "-1" />
                </Faces>
            </Part>

            <!--<Cut> <Plane NormVector = "-ss; cs;0" NormDistance = "-W / 100" /> </Cut>
            <Cut> <Plane NormVector = "  1; -1;0" NormDistance = "-W / 100" /> </Cut>-->
        </Macro>

        <Macro Name = "Side2" >
            <!--<HideAll/>-->
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />

                <Faces>
                    <Face VertexIndexes = "42;37;32;27;22;17;12;7;2" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "3;8;13;18;23;28;33;38;43" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "2;3;43;42" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = " 3; 2; 7; 8" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = " 8; 7;12;13" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "13;12;17;18" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "18;17;22;23" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "23;22;27;28" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "28;27;32;33" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "33;32;37;38" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "38;37;42;43" InvisibleEdges = "-1" />
                </Faces>
            </Part>

            <!--<Cut> <Plane NormVector = " cs;-ss;0" NormDistance = "-W / 100" /> </Cut>
            <Cut> <Plane NormVector = " -1;  1;0" NormDistance = "-W / 100" /> </Cut>-->
        </Macro>

        <Macro Name = "Center" >
            <!--<HideAll/>-->
            <Part>
                <Vertices Vectors = "Vx; Vy; Vz" />
                <Vertices Vectors = "Vy; Vz; Vx" />
                <Vertices Vectors = "Vz; Vx; Vy" />

                <Faces>
                    <Face VertexIndexes = " 2; 42; 87;47" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "47; 87;132;92" InvisibleEdges = "-1" />
                    <Face VertexIndexes = "92;132; 42; 2" InvisibleEdges = "-1" />

                    <Face Color = "Color" VertexIndexes = "132;87;42" InvisibleEdges = "-1" />
                    <Face Color = "Color" VertexIndexes = "  2;47;92" InvisibleEdges = "-1" />
                </Faces>
            </Part>

            <!--<Cut> <Plane NormVector = " cx;-sx;  0" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = "-sx; cx;  0" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = " cx;  0;-sx" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = "-sx;  0; cx" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = "  0; cx;-sx" NormDistance = "0" /> </Cut>
            <Cut> <Plane NormVector = "  0;-sx; cx" NormDistance = "0" /> </Cut>-->
        </Macro>

        <Macro Name = "Corner" >
            <ExecMacro MacroName = "Edge  " />
            <ExecMacro MacroName = "Side1 " />
            <ExecMacro MacroName = "Side2 " />
            <ExecMacro MacroName = "Wedge " />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

            <ExecMacro MacroName = "Edge  " />
            <ExecMacro MacroName = "Side1 " />
            <ExecMacro MacroName = "Side2 " />
            <ExecMacro MacroName = "Wedge " />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

            <ExecMacro MacroName = "Edge  " />
            <ExecMacro MacroName = "Side1 " />
            <ExecMacro MacroName = "Side2 " />
            <ExecMacro MacroName = "Wedge " />
            <Turn NormVector = "1;1;1" Angle = "2*Pi/3" />

            <ExecMacro MacroName = "Center" />
        </Macro>

        <Macro Name = "CreateShape" >
            <HideAll/>
            <ExecMacro MacroName = "Corner" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
            <ExecMacro MacroName = "Corner" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
            <ExecMacro MacroName = "Corner" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
            <ExecMacro MacroName = "Corner" />
            <Turn NormVector = "0;0;1" Angle = "Pi/2" />
            <Cut InvisibleEdges = "-1" > <Plane NormVector = " 1; 0; 1" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1" > <Plane NormVector = " 0; 1; 1" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1" > <Plane NormVector = "-1; 0; 1" NormDistance = "0" /> </Cut>
            <Cut InvisibleEdges = "-1" > <Plane NormVector = " 0;-1; 1" NormDistance = "0" /> </Cut>
        </Macro>

        <ExecMacro MacroName = "CreateShape" Color = "clWhite" />
        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "CreateShape" Color = "clRed" />
        <Turn NormVector = "1;0;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "CreateShape" Color = "clGreen" />
        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "CreateShape" Color = "clYellow" />
        <Turn NormVector = "1;0;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "CreateShape" Color = "clOrange" />
        <Turn NormVector = "0;1;0" Angle = "Pi/2" />
        <ExecMacro MacroName = "CreateShape" Color = "clBlue" />
        <Turn NormVector = "1;0;0" Angle = "Pi/2" />
        <ShowAll/>

        <SplitByAxes/>

        <Turn NormVector = "0;0;1" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Split>
        <Turn NormVector = "0;0;1" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Split>
        <Turn NormVector = "0;0;1" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Split>
        <Turn NormVector = "0;0;1" Angle = "-3*Pi/8" />
        <RemoveGrayParts/>

        <Turn NormVector = "0;1;0" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Split>
        <Turn NormVector = "0;1;0" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Split>
        <Turn NormVector = "0;1;0" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 1; 0; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Split>
        <Turn NormVector = "0;1;0" Angle = "-3*Pi/8" />
        <RemoveGrayParts/>

        <Turn NormVector = "1;0;0" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Split>
        <Turn NormVector = "1;0;0" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Split>
        <Turn NormVector = "1;0;0" Angle = "Pi/8" />
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 1; 0" NormDistance = "0" /> </Split>
        <Split InvisibleEdges1 = "-1" InvisibleEdges2 = "-1" ><Plane NormVector = " 0; 0; 1" NormDistance = "0" /> </Split>
        <Turn NormVector = "1;0;0" Angle = "-3*Pi/8" />
        <RemoveGrayParts/>
    </Figure>
</xml>
