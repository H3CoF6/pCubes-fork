<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 8x8x8 old</Name>
        <Menu>Cubic\Classic Rubiks\Super 8x8x8 old</Menu>
        <Inventor>unknown</Inventor>
        <Programmer>Skallos</Programmer>
        <Added>2017-07-26</Added>
        <Link>https://www.amazon.com/Pochmann-Supercube-Sticker-Twisty-Puzzle/dp/B01MDNOFUX</Link>
    </Interface>

    <Script>
        W := 0.5;
        W1 := W * 1.06;
        W2 := W1 + (W1 - W);
        W3 := W2 + (W1 - W);

        D1 := W * 1 / 4;
        D2 := W * 2 / 4;
        D3 := W * 3 / 4;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D3; -D2; -D1; 0; D1; D2; D3" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Script> WE := D3; DCut1 := W; DCut2 := W1; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := D2; DCut1 := W1; DCut2 := W2; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := D1; DCut1 := W2; DCut2 := W3; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <ShowAll/>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
