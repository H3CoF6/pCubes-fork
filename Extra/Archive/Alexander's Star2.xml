    <Script>
        mAngle := ArcTan(0.5);
        As := sin(mAngle);
        sAngle := PI * 2 / 5;
        R := 0.7;
        Rsin := R * sin(mAngle);
        Rcos := R * cos(mAngle);
        D := Rsin;
        RcosI := RCos / (sqrt(5) + 3) * 2;

        X[0] := 0;
        Y[0] := 0;
        Z[0] := R;

        for i := 1 to 5 do begin
            X[i] := Rcos * sin(sAngle * (i - 1));
            Y[i] := Rcos * cos(sAngle * (i - 1));
            Z[i] := Rsin;
        end;
        for i := 6 to 10 do begin
            X[i] := Rcos * sin(sAngle * (i - 0.5));
            Y[i] := Rcos * cos(sAngle * (i - 0.5));
            Z[i] := -Rsin;
        end;
     
        X[11] := 0;
        Y[11] := 0;
        Z[11] := -R;


        // inner dodeca

        R := sqrt(RSin * RSin + RcosI * RcosI);
        dAngle := (Arctan(2) + Arcsin(2/3)) / 2;
        dAngle2 := (Arctan(2) - Arcsin(2/3)) / 2;
        Rsin := R * sin(dAngle);
        Rcos := R * cos(dAngle);
        R2sin := R * sin(dAngle2);
        R2cos := R * cos(dAngle2);

        for i := 0 to 4 do begin
            xi[i] := Rcos * sin(sAngle * (i - 0.5));
            yi[i] := Rcos * cos(sAngle * (i - 0.5));
            zi[i] := Rsin;
        end;
        
        for i := 5 to 9 do begin
            xi[i] := R2cos * sin(sAngle * (i - 0.5));
            yi[i] := R2cos * cos(sAngle * (i - 0.5));
            zi[i] := R2sin;
        end;
        
        for i := 10 to 14 do begin
            xi[i] := R2cos * sin(sAngle * i);
            yi[i] := R2cos * cos(sAngle * i);
            zi[i] := -R2sin;
        end;

        for i := 15 to 19 do begin
            xi[i] := Rcos * sin(sAngle * i);
            yi[i] := Rcos * cos(sAngle * i);
            zi[i] := -Rsin;
        end;

    </Script>

