<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Super 9x9x9 old</Name>
        <Menu>Cubic\Classic Rubiks\Super 9x9x9 old</Menu>
        <Inventor>cuberus</Inventor>
        <Programmer>xchemist</Programmer>
        <Added>2017-07-26</Added>
        <Link></Link>
    </Interface>

    <Script>
        W := 0.5;
        W1 := W * 1.06;
        W2 := W1 + (W1 - W);
        W3 := W2 + (W1 - W);
        W4 := W3 + (W1 - W);

        D1 := W * 1 / 9;
        D2 := W * 3 / 9;
        D3 := W * 5 / 9;
        D4 := W * 7 / 9;
    </Script>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-D4; -D3; -D2; -D1; D1; D2; D3; D4" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cube.xml" />

        <Script> WE := D4; DCut1 := W; DCut2 := W1; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := D3; DCut1 := W1; DCut2 := W2; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := D2; DCut1 := W2; DCut2 := W3; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <Script> WE := D1; DCut1 := W3; DCut2 := W4; </Script>
        <LoadFrom File = "Puzzles\Cubic\Classic Rubiks\_Macro_For_Super.xml" />

        <ShowAll/>

        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>
</xml>
