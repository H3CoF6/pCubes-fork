<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Pillow cube</Name>
        <Menu>Test\Pillow cube</Menu>
        <Added>2024-01-26</Added>
    </Interface>

    <Script>
        include 'Figures\Scripts\Cube_Standard_Colors.inc';

        W := 0.5;
        include 'Figures\Scripts\Cube_Coordinates.inc';

        A := W * 1.5;
        B := A - W;

        procedure GetVertices();
        begin
            for i := 0 to (Length(Vertices) + 1) div 3 - 1 do
                v[i] := StrToInt(Copy( Vertices, i * 3 + 1, 2));
        end;
    </Script>

    <Axes TurningAngles = "Pi * 2 / 3" PlaneDistances = "0" >
        <Axis NormVector = "-1;-1;-1" />
        <Axis NormVector = " 1; 1;-1" />
        <Axis NormVector = " 1;-1; 1" />
        <Axis NormVector = "-1; 1; 1" />
    </Axes>

    <Figure>
        <Macro Name = "AddSide" >
            <Script>
                Color := Colors[c];
                GetVertices;
            </Script>
            <Face Color = "Color" VertexIndexes = "v[4];v[5];v[6];v[7]" InvisibleEdges = "15" />
            <Face Color = "Color" VertexIndexes = "v[3];v[7];v[2]"      InvisibleEdges = " 3" />
            <Face Color = "Color" VertexIndexes = "v[2];v[7];v[6]"      InvisibleEdges = " 7" />
            <Face Color = "Color" VertexIndexes = "v[2];v[6];v[1]"      InvisibleEdges = " 3" />
            <Face Color = "Color" VertexIndexes = "v[1];v[6];v[5]"      InvisibleEdges = " 7" />
            <Face Color = "Color" VertexIndexes = "v[1];v[5];v[0]"      InvisibleEdges = " 3" />
            <Face Color = "Color" VertexIndexes = "v[0];v[5];v[4]"      InvisibleEdges = " 7" />
            <Face Color = "Color" VertexIndexes = "v[0];v[4];v[3]"      InvisibleEdges = " 3" />
            <Face Color = "Color" VertexIndexes = "v[3];v[4];v[7]"      InvisibleEdges = " 7" />
        </Macro>

        <Part>
            <Vertices Vectors = "Vx;Vy;Vz" />
            <Vertices>
                // white
                <Add Vector = "-B; 0; A" />
                <Add Vector = " 0; B; A" />
                <Add Vector = " B; 0; A" />
                <Add Vector = " 0;-B; A" />

                // blue
                <Add Vector = "-B;-A; 0" />
                <Add Vector = " 0;-A; B" />
                <Add Vector = " B;-A; 0" />
                <Add Vector = " 0;-A;-B" />

                // orange
                <Add Vector = " A;-B; 0" />
                <Add Vector = " A; 0; B" />
                <Add Vector = " A; B; 0" />
                <Add Vector = " A; 0;-B" />

                // red
                <Add Vector = "-A; B; 0" />
                <Add Vector = "-A; 0; B" />
                <Add Vector = "-A;-B; 0" />
                <Add Vector = "-A; 0;-B" />

                // green
                <Add Vector = " B; A; 0" />
                <Add Vector = " 0; A; B" />
                <Add Vector = "-B; A; 0" />
                <Add Vector = " 0; A;-B" />

                // yellow
                <Add Vector = "-B; 0;-A" />
                <Add Vector = " 0;-B;-A" />
                <Add Vector = " B; 0;-A" />
                <Add Vector = " 0; B;-A" />
            </Vertices>

            <Faces>
                <ExecMacro MacroName = "AddSide" c = "0" Vertices = "' 0; 1; 3; 2;23;22;21;20'" />
                <ExecMacro MacroName = "AddSide" c = "1" Vertices = "' 6; 7; 5; 4;19;18;17;16'" />
                <ExecMacro MacroName = "AddSide" c = "2" Vertices = "' 4; 5; 1; 0;15;14;13;12'" />
                <ExecMacro MacroName = "AddSide" c = "3" Vertices = "' 2; 3; 7; 6;27;26;25;24'" />
                <ExecMacro MacroName = "AddSide" c = "4" Vertices = "' 6; 4; 0; 2;31;30;29;28'" />
                <ExecMacro MacroName = "AddSide" c = "5" Vertices = "' 5; 7; 3; 1;11;10; 9; 8'" />
            </Faces>
        </Part>

        <SaveSolvedState/>
    </Figure>

    <Procedures CheckSolved = "CheckSavedStates" />
</xml>
